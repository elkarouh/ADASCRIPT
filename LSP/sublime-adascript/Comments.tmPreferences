<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>name</key>
    <string>Comments (Adascript)</string>
    <key>scope</key>
    <string>source.adascript</string>
    <key>settings</key>
    <dict>
        <key>shellVariables</key>
        <array>
            <!-- Line comment token used by Edit > Toggle Comment (Ctrl+/) -->
            <dict>
                <key>name</key>
                <string>TM_COMMENT_START</string>
                <key>value</key>
                <string># </string>
            </dict>
        </array>
    </dict>
</dict>
</plist>
