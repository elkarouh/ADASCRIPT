{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Adascript",
  "scopeName": "source.adascript",
  "fileTypes": ["ady"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#substitution" },
    { "include": "#regex-literal" },
    { "include": "#string-triple-double" },
    { "include": "#string-triple-single" },
    { "include": "#string-double" },
    { "include": "#string-single" },
    { "include": "#type-declaration" },
    { "include": "#decorator" },
    { "include": "#function-def" },
    { "include": "#class-def" },
    { "include": "#tick-attribute" },
    { "include": "#keyword-control" },
    { "include": "#keyword-operator" },
    { "include": "#builtin-constant" },
    { "include": "#builtin-function" },
    { "include": "#number" },
    { "include": "#operator" }
  ],
  "repository": {

    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.adascript"
    },

    "regex-literal": {
      "comment": "/pattern/flags. Where a / starts one rather than a division is the tokenizer's rule (HPARSEC/hek_tokenize.py): after an operator or an opening bracket, or after one of a few keywords -- a lookbehind here, allowing two spaces -- and never at // or /=. Before the strings, so that a quote inside it, /x=\"(.*)\"/, is part of the regex and opens no string.",
      "match": "(?<=[=(\\[,:;+\\-*%|&^~!<>]|[=(\\[,:;+\\-*%|&^~!<>]\\s|[=(\\[,:;+\\-*%|&^~!<>]\\s\\s|\\breturn\\s|\\bif\\s|\\belif\\s|\\bwhile\\s|\\band\\s|\\bor\\s|\\bnot\\s|\\bin\\s|\\bprint\\s|\\byield\\s|\\blambda\\s|\\bcase\\s|\\bwhen\\s|\\breturn\\s\\s|\\bif\\s\\s|\\belif\\s\\s|\\bwhile\\s\\s|\\band\\s\\s|\\bor\\s\\s|\\bnot\\s\\s|\\bin\\s\\s|\\bprint\\s\\s|\\byield\\s\\s|\\blambda\\s\\s|\\bcase\\s\\s|\\bwhen\\s\\s)(/)(?![/=])((?:[^/\\\\\\n]|\\\\.)*)(/)([imsxg]*)",
      "name": "string.regexp.adascript",
      "captures": {
        "1": { "name": "punctuation.definition.string.begin.adascript" },
        "3": { "name": "punctuation.definition.string.end.adascript" },
        "4": { "name": "storage.modifier.adascript" }
      }
    },

    "substitution": {
      "comment": "s/pattern/replacement/flags: the s right against the /.",
      "match": "\\b(s)(/)((?:[^/\\\\\\n]|\\\\.)*)(/)((?:[^/\\\\\\n]|\\\\.)*)(/)([imsxg]*)",
      "name": "string.regexp.substitution.adascript",
      "captures": {
        "1": { "name": "keyword.operator.substitution.adascript" },
        "2": { "name": "punctuation.definition.string.begin.adascript" },
        "4": { "name": "punctuation.separator.adascript" },
        "6": { "name": "punctuation.definition.string.end.adascript" },
        "7": { "name": "storage.modifier.adascript" }
      }
    },

    "string-triple-double": {
      "name": "string.quoted.triple.double.adascript",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [{ "include": "#string-escape" }]
    },

    "string-triple-single": {
      "name": "string.quoted.triple.single.adascript",
      "begin": "'''",
      "end": "'''",
      "patterns": [{ "include": "#string-escape" }]
    },

    "string-double": {
      "name": "string.quoted.double.adascript",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "include": "#string-escape" }]
    },

    "string-single": {
      "name": "string.quoted.single.adascript",
      "begin": "'(?=[^'\\n]+')",
      "end": "'",
      "patterns": [{ "include": "#string-escape" }]
    },

    "string-escape": {
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|[0-7]{1,3}|[\\\\\"'nrtbfav0N])",
      "name": "constant.character.escape.adascript"
    },

    "type-declaration": {
      "comment": "type NAME [params] is|= enum|record|tuple ...",
      "match": "\\b(type)\\s+(\\w+)(?:\\s*\\[[^\\]]*\\])?\\s+(is|=)\\s+(enum|record|tuple)\\b",
      "captures": {
        "1": { "name": "storage.type.adascript" },
        "2": { "name": "entity.name.type.adascript" },
        "3": { "name": "keyword.other.adascript" },
        "4": { "name": "storage.type.enum-or-record.adascript" }
      }
    },

    "decorator": {
      "match": "^\\s*(@)(\\w+(?:\\.\\w+)*)",
      "captures": {
        "1": { "name": "punctuation.definition.decorator.adascript" },
        "2": { "name": "entity.name.function.decorator.adascript" }
      }
    },

    "function-def": {
      "match": "\\b(def|async\\s+def)\\s+(\\w+)",
      "captures": {
        "1": { "name": "keyword.control.adascript" },
        "2": { "name": "entity.name.function.adascript" }
      }
    },

    "class-def": {
      "match": "\\b(class)\\s+(\\w+)",
      "captures": {
        "1": { "name": "keyword.control.adascript" },
        "2": { "name": "entity.name.class.adascript" }
      }
    },

    "tick-attribute": {
      "comment": "Ada-style tick attributes: Color'First, State'Last, T'Range",
      "match": "\\b(\\w+)'(\\w+)\\b",
      "captures": {
        "1": { "name": "variable.other.adascript" },
        "2": { "name": "support.function.attribute.adascript" }
      }
    },

    "keyword-control": {
      "match": "\\b(False|None|True|and|as|assert|async|await|break|case|class|continue|def|del|elif|else|enum|except|finally|for|from|global|if|import|in|is|lambda|match|nonlocal|not|or|pass|raise|record|return|try|tuple|type|when|while|with|yield)\\b",
      "name": "keyword.control.adascript"
    },

    "keyword-operator": {
      "match": "\\b(and|or|not|in|is|not\\s+in|is\\s+not)\\b",
      "name": "keyword.operator.logical.adascript"
    },

    "builtin-constant": {
      "match": "\\b(True|False|None|NotImplemented|Ellipsis|__debug__)\\b",
      "name": "constant.language.adascript"
    },

    "builtin-function": {
      "match": "\\b(abs|all|any|ascii|bin|bool|breakpoint|bytearray|bytes|callable|chr|classmethod|compile|complex|delattr|dict|dir|divmod|enumerate|eval|exec|filter|float|format|frozenset|getattr|globals|hasattr|hash|help|hex|id|input|int|isinstance|issubclass|iter|len|list|locals|map|max|memoryview|min|next|object|oct|open|ord|pow|print|property|range|repr|reversed|round|set|setattr|slice|sorted|staticmethod|str|sum|super|tuple|type|vars|zip)(?=\\s*\\()",
      "name": "support.function.builtin.adascript"
    },

    "number": {
      "patterns": [
        {
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b",
          "name": "constant.numeric.hex.adascript"
        },
        {
          "match": "\\b0[oO][0-7_]+\\b",
          "name": "constant.numeric.octal.adascript"
        },
        {
          "match": "\\b0[bB][01_]+\\b",
          "name": "constant.numeric.binary.adascript"
        },
        {
          "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d[\\d_]*)?[jJ]?\\b",
          "name": "constant.numeric.adascript"
        }
      ]
    },

    "operator": {
      "match": "(\\+|-|\\*\\*|\\*|//|/|%|@|<<|>>|&|\\||\\^|~|:=|==|!=|<=|>=|<|>|=|\\+=|-=|\\*=|/=|//=|%=|&=|\\|=|\\^=|>>=|<<=|\\*\\*=)",
      "name": "keyword.operator.adascript"
    }
  }
}
