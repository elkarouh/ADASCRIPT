#!/usr/bin/env py2nim
# test_ada_line_fmt.ady — tests for ada_line_fmt.ady
#
# Run with:
#   py2nim ADA_INDENT/test_ada_line_fmt.ady -r

nimport ada_line_fmt

def fmt(src: str) -> str:
    return format_line(src)


# --- Rule 1: no space before ; and , ---

assert fmt("X := 1 ;") == "X := 1;"
assert fmt("Foo (A , B , C)") == "Foo (A, B, C)"
assert fmt("Foo (A) ;") == "Foo (A);"           # ) then ; — rule 1 beats rule 5


# --- Rule 2: one space around binary operators ---

assert fmt("X:=Y") == "X := Y"
assert fmt("A+B") == "A + B"
assert fmt("A-B") == "A - B"
assert fmt("A*B") == "A * B"
assert fmt("A/B") == "A / B"
assert fmt("A**B") == "A ** B"
assert fmt("A&B") == "A & B"
assert fmt("A=B") == "A = B"
assert fmt("A/=B") == "A /= B"
assert fmt("A<B") == "A < B"
assert fmt("A>B") == "A > B"
assert fmt("A<=B") == "A <= B"
assert fmt("A>=B") == "A >= B"
assert fmt("1..10") == "1 .. 10"
assert fmt("A|B") == "A | B"
assert fmt("X=>Y") == "X => Y"


# --- Rule 3: one space before comment ---

assert fmt("X := 1;-- note") == "X := 1; -- note"
assert fmt("X := 1;  -- note") == "X := 1; -- note"
# Special comment prefixes: body preserved verbatim, one space before --.
assert fmt("--## adactl") == "--## adactl"
assert fmt("--% doc") == "--% doc"


# --- Rule 4: ( — one space before, no space after ---

assert fmt("Foo(X)") == "Foo (X)"
assert fmt("Foo( X)") == "Foo (X)"
assert fmt("Foo  (X)") == "Foo (X)"
assert fmt("( (X))") == "((X))"
assert fmt("(not (X))") == "(not (X))"


# --- Rule 5: ) — no space before, one space after ---

assert fmt("Foo(X )") == "Foo (X)"


# --- Rule 6: tight delimiters . and ' ---

assert fmt("A .B") == "A.B"
assert fmt("A. B") == "A.B"
assert fmt("T 'First") == "T'First"
assert fmt("T' First") == "T'First"


# --- Leading indentation is preserved ---

assert fmt("   X := 1;") == "   X := 1;"
assert fmt("      return X + 1;") == "      return X + 1;"


# --- Blank / whitespace-only lines ---

assert fmt("") == ""
assert fmt("   ") == ""


# --- Compound cases ---

assert fmt("if X>0 then") == "if X > 0 then"
assert fmt("while I<N loop") == "while I < N loop"
assert fmt("return X+1 ;") == "return X + 1;"
assert fmt("X:=A+B*C;") == "X := A + B * C;"
assert fmt("procedure Foo(X:Integer;Y:Boolean) is") == \
    "procedure Foo (X : Integer; Y : Boolean) is"

# : and => preserve extra spaces for manual column alignment.
assert fmt("X : Integer") == "X : Integer"         # single space kept
assert fmt("X:Integer") == "X : Integer"            # zero → normalised to 1
assert fmt("Position    : Integer") == "Position    : Integer"   # 4 spaces kept
assert fmt("X     => 1") == "X     => 1"            # 5 spaces kept
assert fmt("Y_Long => 2") == "Y_Long => 2"          # 1 space kept
assert fmt("X=>1") == "X => 1"                      # zero → normalised to 1
assert fmt("X     := 1") == "X     := 1"            # spaces before := kept
assert fmt("X:=1") == "X := 1"                      # zero → normalised to 1

# --- Label colon: no space before : ---

assert fmt("Log_Changes : declare") == "Log_Changes: declare"
assert fmt("Inner : begin") == "Inner: begin"
assert fmt("Outer : loop") == "Outer: loop"
assert fmt("Named : for I in 1..10 loop") == "Named: for I in 1 .. 10 loop"
assert fmt("W : while Cond loop") == "W: while Cond loop"
assert fmt("Log_Changes :") == "Log_Changes:"           # label alone on its line
assert fmt("Find_Model : -- pick the model") == "Find_Model: -- pick the model"  # label + comment
assert fmt("X : Integer") == "X : Integer"          # type annotation — space kept

# in/out parameter mode alignment: extra spaces after keywords are preserved.
assert fmt("a : in          Float") == "a : in          Float"
assert fmt("b :      out    Float") == "b :      out    Float"
assert fmt("c : in out      Float") == "c : in out      Float"

# ) followed by . or ' stays tight (chained component selector / attribute).
assert fmt("Flight_Updates (Count_Option.Normal).Old_Fixed_Info.The_Flight_Status") == \
    "Flight_Updates (Count_Option.Normal).Old_Fixed_Info.The_Flight_Status"
assert fmt("Foo(X).Bar") == "Foo (X).Bar"
assert fmt("Foo(X)'First") == "Foo (X)'First"

# box notation <> : no space before ) and no space after (
assert fmt("others => <> )") == "others => <>)"
assert fmt("( others => <> )") == "(others => <>)"
assert fmt("X : T := (others => <>);") == "X : T := (others => <>);"
assert fmt("array (<>) of T") == "array (<>) of T"


# --- format_source: applies format_line line by line ---

let src: str = ("X:=1;\n"
                "Y:=2;\n")
assert format_source(src) == ("X := 1;\n"
                              "Y := 2;\n")


print("all ada_line_fmt tests passed")
