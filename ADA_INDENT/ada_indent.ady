#!/usr/bin/env py2nim
#ady2nim-args c -d:release --opt:speed
# ada_indent.ady — a simplified Ada source re-indenter, written in Adascript.
#
# This is NOT a full Ada parser. It implements only the slice of Ada grammar
# that matters for indentation: the keywords that open, close, or split an
# indented block. Everything else is treated as an ordinary statement line.
#
# The model is a stack machine. Each open construct pushes a frame; the
# display indent of a line is the stack depth (times the indent width), with
# small adjustments for keywords that align with their opener rather than the
# block body (end / elsif / else / when / exception / or / private / begin).
#
# See README.md in this directory for the simplified grammar specification.
#
# Usage:
#   py2nim ADA_INDENT/ada_indent.ady -r -- file.adb   # compile if stale, reindent a file
#   py2nim ADA_INDENT/ada_indent.ady -r -- --test     # compile if stale, run self-tests
#
# The core logic (reindent + helpers) is pure Adascript and transpiles to
# both Python and Nim. The CLI uses the bash-style argument primitives
# ($1, $#, quit) so argument handling is target-agnostic.

const INDENT_WIDTH: int = 2

# The indentation-significant constructs. A frame is pushed for each open
# block; the kind is only consulted where it changes behaviour (PKG/DECLARE
# become BLOCK at 'begin'; WHEN frames are popped specially at 'end').
type Block_T is enum:
    PKG          # package / subprogram / task / protected / type spec opened by trailing 'is'
    DECLARE_     # a declare block (block label or bare 'declare')
    BLOCK        # a begin ... end region (statement part)
    IF_          # if ... then
    LOOP_        # [while/for] ... loop
    CASE_        # case ... is
    WHEN_        # when ... =>   (case alternative or exception handler)
    RECORD_      # record  ... end record
    SELECT_      # select ... end select
    DO_          # accept ... do  /  return ... do  (extended return)

# Scanner state for string-literal tracking inside a single line.
type Scan_T is enum:
    CODE        # outside any string literal
    STRING_LIT  # inside a double-quoted string literal


# ---------------------------------------------------------------------------
# Lexical helpers — all work on a single physical line.
# ---------------------------------------------------------------------------

def pairwise(s: str) -> (char, char):
    for i in s'First..<s'Last:
        yield (s[i], s[i + 1])


def strip_code(line: str) -> str:
    """Return the line with any '--' comment removed, string literals kept.

    Quote handling is deliberately simple: it tracks double-quoted strings so
    that a '--' inside a string is not mistaken for a comment. Character
    literals and doubled-quote escapes are not modelled (rare in practice).
    """
    var state: Scan_T = CODE
    for c, next_c in pairwise(line + " "):
        case state:
            when CODE:
                if c == '-' and next_c == '-':
                    break
                result += c
                if c == '"':
                    state = STRING_LIT
            when STRING_LIT:
                result += c
                if c == '"':
                    state = CODE


def paren_delta(line: str) -> int:
    """Net '(' minus ')' on the line, ignoring parens inside string and character
    literals.

    The input must already have comments removed (see strip_code). Double-quoted
    strings are skipped, and so are character literals: a '(' or ')' written as
    '(' / ')' must not be counted. A character literal is a quote, any single
    character, then a closing quote ('x'); a quote followed by a letter is an
    attribute tick (X'Image) and is left alone.
    """
    var depth: int = 0
    var i: int = 0
    let n: int = len(line)
    while i < n:
        let c: char = line[i]
        if c == '"':
            i += 1
            while i < n and line[i] != '"':
                i += 1
            i += 1                               # skip the closing quote
        elif c == '\'' and i + 2 < n and line[i + 2] == '\'':
            i += 3                               # character literal: skip 'x' whole
        elif c == '(':
            depth += 1
            i += 1
        elif c == ')':
            depth -= 1
            i += 1
        else:
            i += 1
    return depth


def lead_word(code: str) -> str:
    """Lowercased leading identifier of a (comment-stripped) line, or ''."""
    for ch in code.strip().lower():
        if ch.isalpha() or ch == "_":
            result += ch
        else:
            break


def last_word(code: str) -> str:
    """Lowercased final token, after dropping a trailing ';'. '' if empty."""
    let parts: []str = code.strip().rstrip(";").split()
    if len(parts) > 0:
        result = parts[-1].lower()


def stmt_incomplete(code_s: str) -> bool:
    """True if a (comment-stripped) code line continues onto the next line.

    In Ada nearly every statement and declaration ends with ';'. The only
    unterminated lines that are nonetheless complete are the structural keyword
    lines: openers ending in is/then/loop/record/select/do, choice lines ending
    in '=>', block/loop label lines ending in ':', and the lone splitter/opener
    keywords (begin/declare/else/…). Any other line that does not end in ';' is a
    logical line split across physical lines, so the next line is a continuation.
    """
    # A trailing ':' marks a block/loop label ('Find_Model :', 'Log_Changes:'),
    # which is a complete prefix — the labelled construct on the next line stays
    # at the label's level rather than indenting as a continuation. (':=' ends in
    # '=', not ':', so an unfinished assignment is unaffected.)
    if (code_s == "" or code_s.endswith(";") or code_s.endswith("=>")
            or code_s.endswith(":")):
        return False
    let lw: str = lead_word(code_s)
    # 'separate (Parent)' is a complete compilation-unit prefix despite content.
    if lw == "separate":
        return False
    # A *bare* splitter/opener keyword line (just the keyword, nothing trailing)
    # is complete. The 'code_s.lower() == lw' guard matters because the same
    # words occur inside expressions: e.g. the 'else …)' line closing an
    # if-EXPRESSION continues the surrounding statement and must NOT be mistaken
    # for a complete statement-level 'else'.
    if (code_s.lower() == lw and (lw == "begin" or lw == "declare"
            or lw == "else" or lw == "exception" or lw == "or"
            or lw == "private" or lw == "select")):
        return False
    let lt: str = last_word(code_s)
    # Block openers, plus the '[not] overriding' indicator on its own line.
    if (lt == "is" or lt == "then" or lt == "loop" or lt == "record"
            or lt == "select" or lt == "do" or lt == "overriding"):
        return False
    result = True


def starts_with_operator(code_s: str) -> bool:
    """True if the line begins with a binary/assignment operator — either a
    symbol (:=, =>, =, &, +, -, *, /, <, >, |, ..) or a word operator
    (and, or, xor, mod, rem, covering 'and then'/'or else'). Such a continuation
    takes one extra indent level so it stands out from the operand it continues."""
    if code_s == "":
        return False
    let c0: char = code_s[0]
    if c0 == ':':
        return len(code_s) > 1 and code_s[1] == '='   # ':=', not a bare ':'
    if c0 == '.':
        return len(code_s) > 1 and code_s[1] == '.'   # '..' range
    if (c0 == '=' or c0 == '&' or c0 == '+' or c0 == '-' or c0 == '*'
            or c0 == '/' or c0 == '<' or c0 == '>' or c0 == '|'):
        return True
    let w: str = lead_word(code_s)
    return w == "and" or w == "or" or w == "xor" or w == "mod" or w == "rem"


def is_term_continuation(code_s: str) -> bool:
    """True if the line continues a value (sub-)expression across a line break,
    rather than starting a new term or binding. Such a line nests one level past
    where its expression began. It qualifies when it opens an argument list with
    '(' or starts with a value operator: arithmetic / relational / concatenation
    / range (=, &, +, -, *, /, <, >, .., mod, rem) or a boolean connective
    (and / or / and then / or else, including 'and not' / 'or not').

    Excluded (these stay at the base continuation level): the binding operators
    ':=' and '=>', the choice separator '|' (handled with the 'when' choice
    list), and 'xor'.

    NOTE: inside a multi-line if/elsif condition the boolean connectives are
    kept at the base level instead — that exception lives in the cond_state
    branch (its 'lw != and/or' guard), not here, because the rule differs
    between a free value expression (connectives indent under their operand)
    and a condition (connectives align under the 'if')."""
    if code_s == "":
        return False
    if code_s.startswith("("):
        return True
    if (not starts_with_operator(code_s)
            or code_s.startswith(":=") or code_s.startswith("=>")
            or code_s.startswith("|")):
        return False
    let w: str = lead_word(code_s)
    if w == "and" or w == "or":
        # Boolean connectives join successive operands of a value expression;
        # each continuation sits one level past where the expression began.
        return True
    return w != "xor"


def scan_parens(text: str, base_depth: int, base_col: int) -> [](int, int, int):
    """Find every '(' opened in a line and how its continuations should align.

    Returns one tuple (paren_level, align_col, kind) per opening parenthesis:
    paren_level is the depth just inside the '(', align_col is the absolute
    output column to align continuations to (base_col is the column at which
    text[0] renders), and kind is 0 for a plain parenthesis, 1 for '(if', 2
    for '(case' and 3 for '(for' (a quantified or iterated expression). For a
    plain '(' the alignment column is the first non-blank character after it
    (the first item), or one indent level in if the '(' ends the line. For
    '(if'/'(case'/'(for' the column is the keyword itself, which the caller
    offsets per the expression's syntax. String and character literals
    are skipped so a '(' written as '(' (or in "(") is not recorded; otherwise
    this is a best-effort scan.
    """
    var openers: [](int, int, int) = []
    var depth: int = base_depth
    var i: int = 0
    let n: int = len(text)
    while i < n:
        let ch: char = text[i]
        if ch == '"':
            i += 1
            while i < n and text[i] != '"':
                i += 1
            i += 1                               # skip the closing quote
        elif ch == '\'' and i + 2 < n and text[i + 2] == '\'':
            i += 3                               # character literal: skip 'x' whole
        elif ch == '(':
            depth += 1
            var j: int = i + 1
            while j < n and text[j] == ' ':
                j += 1
            if (j + 1 < n
                    and (text[j] == 'i' or text[j] == 'I')
                    and (text[j + 1] == 'f' or text[j + 1] == 'F')
                    and (j + 2 >= n or not (text[j + 2].isalnum() or text[j + 2] == '_'))):
                openers.append((depth, base_col + j, 1))
            elif (j + 3 < n
                    and (text[j] == 'c' or text[j] == 'C')
                    and (text[j + 1] == 'a' or text[j + 1] == 'A')
                    and (text[j + 2] == 's' or text[j + 2] == 'S')
                    and (text[j + 3] == 'e' or text[j + 3] == 'E')
                    and (j + 4 >= n or not (text[j + 4].isalnum() or text[j + 4] == '_'))):
                openers.append((depth, base_col + j, 2))
            elif (j + 2 < n
                    and (text[j] == 'f' or text[j] == 'F')
                    and (text[j + 1] == 'o' or text[j + 1] == 'O')
                    and (text[j + 2] == 'r' or text[j + 2] == 'R')
                    and (j + 3 >= n or not (text[j + 3].isalnum() or text[j + 3] == '_'))):
                openers.append((depth, base_col + j, 3))
            elif j < n:
                openers.append((depth, base_col + j, 0))
            else:
                openers.append((depth, base_col + INDENT_WIDTH, 0))
            i += 1
        elif ch == ')':
            depth -= 1
            i += 1
        else:
            i += 1
    return openers


def spaces(levels: int) -> str:
    """A run of spaces for the given number of indent levels (never negative)."""
    " " * (max(0, levels) * INDENT_WIDTH)


# ---------------------------------------------------------------------------
# The indenter proper.
# ---------------------------------------------------------------------------

class Indenter:
    stack: []Block_T = []
    paren_depth: int = 0
    pending_spec: bool = False   # a 'function ... is' header whose body kind is not yet known
    cond_state: int = 0          # 1 = inside multi-line 'if' condition, 2 = 'elsif'
    cond_base: int = 0           # display depth of the opening if/elsif
    cond_value_base: int = 0     # display level of the line holding the current condition term
    in_cont: bool = False        # previous line was an unterminated statement/declaration
    value_base: int = 0          # display level where the current statement's value expression starts
    paren_stack: [](int, int, int) = []  # (paren_level, align_col, kind) for every open '('
    paren_cont: bool = False    # prev line within plain paren ended without ',' (arg-list continuation)
    arrow_level: int = 0        # innermost paren level with an active '=>' named-value spill (0 = none)
    paren_last_lead: int = 0    # lead column of the last code line emitted inside a paren
    paren_last_lead_depth: int = 0  # paren_depth that paren_last_lead applies to

    def _push_parens(self, text: str, base_col: int, base_depth: int, new_depth: int):
        """Record parentheses opened on this line and drop any now closed."""
        for opener in scan_parens(text, base_depth, base_col):
            self.paren_stack.append(opener)
        while len(self.paren_stack) > 0:
            let top: (int, int, int) = self.paren_stack[-1]
            if top[0] > new_depth:
                self.paren_stack.pop()
            else:
                break

    def indent_line(self, line: str) -> str:
        """Process one raw line and return it re-indented."""
        let raw2: str = line.rstrip()
        let code: str = strip_code(raw2)
        let code_s: str = code.strip()
        let emit_text: str = raw2.strip()

        if emit_text == "":
            return ""

        # A comment-only line (text remains, but nothing is left after stripping
        # the '--' comment) is transparent to the parser: indent it to the
        # current continuation context but leave ALL state untouched
        # (in_cont / cond_state / paren_depth / pending_spec / paren_stack), so
        # the next real line indents exactly as if the comment were not there.
        # Without this the trailing in_cont update would clear a pending
        # statement continuation, dropping the line after the comment back to
        # the base level (and a comment after 'function ... is' would wrongly
        # resolve the deferred spec).
        if code_s == "":
            # Inside a parenthesis a comment follows the surrounding lines: align
            # it with the previous code line in this same paren (which, in a list
            # or expression, sits at the same level as the line that follows it),
            # falling back to the paren's item column when there is none yet.
            if self.paren_depth > 0 and len(self.paren_stack) > 0:
                let ptop: (int, int, int) = self.paren_stack[-1]
                if self.paren_last_lead_depth == self.paren_depth:
                    return " " * self.paren_last_lead + emit_text
                return " " * ptop[1] + emit_text
            # Outside parentheses a comment is indented like a NEW instruction at
            # this point — the current block nesting level — not the continuation
            # indent of the statement (or if/elsif condition) it interrupts.
            if self.cond_state > 0:
                return " " * (max(0, self.cond_base) * INDENT_WIDTH) + emit_text
            return " " * (max(0, len(self.stack)) * INDENT_WIDTH) + emit_text

        let entry_depth: int = self.paren_depth
        # When we are outside all parens, clear the plain-paren continuation flag
        # and the named-value spill state so stale paren context does not leak.
        if entry_depth == 0:
            self.paren_cont = False
            self.arrow_level = 0
        let cont: int = 1 if (self.paren_depth > 0 or self.in_cont) else 0
        let lw: str = lead_word(code_s)
        var disp: int = len(self.stack)

        # Resolve a deferred 'function ... is' header (set on the previous line).
        # If the body begins with '(' it is an expression function: indent the
        # expression one level and push no frame. Otherwise it is a real
        # subprogram body, so perform the deferred push and fall through.
        if self.pending_spec:
            self.pending_spec = False
            if code_s.startswith("("):
                self.in_cont = False
                let lead_e: int = max(0, len(self.stack) + 1 + cont) * INDENT_WIDTH
                self.paren_depth = max(0, self.paren_depth + paren_delta(code))
                self._push_parens(emit_text, lead_e, entry_depth, self.paren_depth)
                return " " * lead_e + emit_text
            else:
                self.stack.append(PKG)
                disp = len(self.stack)

        # Inside an unclosed parenthesis the line is a continuation of an
        # expression / list, so statement keywords (then/else/elsif/when) are
        # operators here, not statement parts. It is aligned by absolute column
        # to the innermost open parenthesis:
        #   plain '('  -> under the first item after the '(';
        #   '(if'      -> then/else/elsif under the 'if', condition past it;
        #   '(case'    -> when clauses one level in from the 'case', clause
        #                 bodies one level deeper still.
        # This is checked before the cond_state branch so that lines inside a
        # parenthesis opened within a multi-line if/elsif condition are aligned
        # to that parenthesis (the condition tracker records those parens).
        # If the line also closes the parentheses and opens a block (a
        # multi-line parameter list ending in ') is', ') return T is', ') loop',
        # …) the block frame is pushed here, after the line is aligned.
        if self.paren_depth > 0:
            # Drop any parentheses that have already closed.
            while len(self.paren_stack) > 0:
                let stale: (int, int, int) = self.paren_stack[-1]
                if stale[0] > entry_depth:
                    self.paren_stack.pop()
                else:
                    break
            var lead: int = max(0, len(self.stack) + cont) * INDENT_WIDTH
            var entry_top_level: int = 0
            var entry_top_kind: int = -1
            if len(self.paren_stack) > 0:
                let top: (int, int, int) = self.paren_stack[-1]
                let acol: int = top[1]
                entry_top_level = top[0]
                entry_top_kind = top[2]
                if top[2] != 0 and code_s.startswith(")"):
                    # A line that begins by closing an '(if'/'(case'/'(for'
                    # expression aligns the ')' under the opening '(' — one column
                    # left of the keyword that acol points at — rather than taking
                    # the body/condition continuation indent.
                    lead = max(0, acol - 1)
                elif top[2] == 1:
                    if lw == "then" or lw == "else" or lw == "elsif":
                        lead = acol
                    else:
                        # Condition continuation: one indent level past the 'if'
                        # (so it sits one level in from the then/else, which
                        # align with the 'if'). Uses INDENT_WIDTH, not the literal
                        # width of 'if ', to stay consistent with the case-expr
                        # arms below and the if-statement condition continuation.
                        lead = acol + INDENT_WIDTH
                elif top[2] == 2:
                    if lw == "when":
                        lead = acol + INDENT_WIDTH
                    else:
                        lead = acol + 2 * INDENT_WIDTH
                        # An arm body spanning several lines is an expression: a
                        # continuation line that starts with an operator (or else,
                        # and then, &, …) takes one extra level past the arm body,
                        # exactly as inside a plain parenthesis. A leading '=>' is
                        # excluded — that is the arm's result arrow (its choices
                        # spilled onto earlier lines), which stays at the arm-body
                        # level rather than being treated as an operator.
                        if starts_with_operator(code_s) and not code_s.startswith("=>"):
                            lead += INDENT_WIDTH
                elif top[2] == 3:
                    # '(for some/all … => predicate' (a quantified expression) or
                    # '(for I in … => value' (an iterated component): the body
                    # after the iterator sits one level past the 'for', mirroring
                    # the '(if'/'(case' bodies. A leading operator takes one more
                    # level; a leading '=>' (the predicate arrow spilled onto its
                    # own line) stays at the body level.
                    lead = acol + INDENT_WIDTH
                    if starts_with_operator(code_s) and not code_s.startswith("=>"):
                        lead += INDENT_WIDTH
                else:
                    # A named association whose value spilled past a trailing
                    # '=>' (arrow_level marks the paren it happened in) starts its
                    # value one level past the item column; everything else is a
                    # plain list item at the item column.
                    let vbase: int = acol + (INDENT_WIDTH if self.arrow_level == top[0] else 0)
                    lead = vbase
                    # A continuation that starts with an operator (&, +, and, or
                    # else, …) takes one extra level past the value/items. A '(' on
                    # a continuation line is the argument list of the expression on
                    # the previous line (which ended without ','), so it also nests
                    # one level deeper.
                    if starts_with_operator(code_s):
                        lead = vbase + INDENT_WIDTH
                    elif code_s.startswith("(") and self.paren_cont:
                        lead = vbase + INDENT_WIDTH
            let new_depth: int = self.paren_depth + paren_delta(code)
            let plt: str = last_word(code_s)
            self.in_cont = stmt_incomplete(code_s)
            # Track whether this line ended without a comma: if so, a '(' opening
            # the next line is the argument list of the expression here (not a new
            # list element) and deserves an extra indent level inside plain parens.
            self.paren_cont = self.in_cont and not code_s.endswith(",")
            self.paren_depth = max(0, new_depth)
            # Track the named-association arrow spill state:
            # - A plain-paren line that ends with '=>' (value on next line): arm
            #   that spill for this paren level so following lines align to value.
            # - A line that ends with ',' closes the association: clear the spill.
            # - When the paren itself closes (depth drops): clear.
            if entry_top_kind == 0:
                if code_s.endswith("=>"):
                    self.arrow_level = entry_top_level
                elif self.arrow_level == entry_top_level and code_s.endswith(","):
                    self.arrow_level = 0
            if self.arrow_level > 0 and self.paren_depth < self.arrow_level:
                self.arrow_level = 0
            # Record this line's lead for aligning comments that follow it.
            self.paren_last_lead = lead
            self.paren_last_lead_depth = entry_depth
            self._push_parens(emit_text, lead, entry_depth, self.paren_depth)
            # A line that closes back out of all parentheses and ends in a block
            # opener opens that block.
            if new_depth <= 0:
                if self.cond_state > 0 and plt == "then":
                    # A multi-line if/elsif condition closed its parens and
                    # reached 'then' on the same line: end it like cond_state.
                    if self.cond_state == 1:
                        self.stack.append(IF_)
                    self.cond_state = 0
                else:
                    case plt:
                        when "is":
                            self.stack.append(CASE_ if lw == "case" else PKG)
                        when "then":
                            self.stack.append(IF_)
                        when "loop":
                            self.stack.append(LOOP_)
                        when "record":
                            if lw != "null":
                                self.stack.append(RECORD_)
                        when "select":
                            self.stack.append(SELECT_)
                        when "do":
                            self.stack.append(DO_)
                        when others:
                            pass
            return " " * lead + emit_text

        # Multi-line if/elsif condition (outside any parenthesis): continuation
        # lines are one level deeper than the 'if'/'elsif'. When 'then' appears
        # the IF frame is pushed (for 'if' only — for 'elsif' it is already on
        # the stack) and 'then' snaps back to the opener level. Parens opened in
        # the condition are recorded so the lines inside them are aligned by the
        # branch above.
        if self.cond_state > 0:
            let last: str = last_word(code_s)
            if last == "then" or lw == "then":
                disp = self.cond_base
                if self.cond_state == 1:
                    self.stack.append(IF_)
                self.cond_state = 0
            elif is_term_continuation(code_s) and lw != "and" and lw != "or":
                # A line that continues the previous term across the break (>=,
                # &, '(', …) nests one level past the line that holds that term
                # — which may be the opener itself (call name on the 'if'/'elsif'
                # line) or a preceding 'and then' connective line. 'and not' /
                # 'or not' are excluded here even though is_term_continuation
                # returns True for them: inside a condition they are connectives,
                # not value operators.
                disp = self.cond_value_base + 1
            else:
                # The 'and'/'or'/'xor' connectives join condition terms and sit
                # at the base continuation level. Each starts a fresh term, so a
                # following term continuation nests one level past this line.
                disp = self.cond_base + 1
                self.cond_value_base = self.cond_base + 1
            self.in_cont = False
            # cond_state lines are outside parentheses (inside-paren lines are
            # handled above), so they use only the if/elsif-relative depth — no
            # 'cont', which could otherwise leak in from a preceding paren line.
            let lead_c: int = max(0, disp) * INDENT_WIDTH
            self.paren_depth = max(0, self.paren_depth + paren_delta(code))
            self._push_parens(emit_text, lead_c, entry_depth, self.paren_depth)
            return " " * lead_c + emit_text

        case lw:
            when "end":
                while len(self.stack) > 0 and self.stack[-1] == WHEN_:
                    self.stack.pop()
                if len(self.stack) > 0:
                    self.stack.pop()
                disp = len(self.stack)

            when "begin":
                if len(self.stack) > 0 and (self.stack[-1] == PKG or self.stack[-1] == DECLARE_):
                    disp = len(self.stack) - 1
                    self.stack[-1] = BLOCK
                else:
                    disp = len(self.stack)
                    self.stack.append(BLOCK)

            when "when":
                if len(self.stack) > 0 and self.stack[-1] == WHEN_:
                    self.stack.pop()
                disp = len(self.stack)
                self.stack.append(WHEN_)

            when "elsif":
                disp = len(self.stack) - 1
                let last_e: str = last_word(code_s)
                if last_e != "then":
                    self.cond_state = 2
                    self.cond_base = disp
                    self.cond_value_base = disp

            when "else" | "exception" | "or" | "private":
                if cont == 0:
                    disp = len(self.stack) - 1

            when others:
                disp = len(self.stack)
                let last: str = last_word(code_s)
                # A trailing block keyword opens a block only when it sits at the
                # top level of the line. If the line ends with a net-open '(' the
                # keyword is inside that parenthesis — part of an expression such
                # as ':= (case X is' or ':= (if C then' — so it must NOT push a
                # block frame (which would shift every following line).
                let opens_paren: bool = paren_delta(code) > 0
                if not opens_paren:
                    case last:
                        when "is":
                            # A 'function ... is' header may be a real body or an
                            # expression function; defer the decision to the next
                            # line (see pending_spec handling above). Everything
                            # else ending in 'is' opens a block immediately.
                            if lw == "function":
                                self.pending_spec = True
                            else:
                                self.stack.append(CASE_ if lw == "case" else PKG)
                        when "then":
                            self.stack.append(IF_)
                        when "loop":
                            self.stack.append(LOOP_)
                        when "record":
                            if lw != "null":
                                self.stack.append(RECORD_)
                        when "select":
                            self.stack.append(SELECT_)
                        when "do":
                            self.stack.append(DO_)
                        when "declare":
                            self.stack.append(DECLARE_)
                        when others:
                            pass
                if lw == "if" and last != "then":
                    self.cond_state = 1
                    self.cond_base = disp
                    self.cond_value_base = disp

        # A multi-line if/elsif condition is tracked by cond_state, not here, so
        # only flag a general statement continuation when not in that mode.
        self.in_cont = False if self.cond_state > 0 else stmt_incomplete(code_s)
        self.paren_depth = max(0, self.paren_depth + paren_delta(code))
        # If this statement line opened a parenthesis and the text inside it ends
        # without a comma, the expression that is the paren's first item is not
        # finished — its argument list '(' on the next line is a continuation, not
        # a new list element, so it nests one level deeper. (When no paren is open
        # the next line resets this flag on entry, so setting it here is benign.)
        self.paren_cont = self.in_cont and not code_s.endswith(",")

        # Track where the current statement's value expression begins, so that a
        # term continuation below can nest one level past it. A non-continuation
        # line is the statement head (the expression starts there); a ':=' that
        # leads a continuation line moves the start to that line (the value
        # begins after the ':=').
        if cont == 0:
            self.value_base = disp
        elif code_s.startswith(":="):
            self.value_base = disp + cont

        var lead_n: int = max(0, disp + cont) * INDENT_WIDTH
        # A term continuation (a value operator -, +, &, >=, … or an argument list
        # opening with '(') continues the value expression, so it sits one level
        # past where that expression began (value_base). This nests it under the
        # line it continues — e.g. the '- …' / '(args)' under a continued ':= F' —
        # while a chain of such continuations all align at the same level rather
        # than escalating. The boolean connectives and bindings (':=', '=>') are
        # excluded by is_term_continuation and keep the plain continuation level,
        # so they align with any comments that document them. Applied before
        # _push_parens so the inner items align to this line's '('.
        if cont > 0 and is_term_continuation(code_s):
            lead_n = max(0, self.value_base + 1) * INDENT_WIDTH
        # A '|' continuation extends a 'when' choice list ('when A | B' split
        # before the '=>'). The WHEN_ frame already provides the indent, so it
        # aligns at the arm-body level (the frame depth) rather than taking the
        # 'cont' bonus on top, which would push it past the body.
        if cont > 0 and code_s.startswith("|"):
            lead_n = max(0, disp) * INDENT_WIDTH
        self._push_parens(emit_text, lead_n, entry_depth, self.paren_depth)
        " " * lead_n + emit_text


# ---------------------------------------------------------------------------
# Self-tests
# ---------------------------------------------------------------------------

def run_tests() -> int:
    var passed: int = 0
    var failed: int = 0

    # Each case: messy input (any indentation) -> canonical output.
    var cases: [](str, str) = []

    # 1. Subprogram with if/elsif/else, loop, and case.
    cases.append((
        "procedure Hello is\n"
        "X : Integer := 0;\n"
        "begin\n"
        "if X = 0 then\n"
        "Put_Line (\"zero\");\n"
        "elsif X > 0 then\n"
        "Put_Line (\"pos\");\n"
        "else\n"
        "Put_Line (\"neg\");\n"
        "end if;\n"
        "for I in 1 .. 10 loop\n"
        "X := X + I;\n"
        "end loop;\n"
        "case X is\n"
        "when 0 =>\n"
        "null;\n"
        "when others =>\n"
        "Put_Line (\"other\");\n"
        "end case;\n"
        "end Hello;\n",

        "procedure Hello is\n"
        "  X : Integer := 0;\n"
        "begin\n"
        "  if X = 0 then\n"
        "    Put_Line (\"zero\");\n"
        "  elsif X > 0 then\n"
        "    Put_Line (\"pos\");\n"
        "  else\n"
        "    Put_Line (\"neg\");\n"
        "  end if;\n"
        "  for I in 1 .. 10 loop\n"
        "    X := X + I;\n"
        "  end loop;\n"
        "  case X is\n"
        "    when 0 =>\n"
        "      null;\n"
        "    when others =>\n"
        "      Put_Line (\"other\");\n"
        "  end case;\n"
        "end Hello;\n"))

    # 2. Package spec with a record type and a private part.
    cases.append((
        "package Shapes is\n"
        "type Point is record\n"
        "X : Float;\n"
        "Y : Float;\n"
        "end record;\n"
        "private\n"
        "Origin : constant Point := (0.0, 0.0);\n"
        "end Shapes;\n",

        "package Shapes is\n"
        "  type Point is record\n"
        "    X : Float;\n"
        "    Y : Float;\n"
        "  end record;\n"
        "private\n"
        "  Origin : constant Point := (0.0, 0.0);\n"
        "end Shapes;\n"))

    # 3. Declare block with an exception handler, plus blank-line preservation.
    cases.append((
        "declare\n"
        "X : Integer;\n"
        "\n"
        "begin\n"
        "X := 1;\n"
        "exception\n"
        "when Constraint_Error =>\n"
        "X := 0;\n"
        "end;\n",

        "declare\n"
        "  X : Integer;\n"
        "\n"
        "begin\n"
        "  X := 1;\n"
        "exception\n"
        "  when Constraint_Error =>\n"
        "    X := 0;\n"
        "end;\n"))

    # 4. Continuation inside an unclosed parenthesis (aggregate / call) aligns
    #    under the first item after the '('.
    cases.append((
        "procedure P is\n"
        "begin\n"
        "Set (A => 1,\n"
        "B => 2);\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "  Set (A => 1,\n"
        "       B => 2);\n"
        "end P;\n"))

    # 5. Statement/declaration continuation: a line that does not end the
    #    statement (no ';' and not a structural keyword line) indents its
    #    continuation one level; the terminating ';' clears it. (Operator-led
    #    continuations get no extra level outside parentheses — only within.)
    cases.append((
        "package P is\n"
        "Curtains : constant Alternatives_Profiles_T\n"
        ":= Whatever_But_Very_Long;\n"
        "X : Integer := A\n"
        "+ B\n"
        "+ C;\n"
        "end P;\n",

        "package P is\n"
        "  Curtains : constant Alternatives_Profiles_T\n"
        "    := Whatever_But_Very_Long;\n"
        "  X : Integer := A\n"
        "    + B\n"
        "    + C;\n"
        "end P;\n"))

    # 6. Multi-line if/elsif conditions: continuation lines ('and then …') must
    #    indent one level relative to the 'if'/'elsif'; 'then' aligns with the
    #    opener; body and end-if are at the normal depths.
    cases.append((
        "procedure P is\n"
        "begin\n"
        "if A = 1\n"
        "and then B = 2\n"
        "and then C = 3\n"
        "then\n"
        "null;\n"
        "elsif D = 4\n"
        "and then E = 5\n"
        "then\n"
        "null;\n"
        "end if;\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "  if A = 1\n"
        "    and then B = 2\n"
        "    and then C = 3\n"
        "  then\n"
        "    null;\n"
        "  elsif D = 4\n"
        "    and then E = 5\n"
        "  then\n"
        "    null;\n"
        "  end if;\n"
        "end P;\n"))

    # 7. Expression function: 'function ... is' followed by a parenthesised
    #    expression pushes NO block frame, and the declarations after it must
    #    return to the outer level (regression: the spec frame used to linger).
    cases.append((
        "function Image return String is\n"
        "(Compute (A, B'Image));\n"
        "procedure P is\n"
        "begin\n"
        "null;\n"
        "end P;\n",

        "function Image return String is\n"
        "  (Compute (A, B'Image));\n"
        "procedure P is\n"
        "begin\n"
        "  null;\n"
        "end P;\n"))

    # 8. If-expression inside parentheses: 'then'/'else'/'elsif' align under the
    #    'if' itself, condition continuations align under the condition, and the
    #    statement returns to the normal level once the parenthesis closes.
    cases.append((
        "procedure P is\n"
        "begin\n"
        "R := (if Cycle_Of (X)\n"
        "/= Cycle_Of (Y)\n"
        "then Empty\n"
        "else Full);\n"
        "Next_Statement;\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "  R := (if Cycle_Of (X)\n"
        "          /= Cycle_Of (Y)\n"
        "        then Empty\n"
        "        else Full);\n"
        "  Next_Statement;\n"
        "end P;\n"))

    # 9. Subunit with a multi-line parameter list. The 'separate (Parent)'
    #    clause is a complete line (must NOT make the body indent), the
    #    parameter continuations align under the first parameter, and the
    #    closing ') is' still opens the body frame so the declarations indent.
    cases.append((
        "separate (Flight.Behaviour)\n"
        "procedure P (A : Integer;\n"
        "B : Integer) is\n"
        "X : Integer;\n"
        "begin\n"
        "null;\n"
        "end P;\n",

        "separate (Flight.Behaviour)\n"
        "procedure P (A : Integer;\n"
        "             B : Integer) is\n"
        "  X : Integer;\n"
        "begin\n"
        "  null;\n"
        "end P;\n"))

    # 10. Case-expression as an expression-function body. 'when' clauses are
    #     indented one level in from the 'case', and a clause body on its own
    #     line ('=> ...') one level deeper still.
    cases.append((
        "function F return T is\n"
        "(case X is\n"
        "when A | B\n"
        "=> R1,\n"
        "when others => R2);\n",

        "function F return T is\n"
        "  (case X is\n"
        "     when A | B\n"
        "       => R1,\n"
        "     when others => R2);\n"))

    # 11. Operator-led continuations take an extra level ONLY within parentheses:
    #     the '=> ...' arms inside the else-aggregate sit one level past the
    #     items, while the bare ':=' continuation gets the plain +1 (no extra).
    cases.append((
        "package P is\n"
        "X : T\n"
        ":= (if A\n"
        "then (others => True)\n"
        "else (K1\n"
        "=> V1,\n"
        "K2\n"
        "=> V2));\n"
        "end P;\n",

        "package P is\n"
        "  X : T\n"
        "    := (if A\n"
        "        then (others => True)\n"
        "        else (K1\n"
        "                => V1,\n"
        "              K2\n"
        "                => V2));\n"
        "end P;\n"))

    # 12. Operator-led extra indent applies ONLY inside parentheses. The 'and'
    #     continuation outside the paren takes a plain single level (aligned with
    #     where a comment would sit), while the 'or else' inside the paren takes
    #     the extra level past the aligned items.
    cases.append((
        "function F return Boolean is\n"
        "begin\n"
        "return A\n"
        "and (B = C\n"
        "or else D = E);\n"
        "end F;\n",

        "function F return Boolean is\n"
        "begin\n"
        "  return A\n"
        "    and (B = C\n"
        "           or else D = E);\n"
        "end F;\n"))

    # 13. Parentheses opened inside a multi-line if-statement condition: the
    #     lines within them are aligned to the paren (with the operator extra),
    #     not flattened to the condition level; 'then' still snaps to the 'if'.
    cases.append((
        "procedure P is\n"
        "begin\n"
        "if A\n"
        "and then (B\n"
        "or else (C\n"
        "and then D))\n"
        "then\n"
        "null;\n"
        "end if;\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "  if A\n"
        "    and then (B\n"
        "                or else (C\n"
        "                           and then D))\n"
        "  then\n"
        "    null;\n"
        "  end if;\n"
        "end P;\n"))

    # 14. Comment lines are transparent to the parser: comments interrupting a
    #     statement continuation must not clear it, so the 'and (...' continuation
    #     after the comments still gets its continuation indent relative to
    #     'return'. The comments themselves, being OUTSIDE any paren, are indented
    #     like a new instruction — at the block level (with 'return') — not at the
    #     continuation indent. Comments INSIDE the paren follow the paren's lines.
    cases.append((
        "function F return Boolean is\n"
        "begin\n"
        "return New_OBT > Old_OBT\n"
        "-- comment one\n"
        "-- comment two\n"
        "and (Departure.Earliest_TTOT = None\n"
        "-- inner comment\n"
        "or else New_OBT > X);\n"
        "end F;\n",

        "function F return Boolean is\n"
        "begin\n"
        "  return New_OBT > Old_OBT\n"
        "  -- comment one\n"
        "  -- comment two\n"
        "    and (Departure.Earliest_TTOT = None\n"
        "         -- inner comment\n"
        "           or else New_OBT > X);\n"
        "end F;\n"))

    # 15. A declaration whose initializer is a parenthesised '(case X is …' (or
    #     '(if … )') expression ends in the keyword 'is'/'then', but that keyword
    #     is INSIDE the open '(' — it must NOT push a block frame. Otherwise the
    #     declarations that follow (here a nested expression function and another
    #     constant) would be shifted one level too deep for the rest of the unit.
    cases.append((
        "procedure G is\n"
        "Origin : constant T := (case E is\n"
        "when A => X,\n"
        "when others => Y);\n"
        "function F return T is\n"
        "(if C\n"
        "then P\n"
        "else Q);\n"
        "Id : constant T := Z;\n"
        "begin\n"
        "null;\n"
        "end G;\n",

        "procedure G is\n"
        "  Origin : constant T := (case E is\n"
        "                            when A => X,\n"
        "                            when others => Y);\n"
        "  function F return T is\n"
        "    (if C\n"
        "     then P\n"
        "     else Q);\n"
        "  Id : constant T := Z;\n"
        "begin\n"
        "  null;\n"
        "end G;\n"))

    # 16. Multi-line case-expression arm body. The arm body is an expression:
    #     its first line sits at the arm-body level (one in from 'when'), and a
    #     continuation that starts with an operator ('or else') takes one extra
    #     level. A leading '=>' (the result arrow for choices spilled onto an
    #     earlier line) stays at the arm-body level, not the operator level.
    cases.append((
        "function F return Boolean is\n"
        "(case S is\n"
        "when A | B\n"
        "=> P,\n"
        "when others =>\n"
        "X\n"
        "or else Y\n"
        "or else (Z\n"
        "and then W));\n",

        "function F return Boolean is\n"
        "  (case S is\n"
        "     when A | B\n"
        "       => P,\n"
        "     when others =>\n"
        "       X\n"
        "         or else Y\n"
        "         or else (Z\n"
        "                    and then W));\n"))

    # 17. A continuation line that opens with '(' is the argument list of the
    #     expression it continues, so it nests one level deeper than the bare
    #     continuation above it (here the '(' under a continued ':= F'); the
    #     arguments then align to that '('.
    cases.append((
        "package P is\n"
        "Set_Info : constant T\n"
        ":= Get\n"
        "(Query => Q,\n"
        "Object => O);\n"
        "end P;\n",

        "package P is\n"
        "  Set_Info : constant T\n"
        "    := Get\n"
        "      (Query => Q,\n"
        "       Object => O);\n"
        "end P;\n"))

    # 17b. A '(' continuation nests only one level past the line it continues.
    #      When the call name is the statement's FIRST line (not itself a
    #      continuation), its argument list takes the plain +1 — not the extra
    #      second level that test 17's ':= Get' chain gets.
    cases.append((
        "procedure P is\n"
        "begin\n"
        "Foo\n"
        "(A,\n"
        "B);\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "  Foo\n"
        "    (A,\n"
        "     B);\n"
        "end P;\n"))

    # 18. Block/loop labels end in ':' and are complete prefixes, not statement
    #     continuations: the labelled 'declare' / 'for … loop' stays at the
    #     label's level (a trailing comment on the label is ignored). Without
    #     this the label would push the following line one level too deep.
    cases.append((
        "procedure P is\n"
        "begin\n"
        "Log_Changes:\n"
        "declare\n"
        "X : Integer;\n"
        "begin\n"
        "Find_Model : -- pick the model\n"
        "for M in reverse T loop\n"
        "null;\n"
        "end loop Find_Model;\n"
        "end Log_Changes;\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "  Log_Changes:\n"
        "  declare\n"
        "    X : Integer;\n"
        "  begin\n"
        "    Find_Model : -- pick the model\n"
        "    for M in reverse T loop\n"
        "      null;\n"
        "    end loop Find_Model;\n"
        "  end Log_Changes;\n"
        "end P;\n"))

    # 19. Multi-line if condition: 'and then' connectives sit at the base
    #     continuation level, but a line starting with another operator ('>=')
    #     continues the previous term across the break and nests one level
    #     deeper. A comment between the lines stays transparent and, being
    #     outside any paren, is indented like a new instruction — at the 'if'
    #     (block) level — not at the condition-continuation indent.
    cases.append((
        "procedure P is\n"
        "begin\n"
        "if A\n"
        "and then Take_Off_Time (X)\n"
        "-- a comment\n"
        ">= Take_Off_Time (Y)\n"
        "then\n"
        "null;\n"
        "end if;\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "  if A\n"
        "    and then Take_Off_Time (X)\n"
        "  -- a comment\n"
        "      >= Take_Off_Time (Y)\n"
        "  then\n"
        "    null;\n"
        "  end if;\n"
        "end P;\n"))

    # 20. An if-EXPRESSION's 'else …)' line closes the expression and continues
    #     the surrounding statement (it is not a complete statement-level
    #     'else'), so the following '& …;' stays at the continuation level
    #     rather than dropping back to the declaration's base level.
    cases.append((
        "package P is\n"
        "Name : constant String := A\n"
        "& (if C\n"
        "then \"0\"\n"
        "else Trim (X))\n"
        "& \"_\";\n"
        "end P;\n",

        "package P is\n"
        "  Name : constant String := A\n"
        "    & (if C\n"
        "       then \"0\"\n"
        "       else Trim (X))\n"
        "    & \"_\";\n"
        "end P;\n"))

    # 21. A 'when' choice list split before its '=>': the '|' continuation
    #     aligns at the arm-body level (the WHEN_ frame already provides the
    #     indent), not one level deeper.
    cases.append((
        "procedure P is\n"
        "begin\n"
        "case X is\n"
        "when Action_1 | Action_15\n"
        "| Action_16 | Action_43 =>\n"
        "Do_It;\n"
        "end case;\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "  case X is\n"
        "    when Action_1 | Action_15\n"
        "      | Action_16 | Action_43 =>\n"
        "      Do_It;\n"
        "  end case;\n"
        "end P;\n"))

    # 22. General term-continuation nesting (not just in conditions): when the
    #     ':=' initializer is on its own continuation line, an operator that
    #     continues the value ('- …') nests one level past the ':=' line.
    cases.append((
        "package P is\n"
        "Delta_X : constant Duration_T\n"
        ":= Take_Off_Time (Curtains (Normal) (RTFM))\n"
        "- Take_Off_Time (Flight, FTFM);\n"
        "end P;\n",

        "package P is\n"
        "  Delta_X : constant Duration_T\n"
        "    := Take_Off_Time (Curtains (Normal) (RTFM))\n"
        "      - Take_Off_Time (Flight, FTFM);\n"
        "end P;\n"))

    # 23. A '(' argument list opening a continuation inside a multi-line if
    #     condition nests one level past the 'and then' term it belongs to; its
    #     arguments then align to that '('.
    cases.append((
        "procedure P is\n"
        "begin\n"
        "if A\n"
        "and then Curtain_Index_May_Differ\n"
        "(Left (Normal) (FTFM),\n"
        "Right (FTFM),\n"
        "Skip => True)\n"
        "then\n"
        "null;\n"
        "end if;\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "  if A\n"
        "    and then Curtain_Index_May_Differ\n"
        "      (Left (Normal) (FTFM),\n"
        "       Right (FTFM),\n"
        "       Skip => True)\n"
        "  then\n"
        "    null;\n"
        "  end if;\n"
        "end P;\n"))

    # 23b. The mirror of test 23: when the call name is on the 'elsif'/'if'
    #      opener line itself (not a separate 'and then' continuation), its
    #      split '(' argument list nests one level past the opener — not two.
    #      The 'then' still snaps back to the opener level.
    cases.append((
        "procedure P is\n"
        "begin\n"
        "if X then\n"
        "null;\n"
        "elsif not Traffic_Volume_Profile.Element_Exists\n"
        "(TV_Profiles.P (FTFM), Env_Regulation_Info.TV_Id (Reg_Info))\n"
        "then\n"
        "null;\n"
        "end if;\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "  if X then\n"
        "    null;\n"
        "  elsif not Traffic_Volume_Profile.Element_Exists\n"
        "    (TV_Profiles.P (FTFM), Env_Regulation_Info.TV_Id (Reg_Info))\n"
        "  then\n"
        "    null;\n"
        "  end if;\n"
        "end P;\n"))

    # 24. A ')' (or '(') written as a character literal must not be counted in
    #     the running parenthesis depth, otherwise the enclosing '(if …)'
    #     expression looks closed and its 'else' loses the alignment under 'if'.
    cases.append((
        "procedure P is\n"
        "begin\n"
        "X := (A\n"
        "& (if C\n"
        "then B & ')'\n"
        "else \"\"));\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "  X := (A\n"
        "          & (if C\n"
        "             then B & ')'\n"
        "             else \"\"));\n"
        "end P;\n"))

    # 25. 'and not' / 'or not' are value operators (bit-clear / boolean negate),
    #     not connectives like 'and then' / 'or else'. When ':=' is on its own
    #     continuation line they nest one extra level past ':='; bare 'and' / 'or'
    #     stay at the plain continuation level.
    cases.append((
        "procedure P is\n"
        "begin\n"
        "Mask (K)\n"
        ":= (Mask (K) or Initially_Flagged)\n"
        "and not Initially_Not_Interesting\n"
        "and not Clear_Aspects;\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "  Mask (K)\n"
        "    := (Mask (K) or Initially_Flagged)\n"
        "      and not Initially_Not_Interesting\n"
        "      and not Clear_Aspects;\n"
        "end P;\n"))

    # 27. Inside a plain paren, a '(' that continues the preceding expression
    #     (previous line ended without ',') is the argument list of that
    #     expression, not a new list element: it nests one extra level past the
    #     item column. Here the else-branch of an if-expression calls Convert
    #     whose argument list is split to the next line.
    cases.append((
        "procedure P is\n"
        "Coordination_Fix : constant Def_Location.T :=\n"
        "(if C\n"
        "then (Def_Location.GPS, X => Y)\n"
        "else (Def_Location.ICAO_Aerodrome,\n"
        "Aerodrome => Def_Aerodrome.Convert\n"
        "(Env_Location.Value (A))));\n"
        "begin\n"
        "null;\n"
        "end P;\n",

        "procedure P is\n"
        "  Coordination_Fix : constant Def_Location.T :=\n"
        "    (if C\n"
        "     then (Def_Location.GPS, X => Y)\n"
        "     else (Def_Location.ICAO_Aerodrome,\n"
        "           Aerodrome => Def_Aerodrome.Convert\n"
        "             (Env_Location.Value (A))));\n"
        "begin\n"
        "  null;\n"
        "end P;\n"))

    # 28. 'or else' / 'and then' continuations in a value expression must NOT
    #     trigger the structural 'or'/'else' de-indent (which only applies when
    #     they stand alone as statement-level keywords). With ':=' on its own
    #     continuation line the value expression begins one level past it, so the
    #     'or else' connective nests there (6 spaces), one level past the ':='.
    cases.append((
        "package P is\n"
        "X : constant Boolean\n"
        ":= True\n"
        "or else False;\n"
        "end P;\n",

        "package P is\n"
        "  X : constant Boolean\n"
        "    := True\n"
        "      or else False;\n"
        "end P;\n"))

    # 29. 'and (' combines the preceding result with a parenthesised subexpression
    #     and is a term continuation: when ':=' is on its own continuation line,
    #     'and (' nests one extra level past ':=' (value_base + 1), just like
    #     'and not' / 'or not'.
    cases.append((
        "package P is\n"
        "X : constant Boolean\n"
        ":= (A = B)\n"
        "and (C = D);\n"
        "end P;\n",

        "package P is\n"
        "  X : constant Boolean\n"
        "    := (A = B)\n"
        "      and (C = D);\n"
        "end P;\n"))

    # 30. A multi-line boolean value expression after a ':='-on-its-own-line:
    #     each 'or else' connective joins a parenthesised operand group and sits
    #     one level past the ':='. The comments interleaved between the groups are
    #     OUTSIDE any paren (the groups have closed), so they are indented like a
    #     new instruction — at the declaration's block level — not at the 'or else'
    #     continuation level. Inside each group the 'and then' lines align to the
    #     group's open paren.
    cases.append((
        "package P is\n"
        "X : constant Boolean\n"
        ":= (A\n"
        "and then B)\n"
        "-- comment one\n"
        "-- comment two\n"
        "or else (C\n"
        "and then D)\n"
        "-- comment three\n"
        "or else not E;\n"
        "end P;\n",

        "package P is\n"
        "  X : constant Boolean\n"
        "    := (A\n"
        "          and then B)\n"
        "  -- comment one\n"
        "  -- comment two\n"
        "      or else (C\n"
        "                 and then D)\n"
        "  -- comment three\n"
        "      or else not E;\n"
        "end P;\n"))

    # 31. A quantified expression '(for some/all … => predicate)': the predicate
    #     after '=>' nests one level past the 'for' keyword (like an '(if'/'(case'
    #     body), not flush with it as a plain-paren first item would. The iterator
    #     spec's own nested call parens close on the same line and don't affect it.
    cases.append((
        "package P is\n"
        "Any_Concerned : constant Boolean\n"
        ":= (for some Reg of All_Regs (1 .. N) =>\n"
        "not Reg.Excluded);\n"
        "end P;\n",

        "package P is\n"
        "  Any_Concerned : constant Boolean\n"
        "    := (for some Reg of All_Regs (1 .. N) =>\n"
        "          not Reg.Excluded);\n"
        "end P;\n"))

    # 32. A '(' arg list that continues an expression which is itself the first
    #     item of an outer '(' opened on the SAME statement line. The outer call's
    #     argument (G.Image) is unfinished (the line ends without a comma), so its
    #     own argument list '(' on the next line nests one level past the outer
    #     paren's item column — not flush with it as a new list element would.
    cases.append((
        "procedure P is\n"
        "begin\n"
        "Id := F (G.Image\n"
        "(H (X),\n"
        "Width => W));\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "  Id := F (G.Image\n"
        "             (H (X),\n"
        "              Width => W));\n"
        "end P;\n"))

    # 33. A named association whose value spills past a trailing '=>' into the
    #     next line: the value nests one level past the item column; operators
    #     that continue it take one more level; interleaved comments align with
    #     the operator lines they document; the following association starts a
    #     new item at the outer column once its comma closes the current one.
    cases.append((
        "procedure P is\n"
        "begin\n"
        "Call (A => 1,\n"
        "B =>\n"
        "X\n"
        "and Y\n"
        "-- comment\n"
        "and Z,\n"
        "C => 3);\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "  Call (A => 1,\n"
        "        B =>\n"
        "          X\n"
        "            and Y\n"
        "            -- comment\n"
        "            and Z,\n"
        "        C => 3);\n"
        "end P;\n"))

    # 34. A line that closes a parenthesised if-expression with a lone ')' (often
    #     after a trailing comment) aligns the ')' under the opening '(' — one
    #     column left of the 'if'/'then'/'else' keywords — rather than taking the
    #     condition-continuation indent that would push it right of them.
    cases.append((
        "procedure P is\n"
        "begin\n"
        "X := (if C\n"
        "then A\n"
        "else B\n"
        "-- a trailing note\n"
        ");\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "  X := (if C\n"
        "        then A\n"
        "        else B\n"
        "        -- a trailing note\n"
        "       );\n"
        "end P;\n"))

    for pair in cases:
        let src: str = pair[0]
        let want: str = pair[1]
        var ind: Indenter = Indenter()
        let got: str = "\n".join([ind.indent_line(line) for line in src.split("\n")])
        if got == want:
            passed += 1
        else:
            failed += 1
            print "FAIL:"
            print "--- expected ---"
            print want
            print "--- got ---"
            print got

    print f"{passed} passed, {failed} failed"
    if failed > 0:
        result = 1


def main() -> int:
    var ind: Indenter = Indenter()
    if $# < 1:
        for line in stdin.lines:
            print ind.indent_line(line)
    else:
        let arg: str = $1
        if arg == "--test":
            result = run_tests()
        else:
            with open(arg) as f:
                for line in f:
                    print ind.indent_line(line)


if __name__ == "__main__":
    quit(main())
