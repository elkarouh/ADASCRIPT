#!/usr/bin/env py2nim
#ady2nim-args c -d:release --opt:speed
# ada_indent.ady — a simplified Ada source re-indenter, written in Adascript.
#
# This is NOT a full Ada parser. It implements only the slice of Ada grammar
# that matters for indentation: the keywords that open, close, or split an
# indented block. Everything else is treated as an ordinary statement line.
#
# The model is a stack machine. Each open construct pushes a frame; the
# display indent of a line is the stack depth (times the indent width), with
# small adjustments for keywords that align with their opener rather than the
# block body (end / elsif / else / when / exception / or / private / begin).
#
# See README.md in this directory for the simplified grammar specification.
#
# Usage:
#   py2nim ADA_INDENT/ada_indent.ady -r -- file.adb   # compile if stale, reindent a file
#   py2nim ADA_INDENT/ada_indent.ady -r -- --test     # compile if stale, run self-tests
#
# The core logic (reindent + helpers) is pure Adascript and transpiles to
# both Python and Nim. The CLI uses the bash-style argument primitives
# ($1, $#, quit) so argument handling is target-agnostic.

const INDENT_WIDTH: int = 2

# The indentation-significant constructs. A frame is pushed for each open
# block; the kind is only consulted where it changes behaviour (PKG/DECLARE
# become BLOCK at 'begin'; WHEN frames are popped specially at 'end').
type Block_T is enum:
    PKG          # package / subprogram / task / protected / type spec opened by trailing 'is'
    DECLARE_     # a declare block (block label or bare 'declare')
    BLOCK        # a begin ... end region (statement part)
    IF_          # if ... then
    LOOP_        # [while/for] ... loop
    CASE_        # case ... is
    WHEN_        # when ... =>   (case alternative or exception handler)
    RECORD_      # record  ... end record
    SELECT_      # select ... end select
    DO_          # accept ... do  /  return ... do  (extended return)

# Scanner state for string-literal tracking inside a single line.
type Scan_T is enum:
    CODE        # outside any string literal
    STRING_LIT  # inside a double-quoted string literal


# ---------------------------------------------------------------------------
# Lexical helpers — all work on a single physical line.
# ---------------------------------------------------------------------------

def pairwise(s: str) -> (char, char):
    for i in s'First..<s'Last:
        yield (s[i], s[i + 1])


def strip_code(line: str) -> str:
    """Return the line with any '--' comment removed, string literals kept.

    Quote handling is deliberately simple: it tracks double-quoted strings so
    that a '--' inside a string is not mistaken for a comment. Character
    literals and doubled-quote escapes are not modelled (rare in practice).
    """
    var state: Scan_T = CODE
    for c, next_c in pairwise(line + " "):
        case state:
            when CODE:
                if c == '-' and next_c == '-':
                    break
                result += c
                if c == '"':
                    state = STRING_LIT
            when STRING_LIT:
                result += c
                if c == '"':
                    state = CODE


def paren_delta(line: str) -> int:
    """Net '(' minus ')' on the line, ignoring parens inside string literals.

    The input must already have comments removed (see strip_code), so only
    string literals need to be skipped here.
    """
    var state: Scan_T = CODE
    for c in line:
        case state:
            when CODE:
                case c:
                    when '"':
                        state = STRING_LIT
                    when "(":
                        result += 1
                    when ")":
                        result -= 1
                    when others:
                        pass
            when STRING_LIT:
                case c:
                    when '"':
                        state = CODE
                    when others:
                        pass


def lead_word(code: str) -> str:
    """Lowercased leading identifier of a (comment-stripped) line, or ''."""
    for ch in code.strip().lower():
        if ch.isalpha() or ch == "_":
            result += ch
        else:
            break


def last_word(code: str) -> str:
    """Lowercased final token, after dropping a trailing ';'. '' if empty."""
    let parts: []str = code.strip().rstrip(";").split()
    if len(parts) > 0:
        result = parts[-1].lower()


def stmt_incomplete(code_s: str) -> bool:
    """True if a (comment-stripped) code line continues onto the next line.

    In Ada nearly every statement and declaration ends with ';'. The only
    unterminated lines that are nonetheless complete are the structural keyword
    lines: openers ending in is/then/loop/record/select/do, choice lines ending
    in '=>', and the lone splitter/opener keywords (begin/declare/else/…). Any
    other line that does not end in ';' is a logical line split across physical
    lines, so the next line is a continuation.
    """
    if code_s == "" or code_s.endswith(";") or code_s.endswith("=>"):
        return False
    let lw: str = lead_word(code_s)
    # Lone splitter/opener keyword lines and compilation-unit prefixes
    # ('separate (Parent)') are complete despite having no ';'.
    if (lw == "begin" or lw == "declare" or lw == "else" or lw == "exception"
            or lw == "or" or lw == "private" or lw == "select" or lw == "separate"):
        return False
    let lt: str = last_word(code_s)
    # Block openers, plus the '[not] overriding' indicator on its own line.
    if (lt == "is" or lt == "then" or lt == "loop" or lt == "record"
            or lt == "select" or lt == "do" or lt == "overriding"):
        return False
    result = True


def starts_with_operator(code_s: str) -> bool:
    """True if the line begins with a binary/assignment operator — either a
    symbol (:=, =>, =, &, +, -, *, /, <, >, |, ..) or a word operator
    (and, or, xor, mod, rem, covering 'and then'/'or else'). Such a continuation
    takes one extra indent level so it stands out from the operand it continues."""
    if code_s == "":
        return False
    let c0: char = code_s[0]
    if c0 == ':':
        return len(code_s) > 1 and code_s[1] == '='   # ':=', not a bare ':'
    if c0 == '.':
        return len(code_s) > 1 and code_s[1] == '.'   # '..' range
    if (c0 == '=' or c0 == '&' or c0 == '+' or c0 == '-' or c0 == '*'
            or c0 == '/' or c0 == '<' or c0 == '>' or c0 == '|'):
        return True
    let w: str = lead_word(code_s)
    return w == "and" or w == "or" or w == "xor" or w == "mod" or w == "rem"


def starts_with_bool_operator(code_s: str) -> bool:
    """True if the line begins with a boolean word operator: and / or / xor
    (covering 'and then' and 'or else'). Used for the extra indent of a
    statement continuation *outside* parentheses, where only boolean operators
    qualify — an assignment/arithmetic continuation (e.g. a bare ':=') keeps the
    plain one-level continuation indent."""
    let w: str = lead_word(code_s)
    return w == "and" or w == "or" or w == "xor"


def scan_parens(text: str, base_depth: int, base_col: int) -> [](int, int, int):
    """Find every '(' opened in a line and how its continuations should align.

    Returns one tuple (paren_level, align_col, kind) per opening parenthesis:
    paren_level is the depth just inside the '(', align_col is the absolute
    output column to align continuations to (base_col is the column at which
    text[0] renders), and kind is 0 for a plain parenthesis, 1 for '(if' and 2
    for '(case'. For a plain '(' the alignment column is the first non-blank
    character after it (the first item), or one indent level in if the '(' ends
    the line. For '(if'/'(case' the column is the keyword itself, which the
    caller offsets per the expression's syntax. Parentheses inside string
    literals are not special-cased, so this is a best-effort scan.
    """
    var openers: [](int, int, int) = []
    var depth: int = base_depth
    var i: int = 0
    let n: int = len(text)
    while i < n:
        let ch: char = text[i]
        if ch == '(':
            depth += 1
            var j: int = i + 1
            while j < n and text[j] == ' ':
                j += 1
            if (j + 1 < n
                    and (text[j] == 'i' or text[j] == 'I')
                    and (text[j + 1] == 'f' or text[j + 1] == 'F')
                    and (j + 2 >= n or not (text[j + 2].isalnum() or text[j + 2] == '_'))):
                openers.append((depth, base_col + j, 1))
            elif (j + 3 < n
                    and (text[j] == 'c' or text[j] == 'C')
                    and (text[j + 1] == 'a' or text[j + 1] == 'A')
                    and (text[j + 2] == 's' or text[j + 2] == 'S')
                    and (text[j + 3] == 'e' or text[j + 3] == 'E')
                    and (j + 4 >= n or not (text[j + 4].isalnum() or text[j + 4] == '_'))):
                openers.append((depth, base_col + j, 2))
            elif j < n:
                openers.append((depth, base_col + j, 0))
            else:
                openers.append((depth, base_col + INDENT_WIDTH, 0))
        elif ch == ')':
            depth -= 1
        i += 1
    return openers


def spaces(levels: int) -> str:
    """A run of spaces for the given number of indent levels (never negative)."""
    " " * (max(0, levels) * INDENT_WIDTH)


# ---------------------------------------------------------------------------
# The indenter proper.
# ---------------------------------------------------------------------------

class Indenter:
    stack: []Block_T = []
    paren_depth: int = 0
    pending_spec: bool = False   # a 'function ... is' header whose body kind is not yet known
    cond_state: int = 0          # 1 = inside multi-line 'if' condition, 2 = 'elsif'
    cond_base: int = 0           # display depth of the opening if/elsif
    in_cont: bool = False        # previous line was an unterminated statement/declaration
    paren_stack: [](int, int, int) = []  # (paren_level, align_col, kind) for every open '('

    def _push_parens(self, text: str, base_col: int, base_depth: int, new_depth: int):
        """Record parentheses opened on this line and drop any now closed."""
        for opener in scan_parens(text, base_depth, base_col):
            self.paren_stack.append(opener)
        while len(self.paren_stack) > 0:
            let top: (int, int, int) = self.paren_stack[-1]
            if top[0] > new_depth:
                self.paren_stack.pop()
            else:
                break

    def indent_line(self, line: str) -> str:
        """Process one raw line and return it re-indented."""
        let raw2: str = line.rstrip()
        let code: str = strip_code(raw2)
        let code_s: str = code.strip()
        let emit_text: str = raw2.strip()

        if emit_text == "":
            return ""

        let entry_depth: int = self.paren_depth
        let cont: int = 1 if (self.paren_depth > 0 or self.in_cont) else 0
        let lw: str = lead_word(code_s)
        var disp: int = len(self.stack)

        # Resolve a deferred 'function ... is' header (set on the previous line).
        # If the body begins with '(' it is an expression function: indent the
        # expression one level and push no frame. Otherwise it is a real
        # subprogram body, so perform the deferred push and fall through.
        if self.pending_spec:
            self.pending_spec = False
            if code_s.startswith("("):
                self.in_cont = False
                let lead_e: int = max(0, len(self.stack) + 1 + cont) * INDENT_WIDTH
                self.paren_depth = max(0, self.paren_depth + paren_delta(code))
                self._push_parens(emit_text, lead_e, entry_depth, self.paren_depth)
                return " " * lead_e + emit_text
            else:
                self.stack.append(PKG)
                disp = len(self.stack)

        # Multi-line if/elsif condition: continuation lines are indented one
        # level deeper than the 'if'/'elsif'. When 'then' finally appears
        # (as lead word or last word) the IF frame is pushed (for 'if' only —
        # for 'elsif' the IF frame is already on the stack) and disp snaps
        # back to the if/elsif level so 'then' aligns with its opener.
        if self.cond_state > 0:
            let last: str = last_word(code_s)
            if last == "then" or lw == "then":
                disp = self.cond_base
                if self.cond_state == 1:
                    self.stack.append(IF_)
                self.cond_state = 0
            else:
                disp = self.cond_base + 1
            self.in_cont = False
            self.paren_depth = max(0, self.paren_depth + paren_delta(code))
            return spaces(disp + cont) + emit_text

        # Inside an unclosed parenthesis the line is a continuation of an
        # expression / list, so statement keywords (then/else/elsif/when) are
        # operators here, not statement parts. It is aligned by absolute column
        # to the innermost open parenthesis:
        #   plain '('  -> under the first item after the '(';
        #   '(if'      -> then/else/elsif under the 'if', condition past it;
        #   '(case'    -> when clauses one level in from the 'case', clause
        #                 bodies one level deeper still.
        # If the line also closes the parentheses and opens a block (a
        # multi-line parameter list ending in ') is', ') return T is', ') loop',
        # …) the block frame is pushed here, after the line is aligned.
        if self.paren_depth > 0:
            # Drop any parentheses that have already closed.
            while len(self.paren_stack) > 0:
                let stale: (int, int, int) = self.paren_stack[-1]
                if stale[0] > entry_depth:
                    self.paren_stack.pop()
                else:
                    break
            var lead: int = max(0, len(self.stack) + cont) * INDENT_WIDTH
            if len(self.paren_stack) > 0:
                let top: (int, int, int) = self.paren_stack[-1]
                let acol: int = top[1]
                if top[2] == 1:
                    if lw == "then" or lw == "else" or lw == "elsif":
                        lead = acol
                    else:
                        lead = acol + 3
                elif top[2] == 2:
                    if lw == "when":
                        lead = acol + INDENT_WIDTH
                    else:
                        lead = acol + 2 * INDENT_WIDTH
                else:
                    lead = acol
                    # A plain-paren continuation that starts with an operator
                    # (=>, &, +, …) takes one extra level past the aligned items.
                    if starts_with_operator(code_s):
                        lead = acol + INDENT_WIDTH
            let new_depth: int = self.paren_depth + paren_delta(code)
            let plt: str = last_word(code_s)
            self.in_cont = stmt_incomplete(code_s)
            self.paren_depth = max(0, new_depth)
            self._push_parens(emit_text, lead, entry_depth, self.paren_depth)
            # A line that closes back out of all parentheses and ends in a block
            # opener (e.g. ') is' on a multi-line parameter list) opens that block.
            if new_depth <= 0:
                case plt:
                    when "is":
                        self.stack.append(CASE_ if lw == "case" else PKG)
                    when "then":
                        self.stack.append(IF_)
                    when "loop":
                        self.stack.append(LOOP_)
                    when "record":
                        if lw != "null":
                            self.stack.append(RECORD_)
                    when "select":
                        self.stack.append(SELECT_)
                    when "do":
                        self.stack.append(DO_)
                    when others:
                        pass
            return " " * lead + emit_text

        case lw:
            when "end":
                while len(self.stack) > 0 and self.stack[-1] == WHEN_:
                    self.stack.pop()
                if len(self.stack) > 0:
                    self.stack.pop()
                disp = len(self.stack)

            when "begin":
                if len(self.stack) > 0 and (self.stack[-1] == PKG or self.stack[-1] == DECLARE_):
                    disp = len(self.stack) - 1
                    self.stack[-1] = BLOCK
                else:
                    disp = len(self.stack)
                    self.stack.append(BLOCK)

            when "when":
                if len(self.stack) > 0 and self.stack[-1] == WHEN_:
                    self.stack.pop()
                disp = len(self.stack)
                self.stack.append(WHEN_)

            when "elsif":
                disp = len(self.stack) - 1
                let last_e: str = last_word(code_s)
                if last_e != "then":
                    self.cond_state = 2
                    self.cond_base = disp

            when "else" | "exception" | "or" | "private":
                disp = len(self.stack) - 1

            when others:
                disp = len(self.stack)
                let last: str = last_word(code_s)
                case last:
                    when "is":
                        # A 'function ... is' header may be a real body or an
                        # expression function; defer the decision to the next
                        # line (see pending_spec handling above). Everything
                        # else ending in 'is' opens a block immediately.
                        if lw == "function":
                            self.pending_spec = True
                        else:
                            self.stack.append(CASE_ if lw == "case" else PKG)
                    when "then":
                        self.stack.append(IF_)
                    when "loop":
                        self.stack.append(LOOP_)
                    when "record":
                        if lw != "null":
                            self.stack.append(RECORD_)
                    when "select":
                        self.stack.append(SELECT_)
                    when "do":
                        self.stack.append(DO_)
                    when "declare":
                        self.stack.append(DECLARE_)
                    when others:
                        pass
                if lw == "if" and last != "then":
                    self.cond_state = 1
                    self.cond_base = disp

        # A multi-line if/elsif condition is tracked by cond_state, not here, so
        # only flag a general statement continuation when not in that mode.
        self.in_cont = False if self.cond_state > 0 else stmt_incomplete(code_s)
        self.paren_depth = max(0, self.paren_depth + paren_delta(code))
        var lead_n: int = max(0, disp + cont) * INDENT_WIDTH
        # A statement continuation that begins with a boolean operator
        # (and / or / xor, incl. 'and then' / 'or else') takes one extra level
        # so the operator stands out from the operand above it. Only boolean
        # operators qualify here, outside parentheses: an assignment continuation
        # such as a bare ':=' keeps the plain one-level indent.
        if cont > 0 and starts_with_bool_operator(code_s):
            lead_n += INDENT_WIDTH
        self._push_parens(emit_text, lead_n, entry_depth, self.paren_depth)
        " " * lead_n + emit_text


# ---------------------------------------------------------------------------
# Self-tests
# ---------------------------------------------------------------------------

def run_tests() -> int:
    var passed: int = 0
    var failed: int = 0

    # Each case: messy input (any indentation) -> canonical output.
    var cases: [](str, str) = []

    # 1. Subprogram with if/elsif/else, loop, and case.
    cases.append((
        "procedure Hello is\n"
        "X : Integer := 0;\n"
        "begin\n"
        "if X = 0 then\n"
        "Put_Line (\"zero\");\n"
        "elsif X > 0 then\n"
        "Put_Line (\"pos\");\n"
        "else\n"
        "Put_Line (\"neg\");\n"
        "end if;\n"
        "for I in 1 .. 10 loop\n"
        "X := X + I;\n"
        "end loop;\n"
        "case X is\n"
        "when 0 =>\n"
        "null;\n"
        "when others =>\n"
        "Put_Line (\"other\");\n"
        "end case;\n"
        "end Hello;\n",

        "procedure Hello is\n"
        "  X : Integer := 0;\n"
        "begin\n"
        "  if X = 0 then\n"
        "    Put_Line (\"zero\");\n"
        "  elsif X > 0 then\n"
        "    Put_Line (\"pos\");\n"
        "  else\n"
        "    Put_Line (\"neg\");\n"
        "  end if;\n"
        "  for I in 1 .. 10 loop\n"
        "    X := X + I;\n"
        "  end loop;\n"
        "  case X is\n"
        "    when 0 =>\n"
        "      null;\n"
        "    when others =>\n"
        "      Put_Line (\"other\");\n"
        "  end case;\n"
        "end Hello;\n"))

    # 2. Package spec with a record type and a private part.
    cases.append((
        "package Shapes is\n"
        "type Point is record\n"
        "X : Float;\n"
        "Y : Float;\n"
        "end record;\n"
        "private\n"
        "Origin : constant Point := (0.0, 0.0);\n"
        "end Shapes;\n",

        "package Shapes is\n"
        "  type Point is record\n"
        "    X : Float;\n"
        "    Y : Float;\n"
        "  end record;\n"
        "private\n"
        "  Origin : constant Point := (0.0, 0.0);\n"
        "end Shapes;\n"))

    # 3. Declare block with an exception handler, plus blank-line preservation.
    cases.append((
        "declare\n"
        "X : Integer;\n"
        "\n"
        "begin\n"
        "X := 1;\n"
        "exception\n"
        "when Constraint_Error =>\n"
        "X := 0;\n"
        "end;\n",

        "declare\n"
        "  X : Integer;\n"
        "\n"
        "begin\n"
        "  X := 1;\n"
        "exception\n"
        "  when Constraint_Error =>\n"
        "    X := 0;\n"
        "end;\n"))

    # 4. Continuation inside an unclosed parenthesis (aggregate / call) aligns
    #    under the first item after the '('.
    cases.append((
        "procedure P is\n"
        "begin\n"
        "Set (A => 1,\n"
        "B => 2);\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "  Set (A => 1,\n"
        "       B => 2);\n"
        "end P;\n"))

    # 5. Statement/declaration continuation: a line that does not end the
    #    statement (no ';' and not a structural keyword line) indents its
    #    continuation one level; the terminating ';' clears it. (Operator-led
    #    continuations get no extra level outside parentheses — only within.)
    cases.append((
        "package P is\n"
        "Curtains : constant Alternatives_Profiles_T\n"
        ":= Whatever_But_Very_Long;\n"
        "X : Integer := A\n"
        "+ B\n"
        "+ C;\n"
        "end P;\n",

        "package P is\n"
        "  Curtains : constant Alternatives_Profiles_T\n"
        "    := Whatever_But_Very_Long;\n"
        "  X : Integer := A\n"
        "    + B\n"
        "    + C;\n"
        "end P;\n"))

    # 6. Multi-line if/elsif conditions: continuation lines ('and then …') must
    #    indent one level relative to the 'if'/'elsif'; 'then' aligns with the
    #    opener; body and end-if are at the normal depths.
    cases.append((
        "procedure P is\n"
        "begin\n"
        "if A = 1\n"
        "and then B = 2\n"
        "and then C = 3\n"
        "then\n"
        "null;\n"
        "elsif D = 4\n"
        "and then E = 5\n"
        "then\n"
        "null;\n"
        "end if;\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "  if A = 1\n"
        "    and then B = 2\n"
        "    and then C = 3\n"
        "  then\n"
        "    null;\n"
        "  elsif D = 4\n"
        "    and then E = 5\n"
        "  then\n"
        "    null;\n"
        "  end if;\n"
        "end P;\n"))

    # 7. Expression function: 'function ... is' followed by a parenthesised
    #    expression pushes NO block frame, and the declarations after it must
    #    return to the outer level (regression: the spec frame used to linger).
    cases.append((
        "function Image return String is\n"
        "(Compute (A, B'Image));\n"
        "procedure P is\n"
        "begin\n"
        "null;\n"
        "end P;\n",

        "function Image return String is\n"
        "  (Compute (A, B'Image));\n"
        "procedure P is\n"
        "begin\n"
        "  null;\n"
        "end P;\n"))

    # 8. If-expression inside parentheses: 'then'/'else'/'elsif' align under the
    #    'if' itself, condition continuations align under the condition, and the
    #    statement returns to the normal level once the parenthesis closes.
    cases.append((
        "procedure P is\n"
        "begin\n"
        "R := (if Cycle_Of (X)\n"
        "/= Cycle_Of (Y)\n"
        "then Empty\n"
        "else Full);\n"
        "Next_Statement;\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "  R := (if Cycle_Of (X)\n"
        "           /= Cycle_Of (Y)\n"
        "        then Empty\n"
        "        else Full);\n"
        "  Next_Statement;\n"
        "end P;\n"))

    # 9. Subunit with a multi-line parameter list. The 'separate (Parent)'
    #    clause is a complete line (must NOT make the body indent), the
    #    parameter continuations align under the first parameter, and the
    #    closing ') is' still opens the body frame so the declarations indent.
    cases.append((
        "separate (Flight.Behaviour)\n"
        "procedure P (A : Integer;\n"
        "B : Integer) is\n"
        "X : Integer;\n"
        "begin\n"
        "null;\n"
        "end P;\n",

        "separate (Flight.Behaviour)\n"
        "procedure P (A : Integer;\n"
        "             B : Integer) is\n"
        "  X : Integer;\n"
        "begin\n"
        "  null;\n"
        "end P;\n"))

    # 10. Case-expression as an expression-function body. 'when' clauses are
    #     indented one level in from the 'case', and a clause body on its own
    #     line ('=> ...') one level deeper still.
    cases.append((
        "function F return T is\n"
        "(case X is\n"
        "when A | B\n"
        "=> R1,\n"
        "when others => R2);\n",

        "function F return T is\n"
        "  (case X is\n"
        "     when A | B\n"
        "       => R1,\n"
        "     when others => R2);\n"))

    # 11. Operator-led continuations take an extra level ONLY within parentheses:
    #     the '=> ...' arms inside the else-aggregate sit one level past the
    #     items, while the bare ':=' continuation gets the plain +1 (no extra).
    cases.append((
        "package P is\n"
        "X : T\n"
        ":= (if A\n"
        "then (others => True)\n"
        "else (K1\n"
        "=> V1,\n"
        "K2\n"
        "=> V2));\n"
        "end P;\n",

        "package P is\n"
        "  X : T\n"
        "    := (if A\n"
        "        then (others => True)\n"
        "        else (K1\n"
        "                => V1,\n"
        "              K2\n"
        "                => V2));\n"
        "end P;\n"))

    # 12. Word boolean operators (and/or/and then/or else) at the start of a
    #     line take the extra level both as a statement continuation (the 'and'
    #     under 'return') and inside parentheses (the 'or else').
    cases.append((
        "function F return Boolean is\n"
        "begin\n"
        "return A\n"
        "and (B = C\n"
        "or else D = E);\n"
        "end F;\n",

        "function F return Boolean is\n"
        "begin\n"
        "  return A\n"
        "      and (B = C\n"
        "             or else D = E);\n"
        "end F;\n"))

    for pair in cases:
        let src: str = pair[0]
        let want: str = pair[1]
        var ind: Indenter = Indenter()
        let got: str = "\n".join([ind.indent_line(line) for line in src.split("\n")])
        if got == want:
            passed += 1
        else:
            failed += 1
            print "FAIL:"
            print "--- expected ---"
            print want
            print "--- got ---"
            print got

    print f"{passed} passed, {failed} failed"
    if failed > 0:
        result = 1


def main() -> int:
    var ind: Indenter = Indenter()
    if $# < 1:
        for line in stdin.lines:
            print ind.indent_line(line)
    else:
        let arg: str = $1
        if arg == "--test":
            result = run_tests()
        else:
            with open(arg) as f:
                for line in f:
                    print ind.indent_line(line)


if __name__ == "__main__":
    quit(main())
