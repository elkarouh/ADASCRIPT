#!/usr/bin/env py2py
# ada_indent.ady — a simplified Ada source re-indenter, written in Adascript.
#
# This is NOT a full Ada parser. It implements only the slice of Ada grammar
# that matters for indentation: the keywords that open, close, or split an
# indented block. Everything else is treated as an ordinary statement line.
#
# The model is a stack machine. Each open construct pushes a frame; the
# display indent of a line is the stack depth (times the indent width), with
# small adjustments for keywords that align with their opener rather than the
# block body (end / elsif / else / when / exception / or / private / begin).
#
# See README.md in this directory for the simplified grammar specification.
#
# Usage:
#   python3.13 TO_PYTHON/py2py.py -c ADA_INDENT/ada_indent.ady file.adb   # reindent a file
#   python3.13 TO_PYTHON/py2py.py -c ADA_INDENT/ada_indent.ady --test     # run self-tests
#
# The core logic (reindent + helpers) is pure Adascript and transpiles to
# both Python and Nim. The CLI uses the bash-style argument primitives
# ($1, $#, quit) so argument handling is target-agnostic.

const INDENT_WIDTH: int = 3

# The indentation-significant constructs. A frame is pushed for each open
# block; the kind is only consulted where it changes behaviour (PKG/DECLARE
# become BLOCK at 'begin'; WHEN frames are popped specially at 'end').
type Block_T is enum:
    PKG          # package / subprogram / task / protected / type spec opened by trailing 'is'
    DECLARE_     # a declare block (block label or bare 'declare')
    BLOCK        # a begin ... end region (statement part)
    IF_          # if ... then
    LOOP_        # [while/for] ... loop
    CASE_        # case ... is
    WHEN_        # when ... =>   (case alternative or exception handler)
    RECORD_      # record  ... end record
    SELECT_      # select ... end select
    DO_          # accept ... do  /  return ... do  (extended return)

# Scanner state for string-literal tracking inside a single line.
type Scan_T is enum:
    CODE        # outside any string literal
    STRING_LIT  # inside a double-quoted string literal


# ---------------------------------------------------------------------------
# Lexical helpers — all work on a single physical line.
# ---------------------------------------------------------------------------

def pairwise(s: str) -> (char, char):
    for i in s'First..<s'Last:
        yield (s[i], s[i + 1])


def strip_code(line: str) -> str:
    """Return the line with any '--' comment removed, string literals kept.

    Quote handling is deliberately simple: it tracks double-quoted strings so
    that a '--' inside a string is not mistaken for a comment. Character
    literals and doubled-quote escapes are not modelled (rare in practice).
    """
    var state: Scan_T = CODE
    for c, next_c in pairwise(line + " "):
        case state:
            when CODE:
                if c == '-' and next_c == '-':
                    break
                result += c
                if c == '"':
                    state = STRING_LIT
            when STRING_LIT:
                result += c
                if c == '"':
                    state = CODE


def paren_delta(line: str) -> int:
    """Net '(' minus ')' on the line, ignoring parens inside string literals.

    The input must already have comments removed (see strip_code), so only
    string literals need to be skipped here.
    """
    var state: Scan_T = CODE
    for c in line:
        case state:
            when CODE:
                case c:
                    when '"':
                        state = STRING_LIT
                    when "(":
                        result += 1
                    when ")":
                        result -= 1
                    when others:
                        pass
            when STRING_LIT:
                case c:
                    when '"':
                        state = CODE
                    when others:
                        pass


def lead_word(code: str) -> str:
    """Lowercased leading identifier of a (comment-stripped) line, or ''."""
    for ch in code.strip().lower():
        if ch.isalpha() or ch == "_":
            result += ch
        else:
            break


def last_word(code: str) -> str:
    """Lowercased final token, after dropping a trailing ';'. '' if empty."""
    var s: str = code.strip()
    if s.endswith(";"):
        s = s[:-1].strip()
    let parts: []str = s.split()
    if len(parts) > 0:
        result = parts[-1].lower()


def spaces(levels: int) -> str:
    """A run of spaces for the given number of indent levels (never negative)."""
    " " * (max(0, levels) * INDENT_WIDTH)


# ---------------------------------------------------------------------------
# The indenter proper.
# ---------------------------------------------------------------------------

class Indenter:
    stack: []Block_T = []
    paren_depth: int = 0

    def indent_line(self, line: str) -> str:
        """Process one raw line and return it re-indented."""
        let raw2: str = line.rstrip()
        let code: str = strip_code(raw2)
        let code_s: str = code.strip()
        let emit_text: str = raw2.strip()

        if emit_text == "":
            return ""

        let cont: int = 1 if self.paren_depth > 0 else 0
        let lw: str = lead_word(code_s)
        var disp: int = len(self.stack)

        case lw:
            when "end":
                while len(self.stack) > 0 and self.stack[-1] == WHEN_:
                    self.stack.pop()
                if len(self.stack) > 0:
                    self.stack.pop()
                disp = len(self.stack)

            when "begin":
                if len(self.stack) > 0 and (self.stack[-1] == PKG or self.stack[-1] == DECLARE_):
                    disp = len(self.stack) - 1
                    self.stack[-1] = BLOCK
                else:
                    disp = len(self.stack)
                    self.stack.append(BLOCK)

            when "when":
                if len(self.stack) > 0 and self.stack[-1] == WHEN_:
                    self.stack.pop()
                disp = len(self.stack)
                self.stack.append(WHEN_)

            when "elsif" | "else" | "exception" | "or" | "private":
                disp = len(self.stack) - 1

            when others:
                disp = len(self.stack)
                let last: str = last_word(code_s)
                case last:
                    when "is":
                        self.stack.append(CASE_ if lw == "case" else PKG)
                    when "then":
                        self.stack.append(IF_)
                    when "loop":
                        self.stack.append(LOOP_)
                    when "record":
                        if lw != "null":
                            self.stack.append(RECORD_)
                    when "select":
                        self.stack.append(SELECT_)
                    when "do":
                        self.stack.append(DO_)
                    when "declare":
                        self.stack.append(DECLARE_)
                    when others:
                        pass

        self.paren_depth = max(0, self.paren_depth + paren_delta(code))
        spaces(disp + cont) + emit_text


# ---------------------------------------------------------------------------
# Self-tests
# ---------------------------------------------------------------------------

def run_tests() -> int:
    var passed: int = 0
    var failed: int = 0

    # Each case: messy input (any indentation) -> canonical output.
    var cases: [](str, str) = []

    # 1. Subprogram with if/elsif/else, loop, and case.
    cases.append((
        "procedure Hello is\n"
        "X : Integer := 0;\n"
        "begin\n"
        "if X = 0 then\n"
        "Put_Line (\"zero\");\n"
        "elsif X > 0 then\n"
        "Put_Line (\"pos\");\n"
        "else\n"
        "Put_Line (\"neg\");\n"
        "end if;\n"
        "for I in 1 .. 10 loop\n"
        "X := X + I;\n"
        "end loop;\n"
        "case X is\n"
        "when 0 =>\n"
        "null;\n"
        "when others =>\n"
        "Put_Line (\"other\");\n"
        "end case;\n"
        "end Hello;\n",

        "procedure Hello is\n"
        "   X : Integer := 0;\n"
        "begin\n"
        "   if X = 0 then\n"
        "      Put_Line (\"zero\");\n"
        "   elsif X > 0 then\n"
        "      Put_Line (\"pos\");\n"
        "   else\n"
        "      Put_Line (\"neg\");\n"
        "   end if;\n"
        "   for I in 1 .. 10 loop\n"
        "      X := X + I;\n"
        "   end loop;\n"
        "   case X is\n"
        "      when 0 =>\n"
        "         null;\n"
        "      when others =>\n"
        "         Put_Line (\"other\");\n"
        "   end case;\n"
        "end Hello;\n"))

    # 2. Package spec with a record type and a private part.
    cases.append((
        "package Shapes is\n"
        "type Point is record\n"
        "X : Float;\n"
        "Y : Float;\n"
        "end record;\n"
        "private\n"
        "Origin : constant Point := (0.0, 0.0);\n"
        "end Shapes;\n",

        "package Shapes is\n"
        "   type Point is record\n"
        "      X : Float;\n"
        "      Y : Float;\n"
        "   end record;\n"
        "private\n"
        "   Origin : constant Point := (0.0, 0.0);\n"
        "end Shapes;\n"))

    # 3. Declare block with an exception handler, plus blank-line preservation.
    cases.append((
        "declare\n"
        "X : Integer;\n"
        "\n"
        "begin\n"
        "X := 1;\n"
        "exception\n"
        "when Constraint_Error =>\n"
        "X := 0;\n"
        "end;\n",

        "declare\n"
        "   X : Integer;\n"
        "\n"
        "begin\n"
        "   X := 1;\n"
        "exception\n"
        "   when Constraint_Error =>\n"
        "      X := 0;\n"
        "end;\n"))

    # 4. Continuation inside an unclosed parenthesis (aggregate / call).
    cases.append((
        "procedure P is\n"
        "begin\n"
        "Set (A => 1,\n"
        "B => 2);\n"
        "end P;\n",

        "procedure P is\n"
        "begin\n"
        "   Set (A => 1,\n"
        "      B => 2);\n"
        "end P;\n"))

    for pair in cases:
        let src: str = pair[0]
        let want: str = pair[1]
        var ind: Indenter = Indenter()
        let got: str = "\n".join([ind.indent_line(line) for line in src.split("\n")])
        if got == want:
            passed += 1
        else:
            failed += 1
            print "FAIL:"
            print "--- expected ---"
            print want
            print "--- got ---"
            print got

    print f"{passed} passed, {failed} failed"
    if failed > 0:
        result = 1


def main() -> int:
    var ind: Indenter = Indenter()
    if $# < 1:
        for line in stdin.lines:
            print ind.indent_line(line)
    else:
        let arg: str = $1
        if arg == "--test":
            result = run_tests()
        else:
            with open(arg) as f:
                for line in f:
                    print ind.indent_line(line)


if __name__ == "__main__":
    quit(main())
