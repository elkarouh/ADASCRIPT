#!/usr/bin/env ady2nim
"""What was left of units, Nim side: a square's root, a bound written as a
number, the literals of an explicit generic call, an int beside a float, a
literal to an overloaded constructor, a const made of literals, and a literal
beside a product whose unit comes from a constructor's field."""
from math nimport sqrt

type Speed_T is distinct float
type SpeedSq_T is Speed_T * Speed_T
type Duration_T is distinct float
type Angle_T is distinct float
type AngularRate_T is Angle_T / Duration_T
type metre_T is distinct float

const SPAN: Duration_T = 5.0 * 86400.0

def clip[T](x: T, lo: T, hi: T) -> T:
    return max(lo, min(x, hi))

def fraction(i: int, n: int) -> float:
    return 0.9 * i / n

class Velocity:
    var vx: Speed_T
    var vy: Speed_T
    def __init__(self, vx: Speed_T, vy: Speed_T):
        self.vx = vx
        self.vy = vy
    def __init__(self, v: Velocity):
        self.vx = v.vx
        self.vy = v.vy

class Ephemeris:
    var n: AngularRate_T
    def __init__(self, rate: float):
        self.n = AngularRate_T(rate)

def near(a: float, b: float) -> bool:
    return abs(a - b) <= 1e-9

def main():
    let v: Speed_T = 3.0
    let vv: SpeedSq_T = v * v
    assert near(float(sqrt(vv)), 3.0)          # sqrt of a Speed_T squared is a Speed_T
    let r: metre_T = 0.0
    assert near(float(max(r, 1e-9)), 1e-9)     # a bound written as a number
    assert near(float(min(2.0, metre_T(5.0))), 2.0)
    assert near(float(clip[Speed_T](v, -2.0, 2.0)), 2.0)
    assert near(fraction(2, 3), 0.6)            # an int beside a float is a float
    let still: Velocity = Velocity(0.0, 1.5)    # literals to the two-argument constructor
    let copy: Velocity = Velocity(still)
    assert near(float(copy.vy), 1.5)
    assert near(float(SPAN), 432000.0)
    let t: Duration_T = 10.0
    let ang: Angle_T = 180.0 - Ephemeris(2.0).n * t
    assert near(float(ang), 160.0)
    print "test_units_more: all checks passed"

main()
