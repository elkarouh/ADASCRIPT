# a module of test_method_through_module.ady: a class with methods, and a type mt_holder does not show
type Request is record:
    path: str

class Counter:
    var count: int

    def __init__(self):
        self.count = 0

    def bump(self, by: int):
        self.count += by

    def total(self) -> int:
        return self.count
