#!/usr/bin/env ady2nim
"""The stdlib's graph views: a node and an edge drawn from what drawing needs, in the app's colours
and states. Nim only, as html: blocks are.

    ady2nim c -r test_graph_views.ady
"""
from drawing import Drawing_Pixel_T, Spot_T
from graph_views import Graph_Palette, Node_View, Edge_View

type Mood_T is enum CALM, HOT

let colours: Graph_Palette = Graph_Palette(accent="blue")
var nodes: Node_View[Mood_T] = Node_View[Mood_T](CALM, colours, 20.0, 5.0, 4.0)
nodes.mark(HOT, "red", "pink")
var edges: Edge_View[Mood_T] = Edge_View[Mood_T](CALM, colours, 6.0)
edges.mark(HOT, "red")

# A part in an svg, as the page draws it.
def svg_of(part: Html) -> Html:
    html:
        svg:
            + part

let a: Spot_T = (x: Drawing_Pixel_T(100.0), y: Drawing_Pixel_T(50.0))
let b: Spot_T = (x: Drawing_Pixel_T(200.0), y: Drawing_Pixel_T(150.0))
let node: str = str(svg_of(nodes.to_html("A", a, HOT)))
assert "class=\"node hot\"" in node, node
assert "data-name=\"A\"" in node and "cx=\"120\"" in node and ">A<" in node, node
assert "class=\"node\"" in str(svg_of(nodes.to_html("B", b, CALM)))
let edge: str = str(svg_of(edges.to_html("A", "B", "7", a, b, HOT)))
assert "class=\"edge hot\"" in edge and "data-cost=\"7\"" in edge and "y=\"94\"" in edge, edge

let css: str = nodes.css()
assert "g.node.hot circle { fill: pink; stroke: red; stroke-width: 4px; }" in css, css
assert css.find(".hot circle") < css.find(".selected circle"), css      # the selected one wins
assert "g.node.selected circle { stroke: blue;" in css, css
assert "g[data-from] path.edge.hot { stroke: red; stroke-width: 5px; }" in edges.css(), edges.css()
print "graph views ok"
