#!/usr/bin/env ady2nim
"""
awk-style severity classifier — class-based version.

Usage:
    ./awk_OO < FILE                   # FS = whitespace
    cat FILE | ./awk_OO ,             # FS = comma
    cat FILE | ./awk_OO '\t'          # FS = tab
"""
from awk import StdinProcessor, AwkRecord_T, AwkFailure_T

type Severity_T is enum INFO, WARN, ERROR, OTHER

class SeverityProcessor(StdinProcessor):
    var counts : [Severity_T]int = [INFO : 0, WARN : 0, ERROR : 0, OTHER: 0]

    def classify_record(self, rec: AwkRecord_T) -> Severity_T:
        case rec.line:
            when /error/i:      return ERROR
            when /warn/i:       return WARN
            when /info|debug/i: return INFO
            when others:        return OTHER

    def process_record(self, rec: AwkRecord_T):
        let F:    []str = rec.Fields # F[1..NF] = fields; F[0] = full record ($0)
        let sev: Severity_T = self.classify_record(rec)
        case sev:
            when ERROR:
                print f"!! {rec.NR:>3}: {F[0]}" # F[0] contains the entire line !!!
            when WARN:
                print f" ! {rec.NR:>3}: {F[0]}"
            when INFO:
                if rec.NF >= 1:
                    let first: str = F[1]
                    let last:  str = F[rec.NF]
                    print f"[info] NR={rec.NR} NF={rec.NF} first={first}{self.OFS}last={last}"
                else:
                    print f"[info] NR={rec.NR} (empty)"
            when others:
                let joined: str = self.OFS.join(F[1:])
                print f"   {rec.NR:>3}: {joined}"
        self.counts[sev] += 1

    def start(self):
        print "--- awk report ---"
        print f"FS = {repr(self.FS)}"

    def finish(self):
        print ""
        print "--- summary ---"
        print f"records : {self.NR}"
        if self.NR > 0:
            let avg_len: float = self.total_len / self.NR
            let avg_nf:  float = self.total_nf  / self.NR
            print f"avg len : {avg_len:.2f}"
            print f"avg NF  : {avg_nf:.2f}"
        for s in Severity_T:
            print f"  {s:<6} {self.counts[s]}"


def main():
    let fs: str = ($1 if $# > 0 else " ")
    var processor: SeverityProcessor = SeverityProcessor(fs)
    let done: None | !AwkFailure_T = processor.run()
    if done is AwkFailure_T:
        die(done.reason)


main()
