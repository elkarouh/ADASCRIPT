# A slice of a string or a list is Python's: a negative index counts from the end, and an
# index past either end is the end, so a slice is never an error. (Nim's own raises.)
let t: str = "hello"
let xs: []int = [1, 2, 3]
var i: int = 10
var j: int = 20
print t[1:3], t[3:20], t[7:9], "[" + t[i:j] + "]", t[:2], t[2:], t[-3:], t[:-1], t[-20:2]
print len(xs[1:3]), len(xs[2:20]), len(xs[5:9]), len(xs[:i]), len(xs[-2:]), len(xs[i:]), len(xs[:-1]), len(xs[2:1])
let e: str = ""
print "[" + e[0:5] + "]", "[" + e[:] + "]", "[" + t[:] + "]"
