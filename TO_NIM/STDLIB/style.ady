"""style -- the look of what a class draws, written in the class: CSS rules scoped to it, with the
properties checked by name.

A class that draws something holds its Style, and the page puts every Style it draws into its
<style> once: the rules are written once for the class, never for each element, and an element
carries only its class and its state. The class writes it as a style block (GRAMMAR/ady_style.py),
which is this module's Style, Rule and Look:

    type Role_T is enum NO_ROLE, WAY, START, GOAL

    class Node_View:
        style "g.node":
            &:                  cursor="grab"
            circle:             fill=WHITE stroke=GREY stroke_width=2
            &:hover circle:     stroke=INK
            [WAY] circle:       stroke=ORANGE stroke_width=4

    class Page_View:                    # the page's own: no scope, each selector whole
        style "":
            body:               margin="0" font_family="Arial, sans-serif"
            header, #all:       max_width="68em" margin="0 auto"

    page.shell_text(title, Page_View().style.css() + Node_View().style.css(), ...)

A rule is for the scope followed by its part: "" the element itself (`&`), " circle" a circle in
it, ":hover circle" one when the pointer is over it, ".way circle" one in the state WAY (`[WAY]`),
an enum value whose class, `class_of(WAY)`, the element carries. `part` and `when` add a rule
to a Style made in code. Compiles both ways.
"""

# What a rule sets: each property named as in CSS, with _ for -, its value as CSS writes it, a
# length with its unit ("0.4em 0.7em"); stroke_width, opacity and font_weight are numbers,
# stroke_width in pixels.
# A property left at its default ("", or a negative number) is not set.
type Look is record:
    fill:             str = ""
    stroke:           str = ""
    stroke_width:     float = -1.0      # in pixels
    stroke_dasharray: str = ""          # "6 4"
    stroke_linejoin:  str = ""          # round
    marker_end:       str = ""          # "url(#arrow)"
    opacity:          float = -1.0
    cursor:           str = ""
    font_size:        str = ""          # "13px", "0.9em"
    font_weight:      int = 0           # 400 normal, 700 bold
    text_anchor:      str = ""          # start, middle, end
    pointer_events:   str = ""          # none
    paint_order:      str = ""          # stroke: the outline under the fill, as a halo
    dominant_baseline: str = ""         # middle: the text centred on its y
    font_variant_numeric: str = ""      # tabular-nums: figures of one width, in columns
    # the page's own: what is not drawn, laid out
    background:       str = ""          # "#fff"
    background_color: str = ""
    border:           str = ""          # "1px solid #999"
    border_top:       str = ""
    border_right:     str = ""
    border_bottom:    str = ""
    border_bottom_color: str = ""
    border_radius:    str = ""
    border_collapse:  str = ""
    box_shadow:       str = ""
    box_sizing:       str = ""          # border-box
    color:            str = ""
    display:          str = ""          # none, block, flex, grid
    position:         str = ""          # fixed
    top:              str = ""
    left:             str = ""
    z_index:          str = ""
    transform:        str = ""          # "translateX(-50%)"
    flex_direction:   str = ""
    flex_wrap:        str = ""
    flex_shrink:      str = ""
    align_items:      str = ""
    justify_content:  str = ""
    gap:              str = ""
    grid_template_columns:str = ""      # "1fr 1fr"
    width:            str = ""
    min_width:        str = ""
    max_width:        str = ""
    height:           str = ""
    min_height:       str = ""
    margin:           str = ""          # "0 auto", "0.5em 0"
    margin_top:       str = ""
    margin_bottom:    str = ""
    padding:          str = ""
    padding_left:     str = ""
    font:             str = ""          # inherit
    font_family:      str = ""          # "sans-serif"
    line_height:      str = ""
    list_style:       str = ""          # none: a list without its bullets
    text_align:       str = ""
    text_decoration:  str = ""          # line-through: struck out
    vertical_align:   str = ""
    outline:          str = ""
    user_select:      str = ""          # none: a drag selects no text

# A rule of a Style: what follows the scope (" circle", ":hover circle", ".way circle"), and its look.
type Rule is record:
    part: str
    look: Look

# The rules of what a class draws, every one under SCOPE, the selector of its element.
class Style:
    var scope: str
    var rules: []str = []

    def __init__(self, scope: str, rules: []Rule = []):
        self.scope = scope
        for r in rules:
            self.part(r.part, r.look)

    # A number as CSS writes it: 2, not 2.0.
    def number(self, f: float) -> str:
        if f == float(int(f)):
            return str(int(f))
        return str(f)

    # A number of LOOK's as CSS writes it, "" when left at its default.
    def amount(self, f: float) -> str:
        return ("" if f < 0.0 else self.number(f))

    def pixels(self, f: float) -> str:
        return ("" if f < 0.0 else self.number(f) + "px")

    def weight(self, w: int) -> str:
        return ("" if w <= 0 else str(w))

    # LOOK as declarations: "fill: #fff; stroke-width: 2px;", the properties it sets, in this order.
    def declarations(self, look: Look) -> str:
        let said: [][]str = [
            ["font", look.font],              # first: the shorthand sets every font-*
            ["fill", look.fill],
            ["stroke", look.stroke],
            ["stroke-width", self.pixels(look.stroke_width)],
            ["stroke-dasharray", look.stroke_dasharray],
            ["stroke-linejoin", look.stroke_linejoin],
            ["marker-end", look.marker_end],
            ["opacity", self.amount(look.opacity)],
            ["cursor", look.cursor],
            ["font-size", look.font_size],
            ["font-weight", self.weight(look.font_weight)],
            ["text-anchor", look.text_anchor],
            ["pointer-events", look.pointer_events],
            ["paint-order", look.paint_order],
            ["dominant-baseline", look.dominant_baseline],
            ["font-variant-numeric", look.font_variant_numeric],
            ["background", look.background],
            ["background-color", look.background_color],
            ["border", look.border],
            ["border-top", look.border_top],
            ["border-right", look.border_right],
            ["border-bottom", look.border_bottom],
            ["border-bottom-color", look.border_bottom_color],
            ["border-radius", look.border_radius],
            ["border-collapse", look.border_collapse],
            ["box-shadow", look.box_shadow],
            ["box-sizing", look.box_sizing],
            ["color", look.color],
            ["display", look.display],
            ["position", look.position],
            ["top", look.top],
            ["left", look.left],
            ["z-index", look.z_index],
            ["transform", look.transform],
            ["flex-direction", look.flex_direction],
            ["flex-wrap", look.flex_wrap],
            ["flex-shrink", look.flex_shrink],
            ["align-items", look.align_items],
            ["justify-content", look.justify_content],
            ["gap", look.gap],
            ["grid-template-columns", look.grid_template_columns],
            ["width", look.width],
            ["min-width", look.min_width],
            ["max-width", look.max_width],
            ["height", look.height],
            ["min-height", look.min_height],
            ["margin", look.margin],
            ["margin-top", look.margin_top],
            ["margin-bottom", look.margin_bottom],
            ["padding", look.padding],
            ["padding-left", look.padding_left],
            ["font-family", look.font_family],
            ["line-height", look.line_height],
            ["list-style", look.list_style],
            ["text-align", look.text_align],
            ["text-decoration", look.text_decoration],
            ["vertical-align", look.vertical_align],
            ["outline", look.outline],
            ["user-select", look.user_select]]
        var d: []str = []
        for nv in said:
            if nv[1] != "":
                d.append(nv[0] + ": " + nv[1] + ";")
        return " ".join(d)

    # LOOK for the scope followed by PART: "" the element itself, " circle" a circle in it,
    # ":hover circle" one when the pointer is over the element.
    def part(self, part: str, look: Look):
        self.rules.append(f"{self.scope}{part} {{ {self.declarations(look)} }}")

    # The class an element carries in STATE, an enum value: WAY is "way".
    def class_of[E](self, state: E) -> str:
        return str(state).lower()

    # LOOK for PART of the element in STATE (`class_of`).
    def when[E](self, state: E, part: str, look: Look):
        self.part("." + self.class_of(state) + part, look)

    # The rules, for the page's <style>.
    def css(self) -> str:
        return "\n".join(self.rules) + "\n"
