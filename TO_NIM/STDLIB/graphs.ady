#!/usr/bin/env py2nim
"""
graphs.ady — shortest paths over a weighted digraph, generic in the node type

A graph is `{Node_T}[](float, Node_T)`: each node maps to its outgoing edges, and an
edge is a (weight, destination) pair. The node type is declared `[Node_T]` on
each signature, so one definition serves enum, string and integer nodes:
the Nim compiler instantiates a concrete version per call site, and Python
takes the same brackets as PEP 695 type parameters.

The edge tuple is deliberately (weight, node) and not (node, weight): the
priority queue orders on the tuple's first element, so an edge is already
in the shape the queue wants and no repacking is needed.

    nimport graphs

    type City_T is enum PAR, LON, BER
    let g: {City_T}[](float, City_T) = {PAR: [(3.0, LON)], LON: [(2.0, BER)], BER: []}
    let d: {City_T}float = dijkstra[City_T](g, PAR)
    print d[BER]                              # 5.0
    print shortest_path[City_T](g, PAR, BER)  # PAR, LON, BER

The brackets name the node type explicitly; both backends infer it from the
argument when they are left off.
"""

from stdlib nimport PriorityQueue


# ---------------------------------------------------------------------------
# node_table(graph) — every node the graph mentions, each at Inf
#   A sink has no adjacency entry of its own: it appears only as some edge's
#   destination. Reading the keys alone would leave it out, and the first
#   edge into it would then be a lookup of a key that is not there.
#
#   This returns the distance table rather than a set of nodes because Nim
#   cannot resolve `sets`' items iterator inside a generic proc -- iterating
#   a HashSet[Node_T] here does not compile, while a Table[Node_T, float] does.
# ---------------------------------------------------------------------------

def node_table[Node_T](graph: {Node_T}[](float, Node_T)) -> {Node_T}float:
    var dist: {Node_T}float = {:}
    for node in graph:
        dist[node] = Inf
        for weight, neighbour in graph[node]:
            dist[neighbour] = Inf
    return dist


# ---------------------------------------------------------------------------
# dijkstra(graph, start) — distance from start to every reachable node
#   Unreachable nodes come back as Inf, which compares and adds like any
#   other float; nothing has to be unwrapped in the loop.
# ---------------------------------------------------------------------------

def dijkstra[Node_T](graph: {Node_T}[](float, Node_T), start: Node_T) -> {Node_T}float:
    var dist: {Node_T}float = node_table(graph)
    dist[start] = 0.0
    var seen: {}Node_T
    queue: PriorityQueue[(float, Node_T)] = [(0.0, start)]
    while queue:
        current, node = queue.pop()
        if node in seen:
            continue
        seen.add(node)
        if node not in graph:
            continue                 # a sink: reached, but nothing leaves it
        for weight, neighbour in graph[node]:
            let candidate: float = current + weight
            if candidate < dist[neighbour]:
                dist[neighbour] = candidate
                queue.push((candidate, neighbour))
    return dist


# ---------------------------------------------------------------------------
# shortest_path(graph, start, goal) — the route itself, start..goal inclusive
#   Empty when there is no route, or when either end is not in the graph.
#   A single-node path is [start], so an empty result is never ambiguous.
# ---------------------------------------------------------------------------

def shortest_path[Node_T](graph: {Node_T}[](float, Node_T), start: Node_T, goal: Node_T) -> []Node_T:
    var route: []Node_T = []
    var dist: {Node_T}float = node_table(graph)
    if start not in dist or goal not in dist:
        return route
    dist[start] = 0.0
    var came_from: {Node_T}Node_T = {:}
    var seen: {}Node_T
    queue: PriorityQueue[(float, Node_T)] = [(0.0, start)]
    while queue:
        current, node = queue.pop()
        if node in seen:
            continue
        seen.add(node)
        if node == goal:
            break
        if node not in graph:
            continue                 # a sink: reached, but nothing leaves it
        for weight, neighbour in graph[node]:
            let candidate: float = current + weight
            if candidate < dist[neighbour]:
                dist[neighbour] = candidate
                came_from[neighbour] = node
                queue.push((candidate, neighbour))
    if goal != start and goal not in came_from:
        return route
    # Walk the predecessors back from the goal, then reverse.
    var backwards: []Node_T = [goal]
    var at: Node_T = goal
    while at != start:
        at = came_from[at]
        backwards.append(at)
    for i in 0 ..< len(backwards):
        route.append(backwards[len(backwards) - 1 - i])
    return route
