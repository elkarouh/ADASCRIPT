#!/usr/bin/env ady2nim
"""
blackboard.ady -- a small synchronous publish/subscribe layer

It is meant for the blackboard pattern: one shared state (the blackboard), a control that
decides what is written on it, and independent knowledge sources, each reacting to a change
without knowing about the others. The control publishes what changed on a channel; each
knowledge source subscribes to the channels it cares about. A new capability (saving, a
log, undo, telling other pages) is then a new subscriber, and the control is not touched.
BROWSER_EXAMPLES/DIJKSTRA_HTMX is built so (its docs/TUTORIAL.md, "The blackboard").

A PublishChannel is a named channel. Subscribers register a callback; `publish` hands one
event to every subscriber, in the order they subscribed. Nothing is queued: when `publish` returns, every subscriber has run.

The channel is generic in two types: the name of the channel, and the event it carries.
A blackboard has a handful of channels, all known when it is written, so a channel is named
by a value of an enum of the blackboard's own, not by a string. The enum is then the list of
the blackboard's channels, in one line, for the reader to see; a misspelt channel is a
compile error; and a subscriber that hears several channels can `case` on which. The event
is a record or an enum, checked at compile time, not a bag of keyword arguments:

    from blackboard import PublishChannel

    type Channel_T is enum NODES, EDGES          # the blackboard's channels

    type Change is record:
        kind: str            # "create", "update" or "delete"
        key: str

    def on_change(channel: Channel_T, event: Change):
        print channel, event.kind, event.key     # NODES create A

    var nodes: PublishChannel[Channel_T, Change] = PublishChannel[Channel_T, Change](NODES)
    let id: int = nodes.subscribe(on_change)
    nodes.publish(Change("create", "A"))
    nodes.unsubscribe(id)

A callback takes the channel's name (the enum's value) and the event. `subscribe` answers a number, the
subscription's id, and `unsubscribe` takes that number back: functions are not compared,
so the id is what names a subscription (the same callback subscribed twice is called twice,
under two ids). A callback that raises stops `publish`, and the failure reaches the publisher:
a subscriber that fails is a bug, and it shows. Set `raise_errors = False` to have a failing
callback skipped instead, the others still run.

History is off by default. `keep_history = True` keeps the last `max_history` events
(1000 unless set), oldest dropped first; `history` is read in publish order.
"""


class PublishChannel[Channel_T, Event_T]:
    var name: Channel_T
    var ids: []int
    var callbacks: [](Channel_T, Event_T) -> None
    var next_id: int
    var history: []Event_T
    var keep_history: bool
    var max_history: int
    var raise_errors: bool

    def __init__(self, name: Channel_T):
        self.name = name
        self.ids = []
        self.callbacks = []
        self.next_id = 1
        self.history = []
        self.keep_history = False
        self.max_history = 1000
        self.raise_errors = True

    def subscribe(self, callback: (Channel_T, Event_T) -> None) -> int:
        let id: int = self.next_id
        self.next_id += 1
        self.ids.append(id)
        self.callbacks.append(callback)
        return id

    def unsubscribe(self, id: int) -> bool:
        for i in 0 ..< len(self.ids):
            if self.ids[i] == id:
                self.ids = self.ids[:i] + self.ids[i + 1:]
                self.callbacks = self.callbacks[:i] + self.callbacks[i + 1:]
                return True
        return False

    def publish(self, event: Event_T):
        if self.keep_history:
            self.history.append(event)
            while len(self.history) > self.max_history:
                self.history = self.history[1:]
        # a copy, so a callback may unsubscribe itself while it runs
        let current: [](Channel_T, Event_T) -> None = self.callbacks[:]
        for callback in current:
            try:
                callback(self.name, event)
            except Exception:
                if self.raise_errors:
                    raise

    def clear_subscribers(self):
        self.ids = []
        self.callbacks = []

    def subscriber_count(self) -> int:
        return len(self.ids)


# A subscriber that is an object: it subscribes itself to CHANNEL when it is made, and what it does with
# an event is its method `callback`, which each kind of observer defines. So a knowledge source keeps
# what it needs in its own fields, and the one line that makes it is the one that subscribes it:
#
#     class Liaison_Officer(Observer[Page_Channel_T, Command]):
#         def callback(self, channel: Page_Channel_T, c: Command):
#             if not is_draft(c):
#                 send(c)
#
#     let liaison: Liaison_Officer = Liaison_Officer(commands_channel)
#
# `id` is the subscription's, for the channel's `unsubscribe`.
class Observer[Channel_T, Event_T]:
    var id: int

    def __init__(self, channel: var PublishChannel[Channel_T, Event_T]):
        self.id = channel.subscribe(self.callback)

    # What the observer does with EVENT, heard on CHANNEL: nothing, until a kind of observer says.
    def callback(self, channel: Channel_T, event: Event_T):
        pass
