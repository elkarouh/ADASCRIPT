#!/usr/bin/env ady2nim
"""
blackboard.ady -- a small synchronous publish/subscribe layer

A PublishChannel is a named channel. Subscribers register a callback; `publish` hands one
event to every subscriber, in the order they subscribed, and returns how many took it
without failing. Nothing is queued: when `publish` returns, every subscriber has run.

The channel is generic in the event it carries, so what travels is a record or an enum,
checked at compile time, not a bag of keyword arguments:

    from blackboard import PublishChannel

    type Change is record:
        kind: str            # "create", "update" or "delete"
        key: str

    def on_change(channel: str, event: Change):
        print channel, event.kind, event.key

    var nodes: PublishChannel[Change] = PublishChannel[Change]("nodes")
    let id: int = nodes.subscribe(on_change)
    nodes.publish(Change("create", "A"))
    nodes.unsubscribe(id)

A callback takes the channel's name and the event. `subscribe` answers a number, the
subscription's id, and `unsubscribe` takes that number back: functions are not compared,
so the id is what names a subscription (the same callback subscribed twice is called twice,
under two ids). A callback that raises is skipped and does not stop the others; `publish`
counts only those that returned. Set `raise_errors = True` to have the failure propagate
instead, so a loop driving the channel stops loudly.

History is off by default. `keep_history = True` keeps the last `max_history` events
(1000 unless set), oldest dropped first; `history` is read in publish order.
"""


class PublishChannel[Event_T]:
    var name: str
    var ids: []int
    var callbacks: [](str, Event_T) -> None
    var next_id: int
    var history: []Event_T
    var keep_history: bool
    var max_history: int
    var raise_errors: bool

    def __init__(self, name: str):
        self.name = name
        self.ids = []
        self.callbacks = []
        self.next_id = 1
        self.history = []
        self.keep_history = False
        self.max_history = 1000
        self.raise_errors = False

    def subscribe(self, callback: (str, Event_T) -> None) -> int:
        let id: int = self.next_id
        self.next_id += 1
        self.ids.append(id)
        self.callbacks.append(callback)
        return id

    def unsubscribe(self, id: int) -> bool:
        for i in 0 ..< len(self.ids):
            if self.ids[i] == id:
                self.ids = self.ids[:i] + self.ids[i + 1:]
                self.callbacks = self.callbacks[:i] + self.callbacks[i + 1:]
                return True
        return False

    def publish(self, event: Event_T) -> int:
        if self.keep_history:
            self.history.append(event)
            while len(self.history) > self.max_history:
                self.history = self.history[1:]
        var notified: int = 0
        # a copy, so a callback may unsubscribe itself while it runs
        let current: [](str, Event_T) -> None = self.callbacks[:]
        for callback in current:
            try:
                callback(self.name, event)
                notified += 1
            except Exception:
                if self.raise_errors:
                    raise
        return notified

    def clear_subscribers(self):
        self.ids = []
        self.callbacks = []

    def subscriber_count(self) -> int:
        return len(self.ids)
