#!/usr/bin/env ady2nim
"""json_value -- records written as JSON and read back by name.

Plain text, no page: it compiles to C for a server that writes the records into the page,
and to JavaScript for a script that reads them back there (ady2nim js), so both ends are
the same code. A record goes out as a JSON object, its fields by name; a list of them as a
JSON list:

    from json_value import Json_T, read_json, json_list, json_text, json_number, json_flag, json_string

    let text: str = "{\"slots\": [" + json_string("cash") + "]}"   # what the server writes
    let books: ?Json_T = read_json(text)                        # None when it is not JSON
    if books is not None:
        for s in books.json_list("slots"): ...                   # a list, by name
        let id: str = s.json_text("id")                          # a string field, "" when missing
        let tall: float = s.json_number("tall")                  # a number, 0.0 when missing
        let group: bool = s.json_flag("group")                   # true or false, False when missing

`json_string(s)` is S as a JSON string, quotes and escapes included: what to write for a
text field. A number is written as it prints (`f"{x}"`), and a bool as `true` or `false`.
"""
from json nimport JsonNode, JsonNodeKind, JObject, JArray, parseJson, escapeJson, hasKey, getOrDefault, getStr, getFloat, getBool, getElems, kind

# A value read from JSON: an object, a list, a string, a number, a bool.
type Json_T is JsonNode

# TEXT read as JSON; None when it is not JSON.
def read_json(text: str) -> ?Json_T:
    try:
        return parseJson(text)
    except:
        return None

# The list field NAME of the object J, as values; [] when it has none.
def json_list(j: Json_T, name: str) -> []Json_T:
    if j.kind != JObject or not j.hasKey(name) or j.getOrDefault(name).kind != JArray:
        return []
    return j.getOrDefault(name).getElems()

# The string field NAME of the object J; "" when it has none.
def json_text(j: Json_T, name: str) -> str:
    if j.kind != JObject or not j.hasKey(name):
        return ""
    return j.getOrDefault(name).getStr()

# The number field NAME of the object J; 0.0 when it has none.
def json_number(j: Json_T, name: str) -> float:
    if j.kind != JObject or not j.hasKey(name):
        return 0.0
    return j.getOrDefault(name).getFloat()

# The true-or-false field NAME of the object J; False when it has none.
def json_flag(j: Json_T, name: str) -> bool:
    if j.kind != JObject or not j.hasKey(name):
        return False
    return j.getOrDefault(name).getBool()

# TEXT as a JSON string, its quotes and escapes included. A `<` is written \u003c, so the
# text can stand inside a <script> element of a page whatever it holds.
def json_string(text: str) -> str:
    return escapeJson(text).replace("<", "\\u003c")
