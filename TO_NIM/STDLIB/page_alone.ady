# Every request the page makes, from now on, answered by ANSWER(method, path, fields) ("" when there
# is no such thing); then the page is SHELL.
def serve_in_page(answer: (str, str, str) -> str, shell: str):
    serve_here(answer, shell)

# CHANGE told to the page, as a server tells it on GET /events.
def tell_page(change: str):
    tell_here(change)
