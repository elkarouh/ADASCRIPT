#!/usr/bin/env ady2nim
"""
awk -- a record-processor framework: awk's loop, with the records coming from wherever the base class says.

`AwkProcessor.run` is the whole loop:

    for rec in self.get_record():
        self.process_record(rec)

and three kinds of input are there to build on, each a base class that says where the records come from:

    StdinProcessor     the records of stdin             (what awk reads with no file)
    FileProcessor      the records of a file, FileProcessor(path); a path ending in .gz is read through gzip
    TextProcessor      the records of a text already in hand, TextProcessor(text): what a command printed

A program subclasses the one it wants and overrides

    process_record(rec)  -- called once per record
    start()              -- called before the first record  (default: no-op)
    finish()             -- called after the last one       (default: no-op)

and any other source of records is a subclass of AwkProcessor that overrides `get_record`, a
generator: it yields each record, made with `self.record(raw)`, and ends when there are no more.
A source that cannot be read calls `self.stop(reason)` and ends.

awk variables, on the processor:
    FS   field separator         (default: " " = split on whitespace)
    OFS  output field separator  (default: " ")
    RS   record separator        (default: "\n" = one line per record)
    ORS  output record separator (default: "\n", available to subclasses)

and on the record that process_record is given:
    rec.line      = the record  (awk $0)
    rec.Fields    = Fields[0] the record, Fields[1..NF] its fields  (awk $0, $1..$NF)
    rec.NF        = number of fields
    rec.NR        = number of the record, from 1
"""


# why a run stopped: a failed read, or a record the subclass gave up on with stop()
type AwkFailure_T is record:
    reason: str

# one record: what process_record is given
type AwkRecord_T is record:
    line:   str
    Fields: []str
    NF:     int
    NR:     int


@virtual
class AwkProcessor:
    var FS        : str
    var OFS       : str
    var RS        : str = "\n"
    var ORS       : str = "\n"
    var NR        : int = 0
    var total_len : int = 0
    var total_nf  : int = 0
    var failure   : str = ""

    def __init__(self, fs: str = " ", ofs: str = " ", rs: str = "\n", ors: str = "\n"):
        self.FS  = fs
        self.OFS = ofs
        self.RS  = rs
        self.ORS = ors

    # The records, one after the other: what differs from one use case to another. A subclass
    # overrides it, and `run` loops over the override's.
    def get_record(self) -> AwkRecord_T:
        raise NotImplementedError("Override get_record()")
        yield self.record("")            # never reached: it makes this a generator, as its overrides are

    # The record that the text RAW is: its line, its fields by FS, its number.
    def record(self, raw: str) -> AwkRecord_T:
        let line: str = raw.rstrip()
        let parts: []str = (line.split() if self.FS == " " else line.split(self.FS))
        self.NR        += 1
        self.total_len += line'Length
        self.total_nf  += parts'Length
        var fields: []str = [line]
        fields.extend(parts)
        return AwkRecord_T(line=line, Fields=fields, NF=parts'Length, NR=self.NR)

    def process_record(self, rec: AwkRecord_T):
        raise NotImplementedError("Override process_record()")

    def start(self):
        pass

    def finish(self):
        pass

    # Stop the run, saying why: the records after this one are not read, and `run` gives the
    # reason back as an AwkFailure_T.
    def stop(self, reason: str):
        if self.failure == "":
            self.failure = reason

    def run(self) -> None | !AwkFailure_T:
        self.start()
        for rec in self.get_record():
            self.process_record(rec)
            break if self.failure != ""
        if self.failure != "":
            return AwkFailure_T(self.failure)
        self.finish()


# What a file holds, as text: a path ending in .gz is read through gzip. For a processor that
# reads files of its own: FileProcessor reads its one this way.
def read_source(path: str) -> str | !AwkFailure_T:
    if path.endswith(".gz"):
        let unzipped: str | !ShellFailure_T = shell: gzip -dc -- {!path}
        if unzipped is ShellFailure_T:
            return AwkFailure_T(f"cannot read {path}: {unzipped.stderr.strip()}")
        return unzipped
    let plain: str | !PathFailure_T = Path(path).read_text()
    if plain is PathFailure_T:
        return AwkFailure_T(f"cannot read {path}: {plain.reason}")
    return plain


# The records of stdin: a line each, or, for another RS, the input cut at RS.
class StdinProcessor(AwkProcessor):
    def __init__(self, fs: str = " ", ofs: str = " ", rs: str = "\n", ors: str = "\n"):
        super().__init__(fs, ofs, rs, ors)

    def get_record(self) -> AwkRecord_T:
        if self.RS == "\n":
            for raw in stdin.lines:
                yield self.record(raw)
        else:
            # another separator: the input is read whole, and cut
            for raw in stdin.readAll().split(self.RS):
                if raw'Length > 0:
                    yield self.record(raw)


# The records of a text in hand -- what a command printed, say.
class TextProcessor(AwkProcessor):
    var text : str

    def __init__(self, text: str = "", fs: str = " ", ofs: str = " ", rs: str = "\n", ors: str = "\n"):
        super().__init__(fs, ofs, rs, ors)
        self.text = text

    # The text to cut into records, or why it is not there: for a processor of another kind of text.
    def load(self) -> str | !AwkFailure_T:
        return self.text

    def get_record(self) -> AwkRecord_T:
        let source: str | !AwkFailure_T = self.load()
        if source is AwkFailure_T:
            self.stop(source.reason)
            return
        if self.RS == "\n":
            for raw in source.splitlines():
                yield self.record(raw)
        else:
            for raw in source.split(self.RS):
                if raw'Length > 0:
                    yield self.record(raw)


# The records of a file, whose name is PATH; a name ending in .gz is read as what it holds.
class FileProcessor(TextProcessor):
    var path : str

    def __init__(self, path: str, fs: str = " ", ofs: str = " ", rs: str = "\n", ors: str = "\n"):
        super().__init__("", fs, ofs, rs, ors)
        self.path = path

    def load(self) -> str | !AwkFailure_T:
        return read_source(self.path)
