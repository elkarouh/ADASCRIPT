#!/usr/bin/env ady2nim
"""
awk_base — generic stdin record-processor framework.

Subclass AwkProcessor and override:
    process_record()   — called once per record after read_record()
    start()            — called before the main loop  (default: no-op)
    finish()           — called after the main loop   (default: no-op)

awk variables supported:
    FS   field separator         (default: " " = split on whitespace)
    OFS  output field separator  (default: " ")
    RS   record separator        (default: "\n" = one line per record)
    ORS  output record separator (default: "\n", available to subclasses)

Fields layout:
    self.line        = full record  (awk $0)
    Fields[0..NF-1] = individual fields  (awk $1..$NF)
    NF              = number of fields
"""


# why a run stopped: a failed read, or a record the subclass gave up on with stop()
type AwkFailure_T is record:
    reason: str


@virtual
class AwkProcessor:
    var FS        : str
    var OFS       : str
    var RS        : str = "\n"
    var ORS       : str = "\n"
    var line      : str
    var Fields    : []str
    var NR        : int = 0
    var NF        : int = 0
    var total_len : int = 0
    var total_nf  : int = 0
    var failure   : str = ""

    def __init__(self, fs: str = " ", ofs: str = " ", rs: str = "\n", ors: str = "\n"):
        self.FS  = fs
        self.OFS = ofs
        self.RS  = rs
        self.ORS = ors

    def read_record(self, raw: str):
        self.line       = raw.rstrip()
        let parts: []str = (self.line.split() if self.FS == " " else self.line.split(self.FS))
        self.NF         = parts'Length
        self.Fields     = ["" for _ in 0 .. self.NF]  # NF+1 slots: Fields[0]=$0, Fields[1..NF]=$1..$NF
        self.Fields[0]  = self.line
        self.Fields[1:] = parts
        self.NR        += 1
        self.total_len += self.line'Length
        self.total_nf  += self.NF

    def process_record(self):
        raise NotImplementedError("Override process_record()")

    def start(self):
        pass

    def finish(self):
        pass

    # Stop the run, saying why: the records after this one are not read. `run` and
    # `run_file` end the program with the reason; `try_run` and `try_run_file` give it
    # back as an AwkFailure_T.
    def stop(self, reason: str):
        if self.failure == "":
            self.failure = reason

    def try_run(self) -> None | !AwkFailure_T:
        self.start()
        if self.RS == "\n":
            for raw in stdin.lines:
                self.read_record(raw)
                self.process_record()
                break if self.failure != ""
        else:
            let all: str = stdin.readAll()
            for raw in all.split(self.RS):
                if raw'Length > 0:
                    self.read_record(raw)
                    self.process_record()
                    break if self.failure != ""
        if self.failure != "":
            return AwkFailure_T(self.failure)
        self.finish()

    def try_run_file(self, path: str) -> None | !AwkFailure_T:
        var source: str = ""
        if path.endswith(".gz"):
            # a gzipped file is read as what it holds
            let unzipped: str | !ShellFailure_T = shell: gzip -dc -- {!path}
            if unzipped is ShellFailure_T:
                return AwkFailure_T(f"cannot read {path}: {unzipped.stderr.strip()}")
            source = unzipped
        else:
            let plain: str | !PathFailure_T = Path(path).read_text()
            if plain is PathFailure_T:
                return AwkFailure_T(f"cannot read {path}: {plain.reason}")
            source = plain
        self.start()
        if self.RS == "\n":
            for raw in source.splitlines():
                self.read_record(raw)
                self.process_record()
                break if self.failure != ""
        else:
            for raw in source.split(self.RS):
                if raw'Length > 0:
                    self.read_record(raw)
                    self.process_record()
                    break if self.failure != ""
        if self.failure != "":
            return AwkFailure_T(self.failure)
        self.finish()

    def run(self):
        let r: None | !AwkFailure_T = self.try_run()
        if r is AwkFailure_T:
            die(r.reason)

    def run_file(self, path: str):
        let r: None | !AwkFailure_T = self.try_run_file(path)
        if r is AwkFailure_T:
            die(r.reason)
