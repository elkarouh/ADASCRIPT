"""graph_views -- a node and an edge of a graph drawn as SVG, the same for any app that draws one.

A view draws from what drawing needs and nothing else: a node from its label, its place and its
state; an edge from the labels of its ends, its own label, its two places and its state. The
state is the app's own enum (State_T), whose values the app marks with their colours; PLAIN is
the value drawn as it is. The colours are the app's, a Graph_Palette, given when the view is made.

    type Role_T is enum NO_ROLE, START, GOAL, WAY

    var nodes: Node_View[Role_T] = Node_View[Role_T](NO_ROLE, PALETTE, 24.0, 6.0, 5.0)
    nodes.mark(START, GREEN, PALE_GREEN)            # a node in START: its rim and its fill
    var edges: Edge_View[Role_T] = Edge_View[Role_T](NO_ROLE, PALETTE, 6.0)
    edges.mark(WAY, ORANGE)

    nodes.to_html("A", Spot_T(x: 80.0, y: 210.0), START)
    page.shell_text(title, nodes.css() + edges.css(), ...)

What the browser finds on them: a node is <g class="node [state]" data_name data_x data_y> with
its circle, its label (text.name) and its port (circle.port, the dot on its right, from which the
script draws a wire); an edge is <g data_from data_to data_cost> with its line (path.edge), a wider
transparent one to click (path.hit) and its label (text.cost). The class `selected` on either is
drawn in the palette's accent. Nim only (ady2nim c and js), as html: blocks are.
"""
from drawing import Drawing_Pixel_T, Spot_T
from style import Look, Rule, Style

# The colours of a graph's drawing.
type Graph_Palette is record:
    ink:    str = "#1f2933"         # a node's label, and its rim under the pointer
    soft:   str = "#616e7c"         # an edge's label
    line:   str = "#b0b8c1"         # an edge
    rim:    str = "#7b8794"         # a node
    paper:  str = "#fff"            # a node's inside, and the halo of an edge's label
    accent: str = "#3a66db"         # what is selected, and a node's port

# A node: its circle, R in radius, its label NAME_DY under its middle, and a port (PORT_R in radius)
# on its right. Its look is in three Styles, in this order: the node's own, its states' (`mark`),
# and the selected node's, which wins over a state's.
class Node_View[State_T]:
    var plain:    State_T
    var r:        Drawing_Pixel_T
    var port_r:   Drawing_Pixel_T
    var name_dy:  Drawing_Pixel_T
    var style:    Style
    var states:   Style
    var selected: Style

    def __init__(self, plain: State_T, colours: Graph_Palette, r: Drawing_Pixel_T, port_r: Drawing_Pixel_T, name_dy: Drawing_Pixel_T):
        self.plain = plain
        self.r = r
        self.port_r = port_r
        self.name_dy = name_dy
        self.style = Style("g.node", [
            Rule("", Look(cursor="grab")),
            Rule(" circle", Look(fill=colours.paper, stroke=colours.rim, stroke_width=2)),
            Rule(":hover circle", Look(stroke=colours.ink))])
        self.states = Style("g.node")
        self.selected = Style("g.node", [
            Rule(".selected circle", Look(stroke=colours.accent, stroke_width=4)),
            Rule(" circle.port", Look(fill=colours.accent, opacity=0, cursor="crosshair")),
            Rule(":hover circle.port", Look(opacity=1)),
            Rule(".selected circle.port", Look(opacity=1)),
            Rule(" text.name", Look(font_size="16px", font_weight=700, text_anchor="middle", pointer_events="none", fill=colours.ink))])

    # A node in STATE: its rim, and its fill ("" keeps the paper).
    def mark(self, state: State_T, rim: str, fill: str = ""):
        var states: Style = self.states         # (the call alone does not make self var)
        states.when(state, " circle", Look(fill=fill, stroke=rim, stroke_width=4))
        self.states = states

    # The node labelled NAME at AT, in STATE.
    def to_html(self, name: str, at: Spot_T, state: State_T) -> Html:
        let cx: str = f"{at.x:.0f}"
        let cy: str = f"{at.y:.0f}"
        let ty: str = f"{at.y + self.name_dy:.0f}"
        let px: str = f"{at.x + self.r:.0f}"
        let css: str = ("node" if state == self.plain else "node " + self.style.class_of(state))
        let nr: str = f"{self.r:.0f}"
        let pr: str = f"{self.port_r:.0f}"
        html:
            g class=css data_name=name data_x=cx data_y=cy:
                circle cx=cx cy=cy r=nr
                stext class="name" x=cx y=ty: name
                circle class="port" cx=px cy=cy r=pr

    # The rules of every node, for the page's <style>.
    def css(self) -> str:
        return self.style.css() + self.states.css() + self.selected.css()

# An edge: a line between two places, and its label LABEL_DY over its middle. Its look is in three
# Styles, in this order: the edge's own, its states' (`mark`), and the selected edge's.
class Edge_View[State_T]:
    var plain:    State_T
    var label_dy: Drawing_Pixel_T
    var style:    Style
    var states:   Style
    var selected: Style

    def __init__(self, plain: State_T, colours: Graph_Palette, label_dy: Drawing_Pixel_T):
        self.plain = plain
        self.label_dy = label_dy
        self.style = Style("g[data-from]", [Rule(" path.edge", Look(stroke=colours.line, stroke_width=2.5, fill="none"))])
        self.states = Style("g[data-from]")
        self.selected = Style("g[data-from]", [
            Rule(".selected path.edge", Look(stroke=colours.accent, stroke_width=5)),
            Rule(" path.hit", Look(stroke="transparent", stroke_width=14, fill="none", cursor="pointer")),
            Rule(" text.cost", Look(font_size="13px", fill=colours.soft, text_anchor="middle", paint_order="stroke", stroke=colours.paper, stroke_width=4))])

    # An edge in STATE: its colour, and a wider line.
    def mark(self, state: State_T, stroke: str):
        var states: Style = self.states
        states.part(" path.edge." + self.style.class_of(state), Look(stroke=stroke, stroke_width=5))
        self.states = states

    # The edge from the node labelled A to the one labelled B, from P1 to P2, labelled LABEL, in STATE.
    def to_html(self, a: str, b: str, label: str, p1: Spot_T, p2: Spot_T, state: State_T) -> Html:
        let d: str = f"M {p1.x:.0f} {p1.y:.0f} L {p2.x:.0f} {p2.y:.0f}"
        let css: str = ("edge" if state == self.plain else "edge " + self.style.class_of(state))
        let lx: str = f"{(p1.x + p2.x) / 2.0:.0f}"
        let ly: str = f"{(p1.y + p2.y) / 2.0 - self.label_dy:.0f}"
        html:
            g data_from=a data_to=b data_cost=label:
                path class=css d=d
                path class="hit" d=d
                stext class="cost" x=lx y=ly: label

    # The rules of every edge, for the page's <style>.
    def css(self) -> str:
        return self.style.css() + self.states.css() + self.selected.css()
