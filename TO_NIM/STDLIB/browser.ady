#!/usr/bin/env ady2nim
#ady2nim-args js
"""browser -- the page, for a script that runs in the browser (ady2nim js), in plain words.

An Adascript programmer should not have to learn JavaScript and the DOM to make a page do
something. This module says what a script needs in the words of the page itself: find an
element, read what the server wrote on it, change where it is drawn, fill in a form, press a
button. svg_drag builds on it; an app script imports what it uses:

    from browser import Element_T, page, find, element, all, data, number, has_class, set_attr, fill, field, press

Everything here is called with a dot on what it works on (Nim allows any function to be
called on its first argument that way):

    let form: Element_T = page.element("#move")    # the element the CSS selector matches (must be there)
    for edge in page.all("g.edge"): ...         # all of them
    node.data("name")                           # data_name="C" -> "C"  (what the server wrote)
    node.number("data_x")                       # an attribute, as a number (0.0 if it is not one)
    node.has_class("from")                      # class="node from" -> True
    node.set_html("<b>3</b> done")               # what the element shows, in place of what it showed
    label.set_attr("x", "120")                  # change an attribute
    form.fill("x", "120")                       # put a value in the form's input named x
    form.field("pos")                           # and read one
    page.press("#redraw")                       # click a button, as the user would

A change sent to the server through a form is a Change: fill its fields by name, then press its button,
which sends them (htmx sends the form the button is in):

    let change: Change = Change("#gesture")     # the form, by its CSS selector
    change.set("name", "A")                     # a field of it, by name
    change.send("#make_node")                   # its button

A request can also go without a form: `request` sends its fields by name and puts the answer
in the page, as htmx does for a button:

    request("DELETE", "/nodes", {"name": "A"}, "#all", "#state")   # METHOD, URL, fields, target, forms included

A CSS selector names elements the way the page's stylesheet does: "g.node" is a <g> of class
node, "#move" the element with id="move", "g[data_from]" a <g> that has a data_from
attribute, "input[name=pos]" the <input> named pos.

Finding an element, two ways, by whether it may be missing:

    let maybe: ?Element_T = page.find("#note")     # None when there is no such element
    if maybe is None:
        return                                     # test it before using it, as here
    maybe.set_attr("hidden", "")
    let form: Element_T = page.element("#move")    # must be there: the script stops if it is not

`find` answers None when nothing matches; test it with `is None` or `is not None`, or with an
early return, before you use it. `element` is for the page's own elements, which the server
always draws: when one is missing, the script stops with an assertion that names the selector
(it shows in the browser's console), and nothing else on the page stops. `on(c, css)`, for a
click, is like `find`: None when the click was not on such an element.

Compare with None, not nil: nil is the Nim spelling of the same thing, and Adascript writes None.

What is underneath, for the curious: the page as the browser holds it is the DOM ("document
object model"), a tree of elements, one per HTML tag; `page` is its root. Strings cross into
it as the browser's own cstring, which this module converts both ways.
"""
from dom nimport Node, Element, InputElement, Event, MouseEvent, document, window, getAttribute, setAttribute, querySelector, querySelectorAll, click, closest, stopPropagation, preventDefault, addEventListener, prompt, confirm, KeyboardEvent, value
from js/jsffi nimport *

# An element of the page: a <g>, a <path>, a <form>, an <input>, the page itself.
type Element_T is Node

# The whole page: what `find` and `all` search when nothing narrower is given.
let page: Element_T = document

# An attribute's name as the page has it: what Adascript spells data_x, an `html:` block
# writes data-x (a name with `_` is written with `-`), and so does every name here.
def page_name(name: str) -> str:
    return name.replace("_", "-")

# CSS with its attribute names as the page has them: "g[data_from]" finds data-from.
def page_css(css: str) -> str:
    var out: str = ""
    var in_name: bool = False
    for ch in css:
        if ch == '[':
            in_name = True
        elif ch == '=' or ch == ']':
            in_name = False
        if in_name and ch == '_':
            out = out + "-"
        else:
            out = out + str(ch)
    return out

# The first element below WITHIN that the CSS selector CSS matches, or None when there is none.
def find(within: Element_T, css: str) -> ?Element_T:
    let found: Element_T = within.querySelector(cstring(page_css(css)))
    if found is None:
        return None
    return found

# The first element below WITHIN that CSS matches, which must be there: the script stops if it is not
# (for an element the page is always drawn with). Use `find` when it may be missing.
def element(within: Element_T, css: str) -> Element_T:
    let found: Element_T = within.querySelector(cstring(page_css(css)))
    assert found is not None, f"no element matches {css}"
    return found

# All the elements below WITHIN that CSS matches, in the order of the page.
def all(within: Element_T, css: str) -> []Element_T:
    var found: []Element_T = []
    for e in within.querySelectorAll(cstring(page_css(css))):
        found.append(e)
    return found

# The text of attribute NAME of NODE ("" when it has none).
def attr(node: Element_T, name: str) -> str:
    let v: cstring = node.getAttribute(cstring(page_name(name)))
    if v is None:
        return ""
    return str(v)

# Set attribute NAME of NODE to VALUE.
def set_attr(node: Element_T, name: str, value: str):
    node.setAttribute(cstring(page_name(name)), cstring(value))

# What the server wrote in NODE's data_NAME attribute: `node.data("name")` reads data_name
# (data-name in the page).
def data(node: Element_T, name: str) -> str:
    return attr(node, "data_" + name)

# Attribute NAME of NODE as a number; 0.0 when it is not one.
def number(node: Element_T, name: str) -> float:
    let r: float | !ParseFailure_T = parse_float(attr(node, name))
    if r is ParseFailure_T:
        return 0.0
    return r

# The text inside NODE ("" for no element at all).
def text(node: Element_T) -> str:
    if node is None:
        return ""
    return str(node.textContent)

# Put HTML in NODE, in place of what it held: a table the script has worked out, say. The text is
# the page's own markup, so what the reader typed must not go into it as it is.
def set_html(node: Element_T, html: str):
    Element(node).innerHTML = cstring(html)

# Whether NODE has the CSS class WORD: class="node from" holds two.
def has_class(node: Element_T, word: str) -> bool:
    return f" {word} " in " " + attr(node, "class") + " "

# The value of the input named NAME within FORM (or within the whole page).
def field(form: Element_T, name: str) -> str:
    return str(InputElement(form.element(f"input[name={name}]")).value)

# Put VALUE in the input named NAME within FORM (or within the whole page).
def fill(form: Element_T, name: str, value: str):
    InputElement(form.element(f"input[name={name}]")).value = cstring(value)

# Click the element CSS matches within WITHIN, as the user would: a button sends its form.
def press(within: Element_T, css: str):
    Element(within.element(css)).click()

# A change sent to the server through a form of the page: its fields are filled in by name, then a
# button is pressed, which sends them (htmx sends the form the button is in). FORM is a CSS selector for
# the form, BUTTON one for the button; the fields are looked for within the form.
class Change:
    var form: Element_T

    def __init__(self, form: str):
        self.form = page.element(form)

    # Put VALUE in the field NAME of the form.
    def set(self, name: str, value: str):
        self.form.fill(name, value)

    # Press the button BUTTON, which sends the form.
    def send(self, button: str):
        page.press(button)

# htmx, which the page loads: what sends a request and puts the answer in the page.
jsvar htmx: JsObject

# Send a request to the server and put its answer in the page, as a button with hx-* attributes
# does, with no form or button for it. METHOD is "GET", "POST", "PUT" or "DELETE", and URL where it
# goes. FIELDS are sent by name, after the fields within INCLUDE, CSS selectors such as "#state,
# #move" ("" for none), so a field named in both is sent as FIELDS has it. The answer takes the
# place of TARGET, a CSS selector, the whole element (htmx's outerHTML swap).
def request(method: str, url: str, fields: {str}str, target: str, include: str = ""):
    var values: JsObject = newJsObject()
    if include != "":
        for part in include.split(","):
            let within: str = part.strip()
            for input in page.all(f"{within} input[name], {within} select[name], {within} textarea[name]"):
                let kind: str = input.attr("type")
                if (kind == "checkbox" or kind == "radio") and not InputElement(input).checked:
                    continue                # sent only when ticked, as a form sends it
                values[cstring(input.attr("name"))] = cstring(str(InputElement(input).value))
    for name, value in fields.items():
        values[cstring(name)] = cstring(value)
    htmx.ajax(cstring(method), cstring(url), {"target": cstring(target), "swap": "outerHTML", "values": values})

# ---- A click, as the script is told of it ----

# What a click is to a script: whether shift was held, and the element clicked. `on(css)`
# is the element CSS matches that the click was on or inside (None when none), and `stop()`
# keeps the click from going any further: nothing else on the page (htmx) hears of it.
type Click_T is record:
    shift:  bool
    target: Element_T
    event:  Event

def click_of(e: Event) -> Click_T:
    return Click_T(MouseEvent(e).shiftKey, e.target, e)

def on(c: Click_T, css: str) -> ?Element_T:
    let found: Element_T = c.target.closest(cstring(page_css(css)))
    if found is None:
        return None
    return found

def stop(c: Click_T):
    c.event.stopPropagation()

# Whether the click was made with the left button (the main one).
def left(c: Click_T) -> bool:
    return MouseEvent(c.event).button == 0

# The key the reader pressed: "Delete", "Escape", "a" ...
def key_of(e: Event) -> str:
    return str(KeyboardEvent(e).key)

# Show MENU (an element of the page, hidden until now) where the mouse was when C happened.
def show_at(menu: Element_T, c: Click_T):
    let m: MouseEvent = MouseEvent(c.event)
    menu.set_attr("style", f"display:block; left:{m.clientX}px; top:{m.clientY}px")

# Whether the reader made the click (with the mouse or a key), not a script that pressed a button.
def made_by_reader(c: Click_T) -> bool:
    return c.event.isTrusted

# What the browser would do with the event itself: a right click's menu, say. It does not happen.
def cancel(c: Click_T):
    c.event.preventDefault()

# ---- Events the page sends, and questions the page asks ----

# What the page sends a listener: a click, a key, a move; a Click_T (above) says a click's part.
type Event_T is Event

# What a listener is: a function that is told of the event.
type Listener_T is (Event_T) -> None

# Call HANDLER for every EVENT the page sends, KIND being "mousemove", "dblclick", ... (after
# the elements that are in the way have had theirs).
def listen(kind: str, handler: Listener_T):
    addEventListener(document, cstring(kind), handler)

# As `listen`, but called first, before any element, and it may `stop` the event there.
def listen_first(kind: str, handler: Listener_T):
    addEventListener(document, cstring(kind), handler, true)

# Ask the reader a question, with a box for the answer filled in with ANSWER; "" when they
# cancel it, or leave it empty.
def ask(question: str, answer: str) -> str:
    let got: cstring = window.prompt(cstring(question), cstring(answer))
    if got is None:
        return ""
    return str(got)

# Ask the reader to say yes or no to QUESTION.
def ask_yes(question: str) -> bool:
    return window.confirm(cstring(question))
