#!/usr/bin/env ady2nim
#ady2nim-args js
"""svg_drag -- drag the shapes of an SVG drawing with the mouse, in the browser (ady2nim js).

For a page drawn on the server and kept up to date by htmx: everything else is declared in
the HTML, and only what must follow the mouse every frame runs in the browser. This module
holds what every such drag has in common; the app says what a drag means:

    from svg_drag import Hooks_T, Spot_T, draggable
    def moved_cb(node: Element_T, centre: Spot_T, wanted: Spot_T) -> Spot_T: ...   # during the drag
    def dropped_cb(node: Element_T, at: Spot_T): ...                           # when it is let go
    draggable("g.node", "svg.graph", 580.0, Hooks_T(moved_cb=moved_cb, dropped_cb=dropped_cb, clicked_cb=no_click_cb))

A shape that can be dragged is an element (`g.node` above) carrying its centre, in the
drawing's units, in the attributes data_x and data_y, as the server drew it. While it is
dragged, `moved_cb` is told where the mouse has taken that centre, and answers where the shape
is (it may keep it inside the drawing, or not move it at all). When it is let go, `dropped_cb`
is told where it ended; it usually fills in a hidden form and clicks its button, so that
htmx sends the new place to the server, which draws the page again.

A press that does not move is a click, and goes on to htmx. The click the browser sends
after a drag is swallowed, so a shape is not clicked by being moved. Other clicks go to
`clicked_cb` first, as a Click_T (browser.ady): a shift-click, say, which it may stop.

Used by EXAMPLES/DIJKSTRA_HTMX and TOOLS/ACCOUNTING.

The page itself (finding elements, reading what the server wrote, forms, clicks) is the
browser module's, in plain words; this one adds the drawing: its units, a drag, and moving
what is drawn.
"""
from browser import Element_T, page, set_attr, number, Click_T, click_of, on
from dom nimport Event, MouseEvent, BoundingRect, document, getBoundingClientRect, addEventListener, preventDefault, stopPropagation

# ---- Two units: the mouse's and the drawing's ----
#
# The mouse reports pixels; the server keeps a shape's place in the drawing's own units (its
# viewBox), whatever size the drawing has on the screen. `distinct` makes them two types, so
# adding a pixel to a drawing unit does not compile. The only way across is the scale.

type Pixel_T is distinct float          # on the screen, as the mouse reports it
type Unit_T is distinct float           # in the drawing, as the server keeps a shape's place
type Scale_T is Unit_T / Pixel_T        # drawing units a pixel: pixels * scale = units

type Screen_T is tuple:                   # a place on the screen
    x: Pixel_T
    y: Pixel_T

type Spot_T is tuple:                     # a place in the drawing
    x: Unit_T
    y: Unit_T

const MOVED: Pixel_T = 4.0              # how far a press goes before it is a drag

# What the app says a drag means (see the docstring).
type Moved_T is (Element_T, Spot_T, Spot_T) -> Spot_T   # the shape, its centre when pressed, where the mouse has taken it -> where it is
type Dropped_T is (Element_T, Spot_T) -> None       # the shape, where it was let go
type Clicked_T is (Click_T) -> None                 # any click that is not the end of a drag

# What the app says a drag means, as one value for draggable.
type Hooks_T is record:
    moved_cb:   Moved_T
    dropped_cb: Dropped_T
    clicked_cb: Clicked_T

# What draggable was given: the shapes, the drawing, and the hooks.
type Setup_T is record:
    shapes: str                         # the CSS selector of the shapes that can be dragged
    svg:    str                         # the CSS selector of the <svg>
    width:  Unit_T                      # its width, in its own units
    hooks:  Hooks_T

# ---- The drag, as a small state machine ----
#
#            mousedown on a shape           mousemove more than 4 px
#   IDLE  ------------------------>  PRESSED  ---------------------->  DRAGGING
#    ^  ^                               |                                 |
#    |  +------- mouseup (a click) -----+                                 | mouseup: dropped_cb(..)
#    |                                                                    |
#    +------------- click (the browser's, swallowed) ---- DROPPED  <-----+
#
# IDLE: nothing pressed. PRESSED: a shape is held but has not moved, so letting go is a
# click. DRAGGING: it has moved. DROPPED: a drag has just ended, and the click the browser
# sends after it is not a click.

# Each phase is a record of its own, and the drag is a union of them. A value is built by
# naming its phase, `Pressed_T(node, ...)` or `Idle_T()`, and `grip is Pressed_T` asks which
# phase it is in. Each record holds only the fields of its phase: reading `grip.node` is
# allowed only where an `is` test has narrowed `grip` to a phase that has a node.
type Idle_T is record: pass             # nothing held
type Ended_T is record: pass            # a drag has just ended
type Held_T is record:                  # a shape is held, from the press until it is let go
    node:   Element_T                   # the shape held
    down:   Screen_T                    # where the mouse went down
    centre: Spot_T                      # the shape's centre then
    now:    Spot_T                      # and where it is now, as `moved_cb` answered
    moved:  bool                        # false from the press until the mouse has gone MOVED pixels;
                                        # then true for the rest of the drag. A held shape that has not
                                        # moved is a click when it is let go, and a drag when it has.

type Grip_T is Idle_T | Held_T | Ended_T

var grip: Grip_T = Idle_T()             # the one drag there is; nothing held at first
var setup: Setup_T                      # what draggable was given; set before any mouse event

# ---- Reading the page ----

# Attribute NAME of NODE ("data_x", "data_y") as drawing units; 0 if it is not a number.
def unit_of(node: Element_T, name: str) -> Unit_T:
    Unit_T(node.number(name))

# Where a shape's centre is, as the server last drew it.
def spot_of(node: Element_T) -> Spot_T:
    Spot_T(x=unit_of(node, "data_x"), y=unit_of(node, "data_y"))

# Where the mouse was when event M happened, on the screen.
def screen_of(m: MouseEvent) -> Screen_T:
    Screen_T(x=Pixel_T(float(m.clientX)), y=Pixel_T(float(m.clientY)))

# The drawing's size and place on the screen, in pixels. It is asked each time: the window may
# have been resized, and the drawing is scaled to fit the page.
def svg_box() -> BoundingRect:
    page.element(setup.svg).getBoundingClientRect()

# How many drawing units a pixel is.
def scale() -> Scale_T:
    setup.width / Pixel_T(svg_box().width)   # units / pixels: a Scale_T

# Where the mouse was when event E happened, in the drawing's units: the drawing's own place
# on the screen is taken off first, so the top left of the drawing is 0, 0.
def spot_at(e: Event) -> Spot_T:
    let m: MouseEvent = MouseEvent(e)
    let box: BoundingRect = svg_box()
    let k: Scale_T = setup.width / Pixel_T(box.width)
    Spot_T(x=Pixel_T(float(m.clientX) - box.left) * k, y=Pixel_T(float(m.clientY) - box.top) * k)

# ---- Changing the page ----

# Draw NODE, whose centre the server put at CENTRE, at NOW instead: its picture is shifted by
# the difference. Its data_x/data_y stay CENTRE until the server draws the page again.
def shift(node: Element_T, centre: Spot_T, now: Spot_T):
    node.set_attr("transform", f"translate({now.x - centre.x:.1f},{now.y - centre.y:.1f})")

# Draw the <path> LINE as a straight line from A to B.
def draw_line(line: Element_T, a: Spot_T, b: Spot_T):
    line.set_attr("d", f"M {a.x:.1f} {a.y:.1f} L {b.x:.1f} {b.y:.1f}")

# Give the <path> PATH the curve D, as SVG writes one ("M x y C ...").
def trace(path: Element_T, d: str):
    path.set_attr("d", d)

# Put the <text> LABEL at AT.
def place_at(label: Element_T, at: Spot_T):
    label.set_attr("x", f"{at.x:.1f}")
    label.set_attr("y", f"{at.y:.1f}")

# V kept between LO and HI.
def clamp(v: Unit_T, lo: Unit_T, hi: Unit_T) -> Unit_T:
    max(lo, min(hi, v))

# For an app with nothing to do on a click.
def no_click_cb(c: Click_T):
    pass

# ---- The listeners: what each mouse event does, by phase ----

# A button went down. If it is the left one (button 0) and on a shape, hold that shape.
def on_down(e: Event):
    let m: MouseEvent = MouseEvent(e)
    return if m.button != 0
    let node: ?Element_T = on(click_of(e), setup.shapes)   # the press may be on a part of the shape
    return if node is None
    let centre: Spot_T = spot_of(node)
    grip = Held_T(node=node, down=screen_of(m), centre=centre, now=centre, moved=false)
    e.preventDefault()                  # stop the browser's own drag, which selects text

# The mouse moved. The browser sends this many times a second, whether a button is down or not.
def on_move(e: Event):
    if grip is Held_T:
        let at: Screen_T = screen_of(MouseEvent(e))
        let dx: Pixel_T = at.x - grip.down.x   # how far from where it went down
        let dy: Pixel_T = at.y - grip.down.y
        # a small move is not yet a drag: a hand shakes, and it may still be a click
        return if not grip.moved and abs(dx) < MOVED and abs(dy) < MOVED
        let k: Scale_T = scale()    # pixels * scale = drawing units
        let wanted: Spot_T = Spot_T(x=grip.centre.x + dx * k, y=grip.centre.y + dy * k)
        let now: Spot_T = setup.hooks.moved_cb(grip.node, grip.centre, wanted)
        grip = Held_T(node=grip.node, down=grip.down, centre=grip.centre, now=now, moved=true)

# The button came up.
def on_up(e: Event):
    if grip is Held_T:
        if grip.moved:
            # still a drag while the app answers, so a click it makes (on a form's button)
            # goes through on_click
            setup.hooks.dropped_cb(grip.node, grip.now)
            grip = Ended_T()
        else:
            grip = Idle_T()             # it never moved: a click, which the browser sends next and htmx handles

# A click. The browser sends one after every mouseup, a drag's too; htmx would take that one
# as a click on the shape. So after a drag (ENDED) the click is stopped here, before htmx
# sees it. Any other click is the app's first.
def on_click(e: Event):
    if grip is Ended_T:
        grip = Idle_T()
        e.stopPropagation()             # the event goes no further up the tree, so htmx never sees it
        return
    setup.hooks.clicked_cb(click_of(e))

# Make the shapes SHAPES (a CSS selector) of the drawing DRAWING (the <svg>, WIDTH units wide)
# draggable: HOOKS say what a drag means (see the docstring).
#
# The listeners are on the whole document, so a drag goes on when the mouse leaves the
# shape. The click listener gets True ("capture"): it is called on the way down the tree,
# before htmx, which listens on the way up.
def draggable(shapes: str, drawing: str, width: Unit_T, hooks: Hooks_T):
    setup = Setup_T(shapes=shapes, svg=drawing, width=width, hooks=hooks)
    document.addEventListener("mousedown", on_down)
    document.addEventListener("mousemove", on_move)
    document.addEventListener("mouseup", on_up)
    document.addEventListener("click", on_click, True)
