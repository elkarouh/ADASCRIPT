# IDE and editor directories — ignore local Claude state, but track the
# shared SessionStart hook and project settings so web sessions pick them up.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json

# Build artifacts
NIM_VERSION/
*.exe
*.png
EXAMPLES/**/*.nim
ADA_INDENT/ada_indent
ADA_INDENT/test_ada_indent
ADA_INDENT/ada_indent_gen.py
ADA_INDENT/ada_lexer
ADA_INDENT/test_ada_lexer
ADA_INDENT/ada_line_fmt
ADA_INDENT/test_ada_line_fmt
ADA_INDENT/*_gen.py
# ady2nim drops a symlink to the built binary next to each source, so the
# bundled libraries leave one behind whenever they are compiled. They point
# into ~/.cache/adascript, which is per-machine.
TO_NIM/STDLIB/awk
TO_NIM/STDLIB/db
TO_NIM/STDLIB/graphs
TO_NIM/STDLIB/iters
# The js backend names its output after the source rather than hiding it,
# so jointjs leaves a .js symlink rather than an extensionless one.
TO_NIM/STDLIB/jointjs.js

# Obsolete/deprecated code
OBSOLETE/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
.env/

# IDE
.idea/
.vscode/
*.swp
*.swo
BENCHMARK/phonecode
BENCHMARK/graph
BENCHMARK/h_shortest_path
BENCHMARK/*.nim
BENCHMARK/IGNORE/
files.zip
BENCHMARK/primes
BENCHMARK/show_status
sublime-claude/
