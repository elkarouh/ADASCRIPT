# IDE and editor directories — ignore local Claude state, but track the
# shared SessionStart hook and project settings so web sessions pick them up.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json

# Build artifacts
NIM_VERSION/
*.exe
*.png
EXAMPLES/**/*.nim
BROWSER_EXAMPLES/**/*.nim
TESTS/**/*.nim
!TESTS/hand_speeds.nim
TOOLS/ADA_INDENT/ada_indent
TOOLS/ADA_INDENT/test_ada_indent
TOOLS/ADA_INDENT/ada_indent_gen.py
TOOLS/ADA_INDENT/ada_lexer
TOOLS/ADA_INDENT/test_ada_lexer
TOOLS/ADA_INDENT/ada_line_fmt
TOOLS/ADA_INDENT/test_ada_line_fmt
TOOLS/ADA_INDENT/*_gen.py
# git1 lives in TOOLS/GIT1/ and leaves the same symlink next to its source.
TOOLS/GIT1/git1
TOOLS/GIT1/*_gen.py

# Pgrep, the same again.
TOOLS/PGREP/Pgrep
TOOLS/PGREP/*_gen.py

# Tcheck_tact, the same again.
TOOLS/TCHECK/Tcheck_tact
TOOLS/TCHECK/make_comparable
TOOLS/TCHECK/Tcheckout
TOOLS/TCHECK/*_gen.py

# Tblame, the same again.
TOOLS/TBLAME/Tblame
TOOLS/TBLAME/*_gen.py
# Tdiff and Tdiff_lines, likewise.
TOOLS/TDIFF/Tdiff
TOOLS/TDIFF/Tdiff_lines
TOOLS/TDIFF/*_gen.py
# rsync_time_machine and lolcate, likewise.
TOOLS/RSYNC_TIME_MACHINE/rsync_time_machine
TOOLS/RSYNC_TIME_MACHINE/*_gen.py
TOOLS/LOLCATE/lolcate
TOOLS/LOLCATE/*_gen.py
# c500 and lv, likewise.
TOOLS/C500/c500
TOOLS/C500/*_gen.py
TOOLS/LISPY/lispy
TOOLS/LISPY/lispy_union
TOOLS/LISPY/lispy_short
TOOLS/LV/lv
TOOLS/LV/lv_awk
TOOLS/LV/lv_cmd
TOOLS/LV/*_gen.py

# Thist, the same again.
TOOLS/THIST/Thist
TOOLS/THIST/*_gen.py

# ady2nim drops a symlink to the built binary next to each source, so the
# bundled libraries leave one behind whenever they are compiled. They point
# into ~/.cache/adascript, which is per-machine.
TO_NIM/STDLIB/awk
TO_NIM/STDLIB/db
TO_NIM/STDLIB/graphs
TO_NIM/STDLIB/iters
# The js backend names its output after the source rather than hiding it,
# so jointjs leaves a .js symlink rather than an extensionless one.
TO_NIM/STDLIB/jointjs.js
TO_NIM/STDLIB/svg_drag.js
TO_NIM/STDLIB/browser.js
TO_NIM/STDLIB/svg_path.js

# The tests' builds, likewise: ady2nim leaves a symlink to the binary next
# to each test it compiles, and nim a binary next to a .nim. Everything in
# TO_NIM/TEST without an extension is one of those.
TO_NIM/TEST/*
!TO_NIM/TEST/*.*

# Tcheck_tact's modules, built alone to run their own tests
TOOLS/TCHECK/LIBS/*
!TOOLS/TCHECK/LIBS/*.ady

# Obsolete/deprecated code
OBSOLETE/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
.env/

# IDE
.idea/
.vscode/
*.swp
*.swo
EXAMPLES/PHONECODE/phonecode
BENCHMARK/graph
BENCHMARK/h_shortest_path
BENCHMARK/*.nim
BENCHMARK/IGNORE/
files.zip
BENCHMARK/primes
BENCHMARK/show_status
sublime-claude/

# What the PGREP test builds for its Python-backend run.
TOOLS/PGREP/test/Pgrep_py.py
TOOLS/PGREP/test/pgrep_py
node_modules/
BROWSER_EXAMPLES/HTML/build/

