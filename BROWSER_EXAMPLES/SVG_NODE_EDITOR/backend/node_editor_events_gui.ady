#!/usr/bin/env ady2nim
"""node_editor_events_gui -- what each event the page sends does, and the diagram it does it to; no HTTP.

server.ady hands every request to a Session, as a method, a path and its fields, and sends back
what comes out. The tests make a Session of their own and call answer() the same way, with no server
running.

Commands in, events out, as in DIJKSTRA_HTMX. Every request is read back into a Command, the page's
own vocabulary (node_editor_commands.ady): Create, Read, Update or Delete, of a node or a connector. A
read answers the whole page. A change answers only whether it went through: the paragraph #problem,
empty, or saying why not. When it went through, what it changed is published with the same verbs,
one channel per collection, named by Channel_T: NODES_CHAN and LINKS_CHAN carry a Change (CREATE,
UPDATE or DELETE, and which one). Whoever must hear of it subscribes -- the server, which keeps the
diagram in its file (`keep`) and tells every open page, which then reads itself again -- and the
Session knows none of them:

    def heard(channel: Channel_T, change: Change):
        print channel, change.kind, change.key          # "NODES_CHAN CREATE 4", "LINKS_CHAN DELETE 0 2 3 2"
    session.nodes_channel.subscribe(heard)

Reset is a command on the whole diagram (DELETE /all: the sample comes back), and what it changes
is an UPDATE with no key: everything, read it all again.
"""
from drawing import Spot_T
from blackboard import PublishChannel
from page_request import Page_Request
from store import Store
from commands import Verb_T, CREATE, READ, UPDATE, DELETE, Change
from backend/node_editor_model import Diagram, Link_T, Refusal_T, sample
from backend/node_editor_gui import all_text, problem_text
from backend/node_editor_commands import Command, NODE, LINK, DIAGRAM, command_of, link

# The channels of the server's blackboard: one per collection.
type Channel_T is enum NODES_CHAN, LINKS_CHAN

# A channel of the session's: one of Channel_T, carrying a Change.
type Change_Channel_T is PublishChannel[Channel_T, Change]

# A connector as a Change names it: from output out_row of out_node to input in_row of in_node.
def link_key(l: Link_T) -> str:
    return f"{l.out_port.node} {l.out_port.port.row} {l.in_port.node} {l.in_port.port.row}"

# The diagram is kept under this name, in the session's store.
const KEPT_AS: str = "diagram.txt"

# The diagram, and the store it is kept in (the stdlib's store.ady), which the session is given:
# the server's keeps it in the directory it runs in, the page alone's (frontend/frontend_server.ady)
# in the browser, the tests' in memory.
class Session:
    var diagram: Diagram
    var store: Store                    # where the diagram is kept, as KEPT_AS
    var unsaved: None | !Refusal_T      # why the last change could not be kept, shown on the page
    var nodes_channel: Change_Channel_T = Change_Channel_T(NODES_CHAN)    # what happened to a node
    var links_channel: Change_Channel_T = Change_Channel_T(LINKS_CHAN)    # what happened to a connector

    def __init__(self, store: Store):
        self.store = store
        self.unsaved = None
        let text: ?str = store.read(KEPT_AS)
        if text is None:
            self.diagram = sample()     # nothing kept yet: the sample
        else:
            self.diagram = Diagram(text)

    # The diagram written to the store: refused with why, when it was not.
    def save(self) -> None | !Refusal_T:
        if not self.store.write(KEPT_AS, self.diagram.text()):
            return Refusal_T(message=f"Could not write {KEPT_AS}.")

    # Keep the diagram in the store, after a change: what the server subscribes to the channels.
    # When it cannot, every page says so, from `unsaved`, until a later change is kept.
    def keep(self):
        self.unsaved = self.save()

    # The routes, all answered by answer below, each a Command (on the wire, the verb is the method
    # and the thing the URL). The read answers a whole page for htmx to swap in; the others the
    # paragraph #problem (empty when the command went through).
    #
    #     GET    /all          R the page again
    #     DELETE /all          D the diagram: the sample is put back
    #     POST   /nodes        C a node                            (title, x, y: its top left corner)
    #     PUT    /nodes        U a node moved, after a drag        (id, x, y)
    #     DELETE /nodes        D a node and its connectors         (id)
    #     POST   /links        C a connector, output to input      (out_node, out_row, in_node, in_row)
    #     DELETE /links        D a connector                       (out_node, out_row, in_node, in_row)

    # What METHOD on PATH does, with FIELDS (the query and the body, "a=1&b=2"): what to send back,
    # or "" when there is no such thing.
    def answer(self, method: str, path: str, fields: str) -> str:
        let c: ?Command = command_of(method, path, Page_Request(method, path, fields).fields)
        if c is None:
            return ""
        if c.verb == READ:
            return all_text(self.diagram, self.unsaved)
        case c.thing:
            when NODE:
                return problem_text(self.change_node(c))
            when LINK:
                return problem_text(self.change_link(c))
            when DIAGRAM:
                return problem_text(self.change_diagram(c))

    # The node C names (its field id) created, with its title, at x, y; moved there; or deleted, with
    # its connectors. When it went through, what changed is published; when not, why.
    def change_node(self, c: Command) -> None | !Refusal_T:
        var id: int = c.number_value("id")
        let at: ?Spot_T = c.spot()
        var refused: None | !Refusal_T = None
        case c.verb:
            when CREATE:
                id = self.diagram.next_id()
                if at is None:
                    refused = Refusal_T(message="Where should the node go? There is no place.")
                else:
                    refused = self.diagram.add_node(c.value("title"), at)
            when UPDATE:
                if at is None:
                    refused = Refusal_T(message=f"Where should node {id} go? There is no place.")
                else:
                    refused = self.diagram.move(id, at)
            when DELETE:
                let links: []Link_T = [l for l in self.diagram.links if l.out_port.node == id or l.in_port.node == id]
                refused = self.diagram.remove_node(id)
                if refused is None:
                    for l in links:                 # its connectors went with it, and are told first
                        self.links_channel.publish(Change(DELETE, link_key(l)))
            when others:
                pass                                # a node is not read (command_of)
        if refused is None:
            self.nodes_channel.publish(Change(c.verb, str(id)))
        return refused

    # The connector C names (its fields out_node, out_row, in_node, in_row) made or deleted. When it
    # went through, what changed is published; when not, why.
    def change_link(self, c: Command) -> None | !Refusal_T:
        let l: Link_T = c.link()
        var refused: None | !Refusal_T = None
        case c.verb:
            when CREATE:
                refused = self.diagram.add_link(l.out_port, l.in_port)
            when DELETE:
                refused = self.diagram.remove_link(l.out_port, l.in_port)
            when others:
                refused = Refusal_T(message="A connector is made or deleted, not changed.")
        if refused is None:
            self.links_channel.publish(Change(c.verb, link_key(l)))
        return refused

    # The diagram put back as the sample (D): it cannot be refused, and what changed is everything,
    # an UPDATE with no key, for every page to read again.
    def change_diagram(self, c: Command) -> None | !Refusal_T:
        self.diagram = sample()                     # the one change of the diagram: DELETE (command_of)
        self.links_channel.publish(Change(UPDATE, ""))
        self.nodes_channel.publish(Change(UPDATE, ""))
        return None
