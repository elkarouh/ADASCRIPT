#!/usr/bin/env ady2nim
"""node_editor_request -- the fields of a request, read as the events need them.

A request carries its fields in the query and the body ("a=1&b=2"). field_of takes one of them
and number_of reads a number, -1 when there is none; port_of reads a port from four fields.
No HTML, no HTTP, no diagram.
"""
from uri nimport decodeUrl
from backend/node_editor_model import Pin_T, Port_T, Side_T

# The value of KEY in a query or a form body ("a=1&b=2"), or "".
def field_of(text: str, key: str) -> str:
    for pair in text.split("&"):
        let at: int = pair.find("=")
        if at > 0 and pair[:at] == key:
            return decodeUrl(pair[at + 1:])
    return ""

# TEXT as a number: -1 when it is not one.
def number_of(text: str) -> float:
    let n: float | !ParseFailure_T = parse_float(text)
    if n is ParseFailure_T:
        return -1.0
    else:
        return n

# The pin of side SIDE that FIELDS name with PREFIX_node and PREFIX_row ("out_node=0&out_row=2").
def port_of(fields: str, prefix: str, side: Side_T) -> Pin_T:
    Pin_T(int(number_of(field_of(fields, prefix + "_node"))), Port_T(side, int(number_of(field_of(fields, prefix + "_row")))))
