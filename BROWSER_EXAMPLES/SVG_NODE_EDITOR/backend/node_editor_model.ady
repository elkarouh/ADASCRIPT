#!/usr/bin/env ady2nim
"""node_editor_model -- the model: a diagram of nodes and the connectors between their ports, what may
be done to it, and where it is kept.

A node has a title, a place, and three input ports on its left and three output ports on its right. A
connector joins an output port of one node to an input port of another. The diagram is a Diagram, a
class: it is changed only through its methods (create, move, delete), each of which says what was wrong,
or None when it was done. It is kept in a text file, one line a node or a connector (Diagram.text, and
Diagram(text) to read it back; the file itself is read and written by node_editor_events_gui.ady).

    node 0 50 50 Process 1       node ID, its top left corner X Y, and its title (the rest of the line)
    link 0 2 1 0                 from output 2 of node 0 to input 0 of node 1

A node keeps its id for good: deleting another node does not renumber it, so a connector, and the
number a port is labelled with, stay what they were.

Compiled both ways, as DIJKSTRA_HTMX's model is: the server draws the page and keeps the file with
it, and the browser's View is built from the same text with the same Diagram(text), so where a port
is is worked out from the model, never read off the drawing. No HTML, no HTTP. Every length is a Unit_in_pixel_T, a
unit of the drawing (its viewBox).
"""
from drawing import Unit_in_pixel_T, Unit_in_cm_T, Spot_T, Area_T

const NODE_W: Unit_in_cm_T = 5.3975     # 204 pixels
const NODE_H: Unit_in_cm_T = 3.38667    # 128 pixels
const WIDTH: Unit_in_cm_T = 29.10417    # the drawing's size: 1100 pixels
const HEIGHT: Unit_in_cm_T = 13.75833   # 520 pixels
const PORTS: int = 3                    # inputs, and outputs, on each node
const PORT_R: Unit_in_pixel_T = 7.5               # a port's radius
const GRAB: Unit_in_pixel_T = 12.0                # how near a released connector must be to a port to snap to it
const MAX_TITLE: int = 24

# Where a port is, from its node's top left corner (the page draws it there, see node_editor_gui.ady).
const INPUT_DX: Unit_in_pixel_T = 15.0
const OUTPUT_DX: Unit_in_cm_T = 5.00063          # 189 pixels
const FIRST_PORT_DY: Unit_in_cm_T = 1.5875       # 60 pixels
const PORT_PITCH: Unit_in_pixel_T = 25.0

# Why a change to the diagram is refused: the message the page shows the reader.
type Refusal_T is record:
    message: str

type Side_T is enum INPUT, OUTPUT

# A port of a node: which side it is on, and its row from the top.
type Port_T is record:
    side: Side_T
    row:  int

# A node: its id, its title, the place of its top left corner, and its ports.
type Node_T is record:
    id:    int
    title: str
    at:    Spot_T
    ports: []Port_T

# A port told apart from the others in the diagram: the id of its node, and the port.
type Pin_T is record:
    node: int
    port: Port_T

# A connector: the output port it leaves and the input port it arrives at.
type Link_T is record:
    out_port: Pin_T
    in_port:  Pin_T

# The ports a new node has: PORTS inputs and PORTS outputs.
def ports_made() -> []Port_T:
    var ports: []Port_T = []
    for row in range(PORTS):
        ports.append(Port_T(INPUT, row))
        ports.append(Port_T(OUTPUT, row))
    return ports

# The name a port is shown with: Input 1 .. Input 3 on the node with id 0, Input 4 .. 6 on id 1,
# and so on; Output n is numbered the same way.
def label_of(p: Pin_T) -> str:
    let n: int = p.node * PORTS + p.port.row + 1
    return ("Input " if p.port.side == INPUT else "Output ") + str(n)

# Where the middle of port P is, for a node whose top left corner is AT.
def port_spot(at: Spot_T, p: Port_T) -> Spot_T:
    let dx: Unit_in_pixel_T = (INPUT_DX if p.side == INPUT else Unit_in_pixel_T(OUTPUT_DX))
    Spot_T(at.x + dx, at.y + Unit_in_pixel_T(FIRST_PORT_DY) + PORT_PITCH * float(p.row))

# Whether two pins are the same port of the same node.
def same_pin(a: Pin_T, b: Pin_T) -> bool:
    return a.node == b.node and a.port.side == b.port.side and a.port.row == b.port.row

# Whether SPOT is on the port P of a node whose top left corner is AT: close enough to snap to it.
def on_port(at: Spot_T, p: Port_T, spot: Spot_T) -> bool:
    let c: Spot_T = port_spot(at, p)
    let dx: Unit_in_pixel_T = spot.x - c.x
    let dy: Unit_in_pixel_T = spot.y - c.y
    return dx * dx + dy * dy <= GRAB * GRAB

class Diagram:
    var nodes: []Node_T                 # in the order they were made
    var links: []Link_T                 # each connector once

    def __init__(self, nodes: []Node_T, links: []Link_T):
        self.nodes = nodes
        self.links = links

    # The diagram kept in TEXT, as text() writes it: its node and link lines, in order.
    def __init__(self, text: str):
        self.nodes = []
        self.links = []
        for line in text.split("\n"):
            let w: []str = line.split()
            if len(w) == 0:
                continue
            case w[0]:
                when "node":
                    if len(w) >= 5:
                        let id: int | !ParseFailure_T = parse_int(w[1])
                        let x: float | !ParseFailure_T = parse_float(w[2])
                        let y: float | !ParseFailure_T = parse_float(w[3])
                        if id is ParseFailure_T:
                            continue
                        if x is ParseFailure_T:
                            continue
                        if y is ParseFailure_T:
                            continue
                        self.nodes.append(Node_T(id, " ".join(w[4:]), Spot_T(Unit_in_pixel_T(x), Unit_in_pixel_T(y)), ports_made()))
                when "link":
                    if len(w) == 5:
                        let a: int | !ParseFailure_T = parse_int(w[1])
                        let r: int | !ParseFailure_T = parse_int(w[2])
                        let b: int | !ParseFailure_T = parse_int(w[3])
                        let s: int | !ParseFailure_T = parse_int(w[4])
                        if a is ParseFailure_T:
                            continue
                        if r is ParseFailure_T:
                            continue
                        if b is ParseFailure_T:
                            continue
                        if s is ParseFailure_T:
                            continue
                        let joined: None | !Refusal_T = self.add_link(Pin_T(a, Port_T(OUTPUT, r)), Pin_T(b, Port_T(INPUT, s)))

    # The index of the node with id ID, or -1.
    def index_of(self, id: int) -> int:
        for i in range(len(self.nodes)):
            if self.nodes[i].id == id:
                return i
        return -1

    # The id a new node gets: one more than the greatest there is.
    def next_id(self) -> int:
        var top: int = -1
        for n in self.nodes:
            top = max(top, n.id)
        return top + 1

    # The index of the connector from OUT to IN, or -1.
    def link_index(self, out_port: Pin_T, in_port: Pin_T) -> int:
        for i in range(len(self.links)):
            if same_pin(self.links[i].out_port, out_port) and same_pin(self.links[i].in_port, in_port):
                return i
        return -1

    # Where the node ID has its top left corner.
    def corner_of(self, id: int) -> Spot_T:
        return self.nodes[self.index_of(id)].at

    # Where PORT is, with the nodes where they are now.
    def spot_of(self, p: Pin_T) -> Spot_T:
        return port_spot(self.corner_of(p.node), p.port)

    # The port of side SIDE, on a node other than SKIP, that SPOT is on; None when there is none.
    def port_at(self, spot: Spot_T, side: Side_T, skip: int) -> ?Pin_T:
        for n in self.nodes:
            if n.id == skip:
                continue
            for p in n.ports:
                if p.side == side and on_port(n.at, p, spot):
                    return Pin_T(n.id, p)
        return None

    # ---- create, move, delete: each refuses with a Refusal_T, or is done (None) ----

    # A node with TITLE (1 to 24 characters) whose top left corner is AT.
    def add_node(self, title: str, at: Spot_T) -> None | !Refusal_T:
        let t: str = title.strip()
        if len(t) == 0 or len(t) > MAX_TITLE:
            return Refusal_T(message=f"A title is 1 to {MAX_TITLE} characters.")
        self.nodes.append(Node_T(self.next_id(), t, at, ports_made()))

    def move(self, id: int, at: Spot_T) -> None | !Refusal_T:
        let i: int = self.index_of(id)
        if i < 0:
            return Refusal_T(message=f"There is no node {id}.")
        self.nodes[i].at = at

    # The node goes, and every connector at its ports.
    def remove_node(self, id: int) -> None | !Refusal_T:
        if self.index_of(id) < 0:
            return Refusal_T(message=f"There is no node {id}.")
        var left: []Node_T = []
        for n in self.nodes:
            if n.id != id:
                left.append(n)
        self.nodes = left
        var kept: []Link_T = []
        for l in self.links:
            if l.out_port.node != id and l.in_port.node != id:
                kept.append(l)
        self.links = kept

    # A connector from the output port OUT to the input port IN, of two different nodes.
    def add_link(self, out_port: Pin_T, in_port: Pin_T) -> None | !Refusal_T:
        if out_port.port.side != OUTPUT or in_port.port.side != INPUT:
            return Refusal_T(message="A connector goes from an output to an input.")
        if self.index_of(out_port.node) < 0 or self.index_of(in_port.node) < 0:
            return Refusal_T(message="There is no such node.")
        if out_port.port.row < 0 or out_port.port.row >= PORTS or in_port.port.row < 0 or in_port.port.row >= PORTS:
            return Refusal_T(message="There is no such port.")
        if out_port.node == in_port.node:
            return Refusal_T(message="A connector joins two different nodes.")
        if self.link_index(out_port, in_port) >= 0:
            return Refusal_T(message=f"{label_of(out_port)} is joined to {label_of(in_port)} already.")
        self.links.append(Link_T(out_port, in_port))

    def remove_link(self, out_port: Pin_T, in_port: Pin_T) -> None | !Refusal_T:
        let i: int = self.link_index(out_port, in_port)
        if i < 0:
            return Refusal_T(message="There is no such connector.")
        var kept: []Link_T = []
        for k in range(len(self.links)):
            if k != i:
                kept.append(self.links[k])
        self.links = kept

    # ---- kept in a text file ----

    def text(self) -> str:
        var lines: []str = []
        for n in self.nodes:
            lines.append(f"node {n.id} {n.at.x:.0f} {n.at.y:.0f} {n.title}")
        for l in self.links:
            lines.append(f"link {l.out_port.node} {l.out_port.port.row} {l.in_port.node} {l.in_port.port.row}")
        return "\n".join(lines) + "\n"

# What there is to start with, and after Reset: the original's four nodes in a row.
def sample() -> Diagram:
    var d: Diagram = Diagram([], [])
    for i in range(4):
        let added: None | !Refusal_T = d.add_node(f"Process {i + 1}", Spot_T(Unit_in_pixel_T(50.0 + 250.0 * float(i)), Unit_in_pixel_T(50.0)))
    let a: None | !Refusal_T = d.add_link(Pin_T(0, Port_T(OUTPUT, 0)), Pin_T(2, Port_T(INPUT, 1)))
    let b: None | !Refusal_T = d.add_link(Pin_T(0, Port_T(OUTPUT, 2)), Pin_T(3, Port_T(INPUT, 2)))
    return d
