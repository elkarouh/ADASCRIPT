#!/usr/bin/env ady2nim
"""The model, the page and the requests, with no server running: make test (ady2nim c -r tests/test_node_editor.ady)"""
from drawing import Spot_T
from backend/node_editor_model import Diagram, Pin_T, Port_T, Refusal_T, Side_T, label_of, port_spot, sample
from commands import Change
from store import Store
from backend/node_editor_events_gui import Channel_T, Session

# ---- the model ----
var d: Diagram = sample()
assert len(d.nodes) == 4 and len(d.links) == 2
assert label_of(Pin_T(0, Port_T(INPUT, 0))) == "Input 1" and label_of(Pin_T(3, Port_T(OUTPUT, 2))) == "Output 12"
let spot: Spot_T = port_spot(Spot_T(50.0, 50.0), Port_T(OUTPUT, 0))
assert abs(float(spot.x) - 223.976) < 0.001 and abs(float(spot.y) - 106.693) < 0.001

assert d.add_node("Mixer", Spot_T(300.0, 300.0)) is None
assert d.nodes[4].id == 4 and d.nodes[4].title == "Mixer"
assert d.add_node("   ", Spot_T(0.0, 0.0)) is Refusal_T                    # a title is needed
assert d.add_node("x" * 25, Spot_T(0.0, 0.0)) is Refusal_T
assert d.add_link(Pin_T(4, Port_T(OUTPUT, 1)), Pin_T(1, Port_T(INPUT, 0))) is None
assert d.add_link(Pin_T(4, Port_T(OUTPUT, 1)), Pin_T(1, Port_T(INPUT, 0))) is Refusal_T    # once
assert d.add_link(Pin_T(1, Port_T(INPUT, 0)), Pin_T(4, Port_T(OUTPUT, 1))) is Refusal_T    # an output to an input
assert d.add_link(Pin_T(1, Port_T(OUTPUT, 0)), Pin_T(1, Port_T(INPUT, 0))) is Refusal_T    # of two nodes
assert d.add_link(Pin_T(1, Port_T(OUTPUT, 0)), Pin_T(9, Port_T(INPUT, 0))) is Refusal_T    # that are there
assert d.add_link(Pin_T(1, Port_T(OUTPUT, 3)), Pin_T(2, Port_T(INPUT, 0))) is Refusal_T    # with ports that are
assert d.move(4, Spot_T(10.0, 20.0)) is None and d.move(9, Spot_T(0.0, 0.0)) is Refusal_T
assert d.corner_of(4).x == 10.0
assert d.remove_link(Pin_T(4, Port_T(OUTPUT, 1)), Pin_T(1, Port_T(INPUT, 0))) is None
assert d.remove_link(Pin_T(4, Port_T(OUTPUT, 1)), Pin_T(1, Port_T(INPUT, 0))) is Refusal_T
assert d.remove_node(2) is None and len(d.links) == 1                       # its connector went with it
assert d.remove_node(2) is Refusal_T
assert d.add_node("Again", Spot_T(0.0, 0.0)) is None and d.nodes[len(d.nodes) - 1].id == 5   # ids are not reused
assert Diagram(d.text()).text() == d.text()                                 # kept and read back, the same
assert "node 4 10 20 Mixer\n" in d.text() and "link 0 2 3 2\n" in d.text()
let hit: ?Pin_T = d.port_at(Spot_T(224.0 + 3.0, 110.0), OUTPUT, 1)
assert hit is not None and hit.node == 0 and hit.port.row == 0
assert d.port_at(Spot_T(224.0, 110.0), OUTPUT, 0) is None                  # not on the node it leaves
assert d.port_at(Spot_T(224.0, 119.19), OUTPUT, 1) is None                  # nor between ports

# ---- the page, through the requests the server answers (kept nowhere) ----
var session: Session = Session(Store(""))
let page: str = session.answer("GET", "/all", "")
assert page.count("class=\"node\"") == 4 and "Process 4" in page and "Output 12" in page
assert "<pre id=\"diagram\">node 0 50 50 Process 1\n" in page
assert "<svg id=\"editor\"" in page and "id=\"connections-layer\"" in page
assert "<p id=\"problem\" class=\"problem\"></p>" in page               # nothing wrong yet
assert session.answer("GET", "/nowhere", "") == ""
assert session.answer("PATCH", "/nodes", "") == ""

# A change answers only the paragraph #problem: empty when it went through.
const DONE: str = "<p id=\"problem\" class=\"problem\"></p>"
def diagram_now() -> str:
    return session.answer("GET", "/all", "")

# What the session published, as the server's subscribers hear it.
var heard: []str = []
def note(channel: Channel_T, change: Change):
    heard.append(f"{channel} {change.kind} {change.key}")
session.nodes_channel.subscribe(note)
session.links_channel.subscribe(note)

assert session.answer("POST", "/nodes", "title=Mixer&x=300&y=300") == DONE and "node 4 300 300 Mixer" in diagram_now()
assert "A title is 1 to 24 characters." in session.answer("POST", "/nodes", "title=&x=1&y=1")
assert "There is no place." in session.answer("POST", "/nodes", "title=Lost")
assert session.answer("PUT", "/nodes", "id=4&x=120&y=80") == DONE and "node 4 120 80 Mixer" in diagram_now()
assert "There is no node 9." in session.answer("PUT", "/nodes", "id=9&x=1&y=1")
assert session.answer("POST", "/links", "out_node=4&out_row=1&in_node=1&in_row=0") == DONE and "link 4 1 1 0" in diagram_now()
assert "is joined to" in session.answer("POST", "/links", "out_node=4&out_row=1&in_node=1&in_row=0")
assert "not changed" in session.answer("PUT", "/links", "out_node=4&out_row=1&in_node=1&in_row=0")
assert session.answer("DELETE", "/links", "out_node=4&out_row=1&in_node=1&in_row=0") == DONE and "link 4 1 1 0" not in diagram_now()
session.answer("POST", "/links", "out_node=4&out_row=2&in_node=0&in_row=0")
assert session.answer("DELETE", "/nodes", "id=4") == DONE
assert "node 4" not in diagram_now() and "link 4 2 0 0" not in diagram_now()     # its connector went with it
assert heard == ["NODES_CHAN CREATE 4", "NODES_CHAN UPDATE 4", "LINKS_CHAN CREATE 4 1 1 0", "LINKS_CHAN DELETE 4 1 1 0", "LINKS_CHAN CREATE 4 2 0 0", "LINKS_CHAN DELETE 4 2 0 0", "NODES_CHAN DELETE 4"]
assert session.answer("DELETE", "/all", "") == DONE and "node 0 50 50 Process 1" in diagram_now()
assert heard[len(heard) - 2:] == ["LINKS_CHAN UPDATE ", "NODES_CHAN UPDATE "]
session.answer("POST", "/nodes", "title=%3Cb%3E&x=1&y=1")
assert "&lt;b&gt;" in diagram_now()                                         # what the reader typed is escaped
session.answer("DELETE", "/all", "")

# ---- kept in its store, and read back by a Session of its own ----
var kept: Session = Session(Store(""))
def keep(channel: Channel_T, change: Change):           # as the server subscribes it
    kept.keep()
kept.nodes_channel.subscribe(keep)
kept.links_channel.subscribe(keep)
kept.answer("DELETE", "/all", "")
kept.answer("POST", "/nodes", "title=Kept one&x=7&y=9")
kept.answer("POST", "/links", "out_node=1&out_row=0&in_node=4&in_row=2")
let again: Session = Session(kept.store)
assert again.diagram.text() == kept.diagram.text()
assert "node 4 7 9 Kept one" in again.diagram.text() and "link 1 0 4 2" in again.diagram.text()
print "node_editor: all checks passed"
