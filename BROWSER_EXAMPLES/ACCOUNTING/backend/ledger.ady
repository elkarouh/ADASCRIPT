#!/usr/bin/env ady2nim
"""ledger -- the command line that keeps the books of accounting_model.ady, scenario by
scenario (bookkeeping.ady's Ledger and Scenarios), and reads them in from other programs.

    ledger [--config FILE] list                    the scenarios, with their titles
    ledger [--config FILE] new NAME                a new scenario: the config's chart, no transaction
    ledger [--config FILE] delete-scenario NAME       a scenario's .books and .kept files gone
    ledger [--config FILE] import-gnucash NAME FILE   a new scenario NAME, read from a GnuCash sqlite3 file
    ledger [--config FILE] import-beancount NAME FILE  the same, from a Beancount file
    ledger [--config FILE] import-journal NAME FILE    the same, from a Ledger or hledger journal
    ledger [--config FILE] import-erp NAME JOURNAL.csv [CHART.json]  the same, from an ERP's journal lines
    ledger [--config FILE] SCENARIO COMMAND ...

    show                          the accounts and their balances, and the statements
    journal                       every transaction, numbered, with what it did to each account
    account NUMBER KIND NAME...   open an account: KIND is asset, liability, equity,
                                  revenue or expense
    add DATE WHAT ACCOUNT=AMOUNT...
                                  record a transaction: each ACCOUNT (a number or a name)
                                  gets AMOUNT, negative to take it out; they add up to zero
    delete NUMBER                 delete transaction NUMBER, as journal numbers it
    delete-account ACCOUNT        delete an account no transaction touches
    start-over                    the scenario back as its .books file has it
    save-as NAME                  the books, saved as a new scenario NAME
    export                        the books as text, as a .books file holds them

A scenario is scenarios/NAME.books, beside the config file (accounting.conf
in the current directory, or --config), and NAME.kept there, the books as
they were changed, made from it the first time NAME is used: the same books
the page shows (server.ady).
A transaction or an account that does not fit the books is refused, and
nothing is written.

    ledger list
    ledger 2_vat show
    ledger 2_vat add 2011-05-02 "Printer paper" "Bank=-12.10" "Furniture and equipment=10.00" "VAT receivable=2.10"
    ledger 2_vat start-over
"""
from math nimport round
from store import Store
from backend/accounting_model import BookFailure_T, Cents_T, Entry, Graph, Kind_T, Posting, colour_of, example_entries, money_text
from importers/gnucash import books_of_gnucash
from importers/beancount import books_of_beancount
from importers/journal import books_of_journal
from importers/erp_csv import books_of_erp
from backend/books_text import AccountRow, Books, bad, graph_of, kind_named, kind_text, parse_books, text_of_books
from backend/bookkeeping import Config, Ledger, Scenarios, config_of, open_chart

# The settings and accounts of the config file at PATH.
def read_config(path: Path) -> Config | !BookFailure_T:
    let text: str | !PathFailure_T = path.read_text()
    if text is PathFailure_T:
        return bad(f"{text.op} {text.path}: {text.reason}")
    else:
        return config_of(text, str(path))

# The example company's year, recorded in an empty ledger.
def record_example(ledger: Ledger) -> None | !BookFailure_T:
    if ledger.transaction_count() > 0:
        return bad("the ledger has transactions already; the example goes in an empty one")
    for e in example_entries():
        do:
            ledger.record(e)

# ---------------------------------------------------------------------
# The command line
# ---------------------------------------------------------------------

const USAGE: str = """usage: ledger [--config FILE] list
       ledger [--config FILE] new NAME
       ledger [--config FILE] delete-scenario NAME
       ledger [--config FILE] import-gnucash NAME FILE
       ledger [--config FILE] import-beancount NAME FILE
       ledger [--config FILE] import-journal NAME FILE
       ledger [--config FILE] import-erp NAME JOURNAL.csv [CHART.json]
       ledger [--config FILE] SCENARIO COMMAND ...

    show                          the accounts and their balances, and the statements
    journal                       every transaction, numbered, with what it did to each account
    account NUMBER KIND NAME...   open an account: KIND is asset, liability, equity,
                                  revenue or expense
    add DATE WHAT ACCOUNT=AMOUNT...
                                  record a transaction: each ACCOUNT (a number or a name)
                                  gets AMOUNT, negative to take it out; they add up to zero
    delete NUMBER                 delete transaction NUMBER, as journal numbers it
    delete-account ACCOUNT        delete an account no transaction touches
    start-over                    the scenario back as its .books file has it
    save-as NAME                  the books, saved as a new scenario NAME
    export                        the books as text, as a .books file holds them"""

# 12.10 or -605 as cents.
def cents_of(word: str) -> Cents_T | !BookFailure_T:
    let f: float | !ParseFailure_T = parse_float(word.replace(",", ""))
    if f is ParseFailure_T:
        return bad(f"{word} is not an amount")
    else:
        return Cents_T(int(round(f * 100.0)))

# ACCOUNT=AMOUNT as a posting; the account a number or a name.
def posting_of(ledger: Ledger, word: str) -> Posting | !BookFailure_T:
    let at: int = word.rfind("=")
    if at <= 0:
        return bad(f"{word}: a posting is ACCOUNT=AMOUNT")
    let name: str = ledger.name_of(word[:at])
    if name == "":
        return bad(f"there is no account {word[:at]}")
    do:
        amount <- cents_of(word[at + 1:])
    return Posting(name, amount)

def signed_text(c: Cents_T) -> str:
    return ("+" if c > 0 else "") + money_text(c)

def show(ledger: Ledger, config: Config):
    let g: Graph = ledger.graph()
    print f"Accounts, in {config.currency}"
    for row in ledger.kinds():
        print f"  {row[0]}  {row[1]:<18} {row[2]:<10} {money_text(g.balance(row[1])):>12}"
    print ""
    print "Profit and loss"
    for l in g.profit_and_loss():
        print f"  {l.label:<36} {money_text(l.amount):>12}"
    print f"  {'Profit':<36} {money_text(g.profit()):>12}"
    print ""
    print "Balance sheet"
    for l in g.assets_and_liabilities():
        print f"  {l.label:<36} {money_text(l.amount):>12}"
    print f"  {'Assets less liabilities':<36} {money_text(g.net_assets()):>12}"
    for l in g.equity_lines():
        print f"  {l.label:<36} {money_text(l.amount):>12}"
    print f"  {'Equity':<36} {money_text(g.equity()):>12}"
    print ""
    print ("The books balance." if g.total() == 0 and g.net_assets() == g.equity() else "THE BOOKS DO NOT BALANCE.")

def journal(ledger: Ledger):
    let (entries, ids) = ledger.numbered_entries()
    for i in range(len(entries)):
        let e: Entry = entries[i]
        print f"{ids[i]:>4}  {e.date}  {e.what}"
        for p in e.postings:
            print f"    {p.account:<20} {signed_text(p.amount):>12}"

# COMMAND (WORDS[0]) on the books of scenario NAME.
def run_command(scenarios: Scenarios, config: Config, name: str, words: []str):
    let command: str = words[0]
    let opened: Ledger | !BookFailure_T = scenarios.open(name, command == "start-over")
    if opened is BookFailure_T:
        die(opened.detail)
    else:
        var ledger: Ledger = opened
        var done: None | !BookFailure_T = None
        case command:
            when "show":
                show(ledger, config)
            when "journal":
                journal(ledger)
            when "start-over":
                print f"{name}: {ledger.transaction_count()} transactions, as {name}.books has them"
            when "export":
                stdout.write(text_of_books(ledger.books(config.currency)))
            when "save-as":
                if len(words) != 2:
                    die("save-as NAME")
                done = scenarios.save_as(ledger, name, words[1], config.currency)
                if done is None:
                    print f"saved as scenario {words[1]}"
            when "account":
                if len(words) < 4:
                    die("account NUMBER KIND NAME")
                let kind: Kind_T | !BookFailure_T = kind_named(words[2])
                if kind is BookFailure_T:
                    done = kind
                else:
                    done = ledger.open_account(words[1], kind, " ".join(words[3:]))
                    if done is None:
                        print f"account {words[1]} opened"
            when "add":
                if len(words) < 5:
                    die("add DATE WHAT ACCOUNT=AMOUNT ACCOUNT=AMOUNT...")
                var postings: []Posting = []
                for w in words[3:]:
                    let p: Posting | !BookFailure_T = posting_of(ledger, w)
                    if p is BookFailure_T:
                        die(p.detail)
                    else:
                        postings.append(p)
                done = ledger.record(Entry(words[1], words[2], postings))
                if done is None:
                    print "recorded"
            when "delete":
                if len(words) != 2:
                    die("delete NUMBER   (the transaction's number, as journal shows it)")
                let id: int | !ParseFailure_T = parse_int(words[1])
                if id is ParseFailure_T:
                    die(f"{words[1]} is not a transaction's number")
                else:
                    done = ledger.delete_entry(id)
                    if done is None:
                        print f"transaction {id} deleted"
            when "delete-account":
                if len(words) < 2:
                    die("delete-account ACCOUNT")
                done = ledger.delete_account(" ".join(words[1:]))
                if done is None:
                    print "account deleted"
            when others:
                die(f"no command {command}, see -h")
        if done is BookFailure_T:
            die(done.detail)

def main():
    var conf_path: Path = Path("accounting.conf")
    var words: []str = []
    var i: int = 0
    let args: []str = $@
    while i < len(args):
        if args[i] == "--config" and i + 1 < len(args):
            conf_path = Path(args[i + 1])
            i += 2
        elif args[i] == "-h" or args[i] == "--help":
            print USAGE
            quit(0)
        else:
            words.append(args[i])
            i += 1
    die("no command, see -h") if len(words) == 0

    let read: Config | !BookFailure_T = read_config(conf_path)
    if read is BookFailure_T:
        die(read.detail)
    else:
        let config: Config = read
        var scenarios: Scenarios = Scenarios(Store(str(conf_path.parent / "scenarios")))
        if words[0] == "list":
            for name in scenarios.names():
                print f"{name:<24} {scenarios.title_of(name)}"
        elif words[0] == "new":
            die("new NAME") if len(words) != 2
            var b: Books = Books(config.currency, config.accounts, [], [], words[1], "")
            let made: None | !BookFailure_T = scenarios.write_books(words[1], b, f"scenarios/{words[1]}.books: the chart of {conf_path.name}, no transaction yet.")
            if made is BookFailure_T:
                die(made.detail)
            print f"scenario {words[1]}: {len(config.accounts)} accounts, no transaction"
        elif words[0] == "delete-scenario":
            die("delete-scenario NAME") if len(words) != 2
            let gone: None | !BookFailure_T = scenarios.delete(words[1])
            if gone is BookFailure_T:
                die(gone.detail)
            print f"scenario {words[1]} deleted"
        elif words[0] == "import-gnucash":
            die("import-gnucash NAME FILE") if len(words) != 3
            let read_books: Books | !BookFailure_T = books_of_gnucash(words[2])
            if read_books is BookFailure_T:
                die(read_books.detail)
            else:
                let made: None | !BookFailure_T = scenarios.write_books(words[1], read_books, f"scenarios/{words[1]}.books, read from {words[2]}.")
                if made is BookFailure_T:
                    die(made.detail)
                print f"scenario {words[1]}: {len(read_books.accounts)} accounts, {len(read_books.entries)} transactions"
        elif words[0] == "import-beancount":
            die("import-beancount NAME FILE") if len(words) != 3
            let bean_books: Books | !BookFailure_T = books_of_beancount(words[2])
            if bean_books is BookFailure_T:
                die(bean_books.detail)
            else:
                let made: None | !BookFailure_T = scenarios.write_books(words[1], bean_books, f"scenarios/{words[1]}.books, read from {words[2]}.")
                if made is BookFailure_T:
                    die(made.detail)
                print f"scenario {words[1]}: {len(bean_books.accounts)} accounts, {len(bean_books.entries)} transactions"
        elif words[0] == "import-journal":
            die("import-journal NAME FILE") if len(words) != 3
            let journal_books: Books | !BookFailure_T = books_of_journal(words[2])
            if journal_books is BookFailure_T:
                die(journal_books.detail)
            else:
                let made: None | !BookFailure_T = scenarios.write_books(words[1], journal_books, f"scenarios/{words[1]}.books, read from {words[2]}.")
                if made is BookFailure_T:
                    die(made.detail)
                print f"scenario {words[1]}: {len(journal_books.accounts)} accounts, {len(journal_books.entries)} transactions"
        elif words[0] == "import-erp":
            die("import-erp NAME JOURNAL.csv [CHART.json]") if len(words) != 3 and len(words) != 4
            die(f"{words[2]} is a chart of accounts: the journal's CSV file comes first, then the chart: import-erp NAME JOURNAL.csv CHART.json") if words[2].endswith(".json")
            let erp_books: Books | !BookFailure_T = books_of_erp(words[2], (words[3] if len(words) == 4 else ""))
            if erp_books is BookFailure_T:
                die(erp_books.detail)
            else:
                let made: None | !BookFailure_T = scenarios.write_books(words[1], erp_books, f"scenarios/{words[1]}.books, read from {words[2]}.")
                if made is BookFailure_T:
                    die(made.detail)
                print f"scenario {words[1]}: {len(erp_books.accounts)} accounts, {len(erp_books.entries)} transactions"
        elif len(words) < 2:
            die(f"{words[0]}: a scenario, then a command (see -h); `ledger list` lists the scenarios")
        else:
            run_command(scenarios, config, words[0], words[1:])

if __name__ == "__main__":
    main()
