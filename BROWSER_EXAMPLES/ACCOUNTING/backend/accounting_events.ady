#!/usr/bin/env ady2nim
"""accounting_events -- what each event the page sends does to the books; no HTTP.

server.ady hands each request to its Session, as a method, a path and its fields, and sends back
what comes out. The Session keeps the books shown and the scenarios.

Commands in, events out, as in DIJKSTRA_HTMX. Every request is read back into a Command, the page's
own vocabulary (accounting_commands.ady): Create, Read, Update or Delete, of a transaction, an
account or a scenario. A read answers the whole page. A change answers only the paragraph #told:
what was done, or why not. When it went through, what it changed is published with the same verbs,
one channel per thing, named by Channel_T: ENTRIES_CHAN, ACCOUNTS_CHAN and SCENARIOS_CHAN carry a
Change. Whoever must hear of it subscribes -- the server, which tells every open page, which then
reads itself again -- and the Session knows none of them:

    def heard(channel: Channel_T, change: Change):
        print channel, change.kind, change.key          # "ENTRIES_CHAN CREATE a chair for the office"
    session.entries_channel.subscribe(heard)

Nothing has to be kept on a change: the ledger writes each one to the scenario's database as it is made.
"""
from blackboard import PublishChannel
from backend/accounting_model import BookFailure_T, Entry, EQUITY, Kind_T
from backend/books_text import Books, Year_End, kind_named, text_of_books
from backend/accounting_page_state import Settings, Popup
from backend/accounting_page_gui import all_text, told_text
from page_server import Page_Request
from commands import Verb_T, CREATE, READ, UPDATE, DELETE, Change
from backend/accounting_commands import Command, A_TRANSACTION, AN_ACCOUNT, A_SCENARIO, THE_BOOKS, command_of
from backend/ledger import Config, Ledger, Scenarios, read_config

# The channels of the server's blackboard: one per thing that changes.
type Channel_T is enum ENTRIES_CHAN, ACCOUNTS_CHAN, SCENARIOS_CHAN

# A channel of the session's: one of Channel_T, carrying a Change.
type Change_Channel_T is PublishChannel[Channel_T, Change]

# The books shown, the scenario they are, and the others there are; the config they are kept by.
# The server makes one, and starts it on its config file; each request is one of its methods.
class Session:
    var config: Config
    var books: Ledger                   # the books shown: the scenario's database
    var scenarios: Scenarios            # beside the config file
    var current: str                    # the scenario shown
    var entries_channel: Change_Channel_T = Change_Channel_T(ENTRIES_CHAN)        # what happened to a transaction
    var accounts_channel: Change_Channel_T = Change_Channel_T(ACCOUNTS_CHAN)      # to an account
    var scenarios_channel: Change_Channel_T = Change_Channel_T(SCENARIOS_CHAN)    # to the scenario shown

    def __init__(self):
        self.config = Config("USD", [])
        self.books = Ledger(":memory:")
        self.scenarios = Scenarios(Path("scenarios"))
        self.current = ""

    # The config at CONF_PATH read, and scenario FIRST shown (the first there is, when ""):
    # what was wrong, or "".
    def start(self, conf_path: Path, first: str) -> str:
        let read: Config | !BookFailure_T = read_config(conf_path)
        if read is BookFailure_T:
            return read.detail
        else:
            self.config = read
        self.scenarios = Scenarios(conf_path.parent / "scenarios")
        let names: []str = self.scenarios.names()
        if len(names) == 0:
            return f"no scenario in {self.scenarios.dir}: no *.books file"
        let shown: None | !BookFailure_T = self.show_scenario((first if first != "" else names[0]), False)
        if shown is BookFailure_T:
            return shown.detail
        return ""

    def books_text(self) -> str:
        return text_of_books(self.books.books(self.config.currency))

    # ---- Scenarios (ledger.ady's Scenarios): the one shown, and the others ----

    def scenarios_text(self) -> str:
        var text: str = f"current\t{self.current}\n"
        for name in self.scenarios.names():
            text += f"scenario\t{name}\t{self.scenarios.title_of(name)}\n"
        return text

    # Scenario NAME shown, its database made from its .books file first if it
    # has none, or if FRESH (Start over).
    def show_scenario(self, name: str, fresh: bool) -> None | !BookFailure_T:
        if not self.scenarios.exists(name):
            return BookFailure_T(f"there is no scenario {name}")
        if self.current != "":
            self.books.close()
        let opened: Ledger | !BookFailure_T = self.scenarios.open(name, fresh)
        if opened is BookFailure_T:
            if self.current != "":
                self.books = Ledger(str(self.scenarios.db_file(self.current)))
            return opened
        else:
            self.books = opened
        self.current = name
        return None

    # The books shown, saved as scenario NAME, and shown.
    def save_as(self, name: str) -> None | !BookFailure_T:
        do:
            self.scenarios.save_as(self.books, self.current, name, self.config.currency)
        return self.show_scenario(name, True)

    # The scenario shown deleted, and the first one left shown; refused when it is the only one.
    def delete_scenario(self) -> None | !BookFailure_T:
        if len(self.scenarios.names()) < 2:
            return BookFailure_T("this is the only scenario; make another first")
        let gone: str = self.current
        self.books.close()
        self.current = ""
        let done: None | !BookFailure_T = self.scenarios.delete(gone)
        if done is BookFailure_T:
            return done
        for name in self.scenarios.names():
            return self.show_scenario(name, False)
        return None

    # The htmx page for the settings S.
    def page_text(self, s: Settings) -> str:
        let b: Books = self.books.books(self.config.currency)
        let names: []str = self.scenarios.names()
        var titles: []str = []
        for n in names:
            titles.append(self.scenarios.title_of(n))
        return all_text(b, names, titles, self.current, s)

    # The year closed: the costs and the revenue moved into retained earnings.
    def close_year(self, year: Year_End) -> None | !BookFailure_T:
        if year.date == "":
            return BookFailure_T("There is nothing to close.")
        if len(year.entries) == 0:
            return BookFailure_T("Nothing to close: every cost and revenue account is already at zero.")
        if year.opened:
            do:
                self.books.open_account("140000", EQUITY, year.retained)
        for e in year.entries:
            do:
                self.books.record(e)
        return None

    # The routes the page sends, all answered by answer below, each a Command
    # (accounting_commands.ady: on the wire, the verb is the method and the thing the URL). The read
    # answers the whole page for htmx to swap in; the others the paragraph #told: what was done, or
    # why not.
    #
    #     GET    /h/all          R the page, from the settings in the query (the form #state)
    #     PUT    /h/all          U the year closed: the costs and the revenue moved into retained earnings
    #     POST   /h/entries      C a transaction: the arrow drawn and the popup (source, target, date, what, amount, vat)
    #     DELETE /h/entries      D a transaction                       (id)
    #     POST   /h/accounts     C an account                          (number, acctname, akind)
    #     DELETE /h/accounts     D an account no transaction touches   (name)
    #     POST   /h/scenarios    C the books shown, saved as a scenario (newname), and shown
    #     PUT    /h/scenarios    U the scenario shown, started over
    #     DELETE /h/scenarios    D the scenario shown; the first one left is shown
    #
    # A change that went through is published on the channel of what it changed (a Change), and
    # the server tells every open page, which reads itself again.

    # What METHOD on PATH does, with FIELDS (the query and the body, "a=1&b=2"): what to send back,
    # or "" when there is no such thing.
    def answer(self, method: str, path: str, fields: str) -> str:
        let c: ?Command = command_of(method, path, Page_Request(method, path, fields).fields)
        if c is None:
            return ""
        if c.verb == READ:
            return self.page_all(fields)
        var done: str | !BookFailure_T = ""
        try:
            case c.thing:
                when A_TRANSACTION:
                    done = self.change_transaction(c)
                when AN_ACCOUNT:
                    done = self.change_account(c)
                when A_SCENARIO:
                    done = self.change_scenario(c)
                when THE_BOOKS:
                    done = self.change_books()
        except:                             # the database, not the books: say so, and keep serving
            done = BookFailure_T("the database failed: " + getCurrentExceptionMsg())
        return told_text(done)

    # The transaction C names recorded (the arrow and the popup: source, target, date, what, amount,
    # vat) or deleted (id): what to tell, or why not. When it went through, it is published.
    def change_transaction(self, c: Command) -> str | !BookFailure_T:
        let b: Books = self.books.books(self.config.currency)
        if c.verb == CREATE:
            let popup: Popup = Popup(c.value("source"), c.value("target"), c.value("date"), c.value("what"), c.value("amount"), c.value("vat"))
            let made: Entry | !BookFailure_T = popup.entry_in(b)
            if made is BookFailure_T:
                return made
            do:
                self.books.record(made)
            self.entries_channel.publish(Change(CREATE, made.what))
            return f"Recorded: {made.what}"
        let id: int = c.number_value("id")            # DELETE, the other (command_of)
        var what: str = ""
        for i in range(len(b.ids)):
            if b.ids[i] == id:
                what = b.entries[i].what
        do:
            self.books.delete_entry(id)
        self.entries_channel.publish(Change(DELETE, str(id)))
        return f"Deleted: {what}"

    # The account C names opened (number, acctname, akind) or deleted (name): what to tell, or why
    # not. When it went through, it is published.
    def change_account(self, c: Command) -> str | !BookFailure_T:
        if c.verb == CREATE:
            let number: str = c.value("number").strip()
            let name: str = c.value("acctname").strip()
            if number == "" or name == "":
                return BookFailure_T("An account needs a number and a name.")
            let kind: Kind_T | !BookFailure_T = kind_named(c.value("akind"))
            if kind is BookFailure_T:
                return kind
            do:
                self.books.open_account(number, kind, name)
            self.accounts_channel.publish(Change(CREATE, name))
            return f"Opened: {number} {name}"
        let name: str = c.value("name")               # DELETE, the other (command_of)
        do:
            self.books.delete_account(name)
        self.accounts_channel.publish(Change(DELETE, name))
        return f"Deleted the account {name}."

    # The books shown saved as a new scenario (newname), the scenario shown started over, or
    # deleted: what to tell, or why not. When it went through, it is published.
    def change_scenario(self, c: Command) -> str | !BookFailure_T:
        case c.verb:
            when CREATE:
                let name: str = c.value("newname").strip()
                if name == "":
                    return BookFailure_T("Name the new scenario.")
                do:
                    self.save_as(name)
                self.scenarios_channel.publish(Change(CREATE, name))
                return f"Saved as {name}."
            when UPDATE:
                do:
                    self.show_scenario(self.current, True)
                self.scenarios_channel.publish(Change(UPDATE, self.current))
                return "Started over."
            when others:
                let gone: str = self.current          # DELETE (a scenario is not read: command_of)
                do:
                    self.delete_scenario()
                self.scenarios_channel.publish(Change(DELETE, gone))
                return "Scenario deleted."

    # The year closed (the one change of the books: command_of): what to tell, or why not. When it
    # went through, the transactions are published, every one: an UPDATE with no key.
    def change_books(self) -> str | !BookFailure_T:
        let year: Year_End = Year_End(self.books.books(self.config.currency))
        let closed: None | !BookFailure_T = self.close_year(year)
        if closed is BookFailure_T:
            return closed
        self.entries_channel.publish(Change(UPDATE, ""))
        return f"Closed the year on {year.date}: the profit is in {year.retained}."

    # GET /h/all: the page again, from the settings in QUERY.
    def page_all(self, query: str) -> str:
        var s: Settings = Settings(query)
        if s.scenario != "" and s.scenario != self.current:   # "": the one shown, as a page reading itself again asks
            let shown: None | !BookFailure_T = self.show_scenario(s.scenario, False)
            if shown is None:
                self.scenarios_channel.publish(Change(UPDATE, self.current))     # every page shows it
            s = s.fresh()                     # another scenario: its own grouping
        return self.page_text(s)
