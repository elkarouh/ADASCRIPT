#!/usr/bin/env ady2nim
"""accounting_events -- what each event the page sends does to the books; no HTTP.

server.ady hands each request to its Session and sends back what comes out: the page again
(page_all, page_record, page_do) for htmx, or text (post_text) for the plain POST routes. The
Session keeps the books shown and the scenarios.
"""
from backend/accounting_model import BookFailure_T, Entry, EQUITY, Kind_T
from backend/books_text import AccountRow, Books, closing_entries, kind_named, parse_books, text_of_books
from backend/accounting_page_gui import Params, account_numbered, all_text, entry_of, fresh_params, int_of, params_of, year_end, retained_account
from backend/ledger import Config, Ledger, Scenarios, read_config

# The books shown, the scenario they are, and the others there are; the config they are kept by.
# The server makes one, and starts it on its config file; each request is one of its methods.
class Session:
    var config: Config
    var books: Ledger                   # the books shown: the scenario's database
    var scenarios: Scenarios            # beside the config file
    var current: str                    # the scenario shown

    def __init__(self):
        self.config = Config("USD", [])
        self.books = Ledger(":memory:")
        self.scenarios = Scenarios(Path("scenarios"))
        self.current = ""

    # The config at CONF_PATH read, and scenario FIRST shown (the first there is, when ""):
    # what was wrong, or "".
    def start(self, conf_path: Path, first: str) -> str:
        let read: Config | !BookFailure_T = read_config(conf_path)
        if read is BookFailure_T:
            return read.detail
        else:
            self.config = read
        self.scenarios = Scenarios(conf_path.parent / "scenarios")
        let names: []str = self.scenarios.names()
        if len(names) == 0:
            return f"no scenario in {self.scenarios.dir}: no *.books file"
        let shown: None | !BookFailure_T = self.show_scenario((first if first != "" else names[0]), False)
        if shown is BookFailure_T:
            return shown.detail
        return ""

    def books_text(self) -> str:
        return text_of_books(self.books.books(self.config.currency))

    def answer(self, r: None | !BookFailure_T) -> str:
        if r is BookFailure_T:
            return "error\t" + r.detail
        return "ok"

    # ---- Scenarios (ledger.ady's Scenarios): the one shown, and the others ----

    def scenarios_text(self) -> str:
        var text: str = f"current\t{self.current}\n"
        for name in self.scenarios.names():
            text += f"scenario\t{name}\t{self.scenarios.title_of(name)}\n"
        return text

    # Scenario NAME shown, its database made from its .books file first if it
    # has none, or if FRESH (Start over).
    def show_scenario(self, name: str, fresh: bool) -> None | !BookFailure_T:
        if not self.scenarios.exists(name):
            return BookFailure_T(f"there is no scenario {name}")
        if self.current != "":
            self.books.close()
        let opened: Ledger | !BookFailure_T = self.scenarios.open(name, fresh)
        if opened is BookFailure_T:
            if self.current != "":
                self.books = Ledger(str(self.scenarios.db_file(self.current)))
            return opened
        else:
            self.books = opened
        self.current = name
        return None

    # The books shown, saved as scenario NAME, and shown.
    def save_as(self, name: str) -> None | !BookFailure_T:
        do:
            self.scenarios.save_as(self.books, self.current, name, self.config.currency)
        return self.show_scenario(name, True)

    # The scenario shown deleted, and the first one left shown; refused when it is the only one.
    def delete_scenario(self) -> None | !BookFailure_T:
        if len(self.scenarios.names()) < 2:
            return BookFailure_T("this is the only scenario; make another first")
        let gone: str = self.current
        self.books.close()
        self.current = ""
        let done: None | !BookFailure_T = self.scenarios.delete(gone)
        if done is BookFailure_T:
            return done
        for name in self.scenarios.names():
            return self.show_scenario(name, False)
        return None

    # The htmx page for the settings P.
    def page_text(self, p: Params) -> str:
        let b: Books = self.books.books(self.config.currency)
        let names: []str = self.scenarios.names()
        var titles: []str = []
        for n in names:
            titles.append(self.scenarios.title_of(n))
        return all_text(b, names, titles, self.current, p)

    # The year closed: the costs and the revenue moved into retained earnings.
    def close_year(self, b: Books) -> None | !BookFailure_T:
        if len(b.entries) == 0:
            return BookFailure_T("There is nothing to close.")
        let date: str = year_end(b)
        let name: str = retained_account(b)
        let made: []Entry = closing_entries(b, date, name)
        if len(made) == 0:
            return BookFailure_T("Nothing to close: every cost and revenue account is already at zero.")
        if account_numbered(b, "14") == "":
            do:
                self.books.open_account("140000", EQUITY, name)
        for e in made:
            do:
                self.books.record(e)
        return None

    # What the htmx page asked P.op of the books B, done: what to tell, or why not.
    def do_op(self, p: Params, b: Books) -> str | !BookFailure_T:
        if p.op == "startover":
            do:
                self.show_scenario(self.current, True)
            return "Started over."
        if p.op == "saveas":
            let name: str = p.newname.strip()
            if name == "":
                return BookFailure_T("Name the new scenario.")
            do:
                self.save_as(name)
            return f"Saved as {name}."
        if p.op == "delete":
            do:
                self.delete_scenario()
            return "Scenario deleted."
        if p.op == "delentry":
            let id: int = int_of(p.arg, 0)
            var what: str = ""
            for i in range(len(b.ids)):
                if b.ids[i] == id:
                    what = b.entries[i].what
            do:
                self.books.delete_entry(id)
            return f"Deleted: {what}"
        if p.op == "delaccount":
            do:
                self.books.delete_account(p.arg)
            return f"Deleted the account {p.arg}."
        if p.op == "openaccount":
            let kind: Kind_T | !BookFailure_T = kind_named(p.akind)
            if kind is BookFailure_T:
                return kind
            if p.number.strip() == "" or p.acctname.strip() == "":
                return BookFailure_T("An account needs a number and a name.")
            do:
                self.books.open_account(p.number.strip(), kind, p.acctname.strip())
            return f"Opened: {p.number.strip()} {p.acctname.strip()}"
        if p.op == "closeyear":
            do:
                self.close_year(b)
            return f"Closed the year on {year_end(b)}: the profit is in {retained_account(b)}"
        return BookFailure_T("The page asked for what the ledger does not do.")

    # What the page posts to PATH, done; the answer to send back.
    def post_text(self, path: str, body: str) -> str:
        if path == "/scenario":
            return self.answer(self.show_scenario(body.strip(), False))
        if path == "/start-over":
            return self.answer(self.show_scenario(self.current, True))
        if path == "/delete-scenario":
            return self.answer(self.delete_scenario())
        if path == "/save-as":
            return self.answer(self.save_as(body.strip()))
        if path == "/delete-entry":
            let id: int | !ParseFailure_T = parse_int(body.strip())
            if id is ParseFailure_T:
                return "error\t" + body + " is not a transaction's number"
            else:
                return self.answer(self.books.delete_entry(id))
        if path == "/delete-account":
            return self.answer(self.books.delete_account(body.strip()))
        let read: Books | !BookFailure_T = parse_books(body)
        if read is BookFailure_T:
            return "error\t" + read.detail
        else:
            let b: Books = read
            if path == "/account" and len(b.accounts) == 1 and len(b.entries) == 0:
                let a: AccountRow = b.accounts[0]
                return self.answer(self.books.open_account(a.number, a.kind, a.name))
            elif path == "/entry" and len(b.entries) == 1 and len(b.accounts) == 0:
                return self.answer(self.books.record(b.entries[0]))
            return "error\tthe page sent what " + path + " does not take"

    # GET /h/all: the page again, from the settings in QUERY.
    def page_all(self, query: str) -> str:
        var p: Params = params_of(query)
        if p.scenario != "" and p.scenario != self.current:
            let shown: None | !BookFailure_T = self.show_scenario(p.scenario, False)
            p = fresh_params(p.tab)           # another scenario: its own grouping
        return self.page_text(p)

    # POST /h/record: an arrow drawn on the page, recorded as a transaction.
    def page_record(self, body: str) -> str:
        var p: Params = params_of(body)
        let b: Books = self.books.books(self.config.currency)
        let made: Entry | !BookFailure_T = entry_of(b, p)
        if made is BookFailure_T:
            p.note = made.detail
            p.bad = True
        else:
            var recorded: None | !BookFailure_T = None
            try:
                recorded = self.books.record(made)
            except:
                recorded = BookFailure_T("the database failed: " + getCurrentExceptionMsg())
            if recorded is BookFailure_T:
                p.note = recorded.detail
                p.bad = True
            else:
                p.note = f"Recorded: {made.what}"
                p.source = ""
                p.target = ""
                p.what = ""
                p.howmuch = ""
        return self.page_text(p)

    # POST /h/do: one of the page's other changes (P.op), done.
    def page_do(self, body: str) -> str:
        var p: Params = params_of(body)
        var done: str | !BookFailure_T = ""
        try:
            done = self.do_op(p, self.books.books(self.config.currency))
        except:
            done = BookFailure_T("the database failed: " + getCurrentExceptionMsg())
        if done is BookFailure_T:
            p.note = done.detail
            p.bad = True
        else:
            let told: str = done
            if p.op in ["startover", "saveas", "delete"]:     # another scenario, or the same one again: its own settings
                p = fresh_params(p.tab)
            p.note = told
            p.bad = False
        return self.page_text(p)
