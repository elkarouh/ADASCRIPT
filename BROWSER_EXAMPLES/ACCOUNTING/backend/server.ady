#!/usr/bin/env ady2nim
#ady2nim-args c -d:release
"""server -- the ledger's books, served to the page that draws them; HTTP only.

What each request does to the books is accounting_events.ady's Session; the page is accounting_page_gui.ady.

    server [--config FILE] [--scenario NAME] [--port N]     (or: make app)

Serves the page (drawn by accounting_page_gui.ady, with build/htmx.min.js and
build/accounting_js_events.js beside the config file) and the books of one scenario:

    GET  /, /h             the page, drawn by the server for htmx (accounting_page_gui.ady)
    GET  /events           the changes, as they are made, for every open page (server-sent events)
    GET  /books            the accounts and every transaction, as text (books_text.ady)
    GET  /scenarios        "current", a tab and the scenario shown, then
                           "scenario", NAME and TITLE for each one there is

Every other request (GET /h/all, and the commands on transactions, accounts and scenarios) is
answered by Session.answer in accounting_events.ady, which lists them. A read answers the whole
page, which htmx swaps in; a command only what was done, or why not. Each change it made is
published, and `tell`, here, tells every open page, which then reads itself again.

A scenario is a pair of files in scenarios/, beside the config file (bookkeeping.ady):
NAME.books, the books as they come, and NAME.kept, the books as the page changed them,
made from NAME.books the first time NAME is shown and again by Start over.
"""
from asyncdispatch nimport complete, newFuture, Port, waitFor
from asynchttpserver nimport HttpHeaders, newHttpHeaders, Request, respond, Http200, Http404, AsyncHttpServer, newAsyncHttpServer, serve
from backend/accounting_page_gui import shell_text
from page_server import News, send_script
from commands import Change
from store import Store
from backend/accounting_model import BookFailure_T
from backend/bookkeeping import Config, config_of
from backend/accounting_events import Channel_T, Session

var session: Session = Session(Config("USD", []), Store(""))     # main makes it on the config file

# The pages following GET /events.
var news: News = News()

# A change, told to every page that follows: subscribed to the session's channels in main.
def tell(channel: Channel_T, change: Change):
    news.tell(f"{channel} {change.kind} {change.key}")

var www: Path = Path("build")            # where the page is: build/, beside the config file

const PAGES: []str = ["htmx.min.js", "accounting_js_events.js"]

async def handler(req: Request):
    let path: str = req.url.path
    let text: HttpHeaders = newHttpHeaders([("Content-Type", "text/plain; charset=utf-8")])
    let html_type: HttpHeaders = newHttpHeaders([("Content-Type", "text/html; charset=utf-8")])
    let get: bool = req.reqMethod'Image == "GET"
    if get and (path == "/h" or path == "/"):
        await req.respond(Http200, shell_text(), html_type)
    elif get and path == "/events":
        news.follow(req.client)             # and no end: the changes follow, from tell
    elif get and path == "/books":
        await req.respond(Http200, session.books_text(), text)
    elif get and path == "/scenarios":
        await req.respond(Http200, session.scenarios_text(), text)
    elif get and path[1:] in PAGES:
        await send_script(req, www)
    else:
        let page: str = session.answer(req.reqMethod'Image, path, req.url.query + "&" + req.body)
        if page == "":
            await req.respond(Http404, "not found")
        else:
            await req.respond(Http200, page, html_type)

def main():
    var conf_path: Path = Path("accounting.conf")
    var first: str = ""
    var port: int = 8803
    let args: []str = $@
    var i: int = 0
    while i + 1 < len(args):
        case args[i]:
            when "--config":
                conf_path = Path(args[i + 1])
            when "--scenario":
                first = args[i + 1]
            when "--port":
                let n: int | !ParseFailure_T = parse_int(args[i + 1])
                if n is ParseFailure_T:
                    die(f"--port {args[i + 1]}: not a number")
                else:
                    port = n
            when others:
                die(f"unknown option {args[i]}")
        i += 2
    die(f"unknown option {args[i]}") if i < len(args)
    www = conf_path.parent / "build"
    let text: str | !PathFailure_T = conf_path.read_text()
    if text is PathFailure_T:
        die(f"{text.op} {text.path}: {text.reason}")
    else:
        let config: Config | !BookFailure_T = config_of(text, str(conf_path))
        if config is BookFailure_T:
            die(config.detail)
        else:
            session = Session(config, Store(str(conf_path.parent / "scenarios")))
    let failed: str = session.start(first)
    if failed != "":
        die(failed)
    session.entries_channel.subscribe(tell)
    session.accounts_channel.subscribe(tell)
    session.scenarios_channel.subscribe(tell)
    for file in PAGES:
        let found: str | !PathFailure_T = (www / file).read_text()
        if found is PathFailure_T:
            print f"warning: {www / file} is missing: run make app, which builds it"
    print f"scenario {session.current} of {session.scenarios.store.place}, at http://127.0.0.1:{port}/ (Ctrl-C to stop)"
    var server: AsyncHttpServer = newAsyncHttpServer()
    waitFor(server.serve(Port(port), handler))

if __name__ == "__main__":
    main()
