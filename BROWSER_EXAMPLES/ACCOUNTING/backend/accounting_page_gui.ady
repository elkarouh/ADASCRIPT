#!/usr/bin/env ady2nim
"""accounting_page_gui -- the page as HTML the server draws.

    GET /h        the shell: a script tag and a div that loads /h/all
    GET /h/all    the whole page, drawn from the books and the settings in the query

The server keeps no state of the page's. The settings (scenario, grouping, tab, ...) are the
fields of the form #state inside the page; a change to one asks /h/all for the page again with all
of them, and the answer replaces the page. A click adds one more field to the request: what was
done. accounting_page_state.ady reads them, carries out what was done, and works out what the page
shows, a View; here it is drawn:

    Drawing         the graph: four quarters, an account a box, an arrow a flow of money
    Tabs            below it: the transactions, the T-accounts, the accounts, the statements
    all_html        the whole page: the form #state, the buttons, the graph, the tabs

The same books_text.ady, accounting_gui.ady, routes.ady and accounting_model.ady the JavaScript page
used draw it, here native: the amounts are 64-bit, and the grouping is not limited to what a
browser's int can count. An account is dragged by accounting_js_events.ady, the page's one script of
our own. It records a transaction by an arrow drawn from one account to another, replays, runs the
exercise, closes the year, opens and deletes accounts and transactions, starts a scenario over,
saves it and deletes it. Each button sends a command (accounting_commands.ady), and `page` (the stdlib's server_page.ady) writes how: by its own method
and URL: a read's answer is the page, in place of #all; a change's answer is only the paragraph
#told, above the page: what was done, or why not. The page is drawn again on the news of the change
(accounting_js_events.ady), on every page that shows the books.
"""
from backend/accounting_model import Account, Flow, BookFailure_T, Cents_T, ASSET, LIABILITY, EQUITY, EXPENSE, Entry, Graph, Kind_T, Posting, VatRate_T, NO_VAT, vat_text
from drawing import Drawing_Pixel_T, Spot_T
from shared/routes import Shape, boxes, px, Route_T
from shared/layout import WIDTH, Arrow_T, Layout_T, Slot_T, books_text, layout_of_slots
from backend/accounting_gui import page_view, money, routes_for, ACCOUNTS_TEXT, APP_INTRO, RATIOS_TEXT, T_TEXT, account_view, flow_view, css_of, tip_of, to_html, section_html, sections_after_graph
from backend/books_text import AccountRow, Books, Ratio, kind_text, ratios_of
from backend/accounting_groups import Grouping
from backend/accounting_page_state import Settings, View, posting_text
from server_page import Page_Of
from style import Look, Rule, Style
from backend/accounting_commands import Thing_T, Command, url, no_fields, read_books, create_entry, delete_entry, create_account, delete_account, create_scenario, update_scenario, delete_scenario, close_year

# ---- Buttons ----

# The page: a command goes to its URL; a change's answer takes the place of the paragraph #told,
# and a read takes the settings (the form #state) along.
type Page is Page_Of[Thing_T]
let page: Page = Page(url, "#told", "#state")

# A button that asks for the page again with the field NAME set to VALUE: what was done.
def setting_button(label: str, name: str, value: str) -> Html:
    return page.button(label, read_books({name: value}))

def option_html(value: str, label: str, chosen: bool) -> Html:
    if chosen:
        html:
            option value=value selected="selected": label
    else:
        html:
            option value=value: label

# ---- The graph: four quarters, an account a box, stacked in number order ----

# The graph the view V draws, its accounts placed: shared/layout.ady lays them out (in the browser
# too, as they are dragged), each as a slot in its quarter, the ones dragged where they were let go.
class Drawing:
    var v:     View
    var rows:  []AccountRow         # the accounts drawn, a group as one
    var slots: []Slot_T
    var tall:  []Drawing_Pixel_T    # each one's half height: more arrows, taller
    var at:    Layout_T

    def __init__(self, v: View):
        self.v = v
        self.rows = v.groups.books.accounts
        self.slots = []
        self.tall = []
        for r in self.rows:
            let half: Drawing_Pixel_T = self.tall_of(r.name)
            self.tall.append(half)
            self.slots.append(Slot_T(self.id_of(r), r.name, self.quarter_of(r.kind), r.number, half, v.groups.key_of(r.name) != ""))
        self.at = layout_of_slots(self.slots, v.s.pos)

    # The quarter of an account of kind K: assets top left, liabilities and equity top right,
    # expenses bottom left, revenue bottom right.
    def quarter_of(self, k: Kind_T) -> int:
        if k == ASSET:
            return 0
        if k == LIABILITY or k == EQUITY:
            return 1
        if k == EXPENSE:
            return 2
        return 3

    # Half the height of the account NAME's box: room for the arrows in or out, whichever are more.
    def tall_of(self, name: str) -> Drawing_Pixel_T:
        let ins: int = len([f for f in self.v.whole.flows if f.target.name == name])
        let outs: int = len([f for f in self.v.whole.flows if f.source.name == name])
        return max(Drawing_Pixel_T(15.0), Drawing_Pixel_T(4.5 * float(max(ins, outs)) + 8.0))

    # An account's id in the page: its number and kind, which a group's row has too.
    def id_of(self, r: AccountRow) -> str:
        return r.number + "/" + str(int(r.kind))

    # The account I of the graph drawn: a click freezes it, or opens it when it is a group.
    def node_html(self, i: int) -> Html:
        let a: Account = self.v.drawn.accounts[i]
        let key: str = self.v.groups.key_of(a.name)
        let state: str = ("node from" if a.name == self.v.s.source else ("node now" if a.name in self.v.now_accounts else "node"))
        let css: str = (state + " picked" if a.name in self.v.s.picked else state)
        let freeze: {str}str = {"freeze": a.name}
        let toggle: {str}str = {"toggle": key}
        if key == "":
            return page.sending(read_books(freeze), self.box_of(i, css), "", "", "")
        return page.sending(read_books(toggle), self.box_of(i, css + " group"), "", "", "")

    # The box of account I, its class CSS, and what hovering over it says.
    def box_of(self, i: int, css: str) -> Html:
        let a: Account = self.v.drawn.accounts[i]
        let p: Spot_T = self.at.points[i]
        let shape: Shape = Shape(True, boxes().half_w, self.tall[i])
        let x: str = f"{p.x:.1f}"
        let y: str = f"{p.y:.1f}"
        let h: str = f"{self.tall[i]:.1f}"
        let id: str = self.id_of(self.rows[i])
        let tip: str = self.v.groups.tip(self.v.drawn, a)
        html:
            g class=css data_id=id data_name=a.name data_x=x data_y=y data_h=h:
                title: tip
                + account_view.box_to_html(a, p, shape)

    # The arrow F of the graph drawn, along ROUTE; highlighted when it is the transaction replayed's.
    def arrow_html(self, f: Flow, route: Route_T) -> Html:
        let css: str = ("now" if (f.source.name + "\t" + f.target.name) in self.v.now_arrows else "")
        let tip: str = tip_of(self.v.drawn, f)
        html:
            g class=css data_from=f.source.name data_to=f.target.name:
                + flow_view.to_html(f, route, tip)

    def to_html(self) -> Html:
        let g: Graph = self.v.drawn
        let width: Drawing_Pixel_T = Drawing_Pixel_T(WIDTH)
        let size: Spot_T = Spot_T(width, self.at.height)
        let names: []str = [r.name for r in self.rows]
        let routes: []Route_T = routes_for(g, names, self.at.points, self.tall, size, boxes())
        let arrows: []Arrow_T = [Arrow_T(f.source.name, f.target.name, money(f.amount)) for f in g.flows]
        let box: str = f"0 0 {width:.0f} {self.at.height:.0f}"
        let across: str = f"M 8 {px(self.at.split_y)} L {px(width - 8.0)} {px(self.at.split_y)}"
        let rx: str = px(width / 2.0 + 20.0)
        let by: str = px(self.at.split_y + 30.0)
        let down: str = f"M {px(width / 2.0)} 8 L {px(width / 2.0)} {px(self.at.height - 8.0)}"
        html:
            div class="drawing":
                svg viewBox=box class="graph":
                    defs:
                        marker id="arrow" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto":
                            polygon points="0 0, 10 3.5, 0 7"
                        marker id="arrow-now" markerWidth="4.3" markerHeight="3" refX="3.9" refY="1.5" orient="auto":
                            polygon class="now" points="0 0, 4.3 1.5, 0 3"
                    path class="split" d=down
                    path class="split" d=across
                    stext class="side" x="20" y="30": "Assets"
                    stext class="side" x=rx y="30": "Liabilities and equity"
                    stext class="side" x="20" y=by: "Expenses"
                    stext class="side" x=rx y=by: "Revenue"
                    for i in range(len(g.flows)):
                        + self.arrow_html(g.flows[i], routes[i])
                    path id="rubber" class="rubber" d=""
                    for i in range(len(g.accounts)):
                        + self.node_html(i)
                # the accounts and arrows as the server keeps them, for the browser to lay out and route again
                # (outside the svg: a <pre> inside it would end the drawing)
                script type="application/json" id="books": books_text(self.slots, arrows)

# ---- The popup: the transaction an arrow drawn records ----

# The popup of the view V: from the frozen account to the one the arrow went to, say when, what and
# how much. Record sends it; Cancel closes it.
def popup_html(v: View) -> Html:
    return page.sending(create_entry(), popup_form(v), "", "", "#state")

def popup_form(v: View) -> Html:
    let title: str = f"{v.s.source}  →  {v.s.target}"
    let date: str = (v.s.popup.date if v.s.popup.date != "" or len(v.b.entries) == 0 else v.b.entries[len(v.b.entries) - 1].date)
    html:
        form id="popup" class="popup":
            h3: title
            label: "Date"
            input name="date" value=date placeholder="2012-01-31"
            label: "What happened"
            input name="what" value=v.s.popup.what placeholder="a chair for the office"
            label: "Amount, before VAT"
            input name="amount" value=v.s.popup.amount placeholder="605.00"
            label: "VAT"
            select name="vat":
                for rate in VatRate_T:
                    + option_html(str(rate), vat_text(rate), str(rate) == v.s.popup.vat or (v.s.popup.vat == "" and rate == NO_VAT))
            button type="submit": "Record"
            + setting_button("Cancel", "cancel", "1")

# ---- The tabs: the transactions, the T-accounts, the accounts, the statements ----

const TAB_NAMES: []str = ["Transactions", "T-accounts", "Accounts", "Statements"]

# What the tabs of the view V show: the books as the first COUNT transactions left them, the one
# replayed highlighted; as plus and minus, or as debits and credits (dc).
class Tabs:
    var v: View

    def __init__(self, v: View):
        self.v = v

    # What the tab TAB shows.
    def to_html(self, tab: str) -> []Html:
        let g: Graph = self.v.books
        let help: bool = self.v.s.help
        if tab == "T-accounts":
            return [section_html("T-accounts", (T_TEXT if help else ""), [self.t_accounts_html()])]
        if tab == "Accounts":
            return [section_html("Accounts", (ACCOUNTS_TEXT if help else ""), [self.accounts_html()])]
        if tab == "Statements":
            var out: []Html = sections_after_graph(g, help)[1:]
            out.append(section_html("Ratios", (RATIOS_TEXT if help else ""), [self.ratios_html()]))
            return out
        return [self.dc_html(), self.transactions_html()]

    # The button that writes the transactions as a journal does, or as plus and minus again.
    def dc_html(self) -> Html:
        let label: str = ("Plus and minus" if self.v.s.dc else "Debit and credit")
        html:
            p:
                + setting_button(label, "act", "dc")

    # The cell with the button that deletes transaction I.
    def delete_html(self, i: int) -> Html:
        let b: Books = self.v.b
        let ask: str = f"Delete the transaction of {b.entries[i].date}, {b.entries[i].what}?"
        html:
            td:
                + page.button("Delete", delete_entry(b.ids[i]), ask, "delete")

    # How transaction I is shown in the replay: the one replayed, one after it (greyed), or as it is.
    def replayed_css(self, i: int, css: str) -> str:
        let step: int = self.v.s.step
        if step < 0 or i < step:
            return css
        return (css + " now" if i == step else css + " later").strip()

    # Transaction I as plus and minus: what it did to each account.
    def row_html(self, i: int) -> Html:
        let e: Entry = self.v.b.entries[i]
        let css: str = self.replayed_css(i, "")
        html:
            tr class=css:
                td: e.date
                td: e.what
                td: posting_text(e)
                + self.delete_html(i)

    # Posting P of transaction I, the K-th line of it in the journal.
    def posting_row_html(self, i: int, k: int, p: Posting) -> Html:
        let e: Entry = self.v.b.entries[i]
        let credit: bool = p.amount < 0
        let account_css: str = ("credit" if credit else "debit")
        html:
            tr:
                td: (e.date if k == 0 else "")
                td: (e.what if k == 0 else "")
                td class=account_css: p.account
                td class="num": (money(p.amount) if not credit else "")
                td class="num": (money(Cents_T(-int(p.amount))) if credit else "")
                if k == 0:
                    + self.delete_html(i)
                else:
                    td: ""

    # Transaction I as a journal writes it: the debits first, then the credits.
    def journal_entry_html(self, i: int) -> Html:
        let e: Entry = self.v.b.entries[i]
        let ordered: []Posting = [p for p in e.postings if p.amount > 0] + [p for p in e.postings if p.amount < 0]
        let css: str = self.replayed_css(i, "entry")
        html:
            tbody class=css:
                for k in range(len(ordered)):
                    + self.posting_row_html(i, k, ordered[k])

    # The transactions shown, as plus and minus or, with dc, as a journal's debits and credits.
    def transactions_html(self) -> Html:
        if self.v.s.dc:
            html:
                table:
                    tr:
                        th: "Date"
                        th: "Transaction"
                        th: "Account"
                        th: "Debit"
                        th: "Credit"
                        th: ""
                    for i in range(self.v.count):
                        + self.journal_entry_html(i)
        else:
            html:
                table:
                    tr:
                        th: "Date"
                        th: "Transaction"
                        th: "What it did to each account"
                        th: ""
                    for i in range(self.v.count):
                        + self.row_html(i)

    # The account R: its number, name, kind and balance, and the button that deletes it.
    def account_row_html(self, r: AccountRow) -> Html:
        let g: Graph = self.v.books
        let balance: Cents_T = g.balance(r.name)
        let css: str = css_of(g.account(r.name))
        let ask: str = f"Delete the account {r.name}?"
        html:
            tr:
                td: r.number
                td class=css: r.name
                td: kind_text(r.kind)
                if self.v.s.dc:
                    td class="num": (money(balance) if balance > 0 else "")
                    td class="num": (money(Cents_T(-int(balance))) if balance < 0 else "")
                else:
                    td class="num": money(balance)
                td:
                    + page.button("Delete", delete_account(r.name), ask, "delete")

    # Every account, and a row to open a new one.
    def accounts_html(self) -> Html:
        let dc: bool = self.v.s.dc
        html:
            table class="accounts":
                tr:
                    th: "Number"
                    th: "Account"
                    th: "Kind"
                    if dc:
                        th class="num": "Debit"
                        th class="num": "Credit"
                    else:
                        th class="num": "Balance"
                    th: ""
                for r in self.v.b.accounts:
                    + self.account_row_html(r)
                tr class="new":
                    td:
                        input name="number" placeholder="613100" size="8"
                    td:
                        input name="acctname" placeholder="a new account" size="16"
                    td:
                        select name="akind":
                            for word in ["asset", "liability", "equity", "revenue", "expense"]:
                                option value=word: word
                    td: ""
                    if dc:
                        td: ""
                    td:
                        + page.button("Open", create_account(), "", "", "tr.new")

    # What an accountant or a banker reads off the balance sheet.
    def ratios_html(self) -> Html:
        let ratios: []Ratio = ratios_of(self.v.b, self.v.books)
        html:
            table:
                tr:
                    th: "Ratio"
                    th: "Value"
                    th: "What it tells"
                for r in ratios:
                    tr:
                        td: r.name
                        td class="num": r.value
                        td: r.meaning

    # The account ROW as a T, in the transactions ENTRIES: its debits on the left, its credits on the right.
    def t_account_html(self, row: AccountRow, entries: []Entry) -> Html:
        var debits: []Cents_T = []
        var credits: []Cents_T = []
        for e in entries:
            for p in e.postings:
                if p.account == row.name:
                    if p.amount > 0:
                        debits.append(p.amount)
                    else:
                        credits.append(Cents_T(-int(p.amount)))
        let g: Graph = self.v.books
        let balance: Cents_T = g.balance(row.name)
        let words: str = ("" if balance == 0 else (" debit" if balance > 0 else " credit"))
        let owed: str = f"Balance {money(Cents_T(abs(int(balance))))}{words}"
        let css: str = css_of(g.account(row.name))
        let heading: str = f"{row.number} {row.name}"
        html:
            div class="taccount":
                h4 class=css: heading
                div class="tbody":
                    div class="tdebit":
                        for d in debits:
                            p: money(d)
                    div class="tcredit":
                        for c in credits:
                            p: money(c)
                p class="tbalance": owed

    # Every account the transactions shown touch, as a T.
    def t_accounts_html(self) -> Html:
        let entries: []Entry = self.v.b.entries[:self.v.count]
        var touched: []str = []
        for e in entries:
            for p in e.postings:
                touched.append(p.account)
        html:
            div class="tgrid":
                for r in self.v.b.accounts:
                    if r.name in touched:
                        + self.t_account_html(r, entries)

# ---- The form #state: the settings, and the buttons that change them ----

const FOLDS: []int = [0, 2, 5, 10, 20, 50, 100]

def detail_label(d: int) -> str:
    return ("All accounts" if d == 0 else (f"{d} digit" if d == 1 else f"{d} digits"))

def fold_label(q: int) -> str:
    return ("Every account" if q == 0 else f"Fewer than {q} transactions")

# The form #state: the scenario and the grouping to choose, the settings as the act left them (hidden),
# and the buttons of the replay or the exercise, with the caption of the transaction replayed or asked for.
def state_html(v: View, names: []str, titles: []str, current: str) -> Html:
    let s: Settings = v.s
    let n: int = len(v.b.entries)
    let days: []str = v.replay.days
    let position: int = v.replay.position(s.step)
    let last_day: str = str(max(len(days) - 1, 0))
    let tidy: {str}str = {"tidy": "1"}
    html:
        form id="state":
            strong: "Scenario "
            select name="scenario":
                for i in range(len(names)):
                    + option_html(names[i], titles[i], names[i] == current)
            if len(v.b.accounts) > 12:
                span: " Group by "
                select name="detail":
                    for d in range(0, v.groups.digits()):
                        + option_html(str(d), detail_label(d), d == v.groups.detail)
                span: " fold "
                select name="fold":
                    for q in FOLDS:
                        + option_html(str(q), fold_label(q), q == s.fold)
                if len(s.opened) > 0 or len(s.merges) > 0:
                    + setting_button("Close groups", "act", "close_groups")
            input type="hidden" name="opened" value="|".join(s.opened)
            input type="hidden" name="picked" value="|".join(s.picked)
            input type="hidden" name="merges" value="|".join(s.merges)
            input type="hidden" name="pick" value=""
            input type="hidden" name="tab" value=s.tab
            input type="hidden" name="pos" value=s.pos
            input type="hidden" name="source" value=s.source
            input type="hidden" name="target" value=s.target
            input type="hidden" name="step" value=str(s.step)
            input type="hidden" name="playing" value=("1" if s.playing else "0")
            input type="hidden" name="only" value=s.only
            input type="hidden" name="help" value=("1" if s.help else "0")
            input type="hidden" name="dc" value=("1" if s.dc else "0")
            input type="hidden" name="ex" value=str(s.ex)
            input type="hidden" name="score" value=str(s.score)
            input type="hidden" name="tries" value=str(s.tries)
            + setting_button(("Hide help" if s.help else "Help"), "act", "help")
            + page.sending(read_books(tidy), tidy_button(), "", "", "")
            if s.ex >= 0:
                p class="replay":
                    if v.asking():
                        + setting_button("Show the answer", "act", "answer")
                    + setting_button("Stop the exercise", "act", "stopex")
                p class="caption":
                    strong: v.exercise_caption()
                    span: "  " + (v.b.entries[s.ex].what if v.asking() else "")
            else:
                p class="replay":
                    if s.playing:
                        + setting_button("Pause", "act", "pause")
                    else:
                        + setting_button(v.play_label(), "act", "play")
                    + setting_button("Previous", "act", "prev")
                    + setting_button("Next", "act", "next")
                    if s.step >= 0:
                        + setting_button("Show all", "act", "all")
                    if n > 0 and len(v.groups.names) == 0:
                        + setting_button("Exercise", "act", "exercise")
                    if len(days) > 1:
                        span: " Books as at "
                        strong: days[position]
                        input type="range" class="slide" name="slide" min="0" max=last_day value=str(position)
                if s.step >= 0:
                    p class="caption":
                        strong: v.replay.caption(s.step)
                        span: "  " + v.b.entries[s.step].what
            if s.hint() != "":
                p class="hint": s.hint()

def tidy_button() -> Html:
    html:
        button type="button" title="Lay the accounts out again": "Tidy up"

# The buttons that change the books or the scenario (CURRENT), and the merge of the accounts picked.
def tools_html(v: View, current: str) -> Html:
    let saved: str = current + "_mine"
    let picked: []str = v.s.picked
    let picked_text: str = "Picked: " + ", ".join(picked)
    html:
        p class="tools":
            + page.button("Start over", update_scenario(), "Start this scenario over? What you changed in it is lost.")
            span: " "
            input id="newname" name="newname" value=saved size="16" title="Letters, digits, _ and -"
            + page.button("Save as...", create_scenario(), "", "", "#newname")
            + page.button("Delete scenario", delete_scenario(), "Delete this scenario, and the changes you made in it? It cannot be undone.")
            if v.can_close():
                + page.button("Close the year", close_year(), "Close the year? The costs and the revenue go to retained earnings, and the cost and revenue accounts start again from zero.")
            if len(picked) > 0:
                span class="picked": " " + picked_text
            if len(picked) >= 2:
                input id="mergename" name="mergename" placeholder="name of the merged accounts" size="24"
                + page.button("Merge the picked", read_books({"act": "merge"}), "", "", "#mergename")

# ---- The page ----

# The whole page for the view V of scenario CURRENT, of the scenarios NAMES (their TITLES).
def all_html(v: View, names: []str, titles: []str, current: str) -> Html:
    let s: Settings = v.s
    let arrow: bool = s.source != "" and s.target != ""
    let about: []str = (v.b.about.split("\n") if s.help and v.b.about != "" else [])
    let note_css: str = ("refused" if s.bad else "note")
    let tick: {str}str = {"act": "tick"}
    html:
        div id="all":
            + page.on_change(read_books(no_fields()), state_html(v, names, titles, current))
            + tools_html(v, current)
            if s.help:
                p: APP_INTRO
            h2: v.b.title
            for line in about:
                p class="about": line
            if s.note != "" and not arrow:
                p class=note_css: s.note
            if arrow:
                + popup_html(v)
            + Drawing(v).to_html()
            div class="tabs":
                for name in TAB_NAMES:
                    + page.button(name, read_books({"go": name}), "", ("selected" if name == s.tab else ""))
            for part in Tabs(v).to_html(s.tab):
                + part
            if s.playing:
                + page.every(1800, read_books(tick))


# The paragraph #told, the answer to a change: what was done (DONE), or why not; empty, and not
# shown, before the first. It is outside #all, so the page drawn again on the news keeps it.
def told_html(done: str | !BookFailure_T) -> Html:
    if done is BookFailure_T:
        html:
            p id="told" class="refused": done.detail
    else:
        let text: str = done
        html:
            p id="told" class="note": text

def told_text(done: str | !BookFailure_T) -> str:
    return str(told_html(done))

def title_html() -> Html:
    html:
        h1: "Accounting, as graph theory"

# The app's look: the static page's (page_view), and its own: the form #state and the buttons, the
# graph's quarters, the popup, the tabs and what they show.
class App_View:
    style "":
        body:                       max_width="80em"
        form#state:                 background="#eaf2fb" padding="0.5em 0.8em" border_radius="4px" margin="0.5em 0"
        # the graph's quarters (Drawing)
        path.split:                 stroke="#999" stroke_width=1.5 stroke_dasharray="6 4" fill="none"
        text.side:                  font_size="14px" font_weight=700 fill="#666"
        svg.graph:                  user_select="none"
        # the popup (popup_form)
        form.popup:                 position="fixed" top="20%" left="50%" transform="translateX(-50%)" background="#fff" border="2px solid #333" border_radius="6px" padding="1em 1.5em" box_shadow="0 4px 24px #0006" z_index="10" min_width="24em"
        form.popup label:           display="block" margin_top="0.6em" font_weight=700
        form.popup input, form.popup select: width="100%" box_sizing="border-box"
        form.popup button:          margin="1em 0.5em 0 0"
        # what was done (told_html), the replay, the tools
        p.refused:                  color="#b71c1c" font_weight=700
        p.note:                     background="#e8f5e9" padding="0.3em 0.8em" border_radius="4px"
        p#told:empty:               display="none"
        tr.now td:                  background="#ffe0b2" font_weight=700
        p.replay:                   margin="0.5em 0 0 0"
        p.caption:                  margin="0.3em 0 0 0"
        input.slide:                vertical_align="middle" width="16em"
        tr.later td:                color="#bbb"
        tbody.now td:               background="#ffe0b2" font_weight=700
        tbody.later td:             color="#bbb"
        tbody.entry td:             border_top="2px solid #999"
        tbody.entry tr + tr td:     border_top="1px solid #ddd"
        p.tools, p.hint:            margin="0.4em 0"
        p.hint:                     color="#555"
        p.about:                    color="#444"
        # the T-accounts (Tabs.t_accounts_html)
        div.tgrid:                  display="grid" grid_template_columns="repeat(auto-fill, minmax(190px, 1fr))" gap="12px" margin_top="0.8em" align_items="start"
        div.taccount:               border="1px solid #999" border_radius="4px" background="#fff" font_size="0.9em"
        div.taccount h4:            margin="0" padding="4px 8px" border_bottom="2px solid #333" font_size="1em"
        div.taccount h4.green:      background="#d6f0d6"
        div.taccount h4.liability:  background="#e3d6f5"
        div.taccount h4.revenue:    background="#a9cdf5"
        div.taccount h4.expense:    background="#fbd29c"
        div.taccount h4.untouched:  background="#eee"
        div.taccount h4.pink:       background="#f8d6e6"
        div.tbody:                  display="grid" grid_template_columns="1fr 1fr" min_height="2.4em"
        div.tdebit:                 padding="4px 8px" text_align="right" border_right="2px solid #333" font_variant_numeric="tabular-nums"
        div.tcredit:                padding="4px 8px" text_align="right" font_variant_numeric="tabular-nums"
        div.tbody p, p.tbalance:    margin="0" padding="0 8px"
        # the tabs
        div.tabs button:            padding="0.35em 1em" border="1px solid #bbb" background="#f4f4f4" cursor="pointer"
        div.tabs button.selected:   background="#fff" font_weight=700 border_bottom_color="#fff"

    # The rules of the page, for its <style>.
    def css(self) -> str:
        return page_view.css() + self.style.css()

let app_view: App_View = App_View()

def shell_text() -> str:
    return page.shell_text("Accounting, as graph theory", app_view.css(), ["accounting_js_events.js"], [title_html(), told_html("")], read_books(no_fields()))

# The page for the books B of scenario CURRENT, of the scenarios NAMES (their TITLES), as the settings
# S ask, what the reader did carried out.
def all_text(b: Books, names: []str, titles: []str, current: str, s: Settings) -> str:
    return str(all_html(View(b, s), names, titles, current))
