#!/usr/bin/env ady2nim
"""accounting_commands -- the one vocabulary of the page and the server: Create, Read, Update or
Delete, of a transaction, an account, a scenario, or the books. Compiled both ways: the page's
buttons and its script make commands, the server reads each request back into one, and both go by
the same words, as BROWSER_EXAMPLES/DIJKSTRA_HTMX's do.

A Command is its verb (CREATE, READ, UPDATE, DELETE), what it is done to (A_TRANSACTION, AN_ACCOUNT,
A_SCENARIO, or THE_BOOKS, which is what is read: named so, and not ENTRY or BOOKS, for Nim, which
would take ENTRY for the model's Entry), and its fields by name:

    create_entry()                  # C: POST   /h/entries     date what amount vat, source target (the arrow)
    delete_entry(7)                 # D: DELETE /h/entries     id=7
    create_account()                # C: POST   /h/accounts    number acctname akind
    delete_account("Bank")          # D: DELETE /h/accounts    name=Bank
    create_scenario()               # C: POST   /h/scenarios   newname: the books shown, saved as it
    update_scenario()               # U: PUT    /h/scenarios   the scenario shown, started over
    delete_scenario()               # D: DELETE /h/scenarios   the scenario shown
    read_books({"tab": "Accounts"}) # R: GET    /h/all         the page, with the settings of the form #state
    move_account("100000/0", at)    # a draft: an account still held; it stays in the browser

The fields a command takes from the page (what the reader typed in the popup, the new account's
row, the new scenario's name) are not in it: the button that sends it includes them. On the wire
the verb is the HTTP method and the thing is the URL: `c.method()` and `c.url()` say which, and
`command_of` reads them back, so the mapping is written once, here. The server answers a read with
the page, and a change with the paragraph #told (accounting_page_gui.ady): done, or why not. No
HTML, no HTTP.
"""
from drawing import Drawing_Pixel_T, Spot_T

type Verb_T is enum CREATE, READ, UPDATE, DELETE
type Thing_T is enum A_TRANSACTION, AN_ACCOUNT, A_SCENARIO, THE_BOOKS

type Command is record:
    verb:   Verb_T
    thing:  Thing_T
    fields: {str}str

# The field NAME of command C, or "" when it has none.
def value(c: Command, name: str) -> str:
    if name in c.fields:
        return c.fields[name]
    return ""

# Where command C puts its account: its fields x and y; None when it has none, or they are not numbers.
def spot(c: Command) -> ?Spot_T:
    let x: float | !ParseFailure_T = parse_float(c.value("x"))
    let y: float | !ParseFailure_T = parse_float(c.value("y"))
    if x is ParseFailure_T:
        return None
    if y is ParseFailure_T:
        return None
    return Spot_T(x=Drawing_Pixel_T(x), y=Drawing_Pixel_T(y))

# ---- On the wire: the verb is the HTTP method, the thing is the URL ----

# The HTTP method command C goes by: its verb.
def method(c: Command) -> str:
    case c.verb:
        when CREATE:
            return "POST"
        when READ:
            return "GET"
        when UPDATE:
            return "PUT"
        when DELETE:
            return "DELETE"

# The URL command C goes to: what it is done to.
def url(c: Command) -> str:
    case c.thing:
        when A_TRANSACTION:
            return "/h/entries"
        when AN_ACCOUNT:
            return "/h/accounts"
        when A_SCENARIO:
            return "/h/scenarios"
        when THE_BOOKS:
            return "/h/all"

# The command that HTTP_METHOD on PATH is, with FIELDS; None when it is none of them. The books are
# only read, and only the books are read; only a scenario is updated (started over).
def command_of(http_method: str, path: str, fields: {str}str) -> ?Command:
    for verb in Verb_T:
        for thing in Thing_T:
            let c: Command = Command(verb, thing, fields)
            if c.method() == http_method and c.url() == path and (verb == READ) == (thing == THE_BOOKS) and (verb != UPDATE or thing == A_SCENARIO):
                return c
    return None

# ---- The commands, by name: one each for what the page can ask ----

# No fields: what the page sends with the command, the button includes.
def no_fields() -> {str}str:
    let none: {str}str = {:}
    return none

# C: the transaction the arrow drawn and the popup say (date, what, amount, vat; source, target).
def create_entry() -> Command:
    return Command(CREATE, A_TRANSACTION, no_fields())

# D: the transaction numbered ID.
def delete_entry(id: int) -> Command:
    let fields: {str}str = {"id": str(id)}
    return Command(DELETE, A_TRANSACTION, fields)

# C: the account the new account's row says (number, acctname, akind).
def create_account() -> Command:
    return Command(CREATE, AN_ACCOUNT, no_fields())

# D: the account NAME, which no transaction may touch.
def delete_account(name: str) -> Command:
    return Command(DELETE, AN_ACCOUNT, {"name": name})

# C: the books shown, saved as a new scenario (newname), and shown.
def create_scenario() -> Command:
    return Command(CREATE, A_SCENARIO, no_fields())

# U: the scenario shown, back as its .books file has it.
def update_scenario() -> Command:
    return Command(UPDATE, A_SCENARIO, no_fields())

# D: the scenario shown, with its database; the first one left is shown.
def delete_scenario() -> Command:
    return Command(DELETE, A_SCENARIO, no_fields())

# R: the page, with the settings of the form #state, FIELDS taking the place of its own of the same name.
def read_books(fields: {str}str) -> Command:
    return Command(READ, THE_BOOKS, fields)

# A draft, while the reader still holds the account ID: where it is now. Nothing is changed for it
# but the page; when the account is let go, the page is read again with its place in the field pos.
def move_account(id: str, at: Spot_T) -> Command:
    let fields: {str}str = {"id": id, "x": f"{at.x:.1f}", "y": f"{at.y:.1f}", "draft": "yes"}
    return Command(READ, THE_BOOKS, fields)

# Whether C is a draft: the reader is still making it, and nothing is to be done for it but on the page.
def is_draft(c: Command) -> bool:
    return c.value("draft") == "yes"
