#!/usr/bin/env ady2nim
"""Accounting for computer scientists, as a web page.

    ady2nim c -r accounting_gui.ady > accounting_gui.html   (or: make gui)

The accounting itself is accounting_model.ady: Account and Graph objects
with no GUI in them, tested on their own by test_accounting_model.ady. This
file only renders them: the graph drawn as an SVG (circles for the accounts,
arrows for the money flowing), the transactions, the balances, the profit and
loss statement and the balance sheet. See Martin Kleppmann's "Accounting for
Computer Scientists" (2011,
https://martin.kleppmann.com/2011/03/07/accounting-for-computer-scientists.html).

Needs karax: `nimble install karax@1.5.0`.
"""
from math nimport sqrt
from drawing import Drawing_Pixel_T, Drawing_cm_T, Spot_T
from style import Look, Rule, Style
from shared/routes import NODE_RADIUS, Route_T, Shape, boxes, circles, covers, px, rim, routes_of, toward
from backend/accounting_model import Account, Cents_T, Colour_T, Dollars_T, Flow, Graph, Line, Transaction, kleppmann

# 1234567 cents -> "12,345.67": Dollars_T converts, the format groups.
def money(c: Cents_T) -> str:
    return f"{Dollars_T(c):,.2f}"

# The arrows of G routed by shared/routes.ady, which knows only names, points and texts.
def routes_for(g: Graph, names: []str, points: []Spot_T, tall: []Drawing_Pixel_T, size: Spot_T, shape: Shape) -> []Route_T:
    var sources: []str = []
    var targets: []str = []
    var texts: []str = []
    for f in g.flows:
        sources.append(f.source.name)
        targets.append(f.target.name)
        texts.append(money(f.amount))
    return routes_of(sources, targets, texts, names, points, tall, size, [], [], shape)



def css_of(a: Account) -> str:
    case a.colour:
        when GREEN:
            return ("liability" if a.balance < 0 else "green")      # an asset is owned, a liability owed
        when BLUE:
            if a.balance == 0:
                return "untouched"                                  # neither yet: nothing went through it
            return ("revenue" if a.balance < 0 else "expense")    # revenue is a negative balance
        when PINK:
            return "pink"

# ---------------------------------------------------------------------
# The layout: where each account sits in the drawing
# ---------------------------------------------------------------------

# Where account A is drawn: the example's accounts each have a place;
# another is at (-1, -1), and the page that shows it finds it one.
def place(a: Account) -> Spot_T:
    case a.name:
        when "VAT payable":
            return Spot_T(80.0, 50.0)
        when "Sales":
            return Spot_T(80.0, 190.0)
        when "Trade receivables":
            return Spot_T(270.0, 50.0)
        when "Share capital":
            return Spot_T(80.0, 330.0)
        when "Credit card":
            return Spot_T(480.0, 50.0)
        when "Bank":
            return Spot_T(480.0, 190.0)
        when "VAT receivable":
            return Spot_T(270.0, 330.0)
        when "Furniture and equipment":
            return Spot_T(480.0, 330.0)
        when "Wages and salaries":
            return Spot_T(700.0, 190.0)
        when "Food":
            return Spot_T(700.0, 50.0)
        when "Trade payables":
            return Spot_T(270.0, 470.0)
        when "Goods for resale":
            return Spot_T(480.0, 470.0)
        when "Bank loans":
            return Spot_T(700.0, 470.0)
        when "Purchases":
            return Spot_T(480.0, 610.0)
        when "Change in stock":
            return Spot_T(270.0, 610.0)
        when "Interest expense":
            return Spot_T(900.0, 50.0)
        when "Own work capitalised":
            return Spot_T(900.0, 190.0)
        when "Software":
            return Spot_T(900.0, 330.0)
        when "Depreciation":
            return Spot_T(700.0, 330.0)
        when others:
            return Spot_T(-1.0, -1.0)          # no place of its own: the page finds one

# ---------------------------------------------------------------------
# Rendering: a to_html for each thing of the model that is drawn, called as
# a method (a.to_html(p, tip), g.to_html()) though the model knows nothing of it
# ---------------------------------------------------------------------

# +5,000.00 or -500.00: the change a transaction makes to an account.
def signed(c: Cents_T) -> str:
    return ("+" if c >= 0 else "-") + money(Cents_T(abs(int(c))))

# What hovering over account A shows: its balance, then each transaction that
# touches it with its date, the change it made and the balance after it.
def account_tip(g: Graph, a: Account) -> str:
    var tip: str = f"{a.name}: balance {money(a.balance)}"
    var running: Cents_T = 0
    for t in g.transactions_for(a):
        let change: Cents_T = (t.amount if t.target == a else Cents_T(-int(t.amount)))
        running += change
        tip += "\n" + f"{t.date}   {signed(change)}   -> {money(running)}   {t.what}"
    return tip

# A name as it fits in a node: on one line, or, when long, on two, broken
# at the space nearest its middle.
def label_lines(name: str) -> []str:
    if len(name) <= 14:
        return [name]
    var best: int = -1
    for i in range(len(name)):
        if name[i] == ' ' and (best < 0 or abs(i - len(name) // 2) < abs(best - len(name) // 2)):
            best = i
    if best < 0:
        return [name]
    return [name[:best], name[best + 1:]]

# NAME cut to fit ROOM pixels of the box's 12px text, ending in "..." when it is cut.
def fit_name(name: str, room: Drawing_Pixel_T) -> str:
    let chars: int = int(float(room) / 7.3)
    if len(name) <= chars or chars < 4:
        return name
    return name[:chars - 1] + "\u2026"

# What an account is to the live page's drawing, besides itself: frozen (FROM: an arrow drawn from
# it records a transaction), or one of the transaction replayed's (NOW).
type Mark_T is enum PLAIN, FROM, NOW

# An account drawn: as a node (a circle, the example's drawing) or as a box (the app's), its colour
# by kind, its name and balance, and how it looks when it is frozen, picked, grouped or on the way
# of a transaction.
class Account_View:
    style "svg.graph":
        circle.green:           fill="#d6f0d6" stroke="#5a9a5a" stroke_width=1.5
        rect.green:             fill="#d6f0d6" stroke="#5a9a5a" stroke_width=1.5
        circle.liability:       fill="#e3d6f5" stroke="#7a52b0" stroke_width=1.5
        rect.liability:         fill="#e3d6f5" stroke="#7a52b0" stroke_width=1.5
        circle.revenue:         fill="#a9cdf5" stroke="#1f5fa8" stroke_width=1.5
        rect.revenue:           fill="#a9cdf5" stroke="#1f5fa8" stroke_width=1.5
        circle.expense:         fill="#fbd29c" stroke="#c06a00" stroke_width=1.5
        rect.expense:           fill="#fbd29c" stroke="#c06a00" stroke_width=1.5
        circle.untouched:       fill="#fff" stroke="#999" stroke_width=1.5
        rect.untouched:         fill="#fff" stroke="#999" stroke_width=1.5
        circle.pink:            fill="#f8d6e6" stroke="#b05a85" stroke_width=1.5
        rect.pink:              fill="#f8d6e6" stroke="#b05a85" stroke_width=1.5
        text.label:             text_anchor="middle" dominant_baseline="middle" font_size="11px"
        text.boxname:           text_anchor="start" dominant_baseline="middle" font_size="12px"
        text.boxbalance:        text_anchor="end" dominant_baseline="middle" font_size="12px" font_variant_numeric="tabular-nums"
        g.node:                 cursor="grab"
        g.from rect:            stroke="#c62828" stroke_width=5 stroke_dasharray="8 4"
        g.from:                 cursor="crosshair"
        g.group:                cursor="pointer"
        g.picked rect:          stroke="#1565c0" stroke_width=6 stroke_dasharray="3 3"
        g.picked circle:        stroke="#1565c0" stroke_width=6 stroke_dasharray="3 3"
        g.now circle:           stroke="#e65100" stroke_width=6
        g.now rect:             stroke="#e65100" stroke_width=6

    # An account as a node at P: a circle with its name in it. TIP shows when the
    # mouse is over it, as for an arrow below.
    def to_html(self, a: Account, p: Spot_T, tip: str) -> Html:
        let cx: str = px(p.x)
        let cy: str = px(p.y)
        let css: str = css_of(a)
        let lines: []str = label_lines(a.name)
        let first: str = lines[0]
        let second: str = (lines[1] if len(lines) == 2 else "")
        let y1: str = (px(p.y - 7.0) if second != "" else cy)
        let y2: str = px(p.y + 7.0)
        html:
            g:
                if tip != "":
                    title: tip
                circle class=css cx=cx cy=cy r="42"
                stext class="label" x=cx y=y1: first
                if second != "":
                    stext class="label" x=cx y=y2: second

    # An account as the live page draws it: a box at P, its name on the left and its balance on
    # the right, as on a line of a balance sheet (without its sign: the colour, and the side of the
    # drawing, say whether it is owned or owed); MARK, PICKED, and a GROUP of accounts drawn as one;
    # TIP when the mouse is over it. Its NUMBER (number and kind), P and its half height are written
    # on it (data_*) for the script that drags it.
    def box_to_html(self, a: Account, number: str, p: Spot_T, shape: Shape, mark: Mark_T, picked: bool, group: bool, tip: str) -> Html:
        let marked: str = ("node" if mark == PLAIN else "node " + self.style.class_of(mark))
        let shown: str = (marked + " picked" if picked else marked)
        let state: str = (shown + " group" if group else shown)
        let x: str = f"{p.x:.1f}"
        let y: str = f"{p.y:.1f}"
        let half: str = f"{shape.half_h:.1f}"
        let left: str = px(p.x - shape.half_w)
        let top: str = px(p.y - shape.half_h)
        let w: str = px(shape.half_w * 2.0)
        let h: str = px(shape.half_h * 2.0)
        let css: str = css_of(a)
        let nx: str = px(p.x - shape.half_w + 8.0)
        let bx: str = px(p.x + shape.half_w - 8.0)
        let cy: str = px(p.y)
        let balance: str = money(a.balance if a.balance >= 0 else -a.balance)
        let shown_name: str = fit_name(a.name, shape.half_w * 2.0 - 16.0 - 10.0 - Drawing_Pixel_T(6.7 * float(len(balance))))
        html:
            g class=state data_id=number data_name=a.name data_x=x data_y=y data_h=half:
                title: tip
                g:
                    rect class=css x=left y=top width=w height=h rx="5"
                    stext class="boxname" x=nx y=cy: shown_name
                    stext class="boxbalance" x=bx y=cy: balance

# What hovering over F's arrow shows: each of its transactions, one a line,
# with its date and amount.
def tip_of(g: Graph, f: Flow) -> str:
    var tip: str = f"{f.source.name} to {f.target.name}"
    for t in g.transactions_of(f):
        tip += f"\n{t.date}   {money(t.amount)}   {t.what}"
    return tip

# A flow drawn: an arrow, its head, its amount, and the one of a transaction being drawn.
class Flow_View:
    style "svg.graph":
        path.edge:              fill="none" stroke="#555" stroke_width=1.5 marker_end="url(#arrow)"
        path.hit:               fill="none" stroke="transparent" stroke_width=12
        g.arrow:hover path.edge: stroke="#000" stroke_width=2.5
        polygon:                fill="#555"
        text.amount:            text_anchor="middle" font_size="11px" font_weight=700 paint_order="stroke" stroke="#fff" stroke_width=3
        path.rubber:            stroke="#c62828" stroke_width=3 stroke_dasharray="8 4" fill="none" marker_end="url(#arrow)"
        g.now path.edge:        stroke="#e65100" stroke_width=3.5 marker_end="url(#arrow-now)"
        polygon.now:            fill="#e65100"
        g.now text.amount:      fill="#e65100" font_weight=700 font_size="13px"

    # A flow as an arrow along ROUTE, with its amount where the route says. TIP
    # shows when the mouse is over it, as the browser's tooltip (the live page,
    # which cannot, passes "" and shows its own): a wider invisible path under
    # the arrow makes it easy to point at.
    def to_html(self, f: Flow, route: Route_T, tip: str) -> Html:
        let d: str = route.d
        let lx: str = px(route.label.x)
        let ly: str = px(route.label.y)
        html:
            g class="arrow":
                if tip != "":
                    title: tip
                path class="hit" d=d
                path class="edge" d=d
                stext class="amount" x=lx y=ly: money(f.amount)

    # A flow as the live page draws it: its arrow (to_html), NOW when it is the transaction
    # replayed's, its ends written on it (data_*) for the script.
    def live_to_html(self, f: Flow, route: Route_T, tip: str, now: bool) -> Html:
        let css: str = ("now" if now else "")
        let arrow: Html = self.to_html(f, route, tip)
        html:
            g class=css data_from=f.source.name data_to=f.target.name:
                + arrow

# The accounts and the arrows, as every drawing draws them.
let account_view: Account_View = Account_View()
let flow_view: Flow_View = Flow_View()

def to_html(g: Graph) -> Html:
    var names: []str = []
    var points: []Spot_T = []
    var tall: []Drawing_Pixel_T = []
    for a in g.accounts:
        names.append(a.name)
        points.append(place(a))
        tall.append(NODE_RADIUS)
    let routes: []Route_T = routes_for(g, names, points, tall, Spot_T(980.0, 670.0), circles())
    html:
        svg viewBox="0 0 980 670" class="graph":
            defs:
                marker id="arrow" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto":
                    polygon points="0 0, 10 3.5, 0 7"
            for i in range(len(g.flows)):
                + flow_view.to_html(g.flows[i], routes[i], tip_of(g, g.flows[i]))
            for a in g.accounts:
                + account_view.to_html(a, place(a), account_tip(g, a))

def to_html(edges: []Transaction) -> Html:
    html:
        table:
            tr:
                th: "Date"
                th: "Transaction"
                th: "From"
                th: "To"
                th: "Amount"
            for t in edges:
                tr:
                    td: t.date
                    td: t.what
                    td class=css_of(t.source): t.source.name
                    td class=css_of(t.target): t.target.name
                    td class="num": money(t.amount)

def to_html(accounts: []Account) -> Html:
    html:
        table:
            tr:
                th: "Account"
                th: "Balance"
            for a in accounts:
                tr:
                    td class=css_of(a): a.name
                    td class="num": money(a.balance)

def to_html(lines: []Line, total_label: str, total: Cents_T) -> Html:
    html:
        table class="statement":
            for l in lines:
                tr:
                    td: l.label
                    td class="num": money(l.amount)
            tr class="total":
                td: total_label
                td class="num": money(total)

def section_html(title: str, text: str, parts: []Html) -> Html:
    html:
        section:
            h2: title
            p: text
            for part in parts:
                + part

# The page's own look: the text, the tables (the graph has its own, in its classes above).
class Page_View:
    style "":
        body:               font_family="sans-serif" max_width="52em" margin="2em auto" padding="0 1em" line_height="1.45"
        table:              border_collapse="collapse" margin="1em 0"
        th, td:             border="1px solid #bbb" padding="0.3em 0.7em" text_align="left"
        td.num, th.num:     text_align="right" font_variant_numeric="tabular-nums"
        td.green:           background="#d6f0d6"
        td.blue:            background="#d6e6f8"
        td.pink:            background="#f8d6e6"
        svg.graph:          width="100%" height="auto" margin="1em 0"
        td.untouched:       background="#fff"
        table.statement:    min_width="22em"
        tr.total td:        font_weight=700 border_top="2px solid #333"

    # The rules of the page and of its graph, for its <style>.
    def css(self) -> str:
        return self.style.css() + account_view.style.css() + flow_view.style.css()

let page_view: Page_View = Page_View()

def page_html(title: str, text: str, sections: []Html) -> Html:
    html:
        html lang="en":
            head:
                meta charset="utf-8"
                title: title
                style: page_view.css()
            body:
                h1: title
                p: text
                for s in sections:
                    + s

# The page's sections, below the graph; accounting_live.ady shows them too.
def sections_after_graph(g: Graph, with_text: bool = True) -> []Html:
    let t: bool = with_text
    return [
        section_html("Balances",
            ("" if not t else "An account starts at zero. Money coming in adds to it, money going out subtracts. Every transaction is counted once as positive and once as negative, so all the balances add up to zero: that is what accountants call balancing the books."),
            [g.accounts.to_html()]),
        section_html("Profit and loss",
            ("" if not t else "Only the blue accounts: revenue less expenses. A negative balance on a blue account is revenue, so the sign flips when it is reported."),
            [g.profit_and_loss().to_html("Profit", g.profit())]),
        section_html("Balance sheet",
            ("" if not t else "The green accounts on one side, the pink accounts and the profit on the other. Profit is not cash: the bank holds less than the 25,000 invested plus the sales, because customers may still owe part of their orders."),
            [g.assets_and_liabilities().to_html("Assets less liabilities", g.net_assets()),
             g.equity_lines().to_html("Total equity", g.equity())]),
    ]

const GRAPH_TEXT: str = "Each arrow is an edge of the graph: an amount flowing from one account to another, and several transactions between the same two accounts are drawn as one arrow with their sum. An account can be a bank account, a card, a customer, or an abstract category such as food or furniture. Accounts are coloured: green for what the company owns (assets) and purple for what it owes (liabilities), blue for revenue and orange for expense, pink for the money its shareholders put in."

const TITLE: str = "Accounting for computer scientists"
const INTRO: str = "Basic accounting is graph theory. The company below is the example of Martin Kleppmann's article of that name, worked out by a program."

def main():
    let books: Graph = kleppmann()
    assert books.total() == 0                   # the books balance
    assert books.net_assets() == books.equity()     # and so does the balance sheet

    var sections: []Html = [
        section_html("Accounts are nodes, transactions are edges", GRAPH_TEXT,
            [books.to_html(), books.edges.to_html()])]
    for s in sections_after_graph(books):
        sections.append(s)
    print "<!doctype html>"
    print page_html(TITLE, INTRO, sections)

if __name__ == "__main__":       # not when accounting_live.ady imports this
    main()

# The texts the page (accounting_page_gui.ady) shows.
const ACCOUNTS_TEXT: str = "Every account, with its number in the chart of accounts, its kind and its balance. An account starts at zero; money coming in adds to it, money going out subtracts, and as every transaction is counted once as positive and once as negative, all the balances add up to zero: the books balance. Open a new account on the last row; an account can be deleted once no transaction touches it."
const RATIOS_TEXT: str = "What an accountant or a banker reads off the balance sheet, for the books as shown: they change with every transaction, with the replay and with the date slider. Current means due or turned into cash within the year."
const T_TEXT: str = "Every transaction is written twice, as a debit in one account and a credit in another, for the same amount. An account is a T: its debits on the left, its credits on the right, and its balance is the bigger side less the smaller. Assets and expenses grow on the debit side; liabilities, equity and revenue grow on the credit side. In the graph, an arrow goes from the account that is credited to the account that is debited."
const APP_TITLE: str = "Accounting, as graph theory"
const APP_INTRO: str = "Your books, as the ledger keeps them. Pick a scenario below: each is a small company's books showing one idea, yours to change; Start over brings it back as it was, Save as keeps your version as a scenario of its own. To record a transaction, click the account the money leaves, so that it freezes, then drag an arrow from it to the account the money reaches, and say when, what and how much; with VAT, the amount is before VAT and the VAT goes to its own account. Transactions are listed below the graph, accounts further down; each has a Delete button there, and a new account is opened on the last row of the accounts. Drag the accounts about within their quarters, and Tidy up lays them out again; drag the circle where the lines cross to resize the quarters. Hover over an account or an arrow to see its transactions; Play the transactions replays them one at a time, each highlighted, with the balances as they stood after it; Slide the date to see the books as they stood on each day; Debit and credit writes the transactions as a journal does and shows each account as a T; Exercise asks you to draw the arrows of the transactions yourself, one at a time; Close the year moves the costs and the revenue into retained earnings, so that the profit sits in equity and the cost and revenue accounts start again from zero; with an account frozen, only that account's transactions."
