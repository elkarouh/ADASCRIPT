#!/usr/bin/env ady2nim
#ady2nim-args js
"""roi_js_events -- the events that stay in the browser: a box dragged with the mouse.

Every other event is declared in the HTML (hx-* attributes, roi_gui.ady) and handled on the
server (roi_events.ady); only what must follow the mouse every frame is here.

A box that can be dragged is a <rect class="node" data_name=".." data_x=".." data_y=".."> (its
centre, in the drawing's units); the elements that belong to it, the rectangle itself and the
form on it, carry data_block=".." with the same name. An arrow is a <g class="arrow"> that says
which blocks it joins and where on each (data_a, data_ax, data_ay for its start: the block's
name and the distance from its top left corner; data_b, data_bx, data_by for its end; data_leave,
how it leaves its start, and data_stop, how short of its end it stops), and holds two <path>s,
which svg_path's connector_d draws, as the server does.

While a box is dragged it moves with everything that belongs to it, and the arrows that end
at it are drawn again, here in the browser, at once. Letting go sends the block's name and
new centre, PUT /move: the server keeps the place and draws the page again.

Only the rectangle can be taken hold of, not the fields on it, so they can still be clicked.
The drag itself is the standard library's svg_drag, and the page its browser module.
"""
from browser import Element_T, page, find, all, data, number, request
from svg_path import Leave_T, SIDEWAYS, VERTICAL, connector_d
from drawing import Unit_in_pixel_T, Spot_T
from svg_drag import Hooks_T, spot_of, clamp, shift, trace, no_click_cb, draggable

const WIDTH: Unit_in_pixel_T = 3000.0    # the drawing's size (the svg's viewBox, and its size on the page)
const HEIGHT: Unit_in_pixel_T = 2000.0

# What the server wrote on an element, read as if it were a field: `rect.data_name`.
def data_name(n: Element_T) -> str:
    return n.data("name")

def data_a(a: Element_T) -> str:
    return a.data("a")

def data_b(a: Element_T) -> str:
    return a.data("b")

# The rectangle that is the block called NAME.
def block_named(name: str) -> Element_T:
    return page.element(f"rect.node[data_name=\"{name}\"]")

# Where a block's top left corner is, when its centre is AT.
def corner_of(block: Element_T, at: Spot_T) -> Spot_T:
    return Spot_T(x=at.x - Unit_in_pixel_T(block.number("width") / 2.0), y=at.y - Unit_in_pixel_T(block.number("height") / 2.0))

# Where an end of ARROW is: the block NAME is called, with its centre at AT if it is the block
# being dragged (NODE), else where the server drew it; OFFSET_X and OFFSET_Y from its top left.
def end_of(node: Element_T, at: Spot_T, name: str, dx: float, dy: float) -> Spot_T:
    let block: Element_T = block_named(name)
    let centre: Spot_T = (at if name == node.data_name else spot_of(block))
    let corner: Spot_T = corner_of(block, centre)
    return Spot_T(x=corner.x + Unit_in_pixel_T(dx), y=corner.y + Unit_in_pixel_T(dy))

# Redraw, in the browser, the arrows that end at NODE's block, as if it stood at AT.
def redraw_arrows_of(node: Element_T, at: Spot_T):
    let name: str = node.data_name
    for arrow in page.all("g.arrow"):
        if name in [arrow.data_a, arrow.data_b]:
            let a: Spot_T = end_of(node, at, arrow.data_a, arrow.number("data_ax"), arrow.number("data_ay"))
            let b: Spot_T = end_of(node, at, arrow.data_b, arrow.number("data_bx"), arrow.number("data_by"))
            let leave: Leave_T = (VERTICAL if arrow.data("leave") == "vertical" else SIDEWAYS)
            for path in arrow.all("path"):
                path.trace(connector_d(float(a.x), float(a.y), float(b.x), float(b.y), leave, arrow.number("data_stop")))

# While NODE is dragged: its block goes where the mouse takes it, kept inside the drawing, and
# the arrows follow.
def moved_cb(node: Element_T, centre: Spot_T, wanted: Spot_T) -> Spot_T:
    let half_w: Unit_in_pixel_T = Unit_in_pixel_T(node.number("width") / 2.0)
    let half_h: Unit_in_pixel_T = Unit_in_pixel_T(node.number("height") / 2.0)
    let now: Spot_T = Spot_T(x=clamp(wanted.x, half_w, WIDTH - half_w), y=clamp(wanted.y, half_h, HEIGHT - half_h))
    for part in page.all(f"[data_block=\"{node.data_name}\"]"):
        shift(part, centre, now)
    redraw_arrows_of(node, now)
    return now

# NODE let go at AT: tell the server the block's name and new centre (PUT /move, see
# roi_events.ady); the page the server answers with takes the place of #all.
def dropped_cb(node: Element_T, at: Spot_T):
    request("PUT", "/move", {"name": node.data_name, "x": f"{at.x:.0f}", "y": f"{at.y:.0f}"}, "#all")

draggable("rect.node", "svg.drawing", WIDTH, Hooks_T(moved_cb=moved_cb, dropped_cb=dropped_cb, clicked_cb=no_click_cb))
