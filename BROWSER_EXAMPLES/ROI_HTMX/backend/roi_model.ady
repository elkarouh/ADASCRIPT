#!/usr/bin/env ady2nim
"""roi_model -- what an investment would be worth now; no HTML, no HTTP, nothing about where it is drawn.

An Investment is some money put in at a year. It is split between three products, in
percentages (an InvestmentPercentage each) that add up to 100: when one is changed, the
others give or take the difference, first one first, and none goes below 0. That rule is
about the three together, so a Portfolio, which holds them with the investment, owns it.
evaluate() says what a Portfolio is worth now: an Outcome, one ProductOutcome for each
product and the performance of the whole.
"""

const CURRENT_YEAR: int = 2023
const FIRST_YEAR: int = 2013

type Product_T is enum GOLD, BITCOIN, SP500

type Investment is record:
    funds: float
    year:  int

type InvestmentPercentage is record:
    kind:       Product_T
    percentage: float

type Portfolio is record:
    investment: Investment
    shares:     []InvestmentPercentage          # one for each product, in the order of Product_T

# What something is worth now, and what it earned, in percent of what was put in.
type Performance is record:
    value: float
    roi:   float

type ProductOutcome is record:
    kind:        Product_T
    performance: Performance

type Outcome is record:
    list_of_outcomes:    []ProductOutcome        # one for each product
    overall_performance: Performance

type PriceRow is tuple:
    gold:    float
    bitcoin: float
    sp500:   float

const PRICES: [2013..2023]PriceRow = [
    2013: (gold: 1685.50, bitcoin:    13.51, sp500: 1480.40),
    2014: (gold: 1219.75, bitcoin:   771.40, sp500: 1822.36),
    2015: (gold: 1184.25, bitcoin:   314.25, sp500: 2028.18),
    2016: (gold: 1060.20, bitcoin:   434.33, sp500: 1918.60),
    2017: (gold: 1162.00, bitcoin:   998.33, sp500: 2275.12),
    2018: (gold: 1312.80, bitcoin: 13657.20, sp500: 2789.80),
    2019: (gold: 1287.20, bitcoin:  3800.00, sp500: 2607.39),
    2020: (gold: 1520.55, bitcoin:  7197.92, sp500: 3278.20),
    2021: (gold: 1947.60, bitcoin: 29624.63, sp500: 3793.75),
    2022: (gold: 1800.10, bitcoin: 47434.29, sp500: 4573.82),
    2023: (gold: 1824.16, bitcoin: 16610.44, sp500: 3960.66),
]

# 100 invested in 2018, a quarter in each product.
def new_portfolio() -> Portfolio:
    var shares: []InvestmentPercentage = []
    for kind in Product_T:
        shares.append(InvestmentPercentage(kind, 25.0))
    return Portfolio(Investment(100.0, 2018), shares)

def price_of(year: int, kind: Product_T) -> float:
    let row: PriceRow = PRICES[year]
    case kind:
        when GOLD:
            return row.gold
        when BITCOIN:
            return row.bitcoin
        when others:
            return row.sp500

def roi_of(cost: float, value: float) -> float:
    if cost == 0.0:
        return 0.0
    return (value - cost) / cost * 100.0

def evaluate(portfolio: Portfolio) -> Outcome:
    var outcomes: []ProductOutcome = []
    var total: float = 0.0
    for share in portfolio.shares:
        let cost: float = portfolio.investment.funds * share.percentage / 100.0
        let value: float = cost * price_of(CURRENT_YEAR, share.kind) / price_of(portfolio.investment.year, share.kind)
        outcomes.append(ProductOutcome(share.kind, Performance(value, roi_of(cost, value))))
        total += value
    return Outcome(outcomes, Performance(total, roi_of(portfolio.investment.funds, total)))

# Set the share of KIND to PCT, and let the others give or take the difference.
def set_share(portfolio: Portfolio, kind: Product_T, pct: float):
    var diff: float = 0.0
    for i in 0 ..< len(portfolio.shares):
        if portfolio.shares[i].kind == kind:
            diff = portfolio.shares[i].percentage - pct
            portfolio.shares[i].percentage = pct
    for i in 0 ..< len(portfolio.shares):
        if portfolio.shares[i].kind != kind:
            let moved: float = portfolio.shares[i].percentage + diff
            portfolio.shares[i].percentage = max(moved, 0.0)
            diff = (moved if moved < 0.0 else 0.0)

# The year the money was put in, if there are prices for it. "" when it is done, or what was wrong.
def set_year(portfolio: Portfolio, year: int) -> str:
    if year < FIRST_YEAR or year > CURRENT_YEAR:
        return f"There are no prices for {year}: only {FIRST_YEAR} to {CURRENT_YEAR}."
    portfolio.investment.year = year
    return ""
