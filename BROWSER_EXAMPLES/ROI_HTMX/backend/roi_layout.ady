#!/usr/bin/env ady2nim
"""roi_layout -- where the boxes are drawn: what a drag changes, and nothing the model knows.

The model (roi_model.ady) has no places. The drawing has five boxes that can be dragged, each
called by a name: the investment, a box for each product, and the box of the results, which
carries the results of each product with it. A Layout is where their centres are, in the
drawing's units (its viewBox is WIDE by HIGH, large and shown one to one, so the page scrolls).
The drawing and its blocks are measured in centimetres, the places of the blocks in pixels.
"""
from drawing import Drawing_Pixel_T, Unit_in_cm_T, Spot_T

const WIDE: Unit_in_cm_T = 80.0
const HIGH: Unit_in_cm_T = 54.0

const BLOCKS: []str = ["investment", "gold", "bitcoin", "sp500", "overall"]
const BLOCK_W: []Unit_in_cm_T = [4.0, 4.0, 4.0, 4.0, 7.0]
const BLOCK_H: []Unit_in_cm_T = [6.0, 3.0, 3.0, 3.0, 14.0]

type Layout is record:
    centres: []Spot_T               # the centre of each of the BLOCKS

def new_layout() -> Layout:
    return Layout([Spot_T(90.0, 355.0), Spot_T(360.0, 120.0), Spot_T(360.0, 350.0), Spot_T(360.0, 580.0), Spot_T(740.0, 370.0)])

# Which of the BLOCKS is called NAME: its number, or -1.
def index_of(name: str) -> int:
    for i in 0 ..< len(BLOCKS):
        if BLOCKS[i] == name:
            return i
    return -1

def width_of(name: str) -> Drawing_Pixel_T:
    return Drawing_Pixel_T(BLOCK_W[index_of(name)])

def height_of(name: str) -> Drawing_Pixel_T:
    return Drawing_Pixel_T(BLOCK_H[index_of(name)])

# Where the block NAME has its top left corner.
def left_of(layout: Layout, name: str) -> Drawing_Pixel_T:
    return layout.centres[index_of(name)].x - width_of(name) / 2.0

def top_of(layout: Layout, name: str) -> Drawing_Pixel_T:
    return layout.centres[index_of(name)].y - height_of(name) / 2.0

# Move the block NAME so that its centre is at AT, kept inside the drawing. "" when it is
# done, or what was wrong.
def move_block(layout: Layout, name: str, at: Spot_T) -> str:
    let i: int = index_of(name)
    if i < 0:
        return f"There is no block {name}."
    let half_w: Drawing_Pixel_T = width_of(name) / 2.0
    let half_h: Drawing_Pixel_T = height_of(name) / 2.0
    layout.centres[i] = Spot_T(max(half_w, min(Drawing_Pixel_T(WIDE) - half_w, at.x)), max(half_h, min(Drawing_Pixel_T(HIGH) - half_h, at.y)))
    return ""
