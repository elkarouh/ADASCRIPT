#!/usr/bin/env ady2nim
"""server -- the one place that knows about HTTP; what a request does is roi_events.ady.

    make app [PORT=n]  (or: ady2nim c -r backend/server.ady [PORT])        then open http://127.0.0.1:8820/

    GET    /            the page: a script tag and a div that loads /all
    GET    /htmx.min.js htmx itself
    GET    /roi_js_events.js  roi_js_events.ady, compiled to JavaScript
    GET    /events      the changes, as they are made, for every open page (server-sent events)

Every other request (GET /all, and the commands on the investment, the shares and the blocks) is
answered by Session.answer in roi_events.ady, which lists them. A read answers the whole drawing,
which htmx swaps in; a command only whether it went through. Each change it made is published, and
`tell`, here, tells every open page, which then reads itself again.
"""
from asyncdispatch nimport complete, newFuture, Port, waitFor
from asynchttpserver nimport HttpHeaders, newHttpHeaders, Request, respond, Http200, Http404, AsyncHttpServer, newAsyncHttpServer, serve
from page_server import News, send_script, port_of
from backend/roi_gui import shell_text
from commands import Change
from backend/roi_events import Channel_T, Session

# The portfolio and its drawing, which the requests are answered from.
var session: Session = Session()

# The pages following GET /events.
var news: News = News()

# A change, told to every page that follows: subscribed to the session's channels in main.
def tell(channel: Channel_T, change: Change):
    news.tell(f"{channel} {change.kind} {change.key}")

async def handler(req: Request):
    let html_type: HttpHeaders = newHttpHeaders([("Content-Type", "text/html; charset=utf-8")])
    let path: str = req.url.path
    if path == "/":
        await req.respond(Http200, shell_text(), html_type)
    elif path == "/events":
        news.follow(req.client)             # and no end: the changes follow, from tell
    elif path in ["/htmx.min.js", "/roi_js_events.js"]:
        await send_script(req, Path("frontend"))
    else:
        let page: str = session.answer(req.reqMethod'Image, path, req.url.query + "&" + req.body)
        if page == "":
            await req.respond(Http404, "not found")
        else:
            await req.respond(Http200, page, html_type)

def main():
    let port: int = port_of($@, 8820)
    session.portfolio_channel.subscribe(tell)
    session.layout_channel.subscribe(tell)
    print f"http://127.0.0.1:{port}/ (Ctrl-C to stop)"
    var server: AsyncHttpServer = newAsyncHttpServer()
    waitFor(server.serve(Port(port), handler))

if __name__ == "__main__":
    main()
