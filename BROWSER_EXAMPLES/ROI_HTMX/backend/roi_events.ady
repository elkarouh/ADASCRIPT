#!/usr/bin/env ady2nim
"""roi_events -- what each event the page sends does, and the portfolio and layout it does it to; no HTTP.

server.ady hands every request to a Session, as a method, a path and its fields, and sends back
what comes out. The tests make a Session of their own and call answer() the same way, with no server
running. The portfolio and the layout live in the Session, in memory: they start again when the
server does.

Commands in, events out, as in DIJKSTRA_HTMX. Every request is read back into a Command, the page's
own vocabulary (roi_commands.ady): Read the portfolio, or Update the investment, a share or a block.
A read answers the whole drawing. A change answers only the paragraph #problem, empty, or saying why
not. When it went through, what it changed is published with the same verbs, on the channel of
what it changed, named by Channel_T: PORTFOLIO_CHAN (the investment, the shares) and LAYOUT_CHAN
(where the blocks are) carry a Change. Whoever must hear of it subscribes -- the server, which tells
every open page, which then reads itself again -- and the Session knows none of them:

    def heard(channel: Channel_T, change: Change):
        print channel, change.kind, change.key          # "PORTFOLIO_CHAN UPDATE gold", "LAYOUT_CHAN UPDATE overall"
    session.portfolio_channel.subscribe(heard)

Reset is a command on the whole portfolio (DELETE /all: it starts again), and what it changes is
an UPDATE with no key: everything, read it all again.
"""
from drawing import Spot_T
from blackboard import PublishChannel
from page_request import Page_Request
from backend/roi_model import Portfolio, Product_T, new_portfolio, set_share, set_year
from backend/roi_layout import Layout, new_layout, move_block
from backend/roi_gui import all_text, problem_text, name_of
from commands import READ, UPDATE, Change
from backend/roi_commands import Command, THE_INVESTMENT, A_SHARE, A_BLOCK, THE_PORTFOLIO, command_of

# The channels of the server's blackboard: the portfolio, and where its blocks are drawn.
type Channel_T is enum PORTFOLIO_CHAN, LAYOUT_CHAN

# A channel of the session's: one of Channel_T, carrying a Change.
type Change_Channel_T is PublishChannel[Channel_T, Change]

# TEXT as a number: -1 when it is not one.
def number_of(text: str) -> float:
    let n: float | !ParseFailure_T = parse_float(text)
    if n is ParseFailure_T:
        return -1.0
    return n

# The portfolio, and where its blocks are drawn.
class Session:
    var portfolio: Portfolio
    var layout: Layout
    var portfolio_channel: Change_Channel_T = Change_Channel_T(PORTFOLIO_CHAN)    # what happened to the investment or a share
    var layout_channel: Change_Channel_T = Change_Channel_T(LAYOUT_CHAN)          # to where a block is

    def __init__(self):
        self.portfolio = new_portfolio()
        self.layout = new_layout()

    # The routes, all answered by answer below, each a Command (on the wire, the verb is the method
    # and the thing the URL). The read answers the whole drawing for htmx to swap in; the others the
    # paragraph #problem (empty when the command went through).
    #
    #     GET    /all          R the drawing
    #     DELETE /all          D the portfolio and layout put back as they start
    #     PUT    /investment   U the money invested, or the year      (funds, or year)
    #     PUT    /shares       U a product's share; the others adjust (product, percentage)
    #     PUT    /blocks       U a block dragged                      (name, x, y: its centre)

    # What METHOD on PATH does, with FIELDS (the query and the body, "a=1&b=2"): what to send back,
    # or "" when there is no such thing.
    def answer(self, method: str, path: str, fields: str) -> str:
        let c: ?Command = command_of(method, path, Page_Request(method, path, fields).fields)
        if c is None:
            return ""
        if c.verb == READ:
            return all_text(self.portfolio, self.layout)
        case c.thing:
            when THE_INVESTMENT:
                return problem_text(self.change_investment(c))
            when A_SHARE:
                return problem_text(self.change_share(c))
            when A_BLOCK:
                return problem_text(self.change_block(c))
            when THE_PORTFOLIO:
                return problem_text(self.change_portfolio(c))

    # The money invested (the field funds), or the year (year): "", or why not. When it went
    # through, the field is published.
    def change_investment(self, c: Command) -> str:
        if "funds" in c.fields:
            let funds: float = number_of(c.value("funds"))
            if funds < 0.0:
                return "The money invested is a number, 0 or more."
            self.portfolio.investment.funds = funds
            self.portfolio_channel.publish(Change(UPDATE, "funds"))
            return ""
        let refused: str = set_year(self.portfolio, c.number_value("year"))
        if refused == "":
            self.portfolio_channel.publish(Change(UPDATE, "year"))
        return refused

    # The share of the product C names (product) set to its percentage; the others adjust: "", or
    # why not. When it went through, the product is published.
    def change_share(self, c: Command) -> str:
        let share: float = number_of(c.value("percentage"))
        if share < 0.0:
            return "A share is a number, 0 to 100."
        let product: str = c.value("product")
        for kind in Product_T:
            if name_of(kind) == product:
                set_share(self.portfolio, kind, min(share, 100.0))
                self.portfolio_channel.publish(Change(UPDATE, product))
                return ""
        return f"There is no product {product}."

    # The block C names (name) put with its centre at x, y: "", or why not. When it went through,
    # the block is published.
    def change_block(self, c: Command) -> str:
        let at: ?Spot_T = c.spot()
        if at is None:
            return "Where should the block go? There is no place."
        let refused: str = move_block(self.layout, c.value("name"), at)
        if refused == "":
            self.layout_channel.publish(Change(UPDATE, c.value("name")))
        return refused

    # The portfolio and the layout put back as they start (D): it cannot be refused, and what
    # changed is everything, an UPDATE with no key, for every page to read again.
    def change_portfolio(self, c: Command) -> str:
        self.portfolio = new_portfolio()            # the one change of the portfolio: DELETE (command_of)
        self.layout = new_layout()
        self.portfolio_channel.publish(Change(UPDATE, ""))
        self.layout_channel.publish(Change(UPDATE, ""))
        return ""
