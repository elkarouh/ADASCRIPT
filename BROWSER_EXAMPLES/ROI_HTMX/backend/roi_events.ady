#!/usr/bin/env ady2nim
"""roi_events -- what each event the page sends does, and the portfolio and layout it does it to; no HTTP.

server.ady hands every request here as a method, a path and its fields, and sends back the
drawing that comes out. The tests call answer() the same way, with no server running. The
portfolio and the layout live here, in memory: they start again when the server does.
"""
from backend/roi_model import Portfolio, Product_T, new_portfolio, set_share, set_year
from backend/roi_layout import Layout, move_block, new_layout
from backend/roi_gui import all_text, field_of, name_of

var portfolio: Portfolio = new_portfolio()
var layout: Layout = new_layout()

def number_of(text: str, fallback: float) -> float:
    let n: float | !ParseFailure_T = parse_float(text)
    if n is ParseFailure_T:
        return fallback
    return n

# What METHOD on PATH does, with FIELDS (the query and the body, "a=1&b=2"): the page to send
# back, or "" when there is no such thing.
#   GET /all?changed=gold&value=40   the share of gold is now 40, and the others adjust
#   GET /all?changed=funds&value=500 the money invested; likewise changed=year
#   PUT /move                        a block dragged: name, x, y (its centre)
#   POST /reset                      the starting portfolio and layout again
def answer(method: str, path: str, fields: str) -> str:
    if method == "GET" and path == "/all":
        let what: str = field_of(fields, "changed")
        let value: float = number_of(field_of(fields, "value"), -1.0)
        if value >= 0.0:
            if what == "funds":
                portfolio.investment.funds = value
            elif what == "year":
                set_year(portfolio, int(value))              # a year there are no prices for is refused: the rest stays
            else:
                for kind in Product_T:
                    if name_of(kind) == what:
                        set_share(portfolio, kind, min(value, 100.0))
    elif method == "PUT" and path == "/move":                    # name, x, y: where a block was let go
        move_block(layout, field_of(fields, "name"), number_of(field_of(fields, "x"), 0.0), number_of(field_of(fields, "y"), 0.0))
    elif method == "POST" and path == "/reset":
        portfolio = new_portfolio()
        layout = new_layout()
    else:
        return ""
    return all_text(portfolio, layout)
