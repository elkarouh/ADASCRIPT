#!/usr/bin/env ady2nim
"""roi_gui -- the page as HTML the server draws; no JointJS.

The page is one SVG: boxes (rects with a form inside, in a foreignObject) joined by arrows
(paths). The browser draws it and nothing more. A field that is changed sends its command
(roi_commands.ady), PUT /investment or PUT /shares, with its value; the answer is only the
paragraph #problem, empty, or saying why not, and the whole drawing is asked for again on the
news of the change (roi_js_events.ady), on every page.

Each box of the drawing is one thing of the model: the Investment, an InvestmentPercentage for
each product, a ProductOutcome for each product's results, and the Outcome as a whole. `to_html`
says what each looks like inside its box; where the boxes are is the Layout (roi_layout.ady).
"""
from backend/roi_model import CURRENT_YEAR, FIRST_YEAR, Investment, InvestmentPercentage, Outcome, Portfolio, Product_T, ProductOutcome, evaluate
from drawing import Drawing_Pixel_T
from svg_path import Leave_T, SIDEWAYS, VERTICAL, connector_d
from backend/roi_layout import HIGH, WIDE, Layout, height_of, left_of, top_of, width_of
from backend/roi_commands import Thing_T, Command, url, read_portfolio, update_investment, update_share
from server_page import Page_Of
from style import Look, Rule, Style

# The page: a command goes to its URL, and a change's answer takes the place of #problem.
type Page is Page_Of[Thing_T]
let page: Page = Page(url, "#problem", "")

const INVEST_COLOR: str = "#D4D9D7"
const OVERALL_COLOR: str = "#EAECEA"

# What a product is called on the page, in the URL (the name of a block too), and what colour its boxes are.
def label_of(kind: Product_T) -> str:
    case kind:
        when GOLD:
            return "Gold"
        when BITCOIN:
            return "Bitcoin"
        when others:
            return "S&P 500"

def name_of(kind: Product_T) -> str:
    let image: str = kind'Image
    return image.lower()

def color_of(kind: Product_T) -> str:
    case kind:
        when GOLD:
            return "#F7E3AE"
        when BITCOIN:
            return "#9C9EC8"
        when others:
            return "#FFCCD6"

# Where the results of each product are inside the box of the results, from its top left.
const PERF_DX: Drawing_Pixel_T = 30.0
const PERF_DY: []Drawing_Pixel_T = [50.0, 170.0, 290.0]
const PERF_W: Drawing_Pixel_T = 200.0           # and how big each is
const PERF_H: Drawing_Pixel_T = 100.0

# Where the arrows to the products leave the investment box, from its top left: out of the top
# for gold, the right side for bitcoin, the bottom for the S&P 500; the middle of the side it leaves.
def send_x(i: int) -> Drawing_Pixel_T:
    return (width_of("investment") if i == 1 else width_of("investment") / 2.0)

def send_y(i: int) -> Drawing_Pixel_T:
    return (height_of("investment") if i == 2 else (height_of("investment") / 2.0 if i == 1 else Drawing_Pixel_T(0.0)))

# A number as a person writes it: 25, not 25.0; 12.5 stays.
def plain(v: float) -> str:
    if v == float(int(v)):
        return str(int(v))
    return f"{v:.2f}"

def money(v: float) -> str:
    return f"{v:.2f}"

# How much room an arrow's head takes: the arrow stops this short of its box, where the head
# (Arrow_View.head_to_html, below) begins, so that the tip of the head is at the box.
const HEAD: Drawing_Pixel_T = 13.0

# An arrow from one block to another: a dark outline, the colour on it, and its head.
class Arrow_View:
    style "g.arrow":
        path.outline:       fill="none" stroke="#000" stroke_width=8 stroke_linejoin="round"
        path.line:          fill="none" stroke_width=4 stroke_linejoin="round"

    # The name of the head (a <marker>) for arrows of COLOR, and how an arrow refers to it.
    def head_id(self, color: str) -> str:
        return "head" + color[1:]

    def head_url(self, color: str) -> str:
        return "url(#" + self.head_id(color) + ")"

    # The arrow from the block called FROM to the block called TO. It starts at (FX, FY) from
    # FROM's top left corner and ends at (TX, TY) from TO's. The page writes those on it (data_*),
    # and how it leaves and how short it stops, for the script that redraws it while a block is
    # dragged.
    def to_html(self, layout: Layout, from_block: str, fx: Drawing_Pixel_T, fy: Drawing_Pixel_T, to_block: str, tx: Drawing_Pixel_T, ty: Drawing_Pixel_T, color: str, leave: Leave_T) -> Html:
        let d: str = connector_d(float(left_of(layout, from_block) + fx), float(top_of(layout, from_block) + fy),
                                 float(left_of(layout, to_block) + tx), float(top_of(layout, to_block) + ty), leave, float(HEAD))
        let leaves: str = ("vertical" if leave == VERTICAL else "sideways")
        html:
            g class="arrow" data_a=from_block data_ax=f"{fx:.1f}" data_ay=f"{fy:.1f}" data_b=to_block data_bx=f"{tx:.1f}" data_by=f"{ty:.1f}" data_leave=leaves data_stop=f"{HEAD:.1f}":
                path class="outline" d=d
                path class="line" d=d stroke=color marker_end=self.head_url(color)

    # The head of arrows of COLOR: the colour, outlined in black, with a notch at the back where
    # the arrow's band runs into it, as in JointJS. The arrow's line stops where it starts (HEAD long).
    def head_to_html(self, color: str) -> Html:
        html:
            marker id=self.head_id(color) viewBox="-2 -12 17 24" refX="0" refY="0" markerUnits="userSpaceOnUse" markerWidth="17" markerHeight="24" orient="auto":
                path d="M 0 4 L 0 10 L 13 0 L 0 -10 L 0 -4" fill=color stroke="#000" stroke_width="2" stroke_linejoin="round"

# A box of a block: a rectangle, with what is in it written as HTML, a form (.jj-form): its fields
# one above the other (.jj-field-vertical) or a name beside its value (.jj-field-horizontal).
class Box_View:
    style "g.box":
        rect.body:                      stroke="#333" stroke_width=2
        rect.node:                      stroke="#333" stroke_width=2 cursor="grab"
        foreignObject:                  pointer_events="none"
        .jj-form:                       position="static" font_size="14px" text_align="center" padding="10px" display="flex" flex_direction="column" box_sizing="border-box" height="100%" pointer_events="none" color="#000"
        .jj-form input:                 pointer_events="auto"
        .jj-form select:                pointer_events="auto"
        .jj-form .between:              display="flex" flex_direction="column" justify_content="space-between" height="100%"
        .jj-form h2:                    font_size="1.5em" margin="0.83em 0"
        .jj-form p:                     margin="1em 0"
        .jj-form legend.lead:           margin_bottom="10px"
        .jj-form legend:                display="block" width="100%" text_align="center" padding="0"
        .jj-field-vertical:             display="flex" flex_direction="column"
        .jj-field-vertical label:       margin_top="15px"
        .jj-field-vertical .jj-input:   margin_top="10px"
        .jj-field-horizontal label:     display="flex" align_items="center" text_align="left"
        .jj-field-horizontal span.name: width="30%" flex_shrink="0"
        .jj-field-horizontal .jj-input: width="70%" min_width="0"
        .jj-input:                      box_sizing="border-box" text_align="right" margin="5px 0" font_size="13.33px"
        .jj-field-vertical .jj-input:   width="100%"
        .jj-input-container:            display="flex" flex_direction="row" align_items="center"
        .jj-input-unit:                 flex_shrink="0" padding_left="5px" text_align="right"

    # The box at (LEFT, TOP), W by H, filled with COLOR, with INSIDE in it. It belongs to the block
    # called BLOCK, and moves with it. A box that is a block of its own, GRIP, is what the script
    # lets the mouse take hold of (its rectangle and nothing else, so the fields in it can still be
    # clicked).
    def to_html(self, block: str, left: Drawing_Pixel_T, top: Drawing_Pixel_T, w: Drawing_Pixel_T, h: Drawing_Pixel_T, color: str, inside: Html, grip: bool) -> Html:
        let css: str = ("node" if grip else "body")
        html:
            g class="box":
                rect class=css x=f"{left:.1f}" y=f"{top:.1f}" rx="10" ry="10" width=f"{w:.1f}" height=f"{h:.1f}" fill=color data_block=block data_name=block data_x=f"{left+w/2.0:.1f}" data_y=f"{top+h/2.0:.1f}"
                foreignObject x=f"{left:.1f}" y=f"{top:.1f}" width=f"{w:.1f}" height=f"{h:.1f}" data_block=block:
                    div class="jj-form":
                        + inside

# The boxes and the arrows of the drawing, as every page draws them.
let boxes: Box_View = Box_View()
let arrows: Arrow_View = Arrow_View()

# The fields of the boxes, bare: what each sends when it is changed is said where it is drawn.

def funds_field(investment: Investment) -> Html:
    html:
        input class="jj-input" type="number" name="funds" value=plain(investment.funds) min="0"

def year_field(investment: Investment, years: []int) -> Html:
    html:
        select class="jj-input" name="year":
            for y in years:
                if y == investment.year:
                    option value=str(y) selected="selected": str(y)
                else:
                    option value=str(y): str(y)

def percentage_field(share: InvestmentPercentage) -> Html:
    html:
        input class="jj-input" type="number" name="percentage" value=plain(share.percentage) min="0" max="100" step="1"

# What the Investment looks like inside its box: the money, and the year it was put in.
def to_html(investment: Investment) -> Html:
    var years: []int = []
    var year: int = FIRST_YEAR
    while year <= CURRENT_YEAR:
        years.append(year)
        year += 1
    html:
        div:
            h2: "Investment"
            div class="jj-field-vertical":
                label:
                    "How much did you invest?"
                    + page.on_change(update_investment(), funds_field(investment))
            div class="jj-field-vertical":
                label:
                    "What year it was?"
                    + page.on_change(update_investment(), year_field(investment, years))

# What an InvestmentPercentage looks like inside its box: the question, and the field.
def to_html(share: InvestmentPercentage) -> Html:
    html:
        div class="jj-field-vertical":
            label:
                "What % did you invest in "
                strong: label_of(share.kind)
                "?"
                span class="jj-input-container":
                    + page.on_change(update_share(name_of(share.kind)), percentage_field(share))
                    span class="jj-input-unit": "%"

# A line of a results box: what it is, and its value, which cannot be edited.
def line_html(name: str, value: float) -> Html:
    html:
        div class="jj-field-horizontal":
            label:
                span class="name": name
                input class="jj-input" type="text" readonly="readonly" value=money(value)

# What a ProductOutcome looks like inside its box: the product, its value and its ROI.
def to_html(outcome: ProductOutcome) -> Html:
    html:
        fieldset:
            legend:
                strong: label_of(outcome.kind)
            + line_html("Value", outcome.performance.value)
            + line_html("ROI", outcome.performance.roi)

# What the Outcome looks like inside the box of the results: the year, and the performance of the whole.
def to_html(outcome: Outcome) -> Html:
    html:
        div class="between":
            p:
                "This is your portfolio now in "
                strong: str(CURRENT_YEAR)
                "."
            fieldset:
                legend class="lead": "Your overall performance of investment is:"
                + line_html("Value", outcome.overall_performance.value)
                + line_html("ROI", outcome.overall_performance.roi)

# The paragraph #problem: why the change was refused (PROBLEM), or empty when it went through.
def problem_html(problem: str) -> Html:
    html:
        p id="problem" class="problem": problem

def problem_text(problem: str) -> str:
    return str(problem_html(problem))

def all_html(portfolio: Portfolio, layout: Layout) -> Html:
    let outcome: Outcome = evaluate(portfolio)
    let box: str = f"0 0 {Drawing_Pixel_T(WIDE):.0f} {Drawing_Pixel_T(HIGH):.0f}"
    html:
        div id="all":
            + problem_html("")
            svg viewBox=box width=f"{Drawing_Pixel_T(WIDE):.0f}" height=f"{Drawing_Pixel_T(HIGH):.0f}" class="drawing":
                defs:
                    + arrows.head_to_html(INVEST_COLOR)
                    for share in portfolio.shares:
                        + arrows.head_to_html(color_of(share.kind))
                + boxes.to_html("investment", left_of(layout, "investment"), top_of(layout, "investment"), width_of("investment"), height_of("investment"), INVEST_COLOR, to_html(portfolio.investment), True)
                for share in portfolio.shares:
                    + boxes.to_html(name_of(share.kind), left_of(layout, name_of(share.kind)), top_of(layout, name_of(share.kind)), width_of(name_of(share.kind)), height_of(name_of(share.kind)), color_of(share.kind), to_html(share), True)
                + boxes.to_html("overall", left_of(layout, "overall"), top_of(layout, "overall"), width_of("overall"), height_of("overall"), OVERALL_COLOR, to_html(outcome), True)
                for i in 0 ..< len(outcome.list_of_outcomes):
                    + boxes.to_html("overall", left_of(layout, "overall") + PERF_DX, top_of(layout, "overall") + PERF_DY[i], PERF_W, PERF_H, INVEST_COLOR, to_html(outcome.list_of_outcomes[i]), False)
                for i in 0 ..< len(outcome.list_of_outcomes):
                    + arrows.to_html(layout, "investment", send_x(i), send_y(i), name_of(outcome.list_of_outcomes[i].kind), Drawing_Pixel_T(0.0), height_of(name_of(outcome.list_of_outcomes[i].kind)) / 2.0, INVEST_COLOR, (VERTICAL if i != 1 else SIDEWAYS))
                    + arrows.to_html(layout, name_of(outcome.list_of_outcomes[i].kind), width_of(name_of(outcome.list_of_outcomes[i].kind)), height_of(name_of(outcome.list_of_outcomes[i].kind)) / 2.0, "overall", PERF_DX, PERF_DY[i] + PERF_H / 2.0, color_of(outcome.list_of_outcomes[i].kind), SIDEWAYS)

# The page's own look (the boxes, with their forms, and the arrows have their own, in their classes
# above).
class Page_View:
    style "":
        *:                  font_family="sans-serif"
        body:               margin="0" padding="0" background_color="#f6f4f4"
        svg.drawing:        display="block" user_select="none"
        p.problem:          position="fixed" top="0.5em" left="0.5em" margin="0" color="#b71c1c" background="#fdecea" border_radius="6px" padding="0.4em 0.7em"
        p.problem:empty:    display="none"
        fieldset:           border="none" margin="0" padding="0"
        input:invalid:      background_color="ivory" border="2px solid lightgray" outline="2px solid red"

    # The rules of the page and of its drawing, for its <style>.
    def css(self) -> str:
        return self.style.css() + boxes.style.css() + arrows.style.css()

let page_view: Page_View = Page_View()

def shell_text() -> str:
    return page.shell_text("Return of investment", page_view.css(), ["roi_js_events.js"], [], read_portfolio())

def all_text(portfolio: Portfolio, layout: Layout) -> str:
    return str(all_html(portfolio, layout))
