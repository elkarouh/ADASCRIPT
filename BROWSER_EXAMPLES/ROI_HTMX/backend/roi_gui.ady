#!/usr/bin/env ady2nim
"""roi_gui -- the page as HTML the server draws, for htmx to swap in; no JointJS.

The page is one SVG: boxes (rects with a form inside, in a foreignObject) joined by arrows
(paths). The browser draws it and nothing more. A field that is changed sends its command
(roi_commands.ady), PUT /investment or PUT /shares, with its value; the answer is only the
paragraph #problem, empty, or saying why not, and the whole drawing is asked for again on the
news of the change (roi_js_events.ady), on every page.

Each box of the drawing is one thing of the model: the Investment, an InvestmentPercentage for
each product, a ProductOutcome for each product's results, and the Outcome as a whole. `to_html`
says what each looks like inside its box; where the boxes are is the Layout (roi_layout.ady).
"""
from backend/roi_model import CURRENT_YEAR, FIRST_YEAR, Investment, InvestmentPercentage, Outcome, Portfolio, Product_T, ProductOutcome, evaluate
from drawing import Drawing_Pixel_T
from svg_path import Leave_T, SIDEWAYS, VERTICAL, connector_d
from backend/roi_layout import HIGH, WIDE, Layout, height_of, left_of, top_of, width_of
from backend/roi_commands import Command, method, url, update_investment, update_share

const INVEST_COLOR: str = "#D4D9D7"
const OVERALL_COLOR: str = "#EAECEA"

# What a product is called on the page, in the URL (the name of a block too), and what colour its boxes are.
def label_of(kind: Product_T) -> str:
    case kind:
        when GOLD:
            return "Gold"
        when BITCOIN:
            return "Bitcoin"
        when others:
            return "S&P 500"

def name_of(kind: Product_T) -> str:
    let image: str = kind'Image
    return image.lower()

def color_of(kind: Product_T) -> str:
    case kind:
        when GOLD:
            return "#F7E3AE"
        when BITCOIN:
            return "#9C9EC8"
        when others:
            return "#FFCCD6"

# Where the results of each product are inside the box of the results, from its top left.
const PERF_DX: Drawing_Pixel_T = 30.0
const PERF_DY: []Drawing_Pixel_T = [50.0, 170.0, 290.0]
const PERF_W: Drawing_Pixel_T = 200.0           # and how big each is
const PERF_H: Drawing_Pixel_T = 100.0

# Where the arrows to the products leave the investment box, from its top left: out of the top
# for gold, the right side for bitcoin, the bottom for the S&P 500; the middle of the side it leaves.
def send_x(i: int) -> Drawing_Pixel_T:
    return (width_of("investment") if i == 1 else width_of("investment") / 2.0)

def send_y(i: int) -> Drawing_Pixel_T:
    return (height_of("investment") if i == 2 else (height_of("investment") / 2.0 if i == 1 else Drawing_Pixel_T(0.0)))

# A number as a person writes it: 25, not 25.0; 12.5 stays.
def plain(v: float) -> str:
    if v == float(int(v)):
        return str(int(v))
    return f"{v:.2f}"

def money(v: float) -> str:
    return f"{v:.2f}"

# How much room an arrow's head takes: the arrow stops this short of its box, where the head
# (head_html, below) begins, so that the tip of the head is at the box.
const HEAD: Drawing_Pixel_T = 13.0

# The name of the head (a <marker>) for arrows of COLOR, and how an arrow refers to it.
def head_id(color: str) -> str:
    return "head" + color[1:]

def head_url(color: str) -> str:
    return "url(#" + head_id(color) + ")"

# The arrow from the block called FROM to the block called TO: a dark outline, the colour on it,
# and the head. It starts at (FX, FY) from FROM's top left corner and ends at (TX, TY) from TO's.
# The page writes those on it (data_*), and how it leaves and how short it stops, for the script
# that redraws it while a block is dragged.
def arrow_html(layout: Layout, from_block: str, fx: Drawing_Pixel_T, fy: Drawing_Pixel_T, to_block: str, tx: Drawing_Pixel_T, ty: Drawing_Pixel_T, color: str, leave: Leave_T) -> Html:
    let d: str = connector_d(float(left_of(layout, from_block) + fx), float(top_of(layout, from_block) + fy),
                             float(left_of(layout, to_block) + tx), float(top_of(layout, to_block) + ty), leave, float(HEAD))
    let leaves: str = ("vertical" if leave == VERTICAL else "sideways")
    html:
        g class="arrow" data_a=from_block data_ax=f"{fx:.1f}" data_ay=f"{fy:.1f}" data_b=to_block data_bx=f"{tx:.1f}" data_by=f"{ty:.1f}" data_leave=leaves data_stop=f"{HEAD:.1f}":
            path class="outline" d=d
            path class="line" d=d stroke=color marker_end=head_url(color)

# A box at (X, Y), W by H, filled with COLOR, with what is in it written as HTML. It belongs
# to the block called BLOCK, and moves with it. A box that is a block of its own, FOR_DRAG,
# is the grip: the script lets the mouse take hold of its rectangle and nothing else, so the
# fields in it can still be clicked.
def box_html(block: str, x: Drawing_Pixel_T, y: Drawing_Pixel_T, w: Drawing_Pixel_T, h: Drawing_Pixel_T, color: str, inside: Html, grip: bool) -> Html:
    let css: str = ("node" if grip else "body")
    html:
        g class="box":
            rect class=css x=f"{x:.1f}" y=f"{y:.1f}" rx="10" ry="10" width=f"{w:.1f}" height=f"{h:.1f}" fill=color data_block=block data_name=block data_x=f"{x+w/2.0:.1f}" data_y=f"{y+h/2.0:.1f}"
            foreignObject x=f"{x:.1f}" y=f"{y:.1f}" width=f"{w:.1f}" height=f"{h:.1f}" data_block=block:
                div class="jj-form":
                    + inside

# What a field that is changed sends with its own value: the fields of its command C, as hx-vals.
def vals_of(c: Command) -> str:
    var pairs: []str = []
    for name, value in c.fields.items():
        pairs.append(f'"{name}": "{value}"')
    return "{" + ", ".join(pairs) + "}"

# What the Investment looks like inside its box: the money, and the year it was put in.
def to_html(investment: Investment) -> Html:
    var years: []int = []
    var year: int = FIRST_YEAR
    while year <= CURRENT_YEAR:
        years.append(year)
        year += 1
    html:
        div:
            h2: "Investment"
            div class="jj-field-vertical":
                label:
                    "How much did you invest?"
                    input class="jj-input" type="number" name="funds" value=plain(investment.funds) min="0" data_hx_put=update_investment().url() data_hx_trigger="change" data_hx_target="#problem" data_hx_swap="outerHTML"
            div class="jj-field-vertical":
                label:
                    "What year it was?"
                    select class="jj-input" name="year" data_hx_put=update_investment().url() data_hx_trigger="change" data_hx_target="#problem" data_hx_swap="outerHTML":
                        for y in years:
                            if y == investment.year:
                                option value=str(y) selected="selected": str(y)
                            else:
                                option value=str(y): str(y)

# What an InvestmentPercentage looks like inside its box: the question, and the field.
def to_html(share: InvestmentPercentage) -> Html:
    html:
        div class="jj-field-vertical":
            label:
                "What % did you invest in "
                strong: label_of(share.kind)
                "?"
                span class="jj-input-container":
                    input class="jj-input" type="number" name="percentage" value=plain(share.percentage) min="0" max="100" step="1" data_hx_put=update_share(name_of(share.kind)).url() data_hx_trigger="change" data_hx_vals=vals_of(update_share(name_of(share.kind))) data_hx_target="#problem" data_hx_swap="outerHTML"
                    span class="jj-input-unit": "%"

# A line of a results box: what it is, and its value, which cannot be edited.
def line_html(name: str, value: float) -> Html:
    html:
        div class="jj-field-horizontal":
            label:
                span class="name": name
                input class="jj-input" type="text" readonly="readonly" value=money(value)

# What a ProductOutcome looks like inside its box: the product, its value and its ROI.
def to_html(outcome: ProductOutcome) -> Html:
    html:
        fieldset:
            legend:
                strong: label_of(outcome.kind)
            + line_html("Value", outcome.performance.value)
            + line_html("ROI", outcome.performance.roi)

# What the Outcome looks like inside the box of the results: the year, and the performance of the whole.
def to_html(outcome: Outcome) -> Html:
    html:
        div class="between":
            p:
                "This is your portfolio now in "
                strong: str(CURRENT_YEAR)
                "."
            fieldset:
                legend class="lead": "Your overall performance of investment is:"
                + line_html("Value", outcome.overall_performance.value)
                + line_html("ROI", outcome.overall_performance.roi)

# The head of an arrow of COLOR: the colour, outlined in black, with a notch at the back where
# the arrow's band runs into it, as in JointJS. The arrow's line stops where it starts (HEAD long).
def head_html(color: str) -> Html:
    html:
        marker id=head_id(color) viewBox="-2 -12 17 24" refX="0" refY="0" markerUnits="userSpaceOnUse" markerWidth="17" markerHeight="24" orient="auto":
            path d="M 0 4 L 0 10 L 13 0 L 0 -10 L 0 -4" fill=color stroke="#000" stroke_width="2" stroke_linejoin="round"

# The paragraph #problem: why the change was refused (PROBLEM), or empty when it went through.
def problem_html(problem: str) -> Html:
    html:
        p id="problem" class="problem": problem

def problem_text(problem: str) -> str:
    return str(problem_html(problem))

def all_html(portfolio: Portfolio, layout: Layout) -> Html:
    let outcome: Outcome = evaluate(portfolio)
    let box: str = f"0 0 {Drawing_Pixel_T(WIDE):.0f} {Drawing_Pixel_T(HIGH):.0f}"
    html:
        div id="all":
            + problem_html("")
            svg viewBox=box width=f"{Drawing_Pixel_T(WIDE):.0f}" height=f"{Drawing_Pixel_T(HIGH):.0f}" class="drawing":
                defs:
                    + head_html(INVEST_COLOR)
                    for share in portfolio.shares:
                        + head_html(color_of(share.kind))
                + box_html("investment", left_of(layout, "investment"), top_of(layout, "investment"), width_of("investment"), height_of("investment"), INVEST_COLOR, to_html(portfolio.investment), True)
                for share in portfolio.shares:
                    + box_html(name_of(share.kind), left_of(layout, name_of(share.kind)), top_of(layout, name_of(share.kind)), width_of(name_of(share.kind)), height_of(name_of(share.kind)), color_of(share.kind), to_html(share), True)
                + box_html("overall", left_of(layout, "overall"), top_of(layout, "overall"), width_of("overall"), height_of("overall"), OVERALL_COLOR, to_html(outcome), True)
                for i in 0 ..< len(outcome.list_of_outcomes):
                    + box_html("overall", left_of(layout, "overall") + PERF_DX, top_of(layout, "overall") + PERF_DY[i], PERF_W, PERF_H, INVEST_COLOR, to_html(outcome.list_of_outcomes[i]), False)
                for i in 0 ..< len(outcome.list_of_outcomes):
                    + arrow_html(layout, "investment", send_x(i), send_y(i), name_of(outcome.list_of_outcomes[i].kind), Drawing_Pixel_T(0.0), height_of(name_of(outcome.list_of_outcomes[i].kind)) / 2.0, INVEST_COLOR, (VERTICAL if i != 1 else SIDEWAYS))
                    + arrow_html(layout, name_of(outcome.list_of_outcomes[i].kind), width_of(name_of(outcome.list_of_outcomes[i].kind)), height_of(name_of(outcome.list_of_outcomes[i].kind)) / 2.0, "overall", PERF_DX, PERF_DY[i] + PERF_H / 2.0, color_of(outcome.list_of_outcomes[i].kind), SIDEWAYS)

const STYLE: str = """
* { font-family: sans-serif; }
body { margin: 0; padding: 0; background-color: #f6f4f4; }
svg.drawing { display: block; user-select: none; }
p.problem { position: fixed; top: 0.5em; left: 0.5em; margin: 0; color: #b71c1c; background: #fdecea; border-radius: 6px; padding: 0.4em 0.7em; }
p.problem:empty { display: none; }
rect.body, rect.node { stroke: #333; stroke-width: 2; }
rect.node { cursor: grab; }
foreignObject { pointer-events: none; }
path.outline { fill: none; stroke: #000; stroke-width: 8; stroke-linejoin: round; }
path.line { fill: none; stroke-width: 4; stroke-linejoin: round; }
fieldset { border: none; margin: 0; padding: 0; }
input:invalid { background-color: ivory; border: 2px solid lightgray; outline: 2px solid red; }
.jj-form { position: static; font-size: 14px; text-align: center; padding: 10px; display: flex; flex-direction: column;
           box-sizing: border-box; height: 100%; pointer-events: none; color: #000; }
.jj-form input, .jj-form select { pointer-events: auto; }
.jj-form .between { display: flex; flex-direction: column; justify-content: space-between; height: 100%; }
.jj-form h2 { font-size: 1.5em; margin: 0.83em 0; }
.jj-form p { margin: 1em 0; }
.jj-form legend.lead { margin-bottom: 10px; }
.jj-form legend { display: block; width: 100%; text-align: center; padding: 0; }
.jj-field-vertical { display: flex; flex-direction: column; }
.jj-field-vertical label { margin-top: 15px; }
.jj-field-vertical .jj-input { margin-top: 10px; }
.jj-field-horizontal label { display: flex; align-items: center; text-align: left; }
.jj-field-horizontal span.name { width: 30%; flex-shrink: 0; }
.jj-field-horizontal .jj-input { width: 70%; min-width: 0; }
.jj-input { box-sizing: border-box; text-align: right; margin: 5px 0; font-size: 13.33px; }
.jj-field-vertical .jj-input { width: 100%; }
.jj-input-container { display: flex; flex-direction: row; align-items: center; }
.jj-input-unit { flex-shrink: 0; padding-left: 5px; text-align: right; }
"""

def shell() -> Html:
    html:
        html lang="en":
            head:
                meta charset="utf-8"
                title: "Return of investment"
                style: STYLE
                script src="/htmx.min.js"
                script src="/roi_js_events.js"
            body:
                div id="all" data_hx_get="/all" data_hx_trigger="load": "Loading..."

def shell_text() -> str:
    return "<!doctype html>" + str(shell())

def all_text(portfolio: Portfolio, layout: Layout) -> str:
    return str(all_html(portfolio, layout))
