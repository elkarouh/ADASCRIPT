#!/usr/bin/env ady2nim
"""The model, the page and the requests, with no server running: ady2nim c -r test_roi.ady"""
from backend/roi_model import GOLD, BITCOIN, SP500, Outcome, Portfolio, evaluate, new_portfolio, set_share, set_year
from drawing import Spot_T
from backend/roi_layout import Layout, move_block, new_layout
from backend/roi_events import Channel_T, Change, Session
from backend/roi_gui import shell_text

# ---- the model ----
var p: Portfolio = new_portfolio()
let r: Outcome = evaluate(p)
let gold: float = r.list_of_outcomes[0].performance.value
assert abs(gold - 100.0 * 0.25 * 1824.16 / 1312.80) < 0.0001                 # gold, bought in 2018
let total: float = r.list_of_outcomes[0].performance.value + r.list_of_outcomes[1].performance.value + r.list_of_outcomes[2].performance.value
assert abs(r.overall_performance.value - total) < 0.0001
assert abs(r.overall_performance.roi - (total - 100.0)) < 0.0001             # the whole is 100, so ROI is the gain in %

def shares_of(portfolio: Portfolio) -> []float:
    return [portfolio.shares[0].percentage, portfolio.shares[1].percentage, portfolio.shares[2].percentage]

set_share(p, GOLD, 40.0)                                                    # gold up by 15: gold takes it from bitcoin first
assert shares_of(p) == [40.0, 10.0, 25.0]
set_share(p, GOLD, 70.0)                                                    # up by 30: bitcoin gives 10 and stops at 0, S&P 500 gives the rest
assert shares_of(p) == [70.0, 0.0, 5.0]
set_share(p, SP500, 0.0)                                                    # S&P 500 down by 5: the first product takes it
assert shares_of(p) == [75.0, 0.0, 0.0]
assert set_year(p, 2020) == "" and p.investment.year == 2020
assert set_year(p, 1999) != "" and p.investment.year == 2020                # no prices for 1999: refused, nothing changed

# ---- the layout: where the boxes are, which the model knows nothing of ----
var l: Layout = new_layout()
assert move_block(l, "gold", Spot_T(300.0, 200.0)) == "" and l.centres[1].x == 300.0 and l.centres[1].y == 200.0
assert move_block(l, "gold", Spot_T(-50.0, 9999.0)) == ""
assert abs(float(l.centres[1].x) - 75.59) < 0.01 and abs(float(l.centres[1].y) - 1984.25) < 0.01     # kept inside the drawing, whole
assert move_block(l, "nothing", Spot_T(1.0, 1.0)) != ""

# ---- the page, through the requests the server answers ----
var session: Session = Session()
var heard: []str = []
def hear(channel: Channel_T, change: Change):
    heard.append(f"{channel} {change.kind} {change.key}")
session.portfolio_channel.subscribe(hear)
session.layout_channel.subscribe(hear)

let first: str = session.answer("GET", "/all", "")
assert "<svg" in first and "Investment" in first and "S&amp;P 500" in first
assert "data-hx-put=\"/shares\"" in first and "data-hx-put=\"/investment\"" in first     # the fields send themselves
assert "What % did you invest in <strong>" in first                          # bare text beside a tag
assert "value=\"2018\" selected" in first or "selected=\"selected\" value=\"2018\"" in first
assert "font-family: sans-serif" in shell_text() and "&quot;" not in shell_text()   # the CSS as written
assert "34.74" in first                                                     # gold's value in the sample

# A change answers only #problem, empty when it went through, and is published.
let done: str = session.answer("PUT", "/shares", "product=gold&percentage=40")
assert "id=\"problem\"" in done and "<svg" not in done and "</p>" in done
assert heard == ["PORTFOLIO_CHAN UPDATE gold"]
assert "value=\"40\"" in session.answer("GET", "/all", "")
assert "value=\"10\"" in session.answer("GET", "/all", "")                    # bitcoin gave 15
session.answer("PUT", "/investment", "funds=500")
assert "value=\"500\"" in session.answer("GET", "/all", "")
session.answer("PUT", "/investment", "year=2020")
assert "2020\" selected" in session.answer("GET", "/all", "") or "selected=\"selected\" value=\"2020\"" in session.answer("GET", "/all", "")
assert "There are no prices for 1999" in session.answer("PUT", "/investment", "year=1999")   # refused, and said why
assert "is a number" in session.answer("PUT", "/investment", "funds=lots")
assert "There is no product" in session.answer("PUT", "/shares", "product=tulips&percentage=5")
assert heard == ["PORTFOLIO_CHAN UPDATE gold", "PORTFOLIO_CHAN UPDATE funds", "PORTFOLIO_CHAN UPDATE year"]   # nothing for a refusal
assert "data-a=\"investment\"" in first                       # the arrows say what they join
assert "data-name=\"gold\"" in first and "data-x=\"360.0\"" in first                                    # a block says where its centre is
session.answer("PUT", "/blocks", "name=gold&x=200&y=300")                                                    # a drop moves it
assert "data-x=\"200.0\"" in session.answer("GET", "/all", "") and "data-y=\"300.0\"" in session.answer("GET", "/all", "")
assert heard[len(heard) - 1] == "LAYOUT_CHAN UPDATE gold"
session.answer("POST", "/reset", "")
assert "data-x=\"360.0\"" in session.answer("GET", "/all", "") and "value=\"25\"" in session.answer("GET", "/all", "")
assert heard[len(heard) - 2:] == ["PORTFOLIO_CHAN UPDATE ", "LAYOUT_CHAN UPDATE "]
assert session.answer("GET", "/nowhere", "") == ""
assert session.answer("GET", "/shares", "") == ""                               # a share is not read
print "ok"
