#!/usr/bin/env ady2nim
#ady2nim-args js
"""dijkstra_js_events -- the drawing's own behaviour, in the browser: what a diagram editor does.

Every other event is declared in the HTML (hx-* attributes, dijkstra_gui.ady) and handled
on the server (dijkstra_events_gui.ady); only what must follow the mouse, select, or ask the
reader a question is here. The gestures, the usual ones of a diagram:

    click a node                 chooses the route: the start, then the goal
    click an edge                selects it (it is outlined); the space deselects
    drag a node                  moves it; its edges follow, and where it is let go is kept
    drag from a node's dot       draws a wire to another node: the edge, after its cost is asked
    double-click the space       a new node there (asks the name)
    double-click an edge         its cost (asks it)
    right-click                  a menu of what can be done to what was clicked
    Delete, Backspace            removes the selection (asks first)
    Escape                       closes the menu

A change the server must keep is sent to it as a request, with the form #state, and the page the
server answers with takes the place of #all (see dijkstra_gui.ady).

The nodes and edges here are the model's own (backend/dijkstra_model.ady), with the places the
reader put them, and where a node without one is drawn is the layout's (backend/dijkstra_layout.ady):
the same modules the server draws the page with. The page carries the network as the server keeps it
(pre#network); Network(text) builds the model from that, and the layout works out where everything goes,
never from where the page happens to draw it.

Who holds what, in this file (each class keeps one thing):
    NodeView      one node as the page draws it: its circle and name, how it is chosen, moved and deleted
    EdgeView      one edge as the page draws it: its line, its cost, how it is redrawn, changed or deleted
    Drawing       every NodeView and EdgeView the page draws, by name (the page's objects, not the model's)
    NetworkView   the model (network) and the Drawing of it (drawing); the one `network`, rebuilt when htmx draws the page
    Selection     the node or edge clicked last; the one `selection`
    Menus         the right-click menus; the one `menus`
    Wire          the wire dragged from a node's dot to make an edge; the one `wire`

The drag itself is the standard library's svg_drag; the page (finding elements, forms, menus,
questions, keys) its browser module, both in TO_NIM/STDLIB. This file says only what each
gesture means in this app.
"""
from browser import Element_T, Event_T, Click_T, request, click_of, page, find, all, data, text, fill, press, on, left, made_by_reader, stop, cancel, ask, ask_yes, key_of, show_at, attr, set_attr, has_class, number, listen, listen_first
from drawing import Unit_in_pixel_T, Spot_T
from svg_drag import Hooks_T, spot_at, clamp, shift, draw_line, place_at, no_click_cb, draggable
from backend/dijkstra_model import Network, Node_T, Edge_T
from backend/dijkstra_layout import WIDTH, COST_DY, inside, place_of


# ---- The model's values, read off the drawing, and the drawing's values as the model's ----

# The node a <g class="node"> draws: its name. Where it is drawn is not the model's.
def node_of(el: Element_T) -> Node_T:
    return Node_T(el.data("name"))

# The edge a <g data_from data_to data_cost> draws.
def edge_of(el: Element_T) -> Edge_T:
    return Edge_T(el.data("from"), el.data("to"), int(el.number("data_cost")))

# Where the node NAME of NETWORK is drawn, as a spot: where the reader put it, else the layout's place.
def spot_of_network(network: Network, name: str) -> Spot_T:
    return place_of(network, name)

# Outline the element EL, or take the outline off it.
def set_selected(el: Element_T, lit: bool):
    let cls: str = el.attr("class")
    if lit:
        el.set_attr("class", cls + " selected")
    else:
        el.set_attr("class", cls.replace(" selected", ""))

# Send a change: METHOD to URL with FIELDS, and the reader's choice (the form #state). The page the
# server answers with takes the place of #all.
def send_gesture(method: str, url: str, fields: {str}str):
    request(method, url, fields, "#all", "#state")

# ---- The drawing's objects: each node and edge keeps its own drawn parts ----
#
# A NodeView is a node as the page draws it: its Node_T and its element. An EdgeView is an edge
# as the page draws it: its Edge_T and its element. They draw what the network tells them; they
# never decide where anything is.
#
# An edge is <g data_from="A" data_to="B"> holding <path>s (the line, and the wider one to
# point at) and a <text class="cost">.

class NodeView:
    var node: Node_T
    var el: Element_T

    def __init__(self, node: Node_T, el: Element_T):
        self.node = node
        self.el = el

    # Choose this node for the route: the start, then the goal; or, with UNPICK, take it out again.
    def choose(self, unpick: bool):
        send_gesture("GET", "/all", {"pick": self.node.name, "act": ("unpick" if unpick else "")})

    # Let it go at AT: its name and new centre are sent.
    def drop_at(self, at: Spot_T):
        send_gesture("PUT", "/nodes", {"name": self.node.name, "x": f"{at.x:.0f}", "y": f"{at.y:.0f}"})

    # Ask whether to delete this node and its edges, and if so send it.
    def delete(self):
        if ask_yes(f"Delete the node {self.node.name} and its edges?"):
            send_gesture("DELETE", "/nodes", {"name": self.node.name})

class EdgeView:
    var edge: Edge_T
    var el: Element_T

    def __init__(self, edge: Edge_T, el: Element_T):
        self.edge = edge
        self.el = el

    # Ask whether to delete this edge, and if so send it.
    def delete(self):
        if ask_yes(f"Delete the edge {self.edge.a} — {self.edge.b}?"):
            send_gesture("DELETE", "/edges", {"a": self.edge.a, "b": self.edge.b})

    # Ask the cost of this edge, and send it.
    def change_cost(self):
        let cost: str = ask(f"Cost of the edge {self.edge.a} — {self.edge.b}?", str(self.edge.cost))
        if cost == "":
            return
        send_gesture("PUT", "/edges", {"a": self.edge.a, "b": self.edge.b, "cost": cost})

    # Draw the edge again, from A to B: its lines, and its cost just above the middle.
    def redraw(self, a: Spot_T, b: Spot_T):
        for line in self.el.all("path"):
            line.draw_line(a, b)
        self.el.element("text.cost").place_at(Spot_T(x=(a.x + b.x) / 2.0, y=(a.y + b.y) / 2.0 - COST_DY))

# The page's own objects, by name: the node and edge views the page draws, each found on the page.
# A node or edge the model has but the page does not draw is left out, so no view is ever missing.
class Drawing:
    var nodes: {str}NodeView            # by name
    var edges: {str}EdgeView            # by "A-B", the ends as the model names them
    var edge_list: []EdgeView

    def __init__(self, network: Network):
        self.nodes = {:}
        self.edges = {:}
        self.edge_list = []
        for n in network.nodes:
            let el: ?Element_T = page.find(f"g.node[data_name=\"{n.name}\"]")
            if el is not None:
                self.nodes[n.name] = NodeView(n, el)
        for e in network.edges:
            let el: ?Element_T = page.find(f"g[data_from=\"{e.a}\"][data_to=\"{e.b}\"]")
            if el is not None:
                let view: EdgeView = EdgeView(e, el)
                self.edges[f"{e.a}-{e.b}"] = view
                self.edge_list.append(view)

    # The view of the node drawn as EL, or none when the page does not draw it.
    def node_at(self, el: Element_T) -> ?NodeView:
        let name: str = node_of(el).name
        if name in self.nodes:
            return self.nodes[name]
        return None

    # The view of the edge drawn as EL, or none when the page does not draw it.
    def edge_at(self, el: Element_T) -> ?EdgeView:
        let e: Edge_T = edge_of(el)
        let key: str = f"{e.a}-{e.b}"
        if key in self.edges:
            return self.edges[key]
        return None

    # Draw again each edge that ends at NAME, where NETWORK puts the two ends.
    def redraw_edges(self, name: str, network: Network):
        for e in self.edge_list:
            if e.edge.a == name or e.edge.b == name:
                e.redraw(spot_of_network(network, e.edge.a), spot_of_network(network, e.edge.b))

# The text the server keeps the network in, as the page carries it: its node, edge and "at" lines
# (see dijkstra_gui.ady). Before htmx has drawn the page there is none: an empty network.
def kept_text() -> str:
    let kept: ?Element_T = page.find("pre#network")
    if kept is None:
        return ""
    return kept.text()

# The network as the page holds it: the model, its places included, built from the kept text, and
# what the page draws of it. Moving a node changes the model, then draws again what that moves.
class NetworkView:
    var network: Network                # the model, as the server keeps it
    var drawing: Drawing                # what the page draws of it

    def __init__(self):
        self.network = Network(kept_text())
        self.drawing = Drawing(self.network)

    # Where the node NAME is drawn.
    def spot_of(self, name: str) -> Spot_T:
        return spot_of_network(self.network, name)

var network: NetworkView = NetworkView()     # the page is read again each time htmx draws it (page_drawn)

# While NODE is dragged: it goes where the mouse takes it, kept inside the drawing, and its
# edges follow.
def moved_cb(node: Element_T, centre: Spot_T, wanted: Spot_T) -> Spot_T:
    let now: Spot_T = inside(wanted)
    shift(node, centre, now)
    let name: str = node_of(node).name
    network.network.put(name, now)        # the model keeps the place
    network.drawing.redraw_edges(name, network.network)  # and the edges that end at it are drawn again
    return now

# NODE let go at AT: tell the server, the way a form is sent. The hidden form #move gets the
# node's name and new centre, and its button #redraw sends it (hx-put="/nodes", see
# dijkstra_gui.ady); htmx puts the page the server answers with in place of this one.
def dropped_cb(node: Element_T, at: Spot_T):
    let view: ?NodeView = network.drawing.node_at(node)
    if view is not None:
        view.drop_at(at)

# ---- The selection: the node or edge the reader last clicked ----

# The reader's selection: what it holds, and what the gestures do with it.
class Selection:
    # the node's view or the edge's view the reader clicked last; None when nothing is selected
    var what: NodeView | EdgeView | None

    def __init__(self):
        self.what = None

    # Take the outline off everything selected, and forget it.
    def clear(self):
        for el in page.all(".selected"):
            set_selected(el, false)
        self.what = None

    # Select the node EL, in place of what was selected.
    def select_node(self, el: Element_T):
        self.clear()
        let view: ?NodeView = network.drawing.node_at(el)
        if view is not None:
            self.what = view
            set_selected(el, true)

    # Select the edge EL, in place of what was selected.
    def select_edge(self, el: Element_T):
        self.clear()
        let view: ?EdgeView = network.drawing.edge_at(el)
        if view is not None:
            self.what = view
            set_selected(el, true)

    # Ask the cost of the selected edge, if an edge is selected.
    def change_cost(self):
        let picked: NodeView | EdgeView | None = self.what
        if picked is EdgeView:
            picked.change_cost()

    # Delete what is selected, after asking.
    def remove(self):
        let picked: NodeView | EdgeView | None = self.what
        case picked:
            when NodeView | EdgeView:
                picked.delete()
            when None:
                pass

    # Forget the selection without unmarking it: the page it was on has been drawn again.
    def forget(self):
        self.what = None

var selection: Selection = Selection()

# A click that svg_drag did not take for a drag. On a node it chooses it for the route, or, when
# it is chosen already (drawn as the start or the goal), takes it out of the route again. Anything
# else is a selection: the edge under the click is selected, and the empty space clears it. A click
# outside the drawing (the toolbar, a menu) is none of this.
def clicked_cb(c: Click_T):
    if on(c, "svg.graph") is None:
        return
    let node: ?Element_T = on(c, "g.node")
    if node is not None:
        selection.clear()
        let view: ?NodeView = network.drawing.node_at(node)
        if view is not None:
            view.choose(has_class(node, "start") or has_class(node, "goal"))
        return
    let edge: ?Element_T = on(c, "g[data_from]")
    if edge is None:
        selection.clear()
        return
    selection.select_edge(edge)

# The page was drawn again by the server: what was selected is gone with the old drawing, and the
# drawing's objects are read off the new one.
def page_drawn(e: Event_T):
    selection.forget()
    network = NetworkView()

# ---- Asking the reader, and sending the answer ----

def ask_name() -> str:
    return ask("Name of the new node (letters and digits)?", "")

# Send a new node NAME: placed at X, Y (drawing units, as text) when given, else where the server puts it.
def send_node(name: str, x: str, y: str):
    send_gesture("POST", "/nodes", {"name": name, "x": x, "y": y})

# ---- Double-click: a new node in the space, or a new cost for an edge ----

def double_click(e: Event_T):
    let c: Click_T = click_of(e)
    let edge: ?Element_T = on(c, "g[data_from]")
    if edge is not None:
        let view: ?EdgeView = network.drawing.edge_at(edge)
        if view is not None:
            view.change_cost()
        return
    if on(c, "svg.graph") is None or on(c, "g.node") is not None:
        return                          # outside the drawing, or on a node (which has no double-click)
    let name: str = ask_name()
    if name == "":
        return
    let at: Spot_T = spot_at(e)
    let kept: Spot_T = inside(at)
    send_node(name, f"{kept.x:.0f}", f"{kept.y:.0f}")

# ---- Right-click: a menu of what can be done to what was clicked ----

# The menus of the drawing: which are shown, and where the space's menu was opened.
class Menus:
    var at: Spot_T

    def __init__(self):
        self.at = Spot_T(x=0.0, y=0.0)

    def hide(self):
        for m in page.all(".menu"):
            m.set_attr("style", "display:none")

var menus: Menus = Menus()

def context(e: Event_T):
    let c: Click_T = click_of(e)
    if on(c, "svg.graph") is None:
        return                          # the rest of the page keeps the browser's own menu
    cancel(c)
    menus.hide()
    let node: ?Element_T = on(c, "g.node")
    let edge: ?Element_T = on(c, "g[data_from]")
    if node is not None:
        selection.select_node(node)
        show_at(page.element("#menu-node"), c)
    elif edge is not None:
        selection.select_edge(edge)
        show_at(page.element("#menu-edge"), c)
    else:
        selection.clear()
        menus.at = spot_at(e)
        show_at(page.element("#menu-space"), c)

# ---- The toolbar and the menus: a button with data_tool does that action ----

# What a button with data_tool asks for (see menus_html in dijkstra_gui.ady).
type Tool_T is enum NO_TOOL, ADD_HERE, CHANGE_COST, DELETE

def tool_of(name: str) -> Tool_T:
    case name:
        when "add-here":
            return ADD_HERE
        when "cost":
            return CHANGE_COST
        when "delete":
            return DELETE
        when others:
            return NO_TOOL

def tool_click(e: Event_T):
    let c: Click_T = click_of(e)
    let b: ?Element_T = on(c, "button[data_tool]")
    if b is None:
        menus.hide()                    # a click elsewhere closes the menus
        return
    menus.hide()
    let tool: Tool_T = tool_of(b.data("tool"))
    case tool:
        when ADD_HERE:
            let name: str = ask_name()
            if name != "":
                send_node(name, f"{menus.at.x:.0f}", f"{menus.at.y:.0f}")
        when CHANGE_COST:
            selection.change_cost()
        when DELETE:
            selection.remove()
        when NO_TOOL:
            pass

# Delete and Backspace remove what is selected; Escape closes the menus.
def key_down(e: Event_T):
    let key: str = key_of(e)
    case key:
        when "Escape":
            menus.hide()
        when "Delete":
            selection.remove()
        when "Backspace":
            selection.remove()
        when others:
            pass                            # any other key

# ---- A drag from a node's dot: a wire, which is the new edge ----
#
# Pressing on a node's dot (circle.port) holds it for a wire, not for a move: the press is
# stopped before svg_drag sees it. While the mouse moves, a dashed line (path#wire, hidden
# until then) runs from that node to the mouse. Letting go on another node asks the cost and
# sends the edge. The browser's click after the release belongs to the wire, so it is not a
# selection, and htmx does not see it.

# The wire's state, and what each gesture on it does.
class Wire:
    var linking: bool                  # a wire is being drawn
    var from_node: Node_T              # the node the wire starts at
    var from_at: Spot_T                # and where it is drawn
    var swallow: bool                  # the click after a wire is let go: not a click on a node

    def __init__(self):
        self.linking = false
        self.from_node = Node_T("")
        self.from_at = Spot_T(x=0.0, y=0.0)
        self.swallow = false

    # The press: on a node's dot, the wire starts there.
    def down(self, e: Event_T):
        let c: Click_T = click_of(e)
        if not left(c) or on(c, "circle.port") is None:
            return
        let node: ?Element_T = on(c, "g.node")
        if node is None:
            return
        let view: ?NodeView = network.drawing.node_at(node)
        if view is None:
            return
        stop(c)
        self.from_node = view.node
        self.from_at = network.spot_of(self.from_node.name)
        self.linking = true
        self.swallow = false
        let el: Element_T = page.element("path#wire")
        el.set_attr("visibility", "visible")
        draw_line(el, self.from_at, spot_at(e))

    # The mouse moves: the wire runs from its start to the mouse.
    def move(self, e: Event_T):
        if not self.linking:
            return
        draw_line(page.element("path#wire"), self.from_at, spot_at(e))

    # The release: on another node, the edge is asked for and sent.
    def up(self, e: Event_T):
        if not self.linking:
            return
        self.linking = false
        page.element("path#wire").set_attr("visibility", "hidden")
        self.swallow = true
        let target: ?Element_T = on(click_of(e), "g.node")
        if target is None:
            return
        let to: Node_T = node_of(target)
        if to.name == self.from_node.name:
            return
        let cost: str = ask(f"Cost of the edge {self.from_node.name} — {to.name}?", "1")
        if cost == "":
            return
        send_gesture("POST", "/edges", {"a": self.from_node.name, "b": to.name, "cost": cost})

    # The click after the release belongs to the wire: it goes no further.
    def swallow_click(self, e: Event_T):
        let c: Click_T = click_of(e)
        if self.swallow and made_by_reader(c):
            self.swallow = false
            stop(c)

var wire: Wire = Wire()

listen_first("mousedown", wire.down)
listen("mousemove", wire.move)
listen("mouseup", wire.up)
listen_first("click", wire.swallow_click)
listen("click", tool_click)
listen("dblclick", double_click)
listen("contextmenu", context)
listen("keydown", key_down)
listen("htmx:afterSwap", page_drawn)
draggable("g.node", "svg.graph", Unit_in_pixel_T(WIDTH), Hooks_T(moved_cb=moved_cb, dropped_cb=dropped_cb, clicked_cb=clicked_cb))
