#!/usr/bin/env ady2nim
#ady2nim-args js
"""dijkstra_js_events -- the drawing's own behaviour, in the browser: what a diagram editor does.

Every other event is declared in the HTML (hx-* attributes, dijkstra_gui.ady) and handled
on the server (dijkstra_events_gui.ady); only what must follow the mouse, select, or ask the
reader a question is here. The gestures, the usual ones of a diagram:

    click a node                 chooses the route: the start, then the goal
    click an edge                selects it (it is outlined); the space deselects
    drag a node                  moves it; its edges follow, and where it is let go is kept
    drag from a node's dot       draws a wire to another node: the edge, after its cost is asked
    double-click the space       a new node there (asks the name)
    double-click an edge         its cost (asks it)
    right-click                  a menu of what can be done to what was clicked
    (another page's change)      the page is drawn again, from GET /all
    Delete, Backspace            removes the selection (asks first)
    Escape                       closes the menu

A gesture never talks to the server: it makes a Command, Create, Read, Update or Delete of a node or
an edge (backend/dijkstra_commands.ady, the server's vocabulary too, which reads each request back
into one), and publishes it on the page's blackboard, the channel `commands_channel`. Many gestures may make
one command: a Delete is the Delete key, Backspace, or the menu's "Delete node". The gesture does not
know who carries the command out. Two observers do (blackboard's Observer: each is an object that
subscribes itself as it is made, and its `callback` is what it does with what it hears):

    Liaison_Officer the liaison officer: what is for the server it sends there (`send`), so the
                    model is changed in one place, the server's
    Mouse_Follower  a draft (a node still held: `move_node`) only moves the drawing, here and now,
                    many times a second; the liaison leaves it in the browser

What decides is what a command means, not which gesture made it: a draft changes only the page, and
anything else is the model's, so the server's. The answer to C, U or D says only whether it went
through (the paragraph #problem). What the server says changed, on any page, comes in on the other
channel, `changes_channel`; the Page_Refresher hears it and asks for the page again (R, which takes the place of #all).
So the browser is built like the server: a blackboard, subscribers that know nothing of each other,
and the liaison between the two.

    gesture                      command
    click a node                 R  read_network(name, ...)
    double-click the space       C  create_node(name, at)        and the space menu's "New node here"
    drag from a dot to a node    C  create_edge(a, b, cost)
    drag a node                  U  move_node(name, at)          a draft: stays in the browser
    let go of a dragged node     U  update_node(name, at)
    double-click an edge         U  update_edge(a, b, cost)      and the edge menu's "Change cost"
    Delete, Backspace            D  delete_node(name) or delete_edge(a, b), for what is selected,
                                    and the menus' "Delete node", "Delete edge"
    (a change, from any page)    R  read_network("", False)

The nodes and edges here are the model's own (backend/dijkstra_model.ady), with the places the
reader put them, and where a node without one is drawn is the layout's (at the end of the model):
the same modules the server draws the page with. The page carries the network as the server keeps it
(pre#network); Network(text) builds the model from that, and the layout works out where everything goes,
never from where the page happens to draw it.

What is in this file, in its order (each class keeps one thing):
    the blackboard  the two channels, and publish_command and publish_change, the only ways onto them
    the views       NodeView, EdgeView: one node or edge as the page draws it, and what can be done to
                    it; NetworkView: the model, a Network, with the view of each node and edge the page
                    draws (the one `network`, rebuilt when htmx draws the page)
    the observers   Liaison_Officer, Mouse_Follower: each subscribes itself to the commands (and, after
                    the gestures, whose wire it asks about, Page_Refresher to the changes)
    the gestures    one object each, whose __init__ says which event runs which of its methods:
                      Selection  the node or edge clicked last (and the page drawn again)
                      Pointer    svg_drag's drag and click of a node, and the double-click
                      Menus      the right-click menus, the buttons with data_tool, and the keys
                      Wire       the wire dragged from a node's dot to make an edge
    the start       the other gestures and the observers made, and the server's news followed

The drag itself is the standard library's svg_drag; the page (finding elements, forms, menus,
questions, keys) its browser module, both in TO_NIM/STDLIB. This file says only what each
gesture means in this app.
"""
from blackboard import PublishChannel, Observer
from browser import Element_T, Event_T, Click_T, send_request, click_of, page, find, all, data, text, fill, press, on, left, made_by_reader, stop, cancel, ask, ask_yes, key_of, show_at, attr, set_attr, has_class, number, listen, listen_first, follow
from drawing import Drawing_Pixel_T, Spot_T
from svg_drag import Hooks_T, holding, spot_of, spot_at, clamp, shift, draw_line, place_at, no_click_cb, draggable
from backend/dijkstra_model import Network, Node_T, Edge_T, WIDTH, COST_DY, inside, place_of
from backend/dijkstra_commands import Command, READ, method, url, value, spot, is_draft, create_node, update_node, move_node, delete_node, create_edge, update_edge, delete_edge, read_network


# ---- The page's blackboard: what the reader asks, and what the server says changed ----

# The channels of the page's blackboard.
type Page_Channel_T is enum COMMANDS, CHANGES
type Command_Channel_T is PublishChannel[Page_Channel_T, Command]    # a channel of Page_Channel_T, carrying a Command
type Change_Channel_T is PublishChannel[Page_Channel_T, str]         # and one carrying a change, as text

# What the reader asks for, as commands. Every gesture publishes here, and nowhere else.
var commands_channel: Command_Channel_T = Command_Channel_T(COMMANDS)
# What the server says changed ("NODES_CHAN CREATE H"), whichever page changed it.
var changes_channel: Change_Channel_T = Change_Channel_T(CHANGES)
commands_channel.raise_errors = True    # a subscriber that fails is a bug: let it show
changes_channel.raise_errors = True

# What goes on the page's blackboard, and only through these two.
# Ask for C: the gesture's one way out.
def publish_command(c: Command):
    commands_channel.publish(c)

# What the server says changed (GET /events): the server's one way in.
def publish_change(change: str):
    changes_channel.publish(change)

# ---- The drawing's objects: each node and edge keeps its own drawn parts ----
#
# A NodeView is a node as the page draws it: a Node_T, read off its element, and the element. An
# EdgeView is an edge as the page draws it: an Edge_T, read off its element, and the element. They
# draw what the network tells them; they never decide where anything is.
#
# An edge is <g data_from="A" data_to="B"> holding <path>s (the line, and the wider one to
# point at) and a <text class="cost">.

class NodeView(Node_T):
    var el: Element_T

    # The node a <g class="node"> draws: its name. Where it is drawn is not the model's.
    def __init__(self, el: Element_T):
        super().__init__(el.data("name"))
        self.el = el

    # Choose this node for the route: the start, then the goal; or, with UNPICK, take it out again.
    def choose(self, unpick: bool):
        publish_command(read_network(self.name, unpick))

    # Let it go at AT: it is moved there.
    def drop_at(self, at: Spot_T):
        publish_command(update_node(self.name, at))

    # Ask whether to delete this node and its edges, and if so send it.
    def delete(self):
        if ask_yes(f"Delete the node {self.name} and its edges?"):
            publish_command(delete_node(self.name))

class EdgeView(Edge_T):
    var el: Element_T

    # The edge a <g data_from data_to data_cost> draws.
    def __init__(self, el: Element_T):
        super().__init__(el.data("from"), el.data("to"), int(el.number("data_cost")))
        self.el = el

    # Ask whether to delete this edge, and if so send it.
    def delete(self):
        if ask_yes(f"Delete the edge {self.a} — {self.b}?"):
            publish_command(delete_edge(self.a, self.b))

    # Ask the cost of this edge, and send it.
    def change_cost(self):
        let cost: str = ask(f"Cost of the edge {self.a} — {self.b}?", str(self.cost))
        if cost == "":
            return
        publish_command(update_edge(self.a, self.b, cost))

    # Draw the edge again, from A to B: its lines, and its cost just above the middle.
    def redraw(self, a: Spot_T, b: Spot_T):
        for line in self.el.all("path"):
            line.draw_line(a, b)
        self.el.element("text.cost").place_at(Spot_T(x=(a.x + b.x) / 2.0, y=(a.y + b.y) / 2.0 - COST_DY))

# The text the server keeps the network in, as the page carries it: its node, edge and "at" lines
# (see dijkstra_gui.ady). Before htmx has drawn the page there is none: an empty network.
def kept_text() -> str:
    let kept: ?Element_T = page.find("pre#network")
    if kept is None:
        return ""
    return kept.text()

# The network as the page holds it: a Network, its places included, built from the kept text, and
# the views of what the page draws of it, by name, each found on the page. A node or edge the
# model has but the page does not draw has no view, so no view is ever missing. Moving a node
# changes the model, then draws again what that moves.
class NetworkView(Network):
    var node_views: {str}NodeView       # by name
    var edge_views: {str}EdgeView       # by "A-B", the ends as the model names them

    def __init__(self):
        super().__init__(kept_text())
        self.node_views = {:}
        self.edge_views = {:}
        for n in self.nodes:
            let el: ?Element_T = page.find(f"g.node[data_name=\"{n.name}\"]")
            if el is not None:
                self.node_views[n.name] = NodeView(el)
        for e in self.edges:
            let el: ?Element_T = page.find(f"g[data_from=\"{e.a}\"][data_to=\"{e.b}\"]")
            if el is not None:
                self.edge_views[f"{e.a}-{e.b}"] = EdgeView(el)

    # Where the node NAME is drawn.
    def spot_of(self, name: str) -> Spot_T:
        return place_of(self, name)

    # The view of the node drawn as EL, or none when the page does not draw it.
    def node_view(self, el: Element_T) -> ?NodeView:
        let name: str = NodeView(el).name
        if name in self.node_views:
            return self.node_views[name]
        return None

    # The view of the edge drawn as EL, or none when the page does not draw it.
    def edge_view(self, el: Element_T) -> ?EdgeView:
        let e: EdgeView = EdgeView(el)
        let key: str = f"{e.a}-{e.b}"
        if key in self.edge_views:
            return self.edge_views[key]
        return None

    # Draw again each edge that ends at NAME, where the model puts the two ends.
    def redraw_edges(self, name: str):
        for e in self.edge_views.values():
            if e.a == name or e.b == name:
                e.redraw(place_of(self, e.a), place_of(self, e.b))

var network: NetworkView = NetworkView()     # read again each time htmx draws the page (Selection.page_drawn)

# ---- The observers of commands: the liaison officer, and the draft's drawer ----

# It hears every command: one that is for the server goes there; a draft stays in the browser.
class Liaison_Officer(Observer[Page_Channel_T, Command]):
    def callback(self, channel: Page_Channel_T, c: Command):
        if not is_draft(c):
            self.send(c)

    # Send C, with the reader's choice (the form #state): its verb is the method, its thing the URL.
    # A read's answer is the page, in place of #all; a change's is whether it went through, in place
    # of #problem (the page is drawn again on the news of the change).
    def send(self, c: Command):
        let target: str = ("#all" if c.verb == READ else "#problem")
        send_request(c.method(), c.url(), c.fields, target, "#state")

# It draws a draft of a node's move (move_node, the only draft): the node is drawn where it is
# asked to be, the page's model keeps the place, and the edges that end at it are drawn again.
# Nothing goes to the server.
class Mouse_Follower(Observer[Page_Channel_T, Command]):
    def callback(self, channel: Page_Channel_T, c: Command):
        let name: str = c.value("name")
        if not is_draft(c) or name not in network.node_views:
            return
        let now: ?Spot_T = c.spot()
        if now is None:
            return
        let el: Element_T = network.node_views[name].el
        shift(el, spot_of(el), now)
        network.put(name, now)
        network.redraw_edges(name)

# ---- The gestures: one object each, with the events it listens to ----
#
# Each gesture is an object that keeps its own state; its methods are what the page's events do,
# and its __init__ says which event runs which (listen), so making it is starting it. A gesture
# only publishes commands.

# The reader's selection: the node or edge clicked last, and what is done to it.
class Selection:
    # the node's view or the edge's view the reader clicked last; None when nothing is selected
    var what: NodeView | EdgeView | None

    def __init__(self):
        self.what = None
        listen("htmx:afterSwap", self.page_drawn)

    # Outline the element EL, or take the outline off it.
    def set_selected(self, el: Element_T, lit: bool):
        let cls: str = el.attr("class")
        if lit:
            el.set_attr("class", cls + " selected")
        else:
            el.set_attr("class", cls.replace(" selected", ""))

    # Take the outline off everything selected, and forget it.
    def clear(self):
        for el in page.all(".selected"):
            self.set_selected(el, false)
        self.what = None

    # Select the node EL, in place of what was selected.
    def select_node(self, el: Element_T):
        self.clear()
        let view: ?NodeView = network.node_view(el)
        if view is not None:
            self.what = view
            self.set_selected(el, true)

    # Select the edge EL, in place of what was selected.
    def select_edge(self, el: Element_T):
        self.clear()
        let view: ?EdgeView = network.edge_view(el)
        if view is not None:
            self.what = view
            self.set_selected(el, true)

    # Ask the cost of the selected edge, if an edge is selected.
    def change_cost(self):
        let picked: NodeView | EdgeView | None = self.what
        if picked is EdgeView:
            picked.change_cost()

    # Delete what is selected, after asking.
    def remove(self):
        let picked: NodeView | EdgeView | None = self.what
        if picked is not None:
            picked.delete()

    # The page was drawn again by the server: what was selected is gone with the old drawing
    # (forgotten, not unmarked), and the drawing's objects are read off the new one.
    def page_drawn(self, e: Event_T):
        self.what = None
        network = NetworkView()

var selection: Selection = Selection()     # made here: the other gestures act on it

# Ask the reader the name of a new node; "" when they cancel.
def ask_name() -> str:
    return ask("Name of the new node (letters and digits)?", "")

# The pointer on the drawing: svg_drag's drag of a node, which calls moved, dropped or clicked,
# and the double-click.
class Pointer:
    def __init__(self):
        draggable("g.node", "svg.graph", Drawing_Pixel_T(WIDTH), Hooks_T(moved_cb=self.moved, dropped_cb=self.dropped, clicked_cb=self.clicked))
        listen("dblclick", self.double_clicked)

    # While NODE is dragged: it is asked to go where the mouse takes it, kept inside the drawing (a
    # draft, which the Mouse_Follower draws).
    def moved(self, node: Element_T, centre: Spot_T, wanted: Spot_T) -> Spot_T:
        let now: Spot_T = inside(wanted)
        publish_command(move_node(NodeView(node).name, now))
        return now

    # NODE let go at AT: it is moved there (U).
    def dropped(self, node: Element_T, at: Spot_T):
        let view: ?NodeView = network.node_view(node)
        if view is not None:
            view.drop_at(at)

    # A click that svg_drag did not take for a drag. On a node it chooses it for the route, or,
    # when it is chosen already (drawn as the start or the goal), takes it out of the route again.
    # Anything else is a selection: the edge under the click is selected, and the empty space
    # clears it. A click outside the drawing (the toolbar, a menu) is none of this.
    def clicked(self, c: Click_T):
        if on(c, "svg.graph") is None:
            return
        let node: ?Element_T = on(c, "g.node")
        if node is not None:
            selection.clear()
            let view: ?NodeView = network.node_view(node)
            if view is not None:
                view.choose(has_class(node, "start") or has_class(node, "goal"))
            return
        let edge: ?Element_T = on(c, "g[data_from]")
        if edge is None:
            selection.clear()
            return
        selection.select_edge(edge)

    # A double-click: on an edge, its cost is asked; on the space, a new node there.
    def double_clicked(self, e: Event_T):
        let c: Click_T = click_of(e)
        let edge: ?Element_T = on(c, "g[data_from]")
        if edge is not None:
            let view: ?EdgeView = network.edge_view(edge)
            if view is not None:
                view.change_cost()
            return
        if on(c, "svg.graph") is None or on(c, "g.node") is not None:
            return                      # outside the drawing, or on a node (which has no double-click)
        let name: str = ask_name()
        if name == "":
            return
        publish_command(create_node(name, inside(spot_at(e))))


# The menus: the right-click menu of what can be done to what was clicked, the buttons with
# data_tool (in the menus and the toolbar), and the keys. `at` is where the space's menu was opened.
class Menus:
    var at: Spot_T

    def __init__(self):
        self.at = Spot_T(x=0.0, y=0.0)
        listen("contextmenu", self.right_clicked)
        listen("click", self.clicked)
        listen("keydown", self.key_pressed)

    def hide(self):
        for m in page.all(".menu"):
            m.set_attr("style", "display:none")

    # A right-click on the drawing: the menu of the node, the edge or the space under it, which
    # is selected. The rest of the page keeps the browser's own menu.
    def right_clicked(self, e: Event_T):
        let c: Click_T = click_of(e)
        if on(c, "svg.graph") is None:
            return
        cancel(c)
        self.hide()
        let node: ?Element_T = on(c, "g.node")
        let edge: ?Element_T = on(c, "g[data_from]")
        if node is not None:
            selection.select_node(node)
            show_at(page.element("#menu-node"), c)
        elif edge is not None:
            selection.select_edge(edge)
            show_at(page.element("#menu-edge"), c)
        else:
            selection.clear()
            self.at = spot_at(e)
            show_at(page.element("#menu-space"), c)

    # Any click closes the menus; one on a button with data_tool does what it names (see menus_html
    # in dijkstra_gui.ady).
    def clicked(self, e: Event_T):
        let c: Click_T = click_of(e)
        self.hide()
        let b: ?Element_T = on(c, "button[data_tool]")
        if b is None:
            return
        case b.data("tool"):
            when "add-here":
                let name: str = ask_name()
                if name != "":
                    publish_command(create_node(name, self.at))
            when "cost":
                selection.change_cost()
            when "delete":
                selection.remove()
            when others:
                pass

    # Delete and Backspace remove what is selected; Escape closes the menus.
    def key_pressed(self, e: Event_T):
        let key: str = key_of(e)
        case key:
            when "Escape":
                self.hide()
            when "Delete" | "Backspace":
                selection.remove()
            when others:
                pass                    # any other key


# A drag from a node's dot: a wire, which is the new edge.
#
# Pressing on a node's dot (circle.port) holds it for a wire, not for a move: the press is
# stopped before svg_drag sees it. While the mouse moves, a dashed line (path#wire, hidden
# until then) runs from that node to the mouse. Letting go on another node asks the cost and
# sends the edge. The browser's click after the release belongs to the wire, so it is not a
# selection, and htmx does not see it.

# The wire's state, and what each gesture on it does.
class Wire:
    var linking: bool                  # a wire is being drawn
    var from_name: str                 # the node the wire starts at
    var from_at: Spot_T                # and where it is drawn
    var swallow: bool                  # the click after a wire is let go: not a click on a node

    def __init__(self):
        self.linking = false
        self.from_name = ""
        self.from_at = Spot_T(x=0.0, y=0.0)
        self.swallow = false
        listen_first("mousedown", self.down)
        listen("mousemove", self.move)
        listen("mouseup", self.up)
        listen_first("click", self.swallow_click)

    # The press: on a node's dot, the wire starts there.
    def down(self, e: Event_T):
        let c: Click_T = click_of(e)
        if not left(c) or on(c, "circle.port") is None:
            return
        let node: ?Element_T = on(c, "g.node")
        if node is None:
            return
        let view: ?NodeView = network.node_view(node)
        if view is None:
            return
        stop(c)
        self.from_name = view.name
        self.from_at = network.spot_of(self.from_name)
        self.linking = true
        self.swallow = false
        let el: Element_T = page.element("path#wire")
        el.set_attr("visibility", "visible")
        draw_line(el, self.from_at, spot_at(e))

    # The mouse moves: the wire runs from its start to the mouse.
    def move(self, e: Event_T):
        if not self.linking:
            return
        draw_line(page.element("path#wire"), self.from_at, spot_at(e))

    # The release: on another node, the edge is asked for and sent.
    def up(self, e: Event_T):
        if not self.linking:
            return
        self.linking = false
        page.element("path#wire").set_attr("visibility", "hidden")
        self.swallow = true
        let target: ?Element_T = on(click_of(e), "g.node")
        if target is None:
            return
        let to: NodeView = NodeView(target)
        if to.name == self.from_name:
            return
        let cost: str = ask(f"Cost of the edge {self.from_name} — {to.name}?", "1")
        if cost == "":
            return
        publish_command(create_edge(self.from_name, to.name, cost))

    # The click after the release belongs to the wire: it goes no further.
    def swallow_click(self, e: Event_T):
        let c: Click_T = click_of(e)
        if self.swallow and made_by_reader(c):
            self.swallow = false
            stop(c)

var wire: Wire = Wire()     # made here: the Page_Refresher asks whether a wire is held

# ---- The observer of changes ----

# The server tells every open page of each change to the network (GET /events, "NODES_CHAN CREATE H"),
# whichever page made it, this one included; each asks for itself again, keeping what its reader
# picked (#state). Not while a node or a wire is held: what is let go is a change of its own, and
# its news draws the page again.
class Page_Refresher(Observer[Page_Channel_T, str]):
    def callback(self, channel: Page_Channel_T, change: str):
        if holding() or wire.linking:
            return
        publish_command(read_network("", False))

# ---- Start: the page's knowledge sources, and the server's news ----

# The two gestures nothing else asks about (the selection and the wire are made above).
let pointer: Pointer = Pointer()
let menus: Menus = Menus()

# Each observer subscribes itself to its channel as it is made.
let liaison: Liaison_Officer = Liaison_Officer(commands_channel)
let mouse_follower: Mouse_Follower = Mouse_Follower(commands_channel)
let page_refresher: Page_Refresher = Page_Refresher(changes_channel)
follow("/events", publish_change)
