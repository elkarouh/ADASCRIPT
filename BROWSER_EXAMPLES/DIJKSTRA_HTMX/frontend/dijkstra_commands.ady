#!/usr/bin/env ady2nim
#ady2nim-args js
"""dijkstra_commands -- what the page asks of the server: Create, Read, Update or Delete, of a node or an edge.

A gesture does not talk to the server. It makes a Command, and `send` sends it. Which gesture made it
does not matter to anything after that: a Delete is the same command whether it came from the Delete
key, Backspace, or the right-click menu's "Delete node".

    send(delete_node("A"))                       # D: DELETE /nodes   name=A
    send(create_edge("A", "B", "3"))             # C: POST   /edges   a=A b=B cost=3
    send(update_node("A", at))                   # U: PUT    /nodes   name=A x=.. y=..
    send(read_network("A", False))               # R: GET    /all     pick=A

A Command is its verb (CREATE, READ, UPDATE, DELETE), what it is done to (a NODE, an EDGE, or the
whole NETWORK, which is what is read), and its fields by name. The verb is the HTTP method, the thing
is the URL, and the reader's choice (the form #state) goes with every command.

C, U and D are commands: the answer says only whether it went through (the paragraph #problem, empty,
or why not); the page is drawn again when the server tells it of the change (see `news` in
dijkstra_js_events.ady). R is the read: its answer is the page, in place of #all.
"""
from browser import request
from drawing import Spot_T

type Verb_T is enum CREATE, READ, UPDATE, DELETE
type Thing_T is enum NODE, EDGE, NETWORK

type Command is record:
    verb:   Verb_T
    thing:  Thing_T
    fields: {str}str

# A command: VERB, done to THING, with FIELDS.
def command(verb: Verb_T, thing: Thing_T, fields: {str}str) -> Command:
    return Command(verb, thing, fields)

# The HTTP method a verb is sent as.
def method_of(verb: Verb_T) -> str:
    case verb:
        when CREATE:
            return "POST"
        when READ:
            return "GET"
        when UPDATE:
            return "PUT"
        when DELETE:
            return "DELETE"

# The URL of what a command is done to.
def url_of(thing: Thing_T) -> str:
    case thing:
        when NODE:
            return "/nodes"
        when EDGE:
            return "/edges"
        when NETWORK:
            return "/all"

# Send COMMAND to the server, with the reader's choice (#state). A read's answer is the page, in
# place of #all; a change's is whether it went through, in place of #problem.
def send(command: Command):
    let target: str = ("#all" if command.verb == READ else "#problem")
    request(method_of(command.verb), url_of(command.thing), command.fields, target, "#state")

# ---- The commands, by name: one each for what the page can ask ----

# C: a node NAME, at AT (in the drawing's units).
def create_node(name: str, at: Spot_T) -> Command:
    return command(CREATE, NODE, {"name": name, "x": f"{at.x:.0f}", "y": f"{at.y:.0f}"})

# U: the node NAME, moved to AT.
def update_node(name: str, at: Spot_T) -> Command:
    return command(UPDATE, NODE, {"name": name, "x": f"{at.x:.0f}", "y": f"{at.y:.0f}"})

# D: the node NAME, and its edges.
def delete_node(name: str) -> Command:
    return command(DELETE, NODE, {"name": name})

# C: an edge from A to B, costing COST (as the reader typed it; the server refuses what is no cost).
def create_edge(a: str, b: str, cost: str) -> Command:
    return command(CREATE, EDGE, {"a": a, "b": b, "cost": cost})

# U: the edge from A to B, now costing COST.
def update_edge(a: str, b: str, cost: str) -> Command:
    return command(UPDATE, EDGE, {"a": a, "b": b, "cost": cost})

# D: the edge from A to B.
def delete_edge(a: str, b: str) -> Command:
    return command(DELETE, EDGE, {"a": a, "b": b})

# R: the network, as this reader sees it, after clicking the node PICK ("" for none): the start, then
# the goal, or, with UNPICK, a chosen node taken out again.
def read_network(pick: str, unpick: bool) -> Command:
    return command(READ, NETWORK, {"pick": pick, "act": ("unpick" if unpick else "")})
