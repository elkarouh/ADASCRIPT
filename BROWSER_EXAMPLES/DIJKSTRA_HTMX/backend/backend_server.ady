#!/usr/bin/env ady2nim
"""server -- the one place that knows about HTTP; what a request does is dijkstra_events_gui.ady.

    make app [PORT=n]  (or: ady2nim js frontend/dijkstra_js_events.ady; ady2nim c -r backend/backend_server.ady [PORT])        then open http://127.0.0.1:8810/

    GET    /            the page: a script tag and a div that loads /all
    GET    /htmx.min.js htmx itself
    GET    /dijkstra_js_events.js     dijkstra_js_events.ady, compiled to JavaScript
    GET    /events      the changes, as they are made, for every open page (server-sent events)

Every other request (GET /all, and the routes for nodes, edges, relayout and reset) is answered
by Session.answer in dijkstra_events_gui.ady, which lists them.

A read answers the whole page, which htmx swaps in; a command only whether it went through. Each
change it made is published, and two subscribers here hear of it: `keep`, which writes the network to
graph.txt (in the directory the server runs in), and `tell`, which tells every open page, which then
reads itself again.
"""
from asyncdispatch nimport complete, newFuture, Port, waitFor
from asynchttpserver nimport HttpHeaders, newHttpHeaders, Request, respond, Http200, Http404, AsyncHttpServer, newAsyncHttpServer, serve
from page_server import News, send_script, port_of
from backend/dijkstra_gui import shell_text
from commands import Change
from backend/dijkstra_events_gui import Channel_T, Session

# The session the requests are answered from: main makes it the one that keeps the network in graph.txt.
var session: Session = Session("")

# The pages following GET /events.
var news: News = News()

# A change, told to every page that follows: subscribed to the session's channels in main.
def tell(channel: Channel_T, change: Change):
    news.tell(f"{channel} {change.kind} {change.key}")

# A change, kept: the network written to graph.txt.
def keep(channel: Channel_T, change: Change):
    session.keep()

async def handler(req: Request):
    let html_type: HttpHeaders = newHttpHeaders([("Content-Type", "text/html; charset=utf-8")])
    let path: str = req.url.path
    case path:
        when "/":
            await req.respond(Http200, shell_text(), html_type)
        when "/htmx.min.js":
            await send_script(req, Path("frontend"))
        when "/dijkstra_js_events.js":
            await send_script(req, Path("frontend"))
        when "/events":
            news.follow(req.client)             # and no end: the changes follow, from tell
        when others:
            let page: str = session.answer(req.reqMethod'Image, path, req.url.query + "&" + req.body)
            if page == "":
                await req.respond(Http404, "not found")
            else:
                await req.respond(Http200, page, html_type)

def main():
    let port: int = port_of($@, 8810)
    session = Session("graph.txt")
    session.nodes_channel.subscribe(keep)       # kept first, so a page that reads again sees it saved, or why not
    session.edges_channel.subscribe(keep)
    session.nodes_channel.subscribe(tell)
    session.edges_channel.subscribe(tell)
    print f"http://127.0.0.1:{port}/ (Ctrl-C to stop); the network is kept in graph.txt"
    var server: AsyncHttpServer = newAsyncHttpServer()
    waitFor(server.serve(Port(port), handler))

if __name__ == "__main__":
    main()
