#!/usr/bin/env ady2nim
"""dijkstra_layout -- the layout: where each node of the network is drawn, when nobody has put it.

The model (dijkstra_model.ady) keeps the places the reader has put (Network.places); this module
decides where every other node goes (place_of): the layout algorithm, in the order the model
keeps the nodes, round an ellipse. It is computed from the network, never read off a page: the
server draws the page with it (dijkstra_gui.ady), and the browser moves nodes with it
(frontend/dijkstra_js_events.ady), so both find the same places from the same network. Like the
model, it is compiled both ways: no HTML, no HTTP, no DOM.
"""
from drawing import Drawing_Pixel_T, Unit_in_cm_T, Spot_T
from backend/dijkstra_model import Network
nimport math

const WIDTH: Unit_in_cm_T = 15.0        # the drawing's width
const HEIGHT: Unit_in_cm_T = 10.0       # the drawing's height
const MARGIN: Drawing_Pixel_T = 30.0    # how near its edge a node may go
const ACROSS: Unit_in_cm_T = 6.0        # the ellipse the unplaced nodes sit on: its half width
const UP: Unit_in_cm_T = 4.0            # and its half height

# The sizes of what is drawn at a node and an edge.
const NODE_R: Drawing_Pixel_T = 24.0    # a node's radius
const PORT_R: Drawing_Pixel_T = 6.0     # its port's, the dot on its right, NODE_R from its middle
const NAME_DY: Drawing_Pixel_T = 5.0    # a node's name is this far under its middle
const COST_DY: Drawing_Pixel_T = 6.0    # an edge's cost is this far over its middle

# P, kept inside the drawing: a node may not go nearer its edge than MARGIN.
def inside(p: Spot_T) -> Spot_T:
    let right: Drawing_Pixel_T = Drawing_Pixel_T(WIDTH) - MARGIN
    let bottom: Drawing_Pixel_T = Drawing_Pixel_T(HEIGHT) - MARGIN
    return Spot_T(max(MARGIN, min(right, p.x)), max(MARGIN, min(bottom, p.y)))

# The place of the K-th of N nodes that nobody has put anywhere: the nodes sit on an ellipse
# that fills the drawing, evenly spaced, in the order the model keeps them. Deterministic, so the
# same network is drawn the same way on the server and in the browser.
def new_spot(k: int, n: int) -> Spot_T:
    let angle: float = 6.283185307179586 * float(k) / float(max(n, 1))
    let middle: Spot_T = Spot_T(Drawing_Pixel_T(WIDTH) / 2.0, Drawing_Pixel_T(HEIGHT) / 2.0)
    return Spot_T(middle.x + Drawing_Pixel_T(ACROSS) * math.cos(angle), middle.y + Drawing_Pixel_T(UP) * math.sin(angle))

# Where the node NAME of NET is drawn: where the reader put it, else where the layout puts it.
def place_of(net: Network, name: str) -> Spot_T:
    if name in net.places:
        return net.places[name]
    for i in range(len(net.nodes)):
        if net.nodes[i].name == name:
            return new_spot(i, len(net.nodes))
    return Spot_T(0.0, 0.0)
