#!/usr/bin/env ady2nim
"""dijkstra_model -- the model: a network of nodes and edges, what may be done to it, and
where it is kept.

A node has a name; an edge joins two nodes, both ways, at a cost. The network is a Network,
a class: it is changed only through its methods (create, update, delete), each of which says
what was wrong, or "" when it was done. It also keeps where the reader has put each node (put),
as data; a node without a place is laid out by dijkstra_layout.ady. It is kept in a text file,
one line a node, an edge or a place (Network.text, and Network(text) to read it back; the file itself is read and
written by dijkstra_events_gui.ady). The shortest way itself is the library's (TO_NIM/STDLIB/graphs.ady):
build_graph turns the network into the graph it wants.

A placeholder: replace this file with your own model. No HTML, no HTTP.
"""
from drawing import Drawing_Pixel_T, Spot_T

# Why a change to the network is refused: the message the page shows the reader.
type Refusal_T is record:
    message: str

# A node: its name.
type Node_T is record:
    name: str

# An edge: the two nodes it joins, both ways, and its cost.
type Edge_T is record:
    a:    str
    b:    str
    cost: int

const LETTERS: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"

class Network:
    var nodes: []Node_T                 # in the order they were made
    var edges: []Edge_T                 # each edge once
    var places: {str}Spot_T            # where the reader put a node, by name; the others are laid out

    def __init__(self, nodes: []Node_T, edges: []Edge_T, places: {str}Spot_T = {:}):
        self.nodes = nodes
        self.edges = edges
        self.places = places

    # The network kept in TEXT, as text() writes it: its node, edge and "at" lines, in order.
    def __init__(self, text: str):
        self.nodes = []
        self.edges = []
        self.places = {:}
        for line in text.split("\n"):
            let w: []str = line.split()
            if len(w) == 0:
                continue
            case w[0]:
                when "node":
                    if len(w) == 2:
                        let added: None | !Refusal_T = self.add_node(w[1])
                when "edge":
                    if len(w) == 4:
                        let c: int | !ParseFailure_T = parse_int(w[3])
                        if c is ParseFailure_T:
                            continue
                        let joined: None | !Refusal_T = self.add_edge(w[1], w[2], c)
                when "at":
                    if len(w) == 4:
                        let x: float | !ParseFailure_T = parse_float(w[2])
                        let y: float | !ParseFailure_T = parse_float(w[3])
                        if x is ParseFailure_T:
                            continue
                        if y is ParseFailure_T:
                            continue
                        self.put(w[1], Spot_T(Drawing_Pixel_T(x), Drawing_Pixel_T(y)))

    # The reader puts the node NAME at AT.
    def put(self, name: str, at: Spot_T):
        self.places[name] = at

    # Every node goes back to the layout: no node keeps a place of its own.
    def forget_places(self):
        self.places = {:}

    # The names of the nodes, in order.
    def names(self) -> []str:
        var names: []str = []
        for n in self.nodes:
            names.append(n.name)
        return names

    # The edge between A and B, either way round: its index, or -1.
    def edge_at(self, a: str, b: str) -> int:
        for i in range(len(self.edges)):
            let e: Edge_T = self.edges[i]
            if (e.a == a and e.b == b) or (e.a == b and e.b == a):
                return i
        return -1

    # ---- create, update, delete: each refuses with a Refusal_T, or is done (None) ----

    def add_node(self, name: str) -> None | !Refusal_T:
        if len(name) == 0 or len(name) > 8:
            return Refusal_T(message="A name is 1 to 8 letters or digits.")
        for c in name:
            if c not in LETTERS:
                return Refusal_T(message="A name is 1 to 8 letters or digits.")
        if name in self.names():
            return Refusal_T(message=f"There is a node {name} already.")
        self.nodes.append(Node_T(name))

    # The node goes, and every edge that ends at it.
    def remove_node(self, name: str) -> None | !Refusal_T:
        if name not in self.names():
            return Refusal_T(message=f"There is no node {name}.")
        var left: []Node_T = []
        for n in self.nodes:
            if n.name != name:
                left.append(n)
        self.nodes = left
        var kept: []Edge_T = []
        for e in self.edges:
            if e.a != name and e.b != name:
                kept.append(e)
        self.edges = kept

    def add_edge(self, a: str, b: str, cost: int) -> None | !Refusal_T:
        if a not in self.names() or b not in self.names():
            return Refusal_T(message="Pick two nodes for the edge.")
        if a == b:
            return Refusal_T(message="An edge joins two different nodes.")
        if self.edge_at(a, b) >= 0:
            return Refusal_T(message=f"There is an edge {a} - {b} already.")
        if cost < 1:
            return Refusal_T(message="A cost is 1 or more.")
        self.edges.append(Edge_T(a, b, cost))

    def set_cost(self, a: str, b: str, cost: int) -> None | !Refusal_T:
        let i: int = self.edge_at(a, b)
        if i < 0:
            return Refusal_T(message=f"There is no edge {a} - {b}.")
        if cost < 1:
            return Refusal_T(message="A cost is 1 or more.")
        self.edges[i].cost = cost

    def remove_edge(self, a: str, b: str) -> None | !Refusal_T:
        let i: int = self.edge_at(a, b)
        if i < 0:
            return Refusal_T(message=f"There is no edge {a} - {b}.")
        var kept: []Edge_T = []
        for k in range(len(self.edges)):
            if k != i:
                kept.append(self.edges[k])
        self.edges = kept

    # ---- kept in a text file: "node A" and "edge A B 7", a line each ----

    def text(self) -> str:
        var lines: []str = []
        for n in self.nodes:
            lines.append(f"node {n.name}")
        for e in self.edges:
            lines.append(f"edge {e.a} {e.b} {e.cost}")
        for n in self.nodes:
            if n.name in self.places:
                let p: Spot_T = self.places[n.name]
                lines.append(f"at {n.name} {p.x:.0f} {p.y:.0f}")
        return "\n".join(lines) + "\n"

    # ---- for the library ----

    # The graph the library wants: each node to its (cost, neighbour) pairs. The edges are
    # undirected, so each one is entered both ways.
    def build_graph(self) -> {str}[](float, str):
        var graph: {str}[](float, str)
        for n in self.nodes:
            graph[n.name] = []
        for e in self.edges:
            graph[e.a].append((float(e.cost), e.b))
            graph[e.b].append((float(e.cost), e.a))
        return graph

# What there is to start with, and after Reset.
def sample() -> Network:
    let nodes: []Node_T = [Node_T("A"), Node_T("B"), Node_T("C"), Node_T("D"), Node_T("E"), Node_T("F")]
    let edges: []Edge_T = [Edge_T("A", "B", 7), Edge_T("A", "C", 9), Edge_T("A", "F", 14), Edge_T("B", "C", 10),
                         Edge_T("B", "D", 15), Edge_T("C", "D", 11), Edge_T("C", "F", 2), Edge_T("D", "E", 6),
                         Edge_T("E", "F", 9)]
    var net: Network = Network(nodes, edges)
    net.put("A", Spot_T(60.0, 190.0))
    net.put("B", Spot_T(200.0, 60.0))
    net.put("C", Spot_T(200.0, 190.0))
    net.put("D", Spot_T(380.0, 60.0))
    net.put("E", Spot_T(520.0, 190.0))
    net.put("F", Spot_T(330.0, 320.0))
    return net

# Whether ROUTE runs along the edge E, in either direction: dijkstra_gui.ady draws those edges in orange.
def uses(route: []str, e: Edge_T) -> bool:
    for i in range(len(route) - 1):
        if (route[i] == e.a and route[i + 1] == e.b) or (route[i] == e.b and route[i + 1] == e.a):
            return True
    return False
