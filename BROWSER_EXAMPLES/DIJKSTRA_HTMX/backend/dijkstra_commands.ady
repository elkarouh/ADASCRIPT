#!/usr/bin/env ady2nim
"""dijkstra_commands -- the one vocabulary of the page and the server: Create, Read, Update or Delete,
of a node or an edge. Compiled both ways, like the model: the page makes commands, the server reads
each request back into one, and both go by the same words.

A Command is its verb (CREATE, READ, UPDATE, DELETE), what it is done to (a NODE, an EDGE, or the
whole NETWORK, which is what is read), and its fields by name:

    delete_node("A")                    # D: DELETE /nodes   name=A
    create_edge("A", "B", "3")          # C: POST   /edges   a=A b=B cost=3
    update_node("A", at)                # U: PUT    /nodes   name=A x=.. y=..
    read_network("A", False)            # R: GET    /all     pick=A

On the wire the verb is the HTTP method and the thing is the URL: `method_of` and `url_of` say which,
and `command_of` reads them back, so the mapping is written once, here. The page sends a command
(`send` in dijkstra_js_events.ady); the server reads it back (`Session.answer` in
dijkstra_events_gui.ady) and carries it out; and what it changed goes out with the same verbs (a
`Change`, also of this module's Verb_T). No HTML, no HTTP.
"""
from drawing import Spot_T

type Verb_T is enum CREATE, READ, UPDATE, DELETE
type Thing_T is enum NODE, EDGE, NETWORK

type Command is record:
    verb:   Verb_T
    thing:  Thing_T
    fields: {str}str

# A command: VERB, done to THING, with FIELDS.
def command(verb: Verb_T, thing: Thing_T, fields: {str}str) -> Command:
    return Command(verb, thing, fields)

# The field NAME of command C, or "" when it has none.
def value(c: Command, name: str) -> str:
    if name in c.fields:
        return c.fields[name]
    return ""

# ---- On the wire: the verb is the HTTP method, the thing is the URL ----

def method_of(verb: Verb_T) -> str:
    case verb:
        when CREATE:
            return "POST"
        when READ:
            return "GET"
        when UPDATE:
            return "PUT"
        when DELETE:
            return "DELETE"

def url_of(thing: Thing_T) -> str:
    case thing:
        when NODE:
            return "/nodes"
        when EDGE:
            return "/edges"
        when NETWORK:
            return "/all"

# The command METHOD on URL is, with FIELDS; None when it is none of them. The network is only read,
# and only the network is read.
def command_of(method: str, url: str, fields: {str}str) -> ?Command:
    for verb in Verb_T:
        if method_of(verb) != method:
            continue
        for thing in Thing_T:
            if url_of(thing) == url and (verb == READ) == (thing == NETWORK):
                return command(verb, thing, fields)
    return None

# ---- The commands, by name: one each for what the page can ask ----

# C: a node NAME, at AT (in the drawing's units).
def create_node(name: str, at: Spot_T) -> Command:
    return command(CREATE, NODE, {"name": name, "x": f"{at.x:.0f}", "y": f"{at.y:.0f}"})

# U: the node NAME, moved to AT.
def update_node(name: str, at: Spot_T) -> Command:
    return command(UPDATE, NODE, {"name": name, "x": f"{at.x:.0f}", "y": f"{at.y:.0f}"})

# D: the node NAME, and its edges.
def delete_node(name: str) -> Command:
    return command(DELETE, NODE, {"name": name})

# C: an edge from A to B, costing COST (as the reader typed it; the server refuses what is no cost).
def create_edge(a: str, b: str, cost: str) -> Command:
    return command(CREATE, EDGE, {"a": a, "b": b, "cost": cost})

# U: the edge from A to B, now costing COST.
def update_edge(a: str, b: str, cost: str) -> Command:
    return command(UPDATE, EDGE, {"a": a, "b": b, "cost": cost})

# D: the edge from A to B.
def delete_edge(a: str, b: str) -> Command:
    return command(DELETE, EDGE, {"a": a, "b": b})

# R: the network, as this reader sees it, after clicking the node PICK ("" for none): the start, then
# the goal, or, with UNPICK, a chosen node taken out again.
def read_network(pick: str, unpick: bool) -> Command:
    return command(READ, NETWORK, {"pick": pick, "act": ("unpick" if unpick else "")})
