#!/usr/bin/env ady2nim
"""dijkstra_request -- a request, read as the page and the events need it.

A Request is its method, its path and its fields, which come in the query and the body
("a=1&b=2") and are read once, by name. `r.field(key)` is one of them, `r.params()` what the page
keeps about the reader's choice (see dijkstra_gui.ady), and `r.command()` the Command it is
(dijkstra_commands.ady). number_of reads a number, -1 when there is none. No HTML, no HTTP server,
no network.
"""
from uri nimport decodeUrl
from backend/dijkstra_commands import Command, command_of

# What the page keeps about the reader's choice, sent with every request as the form #state
# and the gesture form: the start and the goal of the route, the node clicked, and whether it
# was clicked to be unchosen.
type Params_T is record:
    start: str
    goal:  str
    pick:  str                      # the node clicked
    act:   str                      # unpick

class Request:
    var method: str                 # GET, POST, PUT, DELETE
    var path:   str                 # /all, /nodes, /edges, ...
    var fields: {str}str            # by name, from the query and the body

    # METHOD on PATH, with the fields of TEXT, a query or a form body ("a=1&b=2").
    def __init__(self, method: str, path: str, text: str):
        self.method = method
        self.path = path
        self.fields = {:}
        for pair in text.split("&"):
            let at: int = pair.find("=")
            if at > 0:
                self.fields[pair[:at]] = decodeUrl(pair[at + 1:])

    # The field KEY, or "".
    def field(self, key: str) -> str:
        if key in self.fields:
            return self.fields[key]
        return ""

    # The reader's choice: the start, the goal, the node clicked, and whether to unpick it.
    def params(self) -> Params_T:
        return Params_T(self.field("start"), self.field("goal"), self.field("pick"), self.field("act"))

    # The command this request is; None when it is none.
    def command(self) -> ?Command:
        return command_of(self.method, self.path, self.fields)

# TEXT as a number: -1 when it is not one.
def number_of(text: str) -> float:
    let n: float | !ParseFailure_T = parse_float(text)
    if n is ParseFailure_T:
        return -1.0
    else:
        return n
