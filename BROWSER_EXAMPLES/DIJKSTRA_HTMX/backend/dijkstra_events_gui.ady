#!/usr/bin/env ady2nim
"""dijkstra_events_gui -- what each event the page sends does, and the network it does it to; no HTTP.

server.ady hands every request to a Session, as a method, a path and its fields, and sends back
what comes out. The tests make a Session of their own and call answer() the same way, with no server
running.

Commands in, events out. Every request is read back into a Command, the page's own vocabulary
(dijkstra_commands.ady): Create, Read, Update or Delete, of a node or an edge. A read answers the whole
page. A change answers only whether it went through: the paragraph #problem, empty, or saying why not.
When it went through, what it changed is published with the same verbs, one channel per collection,
named by Channel_T: NODES_CHAN and EDGES_CHAN carry a Change (CREATE, UPDATE or DELETE, and which one). Whoever must hear of it subscribes -- the server, which
keeps the network in its file (`keep`) and tells every open page, which then reads itself again --
and the Session knows none of them:

    def heard(channel: Channel_T, change: Change):
        print channel, change.kind, change.key          # "NODES_CHAN CREATE H", "EDGES_CHAN DELETE A H"
    session.nodes_channel.subscribe(heard)

Relayout and reset are no command on one node or edge: each is its own route, and what it changed is
an UPDATE with no key: everything, read it all again.
"""
from uri nimport decodeUrl
from drawing import Drawing_Pixel_T, Spot_T
from blackboard import PublishChannel
from backend/dijkstra_model import Edge_T, Network, Refusal_T, sample, place_of
from backend/dijkstra_gui import Params_T, all_text, problem_text
from backend/dijkstra_commands import Command, Verb_T, CREATE, READ, UPDATE, DELETE, NODE, EDGE, NETWORK, command_of, value, spot

# ---- A request: its method, its path and its fields ----
#
# The fields come in the query and the body ("a=1&b=2") and are read once, by name. r.field(key) is
# one of them, r.params() what the page keeps about the reader's choice (dijkstra_gui.ady), and
# r.command() the Command it is (dijkstra_commands.ady).

class Request:
    var method: str                 # GET, POST, PUT, DELETE
    var path:   str                 # /all, /nodes, /edges, ...
    var fields: {str}str            # by name, from the query and the body

    # METHOD on PATH, with the fields of TEXT, a query or a form body ("a=1&b=2").
    def __init__(self, method: str, path: str, text: str):
        self.method = method
        self.path = path
        self.fields = {:}
        for pair in text.split("&"):
            let at: int = pair.find("=")
            if at > 0:
                self.fields[pair[:at]] = decodeUrl(pair[at + 1:])

    # The field KEY, or "".
    def field(self, key: str) -> str:
        if key in self.fields:
            return self.fields[key]
        return ""

    # The reader's choice: the start, the goal, the node clicked, and whether to unpick it.
    def params(self) -> Params_T:
        return Params_T(self.field("start"), self.field("goal"), self.field("pick"), self.field("act"))

    # The command this request is; None when it is none.
    def command(self) -> ?Command:
        return command_of(self.method, self.path, self.fields)

# TEXT as a number: -1 when it is not one.
def number_of(text: str) -> float:
    let n: float | !ParseFailure_T = parse_float(text)
    if n is ParseFailure_T:
        return -1.0
    else:
        return n

# The channels of the server's blackboard: one per collection.
type Channel_T is enum NODES_CHAN, EDGES_CHAN

# What a command changed, as the channels carry it, in the commands' verbs: the node's name, or the
# edge's two ends ("A B"); "" for everything (relayout, reset), which is read again whole.
type Change is record:
    kind: Verb_T
    key:  str

# A channel of the session's: one of Channel_T, carrying a Change.
type Change_Channel_T is PublishChannel[Channel_T, Change]

# The network, and the file it is kept in. The server makes one that keeps it in graph.txt; the tests
# make one that keeps it nowhere.
class Session:
    var net: Network
    var store: str                      # the file the network is kept in; "" keeps it nowhere
    var unsaved: None | !Refusal_T      # why the last change could not be kept, shown on the page
    var nodes_channel: Change_Channel_T = Change_Channel_T(NODES_CHAN)    # what happened to a node
    var edges_channel: Change_Channel_T = Change_Channel_T(EDGES_CHAN)    # what happened to an edge

    def __init__(self, store: str):
        self.store = store
        self.unsaved = None
        let text: str | !PathFailure_T = Path(store).read_text()
        if text is PathFailure_T:
            self.net = sample()         # no file yet, or kept nowhere (""): the sample
        else:
            self.net = Network(text)

    # The network, with its places, written to the store: refused with why, when it was not.
    def save(self) -> None | !Refusal_T:
        if self.store != "":
            let done: None | !PathFailure_T = Path(self.store).write_text(self.net.text())
            if done is PathFailure_T:
                return Refusal_T(message=f"Could not write {self.store}.")

    # Keep the network in the store, after a change: what the server subscribes to the channels.
    # When it cannot, every page says so, from `unsaved`, until a later change is kept.
    def keep(self):
        self.unsaved = self.save()

    # The routes, all answered by answer below. Each but the last two is a Command (on the wire, the
    # verb is the method and the thing the URL); the read answers a whole page for htmx to swap in,
    # the others the paragraph #problem (empty when the command went through).
    #
    #     GET    /all          R the page again                            (start, goal, pick, act)
    #     POST   /nodes        C a node, at x, y if given                  (name, x, y)
    #     PUT    /nodes        U a node moved, after a drag                (name, x, y)
    #     DELETE /nodes        D a node and its edges                      (name)
    #     POST   /edges        C an edge                                   (a, b, cost)
    #     PUT    /edges        U an edge's cost                            (a, b, cost)
    #     DELETE /edges        D an edge                                   (a, b)
    #     POST   /relayout     put every node where the layout puts it
    #     POST   /reset        put the sample network back

    # What METHOD on PATH does, with FIELDS (the query and the body, "a=1&b=2"): what to send back,
    # or "" when there is no such thing.
    def answer(self, method: str, path: str, fields: str) -> str:
        let r: Request = Request(method, path, fields)
        let went: None | !Refusal_T = None         # what relayout and reset answer: they cannot be refused
        case r.method + " " + r.path:
            when "POST /relayout":
                self.net.forget_places()        # no node keeps a place of its own: the layout gives each one
                self.nodes_channel.publish(Change(UPDATE, ""))
                return problem_text(went)
            when "POST /reset":
                self.net = sample()
                self.edges_channel.publish(Change(UPDATE, ""))
                self.nodes_channel.publish(Change(UPDATE, ""))
                return problem_text(went)
            when others:
                pass
        let c: ?Command = r.command()
        if c is None:
            return ""
        if c.verb == READ:
            return all_text(self.net, r.params(), self.unsaved)
        return problem_text(self.carry_out(c))

    # Carry out the change C, and when it went through publish what it changed: why not, when it did not.
    def carry_out(self, c: Command) -> None | !Refusal_T:
        var problem: None | !Refusal_T = None
        let name: str = c.value("name")
        let a: str = c.value("a")
        let b: str = c.value("b")
        let cost: int = int(number_of(c.value("cost")))         # -1 when there is none, which the model refuses
        var node_changes: []Change = []             # published once the command went through
        var edge_changes: []Change = []
        case c.thing:
            when NODE:
                let at: ?Spot_T = c.spot()
                case c.verb:
                    when CREATE:
                        problem = self.net.add_node(name)
                        if problem is None:
                            if at is None:                      # not given: the layout's place for it
                                self.net.put(name, place_of(self.net, name))
                            else:
                                self.net.put(name, at)
                    when UPDATE:
                        if at is None:
                            problem = Refusal_T(message=f"Where should {name} go? There is no place.")
                        elif name not in self.net.names():
                            problem = Refusal_T(message=f"There is no node {name}.")
                        else:
                            self.net.put(name, at)
                    when DELETE:
                        for e in self.net.edges:        # its edges go with it, and are told first
                            if e.a == name or e.b == name:
                                edge_changes.append(Change(DELETE, edge_key(e)))
                        problem = self.net.remove_node(name)
                    when READ:
                        pass                            # never: a read is of the network (command_of)
                node_changes.append(Change(c.verb, name))
            when EDGE:
                case c.verb:
                    when CREATE:
                        problem = self.net.add_edge(a, b, cost)
                    when UPDATE:
                        problem = self.net.set_cost(a, b, cost)
                    when DELETE:
                        problem = self.net.remove_edge(a, b)
                    when READ:
                        pass
                edge_changes.append(Change(c.verb, f"{a} {b}"))
            when NETWORK:
                pass                                    # only read (command_of)
        if problem is None:
            for ch in edge_changes:
                self.edges_channel.publish(ch)
            for ch in node_changes:
                self.nodes_channel.publish(ch)
        return problem

# An edge as a Change names it: its two ends, as the model keeps them.
def edge_key(e: Edge_T) -> str:
    return f"{e.a} {e.b}"
