#!/usr/bin/env ady2nim
"""dijkstra_events_gui -- what each event the page sends does, and the network it does it to; no HTTP.

server.ady hands every request to a Session, as a method, a path and its fields, and sends back
the page that comes out. The tests make a Session of their own and call answer() the same way, with
no server running. A Session keeps the network in a text file (its store), written after every change.
"""
from drawing import Drawing_Pixel_T, Spot_T
from backend/dijkstra_model import Network, Refusal_T, sample
from backend/dijkstra_layout import place_of
from backend/dijkstra_gui import all_text
from backend/dijkstra_request import field_of, number_of, params_of

# The network, and the file it is kept in. The server makes one that keeps it in graph.txt; the tests
# make one that keeps it nowhere.
class Session:
    var net: Network
    var store: str                      # the file the network is kept in; "" keeps it nowhere

    def __init__(self, store: str):
        self.store = store
        self.net = sample()
        if store != "":
            let text: str | !PathFailure_T = Path(store).read_text()
            if text is PathFailure_T:
                pass                    # no file yet: the sample
            else:
                self.net = Network(text)

    # The network, with its places, written to the store: refused with why, when it was not.
    def save(self) -> None | !Refusal_T:
        if self.store != "":
            let done: None | !PathFailure_T = Path(self.store).write_text(self.net.text())
            if done is PathFailure_T:
                return Refusal_T(message=f"Could not write {self.store}.")

    # The routes, all answered by answer below: each is a whole page, sent back to htmx to swap in.
    #
    #     GET    /all          the page again                              (start, goal, pick, act)
    #     POST   /nodes        create a node, at x, y if given             (name, x, y)
    #     PUT    /nodes        move a node, after a drag                   (name, x, y)
    #     DELETE /nodes        delete a node and its edges                 (name)
    #     POST   /edges        create an edge                              (a, b, cost)
    #     PUT    /edges        change an edge's cost                       (a, b, cost)
    #     DELETE /edges        delete an edge                              (a, b)
    #     POST   /relayout     put every node where the layout puts it
    #     POST   /reset        put the sample network back

    # What METHOD on PATH does, with FIELDS (the query and the body, "a=1&b=2"): the page to
    # send back, or "" when there is no such thing.
    def answer(self, method: str, path: str, fields: str) -> str:
        var problem: None | !Refusal_T = None
        let name: str = field_of(fields, "name")
        let a: str = field_of(fields, "a")
        let b: str = field_of(fields, "b")
        case method + " " + path:
            when "GET /all":
                pass
            when "POST /nodes":
                let x: float = number_of(field_of(fields, "x"))      # where it was double-clicked, if it was
                let y: float = number_of(field_of(fields, "y"))
                problem = self.net.add_node(name)
                if problem is None:
                    if x < 0.0 or y < 0.0:                           # not given: the layout's place for it
                        self.net.put(name, place_of(self.net, name))
                    else:
                        self.net.put(name, Spot_T(Drawing_Pixel_T(x), Drawing_Pixel_T(y)))
            when "PUT /nodes":
                if name in self.net.names():
                    self.net.put(name, Spot_T(Drawing_Pixel_T(number_of(field_of(fields, "x"))), Drawing_Pixel_T(number_of(field_of(fields, "y")))))
                else:
                    problem = Refusal_T(message=f"There is no node {name}.")
            when "DELETE /nodes":
                problem = self.net.remove_node(name)
            when "POST /edges":
                problem = self.net.add_edge(a, b, cost_of(fields))
            when "PUT /edges":
                problem = self.net.set_cost(a, b, cost_of(fields))
            when "DELETE /edges":
                problem = self.net.remove_edge(a, b)
            when "POST /relayout":
                self.net.forget_places()        # no node keeps a place of its own: the layout gives each one
            when "POST /reset":
                self.net = sample()
            when others:
                return ""
        if method != "GET" and problem is None:
            let saved: None | !Refusal_T = self.save()
            if saved is Refusal_T:
                return all_text(self.net, params_of(fields), saved)
        return all_text(self.net, params_of(fields), problem)

# The cost in FIELDS: -1 when there is none, which the model refuses.
def cost_of(fields: str) -> int:
    return int(number_of(field_of(fields, "cost")))
