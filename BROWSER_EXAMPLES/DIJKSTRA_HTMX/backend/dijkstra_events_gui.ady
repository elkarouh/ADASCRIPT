#!/usr/bin/env ady2nim
"""dijkstra_events_gui -- what each event the page sends does, and the network it does it to; no HTTP.

backend_server.ady hands every request to a Session, as a method, a path and its fields, and sends back
what comes out. The tests make a Session of their own and call answer() the same way, with no server
running.

Commands in, events out. Every request is read back into a Command, the page's own vocabulary
(dijkstra_commands.ady): Create, Read, Update or Delete, of a node or an edge. A read answers the whole
page. A change answers only whether it went through: the paragraph #problem, empty, or saying why not.
When it went through, what it changed is published with the same verbs, one channel per collection,
named by Channel_T: NODES_CHAN and EDGES_CHAN carry a Change (CREATE, UPDATE or DELETE, and which
one). Whoever must hear of it subscribes -- the server, which keeps the network in its file
(`keep`) and tells every open page, which then reads itself again -- and the Session knows none of
them:

    def heard(channel: Channel_T, change: Change):
        print channel, change.kind, change.key          # "NODES_CHAN CREATE H", "EDGES_CHAN DELETE A H"
    session.nodes_channel.subscribe(heard)

Relayout and reset are commands on the whole network, and what they change is an UPDATE with no
key: everything, read it all again.
"""
from drawing import Spot_T
from blackboard import PublishChannel
from page_request import Page_Request
from kept import kept_text, keep_text
from commands import Verb_T, CREATE, READ, UPDATE, DELETE, Change
from backend/dijkstra_model import Edge_T, Network, Refusal_T, sample
from backend/dijkstra_gui import Choice, all_text, problem_text
from backend/dijkstra_commands import Command, NODE, EDGE, NETWORK, command_of

# The channels of the server's blackboard: one per collection.
type Channel_T is enum NODES_CHAN, EDGES_CHAN

# A channel of the session's: one of Channel_T, carrying a Change.
type Change_Channel_T is PublishChannel[Channel_T, Change]

# The network, and where it is kept: the server makes one that keeps it in the file graph.txt, the
# page alone (frontend/frontend_server.ady) one that keeps it in the browser, the tests one that
# keeps it nowhere.
class Session:
    var net: Network
    var store: str                      # the name the network is kept under (kept.ady); "" nowhere
    var unsaved: None | !Refusal_T      # why the last change could not be kept, shown on the page
    var nodes_channel: Change_Channel_T = Change_Channel_T(NODES_CHAN)    # what happened to a node
    var edges_channel: Change_Channel_T = Change_Channel_T(EDGES_CHAN)    # what happened to an edge

    def __init__(self, store: str):
        self.store = store
        self.unsaved = None
        let text: ?str = kept_text(store)
        if text is None:
            self.net = sample()         # nothing kept yet, or kept nowhere (""): the sample
        else:
            self.net = Network(text)

    # The network, with its places, written to the store: refused with why, when it was not.
    def save(self) -> None | !Refusal_T:
        if self.store != "" and not keep_text(self.store, self.net.text()):
            return Refusal_T(message=f"Could not write {self.store}.")

    # Keep the network in the store, after a change: what the server subscribes to the channels.
    # When it cannot, every page says so, from `unsaved`, until a later change is kept.
    def keep(self):
        self.unsaved = self.save()

    # The routes, all answered by answer below, each a Command (on the wire, the verb is the method
    # and the thing the URL). The read answers a whole page for htmx to swap in; the others the
    # paragraph #problem (empty when the command went through).
    #
    #     GET    /all          R the page again                            (start, goal, pick, act)
    #     PUT    /all          U every node where the layout puts it
    #     DELETE /all          D the network: the sample is put back
    #     POST   /nodes        C a node, at x, y if given                  (name, x, y)
    #     PUT    /nodes        U a node moved, after a drag                (name, x, y)
    #     DELETE /nodes        D a node and its edges                      (name)
    #     POST   /edges        C an edge                                   (a, b, cost)
    #     PUT    /edges        U an edge's cost                            (a, b, cost)
    #     DELETE /edges        D an edge                                   (a, b)

    # What METHOD on PATH does, with FIELDS (the query and the body, "a=1&b=2"): what to send back,
    # or "" when there is no such thing.
    def answer(self, method: str, path: str, fields: str) -> str:
        let c: ?Command = command_of(method, path, Page_Request(method, path, fields).fields)
        if c is None:
            return ""
        if c.verb == READ:          # the page as this reader sees it, after the node clicked (pick), if any
            var choice: Choice = Choice(c.value("start"), c.value("goal"), self.net.names())
            choice.click(c.value("pick"), c.value("act") == "unpick")
            return all_text(self.net, choice, self.unsaved)
        case c.thing:
            when NODE:
                return problem_text(self.change_node(c))
            when EDGE:
                return problem_text(self.change_edge(c))
            when NETWORK:
                return problem_text(self.change_network(c))

    # The node C names (its field name) created, at x, y if given; moved there; or deleted, with its
    # edges. When it went through, what changed is published; when not, why.
    def change_node(self, c: Command) -> None | !Refusal_T:
        let name: str = c.value("name")
        let at: ?Spot_T = c.spot()
        var refused: None | !Refusal_T = None
        case c.verb:
            when CREATE:
                refused = self.net.add_node(name)
                if refused is None:
                    if at is None:
                        self.net.put(name, self.net.place_of(name))     # where the layout puts it, kept
                    else:
                        self.net.put(name, at)
            when UPDATE:
                if name not in self.net.names():
                    refused = Refusal_T(message=f"There is no node {name}.")
                elif at is None:
                    refused = Refusal_T(message=f"Where should {name} go? There is no place.")
                else:
                    self.net.put(name, at)
            when DELETE:
                let edges: []Edge_T = [e for e in self.net.edges if e.a == name or e.b == name]
                refused = self.net.remove_node(name)
                if refused is None:
                    for e in edges:                 # its edges went with it, and are told first
                        self.edges_channel.publish(Change(DELETE, f"{e.a} {e.b}"))
            when others:
                pass                                # a node is not read (command_of)
        if refused is None:
            self.nodes_channel.publish(Change(c.verb, name))
        return refused

    # The edge C names (its fields a and b) created with its cost, given a new cost, or deleted. When
    # it went through, what changed is published; when not, why.
    def change_edge(self, c: Command) -> None | !Refusal_T:
        let a: str = c.value("a")
        let b: str = c.value("b")
        let cost: int = c.number_value("cost")      # -1 when there is none, which the model refuses
        var refused: None | !Refusal_T = None
        case c.verb:
            when CREATE:
                refused = self.net.add_edge(a, b, cost)
            when UPDATE:
                refused = self.net.set_cost(a, b, cost)
            when DELETE:
                refused = self.net.remove_edge(a, b)
            when others:
                pass                                # an edge is not read (command_of)
        if refused is None:
            self.edges_channel.publish(Change(c.verb, f"{a} {b}"))
        return refused

    # The whole network laid out again (U), or put back as the sample (D): it cannot be refused, and
    # what changed is everything, an UPDATE with no key, for every page to read again.
    def change_network(self, c: Command) -> None | !Refusal_T:
        case c.verb:
            when UPDATE:
                self.net.forget_places()
            when DELETE:
                self.net = sample()
                self.edges_channel.publish(Change(UPDATE, ""))
            when others:
                pass                                # read, in answer; never created (command_of)
        self.nodes_channel.publish(Change(UPDATE, ""))
        return None
