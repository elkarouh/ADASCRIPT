#!/usr/bin/env ady2nim
"""dijkstra_gui -- the page as HTML the server draws.

What the page shows is a function of the network (the model, which the server keeps) and of what
the reader has chosen, a Choice: the start and the goal, which the page keeps in the form #state and
sends with every request. A Route is the shortest way between them, worked out once, and what the
page says of it; the drawing only draws (a to_html for an edge, a node and the network).

Each button sends a command (dijkstra_commands.ady), and says which: `page.button`, the stdlib's
server_page.ady, writes how it is sent. A read gets the whole page back; a change, from a button here
or from the drawing's gestures and menus (dijkstra_js_events.ady), gets only the paragraph
#problem, empty when it went through, and every open page then reads itself again when the server
tells it of the change.
"""
from graphs import shortest_route
from backend/dijkstra_model import Edge_T, Network, Node_T, Refusal_T, WIDTH, HEIGHT, NODE_R, PORT_R, NAME_DY, COST_DY
from backend/dijkstra_commands import Thing_T, Command, url, read_network, relayout_network, reset_network
from server_page import Page_Of
from drawing import Drawing_Pixel_T, Spot_T
from style import Look, Rule, Style

# ---- What the reader chose, and the way it gives ----

# The reader's choice: the start and the goal of the way, which the page keeps between requests in
# the form #state. A node clicked is the start, then the goal, then the start again; a chosen node
# clicked again is no longer chosen.
class Choice:
    var start: str
    var goal:  str
    var names: []str                # the network's nodes: only they can be chosen

    # START and GOAL, as the page kept them, in a network with the nodes NAMES: a node deleted since
    # is no longer chosen.
    def __init__(self, start: str, goal: str, names: []str):
        self.names = names
        self.start = (start if start in names else "")
        self.goal = (goal if goal in names else "")

    # The reader clicked the node NAME ("" for none); UNPICK when it was chosen, to unchoose it.
    def click(self, name: str, unpick: bool):
        if unpick:
            if name == self.start:
                self.start = ""
                self.goal = ""
            elif name == self.goal:
                self.goal = ""
        elif name in self.names:
            if self.start == "" or self.goal != "":
                self.start = name
                self.goal = ""
            elif name != self.start:
                self.goal = name

# What a node is to the way: each a state of the node's drawing (Node_View's style).
type Role_T is enum NO_ROLE, START, GOAL, WAY

# The shortest way from the choice's start to its goal, and what the page says of it.
class Route:
    var choice: Choice
    var way:    []str               # the nodes it passes, from the start to the goal; none when there is no way
    var cost:   float

    def __init__(self, net: Network, choice: Choice):
        self.choice = choice
        let found: (float, []str) = shortest_route[str](net.build_graph(), choice.start, choice.goal)
        self.cost = found[0]
        self.way = found[1]

    # Whether the way runs along the edge E, in either direction: it is drawn in orange.
    def uses(self, e: Edge_T) -> bool:
        for i in range(len(self.way) - 1):
            if (self.way[i] == e.a and self.way[i + 1] == e.b) or (self.way[i] == e.b and self.way[i + 1] == e.a):
                return True
        return False

    # What the node NAME is to the way: its START, its GOAL, a node on the WAY, or NO_ROLE.
    def role_of(self, name: str) -> Role_T:
        if name == self.choice.start:
            return START
        if name == self.choice.goal:
            return GOAL
        if name in self.way:
            return WAY
        return NO_ROLE

    # What the page says under the drawing: where to start, where to go, or the way found and its cost.
    def said(self) -> str:
        let start: str = self.choice.start
        let goal: str = self.choice.goal
        if start == "":
            return "Click a node to start from."
        if goal == "":
            return f"From {start}: click a node to go to."
        if len(self.way) == 0:
            return f"No way from {start} to {goal}."
        return f"Shortest way from {start} to {goal}: " + " → ".join(self.way) + f", cost {self.cost:.0f}."

# ---- The drawing: an edge, a node, the network ----

# The colours, named once.
const INK: str = "#1f2933"          # text, and a node under the pointer
const SOFT: str = "#616e7c"         # what is said in passing: an edge's cost
const LINE: str = "#b0b8c1"         # an edge
const RIM: str = "#7b8794"          # a node
const PAPER: str = "#fff"
const ORANGE: str = "#e65100"       # the way
const GREEN: str = "#2e7d32"        # its start
const PALE_GREEN: str = "#e3f2e5"
const BLUE: str = "#1565c0"         # its goal
const PALE_BLUE: str = "#e3eefb"
const ACCENT: str = "#3a66db"       # what is selected, and what is being drawn
const GROUND: str = "#f5f7fa"       # the page under the board
const FRAME: str = "#e4e7eb"        # the board's border
const RED: str = "#c62828"          # what is refused, and what deletes

# An edge: a line between two places, orange when the way runs along it, and its cost
# over its middle. Its look is its Style; the edge's g is selected by the browser (dijkstra_js_events).
class Edge_View:
    style "g[data-from]":
        path.edge:              stroke=LINE stroke_width=2.5 fill="none"
        path.edge.way:          stroke=ORANGE stroke_width=5
        &.selected path.edge:   stroke=ACCENT stroke_width=5
        path.hit:               stroke="transparent" stroke_width=14 fill="none" cursor="pointer"
        text.cost:              font_size="13px" fill=SOFT text_anchor="middle" paint_order="stroke" stroke=PAPER stroke_width=4

    # Edge E, from P1 to P2, orange when the way runs along it (ON_WAY).
    def to_html(self, e: Edge_T, p1: Spot_T, p2: Spot_T, on_way: bool) -> Html:
        let d: str = f"M {p1.x:.0f} {p1.y:.0f} L {p2.x:.0f} {p2.y:.0f}"
        let css: str = ("edge way" if on_way else "edge")
        let lx: str = f"{(p1.x + p2.x) / 2.0:.0f}"
        let ly: str = f"{(p1.y + p2.y) / 2.0 - COST_DY:.0f}"
        let label: str = str(e.cost)
        html:
            g data_from=e.a data_to=e.b data_cost=label:
                path class=css d=d
                path class="hit" d=d
                stext class="cost" x=lx y=ly: label

# A node: its circle, coloured by what it is to the way (a Role_T), its name, and a
# port (the dot on its right) from which a wire is drawn to another. Its look is its Style.
class Node_View:
    style "g.node":
        &:                      cursor="grab"
        circle:                 fill=PAPER stroke=RIM stroke_width=2
        &:hover circle:         stroke=INK
        [WAY] circle:           stroke=ORANGE stroke_width=4
        [START] circle:         fill=PALE_GREEN stroke=GREEN stroke_width=4
        [GOAL] circle:          fill=PALE_BLUE stroke=BLUE stroke_width=4
        &.selected circle:      stroke=ACCENT stroke_width=4
        circle.port:            fill=ACCENT opacity=0 cursor="crosshair"
        &:hover circle.port:    opacity=1
        &.selected circle.port: opacity=1
        text.name:              font_size="16px" font_weight=700 text_anchor="middle" pointer_events="none" fill=INK

    # Node N at AT, drawn as what it is to the way (ROLE).
    def to_html(self, n: Node_T, at: Spot_T, role: Role_T) -> Html:
        let cx: str = f"{at.x:.0f}"
        let cy: str = f"{at.y:.0f}"
        let ty: str = f"{at.y + NAME_DY:.0f}"
        let px: str = f"{at.x + NODE_R:.0f}"
        let css: str = ("node" if role == NO_ROLE else "node " + self.style.class_of(role))
        let nr: str = f"{NODE_R:.0f}"
        let pr: str = f"{PORT_R:.0f}"
        html:
            g class=css data_name=n.name data_x=cx data_y=cy:
                circle cx=cx cy=cy r=nr
                stext class="name" x=cx y=ty: n.name
                circle class="port" cx=px cy=cy r=pr

# The network: the svg with each edge and each node, and the wire the browser draws while an edge is
# made (see dijkstra_js_events.ady). Its look is its own Style and those of its edges and nodes.
class Network_View:
    var edges: Edge_View = Edge_View()
    var nodes: Node_View = Node_View()
    style "svg.graph":
        &:                      width="100%" height="auto" user_select="none" display="block"
        path.wire:              stroke=ACCENT stroke_width=2.5 stroke_dasharray="6 4" fill="none" pointer_events="none"

    def to_html(self, net: Network, route: Route) -> Html:
        let box: str = f"0 0 {Drawing_Pixel_T(WIDTH):.0f} {Drawing_Pixel_T(HEIGHT):.0f}"
        html:
            svg viewBox=box class="graph":
                for e in net.edges:
                    + self.edges.to_html(e, net.place_of(e.a), net.place_of(e.b), route.uses(e))
                for n in net.nodes:
                    + self.nodes.to_html(n, net.place_of(n.name), route.role_of(n.name))
                path id="wire" class="wire" visibility="hidden" d="M 0 0 L 0 0"

    # The rules of the drawing, for the page's <style>.
    def css(self) -> str:
        return self.style.css() + self.edges.style.css() + self.nodes.style.css()

# The drawing, as every page draws it.
let network_view: Network_View = Network_View()

# ---- Around the drawing: the menus, the buttons, the answer to a command ----

# The menus of what a right click on a node, an edge or the space offers: the buttons carry
# data_tool, which dijkstra_js_events.ady acts on for the thing that was right-clicked.
class Menu_View:
    style "div.menu":
        &:                      position="fixed" z_index="10" display="none" flex_direction="column" min_width="10em" background="#fff" border="1px solid #cbd2d9" border_radius="8px" box_shadow="0 6px 18px rgba(31, 41, 51, 0.18)" padding="0.3em"
        button:                 border="none" text_align="left" border_radius="4px" padding="0.4em 0.7em"

    def to_html(self) -> Html:
        html:
            div id="menus":
                div id="menu-node" class="menu":
                    button type="button" class="danger" data_tool="delete": "Delete node"
                div id="menu-edge" class="menu":
                    button type="button" data_tool="cost": "Change cost…"
                    button type="button" class="danger" data_tool="delete": "Delete edge"
                div id="menu-space" class="menu":
                    button type="button" data_tool="add-here": "New node here"

let menu_view: Menu_View = Menu_View()

# The page: a command goes to its URL; a change's answer takes the place of #problem, and a read
# takes the reader's choice (#state) along.
type Page is Page_Of[Thing_T]
let page: Page = Page(url, "#problem", "#state")

# Why the last command was refused, where the page shows it: empty (and not shown) when it went through.
# The answer to a command is this paragraph alone.
def problem_html(problem: None | !Refusal_T) -> Html:
    var message: str = ""
    if problem is Refusal_T:
        message = problem.message
    html:
        p id="problem" class="problem": message

def problem_text(problem: None | !Refusal_T) -> str:
    return str(problem_html(problem))

# ---- The page ----

# The page as the reader sees it: the reader's choice, kept for the next request (#state), the
# buttons, what the route is, why the last command was refused, the drawing, and the network as text.
def all_html(net: Network, choice: Choice, problem: None | !Refusal_T) -> Html:
    let route: Route = Route(net, choice)
    let said_css: str = ("said found" if len(route.way) > 0 else "said")
    html:
        div id="all":
            form id="state":
                input type="hidden" name="start" value=choice.start
                input type="hidden" name="goal" value=choice.goal
            div class="toolbar":
                + page.button("Relayout", relayout_network(), "Put every node where the layout puts it? Nodes you moved go back to the layout.", "quiet")
                + page.button("Reset the sample", reset_network(), "Put the sample network back?", "quiet")
            p class=said_css: route.said()
            + problem_html(problem)
            + network_view.to_html(net, route)
            # the network, its places included, as the server keeps it: for the browser's NetworkView to draw from
            pre id="network": net.text()
            p class="hint": "Click a node to choose it as the start, then one to go to; click a chosen node again to unchoose it. Click an edge to select it, then Delete removes it. Drag a node to move it, or from its dot to another node to join them. Double-click the space for a new node, or an edge to change its cost. Right-click for a menu."
            + menu_view.to_html()

# What the page says above itself.
def header_html() -> Html:
    html:
        header:
            h1: "Shortest way"
            p: "Dijkstra on a network you can edit, drawn by the server."

# The page's own look: the body, the buttons, the paragraphs around the drawing (the drawing and the
# menus have their own, in their classes above).
class Page_View:
    style "":
        *:                      box_sizing="border-box"
        body:                   font_family="system-ui, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif" color=INK background=GROUND margin="0" padding="1.5em 1em 3em"
        header, #all:           max_width="68em" margin="0 auto"
        header h1:              font_size="1.5em" margin="0"
        header p:               color=SOFT margin="0.2em 0 1.2em"
        div.board:              background=PAPER border=f"1px solid {FRAME}" border_radius="10px" padding="1em 1.2em"
        p.said:                 font_weight=600 margin="0 0 0.4em" min_height="1.4em"
        p.said.found:           color=ORANGE
        p.problem:              color=RED background="#fdecea" border_radius="6px" padding="0.4em 0.7em" margin="0 0 0.4em"
        p.problem:empty:        display="none"
        p.hint:                 color=SOFT font_size="0.85em" margin="0.4em 0 0"
        input, button:          font="inherit" font_size="0.9em"
        button:                 border="1px solid #cbd2d9" border_radius="6px" padding="0.3em 0.8em" background="#fff" cursor="pointer"
        button:hover:           background=GROUND
        button.quiet:           color=SOFT
        button.danger:          color=RED
        div.toolbar:            display="flex" flex_wrap="wrap" gap="0.5em" margin_bottom="0.8em"
        pre#network:            display="none"

    # The rules of the page, of its drawing and of its menus, for its <style>.
    def css(self) -> str:
        return self.style.css() + network_view.css() + menu_view.style.css()

let page_view: Page_View = Page_View()

def shell_text() -> str:
    return page.shell_text("Shortest way", page_view.css(), ["dijkstra_js_events.js"], [header_html()], read_network("", False))

def all_text(net: Network, choice: Choice, problem: None | !Refusal_T) -> str:
    return str(all_html(net, choice, problem))
