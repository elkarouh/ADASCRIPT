#!/usr/bin/env ady2nim
"""The model, the page and the requests, with no server running: make test (ady2nim c -r tests/test_dijkstra.ady)"""
from graphs import shortest_route
from blackboard import PublishChannel      # its subscribe, for session.nodes_channel.subscribe below
from backend/dijkstra_model import Edge_T, Network, Refusal_T, sample, uses
from backend/dijkstra_events_gui import Channel_T, Change, Session
from backend/dijkstra_commands import Command, command_of, method_of, url_of, create_node, update_node, move_node, is_draft, delete_node, create_edge, update_edge, delete_edge, read_network
from drawing import Drawing_Pixel_T, Spot_T

# ---- the model ----
var net: Network = sample()
let w: (float, []str) = shortest_route[str](net.build_graph(), "A", "E")
assert w[1] == ["A", "C", "F", "E"] and w[0] == 20.0
assert shortest_route[str](net.build_graph(), "E", "A")[1] == ["E", "F", "C", "A"]      # the edges go both ways
assert uses(w[1], Edge_T("C", "F", 2)) and not uses(w[1], Edge_T("A", "B", 7))

assert net.add_node("G") is None
assert net.add_node("G") is Refusal_T
assert net.add_node("a b") is Refusal_T                    # letters and digits only
assert net.add_edge("G", "A", 3) is None
assert net.add_edge("A", "G", 4) is Refusal_T                          # either way round, one edge
assert net.add_edge("G", "G", 4) is Refusal_T and net.add_edge("G", "Z", 4) is Refusal_T
assert net.set_cost("A", "G", 5) is None and net.set_cost("A", "G", 0) is Refusal_T
assert "node G" in net.text() and "edge G A 5" in net.text()
assert Network(net.text()).text() == net.text()         # kept and read back, the same
assert net.remove_edge("G", "A") is None and net.remove_edge("G", "A") is Refusal_T
assert net.remove_node("C") is None
assert len(net.nodes) == 6 and len(net.edges) == 5               # C's four edges went with it

# ---- the commands: one vocabulary, read back from the wire as the page sent it ----
for sent in [create_node("H", Spot_T(Drawing_Pixel_T(10.0), Drawing_Pixel_T(20.0))), update_node("H", Spot_T(Drawing_Pixel_T(30.0), Drawing_Pixel_T(40.0))),
             delete_node("H"), create_edge("A", "H", "3"), update_edge("A", "H", "4"), delete_edge("A", "H"), read_network("A", True)]:
    let back: ?Command = command_of(method_of(sent.verb), url_of(sent.thing), sent.fields)
    assert back is not None
    assert back == sent
assert command_of("GET", "/nodes", {:}) is None                  # a node is not read; the network is
assert command_of("DELETE", "/all", {:}) is None                 # and the network is only read
assert command_of("PATCH", "/nodes", {:}) is None
# a node still held is a draft, which the page's liaison keeps in the browser; let go, it is not
assert is_draft(move_node("H", Spot_T(Drawing_Pixel_T(30.0), Drawing_Pixel_T(40.0))))
assert not is_draft(update_node("H", Spot_T(Drawing_Pixel_T(30.0), Drawing_Pixel_T(40.0)))) and not is_draft(delete_node("H"))

# ---- the page, through the requests the server answers (kept nowhere) ----
var session: Session = Session("")

# A command, then the page read again, as every open page does when it hears of the change: why the
# command was refused, if it was, and the page.
def after(method: str, path: str, fields: str) -> str:
    let problem: str = session.answer(method, path, fields)
    return problem + session.answer("GET", "/all", fields)

# A command's answer is only whether it went through
assert session.answer("POST", "/nodes", "name=Q") == "<p id=\"problem\" class=\"problem\"></p>"
assert "There is a node Q already." in session.answer("POST", "/nodes", "name=Q")
assert "<svg" not in session.answer("POST", "/nodes", "name=Q")
assert "<p id=\"problem\" class=\"problem\"></p>" in session.answer("GET", "/all", "")    # where it goes
session.answer("DELETE", "/nodes", "name=Q")
assert "Click a node to start from." in session.answer("GET", "/all", "")
assert "click a node to go to." in session.answer("GET", "/all", "start=A&pick=A")
assert "Shortest way from A to E: A → C → F → E, cost 20." in session.answer("GET", "/all", "start=A&goal=E")
assert "name=\"start\" value=\"C\"" in session.answer("GET", "/all", "start=A&goal=B&pick=C")    # a third click starts again
assert "<form id=\"state\">" in session.answer("GET", "/all", "")         # what every request the script sends includes
assert session.answer("GET", "/nowhere", "") == ""

assert "A → F → E, cost 23" in after("PUT", "/edges", "start=A&goal=E&a=C&b=F&cost=40")   # C-F made dear
assert "A → C → F → E, cost 20" in after("PUT", "/edges", "start=A&goal=E&a=F&b=C&cost=2")
assert "A → F → E, cost 23" in after("DELETE", "/edges", "start=A&goal=E&a=C&b=F")
let added: str = after("POST", "/nodes", "name=H")
assert "data-name=\"H\"" in added
assert "There is a node H already." in after("POST", "/nodes", "name=H")
assert "A → F → E, cost 23" in after("POST", "/edges", "start=A&goal=E&a=A&b=H&cost=1")      # H leads nowhere yet
assert "A → H → E, cost 2." in after("POST", "/edges", "start=A&goal=E&a=H&b=E&cost=1")
let moved: str = after("PUT", "/nodes", "name=H&x=300&y=100")
assert "data-x=\"300\"" in moved
assert "A → F → E, cost 23" in after("DELETE", "/nodes", "start=A&goal=E&name=H")       # its edges went with it
assert "Click a node to start from." in after("DELETE", "/nodes", "start=A&goal=E&name=A")
assert "Click a node to start from." in session.answer("GET", "/all", "start=C&goal=B&pick=C&act=unpick")    # a chosen start clicked again
assert "From C: click a node to go to." in session.answer("GET", "/all", "start=C&goal=B&pick=B&act=unpick")  # a chosen goal clicked again
assert "A → C → F → E, cost 20" in after("POST", "/reset", "start=A&goal=E")
assert "at A " not in after("POST", "/relayout", "")         # no kept places: the layout draws every node
assert "data-hx-post=\"/relayout\"" in session.answer("GET", "/all", "")
after("POST", "/reset", "")                                   # the sample again, for the tests that follow
# the drawing's own gestures: a node where it was double-clicked, and the wire
let placed: str = after("POST", "/nodes", "name=K&x=120&y=200")
assert "data-x=\"120\"" in placed
assert "There is a node K already." in after("POST", "/nodes", "name=K&x=5&y=5")
assert "id=\"gesture\"" not in session.answer("GET", "/all", "") and "id=\"wire\"" in session.answer("GET", "/all", "")
assert "id=\"menu-node\"" in session.answer("GET", "/all", "") and "data-tool=\"delete\"" in session.answer("GET", "/all", "")
assert "<pre id=\"network\">node A\n" in session.answer("GET", "/all", "") and "at A 60 190\n" in session.answer("GET", "/all", "")   # what the browser builds its NetworkView from

# ---- what changed, as a subscriber hears it: published only when the request went through ----
var heard: []str = []
def hear(channel: Channel_T, change: Change):
    heard.append(f"{channel} {change.kind} {change.key}")
var told: Session = Session("")
told.nodes_channel.subscribe(hear)
told.edges_channel.subscribe(hear)
told.answer("GET", "/all", "")
told.answer("POST", "/nodes", "name=H")
told.answer("POST", "/nodes", "name=H")                  # refused: nothing is told
told.answer("POST", "/edges", "a=A&b=H&cost=1")
told.answer("PUT", "/edges", "a=A&b=H&cost=2")
told.answer("PUT", "/nodes", "name=H&x=300&y=100")
told.answer("DELETE", "/nodes", "name=H")                # its edge first, then the node
told.answer("POST", "/reset", "")
assert heard == ["NODES_CHAN CREATE H", "EDGES_CHAN CREATE A H", "EDGES_CHAN UPDATE A H", "NODES_CHAN UPDATE H",
                 "EDGES_CHAN DELETE A H", "NODES_CHAN DELETE H", "EDGES_CHAN UPDATE ", "NODES_CHAN UPDATE "]

# a change that could not be kept: every page says so, until one is
var stuck: Session = Session("/nowhere/graph.txt")
stuck.keep()
assert "Could not write " in stuck.answer("GET", "/all", "")
print "dijkstra: all checks passed"
