#!/usr/bin/env ady2nim
"""The shopping list's model, with no page and no browser: ady2nim c -r tests/test_shopping.ady"""
from shopping_model import Shopping_List, Refusal_T

var list: Shopping_List = Shopping_List()
assert list.add("milk") is None
assert list.add("bread") is None
assert list.add("milk") is Refusal_T
assert list.add("  ") is Refusal_T
assert list.left() == 2

list.toggle("milk")
assert list.left() == 1
assert list.text() == "+ milk\n- bread"

var again: Shopping_List = Shopping_List()
again.read(list.text())
assert again.text() == list.text()

list.remove("milk")
assert list.text() == "- bread"
print "shopping: all checks passed"
