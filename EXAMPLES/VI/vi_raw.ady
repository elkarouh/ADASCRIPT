#!/usr/bin/env ady2nim
"""vi_raw -- a tiny vi-like text editor (it began as vip, github.com/maksimKorzh/vip), on
the Nim backend, on the raw terminal.

    vi -raw [file]         this terminal, RawTerminal; `vi [file]` is vi_curses's

The editor is vi.ady, and its loop calls the terminal; this file is the
terminal, a RawTerminal. Nim has no curses,
so the terminal is Nim's own `terminal` module plus a raw mode set up with
`termios`: no echo, no line editing, no signals, and ^S and ^Q reach the program
instead of stopping the terminal. What a terminal has to do is here: reading a key
(an escape sequence such as an arrow key is swallowed, a lone ESC is told from one
by waiting 25 ms), drawing the screen (one frame per key, written in one go), and
the window size (read again at every key; there is no resize event).
"""
nimport terminal, termios, posix, os
from vi_protocol import Terminal, Frame_T, Look_T, Code_T

const NOTHING: int = -1                  # a key with no meaning here: a function key

# ---- the terminal ---------------------------------------------------

var original: Termios                    # the terminal as it was, to give back

def raw_mode(on: bool) -> None:
    """No echo, no line editing, no signals, no flow control: every key, ^S and
    ^Q included, comes straight to the program."""
    if not on:
        let back: cint = tcsetattr(0, TCSAFLUSH, addr(original))
        return
    let got: cint = tcgetattr(0, addr(original))
    var t: Termios = original
    t.c_iflag = t.c_iflag and not (BRKINT or ICRNL or INPCK or ISTRIP or IXON)
    t.c_oflag = t.c_oflag and not OPOST
    t.c_lflag = t.c_lflag and not (ECHO or ICANON or IEXTEN or ISIG)
    t.c_cc[VMIN] = chr(1)
    t.c_cc[VTIME] = chr(0)
    let set: cint = tcsetattr(0, TCSAFLUSH, addr(t))

def key_waiting(ms: int) -> bool:
    """Is there a byte to read, within MS milliseconds?"""
    var fds: TPollfd
    fds.fd = cint(0)
    fds.events = POLLIN
    poll(addr(fds), 1, cint(ms)) > 0

def read_byte() -> int:
    """The next byte from the keyboard, read straight from the descriptor: getch
    reads through C's buffer, which swallows the rest of an escape sequence
    where key_waiting cannot see it. The end of the input is ^Q."""
    var b: char
    let n: int = read(cint(0), addr(b), 1)
    ord(b) if n == 1 else ord(CTRL_Q)

var pushed: int = NOTHING                # a byte read ahead, to be the next key

def read_code() -> int:
    """The next key, as a code. A lone ESC is told from the start of an escape
    sequence (an arrow key: ESC [ A) by whether more bytes follow within 25 ms.
    A sequence ending in A, B, C or D is an arrow -- with a modifier too, as in
    ESC [ 1 ; 5 D -- one ending in H or F is Home or End, and ESC [ n ~ is Home (1, 7),
    End (4, 8), PageUp (5) or PageDown (6); each is read as curses' code for it, and any
    other sequence is swallowed and read as NOTHING. ESC and a character (Alt-x) is an ESC, the character kept for
    the next call."""
    if pushed != NOTHING:
        let ahead: int = pushed
        pushed = NOTHING
        return ahead
    let first: int = read_byte()
    if first != ord(ESC) or not key_waiting(25):
        return first
    let second: int = read_byte()
    if second != ord('[') and second != ord('O'):
        pushed = second
        return ord(ESC)
    var last: int = read_byte()
    var number: int = 0                                      # the first number of ESC [ n ... ~
    var counted: bool = False
    if second == ord('['):
        while not 64 <= last <= 126:                       # up to the final byte
            if last == ord(';'):
                counted = True
            elif not counted:
                number = number * 10 + (last - ord('0'))
            last = read_byte()
    let final: char = chr(last)
    case final:
        when 'A': ord(KEY_UP)
        when 'B': ord(KEY_DOWN)
        when 'C': ord(KEY_RIGHT)
        when 'D': ord(KEY_LEFT)
        when 'H': ord(KEY_HOME)
        when 'F': ord(KEY_END)
        when '~' if second != ord('['): NOTHING
        when '~':
            case number:
                when 1 | 7: ord(KEY_HOME)
                when 4 | 8: ord(KEY_END)
                when 5: ord(KEY_PPAGE)
                when 6: ord(KEY_NPAGE)
                when others: NOTHING
        when others: NOTHING

def clip(text: str, start: int, width: int) -> str:
    """WIDTH characters of TEXT from START, fewer where it ends: a slice past
    the end raises on Nim."""
    if start >= len(text) or width <= 0: return ""
    text[start:min(len(text), start + width)]

def sgr(look: Look_T) -> str:
    """The escape sequence that sets how a character looks, sent after one that cleared it."""
    case look:
        when KEYWORD: "\x1b[33m"
        when STRING: "\x1b[32m"
        when COMMENT: "\x1b[1;34m"
        when NUMBER: "\x1b[35m"
        when TYPE: "\x1b[36m"
        when CURSOR: "\x1b[7m"                        # the character under the cursor: reversed
        when BAR: "\x1b[4m"                           # in insert mode: underlined
        when others: ""

class RawTerminal(Terminal):
    def start(self):
        raw_mode(True)
        stdout.write("\x1b[?1049h")                  # the alternate screen, so the shell's stays as it was

    def stop(self):
        stdout.write("\x1b[?1049l\x1b[?25h")
        stdout.flushFile()
        raw_mode(False)

    def window(self) -> (int, int):
        """How big the window is now; a terminal that says 0 x 0 is not up yet."""
        let (w, h) = terminalSize()
        (max(w, 1), max(h, 2))

    def key(self) -> int:
        read_code()

    def draw(self, view: Frame_T):
        var frame: str = "\x1b[?25l\x1b[H"                  # hide the cursor, go home
        for i in 0 ..< view.rows:
            # the line the cursor is on has a dark grey ground (256 colours), to the right edge
            let ground: str = ("\x1b[48;5;236m" if i == view.current else "")
            var room: int = view.cols - 1
            for seg in view.lines[i]:
                if room > 0:
                    frame += "\x1b[0m" + ground + sgr(seg.look) + clip(seg.text, 0, room)
                room -= len(seg.text)
            frame += "\x1b[0m" + ground + "\x1b[K\x1b[0m\r\n"     # to the end of the line, then down
        frame += clip(view.status, 0, view.cols - 1) + "\x1b[K"
        frame += f"\x1b[{view.cursor_y + 1};{view.cursor_x + 1}H\x1b[?25h"
        stdout.write(frame)
        stdout.flushFile()

    def flash(self, cols: int, rows: int, message: str):
        stdout.write(f"\x1b[{rows + 1};1H\x1b[K" + clip(message, 0, cols - 1))
        stdout.flushFile()
        sleep(1000)

