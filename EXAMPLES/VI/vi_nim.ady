#!/usr/bin/env ady2nim
"""vi_nim -- vi.ady for the Nim backend: a tiny vi-like text editor, after vip
(github.com/maksimKorzh/vip).

    vi_nim [file]

  Normal    h j k l   0 $   gg G   x   r R   i a A o O   dd yy p   u ^R
            counts: 3dd  12G  2yy
  Anywhere  ^S saves, ^Q quits

Nim has no curses, so the terminal is Nim's own `terminal` module plus a raw
mode set up with `termios`: no echo, no line editing, no signals, and ^S and
^Q reach the program instead of stopping the terminal. The editing is vi.ady's,
line for line: the keyboard is decoded once into a Press_T and every mode is a
`case` over it. What differs is only the terminal: reading a key (an escape
sequence such as an arrow key is swallowed, a lone ESC is told from one by
waiting 25 ms), drawing the screen (one frame per key, written in one go), and
the window size (read again at every key; there is no resize event).
"""
nimport terminal, termios, posix, os

type Mode_T is enum NORMAL, INSERT, REPLACE_ONE, REPLACE, GOTO, DELETE, YANK

# What a key press means, whatever code the terminal sent for it.
type Key_T is enum CHAR, ESCAPE, ENTER, BACKSPACE, SAVE, QUIT, REDO, OTHER

type Press_T is record:
    key:  Key_T
    text: str = ""              # the character, for a CHAR; "" for the rest

type Snapshot_T is record:
    lines: []str
    row: int
    col: int

const TAG: [Mode_T]str = [NORMAL: "n", INSERT: "i", REPLACE_ONE: "r",
                          REPLACE: "R", GOTO: "g", DELETE: "d", YANK: "y"]

# The codes decode() recognises. The control keys are the letter & 0x1f.
const CTRL_Q: int = 17
const CTRL_R: int = 18
const CTRL_S: int = 19
const ESC: int = 27
const DEL: int = 127
const BACKSPACE_KEY: int = 8
const NOTHING: int = -1                  # a key with no meaning here: an arrow, a function key

def decode(ch: int) -> Press_T:
    """A key code, as what it means."""
    case ch:
        when ESC: Press_T(ESCAPE, "")
        when 10 | 13: Press_T(ENTER, "")
        when BACKSPACE_KEY | DEL: Press_T(BACKSPACE, "")
        when CTRL_S: Press_T(SAVE, "")
        when CTRL_Q: Press_T(QUIT, "")
        when CTRL_R: Press_T(REDO, "")
        when 32..126: Press_T(CHAR, str(chr(ch)))
        when others: Press_T(OTHER, "")

# ---- the terminal ---------------------------------------------------

var original: Termios                    # the terminal as it was, to give back

def raw_mode(on: bool) -> None:
    """No echo, no line editing, no signals, no flow control: every key, ^S and
    ^Q included, comes straight to the program."""
    if not on:
        let back: cint = tcsetattr(0, TCSAFLUSH, addr(original))
        return
    let got: cint = tcgetattr(0, addr(original))
    var t: Termios = original
    t.c_iflag = t.c_iflag and not (BRKINT or ICRNL or INPCK or ISTRIP or IXON)
    t.c_oflag = t.c_oflag and not OPOST
    t.c_lflag = t.c_lflag and not (ECHO or ICANON or IEXTEN or ISIG)
    t.c_cc[VMIN] = chr(1)
    t.c_cc[VTIME] = chr(0)
    let set: cint = tcsetattr(0, TCSAFLUSH, addr(t))

def key_waiting(ms: int) -> bool:
    """Is there a byte to read, within MS milliseconds?"""
    var fds: TPollfd
    fds.fd = cint(0)
    fds.events = POLLIN
    poll(addr(fds), 1, cint(ms)) > 0

def read_byte() -> int:
    """The next byte from the keyboard, read straight from the descriptor: getch
    reads through C's buffer, which swallows the rest of an escape sequence
    where key_waiting cannot see it. The end of the input is ^Q."""
    var b: char
    let n: int = read(cint(0), addr(b), 1)
    ord(b) if n == 1 else CTRL_Q

var pushed: int = NOTHING                # a byte read ahead, to be the next key

def read_code() -> int:
    """The next key, as a code. A lone ESC is told from the start of an escape
    sequence (an arrow key: ESC [ A) by whether more bytes follow within 25 ms;
    a sequence is swallowed and read as NOTHING. ESC and a character (Alt-x) is
    an ESC, the character kept for the next call."""
    if pushed != NOTHING:
        let ahead: int = pushed
        pushed = NOTHING
        return ahead
    let first: int = read_byte()
    if first != ESC or not key_waiting(25):
        return first
    let second: int = read_byte()
    if second != ord('[') and second != ord('O'):
        pushed = second
        return ESC
    var last: int = read_byte()
    if second == ord('['):
        while last < 64 or last > 126:                       # up to the final byte
            last = read_byte()
    NOTHING

def tail(text: str, start: int) -> str:
    """TEXT from START on; empty past the end, where a Nim slice would raise."""
    text[start:] if start < len(text) else ""

def splice(line: str, start: int, stop: int, text: str) -> str:
    """LINE with START up to STOP replaced by TEXT."""
    let before: str = line[:start]
    let after: str = tail(line, stop)
    before + text + after

def clip(text: str, start: int, width: int) -> str:
    """WIDTH characters of TEXT from START, fewer where it ends: a slice past
    the end raises on Nim."""
    if start >= len(text) or width <= 0:
        return ""
    text[start:min(len(text), start + width)]

def load(path: str) -> []str:
    """The lines of PATH; an empty buffer when it cannot be read -- a new file."""
    let read: []str | !PathFailure_T = Path(path).read_lines()
    if read is PathFailure_T:
        return [""]
    read if len(read) > 0 else [""]

class Editor:
    var path: str
    var lines: []str
    var yanked: []str = []
    var history: []Snapshot_T = []
    var hpos: int = 0
    var mode: Mode_T = NORMAL
    var count: str = ""
    var row: int = 0
    var col: int = 0
    var top: int = 0
    var left: int = 0
    var rows: int = 0
    var cols: int = 0

    def __init__(self, path: str):
        self.path = path
        self.lines = load(path)
        self.history = [self.snapshot()]
        self.resize()

    # ---- state ------------------------------------------------------
    def snapshot(self) -> Snapshot_T:
        Snapshot_T(list(self.lines), self.row, self.col)

    def restore(self, snap: Snapshot_T):
        self.lines = list(snap.lines)
        self.row = snap.row
        self.col = snap.col

    def record(self):
        # a snapshot only when the text really changed; any redo tail goes
        if self.lines != self.history[self.hpos].lines:
            self.history = self.history[:self.hpos + 1] + [self.snapshot()]
            self.hpos = len(self.history) - 1

    def undo(self):
        if self.hpos > 0:
            self.hpos -= 1
            self.restore(self.history[self.hpos])

    def redo(self):
        if self.hpos < len(self.history) - 1:
            self.hpos += 1
            self.restore(self.history[self.hpos])

    def times(self) -> int:
        """The count typed before the command; 1 when there is none."""
        let n: int | !ParseFailure_T = parse_int(self.count)
        case n:                              # Nim does not unwrap n in a bare `return n` after an `if`
            when ParseFailure_T: return 1
            when int: return n

    def resize(self):
        let (w, h) = terminalSize()
        self.cols = w
        self.rows = h - 1                    # the last line is the status bar

    def clamp(self):
        self.row = max(0, min(self.row, len(self.lines) - 1))
        let width: int = len(self.lines[self.row])
        let limit: int = (width if self.mode in {INSERT, REPLACE} else max(width - 1, 0))
        self.col = max(0, min(self.col, limit))

    # ---- screen -----------------------------------------------------
    def draw(self):
        self.top = max(min(self.top, self.row), self.row - self.rows + 1)
        self.left = max(min(self.left, self.col), self.col - self.cols + 1)
        var frame: str = "\x1b[?25l\x1b[H"                  # hide the cursor, go home
        for i in 0 ..< self.rows:
            let n: int = self.top + i
            let shown: str = clip(self.lines[n], self.left, self.cols - 1) if n < len(self.lines) else "~"
            frame += shown + "\x1b[K\r\n"                  # to the end of the line, then down
        let total: int = len(self.lines)
        let pct: int = (self.row + 1) * 100 // total
        let status: str = f'{TAG[self.mode]} "{self.path}" line {self.row + 1} of {total} --{pct}%-- col {self.col}'
        frame += clip(status, 0, self.cols - 1) + "\x1b[K"
        frame += f"\x1b[{self.row - self.top + 1};{self.col - self.left + 1}H\x1b[?25h"
        stdout.write(frame)
        stdout.flushFile()

    def flash(self, message: str):
        stdout.write(f"\x1b[{self.rows + 1};1H\x1b[K" + clip(message, 0, self.cols - 1))
        stdout.flushFile()
        sleep(1000)

    def save(self):
        let saved: None | !PathFailure_T = Path(self.path).write_text("\n".join(self.lines) + "\n")
        if saved is PathFailure_T:
            self.flash(f"Not saved: {saved.reason}")
        else:
            self.flash("Saved")

    # ---- editing ----------------------------------------------------
    def put_line(self, text: str):
        self.lines[self.row] = text

    def insert_line(self, at: int, text: str):
        let head: []str = self.lines[:at]
        let rest: []str = self.lines[at:]
        self.lines = head + [text] + rest

    def delete_lines(self, lo: int, hi: int):
        let head: []str = self.lines[:lo]
        let rest: []str = self.lines[hi:]
        self.lines = head + rest

    def begin_insert(self, command: char):
        """i a A o O: where the cursor goes, then insert mode."""
        case command:
            when 'a': self.col += 1
            when 'A': self.col = len(self.lines[self.row])
            when 'o':
                self.row += 1
                self.insert_line(self.row, "")
            when 'O': self.insert_line(self.row, "")
            when others: pass
        self.mode = INSERT

    def move(self, command: char):
        case command:
            when 'h': self.col -= 1
            when 'l': self.col += 1
            when 'k': self.row -= 1
            when 'j': self.row += 1
            when '0': self.col = 0
            when '$':
                self.row += self.times() - 1
                self.col = len(self.lines[min(self.row, len(self.lines) - 1)])
            when 'G': self.row = (self.times() - 1 if self.count != "" else len(self.lines) - 1)
            when others: pass

    def put(self):
        let head: []str = self.lines[:self.row + 1]
        let rest: []str = self.lines[self.row + 1:]
        self.lines = head + self.yanked + rest
        if self.yanked:
            self.row += 1

    # ---- modes ------------------------------------------------------
    def normal(self, press: Press_T):
        let line: str = self.lines[self.row]
        case press.key:
            when REDO: self.redo()
            when CHAR:
                case press.text:
                    when "i" | "a" | "A" | "o" | "O": self.begin_insert(press.text[0])
                    when "h" | "j" | "k" | "l" | "0" | "$" | "G": self.move(press.text[0])
                    when "r": self.mode = REPLACE_ONE
                    when "R": self.mode = REPLACE
                    when "g": self.mode = GOTO
                    when "d": self.mode = DELETE
                    when "y": self.mode = YANK
                    when "x": self.put_line(splice(line, self.col, self.col + 1, ""))
                    when "p": self.put()
                    when "u": self.undo()
                    when others: pass
            when others: pass
        if self.mode not in {DELETE, YANK, GOTO}:
            self.count = ""

    def insert(self, press: Press_T):
        let line: str = self.lines[self.row]
        case press.key:
            when ESCAPE:
                self.mode = NORMAL
                self.col -= 1
            when ENTER:
                self.put_line(line[:self.col])
                self.row += 1
                self.insert_line(self.row, tail(line, self.col))
                self.col = 0
            when BACKSPACE:
                if self.col > 0:
                    self.put_line(splice(line, self.col - 1, self.col, ""))
                    self.col -= 1
                elif self.row > 0:
                    self.row -= 1
                    self.col = len(self.lines[self.row])
                    let above: str = self.lines[self.row]
                    let below: str = self.lines[self.row + 1]
                    self.put_line(above + below)
                    self.delete_lines(self.row + 1, self.row + 2)
            when CHAR:
                self.put_line(splice(line, self.col, self.col, press.text))
                self.col += 1
            when others: pass

    def overwrite(self, press: Press_T):
        let line: str = self.lines[self.row]
        case press.key:
            when ESCAPE:
                self.mode = NORMAL
                self.col -= 1
            when BACKSPACE: self.col -= 1
            when CHAR:
                self.put_line(splice(line, self.col, self.col + 1, press.text))
                self.col += 1
            when others: pass

    def replace_one(self, press: Press_T):
        """r: the next character replaces the one under the cursor, once."""
        let line: str = self.lines[self.row]
        if press.key == CHAR and self.col < len(line):
            self.put_line(splice(line, self.col, self.col + 1, press.text))
        self.mode = NORMAL

    def operator(self, press: Press_T):
        """The second key of dd, yy and gg; anything else cancels."""
        let lo: int = self.row
        let hi: int = min(self.row + self.times(), len(self.lines))
        case (self.mode, press.text):
            when (DELETE, "d"):
                self.yanked = self.lines[lo:hi]
                self.delete_lines(lo, hi)
                if not self.lines:
                    self.lines = [""]
                self.col = 0
            when (YANK, "y"): self.yanked = self.lines[lo:hi]
            when (GOTO, "g"): self.row = 0
            when others: pass
        self.mode = NORMAL
        self.count = ""

    # ---- main loop --------------------------------------------------
    def run(self):
        while True:
            self.resize()                    # the window may have changed since the last key
            self.clamp()
            self.draw()
            let press: Press_T = decode(read_code())
            case press.key:
                when QUIT: return
                when SAVE:
                    self.save()
                    continue
                when others: pass
            # digits make a count -- a leading 0 is the motion, not a digit
            let counting: bool = self.mode in {NORMAL, DELETE, YANK, GOTO}
            if counting and press.text.isdigit() and (press.text != "0" or self.count != ""):
                self.count = f"{self.count}{press.text}"
                continue
            case self.mode:
                when NORMAL: self.normal(press)
                when INSERT: self.insert(press)
                when REPLACE: self.overwrite(press)
                when REPLACE_ONE: self.replace_one(press)
                when DELETE | YANK | GOTO: self.operator(press)
            self.clamp()
            self.record()

let path: str = ($1 if $# >= 1 else "noname.txt")
raw_mode(True)
stdout.write("\x1b[?1049h")                  # the alternate screen, so the shell's stays as it was
var editor: Editor = Editor(path)
editor.run()
stdout.write("\x1b[?1049l\x1b[?25h")
stdout.flushFile()
raw_mode(False)
