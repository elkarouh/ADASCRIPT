#!/usr/bin/env ady2nim
"""vi_nim -- a tiny vi-like text editor (it began as vip, github.com/maksimKorzh/vip), on
the Nim backend.

    vi_nim [file]

The editor is vi_core.ady; this file shows it on a terminal. Nim has no curses,
so the terminal is illwill (TO_NIM/STDLIB/illwill.nim, one file in pure Nim):
raw keyboard input that decodes arrow keys and tells a lone ESC from one, and a
screen buffer that writes only what changed. What is left here is small: asking
illwill for a key, drawing the rows into its buffer, and giving ^S and ^Q to the
program -- illwill leaves flow control on, so the terminal would take them.
"""
nimport illwill, termios
from vi_core import (
    Editor, Press_T, Key_T, Look_T, decode, KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT, KEY_HOME, KEY_END,
    KEY_PPAGE, KEY_NPAGE,
)

# illwill takes a style as a Nim set, which Adascript's set literal is not: three of them.
# nimraw: const STYLE_REVERSE = {styleReverse}
# nimraw: const STYLE_BAR = {styleUnderscore, styleBright}
# nimraw: const STYLE_LINE = {styleUnderscore}

def keep_flow_control_keys():
    """^S and ^Q are saved and quit here, not the terminal's stop and go."""
    var t: Termios
    let got: cint = tcgetattr(0, addr(t))
    t.c_iflag = t.c_iflag and not IXON
    let set: cint = tcsetattr(0, TCSANOW, addr(t))

def read_code() -> int:
    """The next key, as a code decode() knows. illwill reads an arrow, Home, End or Page
    key as one key of its own, with an ordinal that is no ASCII code: it becomes curses'
    code for it, which decode() knows; the other function keys stay as they are, and
    decode() takes them as OTHER."""
    while True:
        let key: Key = getKeyWithTimeout(200)
        case key:
            when Key.Up: return KEY_UP
            when Key.Down: return KEY_DOWN
            when Key.Left: return KEY_LEFT
            when Key.Right: return KEY_RIGHT
            when Key.Home: return KEY_HOME
            when Key.End: return KEY_END
            when Key.PageUp: return KEY_PPAGE
            when Key.PageDown: return KEY_NPAGE
            when Key.None: pass
            when others: return ord(key)

def draw(ed: Editor):
    ed.scroll()
    var screen: TerminalBuffer = newTerminalBuffer(ed.cols, ed.rows + 1)
    for i in 0 ..< ed.rows:
        var x: int = 0
        for seg in ed.row_segments(i):
            screen.resetAttributes()
            case seg.look:
                when KEYWORD: screen.setForegroundColor(fgYellow)
                when STRING: screen.setForegroundColor(fgGreen)
                when COMMENT: screen.setForegroundColor(fgBlue, True)
                when NUMBER: screen.setForegroundColor(fgMagenta)
                when TYPE: screen.setForegroundColor(fgCyan)
                when others: pass
            # the cursor's character is reversed, or underlined in insert mode; the line it is on is underlined
            if seg.look == CURSOR: screen.setStyle(STYLE_REVERSE)
            elif seg.look == BAR: screen.setStyle(STYLE_BAR)
            elif ed.is_current(i): screen.setStyle(STYLE_LINE)
            screen.write(x, i, seg.text)
            x += len(seg.text)
    screen.resetAttributes()
    screen.write(0, ed.rows, ed.status())
    screen.setCursorPos(ed.cursor_x(), ed.cursor_y())
    screen.display()
    showCursor()

def flash(ed: Editor, message: str):
    var line: TerminalBuffer = newTerminalBuffer(ed.cols, 1)
    line.write(0, 0, message)
    line.display()
    sleep(1000)

def fit_window(ed: Editor):
    """Tell the editor how big the window is now; a terminal that says 0 x 0 is not up yet."""
    ed.fit(max(terminalWidth(), 1), max(terminalHeight(), 2))

def run(ed: Editor):
    while True:
        fit_window(ed)                       # the window may have changed since the last key
        ed.clamp()
        draw(ed)
        let press: Press_T = decode(read_code())
        fit_window(ed)                       # ... or while it waited: a page is the window less a line
        case press.key:
            when QUIT: return
            when SAVE: flash(ed, ed.save())
            when others:
                ed.handle(press)
                if ed.quitting: return
                if ed.message != "":
                    flash(ed, ed.message)
                    ed.message = ""

let path: Path = Path($1 if $# >= 1 else "noname.txt")
illwillInit(fullScreen=True)
keep_flow_control_keys()
var editor: Editor = Editor(path)
run(editor)
illwillDeinit()
