#!/usr/bin/env ady2nim
"""vi_curses -- a tiny vi-like text editor (it began as vip, github.com/maksimKorzh/vip), on
the Nim backend.

    vi_curses [file]

The editor is vi_editor.ady, and its loop calls the terminal; this file is the
terminal, an IllwillTerminal. Nim has no curses,
so the terminal is illwill (TO_NIM/STDLIB/illwill.nim, one file in pure Nim):
raw keyboard input that decodes arrow keys and tells a lone ESC from one, and a
screen buffer that writes only what changed. What is left here is small: asking
illwill for a key, drawing the rows into its buffer, and giving ^S and ^Q to the
program -- illwill leaves flow control on, so the terminal would take them.
"""
nimport os
from termios nimport Termios, tcgetattr, IXON, tcsetattr, TCSANOW
from illwill nimport write, styleReverse, styleUnderscore, styleBright, Key, getKeyWithTimeout, illwillInit, illwillDeinit, terminalWidth, terminalHeight, TerminalBuffer, newTerminalBuffer, resetAttributes, setForegroundColor, fgYellow, fgGreen, fgBlue, fgMagenta, fgCyan, setStyle, setCursorPos, display, showCursor
from vi_editor import Editor, Terminal, edit, Frame_T, Look_T, Code_T

# illwill takes a style as a Nim set, which Adascript's set literal is not: three of them.
# nimraw: const STYLE_REVERSE = {styleReverse}
# nimraw: const STYLE_BAR = {styleUnderscore, styleBright}
# nimraw: const STYLE_LINE = {styleUnderscore}

def keep_flow_control_keys():
    """^S and ^Q are saved and quit here, not the terminal's stop and go."""
    var t: Termios
    let got: cint = tcgetattr(0, addr(t))
    t.c_iflag = t.c_iflag and not IXON
    let set: cint = tcsetattr(0, TCSANOW, addr(t))

def read_code() -> int:
    """The next key, as a code decode() knows. illwill reads an arrow, Home, End or Page
    key as one key of its own, with an ordinal that is no ASCII code: it becomes curses'
    code for it, which decode() knows; the other function keys stay as they are, and
    decode() takes them as OTHER."""
    while True:
        let key: Key = getKeyWithTimeout(200)
        case key:
            when Key.Up: return ord(KEY_UP)
            when Key.Down: return ord(KEY_DOWN)
            when Key.Left: return ord(KEY_LEFT)
            when Key.Right: return ord(KEY_RIGHT)
            when Key.Home: return ord(KEY_HOME)
            when Key.End: return ord(KEY_END)
            when Key.PageUp: return ord(KEY_PPAGE)
            when Key.PageDown: return ord(KEY_NPAGE)
            when Key.None: pass
            when others: return ord(key)

class IllwillTerminal(Terminal):
    def start(self):
        illwillInit(fullScreen=True)
        keep_flow_control_keys()

    def stop(self):
        illwillDeinit()

    def window(self) -> (int, int):
        """How big the window is now; a terminal that says 0 x 0 is not up yet."""
        (max(terminalWidth(), 1), max(terminalHeight(), 2))

    def key(self) -> int:
        read_code()

    def draw(self, view: Frame_T):
        var screen: TerminalBuffer = newTerminalBuffer(view.cols, view.rows + 1)
        for i in 0 ..< view.rows:
            var x: int = 0
            for seg in view.lines[i]:
                screen.resetAttributes()
                case seg.look:
                    when KEYWORD: screen.setForegroundColor(fgYellow)
                    when STRING: screen.setForegroundColor(fgGreen)
                    when COMMENT: screen.setForegroundColor(fgBlue, True)
                    when NUMBER: screen.setForegroundColor(fgMagenta)
                    when TYPE: screen.setForegroundColor(fgCyan)
                    when others: pass
                # the cursor's character is reversed, or underlined in insert mode; the line it is on is underlined
                if seg.look == CURSOR: screen.setStyle(STYLE_REVERSE)
                elif seg.look == BAR: screen.setStyle(STYLE_BAR)
                elif i == view.current: screen.setStyle(STYLE_LINE)
                screen.write(x, i, seg.text)
                x += len(seg.text)
        screen.resetAttributes()
        screen.write(0, view.rows, view.status)
        screen.setCursorPos(view.cursor_x, view.cursor_y)
        screen.display()
        showCursor()

    def flash(self, cols: int, rows: int, message: str):
        var line: TerminalBuffer = newTerminalBuffer(cols, 1)
        line.write(0, 0, message)
        line.display()
        sleep(1000)

var editor: Editor = Editor(Path($1 if $# >= 1 else "noname.txt"))
edit(editor, IllwillTerminal())
