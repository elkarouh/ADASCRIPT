#!/usr/bin/env ady2py
"""vi_py -- a tiny vi-like text editor, after vip (github.com/maksimKorzh/vip), on curses.

    vi_py [file]

The editor is vi_core.ady; this file shows it on a curses window. curses is
Python's, so this one is built for the Python backend (ady2py), which brings
vi_core in where it is nimported.
"""
import curses, os, time
from vi_core nimport Editor, Press_T, Key_T, decode

def draw(scr: curses.window, ed: Editor):
    ed.scroll()
    for i in 0 ..< ed.rows:
        scr.move(i, 0)
        scr.clrtoeol()
        scr.addnstr(i, 0, ed.row_text(i), ed.cols - 1)
    scr.move(ed.rows, 0)
    scr.clrtoeol()
    scr.addnstr(ed.rows, 0, ed.status(), ed.cols - 1)
    scr.move(ed.row - ed.top, ed.col - ed.left)
    scr.refresh()

def flash(scr: curses.window, ed: Editor, message: str):
    scr.move(ed.rows, 0)
    scr.clrtoeol()
    scr.addnstr(ed.rows, 0, message, ed.cols - 1)
    scr.refresh()
    time.sleep(1)

def run(scr: curses.window, ed: Editor):
    curses.raw()
    while True:
        let (rows, cols) = scr.getmaxyx()      # a resize shows up here, as KEY_RESIZE
        ed.fit(cols, rows)
        ed.clamp()
        draw(scr, ed)
        let press: Press_T = decode(scr.getch())
        case press.key:
            when QUIT: return
            when SAVE: flash(scr, ed, ed.save())
            when RESIZE: pass
            when others: ed.handle(press)

def main(scr: curses.window):
    var ed: Editor = Editor(Path($1 if $# >= 1 else "noname.txt"))
    run(scr, ed)

os.environ.setdefault("ESCDELAY", "25")
curses.wrapper(main)
