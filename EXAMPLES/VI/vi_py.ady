#!/usr/bin/env ady2py
"""vi_py -- a tiny vi-like text editor (it began as vip, github.com/maksimKorzh/vip), on curses.

    vi_py [file]

The editor is vi_core.ady; this file shows it on a curses window. curses is
Python's, so this one is built for the Python backend (ady2py), which brings
vi_core in where it is imported.
"""
pyimport curses, os, time
from vi_core import Editor, Press_T, Key_T, Look_T, decode

# A look's colour pair is its value in Look_T, from KEYWORD (1) to TYPE (5); the pair
# 10 more is the same on the line the cursor is on. PLAIN (0) has none, and CURSOR and
# BAR are drawn by attribute alone.

def setup_colors():
    """Colours on the terminal's own background; on 256 colours, the line the cursor is on
    gets a dark grey one, where 8 colours can only underline it."""
    if not curses.has_colors(): return
    curses.start_color()
    curses.use_default_colors()
    let ground: int = (236 if curses.COLORS >= 256 else -1)
    let colours: []int = [curses.COLOR_YELLOW, curses.COLOR_GREEN, curses.COLOR_BLUE, curses.COLOR_MAGENTA, curses.COLOR_CYAN]
    for k in 0 ..< 5:
        curses.init_pair(k + 1, colours[k], -1)
        curses.init_pair(k + 11, colours[k], ground)
    curses.init_pair(10, -1, ground)

def attr_of(look: Look_T, current: bool) -> int:
    """How a character of this LOOK is drawn; CURRENT: on the line the cursor is on."""
    if look == CURSOR: return curses.A_REVERSE                   # the character under the cursor
    if look == BAR: return curses.A_UNDERLINE | curses.A_BOLD    # ... in insert mode
    var attr: int = 0
    if curses.has_colors():
        let pair: int = ord(look) + (10 if current and curses.COLORS >= 256 else 0)
        attr = curses.color_pair(pair)
    if look == COMMENT: attr = attr | curses.A_BOLD              # blue is bright blue
    if current and curses.COLORS < 256: attr = attr | curses.A_UNDERLINE
    attr

def draw(scr: curses.window, ed: Editor):
    ed.scroll()
    for i in 0 ..< ed.rows:
        let current: bool = ed.is_current(i)
        scr.move(i, 0)
        scr.clrtoeol()
        if current and curses.has_colors() and curses.COLORS >= 256:
            scr.chgat(i, 0, ed.cols, curses.color_pair(10))         # the ground, to the right edge
        var x: int = 0
        for seg in ed.row_segments(i):
            if x < ed.cols - 1:
                scr.addnstr(i, x, seg.text, ed.cols - 1 - x, attr_of(seg.look, current))
            x += len(seg.text)
    scr.move(ed.rows, 0)
    scr.clrtoeol()
    scr.addnstr(ed.rows, 0, ed.status(), ed.cols - 1)
    scr.move(ed.cursor_y(), ed.cursor_x())
    scr.refresh()

def flash(scr: curses.window, ed: Editor, message: str):
    scr.move(ed.rows, 0)
    scr.clrtoeol()
    scr.addnstr(ed.rows, 0, message, ed.cols - 1)
    scr.refresh()
    time.sleep(1)

def run(scr: curses.window, ed: Editor):
    curses.raw()
    while True:
        let (rows, cols) = scr.getmaxyx()      # a resize shows up here, as KEY_RESIZE
        ed.fit(cols, rows)
        ed.clamp()
        draw(scr, ed)
        let press: Press_T = decode(scr.getch())
        let (rows2, cols2) = scr.getmaxyx()    # a page is the window less a line: the size now
        ed.fit(cols2, rows2)
        case press.key:
            when QUIT: return
            when SAVE: flash(scr, ed, ed.save())
            when RESIZE: pass
            when others:
                ed.handle(press)
                if ed.quitting: return
                if ed.message != "":
                    flash(scr, ed, ed.message)
                    ed.message = ""

def main(scr: curses.window):
    setup_colors()
    var ed: Editor = Editor(Path($1 if $# >= 1 else "noname.txt"))
    run(scr, ed)

os.environ.setdefault("ESCDELAY", "25")
curses.wrapper(main)
