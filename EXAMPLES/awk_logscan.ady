#!/usr/bin/env ady2nim
"""
awk_logscan — an application-log scanner, written the way an awk programmer
would think about it, using the parts of Adascript that awk does not have.

    ./awk_logscan < EXAMPLES/awk_logscan_sample.txt

The file holds records of two kinds. Most are timestamped events; the lines
after a failure are a stack trace, and a trace has no timestamp of its own --
only the state the scanner is in says whom those lines belong to.

So: a state machine decides which kind of record this is, each kind is
gathered into its own list of its own record type, some work is done on the
way past and the rest once both lists are complete.
"""
nimport awk


type Severity_T   is enum DEBUG, INFO, WARN, ERROR

# Where in the file we are.  A trace line carries no timestamp of its own, so
# only the state says whom it belongs to.
type Scan_State_T is enum OUTSIDE, IN_TRACE

# What the status code meant.  awk would keep these as strings in an
# associative array; naming them makes the report loop over the type itself.
type Status_T is enum SUCCESS, REDIRECT, CLIENT_ERROR, SERVER_ERROR, ODD

type Request_T is record:      # a timestamped event
    """One served request, taken apart by a single regex."""
    at:      str     = ""
    verb:    str     = ""
    path:    str     = ""
    status:  Natural = 0
    ms:      Natural = 0

type Trace_T is record:        # the lines after a failure
    """One stack trace: several lines, belonging to the request before it."""
    under:   str     = ""      # the request it followed
    lines:   Natural = 0
    failure: str     = ""      # the exception line that ends it

def status_class(status: Natural) -> Status_T:
    """A case over ranges, which awk has to spell as an if/else chain.

    Nothing here is about one scanner: a status code means the same thing
    whoever read it, so it is a function of the code and lives outside the
    class.
    """
    case status:
        when 200 .. 299: SUCCESS
        when 300 .. 399: REDIRECT
        when 400 .. 499: CLIENT_ERROR
        when 500 .. 599: SERVER_ERROR
        when others:     ODD

class LogScan(AwkBase):
    var state    : Scan_State_T          = OUTSIDE

    # One list per kind of record. Both are complete by finish().
    var requests : []Request_T           = []
    var traces   : []Trace_T             = []

    # Counted on the way past, because a total needs no second pass.
    var counts   : [Severity_T]Natural   = [DEBUG: 0, INFO: 0, WARN: 0, ERROR: 0]
    var by_status: [Status_T]Natural     = [SUCCESS: 0, REDIRECT: 0, CLIENT_ERROR: 0, SERVER_ERROR: 0, ODD: 0]
    var open_trace: Trace_T              = Trace_T()

    def _event(self, sev: Severity_T, req: Request_T) -> None:
        """On the fly: what a running total can answer without a second pass."""
        self.counts[sev] += 1
        self.by_status[status_class(req.status)] += 1

    def _outside(self) -> None:
        """Between traces: a record is an event, the start of one, or noise."""
        # One regex takes the record apart; $+1 .. $+7 are its groups.
        case self.line:
            when /^(\d{4}-\d{2}-\d{2}) (\d{2}:\d{2}:\d{2}) (\w+) +(\w+) (\S+) (\d{3}) (\d+)ms$/:
                let req: Request_T = Request_T(at=$+1 + " " + $+2, verb=$+4, path=$+5, status=int($+6), ms=int($+7))
                let sev: Severity_T = Severity_T($+3.upper())
                self.requests.append(req)
                self._event(sev, req)
            when /^Traceback |^[A-Z]\w+(Error|Exception): /:
                # A trace belongs to the request logged just before it, which
                # is the last one in the other list.
                self.open_trace = Trace_T(lines=1)
                if self.requests'Length > 0:
                    let prev: Request_T = self.requests[self.requests'Length - 1]
                    self.open_trace.under = prev.verb + " " + prev.path
                self.state = IN_TRACE
            when others:
                pass                      # a line belonging to neither kind

    def _in_trace(self) -> None:
        """Inside a trace: every record is part of it until one is not."""
        case self.line:
            when /^\d{4}-\d{2}-\d{2} /:
                # A timestamped line is not part of the trace: close it, leave
                # the state, and hand this same record to the state just
                # entered -- it is an event, and is counted as one.
                self.traces.append(self.open_trace)
                self.state = OUTSIDE
                self._outside()
            when /^([A-Z]\w+(Error|Exception)): /:
                self.open_trace.lines  += 1
                self.open_trace.failure = $+1
            when others:
                self.open_trace.lines += 1

    def process_record(self):
        """The whole dispatch: one branch per state, and nothing outside it.

        Every record is handled by the state it arrives in. Because the case
        covers both members of Scan_State_T there is no `when others:`, and
        the compiler is checking that a new state cannot be forgotten here --
        which is the point of making the state a type. In awk this is a flag
        and a condition repeated on the front of every pattern.
        """
        case self.state:
            when OUTSIDE:  self._outside()
            when IN_TRACE: self._in_trace()

    def finish(self):
        # A trace that runs to the end of the file has no following record to
        # close it, so this is where the last one gets filed.
        if self.state == IN_TRACE:
            self.traces.append(self.open_trace)

        print "--- awk_logscan ---"
        print f"records : {self.NR}"
        print f"requests: {self.requests'Length}    traces: {self.traces'Length}"

        # The running totals, already answered.
        print ""
        for s in Severity_T:
            print f"  {s'Image:<5} {self.counts[s]}"
        print ""
        for k in Status_T:
            print f"  {k'Image:<13} {self.by_status[k]}"

        # Post-processing: the questions no running total can answer, because
        # they need every record in hand before any of them has an answer.
        var times: []Natural = []
        for r in self.requests:
            times.append(r.ms)
        times = sorted(times)

        var slowest: Request_T = Request_T()
        for r in self.requests:
            if r.ms > slowest.ms:
                slowest = r

        print ""
        print f"p50     : {times[times'Length // 2]} ms"
        print f"slowest : {slowest.ms} ms  {slowest.verb} {slowest.path} at {slowest.at}"

        print ""
        for t in self.traces:
            print f"  trace   {t.lines} line(s) under {t.under} -- {t.failure}"


def main():
    var p: LogScan = LogScan()
    p.run()


main()
