# `a + b` on two list fields reached through a chain (`self.inner.xs`) is a list
# concatenation, as it is on a plain variable or a one-step field.
class Inner:
    var xs: []int
    var ys: []int
    def __init__(self):
        self.xs = [1, 2]
        self.ys = [3]

class Outer:
    var inner: Inner
    def __init__(self):
        self.inner = Inner()
    def joined(self) -> []int:
        return self.inner.xs + self.inner.ys

let o: Outer = Outer()
let both: []int = o.joined()
print len(both), both[0], both[2]
let i: Inner = Inner()
let more: []int = i.xs + i.ys
print len(more), more[1]
