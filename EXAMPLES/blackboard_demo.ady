#!/usr/bin/env ady2nim
"""blackboard_demo.ady -- knowledge sources on a blackboard, over stdlib's blackboard.ady

The blackboard holds three alarm channels. Each knowledge source is an Observer (stdlib's
blackboard.ady), one on each channel it cares about: made on a channel, it subscribes itself
there, and its `callback` is what it does with an alarm. It knows nothing of the other sources;
the publisher knows nothing of any source. The channels are named by an enum of the board's own; an alarm is
a record, so a source reads its fields by name.
"""

from blackboard import PublishChannel, Observer

type Channel_T is enum ALARM_CHANNEL_1, ALARM_CHANNEL_2, ALARM_CHANNEL_3

type Alarm is record:
    first: str
    second: str

type Alarm_Channel_T is PublishChannel[Channel_T, Alarm]     # a channel of Channel_T, carrying an Alarm

class Blackboard:
    var name: str
    var alarm_channel_1: Alarm_Channel_T
    var alarm_channel_2: Alarm_Channel_T
    var alarm_channel_3: Alarm_Channel_T

    def __init__(self, name: str):
        self.name = name
        self.alarm_channel_1 = Alarm_Channel_T(ALARM_CHANNEL_1)
        self.alarm_channel_2 = Alarm_Channel_T(ALARM_CHANNEL_2)
        self.alarm_channel_3 = Alarm_Channel_T(ALARM_CHANNEL_3)

var board: Blackboard = Blackboard("BLACKBOARD")

# A knowledge source, as it listens on one channel: it says who it is and what it heard.
class Source(Observer[Channel_T, Alarm]):
    var name: str

    def __init__(self, name: str, channel: var Alarm_Channel_T):
        super().__init__(channel)
        self.name = name

    def callback(self, channel: Channel_T, alarm: Alarm):
        print self.name, "of", board.name, "received:", alarm.first, alarm.second, "on", channel

# Source 1 listens on channels 1 and 2; source 2 on channels 2 and 3.
let source_1_on_1: Source = Source("source 1", board.alarm_channel_1)
let source_1_on_2: Source = Source("source 1", board.alarm_channel_2)
let source_2_on_2: Source = Source("source 2", board.alarm_channel_2)
let source_2_on_3: Source = Source("source 2", board.alarm_channel_3)

board.alarm_channel_1.publish(Alarm("message for chan1", "111"))
board.alarm_channel_2.publish(Alarm("message for chan2", "222"))
board.alarm_channel_3.publish(Alarm("message for chan3", ""))
