#!/usr/bin/env ady2nim
"""Test: spellings that ran on one backend only, or on neither.

`n'Image` on an int and a str; `case $1` with no argument given; an f-string
inside a shell `{!...}`; a record built from fewer positional values than it
has fields; `xs.insert(i, x)`; a mutating method called on a temporary;
`.map` and `.and_then` on a ?T, and a ?T printed; `s.sub(/re/, repl)` as an
expression; a pattern made at run time with `Regex(s)`; and an [E]T built
with `[k: v for k in E]`. Compared between the backends.
"""

type Color_T is enum RED, GREEN, BLUE
type Key_T is enum ESCAPE, CHAR

type Press_T is record:
    key: Key_T
    count: int = 5
    text: str = "-"

class Box:
    var items: []int

    def __init__(self):
        self.items = [1, 3]

class Ed:
    var n: int

    def __init__(self, n: int):
        self.n = n

    def run(self) -> int:
        self.n += 1
        return self.n

def image_of_int(n: int) -> str:
    return n'Image

def image_of_str(s: str) -> str:
    return s'Image

def half(x: int) -> ?int:
    if x % 2 == 0:
        return x // 2
    return None

def plus1(v: int) -> int:
    return v + 1

def twice() -> int:
    return Ed(5).run() + Ed(10).run()

def classify(line: str, pat: Regex) -> str:
    if line == pat:
        return f"yes {matches[1]}"
    return "no"

# 'Image
let c: Color_T = GREEN
print image_of_int(3), image_of_str("x"), c'Image, True'Image

# case on an argument that was not given
case $1:
    when "find": print "find"
    when others: print "no argument"

# an f-string in a shell interpolation
let short: str = "abc"
let rc: int = shell: echo {!f"HEAD {short}"}
print rc

# record defaults after positional values
let p: Press_T = Press_T(ESCAPE)
let q: Press_T = Press_T(CHAR, 2)
let r: Press_T = Press_T(key=CHAR)
let s: Press_T = Press_T(CHAR, text="t")
print p.key, p.count, p.text, q.count, q.text, r.count, r.text, s.count, s.text

# insert
var xs: []str = ["a", "c"]
xs.insert(1, "b")
xs.insert(0, "z")
var b: Box = Box()
b.items.insert(1, 2)
print xs, b.items

# a method on a temporary
print Ed(1).run(), twice()

# map and and_then
let m1: ?int = half(8).and_then(half).map(plus1)
let m2: ?int = half(6).and_then(half).map(plus1)
print m1, m2, half(3)

# substitution as an expression
let name: str = "Ab.GZ"
print name.sub(/\.gz$/i, ""), name.sub(/(\w)b/, "$+1x"), "a b  c".sub(/\s+/, "_")

# a pattern made at run time
let parts: []str = ["^(\\w+)", "\\.gz$"]
let first: Regex = Regex(parts[0])
let gz: Regex = Regex("(?i)" + parts[1])
print classify("abc def", first), classify("!!", first)
print name == gz, name != gz, name.sub(gz, ""), name.sub(first, "[$+1]")

# a keyed comprehension
var tens: [Color_T]int = [k: ord(k) * 10 for k in Color_T]
print tens[RED], tens[GREEN], tens[BLUE]
tens = [k: 7 for k in Color_T]
print tens[BLUE]
