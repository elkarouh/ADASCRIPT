#!/usr/bin/env ady2nim
# test_function_type.ady — `(A, B) -> R` is a function type
#
#   ady2nim EXAMPLES/test_function_type.ady -r
#   ady2py  EXAMPLES/test_function_type.ady -c
#
# A function type is written the way a `def` writes its signature: the
# parameter types in parentheses, an arrow, the result. The return type is a
# whole type, as after a def's `->`, so `(str) -> int | None` returns an
# optional int. `?` before one makes the *function* optional.
#
# `[(A, B)]V` is no longer a function: like any other `[K]V` over a key with
# no finite domain, it is a mapping in insertion order, keyed here by a tuple.
#
# Run on both backends and the outputs compared.

type Op_T is (int, int) -> int

def add(a: int, b: int) -> int:
    return a + b

def mul(a: int, b: int) -> int:
    return a * b

def inc(x: int) -> int:
    return x + 1

def parse_digit(s: str) -> int | None:
    if s >= "0" and s <= "9":
        return ord(s[0]) - ord("0")
    return None

def hello() -> None:
    print "hello"

# --- parameters and results -----------------------------------------------
def fold(op: Op_T, xs: []int, init: int) -> int:
    var acc: int = init
    for x in xs:
        acc = op(acc, x)
    return acc

def pick(name: str) -> (int, int) -> int:
    if name == "add":
        return add
    return mul

def run(cb: () -> None):
    cb()

def apply_if(f: ?(int) -> int, x: int) -> int:
    if f is None:
        return x
    return f(x)

print fold(add, [1, 2, 3], 0)            # 6
print fold(mul, [1, 2, 3, 4], 1)         # 24
print pick("mul")(6, 7)                  # 42
run(hello)                               # hello
print apply_if(inc, 1)                   # 2
print apply_if(None, 1)                  # 1

# --- stored: a variable, a list of them, a union in the result ------------
let p: (str) -> int | None = parse_digit
assert p("7") is not None and p("x") is None
var steps: [](int) -> int = [inc, inc]
var v: int = 0
for f in steps:
    v = f(v)
print v                                  # 2

# --- [(A, B)]V: a mapping keyed by a tuple, in insertion order ------------
var dist: [(int, int)]float = {:}
dist[(2, 1)] = 1.5
dist[(0, 0)] = 0.5
dist[(1, 3)] = 2.5
for d in dist.values():
    print d                              # 1.5 0.5 2.5
for p in dist:
    print f"{p[0]},{p[1]}"               # the keys: 2,1 then 0,0 then 1,3
for k, d in dist.items():
    print f"{k[0]},{k[1]}={d}"
assert (0, 0) in dist
print "test_function_type: ok"
