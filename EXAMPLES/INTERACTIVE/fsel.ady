#!/usr/bin/env ady2nim
# https://github.com/vroby65/fsel/tree/main ported to adascript
nimport os
from ansi import Style, bold, fg_blue, fg_magenta

let editor: str = $EDITOR if $EDITOR else "nano"
let tmpfile: str = "/tmp/fsel_entries"
const TAB: str = "\t"
const NL: str = "\n"
let bold_magenta: Style = bold + fg_magenta
let bold_blue:    Style = bold + fg_blue

if $# > 0:
    setCurrentDir($1)

while True:
    let cwd: str = getCurrentDir()
    let listing = shellLines: find {cwd} -maxdepth 1 -mindepth 1 -printf '%P\n' | sort
    var entries: str = bold_magenta("/") + TAB + "/" + NL + bold_magenta("..") + TAB + ".." + NL
    for item in listing:
        if len(item) == 0:
            continue
        if -d (f"{cwd}/{item}"):
            entries += bold_blue(item + "/") + TAB + item + NL
        else:
            entries += item + TAB + item + NL

    writeFile(tmpfile, entries)
    let prompt: str = cwd + " > "
    let (selection, sel_code) = shell: fzf --ansi --delimiter=$'\t' --with-nth=1 --height 40% --reverse --prompt="{prompt}" --expect=enter,right,left < {tmpfile}

    if sel_code != 0 or len(selection) == 0:
        quit(0)

    let lines: []str = selection.split("\n", 1)
    var key: str = lines[0]
    var row: str = lines[0] if len(lines) < 2 else lines[1]
    if len(lines) < 2:
        key = "enter"

    let fields: []str = row.split("\t", 1)
    let sel: str = fields[len(fields) - 1].strip()

    if key == "left":
        setCurrentDir("..")
        continue

    case sel:
        when "/" | "..":
            setCurrentDir(sel)
        when _ if -d (f"{cwd}/{sel}"):
            setCurrentDir(sel)
        when _ if key == "right" and -x (f"{cwd}/{sel}"):
            if "/" in sel:
                shell: {sel}
            else:
                shell: {cwd}/{sel}
            quit(0)
        when others:
            shell: {editor} {cwd}/{sel}
            quit(0)
