#!/usr/bin/env ady2nim
"""clsworkspace -- list the workspaces recorded in a git "configs" repository.

A small twin of the Perl tool Clsworkspace.pl (CMA5::Workspace::Config::Storage).
Each workspace is registered by one commit whose subject reads

    CONFIG <name> <json>

so the whole list is one `git log --all`. By default it reads the real local
clone of the configs repository, the one CMA5 itself uses:

    $CONFIGS_REPOSITORY_URL        where the repository is cloned from
    $CONFIGS_REPOSITORY_LOCATION   the local clone; unless set,
                                   /cm/local_build/$USER/$CMA_WORKSPACE_ROOT/cma/configs

Usage:
    clsworkspace               your workspaces
    clsworkspace --user NAME   NAME's

What it leaves out of the original: `-long`, the ClearCase-derived "BL Built?"
(always "?"), `-extra` and the `git checkout main` before listing, which `git log --all`
does not need and which would move the branch of a real clone.

Where Python raised, a function here returns `T | !ConfigFailure_T`: `git`,
`ConfigStorage.init`, `list_workspaces_config`, the lock
and the two lookups of the real repository all say in their signature that
they can fail, and `main` is the one place that turns a failure into a message.

Nim only: the lock is flock(2) and the configs are JSON.
"""

from json nimport *
nimport posix
nimport time

# --- the vocabulary -----------------------------------------------------------

type WorkspaceName_T is str     # as typed to the tool that registered it: ws_feature_a
type UserName_T      is str     # a login name
type Baseline_T      is str     # the baseline a workspace is based on: BL_42
type EnvId_T         is str     # the build environment: L8
type HostName_T      is str     # the machine that registered the workspace
type Json_T          is distinct str     # the text after "CONFIG <name> " in a commit subject

# The columns, in the order @headers lists them in Clsworkspace.pl.
type Column_T is enum COL_WORKSPACE, COL_BASED_ON, COL_ENVID, COL_BL_BUILT, COL_SS_STATE, COL_HOSTNAME
const HEADER: [Column_T]str = [
    COL_WORKSPACE: "Workspace", COL_BASED_ON: "Based On", COL_ENVID: "ENV_ID",
    COL_BL_BUILT: "BL Built?", COL_SS_STATE: "SS State", COL_HOSTNAME: "Hostname"]

type Row_T is [Column_T]str

# What went wrong, and in which step: the one failure every fallible function of
# the program returns.
type ConfigFailure_T is record:
    step:   str     # what was being done: "git fetch --prune in /cm/local_build/..."
    reason: str     # what the system said

# --- running git ----------------------------------------------------------------

def git(args: []str, cwd: Path) -> str | !ConfigFailure_T:
    """Run `git -C cwd args` and return its stdout (CMA5::Utils->run_command)."""
    let res: RunResult = run(["git", "-C", str(cwd)] + args)
    if res.code != 0:
        let words: str = " ".join(args)
        return ConfigFailure_T(f"git {words} in {cwd}", res.stderr.strip())
    return res.output

def make_dir(d: Path) -> None | !ConfigFailure_T:
    let made: None | !PathFailure_T = d.mkdir()
    if made is PathFailure_T:
        return ConfigFailure_T(f"mkdir {made.path}", made.reason)
    return None

# --- the lock ---------------------------------------------------------------------
#
# A lock scoped to THIS program only (not the real CMA5::Mutex::ConfigsRepository
# lock, whose path and format are not reproduced here). It shows the same idea:
# listing holds an exclusive lock for its whole git operation, so callers that
# arrive together queue up instead of racing a fetch against a clone.
#
# flock(2) is blocking, and dropped when the descriptor is closed, so a
# crash cannot leave the lock held.

type Lock_T is distinct int     # a descriptor holding flock(LOCK_EX)

# Nim has no flock in its posix module, and nothing here is worth a name in
# Adascript: two procs, the whole of what the lock needs from C.
# nimraw: proc c_flock(fd: cint, op: cint): cint {.importc: "flock", header: "<sys/file.h>".}
# nimraw: proc lock_fd(path: string): int = (let fd = posix.open(path.cstring, O_CREAT or O_RDWR, 0o644.Mode); if fd >= 0 and c_flock(fd, 2) != 0: (discard posix.close(fd); -2) else: int(fd))
# nimraw: proc unlock_fd(fd: int) = (discard posix.close(fd.cint))

def acquire_lock(path: Path) -> Lock_T | !ConfigFailure_T:
    let made: None | !ConfigFailure_T = make_dir(path.parent)
    if made is ConfigFailure_T:
        return made
    let fd: int = lock_fd(str(path))             # LOCK_EX: waits its turn
    if fd < 0:
        return ConfigFailure_T(f"lock {path}", "cannot create or lock the file")
    return Lock_T(fd)

def release_lock(lock: Lock_T):
    unlock_fd(int(lock))

# --- one workspace ----------------------------------------------------------------

class WorkspaceConfig:
    """The JSON blob of one 'CONFIG <name> <json>' commit, kept whole.

    Real configs carry more keys (branch, data_directory, subsystem_name,
    system_name, ...) than this tool prints, so the object keeps the parsed
    JSON and has a getter only for what is displayed -- the same bargain
    CMA5::Workspace::Config makes with its AUTOLOAD.

    Made from parsed JSON, or from the text of a commit subject. The text
    constructor can fail: not every "CONFIG ..." commit subject is
    necessarily ours, and what is not JSON, or has no name, is somebody
    else's.
    """
    var data: JsonNode

    def __init__(self, data: JsonNode):
        self.data = data

    def __init__(self, payload: Json_T) -> None | !ConfigFailure_T:
        try:
            self.data = parseJson(str(payload))
        except JsonParsingError:
            return ConfigFailure_T("CONFIG payload", "is not JSON")
        if self.data.kind != JObject or not self.data.hasKey("name"):
            return ConfigFailure_T("CONFIG payload", "is not a workspace")

    def text(self, key: str) -> str:
        """The string under key, "" when absent."""
        self.data.getOrDefault(key).getStr("")

    def row(self) -> Row_T:
        """This workspace as one line of the table."""
        var cells: Row_T = ["" for c in Column_T]
        cells[COL_WORKSPACE] = str(self.name())
        cells[COL_BASED_ON] = str(self.baseline())
        cells[COL_ENVID] = str(self.envid())
        # The real "BL Built?" is CMA5::BaselineId->is_built(), a query of a
        # ClearCase-backed build registry that is not reproduced here.
        cells[COL_BL_BUILT] = "?"
        cells[COL_SS_STATE] = self.status() or "---"
        cells[COL_HOSTNAME] = str(self.hostname())
        return cells

    def name(self) -> WorkspaceName_T:
        WorkspaceName_T(self.text("name"))

    def username(self) -> UserName_T:
        UserName_T(self.text("username"))

    def baseline(self) -> Baseline_T:
        Baseline_T(self.text("baseline"))

    def envid(self) -> EnvId_T:
        EnvId_T(self.text("envid"))

    def hostname(self) -> HostName_T:
        HostName_T(self.text("hostname"))

    def status(self) -> ?str:
        let node: JsonNode = self.data
        if node.hasKey("status"):
            return node["status"].getStr("")
        return None

# --- the configs repository ----------------------------------------------------------

class ConfigStorage:
    """Twin of CMA5::Workspace::Config::Storage (Config.pm:264-420)."""
    var path:       Path     # the local clone
    var remote_url: str
    var inited:     bool = False

    def __init__(self, path: Path, remote_url: str):
        self.path = path
        self.remote_url = remote_url

    def init(self) -> None | !ConfigFailure_T:
        """Storage::init() (Config.pm:284-359): the call behind 'slow the first
        time, fast afterwards'. A clone the first time, a fetch after that."""
        if self.inited:
            return None
        if -d self.path:
            # Steady state: an incremental fetch into the clone that is there.
            let fetched: str | !ConfigFailure_T = git(["fetch", "--prune"], self.path)
            if fetched is ConfigFailure_T:
                # Config.pm:302-304: not fatal. Fall back on what is cached.
                warn(f"Unable to contact remote repository; relying on cached data ({fetched.reason})")
        else:
            # First call ever for this location: the whole repository. Slow.
            let made: None | !ConfigFailure_T = make_dir(self.path.parent)
            if made is ConfigFailure_T:
                return made
            let cloned: RunResult = run(["git", "clone", "--quiet", self.remote_url, str(self.path)])
            if cloned.code != 0:
                return ConfigFailure_T(f"git clone {self.remote_url}", cloned.stderr.strip())
        self.inited = True
        return None

    def subjects(self) -> str | !ConfigFailure_T:
        """Every commit subject on every ref, oldest first -- init() included."""
        let ready: None | !ConfigFailure_T = self.init()
        if ready is ConfigFailure_T:
            return ready
        return git(["log", "--all", "--pretty=%s", "--reverse"], self.path)

    def list_workspaces_config(self, user: ?UserName_T) -> []WorkspaceConfig | !ConfigFailure_T:
        """list_workspaces_config() (Config.pm:389-420): one lock-protected git
        operation however many workspaces there are. Unlike the real tool it does
        not `git checkout` the default branch first -- `git log --all` covers every
        ref, and not checking out leaves your real clone on its own branch."""
        do:
            lock <- acquire_lock(self.path.parent / ".clsworkspace.lock")
        let log: str | !ConfigFailure_T = self.subjects()
        release_lock(lock)
        if log is ConfigFailure_T:
            return log

        var configs: []WorkspaceConfig = []
        for line in log.splitlines():
            continue if not line.startswith("CONFIG ")
            let (_, _, rest) = line.removeprefix("CONFIG ").partition(" ")
            let config: WorkspaceConfig | !ConfigFailure_T = WorkspaceConfig(Json_T(rest))
            continue if config is ConfigFailure_T
            configs.append(config)
        if user is None:
            return configs
        return [c for c in configs if c.username() == user]

# --- where the real repository is (CMA5::Global, Global.pm:13,45) ------------------

def current_user() -> UserName_T:
    if $USER != "":
        return UserName_T($USER)
    if $LOGNAME != "":
        return UserName_T($LOGNAME)
    return UserName_T(run(["id", "-un"]).output.strip())

def real_configs_location() -> Path | !ConfigFailure_T:
    if $CONFIGS_REPOSITORY_LOCATION != "":
        return Path($CONFIGS_REPOSITORY_LOCATION)
    if $CMA_WORKSPACE_ROOT == "":
        return ConfigFailure_T("CMA_WORKSPACE_ROOT", "is not set in the environment")
    return Path(f"/cm/local_build/{current_user()}/{$CMA_WORKSPACE_ROOT}/cma/configs")

def real_configs_url() -> str | !ConfigFailure_T:
    if $CONFIGS_REPOSITORY_URL == "":
        return ConfigFailure_T("CONFIGS_REPOSITORY_URL", "is not set in the environment")
    return $CONFIGS_REPOSITORY_URL

# --- the table ---------------------------------------------------------------------------

def print_table(rows: []Row_T):
    var widths: [Column_T]int = [len(HEADER[c]) for c in Column_T]
    for row in rows:
        for c in Column_T:
            widths[c] = max(widths[c], len(row[c]))
    let separator: str = "--".join(["-" * widths[c] for c in Column_T])
    print separator
    print "  ".join([f"{HEADER[c]:<{widths[c]}}" for c in Column_T])
    print separator
    for row in rows:
        print "  ".join([f"{row[c]:<{widths[c]}}" for c in Column_T])

# --- main(): the `eval { ... }` block of Clsworkspace.pl ----------------------------------

type Options_T is record:
    user:     ?UserName_T

def usage() -> str:
    return f"usage: {PROG} [--user NAME]"

def read_options(argv: []str) -> Options_T:
    var opt: Options_T
    var i: int = 0
    while i < len(argv):
        let arg: str = argv[i]
        case arg:
            when "-h" | "--help":
                print usage()
                quit(0)
            when "--user":
                i += 1
                die(f"--user needs a name\n{usage()}", code = 2) if i >= len(argv)
                opt.user = UserName_T(argv[i])
            when _ if arg.startswith("--user="):
                opt.user = UserName_T(arg.removeprefix("--user="))
            when others:
                die(f"unknown option {arg}\n{usage()}", code = 2)
        i += 1
    return opt

def main() -> int:
    let opt: Options_T = read_options($@)

    let location: Path | !ConfigFailure_T = real_configs_location()
    if location is ConfigFailure_T:
        die(f"{location.step} {location.reason}")
    let url: str | !ConfigFailure_T = real_configs_url()
    if url is ConfigFailure_T:
        die(f"{url.step} {url.reason}")
    var storage: ConfigStorage = ConfigStorage(location, url)

    let started: float = time.time()

    # one user's workspaces: --user's, or your own
    let who: ?UserName_T = opt.user or current_user()
    let listed: []WorkspaceConfig | !ConfigFailure_T = storage.list_workspaces_config(who)
    if listed is ConfigFailure_T:
        die(f"{listed.step}: {listed.reason}")

    let rows: []Row_T = [c.row() for c in listed]
    let elapsed: float = time.time() - started

    if len(rows) == 0:
        stderr.writeLine("(no workspaces found)")
        return 0
    print_table(rows)
    stderr.writeLine(f"\n[{elapsed:.3f}s against {storage.path}]")
    return 0

quit(main())
