# Regression tests for transpiler quirks met while porting kilo.
# Each used to emit Nim that did not compile.

# `+=` on a string field is `&=`, and makes the method mutate self
class A:
    var s: str = ""
    def add(self, t: str):
        self.s += t

def clip(t: str, n: int) -> str:
    t[:n] if n < len(t) else t

def spaces(n: int) -> str:
    " " * max(n, 0)

# `+` with a call operand is string concatenation
def f(a: str, k: int) -> str:
    clip(a, 2) + spaces(k) + "x"

def g(a: str) -> str:
    clip(a, 2) + clip(a, 1)

var a: A = A()
a.add("hi")
a.add("yo")
assert a.s == "hiyo"
assert f("abc", 2) == "ab  x"
assert g("abc") == "aba"

# join over a comprehension whose f-string holds a newline
var xs: []str = []
for i in 0 ..< 3:
    xs.append(f"l{i}\n")
assert "".join([f"l{i}\n" for i in 0 ..< 3]) == "l0\nl1\nl2\n"
assert "".join(xs) == "l0\nl1\nl2\n"

# an empty set as a record field
type Cfg_T is record:
    name: str
    words: {}str

let c: Cfg_T = Cfg_T(name="a", words={})
assert len(c.words) == 0
let d: Cfg_T = Cfg_T(name="b", words={"x"})
assert "x" in d.words

# a failure narrowed by an early return, in a method as in a function
class Holder:
    var lines: []str = []
    def load(self, text: str) -> None | !PathFailure_T:
        let p: Path = Path(text)
        return None if not -e p
        let read: []str | !PathFailure_T = p.read_lines()
        if read is PathFailure_T: return read
        for line in read:
            self.lines.append(line)
        let n: []str = [x for x in read]
        self.lines.add(str(len(n)))

def count(p: Path) -> int | !PathFailure_T:
    let read: []str | !PathFailure_T = p.read_lines()
    if read is PathFailure_T:
        return read
    len(read)

var h: Holder = Holder()
let path: Path = Path("/tmp") / "ady_nim_quirks_input.txt"
assert path.write_text("a\nb\n") is None
assert h.load(f"{path}") is None
assert h.lines == ["a", "b", "2"]
let k: int | !PathFailure_T = count(path)
assert k is int
print "ok"
