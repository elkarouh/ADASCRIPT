#!/usr/bin/env py2nim
from stdlib nimport PriorityQueue
type Node_T is enum A, B, C, D
type Distance_T is float
type Neighbour_T is tuple:
    distance: Distance_T
    neighbor: Node_T
type Graph_T is {Node_T}[]Neighbour_T

def dijkstra(graph : Graph_T, start: Node_T) -> {Node_T}Distance_T:
    distances: {Node_T}Distance_T = {node: (0.0 if node==start else Inf) for node in graph}
    var visited : {}Node_T
    queue : PriorityQueue[Neighbour_T] = [(0.0, start)]
    while queue:
        current_dist, node = queue.pop()
        if node in visited:
            continue
        visited.add(node)
        for dist, neighbor in graph[node]:
            let new_dist: Distance_T = current_dist + dist
            if new_dist < distances[neighbor]:
                distances[neighbor] = new_dist
                queue.push((new_dist, neighbor))
    return distances

# `D: []` is load-bearing. D has no outgoing edges, so it is tempting to
# leave it out -- but the distance table above is built from `for node in
# graph`, which reads the keys, and D would then not be in it. The first
# edge into D would look up a key that is not there: an unhandled KeyError
# on the last line of a program that looks right.
#
# The generic version in the bundled library seeds its table from the keys
# in exactly the same way, but relaxes with `dist.get(neighbour, Inf)`
# rather than `dist[neighbour]`, so a sink that is reached is put in the
# table by the edge that reaches it and this literal may stop at C:
#
#     nimport graphs
#     print dijkstra[Node_T]({A: [(1.0, B), (4.0, C)], B: [(2.0, C), (5.0, D)], C: [(1.0, D)]}, A)
#     # {D: 4.0, C: 3.0, A: 0.0, B: 1.0}
#
# That covers a sink, not every omission: a node left out of the keys that
# nothing reaches either is a node the walk never sees, and it is missing
# from the result instead of sitting there at Inf. Naming every node as a
# key, as this literal does, is still the rule -- it is what makes the
# table exhaustive.
#
# See TO_NIM/STDLIB/graphs.ady, which also offers shortest_path() for the
# route rather than the distances. Its `def dijkstra[Node_T](...)` names the
# node type as a parameter, so `[Node_T]` above says which one this call
# wants; both backends also infer it from the argument if the brackets are
# left off. The version here stays written out because it is what §1.4 of
# the book reads line by line.
graph : Graph_T = {A: [(1.0, B), (4.0, C)], B: [(2.0, C), (5.0, D)], C: [(1.0, D)], D: []}
print dijkstra(graph, A)
