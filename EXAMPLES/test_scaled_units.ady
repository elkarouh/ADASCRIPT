#!/usr/bin/env ady2nim
# test_scaled_units.ady — `type C is K * B`: a multiple of a unit
#
#   ady2nim EXAMPLES/test_scaled_units.ady -r
#
# `type Distance_in_km_T is 1000.0 * Distance_T` says one Distance_in_km_T is
# a thousand Distance_T. The two do not mix -- a km plus a metre is refused --
# and the conversions between them come from the declaration:
# `Distance_in_km_T(d)` of a Distance_T divides by 1000, `Distance_T(k)` of a
# Distance_in_km_T multiplies by it, and of a plain number each keeps the
# number, as any distinct type's conversion does.
#
# The factor is fixed when the program is compiled: a number, or a `const`
# float. A rate that changes as the program runs -- euros per dollar -- is a
# unit of its own, `type Rate_T is Euro_T / Dollar_T`, passed in as a value.
#
# Nim only: ady2py refuses the declaration. What is refused is checked in the
# Makefile, one line at a time.

const METRES_PER_MILE: float = 1609.344          # exact, by definition

type Distance_T          is distinct float                # metres
type Duration_T          is distinct float                # seconds
type Distance_in_km_T    is 1000.0 * Distance_T           # a km is 1000 m
type Distance_in_miles_T is METRES_PER_MILE * Distance_T  # a mile is 1609.344 m
type Distance_in_mm_T    is 0.001 * Distance_T            # a factor below one
type Velocity_T          is Distance_T / Duration_T       # m/s

def near(a: float, b: float) -> bool:
    return abs(a - b) <= 1e-9 * max(abs(b), 1.0)

def to_miles(d: Distance_T) -> Distance_in_miles_T:
    return Distance_in_miles_T(d)

# --- from the base and back -------------------------------------------------
let d: Distance_T = 42195.0
let km: Distance_in_km_T = Distance_in_km_T(d)
let mi: Distance_in_miles_T = Distance_in_miles_T(d)
let mm: Distance_in_mm_T = Distance_in_mm_T(d)
assert near(float(km), 42.195)
assert near(float(mi), 42195.0 / 1609.344)
assert near(float(mm), 42195000.0)
assert near(float(Distance_T(km)), 42195.0)
assert near(float(Distance_T(mi)), 42195.0)
assert near(float(Distance_T(mm)), 42195.0)
assert near(float(to_miles(Distance_T(1609.344))), 1.0)

# --- a plain number keeps its number ----------------------------------------
let five: Distance_in_km_T = Distance_in_km_T(5.0)
let n: int = 3
assert near(float(five), 5.0)
assert near(float(Distance_in_km_T(n)), 3.0)
assert near(float(Distance_T(2.5)), 2.5)
let x: float = 7.0
assert near(float(Distance_in_miles_T(x)), 7.0)

# --- of its own type, a conversion is the value -----------------------------
assert near(float(Distance_in_km_T(km)), 42.195)

# --- between two multiples, through the base --------------------------------
let mi_as_km: Distance_in_km_T = Distance_in_km_T(Distance_T(mi))
assert near(float(mi_as_km), 42.195)

# --- each is a unit: it scales, adds to itself, compares --------------------
var total: Distance_in_km_T = km + five
total *= 2.0
assert near(float(total), 94.39)
assert km < total
assert near(km / five, 8.439)                   # a ratio has no unit

# --- in arithmetic, the conversion gives the unit ---------------------------
let t: Duration_T = 7235.0
let v: Velocity_T = Distance_T(km) / t
assert near(float(v), 42195.0 / 7235.0)
let back: Distance_T = Distance_T(mi) + d
assert near(float(back), 84390.0)

print f"{float(km):.3f} km, {float(mi):.4f} mi, {float(mm):.0f} mm"
print f"{float(v):.4f} m/s"
print "test_scaled_units: all checks passed"
