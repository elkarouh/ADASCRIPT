"""A module that nimports a sibling (`names`, by its bare name) and is itself
nimported: a record, a class and a function returning `T | !Failure_T`."""
from names import Kind_T, Failure_T

type Shape_T is record:
    kind: Kind_T
    size: float

def parse(text: str) -> Shape_T | !Failure_T:
    case text:
        when "circle": return Shape_T(CIRCLE, 1.0)
        when "square": return Shape_T(SQUARE, 2.0)
        when "triangle": return Shape_T(TRIANGLE, 3.0)
        when others: return Failure_T(f"not a shape: {text}")

class Canvas:
    var shapes: []Shape_T = []

    def add(self, shape: Shape_T):
        self.shapes.append(shape)

    def total(self) -> float:
        var sum: float = 0.0
        for s in self.shapes:
            sum += s.size
        sum
