#!/usr/bin/env ady2nim
"""Test: a string type with a check, `type N is str where x: PREDICATE` (Nim only).

`Date_T(text)` is the check: a `Date_T | !ParseFailure_T`, taken like any
failure. A Date_T goes up to str with no cast, and is refused beside a plain
str. ady2py refuses the form.
"""

type Date_T   is str where d: d == /^\d+$/ or d == ""
type Period_T is str where p: p == /^\d{3}$/

def describe(d: Date_T) -> str:
    f"date [{d}] of length {len(d)}"

def twice(text: str) -> str | !ParseFailure_T:
    do:
        a <- Date_T(text)
        b <- Period_T("123")
    return describe(a) + " " + b

let good: Date_T | !ParseFailure_T = Date_T("20240131")
if good is ParseFailure_T:
    die("good date refused")
print describe(good)
let blank: Date_T | !ParseFailure_T = Date_T("")
if blank is ParseFailure_T:
    die("blank refused")
let bad: Date_T | !ParseFailure_T = Date_T("2024-01-31")
if bad is ParseFailure_T:
    print f"refused: {bad.what} {bad.text}"
else:
    die("bad date accepted")
let p: Period_T | !ParseFailure_T = Period_T("12")
assert p is ParseFailure_T
let t1: str | !ParseFailure_T = twice("99")
if t1 is ParseFailure_T:
    die("twice refused")
print t1
let t2: str | !ParseFailure_T = twice("x")
if t2 is ParseFailure_T:
    print t2.text
print "test_where_type OK"

# The base may be a whole number, a float or a character too; arithmetic is the base's.
type Even_T  is int   where n: n % 2 == 0
type Share_T is float where f: 0.0 <= f <= 1.0

let e: Even_T | !ParseFailure_T = Even_T(10)
if e is ParseFailure_T:
    die("10 is even")
let doubled: int = e + 1
assert doubled == 11
let odd: Even_T | !ParseFailure_T = Even_T(7)
assert odd is ParseFailure_T
let s1: Share_T | !ParseFailure_T = Share_T(0.25)
if s1 is ParseFailure_T:
    die("0.25 is a share")
print f"{s1:.2f}"
let s2: Share_T | !ParseFailure_T = Share_T(1.5)
if s2 is ParseFailure_T:
    print f"refused: {s2.what} {s2.text}"
print "test_where_type bases OK"

# The variable may be left out: the predicate then speaks of x.
type Prob_T is float where 0 <= x <= 1

def either(p: Prob_T) -> Prob_T | !ParseFailure_T:
    do:
        q <- Prob_T(1.0 - p)        # arithmetic on a Prob_T is a float: checked again to be one
    return q

let half: Prob_T | !ParseFailure_T = Prob_T(0.5)
if half is ParseFailure_T:
    die("0.5 is a probability")
let other: Prob_T | !ParseFailure_T = either(half)
if other is ParseFailure_T:
    die("1 - 0.5 is a probability")
assert float(other) == 0.5
let certain: Prob_T | !ParseFailure_T = Prob_T(1)
assert not (certain is ParseFailure_T)
let bad_p: Prob_T | !ParseFailure_T = Prob_T(1.5)
if bad_p is ParseFailure_T:
    print f"refused: {bad_p.what} {bad_p.text}"
print "test_where_type implicit x OK"

# Any type: a record, a sequence.
type Point_T is record:
    x: int
    y: int

type Origin_T  is Point_T where p: p.x == 0 and p.y == 0
type Triple_T  is []int where len(x) == 3

let o: Origin_T | !ParseFailure_T = Origin_T(Point_T(0, 0))
if o is ParseFailure_T:
    die("origin is the origin")
let off: Origin_T | !ParseFailure_T = Origin_T(Point_T(1, 0))
assert off is ParseFailure_T
let tr: Triple_T | !ParseFailure_T = Triple_T([1, 2, 3])
if tr is ParseFailure_T:
    die("three items")
assert len([1, 2, 3]) == 3
let nt: Triple_T | !ParseFailure_T = Triple_T([1, 2])
assert nt is ParseFailure_T
print "test_where_type any type OK"

# A checked type over a table of checked values: a probability distribution.
# Two levels of check: each entry is a Prob_T (between 0 and 1), and the table
# as a whole is a Pdf_T (its entries add up to 1). One does not imply the other.
type Dice_T is 1 .. 6
type Pdf_T is [Dice_T]Prob_T where pdf: abs(sum(pdf[d] for d in Dice_T) - 1.0) < 1e-9

def fair() -> Pdf_T | !ParseFailure_T:
    var table: [Dice_T]Prob_T = {:}
    for d in Dice_T:
        do:
            p <- Prob_T(1.0 / 6.0)      # a plain float is not a Prob_T until it passes its check
        table[d] = p
    return Pdf_T(table)             # the sum check: entries in 0..1 do not imply they add up to 1

def loaded() -> Pdf_T | !ParseFailure_T:
    var table: [Dice_T]Prob_T = {:}
    for d in Dice_T:
        do:
            p <- Prob_T(0.2)            # each 0.2 is a fine Prob_T ...
        table[d] = p
    return Pdf_T(table)             # ... but six of them add up to 1.2: refused here

let pf: Pdf_T | !ParseFailure_T = fair()
if pf is ParseFailure_T:
    die("a fair die sums to 1")
let pl: Pdf_T | !ParseFailure_T = loaded()
assert pl is ParseFailure_T
print "test_where_type pdf OK"
