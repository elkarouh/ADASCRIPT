#!/usr/bin/env ady2nim
"""Test: a string type with a check, `type N is str where x: PREDICATE` (Nim only).

`Date_T(text)` is the check: a `Date_T | !ParseFailure_T`, taken like any
failure. A Date_T goes up to str with no cast, and is refused beside a plain
str. ady2py refuses the form.
"""

type Date_T   is str where d: d == /^\d+$/ or d == ""
type Period_T is str where p: p == /^\d{3}$/

def describe(d: Date_T) -> str:
    f"date [{d}] of length {len(d)}"

def twice(text: str) -> str | !ParseFailure_T:
    do:
        a <- Date_T(text)
        b <- Period_T("123")
    return describe(a) + " " + b

let good: Date_T | !ParseFailure_T = Date_T("20240131")
if good is ParseFailure_T:
    die("good date refused")
print describe(good)
let blank: Date_T | !ParseFailure_T = Date_T("")
if blank is ParseFailure_T:
    die("blank refused")
let bad: Date_T | !ParseFailure_T = Date_T("2024-01-31")
if bad is ParseFailure_T:
    print f"refused: {bad.what} {bad.text}"
else:
    die("bad date accepted")
let p: Period_T | !ParseFailure_T = Period_T("12")
assert p is ParseFailure_T
let t1: str | !ParseFailure_T = twice("99")
if t1 is ParseFailure_T:
    die("twice refused")
print t1
let t2: str | !ParseFailure_T = twice("x")
if t2 is ParseFailure_T:
    print t2.text
print "test_where_type OK"

# The base may be a whole number, a float or a character too; arithmetic is the base's.
type Even_T  is int   where n: n % 2 == 0
type Share_T is float where f: 0.0 <= f <= 1.0

let e: Even_T | !ParseFailure_T = Even_T(10)
if e is ParseFailure_T:
    die("10 is even")
let doubled: int = e + 1
assert doubled == 11
let odd: Even_T | !ParseFailure_T = Even_T(7)
assert odd is ParseFailure_T
let s1: Share_T | !ParseFailure_T = Share_T(0.25)
if s1 is ParseFailure_T:
    die("0.25 is a share")
print f"{s1:.2f}"
let s2: Share_T | !ParseFailure_T = Share_T(1.5)
if s2 is ParseFailure_T:
    print f"refused: {s2.what} {s2.text}"
print "test_where_type bases OK"
