#!/usr/bin/env ady2nim
"""Test: `nimport M` binds M, as Python's `import M` does, so M's names are
reached as `M.name`, on both backends. A module nimported by a path is
qualified by its last part, as in Nim: `NIMPORT_TEST/shapes` is `shapes`.
`from M nimport A` still gives A unqualified, and both forms meet in one file:
`sh.Shape_T` and `names.SQUARE` below are qualified, `label` is from the
from-list. A name of the file's own may be a module's name too: `run` below
is this file's, `names.run` the module's.
The output is compared between the backends (see the Makefile).
"""
import NIMPORT_TEST/shapes as sh, NIMPORT_TEST/names
from NIMPORT_TEST/names import label as name_of

def describe(text: str) -> str:
    let parsed: sh.Shape_T | !names.Failure_T = sh.parse(text)
    if parsed is names.Failure_T:
        return parsed.description
    return f"{name_of(parsed.kind)}, size {parsed.size}"

for text in ["circle", "square", "hexagon"]:
    print describe(text)

var canvas: sh.Canvas = sh.Canvas()
canvas.add(sh.Shape_T(names.SQUARE, 2.5))
print f"total {canvas.total()}"

def run(n: int) -> int:
    return n + 1

print names.run(21), run(21)
print "test_nimport_qualified OK"
