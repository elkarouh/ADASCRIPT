#!/usr/bin/env py2nim
"""SARSA (on-policy TD control) on the Windy Gridworld.

Reference: Sutton & Barto — "Reinforcement Learning", Example 6.5
Grid: 7 rows x 10 cols.  Start: (3,0).  Goal: (3,7).
Wind pushes the agent upward by 1-2 cells in columns 3-8.

Key insight — SARSA is on-policy:
  Q(s,a) += alpha * [r + gamma*Q(s', a') - Q(s,a)]
where a' is the epsilon-greedy action the agent will *actually* take next.
This makes SARSA conservative: exploration mistakes count against it.
"""
nimport random
nimport sequtils

# ─── environment constants ────────────────────────────────────────
const ROWS:  int = 7
const COLS:  int = 10
const N_S:   int = 70    # ROWS * COLS
const START: int = 30    # row 3, col 0  (3*10+0)
const GOAL:  int = 37    # row 3, col 7  (3*10+7)

type Action_T is enum UP, RIGHT, DOWN, LEFT

# wind strength (upward push in rows) per column
let WIND: []int = [0, 0, 0, 1, 1, 1, 2, 2, 1, 0]

# ─── environment step ────────────────────────────────────────────
def clamp(v: int, lo: int, hi: int) -> int:
    lo if v < lo else (hi if v > hi else v)

def env_step(state: int, action: Action_T) -> (int, float, bool):
    """Deterministic step — returns (next_state, reward, done)."""
    let row: int = state // COLS
    let col: int = state % COLS
    var nr: int = row
    var nc: int = col
    # wind pushes upward based on the original column
    case action:
        when UP:    nr -= 1
        when RIGHT: nc += 1
        when DOWN:  nr += 1
        when LEFT:  nc -= 1
    nr = clamp(nr - WIND[col], 0, ROWS - 1)
    nc = clamp(nc, 0, COLS - 1)
    let ns: int = nr * COLS + nc
    return (ns, -1.0, ns == GOAL)

# ─── Q-table ─────────────────────────────────────────────────────
type QTable_T is {int}[Action_T]float

# ─── epsilon-greedy action selection ─────────────────────────────
def choose_action(qtable: lent QTable_T, state: int, epsilon: float) -> Action_T:
    let base: float = epsilon / 4.0
    var probs: [Action_T]float = [UP: base, RIGHT: base, DOWN: base, LEFT: base]
    let qrow: [Action_T]float = qtable[state]
    probs[Action_T(qrow.maxIndex)] += 1.0 - epsilon
    # weighted random draw from probability distribution
    let r: float = rand(1.0)
    var cum: float = 0.0
    for a in Action_T:
        cum += probs[a]
        if r < cum: return a
    return Action_T'Last

# ─── SARSA algorithm ─────────────────────────────────────────────
def sarsa(num_episodes: int, alpha: float = 0.5,
          epsilon: float = 0.1, gamma: float = 1.0) -> QTable_T:
    randomize()
    var qtable: QTable_T = {s: [UP: 0.0, RIGHT: 0.0, DOWN: 0.0, LEFT: 0.0] for s in 0..N_S-1}
    var bucket_rew: float = 0.0

    for ep in 1..num_episodes:
        var state:  int = START
        var action: Action_T = choose_action(qtable, state, epsilon)

        while True:
            let (ns, rew, done) = env_step(state, action)
            let na: Action_T = choose_action(qtable, ns, epsilon)

            # on-policy update: bootstrap from the action we will actually take
            var row: [Action_T]float = qtable[state]
            let qns: [Action_T]float = qtable[ns]
            let td_err: float = rew + gamma * qns[na] - row[action]
            row[action] += alpha * td_err
            qtable[state] = row

            bucket_rew += rew
            state  = ns
            action = na
            if done: break

        if ep % 100 == 0:
            let avg: float = bucket_rew / 100.0
            print(f"Episode {ep}/{num_episodes}  avg reward/ep: {avg}")
            bucket_rew = 0.0

    return qtable

# ─── display learned policy ──────────────────────────────────────
def print_policy(qtable: lent QTable_T):
    let arrows: [Action_T]str = [UP: "^", RIGHT: ">", DOWN: "v", LEFT: "<"]
    print("\nLearned greedy policy  (G=goal, S=start):")
    for r in 0..ROWS-1:
        var line: str = "  "
        for c in 0..COLS-1:
            let s: int = r * COLS + c
            if s == GOAL:    line &= "G "
            elif s == START: line &= "S "
            else:
                let qrow: [Action_T]float = qtable[s]
                line &= arrows[Action_T(qrow.maxIndex)] & " "
        print(line)
    print("  Wind: 0 0 0 1 1 1 2 2 1 0")
    print("         (columns 3-8 push agent upward)")

let q_sarsa: QTable_T = sarsa(500)
print_policy(q_sarsa)
