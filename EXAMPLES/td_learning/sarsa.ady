#!/usr/bin/env py2nim
"""SARSA (on-policy TD control) on the Windy Gridworld.

Original Python: https://github.com/dennybritz/reinforcement-learning/blob/master/TD/SARSA%20Solution.ipynb
Reference: Sutton & Barto — "Reinforcement Learning", Example 6.5
Grid: 7 rows x 10 cols.  Start: (4,1).  Goal: (4,8).
Wind pushes the agent upward by 1-2 cells in columns 4-9.

Key insight — SARSA is on-policy:
  Q(s,a) += alpha * [r + gamma*Q(s', a') - Q(s,a)]
where a' is the epsilon-greedy action the agent will *actually* take next.
This makes SARSA conservative: exploration mistakes count against it.
"""
nimport random
nimport sequtils

# ─── environment constants ────────────────────────────────────────
type Row_T      is 1..7
type Col_T      is 1..10
type Coord_T    is (row: Row_T, col: Col_T)
type Action_T   is enum UP, RIGHT, DOWN, LEFT
type Prob_T     is float range 0..1
type Reward_T   is float

const START: Coord_T = (4, 1)
const GOAL:  Coord_T = (4, 8)

# wind strength (upward push in rows) per column
let WIND: [Col_T]int = [0, 0, 0, 1, 1, 1, 2, 2, 1, 0]

# ─── environment step ────────────────────────────────────────────
def env_step(state: Coord_T, action: Action_T) -> (Coord_T, Reward_T, bool):
    """Deterministic step — returns (next_state, reward, done)."""
    var nr: int = state.row
    var nc: int = state.col
    # wind pushes upward based on the original column
    case action:
        when UP:    nr -= 1
        when RIGHT: nc += 1
        when DOWN:  nr += 1
        when LEFT:  nc -= 1
    nr = clamp(nr - WIND[state.col], Row_T'First, Row_T'Last)
    nc = clamp(nc, Col_T'First, Col_T'Last)
    let ns: Coord_T = (nr, nc)
    return (ns, -1.0, ns == GOAL)

# ─── Q-table ─────────────────────────────────────────────────────
type QTable_T is {Coord_T}[Action_T]Reward_T

# ─── epsilon-greedy action selection ─────────────────────────────
def choose_action(qtable: lent QTable_T, state: Coord_T, epsilon: Prob_T) -> Action_T:
    let base: Prob_T = epsilon / 4.0
    var probs: [Action_T]Prob_T = [UP: base, RIGHT: base, DOWN: base, LEFT: base]
    let qrow: [Action_T]Reward_T = qtable[state]
    probs[Action_T(qrow.maxIndex)] += 1.0 - epsilon
    # weighted random draw from probability distribution
    let r: Prob_T = rand(1.0)
    var cum: Prob_T = 0.0
    for a in Action_T:
        cum += probs[a]
        if r < cum: return a
    return Action_T'Last

# ─── SARSA algorithm ─────────────────────────────────────────────
def sarsa(num_episodes: int, alpha: Prob_T = 0.5,
          epsilon: Prob_T = 0.1, gamma: Prob_T = 1.0) -> QTable_T:
    randomize()
    var qtable: QTable_T = {(r, c): [UP: 0.0, RIGHT: 0.0, DOWN: 0.0, LEFT: 0.0] for r in Row_T for c in Col_T}
    var bucket_rew: Reward_T = 0.0

    for ep in 1..num_episodes:
        var state:  Coord_T = START
        var action: Action_T = choose_action(qtable, state, epsilon)

        while True:
            let (ns, rew, done) = env_step(state, action)
            let na: Action_T = choose_action(qtable, ns, epsilon)

            # on-policy update: bootstrap from the action we will actually take
            var row: [Action_T]Reward_T = qtable[state]
            let qns: [Action_T]Reward_T = qtable[ns]
            let td_err: Reward_T = rew + gamma * qns[na] - row[action]
            row[action] += alpha * td_err
            qtable[state] = row

            bucket_rew += rew
            state  = ns
            action = na
            if done: break

        if ep % 100 == 0:
            let avg: Reward_T = bucket_rew / 100.0
            print f"Episode {ep}/{num_episodes}  avg reward/ep: {avg}"
            bucket_rew = 0.0

    return qtable

# ─── display learned policy ──────────────────────────────────────
def print_policy(qtable: lent QTable_T):
    let arrows: [Action_T]str = [UP: "^", RIGHT: ">", DOWN: "v", LEFT: "<"]
    print "\nLearned greedy policy  (G=goal, S=start):"
    for r in Row_T:
        var line: str = "  "
        for c in Col_T:
            let s: Coord_T = (r, c)
            if s == GOAL:    line &= "G "
            elif s == START: line &= "S "
            else:
                let qrow: [Action_T]Reward_T = qtable[s]
                line &= arrows[Action_T(qrow.maxIndex)] & " "
        print line
    print "  Wind: 0 0 0 1 1 1 2 2 1 0"
    print "         (columns 4-9 push agent upward)"

let q_sarsa: QTable_T = sarsa(500)
print_policy(q_sarsa)
