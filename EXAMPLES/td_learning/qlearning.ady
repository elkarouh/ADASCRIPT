#!/usr/bin/env py2nim
"""Q-Learning (off-policy TD control) on the Cliff Walking problem.

Reference: Sutton & Barto — "Reinforcement Learning", Example 6.6
Grid: 4 rows x 12 cols.  Start: (3,0).  Goal: (3,11).
Cliff: row 3, cols 1-10 — stepping there gives reward -100 and ends episode.

Key insight — Q-Learning is off-policy:
  Q(s,a) += alpha * [r + gamma*max_a' Q(s', a') - Q(s,a)]
It always bootstraps from the BEST possible next action, not the one taken.
This learns the optimal (cliff-edge) path, while SARSA would stay a row above.
"""
nimport random
nimport sequtils

# ─── environment constants ────────────────────────────────────────
const ROWS: int = 4
const COLS: int = 12

type Row_T      is 0..ROWS-1
type Col_T      is 0..COLS-1
type Coord_T    is (row: Row_T, col: Col_T)
type Action_T   is enum UP, RIGHT, DOWN, LEFT
type Prob_T     is float range 0..1
type Reward_T   is float

const START: Coord_T = (3, 0)
const GOAL:  Coord_T = (3, 11)

# ─── environment step ────────────────────────────────────────────
def is_cliff(state: Coord_T) -> bool:
    state.row == 3 and 1 <= state.col <= 10

def clamp(v: int, lo: int, hi: int) -> int:
    lo if v < lo else (hi if v > hi else v)

def env_step(state: Coord_T, action: Action_T) -> (Coord_T, Reward_T, bool):
    """Returns (next_state, reward, done).
    Falling off the cliff resets to START with reward -100."""
    var nr: int = state.row
    var nc: int = state.col
    case action:
        when UP:    nr -= 1
        when RIGHT: nc += 1
        when DOWN:  nr += 1
        when LEFT:  nc -= 1
    nr = clamp(nr, 0, ROWS - 1)
    nc = clamp(nc, 0, COLS - 1)
    let ns: Coord_T = (nr, nc)
    if is_cliff(ns):
        return (START, -100.0, True)   # fell off cliff — big penalty, episode ends
    if ns == GOAL:
        return (ns, -1.0, True)
    return (ns, -1.0, False)

# ─── Q-table ─────────────────────────────────────────────────────
type QTable_T is {Coord_T}[Action_T]Reward_T

# ─── epsilon-greedy action selection ─────────────────────────────
def choose_action(qtable: lent QTable_T, state: Coord_T, epsilon: Prob_T) -> Action_T:
    let base: Prob_T = epsilon / 4.0
    var probs: [Action_T]Prob_T = [UP: base, RIGHT: base, DOWN: base, LEFT: base]
    let qrow: [Action_T]Reward_T = qtable[state]
    probs[Action_T(qrow.maxIndex)] += 1.0 - epsilon
    # weighted random draw from probability distribution
    let r: Prob_T = rand(1.0)
    var cum: Prob_T = 0.0
    for a in Action_T:
        cum += probs[a]
        if r < cum: return a
    return Action_T'Last

# ─── Q-Learning algorithm ─────────────────────────────────────────
def q_learning(num_episodes: int, alpha: Prob_T = 0.5,
               epsilon: Prob_T = 0.1, gamma: Prob_T = 1.0) -> QTable_T:
    randomize()
    var qtable: QTable_T = {(r, c): [UP: 0.0, RIGHT: 0.0, DOWN: 0.0, LEFT: 0.0] for r in 0..ROWS-1 for c in 0..COLS-1}
    var bucket_rew: Reward_T = 0.0

    for ep in 1..num_episodes:
        var state: Coord_T = START

        while True:
            let action: Action_T = choose_action(qtable, state, epsilon)
            let (ns, rew, done) = env_step(state, action)

            # off-policy update: bootstrap from the best possible next action
            var row: [Action_T]Reward_T = qtable[state]
            let qns: [Action_T]Reward_T = qtable[ns]
            let td_err: Reward_T = rew + gamma * max(qns) - row[action]
            row[action] += alpha * td_err
            qtable[state] = row

            bucket_rew += rew
            state = ns
            if done: break

        if ep % 100 == 0:
            let avg: Reward_T = bucket_rew / 100.0
            print(f"Episode {ep}/{num_episodes}  avg reward/ep: {avg}")
            bucket_rew = 0.0

    return qtable

# ─── display learned policy ──────────────────────────────────────
def print_policy(qtable: lent QTable_T):
    let arrows: [Action_T]str = [UP: "^", RIGHT: ">", DOWN: "v", LEFT: "<"]
    print("\nLearned greedy policy  (G=goal, S=start, C=cliff):")
    for r in 0..ROWS-1:
        var line: str = "  "
        for c in 0..COLS-1:
            let s: Coord_T = (r, c)
            if s == GOAL:      line &= "G "
            elif s == START:   line &= "S "
            elif is_cliff(s):  line &= "C "
            else:
                let qrow: [Action_T]Reward_T = qtable[s]
                line &= arrows[Action_T(qrow.maxIndex)] & " "
        print(line)
    print("  (Q-Learning learns the cliff-edge path; SARSA stays one row above)")

let q_ql: QTable_T = q_learning(500)
print_policy(q_ql)
