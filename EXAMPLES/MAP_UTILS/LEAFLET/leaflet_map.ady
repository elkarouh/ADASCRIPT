#!/usr/bin/env ady2nim
#ady2nim-args js
"""leaflet_map -- route_check on a map, with Leaflet.js, in the browser.

    ady2nim js leaflet_map.ady     (writes leaflet_map.js; leaflet_map.html loads it)

The same drawing as route_map.ady, without Python: map_utils works the route out
(map_geo, regions, route_check), and this script hands the points to the stdlib's
`leaflet_utils`, which draws them with Leaflet, loaded from a CDN by leaflet_map.html. It draws

  * the route, coloured by the airspace it is in: red where it is restricted, green in the
    approach funnel where it may be used, blue elsewhere;
  * the airspace: the polygon R-1, the circle R-2 and the approach funnel;
  * the airports, with what the leg to each takes;
  * the holding pattern round Marseille.

Click the map: the popup gives the place's distance and bearing from Brussels, worked out
by map_geo (`GeoPoint - GeoPoint`, the Vincenty inverse formula).
"""
from map_base import Degree_T, Kilometers_T, Latitude_T, Longitude_T
from units import metre_T
from map_geo import GeoPoint, GeoVector, must
from regions import Region
from route_check import Airport_T, ROUTE, R2_CENTRE, R2_RADIUS, FUNNEL_HEADING, FUNNEL_HALF_ANGLE, FUNNEL_RANGE
from route_check import HOLD_RADIUS, HOLD_POINTS, CRUISE, Hours_T, Airspace_T
from route_check import position_of, outline, airspace, holding_pattern, hours_minutes
from leaflet_utils import Map_T, Point_T, Style_T, style, new_map, fit, polyline, polygon, circle, dot, pin, popup_at, on_click

# What the route is in: the colour of a stretch of it.
type Cover_T is enum PLAIN_LEG, RESTRICTED_LEG, FUNNEL_LEG
const COLOUR: [Cover_T]str = [PLAIN_LEG: "#1f78b4", RESTRICTED_LEG: "#e31a1c", FUNNEL_LEG: "#33a02c"]
const MEANING: [Cover_T]str = [PLAIN_LEG: "open airspace", RESTRICTED_LEG: "restricted", FUNNEL_LEG: "approach funnel, unrestricted"]

def cover_at(point: GeoPoint, air: Airspace_T) -> Cover_T:
    return RESTRICTED_LEG if point in air.restricted
    return FUNNEL_LEG if point in air.open_funnel
    return PLAIN_LEG

# GeoPoints, as the map has them.
def spots(points: []GeoPoint) -> []Point_T:
    return [p.latlng() for p in points]

# ---- the route ---------------------------------------------------------------------------

def line(map: Map_T, points: []GeoPoint, cover: Cover_T, label: str):
    polyline(map, spots(points), style(COLOUR[cover], weight=5), tip=f"{label}: {MEANING[cover]}")

def draw_leg(map: Map_T, start: GeoPoint, leg: GeoVector, air: Airspace_T, label: str):
    """A leg as polylines, a new one wherever the airspace changes, joined end to start."""
    let total: float = float(leg.magnitude())
    var points: []GeoPoint = []
    var cover: Cover_T = PLAIN_LEG
    for k in 0 .. int(total):
        let here: GeoPoint = start + leg * (float(k) / total if total > 0.0 else 0.0)
        let now: Cover_T = cover_at(here, air)
        if k > 0 and now != cover:
            points.append(here)                     # the old stretch ends where the new one starts
            line(map, points, cover, label)
            points = []
        points.append(here)
        cover = now
    points.append(start + leg)                      # the airport itself, which the last kilometre falls short of
    line(map, points, cover, label)

# ---- the airspace --------------------------------------------------------------------------

def funnel_outline(apex: GeoPoint) -> []GeoPoint:
    """The outline of the wedge: the apex, then points every 2.5 degrees along its far edge."""
    var points: []GeoPoint = [apex]
    let first: float = float(FUNNEL_HEADING) - float(FUNNEL_HALF_ANGLE)
    let steps: int = int(2.0 * float(FUNNEL_HALF_ANGLE) / 2.5)
    for k in 0 .. steps:
        points.append(apex + GeoVector(FUNNEL_RANGE, Degree_T(first + 2.5 * float(k))))
    return points

def draw_airspace(map: Map_T, apex: GeoPoint):
    let red: Style_T = style("#e31a1c", weight=2, fill=0.18)
    polygon(map, spots(outline()), red, tip="R-1: restricted area")
    circle(map, must(GeoPoint(R2_CENTRE)).latlng(), float(metre_T(R2_RADIUS)), red, tip="R-2: restricted circle")
    polygon(map, spots(funnel_outline(apex)), style("#33a02c", weight=2, fill=0.1), tip="Approach funnel")

# ---- the page ------------------------------------------------------------------------------

let brussels: GeoPoint = position_of(ROUTE[0])
let apex: GeoPoint = position_of(ROUTE[len(ROUTE) - 1])
let air: Airspace_T = airspace()
let map: Map_T = new_map("map")

var points: []GeoPoint = []
for a in ROUTE:
    points.append(position_of(a))

for i in 1 ..< len(points):
    draw_leg(map, points[i - 1], points[i] - points[i - 1], air, f"{ROUTE[i - 1]} to {ROUTE[i]}")

draw_airspace(map, apex)

for i in 0 ..< len(points):
    var note: str = f"<b>{ROUTE[i]}</b><br>{points[i].human()}"
    if i > 0:
        let leg: GeoVector = points[i] - points[i - 1]
        let hours: Hours_T = leg.magnitude() / CRUISE
        note = f"{note}<br>{leg.magnitude():.1f} km from {ROUTE[i - 1]}, {hours_minutes(hours)} at {int(float(CRUISE))} km/h"
    pin(map, points[i].latlng(), note)

let purple: Style_T = style("#6a3d9a", weight=2, dashed=True)
for hold in holding_pattern(apex, HOLD_RADIUS, HOLD_POINTS):
    dot(map, hold.latlng(), purple)
circle(map, apex.latlng(), float(metre_T(HOLD_RADIUS)), purple, tip="holding pattern")

fit(map, spots(points + [apex] + outline()))

# A click on the map: how far and which way from Brussels, by map_geo.
def clicked(at: Point_T):
    let here: GeoPoint = GeoPoint(Latitude_T(at.lat), Longitude_T(at.lng))
    popup_at(map, at, f"{here.human()}<br>{here - brussels}")

on_click(map, clicked)
