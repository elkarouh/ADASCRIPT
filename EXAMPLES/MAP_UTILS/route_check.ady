#!/usr/bin/env ady2nim
"""route_check -- a flight route checked with map_utils.

    route_check

A route through four airports is flown over a restricted area.  The program:

  1. reads the airports' positions from DMS strings -- and shows what happens to
     a string that is not one;
  2. measures each leg with `GeoPoint - GeoPoint` (a GeoVector: a distance and a
     bearing) and works out how long it takes at the cruising speed: a
     Kilometers_T over a Speed_T is Hours_T, and the compiler knows it;
  3. describes the airspace as regions -- a polygon, a circle, a wedge -- composed with
     `&`, `|` and `~` (regions.ady, the algebra of geo_server.ady on the Earth's
     surface), walks along each leg with `GeoPoint + GeoVector * fraction`, and asks
     `point in region` where the leg is inside what;
  4. takes a plane that has strayed from a leg and finds how far to the side it is
     and how far along: on the flat plane, with Vector and Position, where a dot
     product and a cross product do it;
  5. builds a holding pattern -- points on a circle round a beacon -- by turning one
     point round the beacon with `rotate_around_point`;

and checks what it printed: the legs add up, the pattern is a circle, the plane is
the distance to the side it was put at.
"""
from map_utils import GeoPoint, GeoVector, Vector, Position, GeoFailure_T, LatLong_T
from map_utils import Kilometers_T, Meters_T, Degrees_T, Bearing_T, SquareMeters_T
from map_utils import geo_point_from_dms, human_latlong2dec, vector_xy, must
from regions import Region, Circle, Sector, Polygon

# ---- the data ------------------------------------------------------------------

type Airport_T is enum EBBR, LFPG, LFLL, LFML

const POSITION: [Airport_T]str = [
    EBBR: "505405N 0042904E",              # Brussels
    LFPG: "490035N 0023252E",              # Paris Charles de Gaulle
    LFLL: "454336N 0050500E",              # Lyon
    LFML: "432615N 0051313E",              # Marseille
]
const ROUTE: []Airport_T = [EBBR, LFPG, LFLL, LFML]

# R-1, a restricted area, as the corners of its outline, in order.
const RESTRICTED: []str = [
    "473000N 0034000E", "473000N 0044500E", "463000N 0044500E", "463000N 0034000E",
]

# R-2, a restricted circle of 20 km, and the approach to Marseille: a wedge of 25 degrees
# either side of north, 150 km deep.
const R2_CENTRE: str = "443600N 0050900E"
const FUNNEL_HEADING: Bearing_T = 355.0

# The kinds of airspace the route is checked against; the last is made of the others.
type Zone_T is enum R1, R2, FUNNEL, OPEN_FUNNEL
const ZONE_LABEL: [Zone_T]str = [R1: "R-1", R2: "R-2", FUNNEL: "approach funnel", OPEN_FUNNEL: "funnel, unrestricted"]

type Hours_T is distinct float
type Speed_T is Kilometers_T / Hours_T                      # kilometres an hour
let CRUISE: Speed_T = 780.0

# Which side of the track: the sign of the cross product, left of where it points
# being the counter-clockwise side.
type Side_T is enum LEFT, RIGHT, ON_TRACK

def side_of_track(cross_track: Meters_T) -> Side_T:
    """Which side a cross-track distance is on; within half a metre of the track is on it."""
    return ON_TRACK if -0.5 <= cross_track <= 0.5
    return RIGHT if cross_track < 0.0
    return LEFT

def position_of(airport: Airport_T) -> GeoPoint:
    must(geo_point_from_dms(POSITION[airport]))

def outline() -> []GeoPoint:
    return [must(geo_point_from_dms(corner)) for corner in RESTRICTED]

def hours_minutes(time: Hours_T) -> str:
    let minutes: int = int(float(time) * 60.0 + 0.5)
    f"{minutes // 60}h{minutes % 60:02d}"

# ---- 1. positions, and a string that is not one -----------------------------------

def refusal(text: str) -> str:
    let r: LatLong_T | !GeoFailure_T = human_latlong2dec(text)
    if r is GeoFailure_T:
        return r.detail
    return "ok"

# ---- 3. a leg against the restricted area -----------------------------------------

type Run_T is record:
    first: int                 # the kilometre along the leg it goes in
    last:  int                 # the kilometre it is last in

def runs(start: GeoPoint, leg: GeoVector, region: Region) -> []Run_T:
    """The stretches of a leg that are inside REGION, tested at every kilometre along it."""
    let total: float = float(leg.magnitude())
    var found: []Run_T = []
    var open_at: int = -1
    for k in 0 .. int(total):
        let fraction: float = float(k) / total if total > 0.0 else 0.0
        let here: GeoPoint = start + leg * fraction
        if here in region:
            if open_at < 0:
                open_at = k
        elif open_at >= 0:
            found.append(Run_T(open_at, k - 1))
            open_at = -1
    if open_at >= 0:
        found.append(Run_T(open_at, int(total)))
    return found

def describe(stretches: []Run_T) -> str:
    if len(stretches) == 0:
        return "clear"
    var parts: []str = []
    for r in stretches:
        parts.append(f"km {r.first}-{r.last}")
    return ", ".join(parts)

def kilometres(stretches: []Run_T) -> int:
    var total: int = 0
    for r in stretches:
        total += r.last - r.first + 1
    return total

# ---- 4. a plane off its track ------------------------------------------------------

type Fix_T is record:
    along:  Kilometers_T       # how far along the leg, measured on the track
    across: Kilometers_T       # how far to the side of it (unsigned)
    side:   Side_T

def fix_on_leg(start: GeoPoint, leg: GeoVector, plane: GeoPoint) -> Fix_T:
    """Where PLANE is, as seen from a leg that starts at START: on a flat plane, with the
    east and north of the leg and of the way from START to the plane as the x and y.
    Good for tens of kilometres, which is all a leg's neighbourhood is."""
    let track: Vector = vector_xy(leg.east, leg.north)
    let off: GeoVector = plane - start
    let offset: Vector = vector_xy(off.east, off.north)
    let cross: SquareMeters_T = track.cross(offset)
    let dot: SquareMeters_T = track.dot_product(offset)
    let length: Meters_T = track.length()
    let across: Meters_T = cross / length                    # a square over a length: a length
    let along: Meters_T = dot / length
    return Fix_T(Kilometers_T(float(along) / 1000.0), Kilometers_T(abs(float(across)) / 1000.0), side_of_track(across))

def main():
    let airports: []Airport_T = ROUTE
    # The airspace: R-1 and R-2 are restricted, the funnel is the approach to Marseille,
    # and what may be used of the funnel is what is not restricted.
    let r1: Region = Polygon(outline())
    let r2: Region = Circle(must(geo_point_from_dms(R2_CENTRE)), 20.0)
    let funnel: Region = Sector(position_of(LFML), FUNNEL_HEADING, 25.0, 150.0)
    let restricted: Region = r1 | r2
    let open_funnel: Region = funnel & ~restricted
    let zones: []Region = [r1, r2, funnel, open_funnel]            # in the order of Zone_T

    print "ROUTE"
    print "-----"
    var previous: GeoPoint = position_of(airports[0])
    print f"  {airports[0]}  {previous.human()}"
    var total_km: Kilometers_T = 0.0
    var total_h: Hours_T = 0.0
    var leg_km: []Kilometers_T = []
    var legs: []GeoVector = []
    var starts: []GeoPoint = []
    for i in 1 ..< len(airports):
        let here: GeoPoint = position_of(airports[i])
        let leg: GeoVector = here - previous                   # from the last airport to this
        let hours: Hours_T = leg.magnitude() / CRUISE          # km over km/h: hours
        print f"  {airports[i]}  {here.human()}   {leg.magnitude():7.1f} km  bearing {leg.phase():5.1f}  {hours_minutes(hours)}"
        total_km += leg.magnitude()
        total_h += hours
        leg_km.append(leg.magnitude())
        legs.append(leg)
        starts.append(previous)
        previous = here
    print f"  total {total_km:.1f} km, {hours_minutes(total_h)} at {CRUISE:.0f} km/h"

    print ""
    print "AIRSPACE"
    print "--------"
    var restricted_km: int = 0
    for i in 0 ..< len(legs):
        print f"  {airports[i]} -> {airports[i + 1]}"
        for zone in Zone_T:
            let stretches: []Run_T = runs(starts[i], legs[i], zones[ord(zone)])
            print f"    {ZONE_LABEL[zone]:<22} {describe(stretches)}"
        restricted_km += kilometres(runs(starts[i], legs[i], restricted))
    print f"  {restricted_km} of the {total_km:.0f} km are restricted"

    print ""
    print "OFF TRACK"
    print "---------"
    # A plane 12 km to the right of the middle of the second leg, and one 7 km to the left
    # of a point a quarter of the way along the third.
    let second: GeoVector = legs[1]
    let midway: GeoPoint = starts[1] + second * 0.5
    let to_right: GeoVector = GeoVector(12.0, Degrees_T(float(second.phase()) + 90.0))
    let strayed_right: GeoPoint = midway + to_right
    let fix_right: Fix_T = fix_on_leg(starts[1], second, strayed_right)
    print f"  a plane at {strayed_right.human()}: {fix_right.along:.1f} km along the leg, {fix_right.across:.1f} km to the {fix_right.side}"
    let third: GeoVector = legs[2]
    let quarter: GeoPoint = starts[2] + third * 0.25
    let to_left: GeoVector = GeoVector(7.0, Degrees_T(float(third.phase()) - 90.0))
    let strayed_left: GeoPoint = quarter + to_left
    let fix_left: Fix_T = fix_on_leg(starts[2], third, strayed_left)
    print f"  a plane at {strayed_left.human()}: {fix_left.along:.1f} km along the leg, {fix_left.across:.1f} km to the {fix_left.side}"

    print ""
    print "HOLDING PATTERN"
    print "---------------"
    # Six points on a circle of 20 km round the last beacon, made by turning one of them.
    let beacon: GeoPoint = position_of(LFML)
    let first: GeoPoint = beacon + GeoVector(20.0, 0.0)
    var pattern: []GeoPoint = []
    for k in 0 ..< 6:
        let spot: GeoPoint = first.rotate_around_point(beacon, Degrees_T(60.0 * float(k)))
        pattern.append(spot)
        print f"  point {k + 1}: {spot.human()}"

    # ---- what it printed is right ----------------------------------------------
    var summed: Kilometers_T = 0.0
    for km in leg_km:
        summed += km
    assert abs(float(summed - total_km)) < 1e-9
    assert len(runs(starts[0], legs[0], restricted)) == 0               # Brussels - Paris: clear
    assert len(runs(starts[1], legs[1], r1)) == 1 and len(runs(starts[1], legs[1], r2)) == 0
    assert len(runs(starts[2], legs[2], r2)) == 1 and len(runs(starts[2], legs[2], r1)) == 0
    assert len(runs(starts[2], legs[2], funnel)) == 1                   # the last leg is the approach
    assert kilometres(runs(starts[2], legs[2], open_funnel)) < kilometres(runs(starts[2], legs[2], funnel))
    for i in 0 ..< len(legs):                                           # the algebra, on every kilometre
        for k in 0 .. int(float(legs[i].magnitude())):
            let fraction: float = float(k) / float(legs[i].magnitude())
            let p: GeoPoint = starts[i] + legs[i] * fraction
            assert (p in restricted) == ((p in r1) or (p in r2))
            assert (p in ~restricted) == (p in (~r1 & ~r2))              # De Morgan
            assert (p in open_funnel) == ((p in funnel) and not (p in restricted))
            assert not ((p in open_funnel) and (p in restricted))
    assert abs(float(fix_right.along) - 0.5 * float(leg_km[1])) < 1.0     # halfway, to the km
    assert abs(float(fix_right.across) - 12.0) < 0.1
    assert fix_right.side == RIGHT
    assert abs(float(fix_left.along) - 0.25 * float(leg_km[2])) < 1.0
    assert abs(float(fix_left.across) - 7.0) < 0.1
    assert fix_left.side == LEFT
    assert side_of_track(0.5) == ON_TRACK and side_of_track(-0.5) == ON_TRACK    # the band is closed
    assert side_of_track(0.6) == LEFT and side_of_track(-0.6) == RIGHT and side_of_track(0.0) == ON_TRACK
    for spot in pattern:
        let radius: GeoVector = spot - beacon
        assert abs(float(radius.magnitude()) - 20.0) < 0.01          # all on the circle
    let across_the_circle: GeoVector = pattern[0] - pattern[3]
    assert abs(float(across_the_circle.magnitude()) - 40.0) < 0.1     # points 1 and 4 opposite

    print ""
    print "BAD INPUT"
    print "---------"
    for text in ["505405N", "950000N 0042904E", "505405N 0042904E 7", "50x405N 0042904E"]:
        print f"  '{text}': {refusal(text)}"
    assert refusal("505405N 0042904E") == "ok"
    print ""
    print "route_check: all checks passed"

if __name__ == "__main__":
    main()
