#!/usr/bin/env py2nim
"""
test_inline_suite — exercise inline form of if/elif/else/while.
"""

# inline if / elif / else
let x: int = 7
if x < 5: print("x<5")
elif x < 10: print("5<=x<10")
else: print("x>=10")

# inline while
var n: int = 3
while n > 0: n -= 1
print("n=", n)

# block forms still work
if x > 0:
    print("positive")
else:
    print("zero or negative")

# A bracketed expression spanning lines used to be emitted as the source
# wrote it, which skipped every translation inside: 'Length and the rest
# went into the Python output in Adascript spelling.  The layout is kept
# only where it says the same thing as the translated form.
let items: []str = ["a", "b", "c"]
let spread: []int = [
    items'Length,
    2]
let mapped: {str}int = {
    "n": items'Length}
let parend: int = (
    items'Length)
assert spread[0] == 3 and mapped["n"] == 3 and parend == 3
# Nothing to translate here, so this one keeps its shape.
let kept: {str}int = {
    "alpha": 1,
    "beta": 2,
}
assert kept["beta"] == 2

# A record field with no initialiser: Nim zero-initialises it, and Python
# rejects a dataclass whose defaultless field follows one with a default --
# at import time, so the whole module used to die rather than the record.
type Rec_T is record:
    label : str = "x"
    items : []str
    counts: {str}int

# And a record variable with no initialiser is that empty record, not None,
# so it can be filled in field by field the way one is normally built.
var rec : Rec_T
rec.items.append("one")
rec.counts["n"] = 1
assert rec.label == "x" and rec.items'Length == 1 and rec.counts["n"] == 1

# An enum declared inside a function renders to several lines, which used to
# land at column zero -- outside the function that declared them.
def local_enum_works() -> int:
    type Local_T is enum P, Q, R
    var got: int = 0
    case Q:
        when P: got = 1
        when Q:
            got = 2
            got = got + 10
        when others: got = 0
    got
assert local_enum_works() == 12

# A tuple pattern has no to_py of its own -- the parens belong to the
# grammar -- which used to crash the Python backend outright.  And a case in
# tail position returns whichever branch runs, exactly as an if does; without
# that the function returned None on Python while Nim got it right.
def classify(a: int, b: int) -> str:
    case (a, b):
        when (1, 2): "one-two"
        when (1, _): "one-any"
        when (_, 2): "any-two"
        when others: "neither"
assert classify(1, 2) == "one-two"
assert classify(1, 9) == "one-any"
assert classify(9, 2) == "any-two"
assert classify(7, 7) == "neither"

# The same, with block bodies rather than inline ones.
def classify_block(n: int) -> str:
    case n:
        when 1:
            "one"
        when others:
            "many"
assert classify_block(1) == "one" and classify_block(5) == "many"

# Path: a string that also joins with `/`. Both backends give the same
# thing -- Nim's std/paths Path (distinct string) with a converter back to
# string, Python a str subclass -- so a Path goes wherever a str goes.
let root: Path = Path("/tmp")
let leaf: Path = root / "a" / "b"
assert leaf == "/tmp/a/b"
assert (root / "x") == "/tmp/x"
let as_str: str = str(leaf)
assert as_str == "/tmp/a/b"
assert leaf.upper() == "/TMP/A/B"        # still a string
assert (-d root)                          # and a file test takes one
assert (root / "no-such-thing")'Length > 0

# Splitting one apart. `parent` and `name` follow Python's pathlib, which is
# what Nim's parentDir/lastPathPart already do -- os.path is the odd one out
# and is deliberately not the model: it calls the basename of "a/b/" empty.
assert leaf.parent == "/tmp/a"
assert leaf.name == "b"
assert Path("c.txt").parent == "."        # no directory part -> "."
assert Path("c.txt").name == "c.txt"
assert Path("a/b/").parent == "a"         # a trailing slash is not a component
assert Path("a/b/").name == "b"
assert Path("/a").parent == "/"           # ... but the root is its own parent
assert Path("/").parent == "/"
assert Path("").parent == "."
assert Path(".").name == ""               # "." names no file
assert Path("..").name == ".."

# mkdir() is mkdir -p on both backends: parents made, already-there is fine.
let sandbox: Path = Path("/tmp/adascript_path_test")
shell: rm -rf -- {!sandbox}
let deep: Path = sandbox / "x" / "y"
deep.mkdir()
deep.mkdir()
assert (-d deep)

# resolve() expands every symlink along the path. It follows Python's
# realpath, including on a path that does not exist yet: Nim's expandFilename
# raises there, so the helper falls back to resolving as much as does exist.
let real_file: Path = deep / "real.txt"
writeFile(real_file, "content\n")
let link: Path = sandbox / "link.txt"
shell: ln -s {!real_file} {!link}
# A range bound may be a whole expression, not just a name. Taking only the
# first node of a flattened `n-k+1 .. n` used to emit range(n, n + 1) --
# every `for j in i+1..hi` loop then started at i and quietly did an extra
# iteration, which is how tsp.ady and timetable_engine.ady were wrong on the
# Python backend without failing.
let rn: int = 10
let rk: int = 3
var lo_terms: []int = []
for i in rn-rk+1..rn:
    lo_terms.append(i)
assert lo_terms == [8, 9, 10]
var hi_terms: []int = []
for i in 1..rn-rk:
    hi_terms.append(i)
assert hi_terms == [1, 2, 3, 4, 5, 6, 7]
var excl: []int = []
for i in rn-rk+1..<rn:
    excl.append(i)
assert excl == [8, 9]
var pairs: []str = []
for i in 0..3:
    for j in i+1..3:
        pairs.append(f"{i}{j}")
assert pairs == ["01", "02", "03", "12", "13", "23"]

# 'Range on a type is its domain; on a value it is the index range.
type Hue is enum PINK, TEAL
let hues: {}Hue = Hue'Range
assert hues'Length == 2
assert (Hue'Range - {PINK})'Length == 1
let word: str = "abc"          # a tick needs a name, not a literal
var idxs: []int = []
for i in word'Range:
    idxs.append(i)
assert idxs == [0, 1, 2]

let gone: Path = sandbox / "gone.txt"
assert link.resolve() == real_file
assert gone.resolve() == gone     # nothing there: resolved, not rejected
assert (-L link)                  # the link itself is still a link
assert (-f link)                  # ... and -f follows it to the file
assert (-e sandbox)               # -e is true for a directory on both
                                  # backends: it is exists(), not isfile()
shell: rm -rf -- {!sandbox}
assert not (-e sandbox)

# An inline `when` branch that already returns must not be turned into an
# implicit return: `f(x); return True` has its value in the *last* statement,
# and marking the head both drops the real return and returns the wrong thing.
def noop():
    pass
def dispatch(word: str) -> bool:
    case word:
        when "go":    noop(); return True
        when "stop":  noop(); return True
        when others:  return False
assert dispatch("go") and dispatch("stop") and not dispatch("other")

# case with inline when clauses
let y: int = 2
case y:
    when 1: print("one")
    when 2: print("two")
    when 3: print("three")
    when others: print("other")

print("done")
