#!/usr/bin/env ady2nim
"""
test_inline_suite — exercise inline form of if/elif/else/while.
"""

# inline if / elif / else
let x: int = 7
if x < 5: print("x<5")
elif x < 10: print("5<=x<10")
else: print("x>=10")

# inline while
var n: int = 3
while n > 0: n -= 1
print("n=", n)

# block forms still work
if x > 0:
    print("positive")
else:
    print("zero or negative")

# A bracketed expression spanning lines used to be emitted as the source
# wrote it, which skipped every translation inside: 'Length and the rest
# went into the Python output in Adascript spelling.  The layout is kept
# only where it says the same thing as the translated form.
let items: []str = ["a", "b", "c"]
let spread: []int = [
    items'Length,
    2]
let mapped: {str}int = {
    "n": items'Length}
let parend: int = (
    items'Length)
assert spread[0] == 3 and mapped["n"] == 3 and parend == 3
# Nothing to translate here, so this one keeps its shape.
let kept: {str}int = {
    "alpha": 1,
    "beta": 2,
}
assert kept["beta"] == 2

# A record field with no initialiser: Nim zero-initialises it, and Python
# rejects a dataclass whose defaultless field follows one with a default --
# at import time, so the whole module used to die rather than the record.
type Rec_T is record:
    label : str = "x"
    items : []str
    counts: {str}int

# And a record variable with no initialiser is that empty record, not None,
# so it can be filled in field by field the way one is normally built.
var rec : Rec_T
rec.items.append("one")
rec.counts["n"] = 1
assert rec.label == "x" and rec.items'Length == 1 and rec.counts["n"] == 1

# An enum declared inside a function renders to several lines, which used to
# land at column zero -- outside the function that declared them.
def local_enum_works() -> int:
    type Local_T is enum P, Q, R
    var got: int = 0
    case Q:
        when P: got = 1
        when Q:
            got = 2
            got = got + 10
        when others: got = 0
    got
assert local_enum_works() == 12

# A tuple pattern has no to_py of its own -- the parens belong to the
# grammar -- which used to crash the Python backend outright.  And a case in
# tail position returns whichever branch runs, exactly as an if does; without
# that the function returned None on Python while Nim got it right.
def classify(a: int, b: int) -> str:
    case (a, b):
        when (1, 2): "one-two"
        when (1, _): "one-any"
        when (_, 2): "any-two"
        when others: "neither"
assert classify(1, 2) == "one-two"
assert classify(1, 9) == "one-any"
assert classify(9, 2) == "any-two"
assert classify(7, 7) == "neither"

# The same, with block bodies rather than inline ones.
def classify_block(n: int) -> str:
    case n:
        when 1:
            "one"
        when others:
            "many"
assert classify_block(1) == "one" and classify_block(5) == "many"

# Path: a string that also joins with `/`. Both backends give the same
# thing -- Nim's std/paths Path (distinct string) with a converter back to
# string, Python a str subclass -- so a Path goes wherever a str goes.
let root: Path = Path("/tmp")
let leaf: Path = root / "a" / "b"
assert leaf == "/tmp/a/b"
assert (root / "x") == "/tmp/x"
let as_str: str = str(leaf)
assert as_str == "/tmp/a/b"
assert leaf.upper() == "/TMP/A/B"        # still a string
assert (-d root)                          # and a file test takes one
assert (root / "no-such-thing")'Length > 0

# Splitting one apart. `parent` and `name` follow Python's pathlib, which is
# what Nim's parentDir/lastPathPart already do -- os.path is the odd one out
# and is deliberately not the model: it calls the basename of "a/b/" empty.
assert leaf.parent == "/tmp/a"
assert leaf.name == "b"
assert Path("c.txt").parent == "."        # no directory part -> "."
assert Path("c.txt").name == "c.txt"
assert Path("a/b/").parent == "a"         # a trailing slash is not a component
assert Path("a/b/").name == "b"
assert Path("/a").parent == "/"           # ... but the root is its own parent
assert Path("/").parent == "/"
assert Path("").parent == "."
assert Path(".").name == ""               # "." names no file
assert Path("..").name == ".."

# mkdir() is mkdir -p on both backends: parents made, already-there is fine.
let sandbox: Path = Path("/tmp/adascript_path_test")
shell: rm -rf -- {!sandbox}
let deep: Path = sandbox / "x" / "y"
deep.mkdir()
deep.mkdir()
assert (-d deep)

# resolve() expands every symlink along the path. It follows Python's
# realpath, including on a path that does not exist yet: Nim's expandFilename
# raises there, so the helper falls back to resolving as much as does exist.
let real_file: Path = deep / "real.txt"
writeFile(real_file, "content\n")
let link: Path = sandbox / "link.txt"
shell: ln -s {!real_file} {!link}
let gone: Path = sandbox / "gone.txt"
assert link.resolve() == real_file
assert gone.resolve() == gone     # nothing there: resolved, not rejected
assert (-L link)                  # the link itself is still a link
assert (-f link)                  # ... and -f follows it to the file
assert (-e sandbox)               # -e is true for a directory on both
                                  # backends: it is exists(), not isfile()
shell: rm -rf -- {!sandbox}
assert not (-e sandbox)

# A range bound may be a whole expression, not just a name. Taking only the
# first node of a flattened `n-k+1 .. n` used to emit range(n, n + 1) --
# every `for j in i+1..hi` loop then started at i and quietly did an extra
# iteration, which is how tsp.ady and timetable_engine.ady were wrong on the
# Python backend without failing.
let rn: int = 10
let rk: int = 3
var lo_terms: []int = []
for i in rn-rk+1..rn:
    lo_terms.append(i)
assert lo_terms == [8, 9, 10]
var hi_terms: []int = []
for i in 1..rn-rk:
    hi_terms.append(i)
assert hi_terms == [1, 2, 3, 4, 5, 6, 7]
var excl: []int = []
for i in rn-rk+1..<rn:
    excl.append(i)
assert excl == [8, 9]
var pairs: []str = []
for i in 0..3:
    for j in i+1..3:
        pairs.append(f"{i}{j}")
assert pairs == ["01", "02", "03", "12", "13", "23"]

# An ordinary binary operator on the right of a comparison is not a range.
# The range emitter used to ask only whether the operator was "..<", so
# every other one -- `-`, `*`, `/` -- fell into the inclusive branch and
# `a < b - c` came out as `a < range(b, c + 1)`. It parsed and it ran.
let bn: int = 8
let bh: int = 4
assert bh == bn // 2
assert not (bh == bn * 2)
assert bh < bn - 1
assert not (bh > bn - 1)
assert bh == bn - 4
assert (bh == bn % 5) == False
let proot: Path = Path("/tmp")
assert (proot / "x") == proot / "x"

# A bare `x : T` is Python's annotation: it records a type and binds
# nothing, so the assignment is what declares. ady2nim used to emit `var x: T`
# for it, which made code written that way build here and raise
# UnboundLocalError there. The annotation's type is still carried to the
# assignment, so this is `var ann_then: int = 5` in the Nim output.
ann_then: int
ann_then = 5
assert ann_then == 5
# (A declaration is `var x: T`. Reading a bare-annotated name before
# assigning it is now an error on both backends, so it cannot be asserted
# here -- it fails to compile on Nim and raises on Python.)

# A field, though, is declared by exactly that spelling -- Rec_T above has
# `items : []str` with no initialiser -- which is why the two cases are
# told apart rather than the form being rejected outright.
type Field_T is record:
    tag:   str = "t"
    extra: []str
var fr : Field_T
fr.extra.append("e")
assert fr.tag == "t" and fr.extra'Length == 1

# A comprehension fills an array as well as a list -- the annotation decides
# which, and the values land in domain order. The key may be a length, a
# constant, a subrange (including one that does not start at zero), an enum
# or bool: Nim was emitting `0 ..< Idx` for the named ones, which is
# `pred` on a typedesc, and Python was leaving the value a plain list, which
# indexes from 0 whatever the domain says.
#
# Where the key is a named type the generator iterates that type, so the
# loop variable is the key each value is about rather than a count that
# happens to be the right length. `ord` gives its position -- Python's
# builtin is the one-character-string case only, so the emitter supplies
# the rest. A length has no type to name, so those two still count.
type Off_T is 2 .. 6
type Hue_T is enum ROSE, JADE, SLATE
const NC: int = 5
var cLit:  [5]int     = [i*i for i in 0..4]
var cConst:[NC]int    = [i*i for i in 0..4]
var cOff:  [Off_T]int = [o*10 for o in Off_T]
var cHue:  [Hue_T]int = [ord(h)*10 for h in Hue_T]
var cBool: [bool]int  = [ord(b)+300 for b in bool]
assert cLit[0] == 0 and cLit[4] == 16
assert cConst[4] == 16
assert cOff[2] == 20 and cOff[6] == 60       # domain 2..6, so 20 sits at 2
assert cHue[ROSE] == 0 and cHue[SLATE] == 20
assert cBool[False] == 300 and cBool[True] == 301
# ord() over every ordinal, not just the character it is in Python
assert ord("a") == 97 and ord(JADE) == 1 and ord(True) == 1 and ord(4) == 4
# and the two builtin ordinals are domains a plain loop can walk too
var nchars: int = 0
for c in char:
    nchars += 1
assert nchars == 256
var nbools: []bool = []
for b in bool:
    nbools.append(b)
assert nbools == [False, True]

# An enum-bounded range is written like an integer one and means the same
# thing on Nim. Python's range() takes integers, so `E'First .. E'Last` --
# which both tutorials give as the Ada spelling of the enum loop -- emitted
# `range(STAGE1, STAGE3 + 1)` and died on the addition.
type Stage_T is enum STAGE1, STAGE2, STAGE3, STAGE4
var walked: []str = []
for s in Stage_T'First .. Stage_T'Last:
    walked.append(s'Image)
assert walked == ["STAGE1", "STAGE2", "STAGE3", "STAGE4"]
var partly: []str = []
for s in STAGE2 .. STAGE4:
    partly.append(s'Image)
assert partly == ["STAGE2", "STAGE3", "STAGE4"]
var upto: []str = []
for s in Stage_T'First ..< Stage_T'Last:
    upto.append(s'Image)
assert upto == ["STAGE1", "STAGE2", "STAGE3"]
# Membership over the same bounds. A plain Enum has no ordering, so the
# `lo <= x <= hi` chain the integer form uses raises here; ask the members.
assert STAGE2 in Stage_T'First .. Stage_T'Last
assert not (STAGE1 in STAGE2 .. STAGE4)
assert not (STAGE4 in Stage_T'First ..< Stage_T'Last)
# ... and `..<` really is exclusive. The emitter looked for a child node
# spelled '<' where the whole `..<` token sits, so it never matched and
# every `x in lo ..< hi` came out inclusive: `100 in 1 ..< 100` was true
# on Python and false on Nim.
assert 5 in 1 .. 100
assert not (100 in 1 ..< 100)
assert 99 in 1 ..< 100

# A bare enum prints as its member name, as Nim's `$` does. Python's
# default is "Stage_T.STAGE2", so the same f-string said two different
# things depending on the backend. (A *container* of them still differs --
# that is repr, and it is in TODO.md.)
let st: Stage_T = STAGE2
assert f"{st}" == "STAGE2"
assert str(st) == "STAGE2"
assert st'Image == "STAGE2"

# `+` concatenates strings on both backends: the Nim emitter rewrites it to
# that language's `&` once it can tell an operand is a string. It could not
# see through `str(...)`, which renders as `$x` -- so `str(a) + str(b)`
# emitted `$a + $b`, and Nim's `+` has no string overload. The only
# spelling left was `&`, which is bitwise-and on Python: that is how
# sudoku.ady came to be Nim-only.
let ca: str = "A"
let cb: str = "1"
assert ca + cb == "A1"
assert str(ca) + str(cb) == "A1"
var joined: str = ""
for ch in "AB":
    joined += str(ch) + "-"
assert joined == "A-B-"

# `+` joins two comprehensions as well as two literals. A comprehension
# renders to `collect(...)` on Nim, which the seq/string test did not
# recognise, so `[..] + [..]` reached Nim's numeric `+` -- and sudoku.ady's
# unit list had to be built by appending in a loop instead.
var lhs: []str = ["a", "b"]
assert [str(c) for c in "ab"] + [str(c) for c in "cd"] == ["a", "b", "c", "d"]
assert lhs + [str(c) for c in "cd"] == ["a", "b", "c", "d"]
assert [str(c) for c in "ab"] + lhs == ["a", "b", "a", "b"]
# ... including a comprehension with two generators, as that list uses.
var grid: []str = [str(r) + str(c) for r in ["A", "B"] for c in ["1", "2"]]
assert grid == ["A1", "A2", "B1", "B2"]

# A comprehension's loop variables are typed from what they iterate, the
# same as a `for` statement's. Without that, a bare `r + c` between two of
# them was not seen as string concatenation and reached Nim's numeric `+`,
# so only the `str(r) + str(c)` spelling above compiled. The element
# expression is rendered after the clauses now, for the types to exist by
# the time it needs them.
assert [r + c for r in ["A", "B"] for c in ["1", "2"]] == ["A1", "A2", "B1", "B2"]
assert [w + "!" for w in ["a", "b"]] == ["a!", "b!"]
assert [v for v in ["aa", "b"] if v'Length > 1] == ["aa"]
assert {k: k + "!" for k in ["p"]}["p"] == "p!"
let zset: {}str = {v + "z" for v in ["m", "n"]}   # a tick needs a name
assert zset'Length == 2
assert [[a + b for b in ["1", "2"]] for a in ["A"]] == [["A1", "A2"]]
# Iterating a string gives chars, and char + char is a string on both
# backends -- Nim's `&(char, char)` builds one, Python's are already
# one-character strings. This is sudoku.ady's cross().
assert [p + q for p in "AB" for q in "12"] == ["A1", "A2", "B1", "B2"]
# And a char reaching a `str` parameter is converted rather than rejected:
# `cross(ROWS, c)` type-checks on Python, where c is a one-character
# string, and used to need a hand-written str(c) for Nim alone.
def take_str(s: str, t: str) -> str:
    s + t
let pair: str = "xy"
assert [take_str("<", ch) for ch in pair] == ["<x", "<y"]
assert take_str("<", pair[0]) == "<x"
# ... and the same at a declaration, and appending to a []str. Those three
# sites are what let sudoku.ady's parse_grid filter grid characters
# directly, with no `str(c)` temporary standing in between.
var first: str = pair[0]
assert first == "x"
var seen: []str = []
for ch in pair:
    if ch != "y":
        seen.append(ch)
assert seen == ["x"]
# A string method with part-char, part-string arguments. Nim overloads
# these all-char or all-string and has nothing mixed, so the char side of
# `s.replace(ch, "\\" + ch)` failed there -- git1.ady's ignore_escape had
# a str(ch) on it for that reason alone. An all-char or all-string call is
# left as it was: that overload is already the right one.
var esc: str = "a*b"
for ch in "*":
    esc = esc.replace(ch, "\\" + ch)
assert esc == "a\\*b"
assert "x-y-z".replace("-", "+") == "x+y+z"
assert "a,b,c".split(",") == ["a", "b", "c"]

# Iterating a string gives a char, and `[]char` is the honest annotation
# for keeping them. It works throughout: appending, indexing back out,
# adding to a string, and passing to a `str` parameter.
const DIGITS_T: str = "123456789"
var kept_chars: []char
for c in "1.0x9":
    if c in DIGITS_T or c in "0.":
        kept_chars.append(c)
assert kept_chars'Length == 4
let firstc: char = kept_chars[0]
assert firstc == "1"
var glued: str = ""
for c in kept_chars:
    glued += c
assert glued == "1.09"
assert take_str("<", firstc) == "<1"

# `sub in s` over two strings is a substring test. Nim's bare `in` is
# `contains`, and system defines it only for a char in a string -- so
# `c in DIGITS` compiled while `"x" in "daxfdjd"` did not, on every shape
# including two variables. strutils has the string/string overload.
let hay: str = "daxfdjd"
let needle: str = "xf"
assert needle in hay
assert "xf" in hay
assert "x" in hay
assert needle in "daxfdjd"
assert "x" in "daxfdjd"
assert "zz" not in hay
assert hay[2] in "xy"          # a char operand still takes system's
assert hay[2] in hay
# The right of `in` is a range_expr, which has its own arithmetic path for
# the flattened operators -- and that path knew `+` was concatenation only
# for a seq literal. `c in DIGITS + "0."` kept Nim's numeric `+` and failed,
# while the same expression as a statement was rewritten to `&`.
assert "x" in "da" + "xf"
assert hay[2] in DIGITS_T + "x."
let gridc: []char = [c for c in "1.0x9" if c in DIGITS_T+"0."]
assert gridc'Length == 4

# Nim names the float specials as system constants and Python has no names
# for them at all, only literals -- so `Inf` was a working program there and
# a NameError here. It is the honest spelling for "no path yet", which is
# what dijkstra.ady used a 1e6 sentinel for.
type Dist_T is float
const FAR: Dist_T = Inf
assert 5.0 < FAR and 1e300 < FAR
assert NegInf < -1e300
let nan_v: float = NaN
assert nan_v != nan_v          # the only value that is not itself
# A declaration binds the name rather than reading it, so it still shadows.
let Inf: int = 3
assert Inf == 3
# The binding is scoped to the comprehension, as it is in Python: the same
# name can be a string in one and an int in the next, and an outer name of
# that spelling is untouched.
assert [same + 1 for same in [10, 20]] == [11, 21]
assert [same + "?" for same in ["p"]] == ["p?"]
let same: int = 5
assert same + 1 == 6
# and the literal forms are untouched
var cLitE: [Hue_T]int = [ROSE: 1, JADE: 2, SLATE: 3]
assert cLitE[SLATE] == 3

# Every [O]T yields its values, in domain order, on both backends. The
# enum-keyed one is a dict on Python, so left alone it would be the only
# member of the family to yield its keys -- and in the order the literal
# happened to be written rather than the order of the enum.
type Shade_T is enum LIGHT, MID, DARK
var shade: [Shade_T]int = [DARK: 3, LIGHT: 1, MID: 2]
var shades: []int = []
for v in shade:
    shades.append(v)
assert shades == [1, 2, 3]        # enum order, not literal order
assert shade[LIGHT] == 1 and shade[DARK] == 3
shade[MID] = 9
assert shade[MID] == 9
assert shade'Length == 3
var fixed3: [3]int = [10, 20, 30]
var fixed3v: []int = []
for v in fixed3:
    fixed3v.append(v)
assert fixed3v == [10, 20, 30]    # ... and the rest of the family agrees

# A real dict keyed by an enum is untouched: `{E}V` iterates keys, which is
# what a dict does on Python and a Table does on Nim.
var shade_tbl: {Shade_T}int = {:}
shade_tbl[LIGHT] = 1
var shade_keys: []str = []
for k in shade_tbl:
    shade_keys.append(k'Image)
assert shade_keys == ["LIGHT"]

# char is an ordinal, so [char]T is an array with 256 slots. Adascript has
# no character literal -- it is a Python superset, so 'a' is a one-character
# string -- and Nim's array[char, T] cannot be indexed by a string, so the
# emitter converts. Escapes included: "\\" and "\n" are one character in the
# source but two once rendered, which a naive conversion leaves behind.
var freq: [char]int
freq['a'] = 3
freq['z'] = freq['a'] + 1
freq[chr(98)] = 7
freq["'"] = 1
freq["\\"] = 2
freq["\n"] = 4
assert freq['a'] == 3 and freq['z'] == 4 and freq[chr(98)] == 7
assert freq["'"] == 1 and freq["\\"] == 2 and freq["\n"] == 4
var keyed: {str}int = {:}      # a string-keyed table is not touched
keyed["a"] = 9
assert keyed["a"] == 9

# 'Range on a type is its domain; on a value it is the index range.
type Hue is enum PINK, TEAL
let hues: {}Hue = Hue'Range
assert hues'Length == 2
assert (Hue'Range - {PINK})'Length == 1
let word: str = "abc"          # a tick needs a name, not a literal
var idxs: []int = []
for i in word'Range:
    idxs.append(i)
assert idxs == [0, 1, 2]


# An inline `when` branch that already returns must not be turned into an
# implicit return: `f(x); return True` has its value in the *last* statement,
# and marking the head both drops the real return and returns the wrong thing.
def noop():
    pass
def dispatch(word: str) -> bool:
    case word:
        when "go":    noop(); return True
        when "stop":  noop(); return True
        when others:  return False
assert dispatch("go") and dispatch("stop") and not dispatch("other")

# case with inline when clauses
let y: int = 2
case y:
    when 1: print("one")
    when 2: print("two")
    when 3: print("three")
    when others: print("other")

print("done")

# A shell capture in tail position is the function's value, the spelling
# both tutorials give. On Python it emitted a bare subprocess.run with the
# output discarded, so the function returned None there and the lines on
# Nim.
def etc_entries() -> []str:
    shellLines: ls -1 /etc
assert etc_entries()'Length > 0
def echoed() -> str:
    let r = shell: echo hi
    r.output.strip()
assert echoed() == "hi"
var ran: bool = False
def discards():
    shell: true
    ran = True
discards()
assert ran                    # a non-tail shell still just runs

# `nimport` is Nim-only by design, so a module Python also has under the
# same name went unimported: `nimport times` plus `time.time()` was a
# working Nim program and a NameError here.
nimport times
assert time.time() > 0.0

# Iterating a Table reached through an attribute. The `.keys` rewrite needs
# the iterable's type, and the type of `obj.field` was not worked out -- only
# a bare name's was -- so `for k in self.G` did not compile while the same
# loop over a local did.
type Box_T is record:
    tbl: {str}int
var bx: Box_T
bx.tbl["k"] = 1
bx.tbl["j"] = 2
var boxed: []str = []
for k in bx.tbl:
    boxed.append(k)
assert boxed'Length == 2
class Holder_C:
    var G: {str}int = {"a": 1}
    def count(self) -> int:
        var n: int = 0
        for k in self.G:          # ... and the same through `self`
            n += 1
        n
let hc: Holder_C = Holder_C()
assert hc.count() == 1

# A local whose name is one capital and a digit is a local, not a module
# constant. The hoist rule reads a SCREAMING_CASE name as a constant and
# lifts it to module scope; its regex counted a digit as the second
# uppercase character, so `A2` was carried out of the function -- past the
# very declaration it reads.
def hoist_check() -> int:
    let base: int = 5
    let A2: int = base + 1
    A2
assert hoist_check() == 6

# Explicit generic parameters: `def f[T](...)` declares T rather than
# leaving it to be inferred from the single-capital convention, which is
# what a multi-letter name needs -- [Elem] was dropped and Nim then had an
# undeclared identifier. Nim takes the brackets as its own generic proc
# params; Python takes them as PEP 695.
def first_of[T](xs: []T) -> T:
    xs[0]
def head_of[Elem](xs: []Elem) -> Elem:
    xs[0]
assert first_of([7, 8]) == 7
assert first_of(["x", "y"]) == "x"
assert head_of([1.5, 2.5]) == 1.5
# An explicit type application at the call site is accepted too. Nim uses
# it; Python infers instead and a function object is not subscriptable, so
# the emitter drops it there.
assert first_of[int]([7, 8]) == 7
assert head_of[str](["a"]) == "a"

# --- patterns and optionals, the cases the book documents ----------------

# Range patterns: `when lo .. hi:` is one RANGE token, not two dots, and the
# grammar asked for two -- so every range pattern was a parse error. Nim gets
# `of 0 .. 12:`; Python has no range pattern, so the block lowers to a chain.
def tier_of(age: int) -> str:
    case age:
        when 0 .. 12:
            return "child"
        when 13 .. 17:
            return "teen"
        when others:
            return "adult"
assert tier_of(9) == "child"
assert tier_of(15) == "teen"
assert tier_of(40) == "adult"

# The same in match/case, and over characters.
def grade_of(score: int) -> str:
    match score:
        case 90 .. 100:
            return "A"
        case 80 .. 89:
            return "B"
        case _:
            return "C"
assert grade_of(95) == "A" and grade_of(85) == "B" and grade_of(20) == "C"

def char_kind(ch: char) -> str:
    case ch:
        when 'a' .. 'z':
            return "lower"
        when '0' .. '9':
            return "digit"
        when others:
            return "other"
let sample: str = "q7!"
assert char_kind(sample[0]) == "lower"
assert char_kind(sample[1]) == "digit"
assert char_kind(sample[2]) == "other"

# A guard reads the captures of its own pattern, but those are `let`s inside
# the branch body -- so the Nim condition named identifiers that did not
# exist yet. The captures are substituted into the condition instead.
def pair_order(items: []int) -> str:
    match items:
        case [a, b] if a > b:
            return "descending"
        case [a, b] if a == b:
            return "equal"
        case [a, b]:
            return "ascending"
        case _:
            return "not a pair"
assert pair_order([2, 1]) == "descending"
assert pair_order([1, 1]) == "equal"
assert pair_order([1, 2]) == "ascending"
assert pair_order([1]) == "not a pair"

def sign_of(n: int) -> str:
    match n:
        case v if v < 0:
            return "negative"
        case 0:
            return "zero"
        case _:
            return "positive"
assert sign_of(-2) == "negative" and sign_of(0) == "zero" and sign_of(5) == "positive"

# None/True/False as patterns: the keyword literals had no rendering of their
# own, so `when None:` came out as an empty pattern. On an optional subject it
# is a presence test.
def presence(v: ?int) -> str:
    case v:
        when None:
            return "nothing"
        when others:
            return "something"
assert presence(None) == "nothing"
assert presence(3) == "something"

def flag_name(b: bool) -> str:
    case b:
        when True:
            return "on"
        when False:
            return "off"
assert flag_name(True) == "on" and flag_name(False) == "off"

# Optionals: a walrus in `if` tests presence (it used to ask an Option for
# .isNil), a guard that returns unwraps the name for the rest of the block,
# and an already-optional argument is not wrapped a second time.
def digits_to_int(s: str) -> ?int:
    if len(s) == 0:
        return None
    for c in s:
        if not (c >= '0' and c <= '9'):
            return None
    return int(s)

def fmap_int(m: ?int, f: [(int,)]int) -> ?int:
    if m is not None:
        return f(m)
    return None

def bump_one(raw: str) -> ?int:
    let v: ?int = digits_to_int(raw)
    if v is None:
        return None
    return v + 1              # v is a plain int from here on

var walrus_hit: int = 0
if w := digits_to_int("42"):
    walrus_hit = w
assert walrus_hit == 42

let doubled: ?int = fmap_int(digits_to_int("21"), lambda v: v * 2)
assert doubled is not None
let bumped: ?int = bump_one("41")
assert bumped is not None
if doubled is not None and bumped is not None:
    assert doubled == 42
    assert bumped == 42
assert bump_one("x") is None

# Traverse: all-or-nothing over a list of fallible parses.
def traverse_ints(tokens: []str) -> ?[]int:
    var acc: []int = []
    for tok in tokens:
        let v: ?int = digits_to_int(tok)
        if v is None:
            return None
        acc.append(v)
    return acc
let all_good: ?[]int = traverse_ints(["1", "42", "7"])
let one_bad:  ?[]int = traverse_ints(["1", "??", "7"])
assert all_good is not None
assert one_bad is None

# A discriminated record is an object, and construction has to know it:
# `Res_T(tag=OK, value=3)` was emitted as a call with keyword arguments.
type ResultTag_T is enum RTOk, RTErr

type Res_T (tag: ResultTag_T) is record:
    case tag is
        when RTOk:
            value: int
        when RTErr:
            message: str

def res_ok(value: int) -> Res_T:
    return Res_T(tag=RTOk, value=value)

def res_err(msg: str) -> Res_T:
    return Res_T(tag=RTErr, message=msg)

def parse_positive(s: str) -> Res_T:
    let n: ?int = digits_to_int(s)
    if n is None:
        return res_err("not an integer")
    return res_ok(n)

let good_res: Res_T = parse_positive("12")
let bad_res:  Res_T = parse_positive("oops")
assert good_res.tag == RTOk
assert good_res.value == 12
assert bad_res.tag == RTErr
assert bad_res.message == "not an integer"

# A local named `result` is the accumulator idiom Nim spells with its implicit
# result variable, and the Python backend spells with a synthesised prologue
# and return. On Nim it used to be emitted as an escaped local, `var `result``,
# which shadowed the implicit one -- so a function that let the implicit return
# hand it back returned the empty value instead, silently.
def concat_all(items: []str) -> str:
    result: str = ""
    for it in items:
        result = result + it
    result
assert concat_all(["a", "b", "c"]) == "abc"

def concat_all_explicit(items: []str) -> str:
    var result: str = ""
    for it in items:
        result = result + it
    return result
assert concat_all_explicit(["x", "y"]) == "xy"

# The same shape as c500's parse_c_str: accumulate into `result` inside a
# while loop, no explicit return.
def unescape_nl(inner: str) -> str:
    result: str = ""
    var i: int = 0
    while i < len(inner):
        if inner[i:i+1] == "\\" and i + 1 < len(inner) and inner[i+1:i+2] == "n":
            result = result + "\n"
            i = i + 2
        else:
            result = result + inner[i:i+1]
            i = i + 1
assert unescape_nl("a\\nb") == "a\nb"
assert len(unescape_nl("plain")) == 5

# A regex is a legal pattern in the match/case spelling too. It cannot stay a
# Nim `case` -- a regex is not a compile-time constant -- and only the
# case/when spelling used to be desugared, so this emitted `of re"...":` and
# never compiled. $+0 is the text the pattern claimed.
def token_kind(rest: str) -> str:
    match rest:
        case /^[a-zA-Z_][a-zA-Z0-9_]*/:
            return "name:" + $+0
        case /^[0-9]+/:
            return "int:" + $+0
        case _:
            return "other"
assert token_kind("foo_bar+1") == "name:foo_bar"
assert token_kind("1234;") == "int:1234"
assert token_kind("+++") == "other"

def guarded_regex(line: str) -> str:
    match line:
        case /error/i if len(line) > 8:
            return "long error"
        case /error/i:
            return "error"
        case _:
            return "other"
assert guarded_regex("ERROR: disk full") == "long error"
assert guarded_regex("error") == "error"
assert guarded_regex("all fine") == "other"

# A method on the result of str() has to survive the translation to Nim's `$`,
# and be read as a string method: `str(n).ljust(7)` used to emit a bare `$n`,
# dropping the call silently. rjust maps to strutils' `align` -- there is no
# alignRight, so it did not compile at all.
assert str(42).ljust(7) == "42     "
assert str(42).rjust(5) == "   42"
assert str(3.5).ljust(6) == "3.5   "
let pad_me: str = "ab"
assert pad_me.rjust(5) == "   ab"
assert pad_me.ljust(4) == "ab  "

# A guarded catch-all inside a regex match is a condition, not the end of the
# chain: emitted as `else:` it swallowed the branches after it.
def guarded_tail(line: str, on: bool) -> str:
    match line:
        case /^< [0-9]+ bytes:/ if on:
            return "bucket"
        case _ if on:
            return "closing"
        case /^header/:
            return "header"
        case _:
            return "ignored"
assert guarded_tail("< 10 bytes: 3", True) == "bucket"
assert guarded_tail("something else", True) == "closing"
assert guarded_tail("header line", False) == "header"
assert guarded_tail("plain", False) == "ignored"

# zfill pads with zeros but keeps a leading sign ahead of the padding, which
# strutils' align() cannot do -- it pads in front of the sign too. The Nim
# backend emits a helper for it.
assert str(42).zfill(6) == "000042"
assert "-5".zfill(4) == "-005"
assert "+5".zfill(4) == "+005"
assert "".zfill(4) == "0000"
assert "12345".zfill(4) == "12345"
assert "-12345".zfill(4) == "-12345"
assert "abc".zfill(4) == "0abc"
assert "-".zfill(4) == "-000"
assert str(-7).zfill(5) == "-0007"

# `$` binds tighter than any operator in Nim, so str() of anything that is not
# a name has to be parenthesised: `$-7` reads as the operator `$-`, and
# `$x + 1` stringifies x and then adds.
let sx: int = 4
assert str(-7) == "-7"
assert str(3 - 5) == "-2"
assert str(sx + 1) == "5"
assert str(sx) == "4"

# A char subject compared against character patterns in a block that cannot be
# a native Nim case -- one branch carries a guard -- was emitted as a string
# comparison (`ch == "("`), which Nim rejects.
def scan_chars(s: str) -> str:
    var acc: str = ""
    var i: int = 0
    let n: int = len(s)
    while i < n:
        let ch: char = s[i]
        match ch:
            case '"':
                acc = acc + "Q"
                i += 1
            case '\'' if i + 2 < n and s[i + 2] == '\'':
                acc = acc + "C"
                i += 3
            case '(':
                acc = acc + "["
                i += 1
            case ')':
                acc = acc + "]"
                i += 1
            case _:
                acc = acc + "."
                i += 1
    return acc
assert scan_chars("a(b)'x'") == ".[.]C"

# An enum round-trips through its own name without hand-written lookup
# ladders: str()/'Image serialize it, and the enum constructor reads it back.
# On Nim that is parseEnum[T](s); Python's Enum call syntax looks up by value,
# so the string form has to become T[s] there -- it used to pass straight
# through and raise ValueError.
type Kind_T is enum ALPHA, BETA, GAMMA

let kk: Kind_T = BETA
assert kk'Image == "BETA"
assert str(kk) == "BETA"
let kinds: []Kind_T = [ALPHA, GAMMA]
assert str(kinds[1]) == "GAMMA"          # 'Image does not attach to a subscript
assert Kind_T("GAMMA") == GAMMA          # string literal -> member by name
let kname: str = "ALPHA"
assert Kind_T(kname) == ALPHA            # str-typed variable -> member by name
assert Kind_T(2) == GAMMA                # ordinal argument still reads the ordinal
# The one argument may itself contain commas -- lv.ady writes
# State(s.replace("-", "_")) -- so only top-level commas mean "not a
# single-argument call".
let dashed: str = "GAM-MA"
assert Kind_T(dashed.replace("-", "")) == GAMMA

var round: []str = []
for k in Kind_T:
    round.append(str(Kind_T(str(k))))
assert ",".join(round) == "ALPHA,BETA,GAMMA"

# A tick on a name that is also a Python string prefix. `b'Image` is
# ambiguous -- Python opens a bytes literal at `b'`, Ada reads an attribute
# of b -- and the lexer's string branch, which runs first, used to swallow
# the tick and leave a parse error. Python wins wherever it can: the quote
# is a tick only when the literal it would open is never closed and a known
# attribute name follows it.
type Tick_T is enum ONE, TWO

let b: Tick_T = TWO
let r: Tick_T = ONE
let u: Tick_T = TWO
let f: Tick_T = ONE
let rb: Tick_T = TWO
assert b'Image == "TWO"                  # b, r, u, f, rb: all string prefixes
assert r'Image == "ONE"
assert u'Image == "TWO"
assert f'Image == "ONE"
assert rb'Image == "TWO"

# and the literals those prefixes really do open still tokenize as literals
assert r"raw\d+" == "raw\\d+"
assert r'raw\w+' == "raw\\w+"
assert r'First' == "First"               # an attribute name inside a literal
assert r'Image thing' == "Image thing"   # ... and one that continues past it
let who: str = "world"
assert f'hello {who}' == "hello world"

# Python 3's `u` prefix is a no-op left over from 2.x, but Nim has no such
# prefix: u"x" was emitted verbatim and read there as a call to a proc named
# u, and u'x' as a char literal that never closes. It now takes exactly the
# paths a bare literal takes.
assert u"double" == "double"
assert u'single' == "single"
assert U"upper" == "upper"
assert U'upper single' == "upper single"
assert u'has "quotes" too' == 'has "quotes" too'
assert len(u"") == 0

# A triple-quoted string used as a *value*. The Nim backend turned every
# triple-quoted literal into a `##` doc comment, wherever it appeared, so an
# assignment lost its right-hand side entirely. Only a bare expression
# statement is a docstring; everywhere else the literal is a value.
let tq1: str = """triple
double"""
let tq2: str = '''triple
single'''
assert tq1 == "triple\ndouble"
assert tq2 == "triple\nsingle"
assert len(tq1) == 13
assert u"""with the u prefix""" == "with the u prefix"

# Nim's own triple-quoted string is raw, so the value is re-emitted with Nim
# escapes rather than passed through: a literal that carries an escape or a
# double quote has to survive.
assert """has "quotes" and a tab\there""" == 'has "quotes" and a tab\there'
assert """back\\slash""" == "back" + chr(92) + "slash"

def tq_return() -> str:
    """A docstring stays a doc comment, next to a returned triple string."""
    return """the
value"""
assert tq_return() == "the\nvalue"

def tq_implicit() -> str:
    let s: str = """implicit
return"""
    s
assert tq_implicit() == "implicit\nreturn"

# A function whose only statement is a docstring. The Python backend read
# the docstring as the value of the last expression and rewrote it to
# `return """..."""`, so the function returned its own documentation and the
# docstring vanished from the output. A triple-quoted string in statement
# position is a docstring on both backends now, never a value.
def doc_only() -> str:
    """This is documentation, not a return value."""

assert doc_only() != "This is documentation, not a return value."

# A single-quoted string in tail position is still a value, as it is on Nim.
def single_quoted_tail() -> str:
    "the value"

assert single_quoted_tail() == "the value"

# Calling a proc that takes a char with a character literal. Adascript has no
# character type -- 'a' is a one-character string -- so every literal argument
# reached Nim with its quotes merely converted to double ones, and no proc
# taking a char could be called with one, not even 'a'. The reverse coercion,
# a char passed where a string is wanted, already existed.
def char_code(c: char) -> int:
    ord(c)

def is_open_paren(c: char) -> bool:
    c == '('

assert char_code('a') == 97
assert char_code('\'') == 39
assert char_code('\\') == 92
assert char_code('\t') == 9
assert char_code('\n') == 10
assert char_code('"') == 34
assert is_open_paren('(')
assert not is_open_paren(')')
