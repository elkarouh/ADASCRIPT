#!/usr/bin/env py2nim
"""
test_inline_suite — exercise inline form of if/elif/else/while.
"""

# inline if / elif / else
let x: int = 7
if x < 5: print("x<5")
elif x < 10: print("5<=x<10")
else: print("x>=10")

# inline while
var n: int = 3
while n > 0: n -= 1
print("n=", n)

# block forms still work
if x > 0:
    print("positive")
else:
    print("zero or negative")

# A bracketed expression spanning lines used to be emitted as the source
# wrote it, which skipped every translation inside: 'Length and the rest
# went into the Python output in Adascript spelling.  The layout is kept
# only where it says the same thing as the translated form.
let items: []str = ["a", "b", "c"]
let spread: []int = [
    items'Length,
    2]
let mapped: {str}int = {
    "n": items'Length}
let parend: int = (
    items'Length)
assert spread[0] == 3 and mapped["n"] == 3 and parend == 3
# Nothing to translate here, so this one keeps its shape.
let kept: {str}int = {
    "alpha": 1,
    "beta": 2,
}
assert kept["beta"] == 2

# A record field with no initialiser: Nim zero-initialises it, and Python
# rejects a dataclass whose defaultless field follows one with a default --
# at import time, so the whole module used to die rather than the record.
type Rec_T is record:
    label : str = "x"
    items : []str
    counts: {str}int

# And a record variable with no initialiser is that empty record, not None,
# so it can be filled in field by field the way one is normally built.
var rec : Rec_T
rec.items.append("one")
rec.counts["n"] = 1
assert rec.label == "x" and rec.items'Length == 1 and rec.counts["n"] == 1

# An enum declared inside a function renders to several lines, which used to
# land at column zero -- outside the function that declared them.
def local_enum_works() -> int:
    type Local_T is enum P, Q, R
    var got: int = 0
    case Q:
        when P: got = 1
        when Q:
            got = 2
            got = got + 10
        when others: got = 0
    got
assert local_enum_works() == 12

# A tuple pattern has no to_py of its own -- the parens belong to the
# grammar -- which used to crash the Python backend outright.  And a case in
# tail position returns whichever branch runs, exactly as an if does; without
# that the function returned None on Python while Nim got it right.
def classify(a: int, b: int) -> str:
    case (a, b):
        when (1, 2): "one-two"
        when (1, _): "one-any"
        when (_, 2): "any-two"
        when others: "neither"
assert classify(1, 2) == "one-two"
assert classify(1, 9) == "one-any"
assert classify(9, 2) == "any-two"
assert classify(7, 7) == "neither"

# The same, with block bodies rather than inline ones.
def classify_block(n: int) -> str:
    case n:
        when 1:
            "one"
        when others:
            "many"
assert classify_block(1) == "one" and classify_block(5) == "many"

# Path: a string that also joins with `/`. Both backends give the same
# thing -- Nim's std/paths Path (distinct string) with a converter back to
# string, Python a str subclass -- so a Path goes wherever a str goes.
let root: Path = Path("/tmp")
let leaf: Path = root / "a" / "b"
assert leaf == "/tmp/a/b"
assert (root / "x") == "/tmp/x"
let as_str: str = str(leaf)
assert as_str == "/tmp/a/b"
assert leaf.upper() == "/TMP/A/B"        # still a string
assert (-d root)                          # and a file test takes one
assert (root / "no-such-thing")'Length > 0

# Splitting one apart. `parent` and `name` follow Python's pathlib, which is
# what Nim's parentDir/lastPathPart already do -- os.path is the odd one out
# and is deliberately not the model: it calls the basename of "a/b/" empty.
assert leaf.parent == "/tmp/a"
assert leaf.name == "b"
assert Path("c.txt").parent == "."        # no directory part -> "."
assert Path("c.txt").name == "c.txt"
assert Path("a/b/").parent == "a"         # a trailing slash is not a component
assert Path("a/b/").name == "b"
assert Path("/a").parent == "/"           # ... but the root is its own parent
assert Path("/").parent == "/"
assert Path("").parent == "."
assert Path(".").name == ""               # "." names no file
assert Path("..").name == ".."

# mkdir() is mkdir -p on both backends: parents made, already-there is fine.
let sandbox: Path = Path("/tmp/adascript_path_test")
shell: rm -rf -- {!sandbox}
let deep: Path = sandbox / "x" / "y"
deep.mkdir()
deep.mkdir()
assert (-d deep)

# resolve() expands every symlink along the path. It follows Python's
# realpath, including on a path that does not exist yet: Nim's expandFilename
# raises there, so the helper falls back to resolving as much as does exist.
let real_file: Path = deep / "real.txt"
writeFile(real_file, "content\n")
let link: Path = sandbox / "link.txt"
shell: ln -s {!real_file} {!link}
let gone: Path = sandbox / "gone.txt"
assert link.resolve() == real_file
assert gone.resolve() == gone     # nothing there: resolved, not rejected
assert (-L link)                  # the link itself is still a link
assert (-f link)                  # ... and -f follows it to the file
assert (-e sandbox)               # -e is true for a directory on both
                                  # backends: it is exists(), not isfile()
shell: rm -rf -- {!sandbox}
assert not (-e sandbox)

# A range bound may be a whole expression, not just a name. Taking only the
# first node of a flattened `n-k+1 .. n` used to emit range(n, n + 1) --
# every `for j in i+1..hi` loop then started at i and quietly did an extra
# iteration, which is how tsp.ady and timetable_engine.ady were wrong on the
# Python backend without failing.
let rn: int = 10
let rk: int = 3
var lo_terms: []int = []
for i in rn-rk+1..rn:
    lo_terms.append(i)
assert lo_terms == [8, 9, 10]
var hi_terms: []int = []
for i in 1..rn-rk:
    hi_terms.append(i)
assert hi_terms == [1, 2, 3, 4, 5, 6, 7]
var excl: []int = []
for i in rn-rk+1..<rn:
    excl.append(i)
assert excl == [8, 9]
var pairs: []str = []
for i in 0..3:
    for j in i+1..3:
        pairs.append(f"{i}{j}")
assert pairs == ["01", "02", "03", "12", "13", "23"]

# An ordinary binary operator on the right of a comparison is not a range.
# The range emitter used to ask only whether the operator was "..<", so
# every other one -- `-`, `*`, `/` -- fell into the inclusive branch and
# `a < b - c` came out as `a < range(b, c + 1)`. It parsed and it ran.
let bn: int = 8
let bh: int = 4
assert bh == bn // 2
assert not (bh == bn * 2)
assert bh < bn - 1
assert not (bh > bn - 1)
assert bh == bn - 4
assert (bh == bn % 5) == False
let proot: Path = Path("/tmp")
assert (proot / "x") == proot / "x"

# A bare `x : T` is Python's annotation: it records a type and binds
# nothing, so the assignment is what declares. py2nim used to emit `var x: T`
# for it, which made code written that way build here and raise
# UnboundLocalError there. The annotation's type is still carried to the
# assignment, so this is `var ann_then: int = 5` in the Nim output.
ann_then: int
ann_then = 5
assert ann_then == 5
# (A declaration is `var x: T`. Reading a bare-annotated name before
# assigning it is now an error on both backends, so it cannot be asserted
# here -- it fails to compile on Nim and raises on Python.)

# A field, though, is declared by exactly that spelling -- Rec_T above has
# `items : []str` with no initialiser -- which is why the two cases are
# told apart rather than the form being rejected outright.
type Field_T is record:
    tag:   str = "t"
    extra: []str
var fr : Field_T
fr.extra.append("e")
assert fr.tag == "t" and fr.extra'Length == 1

# A comprehension fills an array as well as a list -- the annotation decides
# which, and the values land in domain order. The key may be a length, a
# constant, a subrange (including one that does not start at zero), an enum
# or bool: Nim was emitting `0 ..< Idx` for the named ones, which is
# `pred` on a typedesc, and Python was leaving the value a plain list, which
# indexes from 0 whatever the domain says.
#
# Where the key is a named type the generator iterates that type, so the
# loop variable is the key each value is about rather than a count that
# happens to be the right length. `ord` gives its position -- Python's
# builtin is the one-character-string case only, so the emitter supplies
# the rest. A length has no type to name, so those two still count.
type Off_T is 2 .. 6
type Hue_T is enum ROSE, JADE, SLATE
const NC: int = 5
var cLit:  [5]int     = [i*i for i in 0..4]
var cConst:[NC]int    = [i*i for i in 0..4]
var cOff:  [Off_T]int = [o*10 for o in Off_T]
var cHue:  [Hue_T]int = [ord(h)*10 for h in Hue_T]
var cBool: [bool]int  = [ord(b)+300 for b in bool]
assert cLit[0] == 0 and cLit[4] == 16
assert cConst[4] == 16
assert cOff[2] == 20 and cOff[6] == 60       # domain 2..6, so 20 sits at 2
assert cHue[ROSE] == 0 and cHue[SLATE] == 20
assert cBool[False] == 300 and cBool[True] == 301
# ord() over every ordinal, not just the character it is in Python
assert ord("a") == 97 and ord(JADE) == 1 and ord(True) == 1 and ord(4) == 4
# and the two builtin ordinals are domains a plain loop can walk too
var nchars: int = 0
for c in char:
    nchars += 1
assert nchars == 256
var nbools: []bool = []
for b in bool:
    nbools.append(b)
assert nbools == [False, True]

# An enum-bounded range is written like an integer one and means the same
# thing on Nim. Python's range() takes integers, so `E'First .. E'Last` --
# which both tutorials give as the Ada spelling of the enum loop -- emitted
# `range(STAGE1, STAGE3 + 1)` and died on the addition.
type Stage_T is enum STAGE1, STAGE2, STAGE3, STAGE4
var walked: []str = []
for s in Stage_T'First .. Stage_T'Last:
    walked.append(s'Image)
assert walked == ["STAGE1", "STAGE2", "STAGE3", "STAGE4"]
var partly: []str = []
for s in STAGE2 .. STAGE4:
    partly.append(s'Image)
assert partly == ["STAGE2", "STAGE3", "STAGE4"]
var upto: []str = []
for s in Stage_T'First ..< Stage_T'Last:
    upto.append(s'Image)
assert upto == ["STAGE1", "STAGE2", "STAGE3"]
# Membership over the same bounds. A plain Enum has no ordering, so the
# `lo <= x <= hi` chain the integer form uses raises here; ask the members.
assert STAGE2 in Stage_T'First .. Stage_T'Last
assert not (STAGE1 in STAGE2 .. STAGE4)
assert not (STAGE4 in Stage_T'First ..< Stage_T'Last)
# ... and `..<` really is exclusive. The emitter looked for a child node
# spelled '<' where the whole `..<` token sits, so it never matched and
# every `x in lo ..< hi` came out inclusive: `100 in 1 ..< 100` was true
# on Python and false on Nim.
assert 5 in 1 .. 100
assert not (100 in 1 ..< 100)
assert 99 in 1 ..< 100

# A bare enum prints as its member name, as Nim's `$` does. Python's
# default is "Stage_T.STAGE2", so the same f-string said two different
# things depending on the backend. (A *container* of them still differs --
# that is repr, and it is in TODO.md.)
let st: Stage_T = STAGE2
assert f"{st}" == "STAGE2"
assert str(st) == "STAGE2"
assert st'Image == "STAGE2"

# `+` concatenates strings on both backends: the Nim emitter rewrites it to
# that language's `&` once it can tell an operand is a string. It could not
# see through `str(...)`, which renders as `$x` -- so `str(a) + str(b)`
# emitted `$a + $b`, and Nim's `+` has no string overload. The only
# spelling left was `&`, which is bitwise-and on Python: that is how
# sudoku.ady came to be Nim-only.
let ca: str = "A"
let cb: str = "1"
assert ca + cb == "A1"
assert str(ca) + str(cb) == "A1"
var joined: str = ""
for ch in "AB":
    joined += str(ch) + "-"
assert joined == "A-B-"

# `+` joins two comprehensions as well as two literals. A comprehension
# renders to `collect(...)` on Nim, which the seq/string test did not
# recognise, so `[..] + [..]` reached Nim's numeric `+` -- and sudoku.ady's
# unit list had to be built by appending in a loop instead.
var lhs: []str = ["a", "b"]
assert [str(c) for c in "ab"] + [str(c) for c in "cd"] == ["a", "b", "c", "d"]
assert lhs + [str(c) for c in "cd"] == ["a", "b", "c", "d"]
assert [str(c) for c in "ab"] + lhs == ["a", "b", "a", "b"]
# ... including a comprehension with two generators, as that list uses.
var grid: []str = [str(r) + str(c) for r in ["A", "B"] for c in ["1", "2"]]
assert grid == ["A1", "A2", "B1", "B2"]

# A comprehension's loop variables are typed from what they iterate, the
# same as a `for` statement's. Without that, a bare `r + c` between two of
# them was not seen as string concatenation and reached Nim's numeric `+`,
# so only the `str(r) + str(c)` spelling above compiled. The element
# expression is rendered after the clauses now, for the types to exist by
# the time it needs them.
assert [r + c for r in ["A", "B"] for c in ["1", "2"]] == ["A1", "A2", "B1", "B2"]
assert [w + "!" for w in ["a", "b"]] == ["a!", "b!"]
assert [v for v in ["aa", "b"] if v'Length > 1] == ["aa"]
assert {k: k + "!" for k in ["p"]}["p"] == "p!"
let zset: {}str = {v + "z" for v in ["m", "n"]}   # a tick needs a name
assert zset'Length == 2
assert [[a + b for b in ["1", "2"]] for a in ["A"]] == [["A1", "A2"]]
# Iterating a string gives chars, and char + char is a string on both
# backends -- Nim's `&(char, char)` builds one, Python's are already
# one-character strings. This is sudoku.ady's cross().
assert [p + q for p in "AB" for q in "12"] == ["A1", "A2", "B1", "B2"]
# And a char reaching a `str` parameter is converted rather than rejected:
# `cross(ROWS, c)` type-checks on Python, where c is a one-character
# string, and used to need a hand-written str(c) for Nim alone.
def take_str(s: str, t: str) -> str:
    s + t
let pair: str = "xy"
assert [take_str("<", ch) for ch in pair] == ["<x", "<y"]
assert take_str("<", pair[0]) == "<x"
# ... and the same at a declaration, and appending to a []str. Those three
# sites are what let sudoku.ady's parse_grid filter grid characters
# directly, with no `str(c)` temporary standing in between.
var first: str = pair[0]
assert first == "x"
var seen: []str = []
for ch in pair:
    if ch != "y":
        seen.append(ch)
assert seen == ["x"]
# The binding is scoped to the comprehension, as it is in Python: the same
# name can be a string in one and an int in the next, and an outer name of
# that spelling is untouched.
assert [same + 1 for same in [10, 20]] == [11, 21]
assert [same + "?" for same in ["p"]] == ["p?"]
let same: int = 5
assert same + 1 == 6
# and the literal forms are untouched
var cLitE: [Hue_T]int = [ROSE: 1, JADE: 2, SLATE: 3]
assert cLitE[SLATE] == 3

# Every [O]T yields its values, in domain order, on both backends. The
# enum-keyed one is a dict on Python, so left alone it would be the only
# member of the family to yield its keys -- and in the order the literal
# happened to be written rather than the order of the enum.
type Shade_T is enum LIGHT, MID, DARK
var shade: [Shade_T]int = [DARK: 3, LIGHT: 1, MID: 2]
var shades: []int = []
for v in shade:
    shades.append(v)
assert shades == [1, 2, 3]        # enum order, not literal order
assert shade[LIGHT] == 1 and shade[DARK] == 3
shade[MID] = 9
assert shade[MID] == 9
assert shade'Length == 3
var fixed3: [3]int = [10, 20, 30]
var fixed3v: []int = []
for v in fixed3:
    fixed3v.append(v)
assert fixed3v == [10, 20, 30]    # ... and the rest of the family agrees

# A real dict keyed by an enum is untouched: `{E}V` iterates keys, which is
# what a dict does on Python and a Table does on Nim.
var shade_tbl: {Shade_T}int = {:}
shade_tbl[LIGHT] = 1
var shade_keys: []str = []
for k in shade_tbl:
    shade_keys.append(k'Image)
assert shade_keys == ["LIGHT"]

# char is an ordinal, so [char]T is an array with 256 slots. Adascript has
# no character literal -- it is a Python superset, so 'a' is a one-character
# string -- and Nim's array[char, T] cannot be indexed by a string, so the
# emitter converts. Escapes included: "\\" and "\n" are one character in the
# source but two once rendered, which a naive conversion leaves behind.
var freq: [char]int
freq['a'] = 3
freq['z'] = freq['a'] + 1
freq[chr(98)] = 7
freq["'"] = 1
freq["\\"] = 2
freq["\n"] = 4
assert freq['a'] == 3 and freq['z'] == 4 and freq[chr(98)] == 7
assert freq["'"] == 1 and freq["\\"] == 2 and freq["\n"] == 4
var keyed: {str}int = {:}      # a string-keyed table is not touched
keyed["a"] = 9
assert keyed["a"] == 9

# 'Range on a type is its domain; on a value it is the index range.
type Hue is enum PINK, TEAL
let hues: {}Hue = Hue'Range
assert hues'Length == 2
assert (Hue'Range - {PINK})'Length == 1
let word: str = "abc"          # a tick needs a name, not a literal
var idxs: []int = []
for i in word'Range:
    idxs.append(i)
assert idxs == [0, 1, 2]


# An inline `when` branch that already returns must not be turned into an
# implicit return: `f(x); return True` has its value in the *last* statement,
# and marking the head both drops the real return and returns the wrong thing.
def noop():
    pass
def dispatch(word: str) -> bool:
    case word:
        when "go":    noop(); return True
        when "stop":  noop(); return True
        when others:  return False
assert dispatch("go") and dispatch("stop") and not dispatch("other")

# case with inline when clauses
let y: int = 2
case y:
    when 1: print("one")
    when 2: print("two")
    when 3: print("three")
    when others: print("other")

print("done")
