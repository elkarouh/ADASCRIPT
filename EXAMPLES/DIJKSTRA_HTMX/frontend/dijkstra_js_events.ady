#!/usr/bin/env ady2nim
#ady2nim-args js
"""dijkstra_js_events -- the drawing's own behaviour, in the browser: what a diagram editor does.

Every other event is declared in the HTML (hx-* attributes, dijkstra_gui.ady) and handled
on the server (dijkstra_events.ady); only what must follow the mouse, select, or ask the
reader a question is here. The gestures, the usual ones of a diagram:

    click a node                 chooses the route: the start, then the goal
    click an edge                selects it (it is outlined); the space deselects
    drag a node                  moves it; its edges follow, and where it is let go is kept
    drag from a node's dot       draws a wire to another node: the edge, after its cost is asked
    double-click the space       a new node there (asks the name)
    double-click an edge         its cost (asks it)
    right-click                  a menu of what can be done to what was clicked
    Delete, Backspace            removes the selection (asks first)
    Escape                       closes the menu

A change the server must keep
is written into the hidden form #gesture, whose button then sends it (see dijkstra_gui.ady).

The nodes and edges here are the model's own (backend/dijkstra_model.ady): a node or an edge is read
off the drawing as a Node_T or an Edge_T, and what a gesture does is said in those terms.

The drag itself is the standard library's svg_drag; the page (finding elements, forms, menus,
questions, keys) its browser module, both in TO_NIM/STDLIB. This file says only what each
gesture means in this app.
"""
from browser import Element_T, Event_T, Click_T, click_of, page, find, all, data, fill, press, on, left, made_by_reader, stop, cancel, ask, ask_yes, key_of, show_at, attr, set_attr, has_class, number, listen, listen_first
from svg_drag import Hooks_T, Unit_T, Spot_T, spot_of, spot_at, between, shift, draw_line, place_at, no_click_cb, draggable
from backend/dijkstra_model import Node_T, Edge_T

const WIDTH: Unit_T = 580.0     # the drawing's size (the svg's viewBox)
const HEIGHT: Unit_T = 380.0
const MARGIN: Unit_T = 30.0     # how near its edge a node may go

# ---- The model's values, read off the drawing, and the drawing of each ----

# The node a <g class="node"> draws: its name, and its centre as the server put it.
def node_of(el: Element_T) -> Node_T:
    return Node_T(el.data("name"), el.number("data_x"), el.number("data_y"))

# The edge a <g data_from data_to data_cost> draws.
def edge_of(el: Element_T) -> Edge_T:
    return Edge_T(el.data("from"), el.data("to"), int(el.number("data_cost")))

# The <g class="node"> that draws N.
def node_element(n: Node_T) -> Element_T:
    return page.element(f"g.node[data_name=\"{n.name}\"]")

# The <g> that draws E.
def edge_element(e: Edge_T) -> Element_T:
    return page.element(f"g[data_from=\"{e.a}\"][data_to=\"{e.b}\"]")

# Where the node named NAME is drawn now: an end of an edge, when only its name is known.
def end_spot(name: str) -> Spot_T:
    for el in page.all("g.node"):
        if node_of(el).name == name:
            return spot_of(el)
    return Spot_T(x=0.0, y=0.0)

# The hidden form whose fields a gesture fills in, and whose buttons send them (dijkstra_gui.ady).
def gesture() -> Element_T:
    return page.element("#gesture")

# Redraw, in the browser, the edges that end at NODE, as if it stood at AT.
#
# While a node is dragged, the server is not asked (it is told once, when the mouse is let
# go); but the node's edges must not be left pointing at where it was. So on every mouse move
# each edge of NODE is drawn again from AT to its other end, which has not moved, and its cost
# is put back at the line's middle. Edges that do not touch NODE are left alone.
#
# An edge is <g data_from="A" data_to="B"> holding <path>s (the line, and the wider one to
# point at) and a <text class="cost">.
def redraw_edges_of(node: Node_T, at: Spot_T):
    for el in page.all("g[data_from]"):
        let edge: Edge_T = edge_of(el)
        if node.name in [edge.a, edge.b]:
            # the end that is NODE is at AT; the other end stays where it is
            let a: Spot_T = (at if edge.a == node.name else end_spot(edge.a))
            let b: Spot_T = (at if edge.b == node.name else end_spot(edge.b))
            for line in el.all("path"):
                line.draw_line(a, b)
            el.element("text.cost").place_at(Spot_T(x=(a.x + b.x) / 2.0, y=(a.y + b.y) / 2.0 - 6.0))   # just above the line

# While NODE is dragged: it goes where the mouse takes it, kept inside the drawing, and its
# edges follow.
def moved_cb(node: Element_T, centre: Spot_T, wanted: Spot_T) -> Spot_T:
    let now: Spot_T = Spot_T(x=between(wanted.x, MARGIN, WIDTH - MARGIN), y=between(wanted.y, MARGIN, HEIGHT - MARGIN))
    shift(node, centre, now)
    redraw_edges_of(node_of(node), now)
    return now

# NODE let go at AT: tell the server, the way a form is sent. The hidden form #move gets the
# node's name and new centre, and its button #redraw sends it (hx-put="/nodes", see
# dijkstra_gui.ady); htmx puts the page the server answers with in place of this one.
def dropped_cb(node: Element_T, at: Spot_T):
    let form: Element_T = page.element("#move")
    form.fill("name", node_of(node).name)
    form.fill("x", f"{at.x:.0f}")
    form.fill("y", f"{at.y:.0f}")
    page.press("#redraw")

# ---- The selection: the node or edge the reader last clicked ----

var selected_kind: str = ""             # "node", "edge", or "" for none
var selected_node: Node_T = Node_T("", 0.0, 0.0)
var selected_edge: Edge_T = Edge_T("", "", 0)

# Outline ELEMENT, or take the outline off it.
def mark(el: Element_T, lit: bool):
    let cls: str = el.attr("class")
    if lit:
        el.set_attr("class", cls + " selected")
    else:
        el.set_attr("class", cls.replace(" selected", ""))

def clear_selection():
    for el in page.all(".selected"):
        mark(el, false)
    selected_kind = ""

# Select NODE, in place of what was selected. Only the right click does this (see context).
def select_node(node: Element_T):
    clear_selection()
    selected_kind = "node"
    selected_node = node_of(node)
    mark(node, true)

# Select EDGE, in place of what was selected.
def select_edge(edge: Element_T):
    clear_selection()
    selected_kind = "edge"
    selected_edge = edge_of(edge)
    mark(edge, true)

# A click that svg_drag did not take for a drag. On a node it chooses it for the route, or, when
# it is chosen already (drawn as the start or the goal), takes it out of the route again. Anything
# else is a selection: the edge under the click is selected, and the empty space clears it. A click
# outside the drawing (the toolbar, a menu) is none of this.
def clicked_cb(c: Click_T):
    if on(c, "svg.graph") is None:
        return
    let node: ?Element_T = on(c, "g.node")
    if node is not None:
        clear_selection()
        choose(node_of(node), has_class(node, "start") or has_class(node, "goal"))
        return
    let edge: ?Element_T = on(c, "g[data_from]")
    if edge is None:
        clear_selection()
        return
    select_edge(edge)

# The page was drawn again by the server: what was selected is gone with the old drawing.
def forget_selection(e: Event_T):
    selected_kind = ""

# ---- Asking the reader, and sending the answer ----

def ask_name() -> str:
    return ask("Name of the new node (letters and digits)?", "")

# Send a new node NAME: placed at X, Y (drawing units, as text) when given, else where the server puts it.
def send_node(name: str, x: str, y: str):
    let form: Element_T = gesture()
    form.fill("name", name)
    form.fill("x", x)
    form.fill("y", y)
    page.press("#make_node")

# Ask the cost of EDGE, and send it.
def change_cost(edge: Edge_T):
    let cost: str = ask(f"Cost of the edge {edge.a} — {edge.b}?", str(edge.cost))
    if cost == "":
        return
    let form: Element_T = gesture()
    form.fill("a", edge.a)
    form.fill("b", edge.b)
    form.fill("cost", cost)
    page.press("#set_cost")

# Delete what is selected, after asking.
def remove_selected():
    let form: Element_T = gesture()
    if selected_kind == "node":
        if ask_yes(f"Delete the node {selected_node.name} and its edges?"):
            form.fill("name", selected_node.name)
            page.press("#drop_node")
    elif selected_kind == "edge":
        if ask_yes(f"Delete the edge {selected_edge.a} — {selected_edge.b}?"):
            form.fill("a", selected_edge.a)
            form.fill("b", selected_edge.b)
            page.press("#drop_edge")

# Choose NODE for the route: the start, then the goal (the server decides which, and draws the way);
# or, with UNPICK, take a chosen node out of the route again.
def choose(node: Node_T, unpick: bool):
    let form: Element_T = gesture()
    form.fill("pick", node.name)
    form.fill("act", ("unpick" if unpick else ""))
    page.press("#pick")

# ---- Double-click: a new node in the space, or a new cost for an edge ----

def double_click(e: Event_T):
    let c: Click_T = click_of(e)
    let edge: ?Element_T = on(c, "g[data_from]")
    if edge is not None:
        change_cost(edge_of(edge))
        return
    if on(c, "svg.graph") is None or on(c, "g.node") is not None:
        return                          # outside the drawing, or on a node (which has no double-click)
    let name: str = ask_name()
    if name == "":
        return
    let at: Spot_T = spot_at(e)
    send_node(name, f"{between(at.x, MARGIN, WIDTH - MARGIN):.0f}", f"{between(at.y, MARGIN, HEIGHT - MARGIN):.0f}")

# ---- Right-click: a menu of what can be done to what was clicked ----

var menu_at: Spot_T = Spot_T(x=0.0, y=0.0)     # where the menu of the space was opened

def hide_menus():
    for m in page.all(".menu"):
        m.set_attr("style", "display:none")

def context(e: Event_T):
    let c: Click_T = click_of(e)
    if on(c, "svg.graph") is None:
        return                          # the rest of the page keeps the browser's own menu
    cancel(c)
    hide_menus()
    let node: ?Element_T = on(c, "g.node")
    let edge: ?Element_T = on(c, "g[data_from]")
    if node is not None:
        select_node(node)
        show_at(page.element("#menu-node"), c)
    elif edge is not None:
        select_edge(edge)
        show_at(page.element("#menu-edge"), c)
    else:
        clear_selection()
        menu_at = spot_at(e)
        show_at(page.element("#menu-space"), c)

# ---- The toolbar and the menus: a button with data_tool does that action ----

def tool_click(e: Event_T):
    let c: Click_T = click_of(e)
    let b: ?Element_T = on(c, "button[data_tool]")
    if b is None:
        hide_menus()                    # a click elsewhere closes the menus
        return
    hide_menus()
    let tool: str = b.data("tool")
    if tool == "add-here":
        let name: str = ask_name()
        if name != "":
            send_node(name, f"{menu_at.x:.0f}", f"{menu_at.y:.0f}")
    elif tool == "cost":
        if selected_kind == "edge":
            change_cost(selected_edge)
    elif tool == "delete-node" or tool == "delete-edge":
        remove_selected()

# Delete and Backspace remove what is selected; Escape closes the menus.
def key_down(e: Event_T):
    let key: str = key_of(e)
    if key == "Escape":
        hide_menus()
    elif key == "Delete" or key == "Backspace":
        remove_selected()

# ---- A drag from a node's dot: a wire, which is the new edge ----
#
# Pressing on a node's dot (circle.port) holds it for a wire, not for a move: the press is
# stopped before svg_drag sees it. While the mouse moves, a dashed line (path#wire, hidden
# until then) runs from that node to the mouse. Letting go on another node asks the cost and
# sends the edge. The browser's click after the release belongs to the wire, so it is not a
# selection, and htmx does not see it.

var linking: bool = false               # a wire is being drawn
var from_node: Node_T = Node_T("", 0.0, 0.0)     # the node the wire starts at
var swallow: bool = false               # the click after a wire is let go: not a click on a node

def link_down(e: Event_T):
    let c: Click_T = click_of(e)
    if not left(c) or on(c, "circle.port") is None:
        return
    let node: ?Element_T = on(c, "g.node")
    if node is None:
        return
    stop(c)
    from_node = node_of(node)
    linking = true
    swallow = false
    let wire: Element_T = page.element("path#wire")
    wire.set_attr("visibility", "visible")
    draw_line(wire, spot_of(node), spot_at(e))

def link_move(e: Event_T):
    if not linking:
        return
    draw_line(page.element("path#wire"), spot_of(node_element(from_node)), spot_at(e))

def link_up(e: Event_T):
    if not linking:
        return
    linking = false
    page.element("path#wire").set_attr("visibility", "hidden")
    swallow = true
    let target: ?Element_T = on(click_of(e), "g.node")
    if target is None:
        return
    let to: Node_T = node_of(target)
    if to.name == from_node.name:
        return
    let cost: str = ask(f"Cost of the edge {from_node.name} — {to.name}?", "1")
    if cost == "":
        return
    let form: Element_T = gesture()
    form.fill("a", from_node.name)
    form.fill("b", to.name)
    form.fill("cost", cost)
    page.press("#make_edge")

# The click after the release is the reader's, and goes no further. A click the script makes
# itself (the button that sends the edge) is not the reader's, and is let through.
def swallow_click(e: Event_T):
    let c: Click_T = click_of(e)
    if swallow and made_by_reader(c):
        swallow = false
        stop(c)

listen_first("mousedown", link_down)
listen("mousemove", link_move)
listen("mouseup", link_up)
listen_first("click", swallow_click)
listen("click", tool_click)
listen("dblclick", double_click)
listen("contextmenu", context)
listen("keydown", key_down)
listen("htmx:afterSwap", forget_selection)
draggable("g.node", "svg.graph", WIDTH, Hooks_T(moved_cb=moved_cb, dropped_cb=dropped_cb, clicked_cb=clicked_cb))
