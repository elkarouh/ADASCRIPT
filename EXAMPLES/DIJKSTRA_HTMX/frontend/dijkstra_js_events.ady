#!/usr/bin/env ady2nim
#ady2nim-args js
"""dijkstra_js_events -- the events that stay in the browser: a node dragged with the mouse.

Every other event is declared in the HTML (hx-* attributes, dijkstra_gui.ady) and handled
on the server (dijkstra_events.ady); only what must follow the mouse every frame is here.

A node is a <g class="node" data_name=".." data_x=".." data_y=".."> (its centre, in the
drawing's units) and an edge a <g data_from=".." data_to=".."> holding a path and its
cost. While a node is dragged it moves and its edges follow, here in the browser, at once.
Letting go writes the node's name and new centre into the hidden form `#move` and clicks
its button, which sends PUT /nodes: the server keeps the new place and draws the page again.

A press that does not move is a click, and goes on to htmx (it picks the node).

The mouse speaks in pixels and the drawing in its own units: two units, which the compiler
keeps apart, and a scale between them. A drag is one value, the grip, whose phase says
which fields it has: nothing is held when IDLE, so nothing held can be read then.
"""
from dom nimport Event, Element, InputElement, MouseEvent, BoundingRect, Node, document, getBoundingClientRect, addEventListener, getAttribute, setAttribute, querySelector, querySelectorAll, click, stopPropagation, preventDefault, closest, value

type Pixel_T is distinct float          # on the screen, as the mouse reports it
type Unit_T is distinct float           # in the drawing, as the server keeps a node's place
type Scale_T is Unit_T / Pixel_T        # drawing units a pixel

type Screen is tuple:                   # a place on the screen
    x: Pixel_T
    y: Pixel_T

type Spot is tuple:                     # a place in the drawing
    x: Unit_T
    y: Unit_T

const WIDTH: Unit_T = 580.0             # the drawing's size
const HEIGHT: Unit_T = 380.0
const MARGIN: Unit_T = 30.0             # how near its edge a node may go
const MOVED: Pixel_T = 4.0              # how far a press goes before it is a drag

# IDLE: nothing pressed. PRESSED: a node is held but has not moved, so letting go is a
# click. DRAGGING: it has moved. DROPPED: a drag has just ended, and the click the browser
# sends after it is not a click.
type Phase_T is enum IDLE, PRESSED, DRAGGING, DROPPED

type Grip_T (phase: Phase_T) is record:
    case phase is
        when PRESSED | DRAGGING:
            node:   Node                # the <g class="node"> held
            name:   str
            down:   Screen              # where the mouse went down
            centre: Spot                # the node's centre then
            now:    Spot                # and where it has been dragged to
        when others:
            pass

var grip: Grip_T = IDLE()

def unit_of(node: Node, attr: str) -> Unit_T:
    let r: float | !ParseFailure_T = parse_float(str(node.getAttribute(cstring(attr))))
    if r is ParseFailure_T:
        return 0.0
    return Unit_T(r)

def spot_of(node: Node) -> Spot:
    return Spot(x=unit_of(node, "data_x"), y=unit_of(node, "data_y"))

def node_named(name: str) -> Node:
    return document.querySelector(cstring(f"g.node[data_name=\"{name}\"]"))

def screen_of(m: MouseEvent) -> Screen:
    return Screen(x=Pixel_T(float(m.clientX)), y=Pixel_T(float(m.clientY)))

# How many drawing units a pixel is: the drawing is scaled to fit the page.
def scale() -> Scale_T:
    let box: BoundingRect = document.querySelector("svg.graph").getBoundingClientRect()
    return WIDTH / Pixel_T(box.width)

def inside(v: Unit_T, size: Unit_T) -> Unit_T:
    return max(MARGIN, min(size - MARGIN, v))

# The node's edges drawn again from AT, and their costs moved to their middles.
def follow(name: str, at: Spot):
    for e in document.querySelectorAll("g[data_from]"):
        let ends: (str, str) = (str(e.getAttribute(cstring("data_from"))), str(e.getAttribute(cstring("data_to"))))
        if name in [ends[0], ends[1]]:
            let a: Spot = (at if ends[0] == name else spot_of(node_named(ends[0])))
            let b: Spot = (at if ends[1] == name else spot_of(node_named(ends[1])))
            e.querySelector("path").setAttribute(cstring("d"), cstring(f"M {a.x:.0f} {a.y:.0f} L {b.x:.0f} {b.y:.0f}"))
            let cost: Node = e.querySelector("text.cost")
            cost.setAttribute(cstring("x"), cstring(f"{(a.x + b.x) / 2.0:.0f}"))
            cost.setAttribute(cstring("y"), cstring(f"{(a.y + b.y) / 2.0 - 6.0:.0f}"))

def set_field(name: str, value: str):
    let field: InputElement = InputElement(document.querySelector(cstring(f"#move input[name={name}]")))
    field.value = cstring(value)

def on_down(e: Event):
    let m: MouseEvent = MouseEvent(e)
    if m.button != 0:
        return
    let node: Node = e.target.closest("g.node")
    if node == nil:
        return
    let centre: Spot = spot_of(node)
    grip = PRESSED(node, str(node.getAttribute(cstring("data_name"))), screen_of(m), centre, centre)
    e.preventDefault()                  # no text selected while dragging

def on_move(e: Event):
    case grip.phase:
        when PRESSED | DRAGGING:
            let at: Screen = screen_of(MouseEvent(e))
            let dx: Pixel_T = at.x - grip.down.x
            let dy: Pixel_T = at.y - grip.down.y
            if grip.phase == PRESSED and abs(dx) < MOVED and abs(dy) < MOVED:
                return                  # not yet a drag: it may still be a click
            let k: Scale_T = scale()
            let now: Spot = Spot(x=inside(grip.centre.x + dx * k, WIDTH), y=inside(grip.centre.y + dy * k, HEIGHT))
            grip = DRAGGING(grip.node, grip.name, grip.down, grip.centre, now)
            grip.node.setAttribute(cstring("transform"), cstring(f"translate({now.x - grip.centre.x:.1f},{now.y - grip.centre.y:.1f})"))
            follow(grip.name, now)
        when others:
            pass

def on_up(e: Event):
    case grip.phase:
        when PRESSED:
            grip = IDLE()               # a click: htmx has it
        when DRAGGING:
            set_field("name", grip.name)
            set_field("x", f"{grip.now.x:.0f}")
            set_field("y", f"{grip.now.y:.0f}")
            document.querySelector("#redraw").click()
            grip = DROPPED()            # after the click above, which must go through
        when others:
            pass

# The click after a drag is swallowed before htmx sees it: a node is not picked by being moved.
def on_click(e: Event):
    if grip.phase == DROPPED:
        grip = IDLE()
        e.stopPropagation()

document.addEventListener("mousedown", on_down)
document.addEventListener("mousemove", on_move)
document.addEventListener("mouseup", on_up)
document.addEventListener("click", on_click, True)
