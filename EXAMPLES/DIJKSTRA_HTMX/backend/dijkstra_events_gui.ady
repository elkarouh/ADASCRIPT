#!/usr/bin/env ady2nim
"""dijkstra_events_gui -- what each event the page sends does, and the network it does it to; no HTTP.

server.ady hands every request here as a method, a path and its fields, and sends back
the page that comes out. The tests call answer() the same way, with no server running.
The network is kept in a text file (keep_in), written after every change.
"""
from backend/dijkstra_model import Network_T, add_edge, add_node, names_of, network_of, remove_edge, remove_node, sample, set_cost, text_of
from backend/dijkstra_layout_gui import Layout, Place_T, layout_of, new_spot, sample_layout
from backend/dijkstra_gui import all_text, field_of, params_of

var net: Network_T = sample()
var layout: Layout = sample_layout()   # where each node is drawn (dijkstra_layout_gui.ady), kept with the network
var store: str = ""                     # the file the network is kept in; "" keeps it nowhere (the tests)

# Network and layout, kept together in PATH: the node and edge lines, then the "at" lines.
def save(net: Network_T, layout: Layout, path: Path) -> str:
    let done: None | !PathFailure_T = path.write_text(text_of(net) + layout.text_of(net))
    if done is PathFailure_T:
        return f"Could not write {path}."
    return ""

# From now on the network is the one kept in PATH ("": the sample, kept nowhere).
def keep_in(path: str):
    store = path
    net = sample()
    layout = sample_layout()
    if path != "":
        let text: str | !PathFailure_T = Path(path).read_text()
        if text is PathFailure_T:
            return                      # no file yet: the sample
        net = network_of(text)
        layout = layout_of(text)

def number_of(text: str) -> float:
    let n: float | !ParseFailure_T = parse_float(text)
    if n is ParseFailure_T:
        return -1.0
    else:
        return n

# What METHOD on PATH does, with FIELDS (the query and the body, "a=1&b=2"): the page to
# send back, or "" when there is no such thing.
def answer(method: str, path: str, fields: str) -> str:
    var problem: str = ""
    let name: str = field_of(fields, "name")
    let a: str = field_of(fields, "a")
    let b: str = field_of(fields, "b")
    let cost: int = int(number_of(field_of(fields, "cost")))
    if method == "GET" and path == "/all":
        pass
    elif method == "POST" and path == "/nodes":
        let x: float = number_of(field_of(fields, "x"))      # where it was double-clicked, if it was
        let y: float = number_of(field_of(fields, "y"))
        problem = add_node(net, name)
        if problem == "":
            if x < 0.0 or y < 0.0:                           # not given (-1): the next free place
                layout.put(name, new_spot(len(net.nodes) - 1, len(net.nodes)))
            else:
                layout.put(name, Place_T(x, y))
    elif method == "PUT" and path == "/nodes":
        if name in names_of(net):
            layout.put(name, Place_T(number_of(field_of(fields, "x")), number_of(field_of(fields, "y"))))
        else:
            problem = f"There is no node {name}."
    elif method == "DELETE" and path == "/nodes":
        problem = remove_node(net, name)
    elif method == "POST" and path == "/edges":
        problem = add_edge(net, a, b, cost)
    elif method == "PUT" and path == "/edges":
        problem = set_cost(net, a, b, cost)
    elif method == "DELETE" and path == "/edges":
        problem = remove_edge(net, a, b)
    elif method == "POST" and path == "/relayout":
        let none: {str}Place_T = {:}
        layout = Layout(none)           # no node has a place of its own: the layout gives each one
    elif method == "POST" and path == "/reset":
        net = sample()
        layout = sample_layout()
    else:
        return ""
    if method != "GET" and problem == "" and store != "":
        problem = save(net, layout, Path(store))
    return all_text(net, layout, params_of(fields), problem)
