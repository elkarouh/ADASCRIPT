#!/usr/bin/env ady2nim
"""server -- the one place that knows about HTTP; what a request does is dijkstra_events.ady.

    make app [PORT=n]  (or: ady2nim js frontend/dijkstra_js_events.ady; ady2nim c -r backend/server.ady [PORT])        then open http://127.0.0.1:8810/

    GET    /            the page: a script tag and a div that loads /all
    GET    /all         the page again                      (start, goal, pick, act)
    POST   /nodes       create a node                       (name)
    PUT    /nodes       move a node, after a drag           (name, x, y)
    DELETE /nodes       delete a node and its edges         (name)
    POST   /edges       create an edge                      (a, b, cost)
    PUT    /edges       change an edge's cost               (a, b, cost)
    DELETE /edges       delete an edge                      (a, b)
    POST   /reset       put the sample network back
    GET    /htmx.min.js htmx itself
    GET    /dijkstra_js_events.js     dijkstra_js_events.ady, compiled to JavaScript

Every answer but the scripts is the whole page, which htmx swaps in. The network is kept
in graph.txt, in the directory the server runs in; it is written after every change.
"""
from asyncdispatch nimport complete, newFuture, Port, waitFor
from asynchttpserver nimport HttpHeaders, newHttpHeaders, Request, respond, Http200, Http404, AsyncHttpServer, newAsyncHttpServer, serve
from backend/dijkstra_gui import shell_text
from backend/dijkstra_events import answer, keep_in

async def handler(req: Request):
    let html_type: HttpHeaders = newHttpHeaders([("Content-Type", "text/html; charset=utf-8")])
    let path: str = req.url.path
    if path == "/":
        await req.respond(Http200, shell_text(), html_type)
    elif path in ["/htmx.min.js", "/dijkstra_js_events.js"]:
        let script: str | !PathFailure_T = (Path("frontend") / path[1:]).read_text()
        if script is PathFailure_T:
            await req.respond(Http404, f"frontend{path} is not here: run from the demo's directory, after make dijkstra_js_events.js")
        else:
            await req.respond(Http200, script, newHttpHeaders([("Content-Type", "text/javascript")]))
    else:
        let page: str = answer(req.reqMethod'Image, path, req.url.query + "&" + req.body)
        if page == "":
            await req.respond(Http404, "not found")
        else:
            await req.respond(Http200, page, html_type)

def main():
    var port: int = 8810
    let args: []str = $@
    if len(args) > 0:
        let n: int | !ParseFailure_T = parse_int(args[0])
        if n is ParseFailure_T:
            pass
        else:
            port = n
    keep_in("graph.txt")
    print f"http://127.0.0.1:{port}/ (Ctrl-C to stop); the network is kept in graph.txt"
    var server: AsyncHttpServer = newAsyncHttpServer()
    waitFor(server.serve(Port(port), handler))

if __name__ == "__main__":
    main()
