#!/usr/bin/env ady2nim
"""dijkstra_gui -- the page as HTML the server draws, for htmx to swap in.

What the page shows is a function of the network (the model, which the server keeps)
and of what the reader has picked: the start and the goal, the fields of the form
`#state`. Every request sends that form along and gets the whole page back, which
htmx swaps in. Reading is GET /all; the buttons and fields that change the network
send POST, PUT or DELETE to /nodes or /edges (see server.ady). One-shot fields
(`pick`, `act`) come with a click and are not in the form.
"""
from uri nimport decodeUrl
from graphs import shortest_route
from backend/dijkstra_model import Edge, Network, Node_T, build_graph, names_of, uses

const WIDTH: float = 580.0
const HEIGHT: float = 380.0

type Params is record:
    start: str
    goal:  str
    pick:  str                      # the node clicked
    act:   str                      # clear

# The value of KEY in a query or a form body ("a=1&b=2"), or "".
def field_of(text: str, key: str) -> str:
    for pair in text.split("&"):
        let at: int = pair.find("=")
        if at > 0 and pair[:at] == key:
            return decodeUrl(pair[at + 1:])
    return ""

def params_of(text: str) -> Params:
    return Params(field_of(text, "start"), field_of(text, "goal"), field_of(text, "pick"), field_of(text, "act"))

# Where node NAME is drawn.
def spot(net: Network, name: str) -> []float:
    for n in net.nodes:
        if n.name == name:
            return [n.x, n.y]
    return [0.0, 0.0]

# Where a new node goes: along the bottom, left to right, then again a row up.
def new_spot(net: Network) -> []float:
    let k: int = len(net.nodes)
    return [40.0 + float((k * 70) % 500), HEIGHT - 30.0 - float((k * 70) // 500 % 4) * 60.0]

# ---- the drawing ----

def to_html(e: Edge, on_way: bool, net: Network) -> Html:
    let p1: []float = spot(net, e.a)
    let p2: []float = spot(net, e.b)
    let d: str = f"M {p1[0]:.0f} {p1[1]:.0f} L {p2[0]:.0f} {p2[1]:.0f}"
    let css: str = ("edge way" if on_way else "edge")
    let lx: str = f"{(p1[0] + p2[0]) / 2.0:.0f}"
    let ly: str = f"{(p1[1] + p2[1]) / 2.0 - 6.0:.0f}"
    let label: str = str(e.cost)
    html:
        g data_from=e.a data_to=e.b:
            path class=css d=d
            stext class="cost" x=lx y=ly: label

def to_html(n: Node_T, role: str) -> Html:
    let cx: str = f"{n.x:.0f}"
    let cy: str = f"{n.y:.0f}"
    let ty: str = f"{n.y + 5.0:.0f}"
    let css: str = "node " + role
    let vals: str = "{\"pick\": \"" + n.name + "\"}"
    html:
        g class=css data_name=n.name data_x=cx data_y=cy data_hx_get="/all" data_hx_include="#state" data_hx_vals=vals data_hx_target="#all" data_hx_swap="outerHTML":
            circle cx=cx cy=cy r="24"
            stext class="name" x=cx y=ty: n.name

# ---- the tables: a row for each node and each edge, with what can be done to it ----

def row_html(n: Node_T) -> Html:
    let vals: str = "{\"name\": \"" + n.name + "\"}"
    let ask: str = f"Delete {n.name} and its edges?"
    html:
        span class="chip":
            span: n.name
            button type="button" class="delete" title="Delete" data_hx_delete="/nodes" data_hx_vals=vals data_hx_confirm=ask data_hx_include="#state" data_hx_target="#all" data_hx_swap="outerHTML": "✕"

def row_html(e: Edge) -> Html:
    let label: str = e.a + " — " + e.b
    let value: str = str(e.cost)
    let vals: str = "{\"a\": \"" + e.a + "\", \"b\": \"" + e.b + "\"}"
    html:
        tr:
            td class="ends": label
            td:
                input type="number" name="cost" value=value min="1" max="999" data_hx_put="/edges" data_hx_trigger="change" data_hx_vals=vals data_hx_include="#state" data_hx_target="#all" data_hx_swap="outerHTML"
            td class="end":
                button type="button" class="delete" title="Delete" data_hx_delete="/edges" data_hx_vals=vals data_hx_include="#state" data_hx_target="#all" data_hx_swap="outerHTML": "✕"

def choice_html(name: str, names: []str) -> Html:
    html:
        select name=name:
            for n in names:
                option value=n: n

def all_html(net: Network, p0: Params, problem: str) -> Html:
    var p: Params = p0
    let names: []str = names_of(net)
    if p.act == "clear":
        p.start = ""
        p.goal = ""
    if p.start not in names:            # deleted since
        p.start = ""
    if p.goal not in names:
        p.goal = ""
    if p.pick != "" and p.pick in names:
        if p.start == "" or p.goal != "":
            p.start = p.pick
            p.goal = ""
        elif p.pick != p.start:
            p.goal = p.pick
    let found: (float, []str) = shortest_route[str](build_graph(net), p.start, p.goal)
    let way: []str = found[1]
    let said: str = ("Click the node to start from." if p.start == "" else
                     f"From {p.start}: click the node to go to." if p.goal == "" else
                     f"No way from {p.start} to {p.goal}." if len(way) == 0 else
                     f"Shortest way from {p.start} to {p.goal}: " + " → ".join(way) + f", cost {found[0]:.0f}.")
    let clear_vals: str = "{\"act\": \"clear\"}"
    let box: str = f"0 0 {WIDTH:.0f} {HEIGHT:.0f}"
    let said_css: str = ("said found" if len(way) > 0 else "said")
    # form#move: drag.ady fills in its fields and clicks its button
    html:
        div id="all":
            form id="state":
                input type="hidden" name="start" value=p.start
                input type="hidden" name="goal" value=p.goal
            form id="move":
                input type="hidden" name="name" value=""
                input type="hidden" name="x" value=""
                input type="hidden" name="y" value=""
                button type="button" id="redraw" class="redraw" data_hx_put="/nodes" data_hx_include="#move, #state" data_hx_target="#all" data_hx_swap="outerHTML": "Move"
            div class="layout":
                div class="board":
                    p class=said_css: said
                    if problem != "":
                        p class="problem": problem
                    svg viewBox=box class="graph":
                        for e in net.edges:
                            + to_html(e, uses(way, e), net)
                        for n in net.nodes:
                            + to_html(n, ("start" if n.name == p.start else ("goal" if n.name == p.goal else ("way" if n.name in way else ""))))
                    p class="hint": "Click a node to start from, then one to go to. Drag a node to move it."
                div class="panel":
                    div class="card":
                        h2: "Nodes"
                        div class="chips":
                            for n in net.nodes:
                                + row_html(n)
                        form class="add" data_hx_post="/nodes" data_hx_include="#state" data_hx_target="#all" data_hx_swap="outerHTML":
                            input type="text" name="name" placeholder="New node" size="8" maxlength="8"
                            button class="primary": "Add"
                    div class="card":
                        h2: "Edges"
                        table class="edges":
                            for e in net.edges:
                                + row_html(e)
                        form class="add" data_hx_post="/edges" data_hx_include="#state" data_hx_target="#all" data_hx_swap="outerHTML":
                            + choice_html("a", names)
                            span class="dash": "—"
                            + choice_html("b", names)
                            input type="number" name="cost" value="1" min="1" max="999" title="Cost"
                            button class="primary": "Add"
                    div class="actions":
                        button type="button" data_hx_get="/all" data_hx_include="#state" data_hx_vals=clear_vals data_hx_target="#all" data_hx_swap="outerHTML": "Clear the way"
                        button type="button" class="quiet" data_hx_post="/reset" data_hx_confirm="Put the sample network back?" data_hx_target="#all" data_hx_swap="outerHTML": "Reset the sample"

const STYLE: str = """
:root { --ink: #1f2933; --soft: #616e7c; --line: #e4e7eb; --bg: #f5f7fa; --card: #fff;
        --way: #e65100; --start: #2e7d32; --goal: #1565c0; --bad: #c62828; --accent: #3a66db; }
* { box-sizing: border-box; }
body { font-family: system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; color: var(--ink); background: var(--bg);
       margin: 0; padding: 1.5em 1em 3em; }
header, #all { max-width: 68em; margin: 0 auto; }
header h1 { font-size: 1.5em; margin: 0; }
header p { color: var(--soft); margin: 0.2em 0 1.2em; }
div.layout { display: grid; grid-template-columns: minmax(0, 1fr) 18em; gap: 1.2em; align-items: start; }
@media (max-width: 820px) { div.layout { grid-template-columns: 1fr; } }
div.board, div.card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; }
div.board { padding: 1em 1.2em; }
div.panel { display: flex; flex-direction: column; gap: 1em; }
div.card { padding: 0.8em 1em; }
h2 { font-size: 0.8em; text-transform: uppercase; letter-spacing: 0.06em; color: var(--soft); margin: 0 0 0.6em; }
p.said { font-weight: 600; margin: 0 0 0.4em; min-height: 1.4em; }
p.said.found { color: var(--way); }
p.problem { color: var(--bad); background: #fdecea; border-radius: 6px; padding: 0.4em 0.7em; margin: 0 0 0.4em; }
p.hint { color: var(--soft); font-size: 0.85em; margin: 0.4em 0 0; }
div.chips { display: flex; flex-wrap: wrap; gap: 0.35em; margin-bottom: 0.7em; }
span.chip { display: inline-flex; align-items: center; gap: 0.15em; border: 1px solid var(--line); border-radius: 999px;
            padding: 0.1em 0.2em 0.1em 0.7em; font-weight: 600; background: var(--bg); }
table.edges { width: 100%; border-collapse: collapse; margin-bottom: 0.7em; }
table.edges td { padding: 0.15em 0.2em; border-bottom: 1px solid var(--line); }
td.ends { font-weight: 600; white-space: nowrap; }
td.end { text-align: right; }
form.add { display: flex; gap: 0.35em; align-items: center; }
form.add input[type=text] { flex: 1; min-width: 0; }
span.dash { color: var(--soft); }
input, select, button { font: inherit; font-size: 0.9em; }
input, select { border: 1px solid #cbd2d9; border-radius: 6px; padding: 0.25em 0.4em; background: #fff; }
input[type=number] { width: 4.2em; }
button { border: 1px solid #cbd2d9; border-radius: 6px; padding: 0.3em 0.8em; background: #fff; cursor: pointer; }
button:hover { background: var(--bg); }
button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
button.primary:hover { background: #2f55b8; }
button.delete { border: none; background: none; color: #9aa5b1; padding: 0.1em 0.4em; border-radius: 999px; }
button.delete:hover { color: var(--bad); background: #fdecea; }
div.actions { display: flex; gap: 0.5em; }
div.actions button { flex: 1; }
button.quiet { color: var(--soft); }
button.redraw { display: none; }
svg.graph { width: 100%; height: auto; user-select: none; display: block; }
path.edge { stroke: #b0b8c1; stroke-width: 2.5; fill: none; }
path.edge.way { stroke: var(--way); stroke-width: 5; }
text.cost { font-size: 13px; fill: var(--soft); text-anchor: middle; paint-order: stroke; stroke: #fff; stroke-width: 4px; }
g.node { cursor: grab; }
g.node circle { fill: #fff; stroke: #7b8794; stroke-width: 2; }
g.node:hover circle { stroke: var(--ink); }
g.node.way circle { stroke: var(--way); stroke-width: 4; }
g.node.start circle { fill: #e3f2e5; stroke: var(--start); stroke-width: 4; }
g.node.goal circle { fill: #e3eefb; stroke: var(--goal); stroke-width: 4; }
text.name { font-size: 16px; font-weight: 700; text-anchor: middle; pointer-events: none; fill: var(--ink); }
"""

def shell() -> Html:
    html:
        html lang="en":
            head:
                meta charset="utf-8"
                title: "Shortest way"
                style: STYLE
                script src="/htmx.min.js"
                script src="/drag.js"
            body:
                header:
                    h1: "Shortest way"
                    p: "Dijkstra on a network you can edit, drawn by the server."
                div id="all" data_hx_get="/all" data_hx_trigger="load": "Loading..."

# An html: block writes an attribute with underscores (data_hx_get); htmx wants hyphens.
def hyphens(text: str) -> str:
    return text.replace("data_hx_", "data-hx-")

def shell_text() -> str:
    return "<!doctype html>" + hyphens(str(shell()))

def all_text(net: Network, p: Params, problem: str) -> str:
    return hyphens(str(all_html(net, p, problem)))
