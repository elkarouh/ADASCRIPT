#!/usr/bin/env ady2nim
"""dijkstra_gui -- the page as HTML the server draws, for htmx to swap in.

What the page shows is a function of the network (the model, which the server keeps)
and of what the reader has picked: the start and the goal, the fields of the form
`#state`. Every request sends that form along and gets the whole page back, which
htmx swaps in. Reading is GET /all. The drawing's gestures and the menus (dijkstra_js_events.ady)
fill in the hidden form `#gesture` and press one of its buttons, which sends POST, PUT or
DELETE to /nodes or /edges (see server.ady). `pick` is the node clicked, for the start or the
goal; `act` is unpick (a chosen node clicked again).
"""
from uri nimport decodeUrl
from graphs import shortest_route
from backend/dijkstra_model import Edge_T, Network_T, Node_T, build_graph, names_of, text_of, uses
from backend/dijkstra_layout import Layout, Place_T

const WIDTH: float = 580.0
const HEIGHT: float = 380.0

type Params_T is record:
    start: str
    goal:  str
    pick:  str                      # the node clicked
    act:   str                      # unpick

# The value of KEY in a query or a form body ("a=1&b=2"), or "".
def field_of(text: str, key: str) -> str:
    for pair in text.split("&"):
        let at: int = pair.find("=")
        if at > 0 and pair[:at] == key:
            return decodeUrl(pair[at + 1:])
    return ""

def params_of(text: str) -> Params_T:
    return Params_T(field_of(text, "start"), field_of(text, "goal"), field_of(text, "pick"), field_of(text, "act"))

# ---- the drawing ----

# The edge's own look: the line, the wider line to point at, the cost (see to_html).
const EDGE_STYLE: str = """
path.edge { stroke: #b0b8c1; stroke-width: 2.5; fill: none; }
path.edge.way { stroke: var(--way); stroke-width: 5; }
g[data_from].selected path.edge { stroke: var(--accent); stroke-width: 5; }
path.hit { stroke: transparent; stroke-width: 14px; fill: none; cursor: pointer; }
text.cost { font-size: 13px; fill: var(--soft); text-anchor: middle; paint-order: stroke; stroke: #fff; stroke-width: 4px; }
"""

def to_html(e: Edge_T, on_way: bool, p1: Place_T, p2: Place_T) -> Html:
    let d: str = f"M {p1.x:.0f} {p1.y:.0f} L {p2.x:.0f} {p2.y:.0f}"
    let css: str = ("edge way" if on_way else "edge")
    let lx: str = f"{(p1.x + p2.x) / 2.0:.0f}"
    let ly: str = f"{(p1.y + p2.y) / 2.0 - 6.0:.0f}"
    let label: str = str(e.cost)
    html:
        g data_from=e.a data_to=e.b data_cost=label:
            path class=css d=d
            path class="hit" d=d
            stext class="cost" x=lx y=ly: label

# The node's own look: its circle, its name, its port (see to_html).
const NODE_STYLE: str = """
g.node { cursor: grab; }
g.node circle { fill: #fff; stroke: #7b8794; stroke-width: 2; }
g.node:hover circle { stroke: var(--ink); }
g.node.way circle { stroke: var(--way); stroke-width: 4; }
g.node.start circle { fill: #e3f2e5; stroke: var(--start); stroke-width: 4; }
g.node.goal circle { fill: #e3eefb; stroke: var(--goal); stroke-width: 4; }
g.node.selected circle { stroke: var(--accent); stroke-width: 4; }
circle.port { fill: var(--accent); opacity: 0; cursor: crosshair; }
g.node:hover circle.port, g.node.selected circle.port { opacity: 1; }
text.name { font-size: 16px; font-weight: 700; text-anchor: middle; pointer-events: none; fill: var(--ink); }
"""

# The buttons that act on the edges, sent through the hidden form #gesture (see all_html): add one, set its
# cost, delete it.
def edge_buttons_html() -> Html:
    html:
        span class="edge-actions":
            button type="button" id="make_edge" data_hx_post="/edges" data_hx_include="#gesture, #state" data_hx_target="#all" data_hx_swap="outerHTML": "Add edge"
            button type="button" id="set_cost" data_hx_put="/edges" data_hx_include="#gesture, #state" data_hx_target="#all" data_hx_swap="outerHTML": "Set cost"
            button type="button" id="drop_edge" data_hx_delete="/edges" data_hx_include="#gesture, #state" data_hx_target="#all" data_hx_swap="outerHTML": "Delete edge"

# A node: its circle and name, and a port (the dot on its right) from which a wire is drawn to another.
def to_html(n: Node_T, at: Place_T, role: str) -> Html:
    let cx: str = f"{at.x:.0f}"
    let cy: str = f"{at.y:.0f}"
    let ty: str = f"{at.y + 5.0:.0f}"
    let px: str = f"{at.x + 24.0:.0f}"
    let css: str = "node " + role
    html:
        g class=css data_name=n.name data_x=cx data_y=cy:
            circle cx=cx cy=cy r="24"
            stext class="name" x=cx y=ty: n.name
            circle class="port" cx=px cy=cy r="6"

# The menus' own look (see menus_html).
const MENU_STYLE: str = """
div.menu { position: fixed; z-index: 10; display: none; flex-direction: column; min-width: 10em; background: #fff;
           border: 1px solid #cbd2d9; border-radius: 8px; box-shadow: 0 6px 18px rgba(31, 41, 51, 0.18); padding: 0.3em; }
div.menu button { border: none; text-align: left; border-radius: 4px; padding: 0.4em 0.7em; }
"""

# The buttons that act on the nodes, sent through the hidden form #gesture (see all_html):
# choose one for the route, add one, delete one.
def node_buttons_html() -> Html:
    html:
        span class="node-actions":
            button type="button" id="pick" data_hx_get="/all" data_hx_include="#gesture, #state" data_hx_target="#all" data_hx_swap="outerHTML": "Choose"
            button type="button" id="make_node" data_hx_post="/nodes" data_hx_include="#gesture, #state" data_hx_target="#all" data_hx_swap="outerHTML": "Add node"
            button type="button" id="drop_node" data_hx_delete="/nodes" data_hx_include="#gesture, #state" data_hx_target="#all" data_hx_swap="outerHTML": "Delete node"

# The menu of what a right click on a node, an edge or the space offers: the buttons carry
# data_tool, which dijkstra_js_events.ady acts on for the thing that was right-clicked.
def menus_html() -> Html:
    html:
        div id="menus":
            div id="menu-node" class="menu":
                button type="button" class="danger" data_tool="delete-node": "Delete node"
            div id="menu-edge" class="menu":
                button type="button" data_tool="cost": "Change cost…"
                button type="button" class="danger" data_tool="delete-edge": "Delete edge"
            div id="menu-space" class="menu":
                button type="button" data_tool="add-here": "New node here"

def all_html(net: Network_T, layout: Layout, p0: Params_T, problem: str) -> Html:
    var p: Params_T = p0
    let names: []str = names_of(net)
    if p.start not in names:            # deleted since
        p.start = ""
    if p.goal not in names:
        p.goal = ""
    if p.act == "unpick":                   # a chosen node clicked again: it is no longer chosen
        if p.pick == p.start:
            p.start = ""
            p.goal = ""
        elif p.pick == p.goal:
            p.goal = ""
        p.pick = ""
    if p.pick != "" and p.pick in names:    # a node clicked: the start, then the goal, then the start again
        if p.start == "" or p.goal != "":
            p.start = p.pick
            p.goal = ""
        elif p.pick != p.start:
            p.goal = p.pick
    let found: (float, []str) = shortest_route[str](build_graph(net), p.start, p.goal)
    let way: []str = found[1]
    let said: str = ("Click a node to start from." if p.start == "" else
                     f"From {p.start}: click a node to go to." if p.goal == "" else
                     f"No way from {p.start} to {p.goal}." if len(way) == 0 else
                     f"Shortest way from {p.start} to {p.goal}: " + " → ".join(way) + f", cost {found[0]:.0f}.")
    let box: str = f"0 0 {WIDTH:.0f} {HEIGHT:.0f}"
    let said_css: str = ("said found" if len(way) > 0 else "said")
    html:
        div id="all":
            form id="state":
                input type="hidden" name="start" value=p.start
                input type="hidden" name="goal" value=p.goal
            form id="move":
                input type="hidden" name="name" value=""
                input type="hidden" name="x" value=""
                input type="hidden" name="y" value=""
                button type="button" id="redraw" class="redraw" data_hx_put="/nodes" data_hx_include="#move, #state" data_hx_target="#all" data_hx_swap="outerHTML": "Move"
            # form#gesture: the drawing and the menus (dijkstra_js_events.ady) fill it in, then press one button
            form id="gesture" class="gesture":
                input type="hidden" name="name" value=""
                input type="hidden" name="a" value=""
                input type="hidden" name="b" value=""
                input type="hidden" name="cost" value=""
                input type="hidden" name="x" value=""
                input type="hidden" name="y" value=""
                input type="hidden" name="pick" value=""
                input type="hidden" name="act" value=""
                + node_buttons_html()
                + edge_buttons_html()
            div class="toolbar":
                button type="button" class="quiet" data_hx_post="/relayout" data_hx_confirm="Put every node where the layout puts it? Nodes you moved go back to the layout." data_hx_target="#all" data_hx_swap="outerHTML": "Relayout"
                button type="button" class="quiet" data_hx_post="/reset" data_hx_confirm="Put the sample network back?" data_hx_target="#all" data_hx_swap="outerHTML": "Reset the sample"
            p class=said_css: said
            if problem != "":
                p class="problem": problem
            svg viewBox=box class="graph":
                for e in net.edges:
                    + to_html(e, uses(way, e), layout.place_of(net, e.a), layout.place_of(net, e.b))
                for n in net.nodes:
                    + to_html(n, layout.place_of(net, n.name), ("start" if n.name == p.start else ("goal" if n.name == p.goal else ("way" if n.name in way else ""))))
                path id="wire" class="wire" visibility="hidden" d="M 0 0 L 0 0"
            # the network and its layout as the server keeps them, for the browser's NetworkView to draw from
            pre id="network": text_of(net) + layout.text_of(net)
            p class="hint": "Click a node to choose it as the start, then one to go to; click a chosen node again to unchoose it. Click an edge to select it, then Delete removes it. Drag a node to move it, or from its dot to another node to join them. Double-click the space for a new node, or an edge to change its cost. Right-click for a menu."
            + menus_html()

# The page's own look: the body, the form, the drawing as a whole (the parts of it have their own, above).
const STYLE: str = """
:root { --ink: #1f2933; --soft: #616e7c; --line: #e4e7eb; --bg: #f5f7fa; --card: #fff;
        --way: #e65100; --start: #2e7d32; --goal: #1565c0; --bad: #c62828; --accent: #3a66db; }
* { box-sizing: border-box; }
body { font-family: system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; color: var(--ink); background: var(--bg);
       margin: 0; padding: 1.5em 1em 3em; }
header, #all { max-width: 68em; margin: 0 auto; }
header h1 { font-size: 1.5em; margin: 0; }
header p { color: var(--soft); margin: 0.2em 0 1.2em; }
div.board { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 1em 1.2em; }
p.said { font-weight: 600; margin: 0 0 0.4em; min-height: 1.4em; }
p.said.found { color: var(--way); }
p.problem { color: var(--bad); background: #fdecea; border-radius: 6px; padding: 0.4em 0.7em; margin: 0 0 0.4em; }
p.hint { color: var(--soft); font-size: 0.85em; margin: 0.4em 0 0; }
input, button { font: inherit; font-size: 0.9em; }
button { border: 1px solid #cbd2d9; border-radius: 6px; padding: 0.3em 0.8em; background: #fff; cursor: pointer; }
button:hover { background: var(--bg); }
button.quiet { color: var(--soft); }
button.danger { color: var(--bad); }
div.toolbar { display: flex; flex-wrap: wrap; gap: 0.5em; margin-bottom: 0.8em; }
button.redraw, form.gesture, pre#network { display: none; }
svg.graph { width: 100%; height: auto; user-select: none; display: block; }
path.wire { stroke: var(--accent); stroke-width: 2.5; stroke-dasharray: 6 4; fill: none; pointer-events: none; }
"""

const ALL_STYLE: str = STYLE + EDGE_STYLE + NODE_STYLE + MENU_STYLE

def shell() -> Html:
    html:
        html lang="en":
            head:
                meta charset="utf-8"
                title: "Shortest way"
                style: ALL_STYLE
                script src="/htmx.min.js"
                script src="/dijkstra_js_events.js"
            body:
                header:
                    h1: "Shortest way"
                    p: "Dijkstra on a network you can edit, drawn by the server."
                div id="all" data_hx_get="/all" data_hx_trigger="load": "Loading..."

# An html: block writes an attribute with underscores (data_hx_get); htmx wants hyphens.
def hyphens(text: str) -> str:
    return text.replace("data_hx_", "data-hx-")

def shell_text() -> str:
    return "<!doctype html>" + hyphens(str(shell()))

def all_text(net: Network_T, layout: Layout, p: Params_T, problem: str) -> str:
    return hyphens(str(all_html(net, layout, p, problem)))
