#!/usr/bin/env ady2nim
"""dijkstra_model -- the model: the nodes, the edges and their costs, and the way between two.

The algorithm is TO_NIM/STDLIB/graphs.ady; what is here is the problem (nodes named by
strings, undirected edges with a cost) turned into the graph the library wants
(build_graph); dijkstra_gui.ady hands that to the library's shortest_route itself. A placeholder:
replace this file with your own model; dijkstra_gui.ady needs what it imports from here.
No HTML, no HTTP.
"""

# The problem: six nodes, nine edges between them, and what each costs to start with.
const NAMES: []str = ["A", "B", "C", "D", "E", "F"]
const ENDS: []str = ["A B", "A C", "A F", "B C", "B D", "C D", "C F", "D E", "E F"]
const START_COSTS: []int = [7, 9, 14, 10, 15, 11, 2, 6, 9]

type Edge is record:
    a:    str
    b:    str
    cost: int

# The edges, with COSTS in the order of ENDS.
def edges_of(costs: []int) -> []Edge:
    var edges: []Edge = []
    for i in range(len(ENDS)):
        let ab: []str = ENDS[i].split(" ")
        edges.append(Edge(ab[0], ab[1], costs[i]))
    return edges

# The graph the library wants: each node to its (cost, neighbour) pairs. The edges are
# undirected, so each one is entered both ways.
def build_graph(names: []str, edges: []Edge) -> {str}[](float, str):
    var graph: {str}[](float, str)
    let none: [](float, str) = []
    for n in names:
        graph[n] = none
    for e in edges:
        graph[e.a].append((float(e.cost), e.b))
        graph[e.b].append((float(e.cost), e.a))
    return graph

# Whether ROUTE runs along the edge E, in either direction: dijkstra_gui.ady draws those edges in orange.
def uses(route: []str, e: Edge) -> bool:
    for i in range(len(route) - 1):
        if (route[i] == e.a and route[i + 1] == e.b) or (route[i] == e.b and route[i + 1] == e.a):
            return True
    return False
