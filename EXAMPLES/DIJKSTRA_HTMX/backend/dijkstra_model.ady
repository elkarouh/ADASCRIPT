#!/usr/bin/env ady2nim
"""dijkstra_model -- the model: the nodes, the edges and their costs, and the way between two.

The algorithm is TO_NIM/STDLIB/graphs.ady; what is here is the problem (nodes named by
strings, undirected edges with a cost) turned into the graph the library wants. A
placeholder: replace this file with your own model; page.ady needs what it imports from here.
No HTML, no HTTP.
"""
from graphs import shortest_path

# The problem: six nodes, nine edges between them, and what each costs to start with.
const NAMES: []str = ["A", "B", "C", "D", "E", "F"]
const ENDS: []str = ["A B", "A C", "A F", "B C", "B D", "C D", "C F", "D E", "E F"]
const START_COSTS: []int = [7, 9, 14, 10, 15, 11, 2, 6, 9]

type Edge is record:
    a:    str
    b:    str
    cost: int

# The edges, with COSTS in the order of ENDS.
def edges_of(costs: []int) -> []Edge:
    var edges: []Edge = []
    for i in range(len(ENDS)):
        let ab: []str = ENDS[i].split(" ")
        edges.append(Edge(ab[0], ab[1], costs[i]))
    return edges

# The way from START to GOAL: the nodes on it, and what it costs; cost -1 and no nodes when
# there is no way.
type Way is record:
    nodes: []str
    cost:  int

def shortest_way(names: []str, edges: []Edge, start: str, goal: str) -> Way:
    var graph: {str}[](float, str)
    let none: [](float, str) = []
    for n in names:
        graph[n] = none
    for e in edges:                     # undirected: one edge each way
        graph[e.a].append((float(e.cost), e.b))
        graph[e.b].append((float(e.cost), e.a))
    if start not in graph or goal not in graph:
        return Way([], -1)
    let nodes: []str = shortest_path[str](graph, start, goal)
    var cost: int = 0
    for i in range(len(nodes) - 1):
        for e in edges:
            if (e.a == nodes[i] and e.b == nodes[i + 1]) or (e.b == nodes[i] and e.a == nodes[i + 1]):
                cost += e.cost
    return Way(nodes, cost if len(nodes) > 0 else -1)

# Whether the way uses the edge E, in either direction.
def uses(w: Way, e: Edge) -> bool:
    for i in range(len(w.nodes) - 1):
        if (w.nodes[i] == e.a and w.nodes[i + 1] == e.b) or (w.nodes[i] == e.b and w.nodes[i + 1] == e.a):
            return True
    return False
