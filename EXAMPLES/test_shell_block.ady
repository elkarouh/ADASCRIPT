#!/usr/bin/env py2nim
"""
test_shell_block — exercise the shell: block form with expect/send.
"""

print("=== inline form ===")
shell: echo from inline form

print("=== pure block (commands joined with &&) ===")
shell:
    echo hello
    echo world

print("=== interactive block (expect/send) ===")
print("(silent automation — successful expect/send means matches found)")
shell:
    bc -q
    send("2 + 2\n")
    expect("4")
    send("10 * 5\n")
    expect("50")
    send("quit\n")

print("=== checked form (check = true) ===")
shell(check = true): true
print("a command that succeeds passes through")

let checked = shell(check = true): echo captured and checked
print("capture still works:", checked.output.strip())

try:
    shell(check = true): exit 9
    print("BUG: a failing checked command did not raise")
except:
    print("a failing one raises, and is catchable")

print("=== quoting sigils ===")
let spaced: str = "two words"
let argv: []str = ["one arg", "another arg"]
let r1 = shell: printf '[%s]' {!spaced}
print("{!x}: ", r1.output.strip())
let r2 = shell: printf '[%s]' {*argv}
print("{*xs}:", r2.output.strip())

print("=== stdin feeding ===")
let text: str = "gamma\nalpha\nbeta\n"
let sorted_r = shell(stdin = text): sort
print("fed three lines, sorted:", sorted_r.output.strip().replace("\n", ","))
let counted: []str = shellLines(stdin = text): wc -l
print("shellLines with stdin:", counted[0].strip())
let no_input = shell: cat
print("a capture of a stdin-reading command ends, code:", no_input.code)

print("=== env mapping ===")
let extra: {str}str = {"GREETING": "hello", "HOME": "/overridden"}
let envd = shell(env = extra): sh -c 'printf "%s %s" "$GREETING" "$HOME"'
print("added and overridden:", envd.output.strip())
let inherited = shell(env = extra): sh -c 'test -n "$PATH" && printf inherited-too'
print("the rest of the environment is", inherited.output.strip())

print("=== streaming form (shellIter) ===")
var total: int = 0
for num in shellIter: seq 1 5
    total = total + int(num)
print("summed five streamed lines:", total)
let word: str = "two words"
for line in shellIter: printf '%s\n' {!word} plain
    print("streamed with quoting: [" + line + "]")

print("=== shellIter options ===")
for line in shellIter(cwd = "/tmp"): pwd
    print("cwd:", line)
let iter_env: {str}str = {"STREAMED": "from env"}
for line in shellIter(env = iter_env): sh -c 'echo $STREAMED'
    print("env:", line)

print("=== argv form (run / runLines) — no shell at all ===")
# The list *is* the argument vector, so nothing re-parses it: a filename
# holding spaces, a semicolon or a $(...) is just an element.
let hostile: str = "; touch run-form-canary"
let listed: RunResult = run(["printf", "[%s]\n", "two words", hostile])
# Each element arrived as one argument, the metacharacters included, and the
# semicolon started nothing: it is a string, not a command separator.
print(listed.output.strip().replace("\n", " "))
print("the ; was data, not a separator:", not -e "run-form-canary")
let three: []str = runLines(["seq", "1", "3"])
let n_three: int = three'Length
print("runLines gave", n_three, "lines, last =", three[2])
let split_r: RunResult = run(["sh", "-c", "echo out; echo err >&2; exit 3"])
print("stdout/stderr/code kept apart:", split_r.output.strip(),
      split_r.stderr.strip(), split_r.code)
print("a missing program reports 127, as a shell would:",
      run(["definitely-no-such-program"]).code)
print("timeout still reports 124:", run(["sleep", "5"], timeout = 300).code)
let run_env: {str}str = {"PASSED": "yes"}
print("cwd, env and stdin all apply:",
      run(["pwd"], cwd = "/tmp").output.strip(),
      run(["sh", "-c", "echo $PASSED"], env = run_env).output.strip(),
      run(["sort"], stdin = "b\na\n").output.strip().replace("\n", ","))
try:
    let must_fail: RunResult = run(["false"], check = true)
    print("BUG: check = true did not raise")
except:
    print("check = true raises here too")

print("=== concurrency (shellSpawn) ===")
# Three commands that each sleep a second. Started rather than waited for,
# they finish together instead of one after another.
var sleepers: []Job = []
for tag in ["alpha", "beta", "gamma"]:
    let one: Job = shellSpawn: sleep 1 && echo {tag}
    sleepers.append(one)
let done_all: []RunResult = waitAll(sleepers)
var names: []str = []
for one_r in done_all:
    names.append(one_r.output.strip())
# All three slept a second; the suite as a whole would take two seconds
# longer if this ran them one after another.
print("three 1s commands finished together:", ", ".join(names))

# More output than a pipe holds (64K on Linux): waitAll drains every job as
# it goes, so none of them stalls waiting for its turn to be read.
var bulky: []Job = []
for ch in ["a", "b"]:
    let one: Job = shellSpawn: yes {ch} | head -c 200000
    bulky.append(one)
let bulk_rs: []RunResult = waitAll(bulky)
var total_bytes: int = 0
for one_r in bulk_rs:
    total_bytes = total_bytes + one_r.output'Length
print("two jobs past the pipe buffer, bytes drained:", total_bytes)

let spawn_opts: {str}str = {"WHO": "spawned"}
let opt_job: Job = shellSpawn(cwd = "/tmp", env = spawn_opts): sh -c 'printf "%s in %s" "$WHO" "$(pwd)"'
print("cwd and env apply:", opt_job.wait().output.strip())
let fed: Job = shellSpawn(stdin = "gamma\nalpha\n"): sort
print("stdin applies:", fed.wait().output.strip().replace("\n", ","))

let slow_job: Job = shellSpawn: sleep 30
print("running() right after spawn:", slow_job.running())
slow_job.kill()
print("and after kill():", slow_job.running())

let failing: Job = shellSpawn: exit 7
try:
    let must_fail: RunResult = failing.wait(check = true)
    print("BUG: wait(check = true) did not raise")
except:
    print("wait(check = true) raises, like the other checked forms")

print("done — all expects matched, bc was driven successfully")

print("=== exec form (shellExec) ===")
# shellExec replaces this process: it never returns, the command's own
# exit status becomes the script's, and nothing below it can run.  That is
# why this section has to be last.
print("handing the process over — nothing after this line runs")
shellExec: printf 'replaced by exec: [%s]\n' {*argv}
print("BUG: shellExec returned instead of replacing the process")
