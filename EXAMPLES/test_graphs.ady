#!/usr/bin/env ady2nim
# test_graphs.ady — tests for the generic shortest-path library, graphs.ady
#
#   ady2nim EXAMPLES/test_graphs.ady -r
#
# The point of the library is that one definition serves any node type, so
# every case here runs against three of them: an enum, a string and an int.

from graphs import dijkstra, shortest_path, shortest_route

type City_T is enum PAR, LON, BER, ROM

# --- enum nodes ------------------------------------------------------------
# PAR -3-> LON -2-> BER, and PAR -9-> BER direct: the two-hop route wins.
let ge: {City_T}[](float, City_T) = {
    PAR: [(3.0, LON), (9.0, BER)],
    LON: [(2.0, BER)],
    BER: [],
    ROM: []}
let de: {City_T}float = dijkstra[City_T](ge, PAR)
assert de[PAR] == 0.0
assert de[LON] == 3.0
assert de[BER] == 5.0            # 3 + 2, not the direct 9
assert de[ROM] == Inf            # no edge into it
assert shortest_path[City_T](ge, PAR, BER) == [PAR, LON, BER]
assert shortest_path[City_T](ge, PAR, PAR) == [PAR]        # a node reaches itself
assert shortest_path[City_T](ge, PAR, ROM) == []           # unreachable
assert shortest_path[City_T](ge, BER, PAR) == []           # edges are directed
let rc: (float, []City_T) = shortest_route[City_T](ge, PAR, BER)
assert rc[0] == 5.0 and rc[1] == [PAR, LON, BER]      # the cost comes with the route
assert shortest_route[City_T](ge, PAR, PAR)[0] == 0.0
assert shortest_route[City_T](ge, PAR, ROM)[0] == Inf

# --- string nodes ----------------------------------------------------------
let gs: {str}[](float, str) = {
    "a": [(1.5, "b"), (10.0, "d")],
    "b": [(2.5, "c")],
    "c": [(1.0, "d")],
    "d": []}
let ds: {str}float = dijkstra[str](gs, "a")
assert ds["a"] == 0.0
assert ds["b"] == 1.5
assert ds["c"] == 4.0
assert ds["d"] == 5.0            # 1.5+2.5+1, beating the direct 10
assert shortest_path[str](gs, "a", "d") == ["a", "b", "c", "d"]
assert shortest_path[str](gs, "a", "zz") == []          # goal not in the graph
assert shortest_path[str](gs, "zz", "a") == []          # start not in the graph
let rs: (float, []str) = shortest_route[str](gs, "a", "d")
assert rs[0] == 5.0 and rs[1] == ["a", "b", "c", "d"]
assert shortest_route[str](gs, "zz", "zz")[0] == 0.0    # not in the graph, but itself

# --- int nodes -------------------------------------------------------------
let gi: {int}[](float, int) = {1: [(7.0, 2)], 2: [(1.0, 3)], 3: []}
let di: {int}float = dijkstra[int](gi, 1)
assert di[1] == 0.0
assert di[2] == 7.0
assert di[3] == 8.0
assert shortest_path[int](gi, 1, 3) == [1, 2, 3]

# --- a single node with no edges at all ------------------------------------
# The empty edge list is named: in a one-entry table literal Nim has no
# sibling entry to infer `@[]`'s element type from, and rejects the literal.
let no_edges: [](float, int) = []
let g1: {int}[](float, int) = {42: no_edges}
assert dijkstra[int](g1, 42)[42] == 0.0
assert shortest_path[int](g1, 42, 42) == [42]

# --- a sink: a node that is only ever a destination -------------------------
# It has no adjacency entry of its own, so reading the graph's keys alone
# would leave it out of the distance table and the first edge into it would
# look up a key that is not there.
type Sink_T is enum P, Q
let one_way: [](float, Sink_T) = [(2.0, Q)]
let gsink: {Sink_T}[](float, Sink_T) = {P: one_way}      # Q is never a key
let dsink: {Sink_T}float = dijkstra[Sink_T](gsink, P)
assert dsink[P] == 0.0
assert dsink[Q] == 2.0
assert shortest_path[Sink_T](gsink, P, Q) == [P, Q]
assert shortest_path[Sink_T](gsink, Q, P) == []        # nothing leaves the sink

# --- unreachable nodes ------------------------------------------------------
# A graph names every one of its nodes as a key, the edgeless ones included,
# so the keys are the node set and every node is in the table. The ones
# nothing reaches answer Inf.
type Far_T is enum W, X, Y, Z
let gfar: {Far_T}[](float, Far_T) = {W: [(1.0, X)], X: [], Y: [(1.0, Z)], Z: []}
let dfar: {Far_T}float = dijkstra[Far_T](gfar, W)
assert dfar[W] == 0.0
assert dfar[X] == 1.0
assert dfar[Y] == Inf          # a key, but nothing reaches it
assert dfar[Z] == Inf          # a key, reachable only from the stranded Y
assert shortest_path[Far_T](gfar, W, Z) == []

# Break the convention and the table stops being exhaustive, which is the
# whole reason the convention is written down. Z below is neither a key nor
# reachable -- the graph mentions it in no place the walk ever visits -- so
# it is absent rather than Inf. X is not a key either, but it is reached,
# and the relax step puts it in.
let gpartial: {Far_T}[](float, Far_T) = {W: [(1.0, X)], Y: [(1.0, Z)]}
let dpartial: {Far_T}float = dijkstra[Far_T](gpartial, W)
assert dpartial[W] == 0.0
assert dpartial[X] == 1.0             # not a key, but reached
assert dpartial[Y] == Inf             # a key, so present, and unreached
assert Z not in dpartial              # neither a key nor reached
assert dpartial.get(Z, Inf) == Inf    # ask this way if you cannot be sure
assert shortest_path[Far_T](gpartial, W, Z) == []

print "all graphs tests passed"
