#!/usr/bin/env ady2nim
#ady2nim-args c -r --mm:none -d:useMalloc
"""tsp_window -- tsp_map.html in a native window (the system's web engine) instead of the browser.

    make window                            open the window (it runs ady2nim c -r tsp_window.ady)
    ady2nim c -r tsp_window.ady -- --check load the page, print what it shows, exit

Run it from this directory. The page is unchanged: the script is put inline, so no server is needed. `nim_log` is bound for
the page, so its console and errors reach this terminal.
"""
nimport os, strutils
from webview nimport *
from json nimport *

const HOOK: str = """
for (const level of ["log", "warn", "error"]) {
  const old = console[level];
  console[level] = (...a) => { window.nim_log(level + ": " + a.join(" ")); old.apply(console, a); };
}
window.addEventListener("error", e => window.nim_log("error: " + e.message));
window.addEventListener("load", () => setTimeout(() => window.nim_log("loaded: " +
  document.querySelectorAll("tr.algo").length + " rows, selected: " +
  (document.querySelector("tr.selected td") || {}).textContent), 500));
"""

let CHECK: bool = "--check" in os.commandLineParams()
let W: Webview = newWebview(debug=not CHECK)

def nim_log(id: str, req: JsonNode) -> str:
    let msg: str = req[0].get_str()
    print(msg)
    if CHECK and msg.starts_with("loaded:"):
        W.terminate()
    return "null"

def main():
    let script: str = read_file("tsp_map.js").replace("</script", "<\\/script")
    let html: str = read_file("tsp_map.html").replace("<script src=\"tsp_map.js\"></script>", f"<script>{script}</script>")

    W.title = "Travelling salesman in Adascript"
    W.size = (1100, 700)
    W.bind("nim_log", nim_log)
    W.init(HOOK)
    W.html = html
    W.run()
    W.destroy()

main()
