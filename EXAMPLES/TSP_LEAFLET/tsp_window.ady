#!/usr/bin/env ady2nim
#ady2nim-args c -r --mm:none -d:useMalloc
"""tsp_window -- tsp_map.html in a native window (the system's web engine) instead of the browser.

    make window                            open the window (it runs ady2nim c -r tsp_window.ady)
    ady2nim c -r tsp_window.ady -- --check load the page, print what it shows, exit

Run it from this directory, after `ady2nim js tsp_window_hook.ady` (make window does both). The page is unchanged: the script is put inline, so no server is needed.
`host_log` is bound for
the page, so what tsp_window_hook says reaches this terminal.
"""
nimport os, strutils
from webview nimport *
from json nimport *

let CHECK: bool = "--check" in os.commandLineParams()
let W: Webview = newWebview(debug=not CHECK)

def host_log(id: str, req: JsonNode) -> str:
    let msg: str = req[0].get_str()
    print(msg)
    if CHECK and msg.starts_with("loaded:"):
        W.terminate()
    return "null"

def main():
    let script: str = read_file("tsp_map.js").replace("</script", "<\\/script")
    let html: str = read_file("tsp_map.html").replace("<script src=\"tsp_map.js\"></script>", f"<script>{script}</script>")

    W.title = "Travelling salesman in Adascript"
    W.size = (1100, 700)
    W.bind("host_log", host_log)
    W.init(read_file("tsp_window_hook.js"))
    W.html = html
    W.run()
    W.destroy()

main()
