#!/usr/bin/env ady2nim
"""
bench_search -- time two things a program does all day: look for a word in a
file, and find what two files of numbers have in common.

    bench_search find FILE WORD
    bench_search and  FILE_A FILE_B        (sorted integers, one per token)

Each is done twice: the library's way (`count`, the set `&`), which is what
you would write, and the explicit loop (a scan of the lines, a two-pointer
walk over the sorted lists), which is what C or Java would do. The input is
prepared before the clock starts, so each line times the search alone.

Adascript reads no bytes: a file is text here, and a word is a `str`.

The program is a translation of tests/perf/bench.py of
https://github.com/Anode1/ais, run against that benchmark's data; RESULTS.md
has the numbers, the caveats and how to reproduce them.
"""
nimport time

const REPEATS: Positive = 5
const LOOP_REPEATS: Positive = 3

def find(path: str, word: str) -> None:
    let data:  str   = readFile(path)
    let lines: []str = data.split("\n")     # the "parse", outside the timing
    for it in 0..<REPEATS:                  # the library's substring count
        let start: float = time.time()
        let hits: int = data.count(word)
        print f"find.count iter{it} {(time.time() - start) * 1000.0:7.1f} ms  hits={hits}"
    for it in 0..<LOOP_REPEATS:             # the explicit loop over lines
        let start: float = time.time()
        var hits: int = 0
        for line in lines:
            if word in line:
                hits += 1
        print f"find.loop  iter{it} {(time.time() - start) * 1000.0:7.1f} ms  hits={hits}"

def common(path_a: str, path_b: str) -> None:
    let words_a: []str = readFile(path_a).split()   # each file is read once, and the
    let words_b: []str = readFile(path_b).split()   # sets and lists made from it are
    let a: {}str = set(words_a)             # prepared before the clock starts
    let b: {}str = set(words_b)
    let xs: []int = [int(w) for w in words_a]
    let ys: []int = [int(w) for w in words_b]
    for it in 0..<REPEATS:                  # the set intersection
        let start: float = time.time()
        let n: Natural = len(a & b)
        print f"and.set   iter{it} {(time.time() - start) * 1000.0:7.1f} ms  common={n} |A|={len(a)} |B|={len(b)}"
    for it in 0..<LOOP_REPEATS:             # the explicit two-pointer walk
        let start: float = time.time()
        var i: Natural = 0
        var j: Natural = 0
        var n: Natural = 0
        while i < len(xs) and j < len(ys):
            if xs[i] == ys[j]:
                n += 1
                i += 1
                j += 1
            elif xs[i] < ys[j]:
                i += 1
            else:
                j += 1
        print f"and.2ptr  iter{it} {(time.time() - start) * 1000.0:7.1f} ms  common={n}"

let mode: str = $1
case mode:
    when "find":
        find($2, $3)
    when "and":
        common($2, $3)
    when others:
        print f"usage: {$0} find FILE WORD | and FILE_A FILE_B"
        quit(1)
