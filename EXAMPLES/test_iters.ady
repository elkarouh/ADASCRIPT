#!/usr/bin/env py2nim
# test_iters.ady — tests for iters.ady
#
# Exercises both int and str instantiations of every generic function.
# Run with:
#   py2nim EXAMPLES/test_iters.ady -r

nimport iters

def less_than_4(x: int) -> bool:
    return x < 4

def add(a: int, b: int) -> int:
    return a + b

def starts_with_a(s: str) -> bool:
    return s[0] == 'a'

# --- int tests ---

var got: []int = []
for p in pairwise([1, 2, 3, 4]):
    got.append(p[0] * 10 + p[1])
assert got == [12, 23, 34]

got = []
for w in sliding_window([1, 2, 3, 4, 5], 3):
    got.append(w[0] * 100 + w[1] * 10 + w[2])
assert got == [123, 234, 345]

got = []
for idx, v in enumerate_seq([10, 20, 30]):
    got.append(idx * 100 + v)
assert got == [10, 120, 230]

got = []
for x in takewhile(less_than_4, [1, 2, 3, 4, 5]):
    got.append(x)
assert got == [1, 2, 3]

got = []
for x in dropwhile(less_than_4, [1, 2, 3, 4, 5]):
    got.append(x)
assert got == [4, 5]

got = []
for x in compress([1, 2, 3, 4, 5], [True, False, True, False, True]):
    got.append(x)
assert got == [1, 3, 5]

got = []
for x in chain([1, 2], [3, 4, 5]):
    got.append(x)
assert got == [1, 2, 3, 4, 5]

got = []
for x in flatten([[1, 2], [3], [4, 5]]):
    got.append(x)
assert got == [1, 2, 3, 4, 5]

got = []
for x in accumulate([1, 2, 3, 4], add, 0):
    got.append(x)
assert got == [1, 3, 6, 10]

var pairs: [](int, int) = []
for p in zip_longest([1, 2, 3], [10, 20], 0):
    pairs.append(p)
assert pairs == [(1, 10), (2, 20), (3, 0)]

var seqs: [][]int = []
for c in combinations([1, 2, 3, 4], 2):
    seqs.append(c)
assert seqs == [[1,2],[1,3],[1,4],[2,3],[2,4],[3,4]]

seqs = []
for p in permutations([1, 2, 3]):
    seqs.append(p)
assert len(seqs) == 6

got = []
for x in repeat_elem(7, 3):
    got.append(x)
assert got == [7, 7, 7]

got = []
for x in count_from(0, 2, 5):
    got.append(x)
assert got == [0, 2, 4, 6, 8]

var batches: [][]int = []
for b in batched([1, 2, 3, 4, 5], 2):
    batches.append(b)
assert batches == [[1, 2], [3, 4], [5]]

# --- str tests (exercises a second instantiation of each generic) ---

var str_pw: [](str, str) = []
for p in pairwise(["a", "b", "c"]):
    str_pw.append(p)
assert str_pw == [("a", "b"), ("b", "c")]

var words: []str = []
for x in chain(["hello"], ["world"]):
    words.append(x)
assert words == ["hello", "world"]

words = []
for x in compress(["keep", "drop", "keep"], [True, False, True]):
    words.append(x)
assert words == ["keep", "keep"]

words = []
for x in repeat_elem("ha", 3):
    words.append(x)
assert words == ["ha", "ha", "ha"]

words = []
for x in takewhile(starts_with_a, ["ant", "ape", "bee", "asp"]):
    words.append(x)
assert words == ["ant", "ape"]

var str_pairs: [](str, str) = []
for p in zip_longest(["a", "b", "c"], ["x", "y"], "?"):
    str_pairs.append(p)
assert str_pairs == [("a", "x"), ("b", "y"), ("c", "?")]

# --- mixed types via product ---

var mixed: [](int, str) = []
for p in product([1, 2], ["x", "y"]):
    mixed.append(p)
assert mixed == [(1, "x"), (1, "y"), (2, "x"), (2, "y")]

print("all itertools tests passed")
