#!/usr/bin/env ady2nim
"""Test: `if` statement modifier — `return` / `break` / `continue` if cond.

A guard clause written on one line: the exit is taken only when the
condition holds. Both backends emit the one-line `if cond: stmt` form, so
the check here is that the two agree — every case is an assert, and the
ternary cases are the ones that must keep parsing as expressions rather
than as a modifier.
"""

# ─── test 1: return, the guard-clause case ───────────────────────────────────

def is_term_continuation(code_s: str) -> bool:
    """The shape the modifier was added for: three guards, then the work."""
    return False if code_s == ""
    return True if code_s.startswith("(")
    return False if code_s.startswith(":=") or code_s.startswith("=>")
    return code_s[0] != 'x'

assert not is_term_continuation("")
assert is_term_continuation("(a, b)")
assert not is_term_continuation(":= 1")
assert not is_term_continuation("xor y")
assert is_term_continuation("and then z")
print "test1 OK"

# ─── test 2: continue and break inside a loop ────────────────────────────────

def sum_until_negative(xs: []int) -> int:
    var total: int = 0
    for x in xs:
        continue if x == 0
        break if x < 0
        total += x
    return total

assert sum_until_negative([1, 0, 2, 3]) == 6      # the 0 is skipped
assert sum_until_negative([1, 2, -1, 4]) == 3     # -1 breaks
print "test2 OK"

# ─── test 3: a bare return, and a guard in a nested loop ─────────────────────

def first_row_with(rows: [][]int, want: int) -> int:
    for i in range(len(rows)):
        for v in rows[i]:
            return i if v == want
    return -1

assert first_row_with([[1, 2], [3, 4]], 4) == 1
assert first_row_with([[1, 2], [3, 4]], 9) == -1

def announce(quiet: bool) -> None:
    return if quiet
    print "not quiet"

announce(True)
print "test3 OK"

# ─── test 4: the conditional expression is untouched ─────────────────────────
#
# `a if c else b` is an expression and must keep parsing as one: the modifier
# only takes a line whose `if` has no `else`.

def pick(flag: bool) -> int:
    let v: int = 1 if flag else 2
    return v

assert pick(True) == 1
assert pick(False) == 2

var chosen: str = "big" if len("abcd") > 3 else "small"
assert chosen == "big"

def pick_direct(flag: bool) -> int:
    return 1 if flag else 2

assert pick_direct(True) == 1
assert pick_direct(False) == 2
print "test4 OK"

print "all statement-modifier tests passed"
