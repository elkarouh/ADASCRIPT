#!/usr/bin/env py2nim
#ady2nim-args c -d:release --opt:size
"""git1 — version-control individual files independently.

Each tracked file gets its own private git repo, ".git1/<name>",
grouped under a single ".git1" container in the file's directory.

Concept from kotodharma/single-file-git.
"""

nimport os, strutils

const VERSION:   str = "3.0"
const CONTAINER: str = ".git1"
let PROG:   str = os.path.basename($0).lstrip(".")

# --- what every git call needs to know about the file it acts on -----------
type Target_T is tuple:
    dir:    Path   # the directory holding the file; git runs here
    base:   str    # the file's own name
    gitdir: Path   # its private repo, relative to dir

def die(msg: str):
    stderr.writeLine(f"{PROG}: {msg}")
    quit(1)

def warn(msg: str):
    stderr.writeLine(f"{PROG}: {msg}")

def confirm(question: str) -> bool:
    var reply: str = ""
    stdout.write(question + " [y/N] ")
    stdout.flushFile()
    try:
        reply = input("")
    except EOFError:
        reply = "n"
    return reply.lower().startswith("y")

# --- path handling ---------------------------------------------------------

def split_target(target: str) -> Target_T:
    """Split a file name into the three things a git call needs.

    Returned rather than assigned to globals: a Target_T says which file it
    describes, so g(t, ...) cannot act on whichever file happened to be
    split last. cmd_mv is the case that makes the difference plain -- it
    holds an old target and a new one at the same time, which globals can
    only manage by copying them into locals first.
    """
    var t: str = target.rstrip("/")
    if t'Length == 0:
        die("empty file name")
    let head: str = os.path.dirname(t)
    let base: str = os.path.basename(t)
    if base'Length == 0:
        die(f"not a file name: '{target}'")
    (dir: Path("." if head'Length == 0 else head),
     base: base,
     gitdir: Path(CONTAINER) / base)

def is_repo(cdir: Path, entry: str) -> bool:
    """True when cdir/entry is one of our per-file repos.

    A repo is named after its file, so the entry is recognised by its
    content rather than by its name: "." and ".." are skipped, and anything
    else in the container without a HEAD is not one of ours.
    """
    if entry'Length == 0 or entry == "." or entry == "..": return False
    let gitdir: Path = cdir / entry
    if not -d gitdir: return False
    # Parenthesised: a file test takes a primary, so the join has to be one.
    -f (gitdir / "HEAD")

def ignore_escape(name: str) -> str:
    var s: str = name.replace("\\", "\\\\")
    for ch in "*?[#!":
        s = s.replace(str(ch), "\\" + str(ch))
    s

def write_exclude(base: str, gitdir: Path):
    let exclude: Path = gitdir / "info" / "exclude"
    os.makedirs(os.path.dirname(exclude))
    writeFile(exclude, "/*\n!/" + ignore_escape(base) + "\n")

def g(t: Target_T, args: []str) -> int:
    """Run git against the current file's repo. Returns git's exit code.

    Every git invocation in this program goes through here, and the target
    says which file it acts on -- cmd_each walks a directory of repos and
    passes a different one each time round its loop.

    The three settings are what make a per-file repo work: run in the file's
    own directory, name the private repo as GIT_DIR so git stops searching
    upward for a .git, and declare that directory the work tree. The first is
    the `cwd` option; the other two go through `env`, which is where a value
    crossing into the shell's own namespace belongs -- spelling them as
    `GIT_DIR={!x}` in the command would work, but the shell would be parsing
    what the language can hand over directly.

    `{*args}` quotes each argument and joins them, so
    g(["commit", "-m", "hello world"]) reaches git as three arguments and not
    four.

    An int-typed target -- `let code: int = shell: ...` -- rather than a
    capturing one: git keeps the terminal, so its output, colours and pager
    reach the user directly, and the exit code still comes back.
    """
    let env: {str}str = {"GIT_DIR": str(t.gitdir), "GIT_WORK_TREE": "."}
    let code: int = shell(cwd = t.dir, env = env): git {*args}
    code

def g_exec(t: Target_T, args: []str):
    """Hand this process over to git. Does not return.

    Same repo, same directory, same quoting as g() -- the difference is that
    there is no coming back. The last thing main() does is run git and pass
    its exit code on, and that is what exec is for: git1 *becomes* git rather
    than sitting there as a parent whose only remaining job is to copy a
    number. One less process in the tree, the exit status is git's by
    construction, and Ctrl-C reaches git directly instead of arriving at a
    wrapper that has to decide what to do about it.

    Only the final dispatch can use this. Every other caller needs g(),
    because they still have work to do once git returns.
    """
    let env: {str}str = {"GIT_DIR": str(t.gitdir), "GIT_WORK_TREE": "."}
    shellExec(cwd = t.dir, env = env): git {*args}

def g_lines(t: Target_T, args: []str) -> []str:
    """Run git against the current file's repo. Returns what git printed.

    The capturing twin of g(): same directory, same repo, same quoting,
    but for the calls whose answer is the output rather than the status --
    reading the current branch, listing the branches. git does not get the
    terminal here, so this is not the one to use for anything the user is
    meant to watch.
    """
    let env: {str}str = {"GIT_DIR": str(t.gitdir), "GIT_WORK_TREE": "."}
    let lines = shellLines(cwd = t.dir, env = env): git {*args}
    lines

def current_branch(t: Target_T) -> str:
    let lines: []str = g_lines(t, ["rev-parse", "--abbrev-ref", "HEAD"])
    if lines'Length == 0: return "HEAD"
    return lines[0].strip()

def losing_branches(t: Target_T, current: str, winner: str) -> []str:
    """Every branch other than the one adopted and the one holding it now."""
    var others: []str = []
    for line in g_lines(t, ["for-each-ref", "--format=%(refname:short)", "refs/heads"]):
        let name: str = line.strip()
        if name'Length > 0 and name != current and name != winner:
            others.append(name)
    others

def require_repo(t: Target_T, target: str):
    let repo: Path = t.dir / t.gitdir
    if not -d repo:
        die(f"'{target}' is not tracked (run: {PROG} init {target})")

# --- subcommands -----------------------------------------------------------

def cmd_init(target: str):
    if not -e target: die(f"no such file: {target}")
    if not -f target: die(f"not a regular file: {target}")
    let t: Target_T = split_target(target)
    if not -d t.dir: die(f"no such directory: {t.dir}")
    let repo: Path = t.dir / t.gitdir
    if -e repo: die(f"already tracked: {target}")

    shell: mkdir -p -- {!t.dir / CONTAINER}
    let r = shell: git init --quiet --bare -- {!repo} 2>&1
    if r.code != 0: die(f"could not create {repo}")

    shell: git --git-dir={!repo} config core.bare false
    shell: git --git-dir={!repo} config core.worktree ../..
    write_exclude(t.base, repo)

    if g(t, ["add", "--", t.base]) != 0 or g(t, ["commit", "--quiet", "-m", "initial commit"]) != 0:
        shell: rm -rf -- {!repo}
        die("could not create the initial commit (is user.email set?)")
    print f"tracking {target} in {repo}"

def cmd_ls(argv: []str):
    let d: str = argv[0] if argv'Length >= 1 else "."
    let cdir: Path = Path(d) / CONTAINER
    var found: int = 0
    if -d cdir:
        let entries = shellLines: ls -1a {!cdir}
        for name in sorted(entries):
            if not is_repo(cdir, name): continue
            let gitdir: Path = cdir / name
            found = 1
            let file: Path = Path(d) / name
            var status: str = ""
            if not -e file: status = " [file missing]"
            # `env` rather than `GIT_DIR=...` in the command, for the reason
            # g() gives: the value crosses into the child's environment, which
            # the language can hand over without the shell parsing it.  The
            # capturing form keeps stderr in r.stderr, so there is nothing
            # here for a 2>/dev/null to suppress either.
            let one_env: {str}str = {"GIT_DIR": str(gitdir)}
            let r = shell(env = one_env): git log -1 --format='%cr'
            var when: str = ""
            if r.output.strip()'Length > 0:
                when = f"  (last commit {r.output.strip()})"
            print f"{name}{when}{status}"
    if found == 0:
        warn("no tracked files here")

def cmd_rm(argv: []str):
    var args: []str = argv
    var force: bool = False
    if args'Length > 0 and args[0] == "-f":
        force = True
        args = args[1:]
    if args'Length < 1: die(f"usage: {PROG} rm [-f] <file>")
    let t: Target_T = split_target(args[0])
    require_repo(t, args[0])
    if not force:
        if not confirm(f"Delete the history of {args[0]}? The file itself is kept."):
            die("aborted")
    shell: rm -rf -- {!t.dir / t.gitdir}
    shell: rmdir -- {!t.dir / CONTAINER} 2>/dev/null || true

def cmd_adopt(argv: []str):
    """Replace the current branch with another one, wholesale.

    For the workflow this exists to serve -- try an idea on a branch, keep
    the winner -- a merge is the wrong tool: it combines two versions, and
    two versions of one file conflict readily. Adopting moves the current
    branch to the winning one instead, so nothing is combined.
    """
    var args: []str = argv
    var force: bool = False
    var prune: str = "ask"
    while args'Length > 0 and args[0].startswith("-"):
        if args[0] == "-f":
            force = True
        elif args[0] == "--prune":
            prune = "yes"
        elif args[0] == "--no-prune":
            prune = "no"
        else:
            die(f"unknown option: {args[0]}")
        args = args[1:]
    if args'Length != 2:
        die(f"usage: {PROG} adopt [-f] [--prune|--no-prune] <file> <branch>")

    let target: str = args[0]
    let branch: str = args[1]
    let t: Target_T = split_target(target)
    require_repo(t, target)
    if g(t, ["show-ref", "--verify", "--quiet", "refs/heads/" + branch]) != 0:
        die(f"no such branch: {branch}")
    let current: str = current_branch(t)
    if branch == current:
        die(f"'{branch}' is already the current branch")

    if not force and g(t, ["diff", "--quiet", "HEAD", "--", t.base]) != 0:
        if not confirm(f"{target} has uncommitted changes; discard them?"):
            die("aborted")

    if g(t, ["reset", "--hard", branch]) != 0:
        die(f"could not move {current} to {branch}")
    print f"{current} now holds {branch}"

    if prune == "no": return
    let others: []str = losing_branches(t, current, branch)
    if others'Length == 0: return
    var doit: bool = prune == "yes"
    if prune == "ask":
        doit = confirm(f"Delete the branches that lost ({', '.join(others)})?")
    if doit:
        var cmd: []str = ["branch", "-D"]
        for name in others:
            cmd.append(name)
        g(t, cmd)

def cmd_mv(old: str, new: str):
    # Two targets at once, which is the whole argument for returning one
    # rather than assigning three globals: with globals the old values had
    # to be copied into locals before split_target(new) overwrote them.
    let ot: Target_T = split_target(old)
    require_repo(ot, old)
    if -e new: die(f"target exists: {new}")
    let nt: Target_T = split_target(new)
    if not -d nt.dir: die(f"no such directory: {nt.dir}")
    let new_repo: Path = nt.dir / nt.gitdir
    if -e new_repo: die(f"already tracked: {new}")

    shell: mv -- {!old} {!new}
    shell: mkdir -p -- {!nt.dir / CONTAINER}
    shell: mv -- {!ot.dir / ot.gitdir} {!new_repo}
    write_exclude(nt.base, new_repo)
    g(nt, ["rm", "--quiet", "--cached", "--ignore-unmatch", "--", ot.base])
    g(nt, ["add", "--", nt.base])
    g(nt, ["commit", "--quiet", "-m", f"rename {ot.base} -> {nt.base}"])

def cmd_each(argv: []str):
    if argv'Length == 0: die(f"usage: {PROG} each <git command> [args...]")
    let cdir: Path = Path(CONTAINER)
    if not -d cdir: return
    let entries = shellLines: ls -1a {!cdir}
    for name in sorted(entries):
        if not is_repo(cdir, name): continue
        print f"=== {name} ==="
        let t: Target_T = split_target(name)
        let rc: int = g(t, argv)
        if rc != 0:
            warn(f"'{name}': git exited {rc}")

def usage() -> str:
    f"""{PROG} {VERSION} - independent version control for single files

Each tracked file gets a private git repo named "{CONTAINER}/<file>",
grouped under a single "{CONTAINER}" directory. Many tracked files can coexist
in one directory without seeing each other.

  {PROG} init <file>            start tracking <file>
  {PROG} <file> [git args...]   run git in that file's repo (default: status)
  {PROG} ls [dir]               list tracked files in a directory
  {PROG} mv <old> <new>         rename a tracked file and its repo
  {PROG} rm [-f] <file>         delete a file's history (keeps the file)
  {PROG} adopt <file> <branch>  make <branch> the current branch, wholesale
  {PROG} each <git args...>     run one git command in every repo here
  {PROG} help                   this text

Examples:

  {PROG} init notes.txt
  {PROG} notes.txt diff
  {PROG} notes.txt commit -am "reworked the intro"
  {PROG} notes.txt log --oneline
  {PROG} sub/config.yml status
  {PROG} notes.txt checkout -b bolder
  {PROG} adopt notes.txt bolder
  {PROG} each log -1 --oneline

Notes:

  * Anything after the file name is passed to git untouched, so the full
    command set is available: log, diff, stash, tag, blame, rebase, push...
  * Paths in those arguments are read relative to the tracked file's own
    directory, which is the work tree.
  * The repo ignores every path except its own file, so "commit -a" and
    "status" stay clean no matter what else is in the directory.
  * To track a file whose name collides with a subcommand, use "--":
      {PROG} -- ls log
  * "adopt" is for trying an idea on a branch and keeping the winner: it
    moves the current branch onto <branch>, discarding what the current one
    held (recoverable through "reflog"), and offers to delete the branches
    that lost. Nothing is combined, so nothing can conflict. Use "-f" to
    skip the prompt about uncommitted changes, "--prune"/"--no-prune" to
    settle the losing branches without being asked.
  * If the directory is itself inside an ordinary git repo, add "{CONTAINER}"
    to its .gitignore.

Tip: for a long session on one file, alias it:  alias gg='{PROG} notes.txt'"""

def cmd_help():
    let pager: str = $PAGER if $PAGER else "less"
    # have() asks PATH directly; `command -v` cost a shell and a process to
    # answer the same question, and made the caller know that 127 means no.
    let is_tty: int = shell: test -t 1
    if is_tty == 0 and have(pager):
        let tmp: str = "/tmp/git1-help.txt"
        writeFile(tmp, usage() + "\n")
        let shown: int = shell: {!pager} {!tmp}
        if shown != 0: warn("pager failed")
        shell: rm -f -- {!tmp}
    else:
        print usage()

# --- dispatch ---------------------------------------------------------------

def main():
    if $# == 0:
        stderr.writeLine(usage())
        quit(2)

    var argv: []str = $@
    if argv[0] == "--":
        argv = argv[1:]
        if argv'Length == 0: die("expected a file name after --")
    else:
        case argv[0]:
            when "init":
                if argv'Length < 2: die(f"usage: {PROG} init <file>")
                cmd_init(argv[1])
                return
            when "ls":       cmd_ls(argv[1:]); return
            when "rm":       cmd_rm(argv[1:]); return
            when "mv":
                if argv'Length != 3: die(f"usage: {PROG} mv <old> <new>")
                cmd_mv(argv[1], argv[2])
                return
            when "adopt":    cmd_adopt(argv[1:]); return
            when "each":     cmd_each(argv[1:]); return
            when "help" | "-h" | "--help": cmd_help(); return
            when "--version": print f"{PROG} {VERSION}"; return
            when others: pass

    let target: str = argv[0]
    let t: Target_T = split_target(target)
    require_repo(t, target)
    let args: []str = argv[1:] if argv'Length > 1 else ["status", "--short", "--branch"]
    g_exec(t, args)

main()
