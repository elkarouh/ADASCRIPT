#!/usr/bin/env py2nim
#ady2nim-args c -d:release --opt:size
"""git1 — version-control individual files independently.

Each tracked file gets its own private git repo, ".git1/<name>",
grouped under a single ".git1" container in the file's directory.

Concept from kotodharma/single-file-git.
Adascript translation of git1.sh v3.0.
"""

nimport os, strutils

const VERSION:   str = "3.0"
const CONTAINER: str = ".git1"
let PROG:   str = os.path.basename($0).lstrip(".")

# --- globals set by split_target (mirrors the bash version) ----------------
var G1_DIR:    str = ""
var G1_BASE:   str = ""
var G1_GITDIR: str = ""

def die(msg: str):
    stderr.writeLine(f"{PROG}: {msg}")
    quit(1)

def warn(msg: str):
    stderr.writeLine(f"{PROG}: {msg}")

def confirm(question: str) -> bool:
    var reply: str = ""
    stdout.write(question + " [y/N] ")
    stdout.flushFile()
    try:
        reply = input("")
    except EOFError:
        reply = "n"
    return reply.lower().startswith("y")

# --- shell helpers ---------------------------------------------------------

def Q(s: str) -> str:
    "'" + s.replace("'", "'\\''") + "'"

# --- path handling ---------------------------------------------------------

def split_target(target: str):
    var t: str = target.rstrip("/")
    if t'Length == 0:
        die("empty file name")
    let head: str = os.path.dirname(t)
    G1_BASE = os.path.basename(t)
    if G1_BASE'Length == 0:
        die(f"not a file name: '{target}'")
    G1_DIR = "." if head'Length == 0 else head
    G1_GITDIR = CONTAINER + "/" + G1_BASE

def is_repo(cdir: str, entry: str) -> bool:
    """True when cdir/entry is one of our per-file repos.

    A repo is named after its file, so the entry is recognised by its
    content rather than by its name: "." and ".." are skipped, and anything
    else in the container without a HEAD is not one of ours.
    """
    if entry'Length == 0 or entry == "." or entry == "..": return False
    let gitdir: str = os.path.join(cdir, entry)
    if not -d gitdir: return False
    let head: str = os.path.join(gitdir, "HEAD")
    if -f head: return True
    return False

def ignore_escape(name: str) -> str:
    var s: str = name.replace("\\", "\\\\")
    for ch in "*?[#!":
        s = s.replace(str(ch), "\\" + str(ch))
    s

def write_exclude(base: str, gitdir: str):
    let exclude: str = os.path.join(gitdir, "info", "exclude")
    os.makedirs(os.path.dirname(exclude))
    writeFile(exclude, "/*\n!/" + ignore_escape(base) + "\n")

def g(args: []str) -> int:
    """Run git against the current file's repo. Returns git's exit code.

    Every git invocation in this program goes through here. "The current
    file" is whichever one split_target() was last called with: G1_DIR,
    G1_BASE and G1_GITDIR are globals, as in the bash original, so callers
    set them first -- cmd_each does it once per repo in its loop.

    The three settings in the command are what make a per-file repo work:
    cd into the file's own directory, name the private repo as GIT_DIR so
    git stops searching upward for a .git, and declare that directory the
    work tree.

    Each argument goes through Q() because the command is assembled as a
    string for the shell, which will not quote it for anyone. Without it,
    g(["commit", "-m", "hello world"]) would reach git as four arguments.

    An int-typed target -- `let code: int = shell: ...` -- rather than a
    capturing one: git keeps the terminal, so its output, colours and pager
    reach the user directly, and the exit code still comes back.
    """
    var parts: []str = []
    for a in args:
        parts.append(Q(a))
    let cmd: str = " ".join(parts)
    let code: int = shell: cd {Q(G1_DIR)} && GIT_DIR={Q(G1_GITDIR)} GIT_WORK_TREE=. git {cmd}
    code

def g_lines(args: []str) -> []str:
    """Run git against the current file's repo. Returns what git printed.

    The capturing twin of g(): same directory, same repo, same quoting,
    but for the calls whose answer is the output rather than the status --
    reading the current branch, listing the branches. git does not get the
    terminal here, so this is not the one to use for anything the user is
    meant to watch.
    """
    var parts: []str = []
    for a in args:
        parts.append(Q(a))
    let cmd: str = " ".join(parts)
    let lines = shellLines: cd {Q(G1_DIR)} && GIT_DIR={Q(G1_GITDIR)} GIT_WORK_TREE=. git {cmd}
    lines

def current_branch() -> str:
    let lines: []str = g_lines(["rev-parse", "--abbrev-ref", "HEAD"])
    if lines'Length == 0: return "HEAD"
    return lines[0].strip()

def losing_branches(current: str, winner: str) -> []str:
    """Every branch other than the one adopted and the one holding it now."""
    var others: []str = []
    for line in g_lines(["for-each-ref", "--format=%(refname:short)", "refs/heads"]):
        let name: str = line.strip()
        if name'Length > 0 and name != current and name != winner:
            others.append(name)
    others

def require_repo(target: str):
    let repo: str = os.path.join(G1_DIR, G1_GITDIR)
    if not -d repo:
        die(f"'{target}' is not tracked (run: {PROG} init {target})")

# --- subcommands -----------------------------------------------------------

def cmd_init(target: str):
    if not -e target: die(f"no such file: {target}")
    if not -f target: die(f"not a regular file: {target}")
    split_target(target)
    if not -d G1_DIR: die(f"no such directory: {G1_DIR}")
    let repo: str = os.path.join(G1_DIR, G1_GITDIR)
    if -e repo: die(f"already tracked: {target}")

    shell: mkdir -p -- {Q(os.path.join(G1_DIR, CONTAINER))}
    let r = shell: git init --quiet --bare -- {Q(repo)} 2>&1
    if r.code != 0: die(f"could not create {repo}")

    shell: git --git-dir={Q(repo)} config core.bare false
    shell: git --git-dir={Q(repo)} config core.worktree ../..
    write_exclude(G1_BASE, repo)

    if g(["add", "--", G1_BASE]) != 0 or g(["commit", "--quiet", "-m", "initial commit"]) != 0:
        shell: rm -rf -- {Q(repo)}
        die("could not create the initial commit (is user.email set?)")
    print f"tracking {target} in {repo}"

def cmd_ls(argv: []str):
    let d: str = argv[0] if argv'Length >= 1 else "."
    let cdir: str = os.path.join(d, CONTAINER)
    var found: int = 0
    if -d cdir:
        let entries = shellLines: ls -1a {Q(cdir)}
        for name in sorted(entries):
            if not is_repo(cdir, name): continue
            let gitdir: str = os.path.join(cdir, name)
            found = 1
            let file: str = os.path.join(d, name)
            var status: str = ""
            if not -e file: status = " [file missing]"
            let r = shell: GIT_DIR={Q(gitdir)} git log -1 --format='%cr' 2>/dev/null
            var when: str = ""
            if r.output.strip()'Length > 0:
                when = f"  (last commit {r.output.strip()})"
            print f"{name}{when}{status}"
    if found == 0:
        warn("no tracked files here")

def cmd_rm(argv: []str):
    var args: []str = argv
    var force: bool = False
    if args'Length > 0 and args[0] == "-f":
        force = True
        args = args[1:]
    if args'Length < 1: die(f"usage: {PROG} rm [-f] <file>")
    split_target(args[0])
    require_repo(args[0])
    if not force:
        if not confirm(f"Delete the history of {args[0]}? The file itself is kept."):
            die("aborted")
    shell: rm -rf -- {Q(os.path.join(G1_DIR, G1_GITDIR))}
    shell: rmdir -- {Q(os.path.join(G1_DIR, CONTAINER))} 2>/dev/null || true

def cmd_adopt(argv: []str):
    """Replace the current branch with another one, wholesale.

    For the workflow this exists to serve -- try an idea on a branch, keep
    the winner -- a merge is the wrong tool: it combines two versions, and
    two versions of one file conflict readily. Adopting moves the current
    branch to the winning one instead, so nothing is combined.
    """
    var args: []str = argv
    var force: bool = False
    var prune: str = "ask"
    while args'Length > 0 and args[0].startswith("-"):
        if args[0] == "-f":
            force = True
        elif args[0] == "--prune":
            prune = "yes"
        elif args[0] == "--no-prune":
            prune = "no"
        else:
            die(f"unknown option: {args[0]}")
        args = args[1:]
    if args'Length != 2:
        die(f"usage: {PROG} adopt [-f] [--prune|--no-prune] <file> <branch>")

    let target: str = args[0]
    let branch: str = args[1]
    split_target(target)
    require_repo(target)
    if g(["show-ref", "--verify", "--quiet", "refs/heads/" + branch]) != 0:
        die(f"no such branch: {branch}")
    let current: str = current_branch()
    if branch == current:
        die(f"'{branch}' is already the current branch")

    if not force and g(["diff", "--quiet", "HEAD", "--", G1_BASE]) != 0:
        if not confirm(f"{target} has uncommitted changes; discard them?"):
            die("aborted")

    if g(["reset", "--hard", branch]) != 0:
        die(f"could not move {current} to {branch}")
    print f"{current} now holds {branch}"

    if prune == "no": return
    let others: []str = losing_branches(current, branch)
    if others'Length == 0: return
    var doit: bool = prune == "yes"
    if prune == "ask":
        doit = confirm(f"Delete the branches that lost ({', '.join(others)})?")
    if doit:
        var cmd: []str = ["branch", "-D"]
        for name in others:
            cmd.append(name)
        g(cmd)

def cmd_mv(old: str, new: str):
    split_target(old)
    require_repo(old)
    let old_dir:  str = G1_DIR
    let old_base: str = G1_BASE
    let old_git:  str = G1_GITDIR
    if -e new: die(f"target exists: {new}")
    split_target(new)
    if not -d G1_DIR: die(f"no such directory: {G1_DIR}")
    let new_repo: str = os.path.join(G1_DIR, G1_GITDIR)
    if -e new_repo: die(f"already tracked: {new}")

    shell: mv -- {Q(old)} {Q(new)}
    shell: mkdir -p -- {Q(os.path.join(G1_DIR, CONTAINER))}
    shell: mv -- {Q(os.path.join(old_dir, old_git))} {Q(new_repo)}
    write_exclude(G1_BASE, new_repo)
    shell: cd {Q(G1_DIR)} && GIT_DIR={Q(G1_GITDIR)} GIT_WORK_TREE=. git rm --quiet --cached --ignore-unmatch -- {Q(old_base)}
    g(["add", "--", G1_BASE])
    g(["commit", "--quiet", "-m", f"rename {old_base} -> {G1_BASE}"])

def cmd_each(argv: []str):
    if argv'Length == 0: die(f"usage: {PROG} each <git command> [args...]")
    let cdir: str = CONTAINER
    if not -d cdir: return
    let entries = shellLines: ls -1a {Q(cdir)}
    for name in sorted(entries):
        if not is_repo(cdir, name): continue
        print f"=== {name} ==="
        split_target(name)
        let rc: int = g(argv)
        if rc != 0:
            warn(f"'{name}': git exited {rc}")

def usage() -> str:
    f"""{PROG} {VERSION} - independent version control for single files

Each tracked file gets a private git repo named "{CONTAINER}/<file>",
grouped under a single "{CONTAINER}" directory. Many tracked files can coexist
in one directory without seeing each other.

  {PROG} init <file>            start tracking <file>
  {PROG} <file> [git args...]   run git in that file's repo (default: status)
  {PROG} ls [dir]               list tracked files in a directory
  {PROG} mv <old> <new>         rename a tracked file and its repo
  {PROG} rm [-f] <file>         delete a file's history (keeps the file)
  {PROG} adopt <file> <branch>  make <branch> the current branch, wholesale
  {PROG} each <git args...>     run one git command in every repo here
  {PROG} help                   this text

Examples:

  {PROG} init notes.txt
  {PROG} notes.txt diff
  {PROG} notes.txt commit -am "reworked the intro"
  {PROG} notes.txt log --oneline
  {PROG} sub/config.yml status
  {PROG} notes.txt checkout -b bolder
  {PROG} adopt notes.txt bolder
  {PROG} each log -1 --oneline

Notes:

  * Anything after the file name is passed to git untouched, so the full
    command set is available: log, diff, stash, tag, blame, rebase, push...
  * Paths in those arguments are read relative to the tracked file's own
    directory, which is the work tree.
  * The repo ignores every path except its own file, so "commit -a" and
    "status" stay clean no matter what else is in the directory.
  * To track a file whose name collides with a subcommand, use "--":
      {PROG} -- ls log
  * "adopt" is for trying an idea on a branch and keeping the winner: it
    moves the current branch onto <branch>, discarding what the current one
    held (recoverable through "reflog"), and offers to delete the branches
    that lost. Nothing is combined, so nothing can conflict. Use "-f" to
    skip the prompt about uncommitted changes, "--prune"/"--no-prune" to
    settle the losing branches without being asked.
  * If the directory is itself inside an ordinary git repo, add "{CONTAINER}"
    to its .gitignore.

Tip: for a long session on one file, alias it:  alias gg='{PROG} notes.txt'"""

def cmd_help():
    let pager: str = $PAGER if $PAGER else "less"
    let r = shell: command -v {Q(pager)} 2>&1
    let is_tty: int = shell: test -t 1
    if is_tty == 0 and r.code == 0:
        let tmp: str = "/tmp/git1-help.txt"
        writeFile(tmp, usage() + "\n")
        let shown: int = shell: {Q(pager)} {Q(tmp)}
        if shown != 0: warn("pager failed")
        shell: rm -f -- {Q(tmp)}
    else:
        print usage()

# --- dispatch ---------------------------------------------------------------

def main():
    if $# == 0:
        stderr.writeLine(usage())
        quit(2)

    var argv: []str = $@
    if argv[0] == "--":
        argv = argv[1:]
        if argv'Length == 0: die("expected a file name after --")
    else:
        case argv[0]:
            when "init":
                if argv'Length < 2: die(f"usage: {PROG} init <file>")
                cmd_init(argv[1])
                return
            when "ls":       cmd_ls(argv[1:]); return
            when "rm":       cmd_rm(argv[1:]); return
            when "mv":
                if argv'Length != 3: die(f"usage: {PROG} mv <old> <new>")
                cmd_mv(argv[1], argv[2])
                return
            when "adopt":    cmd_adopt(argv[1:]); return
            when "each":     cmd_each(argv[1:]); return
            when "help" | "-h" | "--help": cmd_help(); return
            when "--version": print f"{PROG} {VERSION}"; return
            when others: pass

    let target: str = argv[0]
    split_target(target)
    require_repo(target)
    let args: []str = argv[1:] if argv'Length > 1 else ["status", "--short", "--branch"]
    quit(g(args))

main()
