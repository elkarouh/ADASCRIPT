#!/usr/bin/env py2nim
#ady2nim-args c -d:release --opt:size
"""git1 — version-control individual files independently.

Each tracked file gets its own private git repo, ".git1/<name>",
grouped under a single ".git1" container in the file's directory.

Concept from kotodharma/single-file-git.
"""

nimport os, strutils

const VERSION:   str = "3.0"
const CONTAINER: str = ".git1"
let PROG:   str = os.path.basename($0).lstrip(".")

def die(msg: str):
    stderr.writeLine(f"{PROG}: {msg}")
    quit(1)

def warn(msg: str):
    stderr.writeLine(f"{PROG}: {msg}")

def confirm(question: str) -> bool:
    var reply: str = ""
    stdout.write(question + " [y/N] ")
    stdout.flushFile()
    try:
        reply = input("")
    except EOFError:
        reply = "n"
    return reply.lower().startswith("y")

def ignore_escape(name: str) -> str:
    """Escape a file name for a .gitignore line."""
    var s: str = name.replace("\\", "\\\\")
    for ch in "*?[#!":
        s = s.replace(str(ch), "\\" + str(ch))
    s

# --- one tracked file ------------------------------------------------------

class Target:
    """One tracked file and the private repo that holds its history.

    Everything a git call needs to know travels with the object: run in the
    file's own directory, name the private repo as GIT_DIR so git stops
    searching upward for a .git, and declare that directory the work tree.
    """
    dir:    Path   # the directory holding the file; git runs here
    base:   str    # the file's own name
    gitdir: Path   # its private repo, relative to dir
    repo:   Path   # where that repo actually lives: dir / gitdir
    name:   str    # what the user typed, for messages
    env:    {str}str   # the two variables that make git use that repo

    def __init__(self, target: str):
        var t: str = target.rstrip("/")
        if t'Length == 0:
            die("empty file name")
        let head: str = os.path.dirname(t)
        self.base = os.path.basename(t)
        if self.base'Length == 0:
            die(f"not a file name: '{target}'")
        self.dir    = Path("." if head'Length == 0 else head)
        self.gitdir = Path(CONTAINER) / self.base
        self.repo   = self.dir / self.gitdir
        self.name   = target
        self.env    = {"GIT_DIR": str(self.gitdir), "GIT_WORK_TREE": "."}

    def git(self, args: []str) -> int:
        """Run git here. Returns its exit code; git keeps the terminal.

        An int-typed target rather than a capturing one, so git's output,
        colours and pager reach the user directly and the status still comes
        back.  `{*args}` quotes each argument, so
        t.git(["commit", "-m", "hello world"]) reaches git as three
        arguments and not four.
        """
        let code: int = shell(cwd = self.dir, env = self.env): git {*args}
        code

    def git_exec(self, args: []str):
        """Hand this process over to git. Does not return.

        The last thing main() does is run git and pass its exit code on, and
        that is what exec is for: git1 *becomes* git rather than sitting
        there as a parent whose only remaining job is to copy a number. One
        less process, the status is git's by construction, and Ctrl-C
        reaches git directly.  Only the final dispatch can use this.
        """
        shellExec(cwd = self.dir, env = self.env): git {*args}

    def git_lines(self, args: []str) -> []str:
        """Run git here and return what it printed.

        The capturing twin of git(), for the calls whose answer is the
        output rather than the status. git does not get the terminal, so
        this is not the one for anything the user is meant to watch.
        """
        let lines = shellLines(cwd = self.dir, env = self.env): git {*args}
        lines

    def require(self):
        if not -d self.repo:
            die(f"'{self.name}' is not tracked (run: {PROG} init {self.name})")

    def current_branch(self) -> str:
        let lines: []str = self.git_lines(["rev-parse", "--abbrev-ref", "HEAD"])
        if lines'Length == 0: return "HEAD"
        return lines[0].strip()

    def losing_branches(self, current: str, winner: str) -> []str:
        """Every branch other than the one adopted and the one holding it."""
        var others: []str = []
        for line in self.git_lines(["for-each-ref", "--format=%(refname:short)", "refs/heads"]):
            let name: str = line.strip()
            if name'Length > 0 and name != current and name != winner:
                others.append(name)
        others

    def write_exclude(self, repo: Path):
        """Make the repo ignore every path except its own file."""
        let exclude: Path = repo / "info" / "exclude"
        os.makedirs(os.path.dirname(exclude))
        writeFile(exclude, "/*\n!/" + ignore_escape(self.base) + "\n")

    def track(self):
        """Start tracking this file: the `init` subcommand."""
        if not -e self.name: die(f"no such file: {self.name}")
        if not -f self.name: die(f"not a regular file: {self.name}")
        if not -d self.dir: die(f"no such directory: {self.dir}")
        let repo: Path = self.repo
        if -e repo: die(f"already tracked: {self.name}")

        shell: mkdir -p -- {!self.dir / CONTAINER}
        let r = shell: git init --quiet --bare -- {!repo} 2>&1
        if r.code != 0: die(f"could not create {repo}")

        shell: git --git-dir={!repo} config core.bare false
        shell: git --git-dir={!repo} config core.worktree ../..
        self.write_exclude(repo)

        if self.git(["add", "--", self.base]) != 0 or self.git(["commit", "--quiet", "-m", "initial commit"]) != 0:
            shell: rm -rf -- {!repo}
            die("could not create the initial commit (is user.email set?)")
        print f"tracking {self.name} in {repo}"

    def rm(self, force: bool):
        """Delete this file's history, keeping the file."""
        self.require()
        if not force:
            if not confirm(f"Delete the history of {self.name}? The file itself is kept."):
                die("aborted")
        shell: rm -rf -- {!self.repo}
        shell: rmdir -- {!self.dir / CONTAINER} 2>/dev/null || true

    def adopt(self, branch: str, force: bool, prune: str):
        """Replace the current branch with another one, wholesale.

        For the workflow this exists to serve -- try an idea on a branch,
        keep the winner -- a merge is the wrong tool: it combines two
        versions, and two versions of one file conflict readily. Adopting
        moves the current branch to the winning one instead, so nothing is
        combined.
        """
        self.require()
        if self.git(["show-ref", "--verify", "--quiet", "refs/heads/" + branch]) != 0:
            die(f"no such branch: {branch}")
        let current: str = self.current_branch()
        if branch == current:
            die(f"'{branch}' is already the current branch")

        if not force and self.git(["diff", "--quiet", "HEAD", "--", self.base]) != 0:
            if not confirm(f"{self.name} has uncommitted changes; discard them?"):
                die("aborted")

        if self.git(["reset", "--hard", branch]) != 0:
            die(f"could not move {current} to {branch}")
        print f"{current} now holds {branch}"

        if prune == "no": return
        let others: []str = self.losing_branches(current, branch)
        if others'Length == 0: return
        var doit: bool = prune == "yes"
        if prune == "ask":
            doit = confirm(f"Delete the branches that lost ({', '.join(others)})?")
        if doit:
            var cmd: []str = ["branch", "-D"]
            for name in others:
                cmd.append(name)
            let pruned: int = self.git(cmd)
            if pruned != 0:
                warn(f"could not delete every losing branch (git exited {pruned})")

    def move_to(self, new: str):
        """Rename this file and its repo. Two targets, so two objects."""
        self.require()
        if -e new: die(f"target exists: {new}")
        var nt: Target = Target(new)
        if not -d nt.dir: die(f"no such directory: {nt.dir}")
        let new_repo: Path = nt.repo
        if -e new_repo: die(f"already tracked: {new}")

        shell: mv -- {!self.name} {!new}
        shell: mkdir -p -- {!nt.dir / CONTAINER}
        shell: mv -- {!self.repo} {!new_repo}
        nt.write_exclude(new_repo)
        # The statuses are kept rather than dropped: a rename whose commit
        # fails leaves the repo moved but the history not recording it, which
        # is worth a word. (Nim also needs a value-returning call used as a
        # statement to be discarded, and only does that automatically outside
        # a method body -- see TODO.md.)
        var rc: int = nt.git(["rm", "--quiet", "--cached", "--ignore-unmatch", "--", self.base])
        rc = nt.git(["add", "--", nt.base])
        rc = nt.git(["commit", "--quiet", "-m", f"rename {self.base} -> {nt.base}"])
        if rc != 0:
            warn(f"renamed, but recording it failed (git exited {rc})")

# --- a directory of them ---------------------------------------------------

class RepoDir:
    """The .git1 directory in one place, and the repos inside it.

    Named RepoDir rather than Container because Nim identifiers ignore case
    and underscores, so `Container` and the `CONTAINER` const above are the
    same name there -- a collision the Python backend does not have.

    `ls` and `each` are its methods rather than a Target's: they are asked
    about a *directory*, and only then find the files it tracks.
    """
    dir:  Path   # the directory that holds the container
    path: Path   # the container itself

    def __init__(self, d: str):
        self.dir  = Path(d)
        self.path = self.dir / CONTAINER

    def is_repo(self, entry: str) -> bool:
        """True when entry is one of our per-file repos.

        A repo is named after its file, so it is recognised by content
        rather than by name: "." and ".." are skipped, and anything else in
        the container without a HEAD is not one of ours.
        """
        if entry'Length == 0 or entry == "." or entry == "..": return False
        let gitdir: Path = self.path / entry
        if not -d gitdir: return False
        # Parenthesised: a file test takes a primary, so the join has to be one.
        -f (gitdir / "HEAD")

    def names(self) -> []str:
        """The tracked file names here, in order."""
        if not -d self.path: return []
        let entries = shellLines: ls -1a {!self.path}
        [name for name in sorted(entries) if self.is_repo(name)]

    def ls(self):
        """List the tracked files here, newest commit first-hand."""
        var found: int = 0
        for name in self.names():
            found = 1
            let gitdir: Path = self.path / name
            let file: Path = self.dir / name
            var status: str = ""
            if not -e file: status = " [file missing]"
            # `env` rather than `GIT_DIR=...` in the command: the value
            # crosses into the child's environment, which the language hands
            # over without the shell parsing it. The capturing form keeps
            # stderr in r.stderr, so there is nothing for a 2>/dev/null to
            # suppress either.
            let one_env: {str}str = {"GIT_DIR": str(gitdir)}
            let r = shell(env = one_env): git log -1 --format='%cr'
            var when: str = ""
            if r.output.strip()'Length > 0:
                when = f"  (last commit {r.output.strip()})"
            print f"{name}{when}{status}"
        if found == 0:
            warn("no tracked files here")

    def each(self, args: []str):
        """Run one git command in every repo here."""
        for name in self.names():
            print f"=== {name} ==="
            var t: Target = Target(name)
            let rc: int = t.git(args)
            if rc != 0:
                warn(f"'{name}': git exited {rc}")

def usage() -> str:
    f"""{PROG} {VERSION} - independent version control for single files

Each tracked file gets a private git repo named "{CONTAINER}/<file>",
grouped under a single "{CONTAINER}" directory. Many tracked files can coexist
in one directory without seeing each other.

  {PROG} init <file>            start tracking <file>
  {PROG} <file> [git args...]   run git in that file's repo (default: status)
  {PROG} ls [dir]               list tracked files in a directory
  {PROG} mv <old> <new>         rename a tracked file and its repo
  {PROG} rm [-f] <file>         delete a file's history (keeps the file)
  {PROG} adopt <file> <branch>  make <branch> the current branch, wholesale
  {PROG} each <git args...>     run one git command in every repo here
  {PROG} help                   this text

Examples:

  {PROG} init notes.txt
  {PROG} notes.txt diff
  {PROG} notes.txt commit -am "reworked the intro"
  {PROG} notes.txt log --oneline
  {PROG} sub/config.yml status
  {PROG} notes.txt checkout -b bolder
  {PROG} adopt notes.txt bolder
  {PROG} each log -1 --oneline

Notes:

  * Anything after the file name is passed to git untouched, so the full
    command set is available: log, diff, stash, tag, blame, rebase, push...
  * Paths in those arguments are read relative to the tracked file's own
    directory, which is the work tree.
  * The repo ignores every path except its own file, so "commit -a" and
    "status" stay clean no matter what else is in the directory.
  * To track a file whose name collides with a subcommand, use "--":
      {PROG} -- ls log
  * "adopt" is for trying an idea on a branch and keeping the winner: it
    moves the current branch onto <branch>, discarding what the current one
    held (recoverable through "reflog"), and offers to delete the branches
    that lost. Nothing is combined, so nothing can conflict. Use "-f" to
    skip the prompt about uncommitted changes, "--prune"/"--no-prune" to
    settle the losing branches without being asked.
  * If the directory is itself inside an ordinary git repo, add "{CONTAINER}"
    to its .gitignore.

Tip: for a long session on one file, alias it:  alias gg='{PROG} notes.txt'"""

def cmd_rm(argv: []str):
    """Parse `rm [-f] <file>` and hand the work to the Target."""
    var args: []str = argv
    var force: bool = False
    if args'Length > 0 and args[0] == "-f":
        force = True
        args = args[1:]
    if args'Length < 1: die(f"usage: {PROG} rm [-f] <file>")
    var t: Target = Target(args[0])
    t.rm(force)

def cmd_adopt(argv: []str):
    """Parse `adopt [-f] [--prune|--no-prune] <file> <branch>`."""
    var args: []str = argv
    var force: bool = False
    var prune: str = "ask"
    while args'Length > 0 and args[0].startswith("-"):
        if args[0] == "-f":
            force = True
        elif args[0] == "--prune":
            prune = "yes"
        elif args[0] == "--no-prune":
            prune = "no"
        else:
            die(f"unknown option: {args[0]}")
        args = args[1:]
    if args'Length != 2:
        die(f"usage: {PROG} adopt [-f] [--prune|--no-prune] <file> <branch>")
    var t: Target = Target(args[0])
    t.adopt(args[1], force, prune)

def cmd_help():
    let pager: str = $PAGER if $PAGER else "less"
    # have() asks PATH directly; `command -v` cost a shell and a process to
    # answer the same question, and made the caller know that 127 means no.
    let is_tty: int = shell: test -t 1
    if is_tty == 0 and have(pager):
        let tmp: str = "/tmp/git1-help.txt"
        writeFile(tmp, usage() + "\n")
        let shown: int = shell: {!pager} {!tmp}
        if shown != 0: warn("pager failed")
        shell: rm -f -- {!tmp}
    else:
        print usage()

# --- dispatch ---------------------------------------------------------------

def cmd_init(argv: []str):
    """`init <file>`"""
    if argv'Length < 1: die(f"usage: {PROG} init <file>")
    var t: Target = Target(argv[0])
    t.track()

def cmd_ls(argv: []str):
    """`ls [dir]` — the directory defaults to here."""
    let where: str = argv[0] if argv'Length >= 1 else "."
    var rd: RepoDir = RepoDir(where)
    rd.ls()

def cmd_mv(argv: []str):
    """`mv <old> <new>`"""
    if argv'Length != 2: die(f"usage: {PROG} mv <old> <new>")
    var t: Target = Target(argv[0])
    t.move_to(argv[1])

def cmd_each(argv: []str):
    """`each <git args...>` — in every repo here."""
    if argv'Length == 0: die(f"usage: {PROG} each <git command> [args...]")
    var here: RepoDir = RepoDir(".")
    here.each(argv)

# --- dispatch ---------------------------------------------------------------
#
# One question decides everything: is the first word a subcommand or a file
# name?  It is usually a file name -- `git1 notes.txt log` -- so an
# unrecognised word is not an error, it is the common case.

def run_subcommand(argv: []str) -> bool:
    """Run argv as a subcommand. False when the first word is not one.

    Every branch returns True; `when others` returns False, which is what
    sends main() on to treat the word as a file name.
    """
    let rest: []str = argv[1:]
    case argv[0]:
        when "init":      cmd_init(rest);  return True
        when "ls":        cmd_ls(rest);    return True
        when "rm":        cmd_rm(rest);    return True
        when "mv":        cmd_mv(rest);    return True
        when "adopt":     cmd_adopt(rest); return True
        when "each":      cmd_each(rest);  return True
        when "help" | "-h" | "--help": cmd_help(); return True
        when "--version": print f"{PROG} {VERSION}"; return True
        when others:      return False

def run_on_file(argv: []str):
    """argv[0] is a tracked file; everything after it is for git.

    Does not return: git1 becomes git, so the exit status is git's own.
    """
    var t: Target = Target(argv[0])
    t.require()
    var args: []str = argv[1:]
    if args'Length == 0:
        args = ["status", "--short", "--branch"]
    t.git_exec(args)

def main():
    if $# == 0:
        stderr.writeLine(usage())
        quit(2)                      # 2 = invoked wrongly; die() uses 1

    let argv: []str = $@

    # "--" means: no subcommand here, the next word is a file name. It is how
    # you reach a file that happens to be called "ls" or "--version".
    if argv[0] == "--":
        if argv'Length < 2: die("expected a file name after --")
        run_on_file(argv[1:])
        return

    if run_subcommand(argv): return

    run_on_file(argv)

main()
