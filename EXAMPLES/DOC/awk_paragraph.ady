#!/usr/bin/env ady2nim
"""A record that is not a line: RS says where one ends.

The §2.1 example from DOCS/ADASCRIPT_FOR_AWK.md. `rs = "\n\n"` is awk's
paragraph mode -- a blank line ends a record -- and nothing else in the
program changes: process_record() still gets one record at a time and
still does not know how the input was cut up.
"""
from awk import StdinProcessor, AwkRecord_T, AwkFailure_T

class Para(StdinProcessor):
    def process_record(self, rec: AwkRecord_T):
        print f"record {rec.NR}: NF={rec.NF} [{rec.line}]"

def main():
    var p: Para = Para(rs = "\n\n")      # a blank line ends a record
    let done: None | !AwkFailure_T = p.run()
    if done is AwkFailure_T:
        die(done.reason)

main()
