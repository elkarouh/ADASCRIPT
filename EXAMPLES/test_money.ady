#!/usr/bin/env ady2nim
# test_money.ady — money as units: prices, tax, and a currency conversion
#
#   ady2nim EXAMPLES/test_money.ady -r
#   ady2py  EXAMPLES/test_money.ady -c
#
# The commonest use of `distinct`: an amount of money is not a number. A
# Dollar_T cannot be added to a Euro_T, cannot be squared, and cannot be
# passed where a price in euros is wanted -- but it can be scaled by a
# quantity, a tax rate or a discount, which are plain numbers.
#
# An exchange rate is a unit of its own: euros per dollar. Declaring it as
# one, `type Rate_T is Euro_T / Dollar_T`, is what makes the conversion
# routines type-check -- a dollar amount times the rate is euros, a euro
# amount over the rate is dollars -- and the wrong way round is refused.
#
# Amounts are printed with `:.2f`, as money is: the two backends print a
# float's full digits differently, and no one wants them.
#
# Run on both backends and the outputs compared. What is refused is in the
# comments here, and the Makefile checks it.

type Dollar_T is distinct float
type Euro_T   is distinct float
type Rate_T   is Euro_T / Dollar_T        # euros per dollar

type Line_T is record:
    item:  str      = ""
    price: Dollar_T = 0.0
    qty:   int      = 0

# --- an order: quantity, tax, discount ---------------------------------------
def line_total(line: Line_T) -> Dollar_T:
    return line.price * line.qty                # a count scales a price

def subtotal(lines: []Line_T) -> Dollar_T:
    var acc: Dollar_T = 0.0
    for line in lines:
        acc += line_total(line)
    return acc

def discounted(price: Dollar_T, percent_off: float) -> Dollar_T:
    return price * (1.0 - percent_off / 100.0)   # a plain factor scales it

let cart: []Line_T = [
    Line_T(item="notebook", price=4.50,  qty=3),
    Line_T(item="pen",      price=1.25,  qty=12),
    Line_T(item="bag",      price=32.00, qty=1),
]

let sub: Dollar_T = subtotal(cart)
let tax_rate: float = 0.08
let tax: Dollar_T = sub * tax_rate
let total: Dollar_T = sub + tax
print f"subtotal {sub:.2f}"                      # 60.50
print f"tax      {tax:.2f}"                      # 4.84
print f"total    {total:.2f}"                    # 65.34
print f"sale     {discounted(total, 10.0):.2f}"  # 58.81

let budget: Dollar_T = 70.0
assert total < budget and not (total > budget)
assert total > 65.0                              # a literal beside a Dollar_T
print f"left     {budget - total:.2f}"           # 4.66

# --- what the types refuse (checked by the Makefile) -------------------------
#   let bad: Dollar_T = total + to_euro(total, rate)   dollars plus euros
#   let sq:  Dollar_T = total * total            dollars squared
#   let two: Dollar_T = total * sub              ...and dollars times dollars
#   let fee: Dollar_T = tax_rate                 a plain number is not money

# --- converting between currencies ------------------------------------------
def to_euro(amount: Dollar_T, rate: Rate_T) -> Euro_T:
    return amount * rate                        # Dollar x (Euro / Dollar) is Euro

def to_dollar(amount: Euro_T, rate: Rate_T) -> Dollar_T:
    return amount / rate                        # Euro / (Euro / Dollar) is Dollar

def convert_all(amounts: []Dollar_T, rate: Rate_T) -> []Euro_T:
    return [to_euro(a, rate) for a in amounts]

let rate: Rate_T = 0.92
print f"{to_euro(total, rate):.2f} EUR"          # 60.11
let back: Dollar_T = to_dollar(to_euro(total, rate), rate)
print f"{back:.2f} USD"                          # 65.34: and back again

for line in cart:
    let usd: Dollar_T = line_total(line)
    print f"{line.item:<10} {usd:>7.2f} USD {to_euro(usd, rate):>7.2f} EUR"

let prices: []Dollar_T = [10.0, 20.0, 30.0]
var in_euros: Euro_T = 0.0
for e in convert_all(prices, rate):
    in_euros += e
print f"{in_euros:.2f} EUR"                      # 55.20

# The rate is a value like any other: today's, and a better one tomorrow.
let better: Rate_T = rate * 1.05                 # a rate scaled by a number
print f"{to_euro(100.0, better):.2f} EUR"        # 96.60
print f"{better / rate:.2f}"                     # 1.05: two rates are a ratio
print "test_money: ok"
