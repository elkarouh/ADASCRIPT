#!/usr/bin/env py2nim
# c500.ady — Single-pass C→WebAssembly compiler in Adascript
# Port of https://github.com/vgel/c500 by Theia Vogel
# Original blog post: https://vgel.me/posts/c500/


const PAGE_SIZE : int = 65536


def parse_c_char(tok: str) -> str:
    """Parse a C char literal like 'a' or '\n' → single character string."""
    inner: str = tok[1:-1]
    if len(inner) == 0:
        "\0"
    elif not inner.startswith("\\"):
        inner[0:1]
    elif len(inner) < 2:
        inner[0:1]
    else:
        c: str = inner[1:2]
        case c:
            when "n":  "\n"
            when "t":  "\t"
            when "r":  "\r"
            when "0":  "\0"
            when "\\": "\\"
            when "'":  "'"
            when others: c


def parse_c_str(tok: str) -> str:
    """Parse a C string literal like "hello\n" → plain string (without surrounding quotes)."""
    inner: str = tok[1:-1]
    result: str = ""
    i: int = 0
    while i < len(inner):
        if inner[i:i+1] != "\\" or i + 1 >= len(inner):
            result = result + inner[i:i+1]
            i = i + 1
        else:
            c: str = inner[i+1:i+2]
            case c:
                when "n":
                    result = result + "\n"
                    i = i + 2
                when "t":
                    result = result + "\t"
                    i = i + 2
                when "r":
                    result = result + "\r"
                    i = i + 2
                when "0":
                    result = result + "\0"
                    i = i + 2
                when "\\":
                    result = result + "\\"
                    i = i + 2
                when "\"":
                    result = result + '"'
                    i = i + 2
                when others:
                    result = result + inner[i:i+1]
                    i = i + 1


def die(message: str, line: ?int = None) -> None:
    location: str = ""
    if line is not None:
        location = f" on line {line + 1}"
    print(f"error{location}: {message}")
    quit(1)


# ---------------------------------------------------------------------------
# Emitter: writes indented WebAssembly text to stdout.
# ---------------------------------------------------------------------------

class Emitter:
    indent_level: int
    emit_disabled: bool

    def __init__(self):
        self.indent_level  = 0
        self.emit_disabled = False

    def __call__(self, code: str) -> None:
        if not self.emit_disabled:
            print(" " * self.indent_level + code)

    @contextmanager
    def emit_block(self, start: str, close: str):
        self(start)
        self.indent_level += 2
        yield
        self.indent_level -= 2
        self(close)

    @contextmanager
    def no_emit(self):
        self.emit_disabled = True
        try:
            yield
        finally:
            self.emit_disabled = False


emit: Emitter = Emitter()


# ---------------------------------------------------------------------------
# StringPool: deduplicated pool of C string literals, placed above PAGE_SIZE.
# ---------------------------------------------------------------------------

class StringPool:
    base: int
    current: int
    strs: {str}int

    def __init__(self):
        self.base    = PAGE_SIZE
        self.current = PAGE_SIZE
        self.strs    = {:}

    def add(self, s: str) -> int:
        s = s + "\0"
        if s not in self.strs:
            self.strs[s] = self.current
            self.current += len(s)
            if self.current - self.base > PAGE_SIZE:
                die("string pool too large")
        return self.strs[s]

    def pooled(self) -> str:
        HEX: str = "0123456789abcdef"
        result: str = ""
        for b in keys(self.strs):
            i: int = 0
            while i < len(b):
                n: int = ord(b[i])
                if 31 < n < 127 and n != 92 and n != 34:
                    result = result + b[i:i+1]
                else:
                    h1: str = HEX[n // 16:n // 16 + 1]
                    h2: str = HEX[n % 16:n % 16 + 1]
                    result = result + "\\" + h1 + h2
                i = i + 1
        return result


str_pool: StringPool = StringPool()


# ---------------------------------------------------------------------------
# Token kinds — fully enumerated; content holds the actual source text.
# ---------------------------------------------------------------------------

type TokKind_T is enum \
    TK_INVALID, TK_EOF, \
    TK_TYPE, TK_NAME, TK_INTCONST, TK_CHARCONST, TK_STRCONST, \
    TK_TYPEDEF, TK_IF, TK_ELSE, TK_WHILE, TK_DO, TK_FOR, TK_RETURN, \
    TK_PLUSPLUS, TK_MINUSMINUS, TK_LSHIFT, TK_RSHIFT, \
    TK_AND, TK_OR, TK_EQEQ, TK_LE, TK_GE, TK_NE, \
    TK_LT, TK_GT, TK_LPAREN, TK_RPAREN, \
    TK_LBRACE, TK_RBRACE, TK_LBRACKET, TK_RBRACKET, \
    TK_SEMI, TK_EQ, TK_PLUS, TK_MINUS, TK_STAR, TK_SLASH, \
    TK_PERCENT, TK_AMP, TK_PIPE, TK_CARET, TK_COMMA, TK_BANG, TK_TILDE


const LITERAL_TOKENS : []str = (
    "typedef if else while do for return "
    "++ -- << >> && || == <= >= != "
    "< > ( ) { } [ ] ; = + - * / % & | ^ , ! ~"
).split()

const STR_TO_KIND : {str}TokKind_T = {
    "typedef": TK_TYPEDEF, "if": TK_IF, "else": TK_ELSE,
    "while": TK_WHILE,  "do": TK_DO,  "for": TK_FOR, "return": TK_RETURN,
    "++": TK_PLUSPLUS, "--": TK_MINUSMINUS,
    "<<": TK_LSHIFT,   ">>": TK_RSHIFT,
    "&&": TK_AND,      "||": TK_OR,
    "==": TK_EQEQ,     "<=": TK_LE,  ">=": TK_GE,  "!=": TK_NE,
    "<":  TK_LT,       ">":  TK_GT,
    "(":  TK_LPAREN,   ")":  TK_RPAREN,
    "{":  TK_LBRACE,   "}":  TK_RBRACE,
    "[":  TK_LBRACKET, "]":  TK_RBRACKET,
    ";":  TK_SEMI,     "=":  TK_EQ,
    "+":  TK_PLUS,     "-":  TK_MINUS,
    "*":  TK_STAR,     "/":  TK_SLASH,
    "%":  TK_PERCENT,  "&":  TK_AMP,
    "|":  TK_PIPE,     "^":  TK_CARET,
    ",":  TK_COMMA,    "!":  TK_BANG,  "~": TK_TILDE,
}


type Token_T is record:
    kind:    TokKind_T
    content: str
    line:    int


# ---------------------------------------------------------------------------
# Lexer: hand-rolled tokeniser with a clone() trick for for-loop advancement.
# ---------------------------------------------------------------------------

class Lexer:
    src: str
    loc: int
    line: int
    types: {}str
    lookahead_ref: ?Lexer

    def __init__(self, src: str, types: {}str, loc: int = 0, line: int = 0):
        self.src   = src
        self.loc   = loc
        self.line  = line
        self.types = types

    def clone(self) -> Lexer:
        return Lexer(self.src, self.types, self.loc, self.line)

    def _skip_comment_ws(self) -> bool:
        if self.src[self.loc:].startswith("//"):
            while self.loc < len(self.src) and self.src[self.loc:self.loc+1] != "\n":
                self.loc += 1
            return True
        elif self.src[self.loc:].startswith("/*"):
            var start_line: int = self.line
            self.loc += 2
            while not self.src[self.loc:].startswith("*/"):
                if self.loc >= len(self.src):
                    die("unterminated multi-line comment", start_line)
                elif self.src[self.loc:self.loc+1] == "\n":
                    self.line += 1
                self.loc += 1
            self.loc += 2
            return True
        elif self.src[self.loc:self.loc+1] in " \t\n":
            if self.src[self.loc:self.loc+1] == "\n":
                self.line += 1
            self.loc += 1
            return True
        return False

    def peek(self) -> Token_T:
        while self.loc < len(self.src) and self._skip_comment_ws():
            pass
        if self.loc >= len(self.src):
            return Token_T(kind=TK_EOF, content="", line=self.line)
        if self.src[self.loc:] == /^[a-zA-Z_][a-zA-Z0-9_]*/:
            tok: str = $+0
            if tok in LITERAL_TOKENS:
                return Token_T(kind=STR_TO_KIND[tok], content=tok, line=self.line)
            kind: TokKind_T = TK_TYPE if tok in self.types else TK_NAME
            return Token_T(kind=kind, content=tok, line=self.line)
        if self.src[self.loc:] == /^[0-9]+/:
            tok: str = $+0
            return Token_T(kind=TK_INTCONST, content=tok, line=self.line)
        if self.src[self.loc:] == /^'([^'\\]|(\\([\\abfnrtv'"?]|[0-7]{1,3}|x[A-Fa-f0-9]{1,2})))'/:
            tok: str = $+0
            return Token_T(kind=TK_CHARCONST, content=tok, line=self.line)
        if self.src[self.loc:] == /^"([^"\\]|(\\([\\abfnrtv'"?]|[0-7]{1,3}|x[A-Fa-f0-9]{1,2})))*?(?<!\\)"/:
            tok: str = $+0
            return Token_T(kind=TK_STRCONST, content=tok, line=self.line)
        for token_str in LITERAL_TOKENS:
            if self.src[self.loc:].startswith(token_str):
                return Token_T(kind=STR_TO_KIND[token_str], content=token_str, line=self.line)
        return Token_T(kind=TK_INVALID, content=self.src[self.loc:self.loc + 10], line=self.line)

    def next(self, kind: ?TokKind_T = None) -> Token_T:
        token: Token_T = self.peek()
        if kind is not None:
            if token.kind != kind:
                msg: str = f"expected {kind}, got {token.content}"
                die(msg, self.line)
        if token.kind != TK_INVALID:
            self.loc += len(token.content)
        return token

    def try_next(self, kind: TokKind_T) -> ?Token_T:
        if self.peek().kind == kind:
            return self.next()
        return None


# ---------------------------------------------------------------------------
# CType_T: represents a C type (base name, pointer level, optional array size).
# load_ins / store_ins use case/when to select the WebAssembly memory instruction.
# ---------------------------------------------------------------------------

class CType_T:
    typename: str
    pointer_level: int
    array_size: ?int
    decl_line: ?int
    wasmtype: str

    def __init__(self, typename: str, pointer_level: int = 0,
                 array_size: ?int = None, decl_line: ?int = None):
        if typename not in ("char", "int"):
            msg: str = f"unknown type: {typename}"
            die(msg, decl_line)
        self.typename      = typename
        self.pointer_level = pointer_level
        self.array_size    = array_size
        self.decl_line     = decl_line
        self.wasmtype      = "i32"

    def sizeof(self) -> int:
        if self.typename == "char" and not self.is_ptr():
            return 1 * (self.array_size or 1)
        return 4 * (self.array_size or 1)

    def is_ptr(self) -> bool:
        return self.pointer_level > 0

    def is_arr(self) -> bool:
        return self.array_size is not None

    def less_ptr(self) -> CType_T:
        assert self.is_ptr(), f"bug: not a pointer: {self}"
        return CType_T(self.typename, self.pointer_level - 1, self.array_size)

    def more_ptr(self) -> CType_T:
        return CType_T(self.typename, self.pointer_level + 1, self.array_size)

    def as_non_array(self) -> CType_T:
        assert self.is_arr(), f"bug: not an array: {self}"
        return CType_T(self.typename, self.pointer_level, None)

    def _mem_ins_size(self) -> int:
        return self.as_non_array().sizeof() if self.is_arr() else self.sizeof()

    def load_ins(self) -> str:
        case self._mem_ins_size():
            when 1: return "i32.load8_s"
            when 2: return "i32.load16_s"
            when 4: return "i32.load"
            when others: return ""

    def store_ins(self) -> str:
        case self._mem_ins_size():
            when 1: return "i32.store8"
            when 2: return "i32.store16"
            when 4: return "i32.store"
            when others: return ""

    def __str__(self) -> str:
        arr: str = f"[{self.array_size}]" if self.array_size is not None else ""
        return f"{self.typename}{'*' * self.pointer_level}{arr}"


typedefs: {str}CType_T = {:}


def parse_type_and_name(lexer: Lexer, prev_t: ?str = None) -> (CType_T, Token_T):
    t: str = prev_t or lexer.next(TK_TYPE).content
    ctype: CType_T
    if t in typedefs:
        base: CType_T = typedefs[t]
        ctype = CType_T(base.typename, base.pointer_level, base.array_size, lexer.line)
    else:
        ctype = CType_T(t, 0, None, lexer.line)
    while lexer.try_next(TK_STAR):
        ctype.pointer_level += 1
    varname: Token_T = lexer.next(TK_NAME)
    if lexer.try_next(TK_LBRACKET):
        ctype.array_size = int(lexer.next(TK_INTCONST).content)
        lexer.next(TK_RBRACKET)
    return ctype, varname


# ---------------------------------------------------------------------------
# Stack frame: tracks C variables and their byte offsets on the wasm stack.
# ---------------------------------------------------------------------------

type FrameVar_T is record:
    name:         str
    ctype:        CType_T
    local_offset: int
    is_parameter: bool


class StackFrame:
    variables: {str}FrameVar_T
    frame_size: int
    frame_offset: int
    parent: ?StackFrame

    def __init__(self, parent: ?StackFrame = None):
        self.parent = parent
        self.variables    = {:}
        self.frame_size   = 0
        self.frame_offset = (parent.frame_offset + parent.frame_size) if parent else 0

    def add_var(self, name: str, ctype: CType_T, is_parameter: bool = False) -> None:
        self.variables[name] = FrameVar_T(
            name=name, ctype=ctype,
            local_offset=self.frame_size,
            is_parameter=is_parameter,
        )
        self.frame_size += ctype.sizeof()

    def get_var_and_offset(self, name: str) -> (FrameVar_T, int):
        if name in self.variables:
            slot: FrameVar_T = self.variables[name]
            return slot, self.frame_offset + slot.local_offset
        elif self.parent is not None:
            return self.parent.get_var_and_offset(name)
        else:
            msg: str = f"unknown variable {name}"
            die(msg, None)
            raise RuntimeError("unreachable")


def emit_return(frame: StackFrame) -> None:
    emit("global.get $__stack_pointer ;; fixup stack pointer before return")
    emit(f"i32.const {frame.frame_size}")
    emit("i32.add")
    emit("global.set $__stack_pointer")
    emit("return")


# ---------------------------------------------------------------------------
# ExprMeta_T: metadata returned after generating code for an expression.
# is_place=True  → stack holds an address (can be assigned to or loaded from)
# is_place=False → stack holds a bare value
# ---------------------------------------------------------------------------

type ExprMeta_T is record:
    is_place: bool
    ctype:    CType_T


def load_result(em: ExprMeta_T) -> ExprMeta_T:
    if em.is_place:
        emit(em.ctype.load_ins())
    return ExprMeta_T(is_place=False, ctype=em.ctype)


def mask_to_sizeof(t: CType_T) -> None:
    if not (t.is_arr() or t.sizeof() == 4):
        mask: int = (1 << (8 * t.sizeof() - 1)) - 1
        emit(f"i32.const {mask}")
        emit("i32.and")


# ---------------------------------------------------------------------------
# expression(): full C expression parser with manual operator precedence.
# ---------------------------------------------------------------------------

def expression(lexer: Lexer, frame: StackFrame) -> ExprMeta_T:

    def value() -> ExprMeta_T:
        case lexer.peek().kind:
            when TK_INTCONST:
                tok: Token_T = lexer.next()
                emit(f"i32.const {tok.content}")
                return ExprMeta_T(is_place=False, ctype=CType_T("int"))
            when TK_CHARCONST:
                tok: Token_T = lexer.next()
                emit(f"i32.const {ord(parse_c_char(tok.content)[0])}")
                return ExprMeta_T(is_place=False, ctype=CType_T("int"))
            when TK_STRCONST:
                tok: Token_T = lexer.next()
                var s: str = parse_c_str(tok.content)
                while nxt := lexer.try_next(TK_STRCONST):
                    s = s + parse_c_str(nxt.content)
                emit(f"i32.const {str_pool.add(s)}")
                return ExprMeta_T(is_place=False, ctype=CType_T("char", pointer_level=1))
            when TK_LPAREN:
                lexer.next()
                meta: ExprMeta_T = expression(lexer, frame)
                lexer.next(TK_RPAREN)
                return meta
            when others:
                varname: Token_T = lexer.next(TK_NAME)
                if lexer.try_next(TK_LPAREN):
                    if lexer.peek().kind != TK_RPAREN:
                        while True:
                            load_result(expression(lexer, frame))
                            if not lexer.try_next(TK_COMMA):
                                break
                    lexer.next(TK_RPAREN)
                    emit(f"call ${varname.content}")
                    return ExprMeta_T(is_place=False, ctype=CType_T("int"))
                else:
                    var_slot, offset = frame.get_var_and_offset(varname.content)
                    emit(f"global.get $__stack_pointer ;; load {varname.content}")
                    emit(f"i32.const {offset}")
                    emit("i32.add")
                    return ExprMeta_T(is_place=True, ctype=var_slot.ctype)

    def accessor() -> ExprMeta_T:
        lhs: ExprMeta_T = value()
        if lexer.try_next(TK_LBRACKET):
            lhs = load_result(lhs)
            l_type: CType_T = lhs.ctype
            if not (l_type.is_arr() or l_type.is_ptr()):
                msg: str = f"not an array or pointer: {lhs.ctype}"
                die(msg, lexer.line)
            el_type: CType_T = l_type.as_non_array() if l_type.is_arr() else l_type.less_ptr()
            load_result(expression(lexer, frame))
            lexer.next(TK_RBRACKET)
            emit(f"i32.const {el_type.sizeof()}")
            emit("i32.mul")
            emit("i32.add")
            return ExprMeta_T(is_place=True, ctype=el_type)
        return lhs

    def prefix() -> ExprMeta_T:
        case lexer.peek().kind:
            when TK_AMP:
                lexer.next()
                meta: ExprMeta_T = prefix()
                if not meta.is_place:
                    die("cannot take reference to value", lexer.line)
                return ExprMeta_T(is_place=False, ctype=meta.ctype.more_ptr())
            when TK_STAR:
                lexer.next()
                meta: ExprMeta_T = load_result(prefix())
                if not meta.ctype.is_ptr():
                    die("cannot dereference non-pointer", lexer.line)
                return ExprMeta_T(is_place=True, ctype=meta.ctype.less_ptr())
            when TK_MINUS:
                lexer.next()
                emit("i32.const 0")
                meta: ExprMeta_T = load_result(prefix())
                emit("i32.sub")
                mask_to_sizeof(meta.ctype)
                return meta
            when TK_PLUS:
                lexer.next()
                return load_result(prefix())
            when TK_BANG:
                lexer.next()
                meta: ExprMeta_T = load_result(prefix())
                emit("i32.eqz")
                return meta
            when TK_TILDE:
                lexer.next()
                meta: ExprMeta_T = load_result(prefix())
                emit("i32.const 0xffffffff")
                emit("i32.xor")
                mask_to_sizeof(meta.ctype)
                return meta
            when others:
                return accessor()

    def makeop(
        higher: [(,)]ExprMeta_T,
        ops:    {TokKind_T}str,
        rtype:  ?CType_T = None,
    ) -> [(,)]ExprMeta_T:
        def op() -> ExprMeta_T:
            lhs: ExprMeta_T = higher()
            if lexer.peek().kind in ops:
                lhs = load_result(lhs)
                op_tok: Token_T = lexer.next()
                load_result(op())
                emit(ops[op_tok.kind])
                mask_to_sizeof(rtype or lhs.ctype)
                return ExprMeta_T(is_place=False, ctype=lhs.ctype)
            return lhs
        return op

    muldiv: [(,)]ExprMeta_T = makeop(
        prefix, {TK_STAR: "i32.mul", TK_SLASH: "i32.div_s", TK_PERCENT: "i32.rem_s"}
    )

    def plusminus() -> ExprMeta_T:
        lhs: ExprMeta_T = muldiv()
        if lexer.peek().kind not in (TK_PLUS, TK_MINUS):
            return lhs
        lhs = load_result(lhs)
        op_tok: Token_T  = lexer.next()
        rhs: ExprMeta_T  = load_result(plusminus())
        lhs_t: CType_T   = lhs.ctype
        rhs_t: CType_T   = rhs.ctype
        var res_t: CType_T = lhs.ctype
        if lhs.ctype.pointer_level == rhs.ctype.pointer_level:
            pass
        elif lhs.ctype.is_ptr() and rhs.ctype.is_ptr():
            die(f"cannot {op_tok.content} {lhs.ctype} and {rhs.ctype}")
        elif lhs.ctype.is_ptr() and not rhs.ctype.is_ptr():
            emit(f"i32.const {lhs.ctype.less_ptr().sizeof()}")
            emit("i32.mul")
        elif not lhs.ctype.is_ptr() and rhs.ctype.is_ptr():
            res_t = rhs.ctype
            emit("call $__swap_i32")
            emit(f"i32.const {rhs.ctype.less_ptr().sizeof()}")
            emit("i32.mul")
            emit("call $__swap_i32")
        emit("i32.add" if op_tok.kind == TK_PLUS else "i32.sub")
        if op_tok.kind == TK_MINUS and lhs_t.is_ptr() and rhs_t.is_ptr():
            emit(f"i32.const {rhs.ctype.less_ptr().sizeof()}")
            emit("i32.div_s")
            res_t = CType_T("int")
        mask_to_sizeof(res_t)
        return ExprMeta_T(is_place=False, ctype=res_t)

    shlr:   [(,)]ExprMeta_T = makeop(plusminus, {TK_LSHIFT: "i32.shl", TK_RSHIFT: "i32.shr_s"})
    cmplg:  [(,)]ExprMeta_T = makeop(
        shlr, {TK_LT: "i32.lt_s", TK_GT: "i32.gt_s", TK_LE: "i32.le_s", TK_GE: "i32.ge_s"},
        CType_T("int"),
    )
    cmpe:   [(,)]ExprMeta_T = makeop(cmplg, {TK_EQEQ: "i32.eq", TK_NE: "i32.ne"}, CType_T("int"))
    bitand: [(,)]ExprMeta_T = makeop(cmpe,   {TK_AMP: "i32.and"})
    bitor:  [(,)]ExprMeta_T = makeop(bitand, {TK_PIPE: "i32.or"})
    bitxor: [(,)]ExprMeta_T = makeop(bitor,  {TK_CARET: "i32.xor"})

    def assign() -> ExprMeta_T:
        lhs: ExprMeta_T = bitxor()
        if lexer.try_next(TK_EQ):
            if not lhs.is_place:
                die("lhs of assignment cannot be value", lexer.line)
            emit("call $__dup_i32")
            rhs: ExprMeta_T = load_result(assign())
            emit(lhs.ctype.store_ins())
            emit(lhs.ctype.load_ins())
            return rhs
        return lhs

    return assign()


# ---------------------------------------------------------------------------
# statement(): C statement parser.
# ---------------------------------------------------------------------------

def statement(lexer: Lexer, frame: StackFrame) -> None:

    def parenthesized_test() -> None:
        lexer.next(TK_LPAREN)
        load_result(expression(lexer, frame))
        lexer.next(TK_RPAREN)
        emit("i32.eqz")

    def block_or_stmt() -> None:
        if lexer.try_next(TK_LBRACE):
            while not lexer.try_next(TK_RBRACE):
                statement(lexer, frame)
        else:
            statement(lexer, frame)

    case lexer.peek().kind:
        when TK_RETURN:
            lexer.next()
            if lexer.peek().kind != TK_SEMI:
                load_result(expression(lexer, frame))
            lexer.next(TK_SEMI)
            emit_return(frame)

        when TK_IF:
            lexer.next()
            # block / block pattern avoids needing a dedicated else-block label:
            # br_if 0 jumps past the then-body into the else; br 1 exits both.
            with emit.emit_block("block ;; if", "end"):
                with emit.emit_block("block", "end"):
                    parenthesized_test()
                    emit("br_if 0 ;; jump to else")
                    block_or_stmt()
                    emit("br 1 ;; exit if")
                if lexer.try_next(TK_ELSE):
                    block_or_stmt()

        when TK_WHILE:
            lexer.next()
            with emit.emit_block("block ;; while", "end"):
                with emit.emit_block("loop", "end"):
                    parenthesized_test()
                    emit("br_if 1 ;; exit loop")
                    block_or_stmt()
                    emit("br 0 ;; repeat loop")

        when TK_DO:
            lexer.next()
            with emit.emit_block("block ;; do-while", "end"):
                with emit.emit_block("loop", "end"):
                    block_or_stmt()
                    lexer.next(TK_WHILE)
                    parenthesized_test()
                    emit("br_if 1 ;; exit loop")
                    emit("br 0 ;; repeat loop")
                    lexer.next(TK_SEMI)

        when TK_FOR:
            # The advancement expression (e.g. i++) must be emitted *after* the
            # body even though it appears before.  Trick: save a Lexer clone,
            # skip the expression with no_emit, then re-lex it after the body.
            lexer.next()
            lexer.next(TK_LPAREN)
            with emit.emit_block("block ;; for", "end"):
                if lexer.peek().kind != TK_SEMI:
                    expression(lexer, frame)
                    emit("drop ;; discard for initializer")
                lexer.next(TK_SEMI)
                with emit.emit_block("loop", "end"):
                    if lexer.peek().kind != TK_SEMI:
                        load_result(expression(lexer, frame))
                        emit("i32.eqz ;; for test")
                        emit("br_if 1 ;; exit loop")
                    lexer.next(TK_SEMI)
                    var saved: ?Lexer = None
                    if lexer.peek().kind != TK_RPAREN:
                        saved = lexer.clone()
                        with emit.no_emit():
                            expression(lexer, frame)
                    lexer.next(TK_RPAREN)
                    emit(";; for body")
                    block_or_stmt()
                    if saved is not None:
                        emit(";; for advancement")
                        expression(saved, frame)
                    emit("br 0 ;; repeat loop")

        when TK_SEMI:
            lexer.next()

        when others:
            expression(lexer, frame)
            lexer.next(TK_SEMI)
            emit("drop ;; discard statement expr result")


# ---------------------------------------------------------------------------
# Declarations
# ---------------------------------------------------------------------------

def variable_declaration(lexer: Lexer, frame: StackFrame) -> None:
    prev_typename: str = lexer.peek().content
    ctype, varname = parse_type_and_name(lexer)
    frame.add_var(varname.content, ctype)
    while lexer.try_next(TK_COMMA):
        ctype, varname = parse_type_and_name(lexer, prev_typename)
        frame.add_var(varname.content, ctype)
    lexer.next(TK_SEMI)


def global_declaration(global_frame: StackFrame, lexer: Lexer) -> None:
    if lexer.try_next(TK_TYPEDEF):
        td_type, td_name = parse_type_and_name(lexer)
        lexer.types.add(td_name.content)
        typedefs[td_name.content] = td_type
        lexer.next(TK_SEMI)
        return

    decl_type, name = parse_type_and_name(lexer)

    if lexer.try_next(TK_SEMI):
        global_frame.add_var(name.content, decl_type, False)
        return

    if decl_type.is_arr():
        die("function array return / global array initializer not supported")

    frame: StackFrame = StackFrame(global_frame)
    lexer.next(TK_LPAREN)
    while not lexer.try_next(TK_RPAREN):
        ptype, pname = parse_type_and_name(lexer)
        frame.add_var(pname.content, ptype, is_parameter=True)
        if lexer.peek().kind != TK_RPAREN:
            lexer.try_next(TK_COMMA)
    lexer.next(TK_LBRACE)
    while lexer.peek().kind == TK_TYPE:
        variable_declaration(lexer, frame)

    with emit.emit_block(f"(func ${name.content}", ")"):
        for v in frame.variables.values():
            if v.is_parameter:
                emit(f"(param ${v.name} {v.ctype.wasmtype})")
        emit(f"(result {decl_type.wasmtype})")
        emit("global.get $__stack_pointer ;; prelude: adjust stack pointer")
        emit(f"i32.const {frame.frame_offset + frame.frame_size}")
        emit("i32.sub")
        emit("global.set $__stack_pointer")
        var all_vars: []FrameVar_T = []
        for v in frame.variables.values():
            all_vars.append(v)
        for v in reversed(all_vars):
            if v.is_parameter:
                _, off = frame.get_var_and_offset(v.name)
                emit("global.get $__stack_pointer ;; prelude: store parameter")
                emit(f"i32.const {off}")
                emit("i32.add")
                emit(f"local.get ${v.name}")
                emit(v.ctype.store_ins())
        while not lexer.try_next(TK_RBRACE):
            statement(lexer, frame)
        emit("unreachable")


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def compile_c(src: str) -> None:
    with emit.emit_block("(module", ")"):
        emit("(memory 3)")
        emit(f"(global $__stack_pointer (mut i32) (i32.const {PAGE_SIZE * 3}))")
        emit("(func $__dup_i32 (param i32) (result i32 i32)")
        emit("  (local.get 0) (local.get 0))")
        emit("(func $__swap_i32 (param i32) (param i32) (result i32 i32)")
        emit("  (local.get 1) (local.get 0))")

        global_frame: StackFrame = StackFrame()
        lexer: Lexer = Lexer(src, set(["int", "char", "short", "long", "float", "double"]))
        while lexer.peek().kind != TK_EOF:
            global_declaration(global_frame, lexer)

        emit('(export "main" (func $main))')
        emit(f'(data $.rodata (i32.const {str_pool.base}) "{str_pool.pooled()}")')


if __name__ == "__main__":
    var src_lines: []str = []
    for line in stdin.lines:
        src_lines.append(line + "\n")
    source: str = "".join(src_lines)
    compile_c(source)
