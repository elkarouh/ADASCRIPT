#!/usr/bin/env ady2nim
"""roi_gui -- the page as HTML the server draws, for htmx to swap in; no JointJS, no script of our own.

The page is one SVG: boxes (rects with a form inside, in a foreignObject) joined by arrows
(paths). The browser draws it and nothing more. A field that is changed sends GET /all with
its value (`value`) and what it is (`changed`); the server works it out and sends the whole
drawing again, which htmx swaps in (see server.ady).
"""
from uri nimport decodeUrl
from backend/roi_model import BLOCKS, BLOCK_H, BLOCK_W, CURRENT_YEAR, FIRST_YEAR, HIGH, PRODUCTS, WIDE, Plan, Outcome, evaluate

# The value of KEY in a query or a form body ("a=1&b=2"), or "".
def field_of(text: str, key: str) -> str:
    for pair in text.split("&"):
        let at: int = pair.find("=")
        if at > 0 and pair[:at] == key:
            return decodeUrl(pair[at + 1:])
    return ""

const LABELS: []str = ["Gold", "Bitcoin", "S&P 500"]
const COLORS: []str = ["#F7E3AE", "#9C9EC8", "#FFCCD6"]
const INVEST_COLOR: str = "#D4D9D7"

# Where the results of each product are inside the box of the results, from its top left.
const PERF_DX: float = 30.0
const PERF_DY: []float = [60.0, 185.0, 310.0]

# A number as a person writes it: 25, not 25.0; 12.5 stays.
def plain(v: float) -> str:
    if v == float(int(v)):
        return str(int(v))
    return f"{v:.2f}"

def money(v: float) -> str:
    return f"{v:.2f}"

# Where block NUMBER has its top left corner.
def left_of(plan: Plan, number: int) -> float:
    return plan.cx[number] - BLOCK_W[number] / 2.0

def top_of(plan: Plan, number: int) -> float:
    return plan.cy[number] - BLOCK_H[number] / 2.0

# The curve from (X1, Y1) to (X2, Y2), leaving and arriving sideways. It stops a head's length
# short of X2, where the head begins: the head's tip is at X2, the box's edge, and the lines
# do not run on under it. (frontend/roi_js_events.ady draws it the same way.)
const HEAD: float = 12.0

def curve(x1: float, y1: float, x2: float, y2: float) -> str:
    let end: float = x2 - HEAD
    let mid: float = (x1 + end) / 2.0
    return f"M {x1:.1f} {y1:.1f} C {mid:.1f} {y1:.1f} {mid:.1f} {y2:.1f} {end:.1f} {y2:.1f}"

# The arrow from block FROM to block TO: a dark outline, the colour on it, and the head. It
# starts at (FX, FY) from FROM's top left corner and ends at (TX, TY) from TO's. The page
# writes those on it (data_*), for the script that redraws it while a block is dragged.
def arrow_html(plan: Plan, from_block: int, fx: float, fy: float, to_block: int, tx: float, ty: float, color: str) -> Html:
    let d: str = curve(left_of(plan, from_block) + fx, top_of(plan, from_block) + fy,
                       left_of(plan, to_block) + tx, top_of(plan, to_block) + ty)
    let head: str = "url(#head" + color[1:] + ")"
    html:
        g class="arrow" data_a=BLOCKS[from_block] data_ax=str(fx) data_ay=str(fy) data_b=BLOCKS[to_block] data_bx=str(tx) data_by=str(ty):
            path class="outline" d=d
            path class="line" d=d stroke=color marker_end=head

# A box at (X, Y), W by H, filled with COLOR, with what is in it written as HTML. It belongs
# to the block called BLOCK, and moves with it. A box that is a block of its own, FOR_DRAG,
# is the grip: the script lets the mouse take hold of its rectangle and nothing else, so the
# fields in it can still be clicked.
def box_html(block: str, x: float, y: float, w: float, h: float, color: str, inside: Html, grip: bool) -> Html:
    let wide: str = str(w)
    let high: str = str(h)
    let at_x: str = str(x)
    let at_y: str = str(y)
    let css: str = ("node" if grip else "body")
    let centre_x: str = str(x + w / 2.0)
    let centre_y: str = str(y + h / 2.0)
    html:
        g class="box":
            rect class=css x=at_x y=at_y rx="10" ry="10" width=wide height=high fill=color data_block=block data_name=block data_x=centre_x data_y=centre_y
            foreignObject x=at_x y=at_y width=wide height=high data_block=block:
                div class="form":
                    + inside

def invest_html(plan: Plan) -> Html:
    let funds_vals: str = "{\"changed\": \"funds\"}"
    let year_vals: str = "{\"changed\": \"year\"}"
    var years: []int = []
    var year: int = FIRST_YEAR
    while year <= CURRENT_YEAR:
        years.append(year)
        year += 1
    html:
        div:
            h2: "Investment"
            label: "How much did you invest?"
            input type="number" name="value" value=plain(plan.funds) min="0" data_hx_get="/all" data_hx_trigger="change" data_hx_vals=funds_vals data_hx_target="#all" data_hx_swap="outerHTML"
            label: "What year it was?"
            select name="value" data_hx_get="/all" data_hx_trigger="change" data_hx_vals=year_vals data_hx_target="#all" data_hx_swap="outerHTML":
                for y in years:
                    if y == plan.year:
                        option value=str(y) selected="selected": str(y)
                    else:
                        option value=str(y): str(y)

def product_html(plan: Plan, i: int) -> Html:
    let vals: str = "{\"changed\": \"" + PRODUCTS[i] + "\"}"
    html:
        div:
            label:
                + text("What % did you invest in ")
                strong: LABELS[i]
                + text("?")
            span class="unit":
                input type="number" name="value" value=plain(plan.pcts[i]) min="0" max="100" step="1" data_hx_get="/all" data_hx_trigger="change" data_hx_vals=vals data_hx_target="#all" data_hx_swap="outerHTML"
                span: " %"

def perf_html(r: Outcome, i: int) -> Html:
    html:
        div:
            h3: LABELS[i]
            div class="fields":
                label: "Value"
                output: money(r.values[i])
                label: "ROI"
                output: money(r.rois[i])

def overall_html(r: Outcome) -> Html:
    html:
        div class="overall":
            p:
                + text("This is your portfolio now in ")
                strong: str(CURRENT_YEAR)
                + text(".")
            label: "Your overall performance of investment is:"
            div class="fields":
                label: "Value"
                output: money(r.total)
                label: "ROI"
                output: money(r.roi)

# The head of an arrow of COLOR: the colour, outlined in black, open at the back so that the
# arrow's colour runs into it. The arrow's line stops where it starts (HEAD long).
def head_html(color: str) -> Html:
    let id: str = "head" + color[1:]
    html:
        marker id=id viewBox="0 0 12 12" refX="0" refY="6" markerUnits="userSpaceOnUse" markerWidth="14" markerHeight="14" orient="auto":
            path d="M -1 0 L 12 6 L -1 12" fill=color stroke="#000" stroke_width="2" stroke_linejoin="round"

def all_html(plan: Plan) -> Html:
    let r: Outcome = evaluate(plan)
    let box: str = f"0 0 {WIDE:.0f} {HIGH:.0f}"
    html:
        div id="all":
            form id="move":
                input type="hidden" name="name" value=""
                input type="hidden" name="x" value=""
                input type="hidden" name="y" value=""
                button type="button" id="redraw" class="redraw" data_hx_put="/move" data_hx_include="#move" data_hx_target="#all" data_hx_swap="outerHTML": "Move"
            svg viewBox=box class="drawing":
                defs:
                    + head_html(INVEST_COLOR)
                    for color in COLORS:
                        + head_html(color)
                + box_html("investment", left_of(plan, 0), top_of(plan, 0), BLOCK_W[0], BLOCK_H[0], INVEST_COLOR, invest_html(plan), True)
                for i in 0 ..< 3:
                    + box_html(BLOCKS[i + 1], left_of(plan, i + 1), top_of(plan, i + 1), BLOCK_W[i + 1], BLOCK_H[i + 1], COLORS[i], product_html(plan, i), True)
                + box_html("overall", left_of(plan, 4), top_of(plan, 4), BLOCK_W[4], BLOCK_H[4], "#EAECEA", overall_html(r), True)
                for i in 0 ..< 3:
                    + box_html("overall", left_of(plan, 4) + PERF_DX, top_of(plan, 4) + PERF_DY[i], 200.0, 100.0, INVEST_COLOR, perf_html(r, i), False)
                for i in 0 ..< 3:
                    + arrow_html(plan, 0, 140.0, 40.0 + 75.0 * float(i), i + 1, 0.0, 60.0, INVEST_COLOR)
                    + arrow_html(plan, i + 1, 140.0, 60.0, 4, PERF_DX, PERF_DY[i] + 50.0, COLORS[i])

const STYLE: str = """
body { font-family: system-ui, -apple-system, Helvetica, Arial, sans-serif; color: #1f2933; background: #f6f4f4;
       margin: 0; padding: 1em; }
h1 { font-size: 1.4em; margin: 0 0 0.2em; }
p.about { color: #616e7c; margin: 0 0 1em; }
svg.drawing { width: 100%; max-width: 62em; height: auto; display: block; margin: 0 auto; }
rect.body, rect.node { stroke: #333; stroke-width: 2; }
rect.node { cursor: grab; }
foreignObject { pointer-events: none; }
button.redraw { display: none; }
svg.drawing { user-select: none; }
div.form input, div.form select { user-select: auto; }
path.outline { fill: none; stroke: #000; stroke-width: 8; stroke-linejoin: round; }
path.line { fill: none; stroke-width: 4; stroke-linejoin: round; }

div.form { pointer-events: none; font: 13px system-ui, -apple-system, Helvetica, Arial, sans-serif; padding: 8px 10px; display: flex; flex-direction: column; gap: 4px; height: 100%; box-sizing: border-box; }
div.form h2 { font-size: 18px; text-align: center; margin: 4px 0 10px; }
div.form h3 { font-size: 13px; text-align: center; margin: 0 0 2px; }
div.form label { display: block; }
div.fields { display: grid; grid-template-columns: auto 1fr; gap: 4px 8px; align-items: center; }
div.overall > label { text-align: center; }
div.form input, div.form select, div.form output { pointer-events: auto; display: block; box-sizing: border-box; width: 100%; font: inherit; text-align: right;
       border: 1px solid #888; border-radius: 4px; padding: 2px 4px; background: #fff; min-height: 1.6em; }
div.form span.unit { display: flex; align-items: center; gap: 4px; }
div.form span.unit input { width: 5em; }
div.overall { display: flex; flex-direction: column; gap: 4px; justify-content: flex-end; height: 100%; }
div.overall p { text-align: center; margin: 0 0 auto; }

"""

def shell() -> Html:
    html:
        html lang="en":
            head:
                meta charset="utf-8"
                title: "Return of investment"
                style: STYLE
                script src="/htmx.min.js"
                script src="/roi_js_events.js"
            body:
                h1: "Return of investment"
                p class="about": "Change the money, the year or a share; the other shares adjust. Drawn by the server, no JointJS."
                div id="all" data_hx_get="/all" data_hx_trigger="load": "Loading..."

# An html: block writes an attribute with underscores (data_hx_get); htmx wants hyphens.
def hyphens(text: str) -> str:
    return text.replace("data_hx_", "data-hx-").replace("marker_end", "marker-end").replace("stroke_width", "stroke-width").replace("stroke_linejoin", "stroke-linejoin")

def shell_text() -> str:
    return "<!doctype html>" + hyphens(str(shell()))

def all_text(plan: Plan) -> str:
    return hyphens(str(all_html(plan)))
