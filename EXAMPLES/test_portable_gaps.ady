#!/usr/bin/env ady2nim
"""Four spellings that both backends take: a lambda returned from a def or held in a table, sorted() over a dict's keys, a true division compared with an int, and & between strings."""

def twice(f: (int) -> int) -> (int) -> int:
    return lambda x: f(f(x))

def adder(n: int) -> (int, int) -> int:
    return lambda x, y: x + y + n

def inc(x: int) -> int:
    return x + 1

def main():
    let g: (int) -> int = twice(inc)
    assert g(1) == 3
    assert adder(1)(2, 3) == 6

    let fns: {str}(float) -> float = {"half": lambda x: x / 2.0, "neg": lambda x: -x}
    assert fns["half"](4.0) == 2.0
    assert fns["neg"](1.0) == -1.0

    let d: {str}int = {"b": 2, "a": 1, "c": 3}
    let ks: []str = sorted(d.keys())
    assert ks[0] == "a"
    assert ks[2] == "c"
    let rev: []str = sorted(d.keys(), reverse=True)
    assert rev[0] == "c"

    let a: int = 8
    let b: int = 4
    assert b == a / 2
    assert a / 2 == 4
    assert 4 == a / 2
    assert a / 3 != 2
    assert b < a / 1

    let s: str = "x"
    let t: str = "y"
    assert s & t == "xy"
    assert "<" & s & ">" == "<x>"
    print "ok"

main()
