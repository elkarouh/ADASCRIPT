#!/usr/bin/env ady2nim
"""Test: input(prompt) is a `str | !InputFailure_T` -- a line, or the end of
the input as a value, not an EOFError. Fed two lines on standard input, the
third call finds the input ended. The output is compared between the
backends (see the Makefile).
"""

def ask(prompt: str) -> str | !InputFailure_T:
    return input(prompt)

def full_name() -> str | !InputFailure_T:
    do:
        first <- input("first: ")
        last <- input()
    return f"{first} {last}"

let name: str | !InputFailure_T = full_name()
if name is InputFailure_T:
    assert False
else:
    print f"name={name}"
print ""

let more: str | !InputFailure_T = ask("more: ")
if more is InputFailure_T:
    print f"no more input ({more.reason})"
else:
    assert False

let again: str | !InputFailure_T = input()
if again is InputFailure_T:
    print "still none"
else:
    assert False
print "test_input OK"
