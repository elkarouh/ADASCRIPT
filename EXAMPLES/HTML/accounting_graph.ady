#!/usr/bin/env ady2nim
"""Accounting for computer scientists, as a web page.

    ady2nim c -r accounting_graph.ady > accounting.html

Martin Kleppmann's article "Accounting for Computer Scientists" (2011,
https://martin.kleppmann.com/2011/03/07/accounting-for-computer-scientists.html)
says that basic accounting is graph theory: an account is a node, a
transaction is an edge carrying an amount, and a balance is what comes in
minus what goes out. This program builds the article's example company as
exactly that graph, works every balance out, and writes the page: the
edges, the balances coloured by kind of account, the profit and loss
statement and the balance sheet.

The page is a tree of objects, each rendering itself with `to_html`
(see EXAMPLES/HTML/html_app.ady). Needs karax: `nimble install karax`.

The two checks the article names are asserted before anything is written:
all balances sum to zero, and assets less liabilities equal equity.
"""

type Cents_T is distinct int

type Account_T is enum BANK, CARD, FURNITURE, CUSTOMER_1, CUSTOMER_2, SALES, CAPITAL, PAYROLL, DEPRECIATION, FOOD

# The article colours its nodes: green is what you own or owe, blue is
# revenue and expense, pink is what the shareholders put in.
type Colour_T is enum GREEN, BLUE, PINK

type Transaction is record:
    what:   str
    source: Account_T
    target: Account_T
    amount: Cents_T

def colour_of(a: Account_T) -> Colour_T:
    case a:
        when BANK | CARD | FURNITURE | CUSTOMER_1 | CUSTOMER_2:
            return GREEN
        when SALES | PAYROLL | DEPRECIATION | FOOD:
            return BLUE
        when CAPITAL:
            return PINK

def name_of(a: Account_T) -> str:
    case a:
        when BANK:
            return "Bank account"
        when CARD:
            return "Credit card"
        when FURNITURE:
            return "Furniture"
        when CUSTOMER_1:
            return "Customer 1"
        when CUSTOMER_2:
            return "Customer 2"
        when SALES:
            return "Sales"
        when CAPITAL:
            return "Capital"
        when PAYROLL:
            return "Payroll"
        when DEPRECIATION:
            return "Depreciation"
        when FOOD:
            return "Food"

def css_of(a: Account_T) -> str:
    case colour_of(a):
        when GREEN:
            return "green"
        when BLUE:
            return "blue"
        when PINK:
            return "pink"

# 1234567 cents -> "12,345.67"
def money(c: Cents_T) -> str:
    let a: Cents_T = abs(c)
    let whole: str = f"{a // 100}"
    var grouped: str = ""
    for i in range(len(whole)):
        if i > 0 and (len(whole) - i) % 3 == 0:
            grouped += ","
        grouped += whole[i]
    let sign: str = "-" if c < 0 else ""
    return f"{sign}{grouped}.{a % 100:02d}"

# ---------------------------------------------------------------------
# The company: every transaction is an edge, money flowing source -> target
# ---------------------------------------------------------------------

let TRANSACTIONS: []Transaction = [
    Transaction("A bagel on the company credit card", CARD, FOOD, 500),
    Transaction("A chair, paid by cheque from the bank account", BANK, FURNITURE, 50000),
    Transaction("The founder puts in savings", CAPITAL, BANK, 500000),
    Transaction("The credit card bill is paid from the bank", BANK, CARD, 500),
    Transaction("A Super Burrito on the credit card", CARD, FOOD, 800),
    Transaction("Sale to customer 1, agreed at 5,000", SALES, CUSTOMER_1, 500000),
    Transaction("Sale to customer 2, agreed at 5,000", SALES, CUSTOMER_2, 500000),
    Transaction("Customer 1 pays in full", CUSTOMER_1, BANK, 500000),
    Transaction("Customer 2 pays half up front", CUSTOMER_2, BANK, 250000),
    Transaction("Y Combinator invests", CAPITAL, BANK, 2000000),
    Transaction("Salaries, paid from the bank", BANK, PAYROLL, 800000),
    Transaction("The chair loses a quarter of its value to depreciation", FURNITURE, DEPRECIATION, 12500),
]

# A balance: what comes into the account, less what goes out of it.
def balances(edges: []Transaction) -> [Account_T]Cents_T:
    var net: [Account_T]Cents_T
    for t in edges:
        net[t.target] += t.amount
        net[t.source] -= t.amount
    return net

# ---------------------------------------------------------------------
# Widgets: each knows how to render itself
# ---------------------------------------------------------------------

const STYLE: str = """
body { font-family: sans-serif; max-width: 52em; margin: 2em auto; padding: 0 1em; line-height: 1.45; }
table { border-collapse: collapse; margin: 1em 0; }
th, td { border: 1px solid #bbb; padding: 0.3em 0.7em; text-align: left; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
td.green { background: #d6f0d6; }
td.blue { background: #d6e6f8; }
td.pink { background: #f8d6e6; }
table.statement { min-width: 22em; }
tr.total td { font-weight: bold; border-top: 2px solid #333; }
"""

@virtual
class Widget:
    def to_html(self) -> Html:
        html:
            div class="widget"

class Prose(Widget):
    var text: str

    def __init__(self, text: str):
        self.text = text

    def to_html(self) -> Html:
        html:
            p: self.text

class Section(Widget):
    var title:    str
    var children: []Widget

    def __init__(self, title: str):
        self.title = title
        self.children = []

    def add(self, child: Widget):
        self.children.append(child)

    def to_html(self) -> Html:
        html:
            section:
                h2: self.title
                for child in self.children:
                    + child.to_html()

class EdgeTable(Widget):
    var edges: []Transaction

    def __init__(self, edges: []Transaction):
        self.edges = edges

    def to_html(self) -> Html:
        html:
            table:
                tr:
                    th: "Transaction"
                    th: "From"
                    th: "To"
                    th: "Amount"
                for t in self.edges:
                    tr:
                        td: t.what
                        td class=css_of(t.source): name_of(t.source)
                        td class=css_of(t.target): name_of(t.target)
                        td class="num": money(t.amount)

class BalanceTable(Widget):
    var net: [Account_T]Cents_T

    def __init__(self, net: [Account_T]Cents_T):
        self.net = net

    def to_html(self) -> Html:
        html:
            table:
                tr:
                    th: "Account"
                    th: "Balance"
                for a in Account_T:
                    tr:
                        td class=css_of(a): name_of(a)
                        td class="num": money(self.net[a])

# A statement is a list of labelled lines and a total.
type Line is record:
    label:  str
    amount: Cents_T

class Statement(Widget):
    var lines: []Line
    var total_label: str
    var total: Cents_T

    def __init__(self, lines: []Line, total_label: str, total: Cents_T):
        self.lines = lines
        self.total_label = total_label
        self.total = total

    def to_html(self) -> Html:
        html:
            table class="statement":
                for l in self.lines:
                    tr:
                        td: l.label
                        td class="num": money(l.amount)
                tr class="total":
                    td: self.total_label
                    td class="num": money(self.total)

class Page(Widget):
    var title: str
    var body:  []Widget

    def __init__(self, title: str):
        self.title = title
        self.body = []

    def add(self, child: Widget):
        self.body.append(child)

    def to_html(self) -> Html:
        html:
            html lang="en":
                head:
                    meta charset="utf-8"
                    title: self.title
                    style: STYLE
                body:
                    h1: self.title
                    for child in self.body:
                        + child.to_html()

# ---------------------------------------------------------------------
# The page
# ---------------------------------------------------------------------

def main():
    let net: [Account_T]Cents_T = balances(TRANSACTIONS)

    # Check 1: each transaction is once positive and once negative.
    var sum: Cents_T = 0
    for a in Account_T:
        sum += net[a]
    assert sum == 0

    # Revenue and expenses are the blue nodes; a negative balance is a profit.
    let revenue: Cents_T = -net[SALES]
    let expenses: Cents_T = net[PAYROLL] + net[DEPRECIATION] + net[FOOD]
    let profit: Cents_T = revenue - expenses

    let debtors: Cents_T = net[CUSTOMER_1] + net[CUSTOMER_2]
    let assets: Cents_T = net[BANK] + debtors + net[FURNITURE]
    let liabilities: Cents_T = -net[CARD]
    let capital: Cents_T = -net[CAPITAL]
    let equity: Cents_T = profit + capital

    # Check 2: assets less liabilities equal equity.
    assert assets - liabilities == equity

    let edges: Section = Section("Accounts are nodes, transactions are edges")
    edges.add(Prose("Each line is an edge of the graph: an amount flowing from one account to another. An account can be a bank account, a card, a customer, or an abstract category such as food or furniture. Accounts are coloured: green for what the company owns or owes, blue for revenue and expense, pink for the money its shareholders put in."))
    edges.add(EdgeTable(TRANSACTIONS))

    let bal: Section = Section("Balances")
    bal.add(Prose("An account starts at zero. Money coming in adds to it, money going out subtracts. Every transaction is counted once as positive and once as negative, so all the balances add up to zero: that is what accountants call balancing the books."))
    bal.add(BalanceTable(net))

    let pnl: Section = Section("Profit and loss")
    pnl.add(Prose("Only the blue accounts: revenue less expenses. A negative balance on a blue account is revenue, so the sign flips when it is reported."))
    pnl.add(Statement([
        Line("Revenue: sales", revenue),
        Line("Expenses: payroll", net[PAYROLL]),
        Line("Expenses: depreciation", net[DEPRECIATION]),
        Line("Expenses: food", net[FOOD]),
    ], "Profit", profit))

    let sheet: Section = Section("Balance sheet")
    sheet.add(Prose("The green accounts on one side, the pink accounts and the profit on the other. Profit is not cash: the bank holds less than the 25,000 invested plus the sales, because customer 2 still owes half."))
    sheet.add(Statement([
        Line("Assets: bank account", net[BANK]),
        Line("Assets: debtors", debtors),
        Line("Assets: furniture", net[FURNITURE]),
        Line("Less liabilities: credit card", -liabilities),
    ], "Assets less liabilities", assets - liabilities))
    sheet.add(Statement([
        Line("Equity: profit", profit),
        Line("Equity: capital", capital),
    ], "Total equity", equity))

    let page: Page = Page("Accounting for computer scientists")
    page.add(Prose("Basic accounting is graph theory. The company below is the example of Martin Kleppmann's article of that name, worked out by a program."))
    page.add(edges)
    page.add(bal)
    page.add(pnl)
    page.add(sheet)
    print "<!doctype html>"
    print page.to_html()

main()
