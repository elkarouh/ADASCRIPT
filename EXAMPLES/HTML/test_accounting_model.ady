#!/usr/bin/env ady2nim
"""The accounting model on its own, no GUI: the article's figures, with the
credit note to customer 2 that kleppmann() adds.

    ady2nim c -r test_accounting_model.ady
"""
from accounting_model import Cents_T, Graph, kleppmann

let g: Graph = kleppmann()

# The two checks the article names.
assert g.total() == 0
assert g.net_assets() == g.equity()

# Balances, in cents.
assert g.balance("Bank account") == 2399500
assert g.balance("Credit card") == -800
assert g.balance("Furniture") == 37500
assert g.balance("Customer 1") == 0
assert g.balance("Customer 2") == 200000
assert g.balance("Sales") == -950000
assert g.balance("Capital") == -2500000
assert g.balance("Food") == 1300

# The statements.
assert g.profit() == 136200
assert g.net_assets() == 2636200
assert g.equity() == 2636200
assert len(g.profit_and_loss()) == 4
assert g.profit_and_loss()[0].label == "Revenue: Sales"

# Two transactions between the same accounts, the same way, are one flow;
# the credit note goes the other way, so it is a flow of its own.
assert len(g.edges) == 13
assert len(g.flows) == 11

print "accounting model: all checks passed"
