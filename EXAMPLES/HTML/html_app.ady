#!/usr/bin/env ady2nim
#ady2nim-args js
"""A page as a tree of objects, each rendering itself, with working buttons.

The application renders the page, and asks each child for its own HTML
(`+ child.to_html()`), which asks its children in turn. A button is an
object too: `onclick=self.press` calls its own method, and the page is
drawn again. Build and serve it with `make app`; needs karax
(`nimble install karax`).
"""
from karax/karax nimport setRenderer

@virtual
class Widget:
    def to_html(self) -> Html:
        html:
            div class="widget"

@virtual
class Counter:
    var count: int = 0

class Label(Widget):
    var model: Counter

    def __init__(self, model: Counter):
        self.model = model

    def to_html(self) -> Html:
        html:
            span class="label": f"count: {self.model.count}"

class Button(Widget):
    var model: Counter
    var label: str
    var step:  int

    def __init__(self, model: Counter, label: str, step: int):
        self.model = model
        self.label = label
        self.step = step

    def press(self):
        self.model.count += self.step

    def to_html(self) -> Html:
        html:
            button onclick=self.press: self.label

class Panel(Widget):
    var title:    str
    var children: []Widget

    def __init__(self, title: str):
        self.title = title
        self.children = []

    def add(self, child: Widget):
        self.children.append(child)

    def to_html(self) -> Html:
        html:
            section class="panel":
                h2: self.title
                for child in self.children:
                    + child.to_html()

class App(Widget):
    var title: str
    var body:  Panel

    def __init__(self, title: str, body: Panel):
        self.title = title
        self.body = body

    def to_html(self) -> Html:
        html:
            div:
                h1: self.title
                + self.body.to_html()

let model: Counter = Counter()
var panel: Panel = Panel("Counter")
panel.add(Label(model))
panel.add(Button(model, "+1", 1))
panel.add(Button(model, "-1", -1))
let app: App = App("Demo", panel)

def render() -> Html:
    return app.to_html()

setRenderer(render)
