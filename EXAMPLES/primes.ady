#!/usr/bin/env ady2nim
"""
primes — count the primes below a million by trial division, and say how
long it took.

The timing is the part worth reading. `time.time()` behind a `nimport` is a
native call on both backends -- Nim's `epochTime()`, Python's `time.time()`
-- and it costs the build nothing. Behind a `pyimport` it is the same
number at the price of nimpy on the Nim path, a libpython link, and a
matching interpreter at run time.

The rule that follows is in DOCS/ADASCRIPT_FOR_SHELL.md §11, and the order
it puts things in is `nimport`, then the shell, then `pyimport`. A clock
stops at the first step: `shell: date +%s` would answer too, and starting a
process to read a clock is worse than an import that costs nothing -- and
it has no fraction of a second in it, which a benchmark wants.

EXAMPLES/pyimport_similar.ady is the other side of that rule -- what a
`pyimport` looks like when the library really has no equivalent.
"""
nimport time

N = 1000000

def is_prime(n: Positive) -> bool:
    result = True
    limit : Positive = Positive(n**0.5)
    for k in 2..limit:
        if n % k == 0:
            result = False
            break

def count_primes(n: Positive) -> Positive:
    result = 1 # we known 2 is a prime
    for k in 3..<n:
        if is_prime(k):
            result += 1

start = time.time()
print f"Number of primes: {count_primes(N)}"
finish = time.time()
print f"time elapsed: {finish - start}/s"
