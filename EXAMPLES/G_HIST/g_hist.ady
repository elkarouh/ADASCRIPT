#!/usr/bin/env ady2nim
"""g_hist: step through a file's git history in meld, newest change first.

    g_hist path/to/file

Follows renames, handles revisions where the file does not exist (before it
was created, after it was deleted), and works from any directory: git is
asked from the file's own directory. A commit that has tags shows them first in
its pane's file name, before the date; one that has none shows the nearest tag
it is in, as `~<tag>` (release tags are usually on a later merge commit). `G_HIST_DEBUG=1 g_hist FILE` also says,
on stderr, what git answered for each commit, to see why a name has no tag.
With a display and zenity it asks in
dialogs, otherwise at the terminal.

A translation of the bash script beside it, g_hist.sh. What the shell needed
`set -euo pipefail`, `trap`, parallel arrays and `IFS= read -r` for is a
`Repo` class, a list of records, and failures that are values: every command
that can fail says so in its type (`str | !ShellFailure_T`, `None |
!PathFailure_T`), nothing here checks a status code, and no exception is
raised or caught.
"""
nimport os

type Rev_T is record:
    hash: str
    path: Path                 # the file's path at that commit: renames change it

# What goes wrong, in this program's words: a git command or a Path operation
# that failed, turned into one message by `else` in the do: steps below.
type Failure_T is record:
    message: str

def shell_failed(f: ShellFailure_T) -> Failure_T:
    return Failure_T(message=f"`{f.command}` exited {f.code}: {f.stderr.strip()}")

def path_failed(f: PathFailure_T) -> Failure_T:
    return Failure_T(message=f"{f.op} {f.path}: {f.reason}")

# Use zenity when a display is available, otherwise fall back to the terminal.
let GUI: bool = which("zenity") is not None and ($DISPLAY != "" or $WAYLAND_DISPLAY != "")

# G_HIST_DEBUG=1 g_hist FILE   says on stderr what git answered for every
# commit and how the names were made: for finding out what a checkout looks
# like from here.
let DEBUG: bool = $G_HIST_DEBUG != ""

def dbg(text: str) -> None:
    if DEBUG:
        stderr.writeLine(f"g_hist debug: {text}")

def msg_error(text: str) -> None:
    stderr.writeLine(f"error: {text}")
    if GUI:
        shell: zenity --error --no-markup --text={!text}

def msg_info(text: str) -> None:
    print text
    if GUI:
        shell: zenity --info --no-markup --text={!text}

def fatal(text: str) -> None:
    msg_error(text)
    quit(1)

def ask(title: str, text: str) -> bool:
    """True to continue, False to stop."""
    if GUI:
        let answer: None | !ShellFailure_T = shell: zenity --question --no-markup --title={!title} --text={!text} --ok-label=Continue --cancel-label=Stop
        return answer is None
    stdout.write(f"{text} [Y/n] ")
    stdout.flushFile()
    for reply in stdin.lines:              # the first line typed; none at end of input
        return not (reply == /^[Nn]/)
    return False

def clean(text: str) -> str:
    """TEXT as part of a file name: ASCII punctuation and spaces become `_`."""
    var out: str = text
    out = s/[\x00-\x2C\x2F\x3A-\x40\x5B-\x5E\x60\x7B-\x7F]/_/g
    return out

class Repo:
    """The git repository a file is in; every command runs from its root."""
    var root: Path

    def __init__(self, root: Path):
        self.root = root

    def output(self, *args: str) -> str | !Failure_T:
        """What git printed, or why it failed: bash's `set -e` ended the script
        on a failing git, here the failure is handed to the caller."""
        do:
            text <- shell(cwd = self.root): git {*args} else shell_failed(text)
        return text.strip()

    def raw(self, *args: str) -> str:
        """What `git ARGS` printed on one line, or how it failed: for the
        debug lines."""
        let r: str | !ShellFailure_T = shell(cwd = self.root): git {*args} 2>&1
        if r is ShellFailure_T:
            return f"<exit {r.code}> {r.stderr.strip()}"
        else:
            let text: str = r.strip()
            return text.replace("\n", " | ")

    def probe(self, hash: str) -> None:
        """The debug lines for one commit: every way git can say it is tagged."""
        if not DEBUG:
            return
        let points: str = self.raw("tag", "--points-at", hash)
        let decorated: str = self.raw("log", "-1", "--format=%D", hash)
        let exact: str = self.raw("describe", "--tags", "--exact-match", hash)
        let named: str = self.raw("name-rev", "--tags", "--name-only", hash)
        let known: str = self.raw("rev-parse", "--verify", hash + "^{commit}")
        dbg(f"commit {hash}")
        dbg(f"  rev-parse --verify   : [{known}]")
        dbg(f"  tag --points-at      : [{points}]")
        dbg(f"  log -1 --format=%D   : [{decorated}]")
        dbg(f"  describe exact-match : [{exact}]")
        dbg(f"  name-rev --tags      : [{named}]")

    def probe_repo(self, abs: Path, rel: Path) -> None:
        """The debug lines about the checkout itself, once."""
        if not DEBUG:
            return
        let version: str = self.raw("--version")
        let gitdir: str = self.raw("rev-parse", "--git-dir")
        let sup: str = self.raw("rev-parse", "--show-superproject-working-tree")
        let shallow: str = self.raw("rev-parse", "--is-shallow-repository")
        let head: str = self.raw("rev-parse", "HEAD")
        let head_tags: str = self.raw("tag", "--points-at", "HEAD")
        let all_tags: str = self.raw("tag", "--list")
        let tag_sort: str = self.raw("config", "--get", "tag.sort")
        let decorate: str = self.raw("config", "--get", "log.decorate")
        let env_dir: str = $GIT_DIR
        let env_tree: str = $GIT_WORK_TREE
        let count: int = len([t for t in all_tags.split(" | ") if t != ""])
        dbg(f"git                  : [{version}]")
        dbg(f"file                 : {abs}")
        dbg(f"repo root, rel path  : {self.root}, {rel}")
        dbg(f"git dir              : [{gitdir}]")
        dbg(f"superproject         : [{sup}]")
        dbg(f"shallow              : [{shallow}]")
        dbg(f"GIT_DIR, GIT_WORK_TREE : [{env_dir}], [{env_tree}]")
        dbg(f"tag.sort, log.decorate : [{tag_sort}], [{decorate}]")
        dbg(f"HEAD                 : {head}")
        dbg(f"tags at HEAD         : [{head_tags}]")
        dbg(f"tags in the repo     : {count}")

    def succeeds(self, *args: str) -> bool:
        let r: None | !ShellFailure_T = shell(cwd = self.root): git {*args} 2>/dev/null
        return not (r is ShellFailure_T)

    def history(self, rel: Path) -> []Rev_T | !Failure_T:
        """Commits touching REL, newest first. --follow tracks renames, so the
        path the file had at each commit is recorded with it."""
        do:
            text <- self.output("log", "--follow", "--name-only", "--format=@%H", "--", str(rel))
        var revs: []Rev_T = []
        var current: str = ""
        for line in text.split("\n"):
            if line.startswith("@"):
                current = line[1:]
            elif line != "":
                revs.append(Rev_T(hash=current, path=Path(line)))
        return revs

    def save_at(self, rev: Rev_T, dest: Path) -> None | !Failure_T:
        """The file as it was at REV, into DEST: empty if it did not exist
        there, before creation or after deletion."""
        let spec: str = f"{rev.hash}:{rev.path}"
        if not self.succeeds("cat-file", "-e", spec):
            do:
                empty <- dest.write_text("") else path_failed(empty)
            return
        do:
            shown <- shell(cwd = self.root): git show {!spec} > {!dest} else shell_failed(shown)

    def describe(self, hash: str) -> str | !Failure_T:
        return self.output("log", "-1", "--format=%h %ad %cn: %s", "--date=short", hash)

    def tmpname(self, hash: str, side: str, tmp: Path, base: str) -> Path | !Failure_T:
        """Where the file at HASH goes, and so what meld's pane header shows:
        [<tags>-]<date>-<committer>-<filename>. The tags are the commit's, if
        it has any, joined by `+`; if it has none, the nearest tag that has the
        commit in it, as `~<tag>` (the release it went out in). SIDE ("new" or "old") is a directory of its
        own (made by `review`), so the two can never collide, even when two
        commits share a date and a committer. Committer and tags keep their
        letters and digits, `.`, `_` and `-`, and non-ASCII letters as they are
        (`Zoë`); any other ASCII character, a space or `/` or `'`, becomes `_`."""
        do:
            committer <- self.output("log", "-1", "--format=%cn", hash)
            when <- self.output("log", "-1", "--format=%cd", "--date=format:%Y-%m-%d", hash)
            tagged <- self.output("tag", "--points-at", hash)
        let tags: []str = [clean(t) for t in tagged.split("\n") if t != ""]
        var prefix: str = "+".join(tags) + "-" if len(tags) > 0 else ""
        if prefix == "":
            # Release tags are usually on a later commit (a merge), not on the
            # ones that changed the file: name the nearest tag the commit is
            # in, marked `~` as not exact. name-rev says `undefined` for none.
            do:
                near <- self.output("name-rev", "--tags", "--name-only", hash)
            if near == /^(?P<tag>[^~^]+)/:
                let found: str = $+{tag}
                if found != "undefined":
                    prefix = "~" + clean(found) + "-"
        self.probe(hash)
        dbg(f"  named {side}: prefix [{prefix}] -> {base}")
        return tmp / side / f"{prefix}{when}-{clean(committer)}-{base}"

def review(repo: Repo, abs: Path, rel: Path, tmp: Path) -> int | !Failure_T:
    """Open the comparisons one after another; the exit status, or what
    failed."""
    for side in ["new", "old", "head"]:    # the directories tmpname puts files in
        do:
            made <- (tmp / side).mkdir() else path_failed(made)
    do:
        revs <- repo.history(rel)
    let base: str = rel.name
    repo.probe_repo(abs, rel)
    dbg(f"{len(revs)} commits touch {rel}, newest first:")
    for rev in revs:
        dbg(f"  {rev.hash}  {rev.path}")

    # 1) Uncommitted changes vs HEAD, if any.
    if repo.succeeds("rev-parse", "--verify", "-q", "HEAD") and not repo.succeeds("diff", "--quiet", "HEAD", "--", str(rel)):
        let head: Rev_T = Rev_T(hash="HEAD", path=rel)
        do:
            head_file <- repo.tmpname("HEAD", "head", tmp, base)     # named like the others: with HEAD's tags
            repo.save_at(head, head_file)
        print "Uncommitted changes: opening working copy vs HEAD"
        # meld's label replaces the name in the header, so the name is said again
        let head_label: str = head_file.name
        shell: meld --label {!head_label} --label "working copy" {!head_file} {!abs}
        if not ask("Continue?", "Continue to committed history?"):
            return 0

    if len(revs) < 2:
        msg_error(f"Need at least 2 committed revisions of {rel} (found {len(revs)})")
        return 1

    let total: int = len(revs) - 1
    print f"Found {len(revs)} revisions; {total} comparisons."

    for i in 0..<total:
        let new: Rev_T = revs[i]
        let old: Rev_T = revs[i + 1]
        do:
            new_desc <- repo.describe(new.hash)
            old_desc <- repo.describe(old.hash)

        if i > 0:
            if not ask("Continue?", f"Comparison {i + 1} of {total}\n\nnew: {new_desc}\nold: {old_desc}"):
                print f"Stopped by user after {i} comparison(s)."
                return 0

        do:
            new_file <- repo.tmpname(new.hash, "new", tmp, base)
            old_file <- repo.tmpname(old.hash, "old", tmp, base)
            repo.save_at(new, new_file)
            repo.save_at(old, old_file)

        if new.path != old.path:
            print f"  (renamed: {old.path} -> {new.path})"
        print f"[{i + 1}/{total}] {new_desc}  <-  {old_desc}"
        # oldest on the left, newest on the right
        shell: meld {!old_file} {!new_file}

        shell: rm -f {!new_file} {!old_file}

    msg_info(f"Done. Reviewed {total} comparison(s).")
    return 0

if $# != 1:
    die(f"usage: {PROG} path/to/file", code = 2)
let file: Path = Path($1)

if which("git") is None:
    fatal("git is not installed")
if which("meld") is None:
    fatal("meld is not installed")
if not -e file:
    fatal(f"File not found: {file}")

let abs: Path = file.resolve()

# Ask git from the file's own directory, so this works from any cwd.
let top: str | !ShellFailure_T = shell(cwd = abs.parent): git rev-parse --show-toplevel 2>/dev/null
if top is ShellFailure_T:
    fatal(f"{file} is not inside a git repository")
let root: Path = Path(top.strip())
let rel: Path | !PathFailure_T = abs.relative_to(root)
if rel is PathFailure_T:
    fatal(f"{file} is not inside the git repo at {root}")
print f"Repo root:     {root}"
print f"Repo-rel path: {rel}"

let scratch: str | !ShellFailure_T = shell: mktemp -d
if scratch is ShellFailure_T:
    fatal("could not make a temporary directory")
let tmp: Path = Path(scratch.strip())
# review reports what goes wrong as a value, so the directory is removed
# whichever way it ends
let outcome: int | !Failure_T = review(Repo(root), abs, rel, tmp)
shell: rm -rf {!tmp}
case outcome:
    when Failure_T:
        fatal(outcome.message)
    when int:
        quit(outcome)
