#!/usr/bin/env ady2nim
#ady2nim-args c -d:release
"""Pgrep — grep the sources of a build closure, or of every subsystem's LATEST build.

Two searches, one program:

  (1) the closure of a system, a baseline ID or a project baseline ID
  (2) the LATEST (or LATEST_GOOD) build of every subsystem

Each subsystem is searched in a process of its own and the results are
printed in subsystem order, so the wall time is the slowest subsystem's
rather than the sum of all of them.

The ksh original dot-sources `trace`, `cm_audit_logger` and
`Caux_functions`. None of the three is ever called by name -- what they
install is a ksh environment (traps, an ERR hook, the audit record a sourced
library writes on its own), and none of it has a meaning in a compiled
program. The CM helpers the script really uses -- `Psort`, `cc_pattern`,
`get_topmost_subsystems` -- are run as commands, as they are there.
"""

nimport os
nimport time

# `$0` is the program name; a built copy can carry a leading dot.
let PROG: str = Path($0).name.lstrip(".")
let PADDING: str = "=" * 93

# Where the subsystem builds are listed from. The shell version spells
# /cm/ot; this reads an override first, so that the whole default path --
# the one that picks the subsystems and filters them -- can be exercised by
# a test rather than only on a site that has a /cm/ot of its own.
let CM_OT: str = ${PGREP_CM_OT:-"/cm/ot"}

# What a baseline ID follows in a *resolved* path, which is not the same
# thing as the root above: a build is listed as /cm/ot/CUA/ADMIN.LATEST and
# resolves to /auto/local_build/<host>/ssd1/cm/ot/CUA/ADMIN.44.0.0.A. The
# marker is the site's own cm/ot, wherever the listing came from.
let CM_MARKER: str = "/cm/ot/"

def die(msg: str):
    stderr.writeLine(PROG + ": " + msg)
    quit(1)

def stdout_is_tty() -> bool:
    """Is our output a terminal, rather than a file or a pipe?"""
    let rc: int = shell: test -t 1
    return rc == 0

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------

def usage() -> str:
    f"""Usage:
  {PROG} -? | -help | -html
  {PROG} [options] [--] <GREP_PARAMS | -no-grep>

Options:
  -closure <SYSTEM | BASELINE_ID | PROJECT_BASELINE_ID>
                                   Search within the closure of a system, baseline, or project baseline.
  -subsys <SUBSYS_BUILD_DIR_PATTERN>
                                   Search for files on the subsystems with that pattern.
  -ada                             Restrict search to ADA files (*.ad?).
  -latest_good                     Search within the LATEST_GOOD builds instead of the default LATEST builds.
  -fpat <FILE_PATTERN>             Filter files based on the specified filename pattern.
  -ppat <PATH_PATTERN>             Filter files based on the specified path pattern.
  -sort                            Sort the output results.
  -verbose                         Enable detailed output, including subsystem baseline headers.
  -no_colors                       Disable colored output (default: enabled for terminal, disabled for file output).
  -basenames                       Display only file basenames (hide full paths for easier comparison).
  -no-grep                         Skip content searching and only list matching files.
  -all                             Include project branch builds when searching in the LATEST builds of all subsystems.

Default Behavior:
- If `-closure` is not provided, the script searches within the LATEST builds of all subsystems.
- If you want to use the *extended regular expressions (ERE)* use the `-E` flag (as with grep).
"""

def pod_text() -> str:
    """The manual page, in POD, for pod2text or pod2html to render."""
    f"""=pod

=head1 NAME

{PROG}

=head1 DESCRIPTION

Grep in all files within the:

(1) closure of a system or a baseline ID or a project baseline ID

(2) LATEST builds for all subsystems.

When grepping files within the closure of a system (1), the default behaviour is to search for files within the LATEST
system build closure, but when used with the -latest_good option, it will search for files within the LATEST_GOOD system
build closure.

When grepping files within the LATEST builds for all subsystems (2), the default behaviour is to skip all project branch
builds. Use the -all option if you don't want to skip the project branch builds, and use the -latest_good option if you
want to search for files within the LATEST_GOOD builds.

The -ada option will match the search to ADA files. Alternatively, you can have the same result using the -fpat option
with the file pattern ".ad?".

=head1 SYNOPSIS

{usage()}

=head2 Options

=over 4

=item B<-help>

Print this message.

=item B<-html>

Print this help text in a browser.

=item B<-basenames>

Display basenames instead of full paths.

=item B<-ada>

Search all .ad? files.

=item B<-all>

Don't skip project branch builds when searching files within the LATEST builds for each subsystem. To search for files
within the LATEST_GOOD builds use the -latest_good option.

=item B<-closure E<lt>SYSTEM | BASELINE_ID E<gt>>

Search for files within the closure of the topmost LATEST subsystem for SYSTEM or for BASELINE_ID.

If you are not in a view context, the ${{CONTEXT_CM_BASELINE}} variable is not defined, and it will search for files
within the closure of the topmost LATEST subsystem.

To search for files within the LATEST_GOOD builds use the -latest_good option.

=item B<-fpat E<lt>FILE_PATTERNE<gt>>

File pattern, FILE_PATTERN, matches the filename for the file search.

=item B<-latest_good>

Search for files on the LATEST_GOOD builds. The default behaviour is to search for files on the LATEST builds.

=item B<-no-grep>

Don't grep the content of the files, list the files.

=item B<-ppat E<lt>PATH_PATTERNE<gt>>

Path pattern, PATH_PATTERN, matches the file pathname for the file search.

=item B<-verbose>

Show results with verbose output (=== header lines showing the subsystem baseline in which result are found).

=item B<-no_colors>

Show results without colors.

=item B<-sort>

Sort the files within the subsystems.

=item B<-subsys E<lt>SUBSYS_BUILD_DIR_PATTERNE<gt>>

Search for files on the subsystems with the <SUBSYS_BUILD_DIR_PATTERN> pattern.

=back

=head1 EXAMPLES

To print help text:

B<$ {PROG} -help>

B<$ {PROG} -html>

To search for the word "test" with grep option "-w" within the files of all the LATEST builds subsystem, including
the projects:

B<$ {PROG} -all -w test>

To search for the word "remote" within the ADA files of the IPS LATEST_GOOD build closure:

B<$ {PROG} -closure IFPS -latest_good -ada remote>

To search for the word "remote" within the "*.ksh" files of the IPS LATEST_GOOD build closure:

B<$ {PROG} -closure IFPS -latest_good -fpat "*.ksh" remote>

To search for the word "remote" within the ADA files of the IFPS.IFPS_CONFIG.27.1.0.12 baseline ID build on a
view context:

B<$ Csetup -b IFPS.IFPS_CONFIG.27.1.0.12 view_search>

B<$ {PROG} -closure IFPS -latest_good -ada remote>

or, if you are not on a view context:

B<$ {PROG} -closure IFPS.IFPS_CONFIG.27.1.0.12 -latest_good -ada remote>

To search for the word "length" within files with the pattern name "*.ksh" and within paths with the pattern
"*queue*" within the IFPS subsystem's closure, on the LATEST_GOOD builds. Additionally, it suppresses verbose output.

B<$ {PROG} -closure IFPS -latest_good -fpat "*.ksh" -ppat "*queue*" -verbose length>

To list the ada files of the TACT LATEST build closure with verbose output:

B<$ {PROG} -ada -closure TACT -verbose -no-grep>

To count the number files of the IFPS LATEST build closure:

B<$ {PROG} -closure IFPS -no-grep | wc -l>

=cut
"""

def print_help(as_html: bool):
    """Render the POD, in a browser when asked and the terminal otherwise."""
    let to_terminal: bool = stdout_is_tty()
    let browser: str = $BROWSER
    if as_html and browser != "":
        let page: Path = Path("/tmp") / (PROG + "_help.html")
        let html_rc: int = shell(stdin = pod_text()): pod2html --title={!PROG} > {!page}
        let show_rc: int = shell: {browser} {!page}
    elif to_terminal:
        # A terminal gets it paged and coloured; a pipe gets it plain.
        let cols: str = ${COLUMNS:-"80"}
        let paged_rc: int = shell(stdin = pod_text()): pod2text --color --width {!cols} | more -f
    else:
        let plain_rc: int = shell(stdin = pod_text()): pod2text
    quit(0)

# ---------------------------------------------------------------------------
# Options
# ---------------------------------------------------------------------------

def value_after(argv: []str, i: Natural, what: str) -> str:
    """The argument after position i, or an error naming the option."""
    if i + 1 >= argv'Length:
        die(what + " needs a value")
    return argv[i + 1]


# What goes to grep before the caller's own arguments; also the measure of
# whether the caller gave any, which is what says a search pattern is missing.
let DEFAULT_GREP_PARAMS: []str = ["--line-number", "--with-filename"]


class Options:
    """What the command line decided.

    One object rather than a dozen module-level vars: the searching procs
    below read half of these and the two that write them are `parse` and
    `resolve`, which is a great deal easier to see when the state has a name
    and a scope.
    """
    closure        : str  = ""      # -closure: the system or baseline to search
    subsys_pattern : str  = ""      # -subsys
    file_pattern   : str  = "*"     # -fpat, or -ada's "*.ad?"
    path_pattern   : str  = ""      # -ppat
    good           : str  = ""      # -latest_good: "" or "_GOOD"
    verbose        : bool = False
    basenames      : bool = False
    use_grep       : bool = True    # not -no-grep
    skip_projects  : bool = True    # not -all
    ada            : bool = False
    fpat_given     : bool = False   # -fpat, which -ada may not also be
    sort_output    : bool = False
    with_colors    : bool = stdout_is_tty()          # -no_colors turns it off
    grep_params    : []str = DEFAULT_GREP_PARAMS     # the caller's part is added

    def parse(self, argv: []str):
        """The command line, option by option."""
        var i: Natural = 0
        var in_grep_args: bool = False
        while i < argv'Length:
            let arg: str = argv[i]
            if in_grep_args:
                # Past the options: the rest belongs to grep, `-` and all.
                # A new list rather than an append: the declared default is
                # one object, and on the Python backend appending to it would
                # be appending to the default itself.
                self.grep_params = self.grep_params + [arg]
                i += 1
                continue
            # How many arguments this option takes: the shell version's `shift`
            # count, and zero for the one that ends the options without being
            # one itself.
            var eaten: Natural = 1
            case arg:
                when "-?" | "-help":         print_help(False)
                when "-ht" | "-html":        print_help(True)
                when "-ada":
                    self.ada = True
                    self.file_pattern = "*.ad?"
                when "-all":                 self.skip_projects = False
                when "-latest_good":         self.good = "_GOOD"
                when "-no-grep":             self.use_grep = False
                when "-basenames":           self.basenames = True
                when "-verbose":             self.verbose = True
                when "-no_colors":           self.with_colors = False
                when "-sort":                self.sort_output = True
                when "-closure":
                    self.closure = value_after(argv, i, arg)
                    eaten = 2
                when "-fpat":
                    self.file_pattern = value_after(argv, i, arg)
                    self.fpat_given = True
                    eaten = 2
                when "-ppat":
                    self.path_pattern = value_after(argv, i, arg)
                    eaten = 2
                when "-subsys":
                    self.subsys_pattern = value_after(argv, i, arg)
                    eaten = 2
                when "--":
                    # The explicit end of the options.
                    in_grep_args = True
                when others:
                    # Anything else is the search pattern: it belongs to grep,
                    # and it is not consumed here.
                    in_grep_args = True
                    eaten = 0
            i += eaten
        self.resolve()

    def resolve(self):
        """What the options mean together, and what they may not mean at all.

        The end of `parse`: an option is not done being read until it has
        been read against the others, and nothing between the two calls
        could have wanted the options half-read.
        """
        if self.use_grep and self.grep_params'Length == DEFAULT_GREP_PARAMS'Length:
            die("a search pattern must be defined. Use -no-grep if you want to list the files searched.")
        if not self.use_grep and self.grep_params'Length > DEFAULT_GREP_PARAMS'Length:
            stderr.writeLine(PROG + ": warning: the search pattern will be ignored since -no-grep is used.")
        if self.closure != "" and (self.subsys_pattern != "" or not self.skip_projects):
            die("option -closure cannot be used with -all or -subsys")
        if self.ada and self.fpat_given:
            die("-ada and -fpat cannot be used at the same time")
        if self.with_colors:
            self.grep_params = self.grep_params + ["--color=always"]


# The object the searching procs below read. It holds the defaults from here
# until the command line is read, which is the last thing this file does: the
# declaration has to precede its readers, the parsing does not.
var opt: Options = Options()

def note(what: str):
    """What the program decided, for -verbose. On stderr: it is not a result."""
    if opt.verbose:
        stderr.writeLine(PROG + ": " + what)


# ---------------------------------------------------------------------------
# Where to search
# ---------------------------------------------------------------------------

def replace_first(text: str, old: str, new: str) -> str:
    """TEXT with the first OLD replaced -- the shell's ${var/old/new}.

    `replace` changes every occurrence on both backends, and a baseline ID
    has more dots than the one that is a directory separator.
    """
    let at: int = text.find(old)
    if at < 0:
        return text
    return text[0:at] + new + text[at + len(old):]

def after_first(text: str, marker: str) -> str:
    """What follows the first MARKER -- the shell's ${var#*<marker>}.

    Everything before it goes too, which is the whole point: a build resolves
    to a path like /auto/local_build/dhws149/ssd1/cm/ot/CUA/ADMIN.44.0.0.A,
    and the baseline ID is what comes after /cm/ot/. Removing the marker and
    keeping the prefix leaves .auto.local_build... instead, which is not a
    baseline ID and matches no pattern that describes one.
    """
    let at: int = text.find(marker)
    if at < 0:
        return text
    return text[at + len(marker):]

def matches_runtime(text: str, pattern: str) -> bool:
    """`text` against a pattern that is not known until the program runs.

    A regex literal is a literal, so a pattern read from cc_pattern or from
    an option cannot be one; grep's exit status is the whole answer.
    """
    let (_, rc) = shell(stdin = text + "\n"): grep -qE -- {!pattern}
    return rc == 0

def matches_runtime_i(text: str, pattern: str) -> bool:
    """The same, ignoring case: what -ppat and -subsys are matched with."""
    let (_, rc) = shell(stdin = text + "\n"): grep -qiE -- {!pattern}
    return rc == 0

def shell_capture(cmd: str) -> str:
    """One line of output from a CM helper, which lives in the ksh environment."""
    let r = shell: {cmd}
    return r.output.strip()

def closure_dir(name: str) -> Path:
    """The directory holding the closure named on the command line.

    The name is an identifier rather than a path -- a SYSTEM, a baseline ID
    -- which is why it arrives as a str; what comes back is a directory.

    A SYSTEM resolves through its topmost subsystem, and the view context
    wins when it names a baseline of that same system; a baseline ID is
    already a path with its first dot turned into a slash.
    """
    if not matches_runtime(name, "^" + shell_capture("cc_pattern SYSTEM")):
        return Path(replace_first(name, ".", "/"))
    let topmost: str = shell_capture("get_topmost_subsystems " + name).split()[0]
    let prefix: str = name + "." + topmost + "."
    if $CONTEXT_CM_BASELINE.startswith(prefix):
        return Path(replace_first($CONTEXT_CM_BASELINE, ".", "/"))
    return Path(name) / (topmost + ".LATEST" + opt.good)

def all_subsystem_builds() -> []Path:
    """Every subsystem whose LATEST build has sources, less the project branches.

    `ls` rather than a glob because the pattern spans two directory levels,
    and the `[0-9].LATEST` exclusion is what keeps numbered project builds
    out when -all is not given.
    """
    let build_dir: str = "build_" + $CM_ENV_ID
    let good: str = opt.good
    var out: []Path = []
    let listing: []str = shellLines: ls -1d {CM_OT}/*/*[A-Z].LATEST{good}/{build_dir}/sources 2>/dev/null
    for line in listing:
        continue if line == /[0-9]\.LATEST/
        out.append(Path(line.replace("/" + build_dir + "/sources", "")))
    return out

def matching_lines(lines: []str, pattern: str, fold_case: bool) -> []bool:
    """Which of these lines match the pattern -- one grep for the whole list.

    A grep for each line is a process for each line, and the lists here are
    as long as the site has subsystems. `grep -n` numbers the lines it keeps,
    which is enough to say yes or no about each one without asking again.

    This is for -ppat and -subsys, which the shell version matches with
    `grep -Ei` too.
    """
    let numbers: str = capture_numbers(lines, "grep", pattern, fold_case)
    return numbered_hits(numbers, lines'Length)

def perl_matching_lines(lines: []str, pattern: str) -> []bool:
    """The same, judged by perl.

    cc_pattern's patterns are perl regexps and the shell version tests them
    with perl. `grep -E` is a different language: given one of them it warns,
    matches nothing, and every subsystem looks like a project branch -- which
    is a search of everything or a search of nothing, depending on which way
    the answer is read. Nothing said so, because no match is a valid answer.
    """
    let numbers: str = capture_numbers(lines, "perl", pattern, False)
    return numbered_hits(numbers, lines'Length)

def capture_numbers(lines: []str, engine: str, pattern: str, fold_case: bool) -> str:
    """The 1-based numbers of the lines that match, one per line.

    Both engines are asked the same way -- the list on stdin, the pattern as
    an argument rather than inside the command text, since it is a regexp
    full of the characters a shell also wants.
    """
    if lines'Length == 0:
        return ""
    let text: str = "\n".join(lines) + "\n"
    if engine == "perl":
        # -s sets $pat from -pat=..., so the pattern needs no quoting inside
        # the program; -l supplies the newline print would otherwise spell.
        let r = shell(stdin = text): perl -s -l -n -e 'print $. if /^$pat$/' -- -pat={!pattern}
        if r.code != 0:
            # A pattern perl cannot compile leaves no output, which reads as
            # "nothing matched" and is not the same thing at all.
            stderr.writeLine(PROG + ": warning: perl could not use the pattern "
                             "(status " + str(r.code) + "): " + r.stderr.strip())
        return r.output
    var flags: str = "-nE"
    if fold_case:
        flags = "-niE"
    let g = shell(stdin = text): grep {flags} -- {!pattern}
    var out: []str = []
    for numbered in g.output.split("\n"):
        continue if numbered == ""
        let at: int = numbered.find(":")
        continue if at < 0
        out.append(numbered[0:at])
    return "\n".join(out)

def numbered_hits(numbers: str, count: Natural) -> []bool:
    """A line number per line, turned into a yes or no for each of `count`."""
    var hits: []bool = []
    for i in range(count):
        hits.append(False)
    for line in numbers.split("\n"):
        continue if line == ""
        # Through a name of its own: int() straight off the loop variable is
        # an int conversion on the Nim side rather than a parse.
        let counted: str = line
        let idx: int = int(counted) - 1
        if idx >= 0 and idx < count:
            hits[idx] = True
    return hits

def ordinary_builds(dirs: []Path) -> []Path:
    """The builds a search without -all wants: the project branches dropped.

    A baseline ID is the resolved path under /cm/ot with its slash and its
    '!' turned into dots -- ELD/GEO_MMI!INM_IO.9 reads as ELD.GEO_MMI.INM_IO.9
    -- and a directory is kept when that matches the pattern cc_pattern gives
    for PROJECT_BASELINE_ID. Kept when it *matches*, which is what the shell
    version's perl filter does:

        if echo "${PROJECT_BASELINE_ID}" | perl -ne "exit 1 if ! /^${PAT}$/"

    The name says project and the effect is the opposite -- a project branch
    build is what does not match -- which is what the "?? This is bizarre"
    comment beside it is about. Reading it as its name suggests and dropping
    the matches instead searches every project branch as well: 200 subsystems
    where the shell version searches 165, a whole system again for each of
    its branches.

    One readlink and one perl for the list, rather than two processes for
    each subsystem: at a few hundred subsystems that was the better part of a
    second before the first file was looked at.
    """
    if dirs'Length == 0:
        return dirs
    if which("perl") is None:
        stderr.writeLine(PROG + ": warning: no perl, so project branch builds "
                         "cannot be told apart; searching them too, as -all does.")
        return dirs
    note("subsystems listed: " + str(dirs'Length))
    let pattern: str = shell_capture("cc_pattern PROJECT_BASELINE_ID")
    note("baseline pattern: " + pattern)
    # readlink takes the whole list; its output is one line per argument, in
    # the order given, which is what lines the answers up with the dirs.
    let resolved = shell: readlink -m {*dirs}
    let real: []str = resolved.output.split("\n")
    if real'Length > 0:
        note("first resolved path: " + real[0])

    var baselines: []str = []
    for i in range(dirs'Length):
        var line: str = str(dirs[i])
        if i < real'Length and real[i] != "":
            line = real[i]
        let tail: str = after_first(line, CM_MARKER)
        baselines.append(replace_first(replace_first(tail, "/", "."), "!", "."))

    if baselines'Length > 0:
        note("first baseline: " + baselines[0])
    let hits: []bool = perl_matching_lines(baselines, "^" + pattern + "$")
    var kept: []Path = []
    for i in range(dirs'Length):
        continue if not hits[i]
        kept.append(dirs[i])
    note("kept after the project-branch filter: " + str(kept'Length))
    if kept'Length == 0:
        # Every subsystem a project branch is not an answer, it is a pattern
        # that did not work. Saying so beats searching nothing in silence.
        stderr.writeLine(PROG + ": warning: no subsystem matched the baseline "
                         "pattern, so there is nothing to search. Use -all to "
                         "search them all.")
    return kept

# ---------------------------------------------------------------------------
# Searching one subsystem
# ---------------------------------------------------------------------------

def search_one(subsys: Path, out_file: Path, err_file: Path) -> Job:
    """Everything one subsystem needs, as a single pipeline into a file.

    The stages are the ksh original's, and for its reason: grep starts on
    the first paths while find is still walking the tree, and a file list
    that runs to tens of thousands of lines never leaves the shell. `cat`
    stands in for a stage the options did not ask for, which is what the
    shell version does and what the stage costs when it is not wanted.

    The output goes to a file rather than back through a pipe. A pipe has
    to be drained by this process while the child writes to it, so with a
    few hundred subsystems this process sits in the middle of every byte
    and polls every pipe to get it; a file lets each child write at its own
    speed and lets this one sleep until there is something to print.
    """
    let build: str = "build_" + $CM_ENV_ID
    var dirs: []Path = [subsys / build / "sources"]
    if -d (subsys / "sources" / "special_files"):
        dirs.append(subsys / build / "special_files")
    let pattern: str = opt.file_pattern

    var sorting: str = "cat"
    if opt.sort_output:
        sorting = "sort"
    # The pattern reaches grep through the environment rather than through
    # the command text: it is the caller's, and it is not ours to quote.
    var filtering: str = "cat"
    if opt.path_pattern != "":
        filtering = 'grep -Ei -- "$PPAT"'
    # -basenames cuts the dirname off grep's `path/to/file:12:line`. The
    # [^:]*/ matches everything up to the last slash before the colon.
    var naming: str = "cat"
    if opt.basenames:
        naming = "sed 's@[^:]*/@@'"
    let stage_env: {str}str = {"PPAT": opt.path_pattern}
    let dest: str = str(out_file)
    let problems: str = str(err_file)
    # The pipeline is bracketed before it is redirected: a bare `2>` at the
    # end catches the last stage's complaints and nobody else's, and the one
    # with something to say is grep, in the middle.

    if not opt.use_grep:
        # A listing keeps its paths whole, as it does in the shell version.
        let lister: Job = shellSpawn(env = stage_env): ( find {*dirs} -type f ! -name '*.gz' -name {!pattern} 2>/dev/null | {sorting} | {filtering} ) > {!dest} 2> {!problems}
        return lister
    let params: []str = opt.grep_params
    let searcher: Job = shellSpawn(env = stage_env): ( find {*dirs} -type f ! -name '*.gz' -name {!pattern} 2>/dev/null | {sorting} | {filtering} | xargs -r grep {*params} -- | {naming} ) > {!dest} 2> {!problems}
    return searcher

def header_for(subsys: Path) -> str:
    """The `!===== SUBSYS ====...` line, padded to a constant width."""
    let name: str = str(subsys.name)
    return "!===== " + name + " " + PADDING[len(name):]

def report(what: str, seconds: float):
    """Where the time went, for -verbose. On stderr: it is not a result."""
    note(what + " " + str(seconds) + "s")

def search(subsystems: []Path):
    """Search every subsystem at once, and print each one as it finishes.

    The waiting is one subsystem at a time, in order, and the others carry
    on while it is waited for: they write to their own files and need
    nothing from this process until their turn comes. So the first
    subsystem's results appear as soon as it is done rather than when the
    slowest one is, and a search that takes a minute shows its work.
    """
    let started: float = time.time()
    let tmp_dir: Path = Path(shell_capture("mktemp -d"))
    var jobs: []Job = []
    var outs: []Path = []
    var errs: []Path = []
    var n: Natural = 0
    for subsys in subsystems:
        let out_file: Path = tmp_dir / (str(n) + ".out")
        let err_file: Path = tmp_dir / (str(n) + ".err")
        outs.append(out_file)
        errs.append(err_file)
        jobs.append(search_one(subsys, out_file, err_file))
        n += 1
    report("started " + str(n) + " subsystem searches in", time.time() - started)

    for idx in range(len(subsystems)):
        let subsys: Path = subsystems[idx]
        # The pipeline's own status says nothing a search wants to know --
        # grep reports 1 when a subsystem simply has no match -- so this is
        # the wait, not the answer. The answer is in the two files.
        let finished: RunResult = jobs[idx].wait()
        report(str(subsys.name) + " done at", time.time() - started)
        # Without a closure the search is long enough that showing where it
        # has got to is worth a line; with one, only -verbose asks for it.
        if opt.closure == "" or opt.verbose:
            print header_for(subsys)
        # An unknown option, an unreadable file: grep says so on stderr, and
        # the pipeline put that in a file rather than letting it reach the
        # terminal out of order. Unprinted it is an empty result and a zero
        # status, which is what a mistyped grep argument looked like.
        let complaints: str = readFile(str(errs[idx])).strip()
        if complaints != "":
            stderr.writeLine(complaints)
        let text: str = readFile(str(outs[idx]))
        continue if text.strip() == ""
        print text.rstrip("\n")

    let cleanup: str = str(tmp_dir)
    let rc: int = shell: rm -rf {!cleanup}
    report("total", time.time() - started)

# ---------------------------------------------------------------------------
# Run
# ---------------------------------------------------------------------------

let args: []str = $@
if args'Length == 0:
    print usage()
    quit(0)

opt.parse(args)

var targets: []Path = []

if opt.closure != "":
    let dir_name: Path = closure_dir(opt.closure)
    if opt.verbose:
        print "Closure     : " + replace_first(str(dir_name), "/", ".")
    # Psort orders the closure the way the CM tools do; the environment
    # variable is read into a name first, since an interpolation is an
    # expression and `$NAME` is not one inside it.
    let cm_root: Path = Path($CM_ROOT)
    let closure_path: Path = cm_root / dir_name
    let ordered: []str = shellLines: echo {!closure_path} | Psort
    for line in ordered:
        targets.append(Path(line))
else:
    targets = all_subsystem_builds()
    if opt.skip_projects:
        targets = ordinary_builds(targets)
    if opt.subsys_pattern != "":
        var names: []str = []
        for d in targets:
            names.append(str(d))
        let hits: []bool = matching_lines(names, opt.subsys_pattern, True)
        var matched: []Path = []
        for i in range(targets'Length):
            continue if not hits[i]
            matched.append(targets[i])
        targets = matched
    if opt.verbose and opt.subsys_pattern != "":
        print "Subsys pattern: " + opt.subsys_pattern

if opt.verbose:
    print "ada option  : " + str(opt.ada)
    print "sort option : " + str(opt.sort_output)
    print "File pattern: " + opt.file_pattern
    if opt.use_grep:
        print "Grep params : " + " ".join(opt.grep_params)
    else:
        print "Grep params : no grep"

search(targets)
