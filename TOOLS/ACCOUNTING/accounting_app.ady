#!/usr/bin/env ady2nim
#ady2nim-args js
"""The books of the ledger, drawn in the browser and kept by clicking: the
accounts are nodes to drag, the money that moved between them arrows, and
a click, a dragged arrow and an amount record a transaction.

    make app       (builds the page and ledger_server, runs it, opens the page)

ledger_server.ady serves this page and the books (books_text.ady); the page
asks for the books when it starts and after each change. A transaction or an
account is checked here first, as the ledger checks it (Graph.check), then
sent to the server, which records it unless the books refuse it.

Needs karax: `nimble install karax@1.5.0`.
"""
from dom nimport Event, MouseEvent, BoundingRect, document, window, getElementById, getBoundingClientRect, addEventListener
from dom nimport value, Element, InputElement, confirm, prompt, focus, setTimeout, TimeOut, KeyboardEvent
from karax/karax nimport setRenderer, redraw
from math nimport sqrt
from karax/kajax nimport ajaxGet, ajaxPost
from accounting_model import Account, BookFailure_T, Cents_T, Entry, Flow, Graph, Kind_T, VatRate_T, entry, purchase_with_vat, sale_with_vat, vat_text
from accounting_gui import STYLE, GRAPH_TEXT, NODE_RADIUS, Point, css_of, money, px, signed, toward, bend_of, tip_of, account_tip, to_html, section_html, sections_after_graph
from books_text import AccountRow, Books, account_line, entry_lines, graph_of, kind_named, kind_text, parse_books

const WIDTH: float = 980.0
const HEIGHT: float = 670.0
const TOP_Y: float = 50.0 + 40.0        # the first row, under the side's title
const ROW_STEP: float = 120.0
const LABEL_ROOM: float = 50.0          # under the horizontal line, the profit and loss's titles

# Account number A before B: by length, then digit by digit.
def number_before(a: str, b: str) -> bool:
    return len(a) < len(b) or (len(a) == len(b) and a < b)

const LIVE_STYLE: str = """
g.node { cursor: grab; }
g.from circle { stroke: #c62828; stroke-width: 5; stroke-dasharray: 8 4; }
g.from { cursor: crosshair; }
path.rubber { fill: none; stroke: #c62828; stroke-width: 2.5; stroke-dasharray: 6 4; marker-end: url(#arrow); pointer-events: none; }
div.backdrop { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.25); z-index: 10; }
div.popup { position: fixed; top: 20%; left: 50%; transform: translateX(-50%); z-index: 11; background: #fff;
            border-radius: 8px; box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3); padding: 0.6em 1.4em 1em; min-width: 26em; }
div.popup label { display: block; margin: 0.5em 0 0.15em; font-size: 0.9em; color: #444; }
div.popup input, div.popup select { font-size: 1em; width: 100%; box-sizing: border-box; }
