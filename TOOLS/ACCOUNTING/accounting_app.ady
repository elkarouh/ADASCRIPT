"""

const FIRST_ROW: float = 90.0          # the first row of accounts, below the top of its quarter's title
const TITLE_HALF: float = 75.0         # half the width of a quarter's title, roughly
const BOX_GAP: float = 8.0            # between boxes stacked in a column
const COLUMN: float = 150.0            # the least width an account takes in a row

# How many accounts fit side by side in a quarter WIDTH wide, at most N,
# drawn as SHAPE: boxes are stacked one above the other.
def columns_for(n: int, width: float, shape: Shape) -> int:
    if shape.boxes:
        return 1
    return max(1, min(n, int((width - 20.0) / COLUMN)))

# How many rows N accounts take in a quarter WIDTH wide.
def rows_for(n: int, width: float, shape: Shape) -> int:
    if n == 0:
        return 0
    let cols: int = columns_for(n, width, shape)
    return (n + cols - 1) // cols

# Where each account sits, starting where accounting_gui.ady puts it.
@virtual
class Layout:
    var names: []str
    var points: []Point
    var lefts: []bool                   # each account's quadrant: left of the vertical line (activa, costs)
    var tops: []bool                    # and above the horizontal one (activa, passiva)
    var tall: []float                   # each account's half height: a box grows with its arrows
    var order: []str                    # the accounts in the order Tidy up found best, or [] (by number)
    var held: int = -1                  # the account being dragged, or -1
    var tip: str = ""                   # what the arrow under the mouse lists, or ""
    var mouse_x: float = 0.0            # where the mouse is, in the drawing's units
    var mouse_y: float = 0.0
    var width: float = WIDTH            # the drawing's size: WIDTH x HEIGHT, or the window's when graph_only
    var height: float = HEIGHT
    var graph_only: bool = False        # True: the graph and its transactions, without the text and the other tables
    var grabbed_x: float = 0.0          # where the held account was grabbed: a press that
    var grabbed_y: float = 0.0          # does not move it is a click, which picks it
    var source: str = ""                # the frozen account, where the money leaves, or ""
    var target: str = ""                # the account the arrow from it was dropped on, or ""
    var drawing: bool = False           # an arrow is being drawn from the frozen account
    var popup: bool = False             # the transaction's popup is open
    var split_x: float = WIDTH / 2.0      # the vertical line: Activa left, Passiva right
    var pl_y: float = 0.0               # the horizontal line above the profit and loss
    var page_height: float = HEIGHT       # the drawing's height in the page, kept while the graph is alone
    var top_y: float = 0.0              # the top of the balance sheet (moved down with the graph alone)
    var has_pl: bool = False            # whether there are costs or revenue to put below it
    var as_boxes: bool = True           # the accounts drawn as boxes, stacked, rather than circles
    var crossing: bool = False          # the lines' crossing is being dragged, to resize the quarters

    # The accounts laid out as a balance sheet: a vertical line, the assets
    # (Activa) left of it and equity and debts (Passiva) right; below a
    # horizontal line the profit and loss, costs left and revenue right, as
    # the Belgian layout has them. Each quarter in account-number order, as
    # many to a row as its width takes; dragging the lines' crossing resizes
    # the quarters. Laid out again whenever the accounts change, so a new one lands in
    # its place; dragging moves one until then.
    def shape(self) -> Shape:
        return (boxes() if self.as_boxes else circles())

    # The shape of account I: a box as high as its arrows need.
    def shape_of(self, i: int) -> Shape:
        let shape: Shape = self.shape()
        return Shape(shape.boxes, shape.half_w, self.tall[i])

    # Where a quarter's first row sits below the top of its title, how far
    # apart its rows are, and how narrow a quarter may be.
    def first_row(self) -> float:
        return (55.0 if self.as_boxes else FIRST_ROW)

    def row_step(self) -> float:
        return (40.0 if self.as_boxes else ROW_STEP)

    def narrowest(self) -> float:
        return (2.0 * self.shape().half_w + 100.0 if self.as_boxes else COLUMN)    # boxes: room for the brackets beside them

    def sync(self, rows: []AccountRow):
        var same: bool = len(rows) == len(self.names)
        for r in rows:
            if r.name not in self.names:
                same = False
        if not same:
            self.arrange(rows)
        elif self.as_boxes:                     # a box grown or shrunk: its column stacked again, in its order
            var changed: bool = False
            for i in range(len(self.names)):
                if tall_of(self.names[i]) != self.tall[i]:
                    changed = True
            if changed:
                self.order = self.names_by_height()
                self.fill(rows)
        if not self.graph_only:
            self.height = 300.0                 # as tall as the accounts need
            for i in range(len(self.points)):
                self.height = max(self.height, self.points[i].y + self.tall[i] + 30.0)

    # The accounts from the top of the drawing down, as they now sit.
    def names_by_height(self) -> []str:
        var ys: []float = []
        var found: []str = []
        for i in range(len(self.names)):
            var j: int = len(found)
            found.append(self.names[i])
            ys.append(self.points[i].y)
            while j > 0 and ys[j] < ys[j - 1]:
                let y: float = ys[j]
                ys[j] = ys[j - 1]
                ys[j - 1] = y
                let n: str = found[j]
                found[j] = found[j - 1]
                found[j - 1] = n
                j -= 1
        return found

    # The lines where they start: the vertical one in the middle, the
    # horizontal one below the taller of the two balance-sheet quarters.
    def arrange(self, rows: []AccountRow):
        self.split_x = self.width / 2.0
        self.top_y = 0.0
        var activa: int = 0
        var passiva: int = 0
        var activa_h: float = 0.0               # how high the boxes stack
        var passiva_h: float = 0.0
        self.has_pl = False
        for r in rows:
            case r.kind:
                when ASSET:
                    activa += 1
                    activa_h += 2.0 * tall_of(r.name) + BOX_GAP
                when LIABILITY | EQUITY:
                    passiva += 1
                    passiva_h += 2.0 * tall_of(r.name) + BOX_GAP
                when EXPENSE | REVENUE:
                    self.has_pl = True
        let shape: Shape = self.shape()
        if self.as_boxes:
            self.pl_y = self.top_y + 40.0 + max(max(activa_h, passiva_h), 40.0) + 24.0
        else:
            let top_rows: int = max(rows_for(activa, self.split_x, shape), rows_for(passiva, self.width - self.split_x, shape))
            self.pl_y = self.top_y + self.first_row() + float(max(top_rows, 1) - 1) * self.row_step() + shape.half_h + 54.0
        self.fill(rows)

    # The accounts placed in their quarters as the lines now divide them,
    # each quarter in account-number order, row by row.
    def fill(self, rows: []AccountRow):
        var sorted: []AccountRow = rows
        for i in range(1, len(sorted)):          # by number: few accounts, an insertion sort
            var j: int = i
            while j > 0 and number_before(sorted[j].number, sorted[j - 1].number):
                let t: AccountRow = sorted[j]
                sorted[j] = sorted[j - 1]
                sorted[j - 1] = t
                j -= 1
        if len(self.order) > 0:                 # Tidy up's order first, any other account after
            var ordered: []AccountRow = []
            for name in self.order:
                for r in sorted:
                    if r.name == name:
                        ordered.append(r)
            for r in sorted:
                if r.name not in self.order:
                    ordered.append(r)
            sorted = ordered
        var activa: []str = []
        var passiva: []str = []
        var costs: []str = []
        var revenue: []str = []
        for r in sorted:
            case r.kind:
                when ASSET:
                    activa.append(r.name)
                when LIABILITY | EQUITY:
                    passiva.append(r.name)
                when EXPENSE:
                    costs.append(r.name)
                when REVENUE:
                    revenue.append(r.name)
        self.names = []
        self.points = []
        self.lefts = []
        self.tops = []
        self.tall = []
        let x: float = self.split_x
        let bottom: float = (self.height if self.graph_only else -1.0)     # in the page, the drawing grows
        self.place_in(activa, 0.0, x, self.top_y + 30.0, self.pl_y, True, True)
        self.place_in(passiva, x, self.width, self.top_y + 30.0, self.pl_y, False, True)
        self.place_in(costs, 0.0, x, self.pl_y + 30.0, bottom, True, False)
        self.place_in(revenue, x, self.width, self.pl_y + 30.0, bottom, False, False)

    # NAMES in rows across the quarter from X0 to X1, from Y0 (below its
    # title) down, in the quarter LEFT and TOP say. If they would pass Y1
    # (-1: no limit), the rows come closer and, if need be, more columns.
    def place_in(self, names: []str, x0: float, x1: float, y0: float, y1: float, left: bool, top: bool):
        let n: int = len(names)
        if n == 0:
            return
        if self.as_boxes:
            self.stack_in(names, x0, x1, y0, y1, left, top)
            return
        let half_h: float = self.shape().half_h
        let first: float = y0 + self.first_row() - 30.0
        let closest: float = 2.0 * half_h + 6.0             # rows no closer than this
        var cols: int = columns_for(n, x1 - x0, self.shape())
        if y1 > 0.0:                                        # too many rows to fit: more, narrower columns
            let fit: int = max(1, int((y1 - first - half_h - 10.0) / closest) + 1)
            cols = max(cols, min(n, (n + fit - 1) // fit))
        let width: float = (x1 - x0) / float(cols)
        let rows: int = (n + cols - 1) // cols
        var step: float = self.row_step()
        if y1 > 0.0 and rows > 1:
            let room: float = y1 - first - half_h - 10.0
            step = min(step, max(room / float(rows - 1), closest))
        for i in range(n):
            self.names.append(names[i])
            self.lefts.append(left)
            self.tops.append(top)
            self.points.append(Point(x0 + width * (float(i % cols) + 0.5), first + step * float(i // cols)))
            self.tall.append(half_h)

    # Boxes stacked down the quarter from X0 to X1, from Y0 (below its
    # title), each as high as its arrows need; in more columns if one would
    # pass Y1 (-1: no limit).
    def stack_in(self, names: []str, x0: float, x1: float, y0: float, y1: float, left: bool, top: bool):
        let n: int = len(names)
        var talls: []float = []
        for name in names:
            talls.append(tall_of(name))
        var cols: int = 1
        while y1 > 0.0 and cols < n and stack_height(talls, cols) > y1 - y0 - 20.0:
            cols += 1
        let width: float = (x1 - x0) / float(cols)
        var tops_at: []float = []
        for c in range(cols):
            tops_at.append(y0 + 10.0)
        for i in range(n):
            let c: int = i % cols
            self.names.append(names[i])
            self.lefts.append(left)
            self.tops.append(top)
            self.points.append(Point(x0 + width * (float(c) + 0.5), tops_at[c] + talls[i]))
            self.tall.append(talls[i])
            tops_at[c] += 2.0 * talls[i] + BOX_GAP

    # A transaction is drawn: a click on an account freezes it (it no longer
    # moves), an arrow is dragged from it to another account, and letting go
    # there opens the popup. A click on the frozen account, or Escape, lets
    # it go.
    # Another scenario's accounts: they start where the example puts them.
    def reset(self):
        self.names = []
        self.points = []
        self.lefts = []
        self.tops = []
        self.tall = []
        self.order = []
        self.held = -1
        self.tip = ""
        self.height = (self.height if self.graph_only else HEIGHT)
        self.unfreeze()

    def unfreeze(self):
        self.source = ""
        self.target = ""
        self.drawing = False
        self.popup = False

    def open_popup(self, target: str):
        self.target = target
        self.popup = True
        self.tip = ""

    # A press on account A: on the frozen one it starts an arrow, on any
    # other it grabs the account, to move it or, if it does not move, to
    # click it.
    def press(self, a: Account):
        if self.popup:
            return
        if a.name == self.source:
            self.drawing = True
            self.grabbed_x = self.mouse_x
            self.grabbed_y = self.mouse_y
            self.tip = ""
        else:
            self.grab(a)

    # The account under (X, Y), or "".
    def node_at(self, x: float, y: float) -> str:
        for i in range(len(self.points)):
            if covers(self.points[i], Point(x, y), self.shape_of(i), 0.0):
                return self.names[i]
        return ""

    def still(self) -> bool:
        return abs(self.mouse_x - self.grabbed_x) < 4.0 and abs(self.mouse_y - self.grabbed_y) < 4.0

    # The mouse let go: an arrow ends on its target, or a click lets the
    # frozen account go; a held account is dropped, or, if it did not move
    # and none is frozen, frozen. Only an arrow dragged onto an account opens
    # the popup: a click on it, or the mouse passing over it, does not.
    def release(self):
        if self.crossing:
            self.crossing = False
            tidy()                              # the accounts into their new quarters
        elif self.drawing:
            self.drawing = False
            let under: str = self.node_at(self.mouse_x, self.mouse_y)
            if under != "" and under != self.source:
                arrow_drawn(under)
            elif under == self.source and self.still():
                self.unfreeze()
        elif self.held >= 0:
            let name: str = self.names[self.held]
            let clicked: bool = self.still()
            self.held = -1
            if clicked and self.source == "":
                self.source = name

    def index(self, a: Account) -> int:
        for i in range(len(self.names)):
            if self.names[i] == a.name:
                return i
        raise KeyError(f"no account {a.name}")

    def at(self, a: Account) -> Point:
        return self.points[self.index(a)]

    def grab_crossing(self):
        if not self.popup and not self.drawing:
            self.crossing = True
            self.tip = ""

    def grab(self, a: Account):
        self.held = self.index(a)
        self.grabbed_x = self.mouse_x
        self.grabbed_y = self.mouse_y
        self.tip = ""

    # The browser shows an SVG <title> as a tooltip, but karax builds this
    # one outside SVG, so the live page draws its own, in the drawing: a box
    # of the tip's lines beside the mouse, on the side that has room.
    def show(self, tip: str):
        if self.held < 0 and not self.drawing and not self.popup:
            self.tip = tip

    def hide(self):
        self.tip = ""

    def tip_html(self) -> Html:
        let lines: []str = self.tip.split("\n")
        var widest: int = 0
        for line in lines:
            widest = max(widest, len(line))
        let w: float = float(widest) * 6.2 + 16.0
        let h: float = float(len(lines)) * 15.0 + 8.0
        let x: float = (self.mouse_x + 14.0 if self.mouse_x + 14.0 + w <= self.width else max(self.mouse_x - 14.0 - w, 0.0))
        let y: float = (self.mouse_y + 14.0 if self.mouse_y + 14.0 + h <= self.height else max(self.mouse_y - 14.0 - h, 0.0))
        let top: float = y + 16.0
        let left: float = x + 8.0
        html:
            g class="tip":
                rect x=px(x) y=px(y) width=px(w) height=px(h) rx="3"
                for i in range(len(lines)):
                    if i == 0:
                        stext class="tiphead" x=px(left) y=px(top): lines[i]
                    else:
                        stext class="tipline" x=px(left) y=px(top+float(i)*15.0): lines[i]

    # The held account to (X, Y), kept whole inside the drawing.
    # The held account follows the mouse, but stays inside the drawing and
    # inside its quadrant, clear of the quadrant's title: an asset left of
    # the vertical line, a cost below the horizontal one, and so on.
    def move_to(self, x: float, y: float):
        if self.crossing:                       # the lines follow, leaving each quarter room for an account
            self.split_x = min(max(x, self.narrowest()), self.width - self.narrowest())
            self.pl_y = max(y, self.top_y + self.first_row() + self.shape().half_h + 20.0)
            if self.graph_only:
                self.pl_y = min(self.pl_y, self.height - self.first_row() - self.shape().half_h)
        elif self.held >= 0:
            let half_w: float = self.shape().half_w
            let half_h: float = self.tall[self.held]
            var low_x: float = half_w
            var high_x: float = self.width - half_w
            var low_y: float = self.top_y + 30.0 + half_h          # below the titles
            var high_y: float = self.height - half_h
            if self.lefts[self.held]:
                high_x = self.split_x - half_w - 6.0
            else:
                low_x = self.split_x + half_w + 6.0
            if self.has_pl:
                if self.tops[self.held]:
                    high_y = self.pl_y - half_h - 6.0
                else:
                    low_y = self.pl_y + 30.0 + half_h                # below the costs' and revenue's titles
            self.points[self.held] = Point(min(max(x, low_x), high_x), min(max(y, low_y), high_y))

    # The arrow being drawn, from the rim of the frozen account to the mouse.
    def rubber_d(self) -> str:
        let i: int = self.names.index(self.source)
        let a: Point = self.points[i]
        let b: Point = Point(self.mouse_x, self.mouse_y)
        if covers(a, b, self.shape_of(i), 0.0):
            return ""
        let start: Point = rim(a, b, self.shape_of(i), 0.0)
        return f"M {start.x:.1f} {start.y:.1f} L {b.x:.1f} {b.y:.1f}"

    # Where the quarters' titles are written (their middles, and half their
    # widths), so that no amount covers them: right of the vertical line or
    # ending left of it, above the first row and below the horizontal line;
    # and the lines' crossing, which is dragged.
    def title_spots(self) -> []Point:
        var spots: []Point = []
        let ty: float = self.top_y + 24.0
        spots.append(Point(self.split_x - 16.0 - TITLE_HALF, ty))
        spots.append(Point(self.split_x + 16.0 + TITLE_HALF, ty))
        if self.has_pl:
            let by: float = self.pl_y + 26.0
            spots.append(Point(self.split_x - 16.0 - TITLE_HALF, by))
            spots.append(Point(self.split_x + 16.0 + TITLE_HALF, by))
            spots.append(Point(self.split_x, self.pl_y))           # and the lines' crossing
        return spots

    def title_halves(self) -> []float:
        var halves: []float = []
        for s in self.title_spots():
            halves.append(TITLE_HALF)
        if self.has_pl:
            halves[len(halves) - 1] = 12.0                      # the crossing is small
        return halves

    def view_box(self) -> str:
        return f"0 0 {self.width:.0f} {self.height:.0f}"

var layout: Layout = Layout()

# ---------------------------------------------------------------------
# The books, as the server last sent them, and what the page sends it
# ---------------------------------------------------------------------

var books: Books = Books("", [], [], [], "", "")
var graph: Graph = Graph()
var message: str = "Asking the ledger for the books..."
var refused: bool = False               # whether the message says why something was refused
var popup_message: str = ""             # why the popup's transaction cannot be recorded yet

let NO_HEADERS: [](cstring, cstring) = []
var replaced: bool = False              # another scenario, or this one started over: lay it out afresh

# The replay (below): the transactions one at a time
var step: int = -1                      # the transaction shown last; -1: not replaying, all shown
var playing: bool = False
var tab: str = "Transactions"          # which of TABS is showing under the graph
var help_open: bool = False             # the explanations, hidden until Help is pressed
var debit_credit: bool = False          # the journal and accounts as debits and credits, and the T-accounts, not as plus and minus
var exercising: bool = False            # the exercise: the transactions to be drawn, one at a time
var ex_index: int = 0                   # the transaction asked for; the ones before it are solved
var ex_score: int = 0                   # the ones got right at the first try
var ex_tries: int = 0                   # wrong tries at this one
var only: str = ""                      # the account whose transactions alone are replayed, or "": all
var tick_pending: bool = False          # a tick is on its way: no second one
var replayed: Graph = Graph()           # the books up to and with transaction STEP
var now_arrows: []str = []              # its arrows, "source\ttarget"
var now_accounts: []str = []            # the accounts it touches

def say(text: str, is_refusal: bool):
    message = text
    refused = is_refusal

def on_books(status: int, response: cstring):
    if status != 200:
        say(f"The ledger did not answer ({status}): is ledger_server running?", True)
        return
    let read: Books | !BookFailure_T = parse_books(str(response))
    case read:
        when BookFailure_T:
            say("The ledger sent books this page cannot read: " + read.detail, True)
        when Books:
            books = read
            graph = graph_of(books)
            stop_replay()
            if replaced:
                layout.reset()
                replaced = False
            layout.sync(books.accounts)
            if message.startswith("Asking"):
                say("", False)

def load():
    ajaxGet("/books", NO_HEADERS, on_books)

# The scenarios the ledger has, and the one it shows.
var scenario: str = ""
var scenario_names: []str = []
var scenario_titles: []str = []

def discard_timeout(t: TimeOut):
    pass

def pick_shown():
    let picker: Element = document.getElementById("scenario")
    if picker != nil:
        InputElement(picker).value = scenario

def on_scenarios(status: int, response: cstring):
    if status != 200:
        return
    scenario_names = []
    scenario_titles = []
    for line in str(response).split("\n"):
        let f: []str = line.split("\t")
        if f[0] == "current" and len(f) == 2:
            scenario = f[1]
        elif f[0] == "scenario" and len(f) == 3:
            scenario_names.append(f[1])
            scenario_titles.append(f[2])
    discard_timeout(setTimeout(pick_shown, 50))     # once the options are drawn, the one shown picked

def load_scenarios():
    ajaxGet("/scenarios", NO_HEADERS, on_scenarios)

# The server's answer to a change of scenario: the new books, drawn afresh.
def on_switched(status: int, response: cstring):
    let answer: str = str(response)
    if answer == "ok":
        replaced = True                 # the layout starts afresh with the books that come
        load()
        load_scenarios()
    else:
        say(("Refused: " + answer[6:] if answer.startswith("error") else f"The ledger did not answer ({status})"), True)

def choose_scenario():
    let name: str = field_text("scenario")
    if name != scenario:
        say("", False)
        ajaxPost("/scenario", NO_HEADERS, name, on_switched)

def start_over():
    if window.confirm("Start this scenario over? What you changed in it is lost."):
        say("Started over.", False)
        ajaxPost("/start-over", NO_HEADERS, scenario, on_switched)

def save_as():
    let name: str = str(window.prompt("Save these books as a new scenario, named (letters, digits, _ and -):", cstring(scenario & "_mine")))
    if name != "":
        say(f"Saved as {name}.", False)
        ajaxPost("/save-as", NO_HEADERS, name, on_switched)

# The server's answer to a POST: "ok", or "error" and why.
def on_answer(status: int, response: cstring):
    let answer: str = str(response)
    if answer == "ok":
        load()
    else:
        say(("Refused: " + answer[6:] if answer.startswith("error") else f"The ledger did not answer ({status})"), True)

def field_text(id: str) -> str:
    return str(document.getElementById(id).value).strip()

def clear_fields(ids: []str):
    for id in ids:
        InputElement(document.getElementById(id)).value = ""

def kind_of(name: str) -> ?Kind_T:
    for a in books.accounts:
        if a.name == name:
            return a.kind
    return None

# The account whose number starts with PREFIX: 411 is VAT receivable, 451
# VAT payable, in the Belgian chart of accounts.
def account_numbered(prefix: str) -> str:
    for a in books.accounts:
        if a.number.startswith(prefix):
            return a.name
    return ""

# The transaction the form describes: from the picked source to the picked
# target, AMOUNT before VAT. With VAT, a sale (the source is revenue) owes it
# to the tax office, a purchase claims it back.
def form_entry() -> Entry | !BookFailure_T:
    let date: str = field_text("date")
    let what: str = field_text("what")
    if layout.source == "" or layout.target == "":
        return BookFailure_T("Click the account the money leaves, then the one it reaches.")
    if len(date) != 10:
        return BookFailure_T("The date is written 2012-01-31.")
    if what == "":
        return BookFailure_T("Say what happened.")
    do:
        amount <- parse_float(field_text("amount").replace(",", "")) else BookFailure_T("The amount is a number, 605.00.")
        rate <- parse_enum(VatRate_T, field_text("vat")) else BookFailure_T("Pick a VAT rate from the list.")
    let net: Cents_T = Cents_T(int(amount * 100.0 + 0.5))
    if net <= 0:
        return BookFailure_T("The amount is more than zero: the arrow says which way it goes.")
    if rate == NO_VAT:
        return entry(date, what, layout.source, layout.target, net)
    let source_kind: ?Kind_T = kind_of(layout.source)
    let is_sale: bool = source_kind is not None and source_kind == REVENUE
    let vat: str = account_numbered("451" if is_sale else "411")
    if vat == "":
        return BookFailure_T(f"There is no {('VAT payable (451...)' if is_sale else 'VAT receivable (411...)')} account to put the VAT in.")
    if is_sale:
        return sale_with_vat(date, what, layout.source, layout.target, vat, net, rate)
    return purchase_with_vat(date, what, layout.source, layout.target, vat, net, rate)

def record_entry():
    let made: Entry | !BookFailure_T = form_entry()
    if made is BookFailure_T:
        popup_message = made.detail
    else:
        let checked: None | !BookFailure_T = graph.check(made)
        if checked is BookFailure_T:
            popup_message = checked.detail
        else:
            say(f"Recorded: {made.what}", False)
            close_popup()
            ajaxPost("/entry", NO_HEADERS, entry_lines(made), on_answer)

# ---------------------------------------------------------------------
# Closing the year: costs and revenue into retained earnings
# ---------------------------------------------------------------------

const RETAINED: str = "Retained earnings"
var closing_urls: []str = []            # what is left to send, in order: the account, then the entries
var closing_bodies: []str = []

# The equity account the profit goes to: the one numbered 14..., or Retained earnings, to be opened.
def retained_account() -> str:
    let found: str = account_numbered("14")
    return (found if found != "" else RETAINED)

# The day the year ends: 31 December of the last transaction's year.
def year_end() -> str:
    return books.entries[len(books.entries) - 1].date[:4] + "-12-31"

# Whether any cost or revenue account has a balance to close.
def closable() -> bool:
    return len(books.entries) > 0 and len(closing_entries(books, year_end(), RETAINED)) > 0

def closing_answer(status: int, response: cstring):
    if str(response) == "ok" and len(closing_urls) > 0:
        send_closing()
    else:
        closing_urls = []
        closing_bodies = []
        on_answer(status, response)

def send_closing():
    let url: str = closing_urls[0]
    let body: str = closing_bodies[0]
    closing_urls = closing_urls[1:]
    closing_bodies = closing_bodies[1:]
    ajaxPost(url, NO_HEADERS, body, closing_answer)

def close_year():
    if len(books.entries) == 0:
        return
    let date: str = year_end()
    let name: str = retained_account()
    let made: []Entry = closing_entries(books, date, name)
    if len(made) == 0:
        say("Nothing to close: every cost and revenue account is already at zero.", False)
    elif window.confirm(f"Close the year on {date}? The costs and the revenue go to {name}, and the cost and revenue accounts start again from zero."):
        closing_urls = []
        closing_bodies = []
        if account_numbered("14") == "":
            closing_urls.append("/account")
            closing_bodies.append(account_line(AccountRow("140000", EQUITY, RETAINED)))
        for e in made:
            closing_urls.append("/entry")
            closing_bodies.append(entry_lines(e))
        say(f"Closed the year on {date}: the profit is in {name}", False)
        send_closing()

def close_popup():
    popup_message = ""
    layout.unfreeze()

def focus_what():
    let what: Element = document.getElementById("what")
    if what != nil:
        what.focus()

# Transaction I of the books, deleted, once the learner says so.
def delete_entry(i: int):
    let e: Entry = books.entries[i]
    if window.confirm(f"Delete the transaction of {e.date}, {e.what}?"):
        say(f"Deleted: {e.what}", False)
        ajaxPost("/delete-entry", NO_HEADERS, str(books.ids[i]), on_answer)

# Account NAME, deleted, once the learner says so: the ledger refuses while
# a transaction touches it.
def delete_account(name: str):
    if window.confirm(f"Delete the account {name}?"):
        say(f"Deleted: {name}", False)
        if layout.source == name:
            layout.unfreeze()
        ajaxPost("/delete-account", NO_HEADERS, name, on_answer)

def open_account():
    let number: str = field_text("number")
    let name: str = field_text("name")
    let kind: Kind_T | !BookFailure_T = kind_named(field_text("kind"))
    if kind is BookFailure_T:
        say(kind.detail, True)
    elif number == "" or name == "":
        say("An account needs a number and a name.", True)
    else:
        say(f"Opened: {number} {name}", False)
        clear_fields(["number", "name"])
        ajaxPost("/account", NO_HEADERS, account_line(AccountRow(number, kind, name)), on_answer)

# ---------------------------------------------------------------------
# Rendering: the graph at the layout's points, the rest as on the static page
# ---------------------------------------------------------------------

# Account NAME's number in the chart of accounts, or "".
def number_of(name: str) -> str:
    for row in books.accounts:
        if row.name == name:
            return row.number
    return ""

def live_node_html(g: Graph, a: Account) -> Html:
    let p: Point = layout.at(a)
    let number: str = number_of(a.name)
    let tip: str = (account_tip(g, a) if number == "" else number + " " + account_tip(g, a))
    let none: str = ""                  # the page's own tooltip shows it, not a <title>
    let css: str = ("node from" if a.name == layout.source else ("node to" if a.name == layout.target else
                    ("node now" if step >= 0 and a.name in now_accounts else "node")))
    html:
        g class=css onmousedown=layout.press(a) onmouseover=layout.show(tip) onmouseout=layout.hide():
            if layout.as_boxes:
                + box_html(a, p, layout.shape_of(layout.index(a)))
            else:
                + a.to_html(p, none)

def live_arrow_html(g: Graph, f: Flow, route: Route) -> Html:
    let tip: str = tip_of(g, f)
    let css: str = ("now" if step >= 0 and (f.source.name + "\t" + f.target.name) in now_arrows else "")
    let none: str = ""                  # the page's own tooltip shows it, not a <title>
    html:
        g class=css onmouseover=layout.show(tip) onmouseout=layout.hide():
            + f.to_html(route, none)

# How high half a box for account NAME is: room on its side for each of
# its arrows, as many as the more of those coming in and going out (a
# circle is NODE_RADIUS round whatever its arrows).
def tall_of(name: str) -> float:
    if not layout.as_boxes:
        return NODE_RADIUS
    var ins: int = 0
    var outs: int = 0
    for f in graph.flows:
        if f.target.name == name:
            ins += 1
        if f.source.name == name:
            outs += 1
    return max(15.0, 4.5 * float(max(ins, outs)) + 8.0)

# How high NAMES' boxes, half as high as TALLS, stack in COLS columns.
def stack_height(talls: []float, cols: int) -> float:
    var heights: []float = []
    for c in range(cols):
        heights.append(0.0)
    for i in range(len(talls)):
        heights[i % cols] += 2.0 * talls[i] + BOX_GAP
    var most: float = 0.0
    for h in heights:
        most = max(most, h)
    return most

# Whether the straight line from A to B runs over (or close to) account I.
def runs_over(i: int, a: Point, b: Point) -> bool:
    for k in range(1, 10):
        let t: float = float(k) / 10.0
        if covers(layout.points[i], Point(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t), layout.shape_of(i), 10.0):
            return True
    return False

# What a layout costs: the length of its arrows, and a lot more for each
# arrow that runs over another account and so has to bend around it.
def layout_cost() -> float:
    var cost: float = 0.0
    for f in graph.flows:
        let source: int = layout.names.index(f.source.name)
        let target: int = layout.names.index(f.target.name)
        let a: Point = layout.points[source]
        let b: Point = layout.points[target]
        cost += sqrt((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y))
        for i in range(len(layout.points)):
            if i != source and i != target and runs_over(i, a, b):
                cost += 400.0
    return cost

# Tidy up: the accounts laid out afresh in their quarters, then, within each
# quarter, two accounts swapped places whenever that makes the arrows
# shorter or takes one off an account, until no swap helps.
def tidy():
    stop_replay()
    layout.order = []
    layout.fill(books.accounts)
    improve()
    layout.sync(books.accounts)

def toggle_debit_credit():
    debit_credit = not debit_credit

def choose_tab(name: str):
    tab = name

def toggle_help():
    help_open = not help_open

# A explanation, shown only when Help is open.
def help_text(t: str) -> str:
    return (t if help_open else "")

# Within each quarter, two accounts swapped while that helps, and the
# quarters filled again in that order (boxes of other heights restack).
def improve():
    layout.order = layout.names
    var best: float = layout_cost()
    var better: bool = True
    var passes: int = 0
    while better and passes < 8:
        better = False
        passes += 1
        for i in range(len(layout.order)):
            for j in range(i + 1, len(layout.order)):
                if layout.lefts[i] == layout.lefts[j] and layout.tops[i] == layout.tops[j]:
                    let name: str = layout.order[i]
                    layout.order[i] = layout.order[j]
                    layout.order[j] = name
                    layout.fill(books.accounts)
                    let cost: float = layout_cost()
                    if cost < best - 0.5:
                        best = cost
                        better = True
                    else:
                        layout.order[j] = layout.order[i]
                        layout.order[i] = name
    layout.fill(books.accounts)

def debit_credit_button_html() -> Html:
    let dc_label: str = ("Plus and minus" if debit_credit else "Debit and credit")
    html:
        p:
            button id="debit-credit" title="Write the transactions as debits and credits" onclick=toggle_debit_credit(): dc_label

# ---------------------------------------------------------------------
# The replay: the transactions one at a time, each highlighted on the graph
# and in the table, the balances as they stood after it
# ---------------------------------------------------------------------

const STEP_MS: int = 1800                # how long each transaction is shown while playing

# The graph drawn: the books as they stood at STEP while replaying, else all of them.
def shown() -> Graph:
    return (replayed if step >= 0 or exercising else graph)

# Transaction I's arrows and accounts marked, as the one just shown.
def mark_now(i: int):
    var alone: Books = books
    alone.entries = [books.entries[i]]
    now_arrows = []
    for f in graph_of(alone).flows:
        now_arrows.append(f.source.name + "\t" + f.target.name)
    now_accounts = []
    for p in books.entries[i].postings:
        now_accounts.append(p.account)

def replay_to(i: int):
    step = i
    var upto: Books = books
    upto.entries = books.entries[:i + 1]
    replayed = graph_of(upto)
    mark_now(i)

# The transactions replayed, by number: those touching ONLY, or all.
def replayable() -> []int:
    var found: []int = []
    for i in range(len(books.entries)):
        var touches: bool = only == ""
        for p in books.entries[i].postings:
            if p.account == only:
                touches = True
        if touches:
            found.append(i)
    return found

# The replayable transaction D places after (D < 0: before) STEP; from
# the first one if not replaying going forward, the last going back; -1 if
# there is none.
def replayable_by(d: int) -> int:
    let found: []int = replayable()
    if len(found) == 0:
        return -1
    if step < 0:
        return (found[0] if d > 0 else found[len(found) - 1])
    var at: int = -1                    # where STEP is among them, or just before it
    for k in range(len(found)):
        if found[k] <= step:
            at = k
    if at >= 0 and found[at] != step and d < 0:
        at += 1                         # STEP is not one of them: back from the next one
    return found[max(0, min(len(found) - 1, at + d))]

# A frozen account's transactions are the ones replayed, and it lets go.
def replay_frozen():
    if layout.source != "":
        only = layout.source
        layout.unfreeze()

# The days the transactions are dated, once each, in order.
def dates_of() -> []str:
    var days: []str = []
    for e in books.entries:
        if len(days) == 0 or days[len(days) - 1] != e.date:
            days.append(e.date)
    return days

# Where the slider stands: the position, among the days, of the books shown.
def slider_position() -> int:
    let days: []str = dates_of()
    if step < 0 or step >= len(books.entries):
        return len(days) - 1
    return max(0, days.index(books.entries[step].date))

# The slider moved to a day: the books as they stood at the end of it.
def slider_moved():
    playing = False
    let days: []str = dates_of()
    let at: int = int(field_text("date-slider"))
    if at < 0 or at >= len(days):
        return
    var last: int = 0
    for i in range(len(books.entries)):
        if books.entries[i].date <= days[at]:
            last = i
    replay_to(last)
    redraw()

def tick():
    tick_pending = False
    if not playing:
        return
    let next: int = replayable_by(1)
    if next > step:
        replay_to(next)
        schedule_tick()
    else:
        playing = False                 # the last one stays shown
    redraw()

def schedule_tick():
    if not tick_pending:
        tick_pending = True
        discard_timeout(setTimeout(tick, STEP_MS))

def play():
    replay_frozen()
    let found: []int = replayable()
    if len(found) == 0:
        return
    if step < 0 or step >= found[len(found) - 1] or (only != "" and step not in found):
        replay_to(found[0])             # from the first
    playing = True
    schedule_tick()

def pause():
    playing = False

def step_by(d: int):
    playing = False
    replay_frozen()
    let i: int = replayable_by(d)
    if i >= 0:
        replay_to(i)

def stop_replay():
    playing = False
    step = -1
    only = ""
    exercising = False

# ---------------------------------------------------------------------
# The exercise: the books as they stood, the next transaction told in
# words, and the arrow for it to be drawn
# ---------------------------------------------------------------------

# The books as they stand before transaction EX_INDEX, the last one solved marked.
def ex_show():
    step = ex_index - 1
    var upto: Books = books
    upto.entries = books.entries[:ex_index]
    replayed = graph_of(upto)
    now_arrows = []
    now_accounts = []
    if ex_index > 0:
        mark_now(ex_index - 1)
    redraw()

def start_exercise():
    if len(books.entries) == 0:
        return
    stop_replay()
    layout.unfreeze()
    exercising = True
    ex_index = 0
    ex_score = 0
    ex_tries = 0
    say("Draw the arrow for the transaction below: click the account the money leaves, then drag to the one it reaches.", False)
    ex_show()

def stop_exercise():
    stop_replay()
    layout.unfreeze()
    say(f"Exercise stopped: {ex_score} right at the first try.", False)
    redraw()

# The transaction solved, the next asked for.
def ex_next(told: str, refusal: bool):
    ex_index += 1
    ex_tries = 0
    layout.unfreeze()
    if ex_index >= len(books.entries):
        say(f"{told} That was the last one: {ex_score} right at the first try, out of {len(books.entries)}.", False)
    else:
        say(told, refusal)
    ex_show()

# An arrow drawn from the frozen account to TARGET: a popup to record it,
# or, in the exercise, an answer to the question.
def arrow_drawn(target: str):
    if not exercising:
        layout.open_popup(target)
        return
    let source: str = layout.source
    let e: Entry = books.entries[ex_index]
    if moves(e, source, target):
        if ex_tries == 0:
            ex_score += 1
        ex_next(f"Right: money leaves {source} and reaches {target}. The transaction did {postings_text(e)}.", False)
    else:
        ex_tries += 1
        layout.unfreeze()
        if moves(e, target, source):
            say("Other way round: the arrow goes from the account the money leaves to the one it reaches.", True)
        else:
            say(f"Not {source} to {target}. Which account gives, and which one receives?" + (" Or press Show the answer." if ex_tries >= 2 else ""), True)
        redraw()

# Give up this transaction: its answer told, the next one asked.
def show_answer():
    let e: Entry = books.entries[ex_index]
    ex_next(f"The answer: {postings_text(e)}.", False)

# The replay buttons and, while replaying, the transaction shown, its own words large.
def replay_html() -> Html:
    let n: int = len(books.entries)
    let found: []int = replayable()
    let which: str = ("" if step < 0 else
                      f"Transaction {step + 1} of {n}, {books.entries[step].date}" if only == "" else
                      f"{only}: transaction {found.index(step) + 1} of {len(found)} (number {step + 1} of {n}), {books.entries[step].date}" if step in found else
                      f"Transaction {step + 1} of {n}, {books.entries[step].date}")
    let play_label: str = (f"Play {layout.source}'s transactions" if layout.source != "" else
                           f"Play {only}'s transactions" if only != "" else "Play the transactions")
    let what: str = (books.entries[step].what if step >= 0 else "")
    let days: []str = dates_of()
    let position: int = (slider_position() if len(days) > 0 else 0)
    let last_day: str = str(max(len(days) - 1, 0))
    let at_day: str = str(position)
    let asked: bool = exercising and ex_index < n
    let ex_which: str = (f"Exercise: transaction {ex_index + 1} of {n}, {books.entries[ex_index].date}, {ex_score} right so far" if asked else f"Exercise finished: {ex_score} right at the first try, out of {n}")
    let ex_what: str = (books.entries[ex_index].what if asked else "")
    html:
        div class="replaying":
            if exercising:
                p class="replay":
                    if asked:
                        button id="answer" onclick=show_answer(): "Show the answer"
                    button id="stop-exercise" onclick=stop_exercise(): "Stop the exercise"
                div class="caption":
                    span class="which": ex_which
                    if asked:
                        span class="what": ex_what
            else:
                p class="replay":
                    if playing:
                        button id="pause" onclick=pause(): "Pause"
                    else:
                        button id="play" onclick=play(): play_label
                    button id="back" onclick=step_by(-1): "Previous"
                    button id="next" onclick=step_by(1): "Next"
                    if step >= 0:
                        button id="all" onclick=stop_replay(): "Show all"
                    if len(books.entries) > 0:
                        button id="exercise" title="Draw the arrows of the transactions yourself, one at a time" onclick=start_exercise(): "Exercise"
                    if closable() and step < 0:
                        button id="close-year" title="Move the costs and the revenue into retained earnings, so that the profit sits in equity and the cost and revenue accounts start again from zero" onclick=close_year(): "Close the year"
                if len(days) > 1:
                    p class="slider":
                        span: "Books as at "
                        strong: days[position]
                        input id="date-slider" type="range" min="0" max=last_day value=at_day oninput=slider_moved()
                if step >= 0:
                    div class="caption":
                        span class="which": which
                        span class="what": what

# The scenario picker, Start over, Save as, and what the scenario is about.
def scenario_option_html(i: int) -> Html:
    let name: str = scenario_names[i]
    let title: str = scenario_titles[i]
    html:
        option value=name: title

def scenario_html() -> Html:
    var about: []str = (books.about.split("\n") if books.about != "" else [])
    let help_label: str = ("Hide help" if help_open else "Help")
    html:
        div class="scenario":
            p:
                strong: "Scenario "
                select id="scenario" onchange=choose_scenario():
                    for i in range(len(scenario_names)):
                        + scenario_option_html(i)
                button id="start-over" onclick=start_over(): "Start over"
                button id="save-as" onclick=save_as(): "Save as..."
                button id="help" onclick=toggle_help(): help_label
                button id="tidy" title="Lay the accounts out again, each in its quarter, placed to keep the arrows short and off other accounts" onclick=tidy(): "Tidy up"
            if help_open:
                for line in about:
                    p class="about": line

def last_date() -> str:
    return (books.entries[len(books.entries) - 1].date if len(books.entries) > 0 else "")

def record_html() -> Html:
    let message_class: str = ("message refused" if refused else "message")
    let hint: str = ("Click the account the money leaves: it freezes. Then drag an arrow from it to the account the money reaches." if exercising and layout.source == "" else
                     f"{layout.source} is frozen: drag an arrow from it to the account the money reaches. Click {layout.source} again to let it go." if exercising else
                     "To record a transaction, click the account the money leaves: it freezes. Then drag an arrow from it to the account the money reaches."
                     if layout.source == "" else
                     f"{layout.source} is frozen: drag an arrow from it to the account the money reaches. Click {layout.source} again, or press Escape, to let it go. Play, Previous and Next replay its transactions alone.")
    html:
        div class="record":
            + replay_html()
            p: help_text(hint) if (layout.source == "" and not exercising) else hint
            if message != "":
                p class=message_class: message

# The accounts, one row each with its number, kind and balance and a button
# to delete it, and a last row to open a new one.
def account_row_html(i: int) -> Html:
    let a: AccountRow = books.accounts[i]
    let css: str = css_of(shown().account(a.name))
    let balance: Cents_T = shown().balance(a.name)
    html:
        tr:
            td: a.number
            td class=css: a.name
            td: kind_text(a.kind)
            if debit_credit:
                td class="num": (money(balance) if balance > 0 else "")
                td class="num": (money(Cents_T(-int(balance))) if balance < 0 else "")
            else:
                td class="num": money(balance)
            td:
                button class="delete" onclick=delete_account(a.name): "Delete"

def accounts_html() -> Html:
    html:
        table class="accounts":
            tr:
                th: "Number"
                th: "Account"
                th: "Kind"
                if debit_credit:
                    th: "Debit"
                    th: "Credit"
                else:
                    th: "Balance"
                th: ""
            for i in range(len(books.accounts)):
                + account_row_html(i)
            tr class="new":
                td:
                    input id="number" placeholder="613100" size="8"
                td:
                    input id="name" placeholder="a new account" size="16"
                td:
                    select id="kind":
                        option value="asset": "asset"
                        option value="liability": "liability"
                        option value="equity": "equity"
                        option value="revenue": "revenue"
                        option value="expense": "expense"
                td: ""
                if debit_credit:
                    td: ""
                td:
                    button id="open" onclick=open_account(): "Open"

const ACCOUNTS_TEXT: str = "Every account, with its number in the chart of accounts, its kind and its balance. An account starts at zero; money coming in adds to it, money going out subtracts, and as every transaction is counted once as positive and once as negative, all the balances add up to zero: the books balance. Open a new account on the last row; an account can be deleted once no transaction touches it."

# A VAT rate as the popup offers it: its member's name, its percentage shown.
def vat_option_html(rate: VatRate_T) -> Html:
    let name: str = str(rate)
    html:
        option value=name: vat_text(rate)

# The transaction from the frozen account to the one the arrow was dropped
# on: when, what, how much. Enter records it, Escape closes it.
def popup_html() -> Html:
    let title: str = f"{layout.source}  →  {layout.target}"
    let date: str = last_date()
    html:
        div:
            div class="backdrop" onclick=close_popup()
            div class="popup":
                h3: title
                label: "Date"
                input id="date" value=date placeholder="2012-01-31"
                label: "What happened"
                input id="what" placeholder="a chair for the office"
                label: "Amount, before VAT"
                input id="amount" placeholder="605.00"
                label: "VAT"
                select id="vat":
                    for rate in VatRate_T:
                        + vat_option_html(rate)
                if popup_message != "":
                    p class="message refused": popup_message
                button id="record" onclick=record_entry(): "Record"
                button id="cancel" onclick=close_popup(): "Cancel"

# The transactions as the books write them, one row each, with what each did
# to every account, and a button to delete it.
def postings_text(e: Entry) -> str:
    var parts: []str = []
    for p in e.postings:
        parts.append(f"{p.account} {signed(p.amount)}")
    return ", ".join(parts)

def journal_row_html(i: int) -> Html:
    let e: Entry = books.entries[i]
    let css: str = ("" if step < 0 else ("now" if i == step else ("later" if i > step else "")))
    html:
        tr class=css:
            td: e.date
            td: e.what
            td: postings_text(e)
            td:
                button class="delete" onclick=delete_entry(i): "Delete"

# The postings of E as a journal writes them: the debits first, then the credits.
def journal_order(e: Entry) -> []Posting:
    var ordered: []Posting = []
    for p in e.postings:
        if p.amount > 0:
            ordered.append(p)
    for p in e.postings:
        if p.amount < 0:
            ordered.append(p)
    return ordered

def posting_row_html(i: int, k: int) -> Html:
    let e: Entry = books.entries[i]
    let p: Posting = journal_order(e)[k]
    let credit: bool = p.amount < 0
    let account_css: str = ("credit" if credit else "debit")
    html:
        tr:
            td: (e.date if k == 0 else "")
            td: (e.what if k == 0 else "")
            td class=account_css: p.account
            td class="num": (money(p.amount) if not credit else "")
            td class="num": (money(Cents_T(-int(p.amount))) if credit else "")
            td:
                if k == 0:
                    button class="delete" onclick=delete_entry(i): "Delete"

# Transaction I written as a journal does: each debit and credit on a line of its own.
def journal_entry_html(i: int) -> Html:
    let css: str = ("entry" if step < 0 else ("entry now" if i == step else ("entry later" if i > step else "entry")))
    html:
        tbody class=css:
            for k in range(len(books.entries[i].postings)):
                + posting_row_html(i, k)

def journal_html() -> Html:
    if debit_credit:
        html:
            table:
                tr:
                    th: "Date"
                    th: "Transaction"
                    th: "Account"
                    th: "Debit"
                    th: "Credit"
                    th: ""
                for i in range(ex_index if exercising else len(books.entries)):
                    + journal_entry_html(i)
    else:
        html:
            table:
                tr:
                    th: "Date"
                    th: "Transaction"
                    th: "What it did to each account"
                    th: ""
                for i in range(ex_index if exercising else len(books.entries)):
                    + journal_row_html(i)

# ---------------------------------------------------------------------
# The ratios: the balance sheet read the way a banker reads it
# ---------------------------------------------------------------------

const RATIOS_TEXT: str = "What an accountant or a banker reads off the balance sheet, for the books as shown: they change with every transaction, with the replay and with the date slider. Current means due or turned into cash within the year."

def ratio_row_html(r: Ratio) -> Html:
    html:
        tr:
            td: r.name
            td class="num": r.value
            td: r.meaning

def ratios_html() -> Html:
    let found: []Ratio = ratios_of(books, shown())
    html:
        table:
            tr:
                th: "Ratio"
                th: "Value"
                th: "What it tells"
            for r in found:
                + ratio_row_html(r)

# ---------------------------------------------------------------------
# The T-accounts: each account's debits on its left, its credits on its right
# ---------------------------------------------------------------------

const T_TEXT: str = "Every transaction is written twice, as a debit in one account and a credit in another, for the same amount. An account is a T: its debits on the left, its credits on the right, and its balance is the bigger side less the smaller. Assets and expenses grow on the debit side; liabilities, equity and revenue grow on the credit side. In the graph, an arrow goes from the account that is credited to the account that is debited."

# How many transactions the T-accounts count: the ones shown so far.
def counted_entries() -> int:
    if exercising:
        return ex_index
    return (step + 1 if step >= 0 else len(books.entries))

def t_account_html(i: int) -> Html:
    let row: AccountRow = books.accounts[i]
    var debits: []Cents_T = []
    var credits: []Cents_T = []
    for k in range(counted_entries()):
        for p in books.entries[k].postings:
            if p.account == row.name:
                if p.amount > 0:
                    debits.append(p.amount)
                else:
                    credits.append(Cents_T(-int(p.amount)))
    let balance: Cents_T = shown().balance(row.name)
    let words: str = ("" if balance == 0 else (" debit" if balance > 0 else " credit"))
    let owed: str = f"Balance {money(Cents_T(abs(int(balance))))}{words}"
    let css: str = css_of(shown().account(row.name))
    let heading: str = f"{row.number} {row.name}"
    html:
        div class="taccount":
            h4 class=css: heading
            div class="tbody":
                div class="tdebit":
                    for d in debits:
                        p: money(d)
                div class="tcredit":
                    for c in credits:
                        p: money(c)
            p class="tbalance": owed

# Whether any counted transaction touches account I.
def t_touched(i: int) -> bool:
    for k in range(counted_entries()):
        for p in books.entries[k].postings:
            if p.account == books.accounts[i].name:
                return True
    return False

def t_accounts_html() -> Html:
    html:
        div class="tgrid":
            for i in range(len(books.accounts)):
                if t_touched(i):
                    + t_account_html(i)

# What the accounts of a quarter of G add up to, as that quarter counts
# them: activa and costs as owned or spent, passiva and revenue as owed or
# earned (their balances are negative); QUARTER 0 to 3 is activa, passiva,
# costs, revenue.
def quarter_total(g: Graph, quarter: int) -> Cents_T:
    var total: Cents_T = 0
    for row in books.accounts:
        var q: int = 0
        case row.kind:
            when ASSET:
                q = 0
            when LIABILITY | EQUITY:
                q = 1
            when EXPENSE:
                q = 2
            when REVENUE:
                q = 3
        if q == quarter:
            for a in g.accounts:
                if a.name == row.name:
                    total += a.balance
    if quarter % 2 == 1 and total != 0:   # never -0 (the page's numbers are JavaScript's)
        total = -total
    return total

# A quarter's title with its total: "Activa (63,600.00)".
def quarter_title(g: Graph, title: str, quarter: int) -> str:
    return f"{title} ({money(quarter_total(g, quarter))})"

# The balance sheet's lines and the titles of its sides, with their totals,
# under the graph G.
def sides_html(g: Graph) -> Html:
    let x: float = layout.split_x
    let y: float = layout.pl_y
    let down: str = f"M {px(x)} {px(layout.top_y + 8.0)} L {px(x)} {px(layout.height - 8.0)}"
    let across: str = f"M 8 {px(y)} L {px(layout.width - 8.0)} {px(y)}"
    let lx: str = px(x - 16.0)
    let rx: str = px(x + 16.0)
    let ty: str = px(layout.top_y + 28.0)
    let by: str = px(y + 30.0)
    let activa: str = quarter_title(g, "Activa", 0)
    let passiva: str = quarter_title(g, "Passiva", 1)
    let costs: str = quarter_title(g, "Costs", 2)
    let revenue: str = quarter_title(g, "Revenue", 3)
    html:
        g class="sides":
            path class="split" d=down
            stext class="side left" x=lx y=ty: activa
            stext class="side right" x=rx y=ty: passiva
            if layout.has_pl:
                path class="split" d=across
                stext class="side left" x=lx y=by: costs
                stext class="side right" x=rx y=by: revenue

def live_graph_html(g: Graph) -> Html:
    let rubber: str = (layout.rubber_d() if layout.drawing else "")
    let routes: []Route = routes_of(g, layout.names, layout.points, layout.tall, Point(layout.width, layout.height), layout.title_spots(), layout.title_halves(), layout.shape())
    html:
        svg id="graph" viewBox=layout.view_box() class="graph":
            defs:
                marker id="arrow" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto":
                    polygon points="0 0, 10 3.5, 0 7"
                marker id="arrow-now" markerWidth="4.3" markerHeight="3" refX="3.9" refY="1.5" orient="auto":
                    polygon class="now" points="0 0, 4.3 1.5, 0 3"
            + sides_html(g)
            for i in range(len(g.flows)):
                + live_arrow_html(g, g.flows[i], routes[i])
            for a in g.accounts:
                + live_node_html(g, a)
            if layout.drawing and rubber != "":
                path class="rubber" d=rubber
            if layout.has_pl:
                circle class="crossing" cx=px(layout.split_x) cy=px(layout.pl_y) r="9" onmousedown=layout.grab_crossing():
                    title: "Drag to resize the four quarters; the accounts are tidied into them when you let go"
            if layout.tip != "":
                + layout.tip_html()

# ---------------------------------------------------------------------
# The mouse: a press on a node grabs it (above), these move it and drop it
# ---------------------------------------------------------------------

def on_move(e: Event):
    let m: MouseEvent = MouseEvent(e)
    let box: BoundingRect = document.getElementById("graph").getBoundingClientRect()
    let scale: float = layout.width / box.width    # the svg is drawn at the page's width
    layout.mouse_x = (float(m.clientX) - box.left) * scale
    layout.mouse_y = (float(m.clientY) - box.top) * scale
    if layout.drawing and m.buttons == 0:               # let go where on_up did not see it: no arrow
        layout.drawing = False
    layout.move_to(layout.mouse_x, layout.mouse_y)      # when an account is held
    if layout.held >= 0 or layout.tip != "" or layout.drawing or layout.crossing:
        redraw()

def on_up(e: Event):
    let was_open: bool = layout.popup
    layout.release()
    redraw()
    if layout.popup and not was_open:
        discard_timeout(setTimeout(focus_what, 30))       # the popup is drawn: type straight into it


def on_key(e: Event):
    let k: KeyboardEvent = KeyboardEvent(e)
    if k.key == "Escape":
        close_popup()
        redraw()
    elif k.key == "Enter" and layout.popup:
        record_entry()
        redraw()

const APP_TITLE: str = "Accounting, as graph theory"
const APP_INTRO: str = "Your books, as the ledger keeps them. Pick a scenario below: each is a small company's books showing one idea, yours to change; Start over brings it back as it was, Save as keeps your version as a scenario of its own. To record a transaction, click the account the money leaves, so that it freezes, then drag an arrow from it to the account the money reaches, and say when, what and how much; with VAT, the amount is before VAT and the VAT goes to its own account. Transactions are listed below the graph, accounts further down; each has a Delete button there, and a new account is opened on the last row of the accounts. Drag the accounts about within their quarters, and Tidy up lays them out again; drag the circle where the lines cross to resize the quarters. Hover over an account or an arrow to see its transactions; Play the transactions replays them one at a time, each highlighted, with the balances as they stood after it; Slide the date to see the books as they stood on each day; Debit and credit writes the transactions as a journal does and shows each account as a T; Exercise asks you to draw the arrows of the transactions yourself, one at a time; Close the year moves the costs and the revenue into retained earnings, so that the profit sits in equity and the cost and revenue accounts start again from zero; with an account frozen, only that account's transactions."

# The graph with its controls; its title and caption are help, like the rest.
def graph_section_html() -> Html:
    if help_open:
        return section_html("Accounts are nodes, transactions are edges",
            GRAPH_TEXT + " Drag an account to move it.",
            [record_html(), live_graph_html(shown())])
    html:
        section:
            + record_html()
            + live_graph_html(shown())

const TABS: []str = ["Transactions", "T-accounts", "Accounts", "Statements"]

def tab_button(name: str) -> Html:
    let chosen: str = ("selected" if name == tab else "")
    html:
        button class=chosen onclick=choose_tab(name): name

def tabs_html() -> Html:
    html:
        div class="tabs":
            for name in TABS:
                + tab_button(name)

def tab_body() -> []Html:
    if tab == "Transactions":
        return [debit_credit_button_html(), journal_html()]
    if tab == "T-accounts":
        return [section_html("T-accounts", help_text(T_TEXT), [t_accounts_html()])]
    if tab == "Accounts":
        return [section_html("Accounts", help_text(ACCOUNTS_TEXT), [accounts_html()])]
    let after: []Html = sections_after_graph(shown(), help_open)
    var out: []Html = []
    for i in range(1, len(after)):              # its first, the balances, is the Accounts table
        out.append(after[i])
    out.append(section_html("Ratios", help_text(RATIOS_TEXT), [ratios_html()]))
    return out

def main():
    def render() -> Html:
        var sections: []Html = [graph_section_html()]
        sections.append(tabs_html())
        for part in tab_body():
            sections.append(part)
        html:
            div:
                style: STYLE + LIVE_STYLE
                if layout.popup:
                    + popup_html()
                h1: APP_TITLE
                if help_open:
                    p: APP_INTRO
                + scenario_html()
                for s in sections:
                    + s

    setRenderer(render)
    document.addEventListener("mousemove", on_move)
    document.addEventListener("mouseup", on_up)
    document.addEventListener("keydown", on_key)
    load()
    load_scenarios()

if __name__ == "__main__":       # not when another module imports this
    main()
