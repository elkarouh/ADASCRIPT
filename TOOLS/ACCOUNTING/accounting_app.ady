g.tip { pointer-events: none; }
g.sides { pointer-events: none; }
path.split { stroke: #888; stroke-width: 2; stroke-dasharray: 10 6; fill: none; }
text.side { font-size: 14px; font-weight: bold; fill: #666; }
text.left { text-anchor: end; }
text.right { text-anchor: start; }
g.tip rect { fill: #fffbe6; stroke: #888; }
