text.tiphead { font-size: 11px; font-weight: bold; white-space: pre; }
"""

# Where each account sits, starting where accounting_gui.ady puts it.
@virtual
class Layout:
    var names: []str
    var points: []Point
    var lefts: []bool                   # each account's quadrant: left of the vertical line (activa, costs)
    var tops: []bool                    # and above the horizontal one (activa, passiva)
    var held: int = -1                  # the account being dragged, or -1
    var tip: str = ""                   # what the arrow under the mouse lists, or ""
    var mouse_x: float = 0.0            # where the mouse is, in the drawing's units
    var mouse_y: float = 0.0
    var width: float = WIDTH            # the drawing's size: WIDTH x HEIGHT, or the window's when graph_only
    var height: float = HEIGHT
    var graph_only: bool = False        # True: the graph and its transactions, without the text and the other tables
    var grabbed_x: float = 0.0          # where the held account was grabbed: a press that
    var grabbed_y: float = 0.0          # does not move it is a click, which picks it
    var source: str = ""                # the frozen account, where the money leaves, or ""
    var target: str = ""                # the account the arrow from it was dropped on, or ""
    var drawing: bool = False           # an arrow is being drawn from the frozen account
    var popup: bool = False             # the transaction's popup is open
    var split_x: float = WIDTH / 2.0      # the vertical line: Activa left, Passiva right
    var pl_y: float = 0.0               # the horizontal line above the profit and loss
    var page_height: float = HEIGHT       # the drawing's height in the page, kept while the graph is alone
    var top_y: float = 0.0              # the top of the balance sheet (moved down with the graph alone)
    var has_pl: bool = False            # whether there are costs or revenue to put below it

    # The accounts laid out as a balance sheet: a vertical line, the assets
    # (Activa) left of it and equity and debts (Passiva) right; below a
    # horizontal line the profit and loss, costs left and revenue right, as
    # the Belgian layout has them. Each side in account-number order, two to a
    # row. Laid out again whenever the accounts change, so a new one lands in
    # its place; dragging moves one until then.
    def sync(self, rows: []AccountRow):
        var same: bool = len(rows) == len(self.names)
        for r in rows:
            if r.name not in self.names:
                same = False
        if not same:
            self.arrange(rows)
        if not self.graph_only:
            self.height = 300.0                 # as tall as the accounts need
            for p in self.points:
                self.height = max(self.height, p.y + NODE_RADIUS + 30.0)

    def arrange(self, rows: []AccountRow):
        var sorted: []AccountRow = rows
        for i in range(1, len(sorted)):          # by number: few accounts, an insertion sort
            var j: int = i
            while j > 0 and number_before(sorted[j].number, sorted[j - 1].number):
                let t: AccountRow = sorted[j]
                sorted[j] = sorted[j - 1]
                sorted[j - 1] = t
                j -= 1
        var activa: []str = []
        var passiva: []str = []
        var costs: []str = []
        var revenue: []str = []
        for r in sorted:
            case r.kind:
                when ASSET:
                    activa.append(r.name)
                when LIABILITY | EQUITY:
                    passiva.append(r.name)
                when EXPENSE:
                    costs.append(r.name)
                when REVENUE:
                    revenue.append(r.name)
        let mid: float = self.width / 2.0
        self.split_x = mid
        self.top_y = 0.0
        self.names = []
        self.points = []
        self.lefts = []
        self.tops = []
        let top_rows: int = max((len(activa) + 1) // 2, (len(passiva) + 1) // 2)
        self.place_side(activa, mid - 370.0, TOP_Y, True, True)
        self.place_side(passiva, mid + 150.0, TOP_Y, False, True)
        self.has_pl = len(costs) + len(revenue) > 0
        self.pl_y = TOP_Y + float(max(top_rows, 1)) * ROW_STEP - 30.0
        let pl_top: float = self.pl_y + 30.0 + LABEL_ROOM
        self.place_side(costs, mid - 370.0, pl_top, True, False)
        self.place_side(revenue, mid + 150.0, pl_top, False, False)

    # NAMES two to a row, from (X, Y): X and X + 220, in the quadrant LEFT and TOP say.
    def place_side(self, names: []str, x: float, y: float, left: bool, top: bool):
        for i in range(len(names)):
            self.names.append(names[i])
            self.lefts.append(left)
            self.tops.append(top)
            self.points.append(Point(x + 220.0 * float(i % 2), y + ROW_STEP * float(i // 2)))

    # A transaction is drawn: a click on an account freezes it (it no longer
    # moves), an arrow is dragged from it to another account, and letting go
    # there opens the popup. A click on the frozen account, or Escape, lets
    # it go.
    # Another scenario's accounts: they start where the example puts them.
    def reset(self):
        self.names = []
        self.points = []
        self.lefts = []
        self.tops = []
        self.held = -1
        self.tip = ""
        self.height = (self.height if self.graph_only else HEIGHT)
        self.unfreeze()

    def unfreeze(self):
        self.source = ""
        self.target = ""
        self.drawing = False
        self.popup = False

    def open_popup(self, target: str):
        self.target = target
        self.popup = True
        self.tip = ""

    # A press on account A: on the frozen one it starts an arrow, on any
    # other it grabs the account, to move it or, if it does not move, to
    # click it.
    def press(self, a: Account):
        if self.popup:
            return
        if a.name == self.source:
            self.drawing = True
            self.grabbed_x = self.mouse_x
            self.grabbed_y = self.mouse_y
            self.tip = ""
        else:
            self.grab(a)

    # The account under (X, Y), or "".
    def node_at(self, x: float, y: float) -> str:
        for i in range(len(self.points)):
            let dx: float = self.points[i].x - x
            let dy: float = self.points[i].y - y
            if dx * dx + dy * dy <= NODE_RADIUS * NODE_RADIUS:
                return self.names[i]
        return ""

    def still(self) -> bool:
        return abs(self.mouse_x - self.grabbed_x) < 4.0 and abs(self.mouse_y - self.grabbed_y) < 4.0

    # The mouse let go: an arrow ends on its target, or a click lets the
    # frozen account go; a held account is dropped, or, if it did not move
    # and none is frozen, frozen. Only an arrow dragged onto an account opens
    # the popup: a click on it, or the mouse passing over it, does not.
    def release(self):
        if self.drawing:
            self.drawing = False
            let under: str = self.node_at(self.mouse_x, self.mouse_y)
            if under != "" and under != self.source:
                self.open_popup(under)
            elif under == self.source and self.still():
                self.unfreeze()
        elif self.held >= 0:
            let name: str = self.names[self.held]
            let clicked: bool = self.still()
            self.held = -1
            if clicked and self.source == "":
                self.source = name

    def index(self, a: Account) -> int:
        for i in range(len(self.names)):
            if self.names[i] == a.name:
                return i
        raise KeyError(f"no account {a.name}")

    def at(self, a: Account) -> Point:
        return self.points[self.index(a)]

    def grab(self, a: Account):
        self.held = self.index(a)
        self.grabbed_x = self.mouse_x
        self.grabbed_y = self.mouse_y
        self.tip = ""

    # The browser shows an SVG <title> as a tooltip, but karax builds this
    # one outside SVG, so the live page draws its own, in the drawing: a box
    # of the tip's lines beside the mouse, on the side that has room.
    def show(self, tip: str):
        if self.held < 0 and not self.drawing and not self.popup:
            self.tip = tip

    def hide(self):
        self.tip = ""

    def tip_html(self) -> Html:
        let lines: []str = self.tip.split("\n")
        var widest: int = 0
        for line in lines:
            widest = max(widest, len(line))
        let w: float = float(widest) * 6.2 + 16.0
        let h: float = float(len(lines)) * 15.0 + 8.0
        let x: float = (self.mouse_x + 14.0 if self.mouse_x + 14.0 + w <= self.width else max(self.mouse_x - 14.0 - w, 0.0))
        let y: float = (self.mouse_y + 14.0 if self.mouse_y + 14.0 + h <= self.height else max(self.mouse_y - 14.0 - h, 0.0))
        let top: float = y + 16.0
        let left: float = x + 8.0
        html:
            g class="tip":
                rect x=px(x) y=px(y) width=px(w) height=px(h) rx="3"
                for i in range(len(lines)):
                    if i == 0:
                        stext class="tiphead" x=px(left) y=px(top): lines[i]
                    else:
                        stext class="tipline" x=px(left) y=px(top+float(i)*15.0): lines[i]

    # The held account to (X, Y), kept whole inside the drawing.
    # The held account follows the mouse, but stays inside the drawing and
    # inside its quadrant, clear of the quadrant's title: an asset left of
    # the vertical line, a cost below the horizontal one, and so on.
    def move_to(self, x: float, y: float):
        if self.held >= 0:
            let gap: float = NODE_RADIUS + 6.0
            var low_x: float = NODE_RADIUS
            var high_x: float = self.width - NODE_RADIUS
            var low_y: float = self.top_y + 30.0 + NODE_RADIUS      # below the titles
            var high_y: float = self.height - NODE_RADIUS
            if self.lefts[self.held]:
                high_x = self.split_x - gap
            else:
                low_x = self.split_x + gap
            if self.has_pl:
                if self.tops[self.held]:
                    high_y = self.pl_y - gap
                else:
                    low_y = self.pl_y + 30.0 + NODE_RADIUS             # below the costs' and revenue's titles
            self.points[self.held] = Point(min(max(x, low_x), high_x), min(max(y, low_y), high_y))

    # The arrow being drawn, from the rim of the frozen account to the mouse.
    def rubber_d(self) -> str:
        let i: int = self.names.index(self.source)
        let a: Point = self.points[i]
        let b: Point = Point(self.mouse_x, self.mouse_y)
        if abs(a.x - b.x) + abs(a.y - b.y) < NODE_RADIUS:
            return ""
        let start: Point = toward(a, b, NODE_RADIUS)
        return f"M {start.x:.1f} {start.y:.1f} L {b.x:.1f} {b.y:.1f}"

    # The graph alone fills the window, one drawing unit per pixel, the
    # accounts moved to its middle; back in the page it is WIDTH x HEIGHT
    # again, the accounts moved back (and kept inside if they strayed).
    def toggle_graph_only(self):
        let was_width: float = self.width
        self.graph_only = not self.graph_only
        self.tip = ""
        if self.graph_only:
            self.page_height = self.height
            self.width = float(window.innerWidth) - 20.0
            self.height = max(float(window.innerHeight) - 90.0, self.page_height)
        else:
            self.width = WIDTH
            self.height = self.page_height     # as it was, so the accounts move back where they were
        let dx: float = (self.width - was_width) / 2.0
        self.split_x += dx                     # centred across; the extra height goes below
        for i in range(len(self.points)):
            self.held = i
            self.move_to(self.points[i].x + dx, self.points[i].y)
        self.held = -1

    def view_box(self) -> str:
        return f"0 0 {self.width:.0f} {self.height:.0f}"

var layout: Layout = Layout()

# ---------------------------------------------------------------------
# The books, as the server last sent them, and what the page sends it
# ---------------------------------------------------------------------

var books: Books = Books("", [], [], [], "", "")
var graph: Graph = Graph()
var message: str = "Asking the ledger for the books..."
var refused: bool = False               # whether the message says why something was refused
var popup_message: str = ""             # why the popup's transaction cannot be recorded yet

let NO_HEADERS: [](cstring, cstring) = []
var replaced: bool = False              # another scenario, or this one started over: lay it out afresh

# The replay (below): the transactions one at a time
var step: int = -1                      # the transaction shown last; -1: not replaying, all shown
var playing: bool = False
var tick_pending: bool = False          # a tick is on its way: no second one
var replayed: Graph = Graph()           # the books up to and with transaction STEP
var now_arrows: []str = []              # its arrows, "source\ttarget"
var now_accounts: []str = []            # the accounts it touches

def say(text: str, is_refusal: bool):
    message = text
    refused = is_refusal

def on_books(status: int, response: cstring):
    if status != 200:
        say(f"The ledger did not answer ({status}): is ledger_server running?", True)
        return
    let read: Books | !BookFailure_T = parse_books(str(response))
    case read:
        when BookFailure_T:
            say("The ledger sent books this page cannot read: " + read.detail, True)
        when Books:
            books = read
            graph = graph_of(books)
            stop_replay()
            if replaced:
                layout.reset()
                replaced = False
            layout.sync(books.accounts)
            if message.startswith("Asking"):
                say("", False)

def load():
    ajaxGet("/books", NO_HEADERS, on_books)

# The scenarios the ledger has, and the one it shows.
var scenario: str = ""
var scenario_names: []str = []
var scenario_titles: []str = []

def discard_timeout(t: TimeOut):
    pass

def pick_shown():
    let picker: Element = document.getElementById("scenario")
    if picker != nil:
        InputElement(picker).value = scenario

def on_scenarios(status: int, response: cstring):
    if status != 200:
        return
    scenario_names = []
    scenario_titles = []
    for line in str(response).split("\n"):
        let f: []str = line.split("\t")
        if f[0] == "current" and len(f) == 2:
            scenario = f[1]
        elif f[0] == "scenario" and len(f) == 3:
            scenario_names.append(f[1])
            scenario_titles.append(f[2])
    discard_timeout(setTimeout(pick_shown, 50))     # once the options are drawn, the one shown picked

def load_scenarios():
    ajaxGet("/scenarios", NO_HEADERS, on_scenarios)

# The server's answer to a change of scenario: the new books, drawn afresh.
def on_switched(status: int, response: cstring):
    let answer: str = str(response)
    if answer == "ok":
        replaced = True                 # the layout starts afresh with the books that come
        load()
        load_scenarios()
    else:
        say(("Refused: " + answer[6:] if answer.startswith("error") else f"The ledger did not answer ({status})"), True)

def choose_scenario():
    let name: str = field_text("scenario")
    if name != scenario:
        say("", False)
        ajaxPost("/scenario", NO_HEADERS, name, on_switched)

def start_over():
    if window.confirm("Start this scenario over? What you changed in it is lost."):
        say("Started over.", False)
        ajaxPost("/start-over", NO_HEADERS, scenario, on_switched)

def save_as():
    let name: str = str(window.prompt("Save these books as a new scenario, named (letters, digits, _ and -):", cstring(scenario & "_mine")))
    if name != "":
        say(f"Saved as {name}.", False)
        ajaxPost("/save-as", NO_HEADERS, name, on_switched)

# The server's answer to a POST: "ok", or "error" and why.
def on_answer(status: int, response: cstring):
    let answer: str = str(response)
    if answer == "ok":
        load()
    else:
        say(("Refused: " + answer[6:] if answer.startswith("error") else f"The ledger did not answer ({status})"), True)

def field_text(id: str) -> str:
    return str(document.getElementById(id).value).strip()

def clear_fields(ids: []str):
    for id in ids:
        InputElement(document.getElementById(id)).value = ""

def kind_of(name: str) -> ?Kind_T:
    for a in books.accounts:
        if a.name == name:
            return a.kind
    return None

# The account whose number starts with PREFIX: 411 is VAT to recover, 451
# VAT to pay, in the Belgian chart of accounts.
def account_numbered(prefix: str) -> str:
    for a in books.accounts:
        if a.number.startswith(prefix):
            return a.name
    return ""

# The transaction the form describes: from the picked source to the picked
# target, AMOUNT before VAT. With VAT, a sale (the source is revenue) owes it
# to the tax office, a purchase claims it back.
def form_entry() -> Entry | !BookFailure_T:
    let date: str = field_text("date")
    let what: str = field_text("what")
    if layout.source == "" or layout.target == "":
        return BookFailure_T("Click the account the money leaves, then the one it reaches.")
    if len(date) != 10:
        return BookFailure_T("The date is written 2012-01-31.")
    if what == "":
        return BookFailure_T("Say what happened.")
    do:
        amount <- parse_float(field_text("amount").replace(",", "")) else BookFailure_T("The amount is a number, 605.00.")
        rate <- parse_enum(VatRate_T, field_text("vat")) else BookFailure_T("Pick a VAT rate from the list.")
    let net: Cents_T = Cents_T(int(amount * 100.0 + 0.5))
    if net <= 0:
        return BookFailure_T("The amount is more than zero: the arrow says which way it goes.")
    if rate == NO_VAT:
        return entry(date, what, layout.source, layout.target, net)
    let source_kind: ?Kind_T = kind_of(layout.source)
    let is_sale: bool = source_kind is not None and source_kind == REVENUE
    let vat: str = account_numbered("451" if is_sale else "411")
    if vat == "":
        return BookFailure_T(f"There is no {('VAT to pay (451...)' if is_sale else 'VAT to recover (411...)')} account to put the VAT in.")
    if is_sale:
        return sale_with_vat(date, what, layout.source, layout.target, vat, net, rate)
    return purchase_with_vat(date, what, layout.source, layout.target, vat, net, rate)

def record_entry():
    let made: Entry | !BookFailure_T = form_entry()
    if made is BookFailure_T:
        popup_message = made.detail
    else:
        let checked: None | !BookFailure_T = graph.check(made)
        if checked is BookFailure_T:
            popup_message = checked.detail
        else:
            say(f"Recorded: {made.what}", False)
            close_popup()
            ajaxPost("/entry", NO_HEADERS, entry_lines(made), on_answer)

def close_popup():
    popup_message = ""
    layout.unfreeze()

def focus_what():
    let what: Element = document.getElementById("what")
    if what != nil:
        what.focus()

# Transaction I of the books, deleted, once the learner says so.
def delete_entry(i: int):
    let e: Entry = books.entries[i]
    if window.confirm(f"Delete the transaction of {e.date}, {e.what}?"):
        say(f"Deleted: {e.what}", False)
        ajaxPost("/delete-entry", NO_HEADERS, str(books.ids[i]), on_answer)

# Account NAME, deleted, once the learner says so: the ledger refuses while
# a transaction touches it.
def delete_account(name: str):
    if window.confirm(f"Delete the account {name}?"):
        say(f"Deleted: {name}", False)
        if layout.source == name:
            layout.unfreeze()
        ajaxPost("/delete-account", NO_HEADERS, name, on_answer)

def open_account():
    let number: str = field_text("number")
    let name: str = field_text("name")
    let kind: Kind_T | !BookFailure_T = kind_named(field_text("kind"))
    if kind is BookFailure_T:
        say(kind.detail, True)
    elif number == "" or name == "":
        say("An account needs a number and a name.", True)
    else:
        say(f"Opened: {number} {name}", False)
        clear_fields(["number", "name"])
        ajaxPost("/account", NO_HEADERS, account_line(AccountRow(number, kind, name)), on_answer)

# ---------------------------------------------------------------------
# Rendering: the graph at the layout's points, the rest as on the static page
# ---------------------------------------------------------------------

def live_node_html(g: Graph, a: Account) -> Html:
    let p: Point = layout.at(a)
    let tip: str = account_tip(g, a)
    let none: str = ""                  # the page's own tooltip shows it, not a <title>
    let css: str = ("node from" if a.name == layout.source else ("node to" if a.name == layout.target else
                    ("node now" if step >= 0 and a.name in now_accounts else "node")))
    html:
        g class=css onmousedown=layout.press(a) onmouseover=layout.show(tip) onmouseout=layout.hide():
            + a.to_html(p, none)

def live_arrow_html(g: Graph, f: Flow) -> Html:
    let a: Point = layout.at(f.source)
    let b: Point = layout.at(f.target)
    let tip: str = tip_of(g, f)
    var others: []Point = []
    for i in range(len(layout.names)):
        if layout.names[i] != f.source.name and layout.names[i] != f.target.name:
            others.append(layout.points[i])
    let css: str = ("now" if step >= 0 and (f.source.name + "\t" + f.target.name) in now_arrows else "")
    html:
        g class=css onmouseover=layout.show(tip) onmouseout=layout.hide():
            + f.to_html(a, b, bend_of(g, f, a, b, others, Point(layout.width, layout.height)), "")

# How far the account at P is from the straight line between A and B, or
# a long way when it is beyond either end.
def off_line(p: Point, a: Point, b: Point) -> float:
    let dx: float = b.x - a.x
    let dy: float = b.y - a.y
    let length2: float = dx * dx + dy * dy
    if length2 == 0.0:
        return 1000.0
    let t: float = ((p.x - a.x) * dx + (p.y - a.y) * dy) / length2
    if t <= 0.0 or t >= 1.0:
        return 1000.0
    let qx: float = a.x + t * dx - p.x
    let qy: float = a.y + t * dy - p.y
    return sqrt(qx * qx + qy * qy)

# What a layout costs: the length of its arrows, and a lot more for each
# arrow that runs over another account and so has to bend around it.
def layout_cost(sources: []int, targets: []int) -> float:
    var cost: float = 0.0
    for k in range(len(sources)):
        let a: Point = layout.points[sources[k]]
        let b: Point = layout.points[targets[k]]
        cost += sqrt((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y))
        for i in range(len(layout.points)):
            if i != sources[k] and i != targets[k] and off_line(layout.points[i], a, b) < NODE_RADIUS + 10.0:
                cost += 400.0
    return cost

# Tidy up: the accounts laid out afresh in their quarters, then, within each
# quarter, two accounts swapped places whenever that makes the arrows
# shorter or takes one off an account, until no swap helps.
def tidy():
    stop_replay()
    layout.arrange(books.accounts)
    var sources: []int = []
    var targets: []int = []
    for f in graph.flows:
        sources.append(layout.names.index(f.source.name))
        targets.append(layout.names.index(f.target.name))
    var best: float = layout_cost(sources, targets)
    var better: bool = True
    var passes: int = 0
    while better and passes < 8:
        better = False
        passes += 1
        for i in range(len(layout.points)):
            for j in range(i + 1, len(layout.points)):
                if layout.lefts[i] == layout.lefts[j] and layout.tops[i] == layout.tops[j]:
                    let p: Point = layout.points[i]
                    layout.points[i] = layout.points[j]
                    layout.points[j] = p
                    let cost: float = layout_cost(sources, targets)
                    if cost < best - 0.5:
                        best = cost
                        better = True
                    else:
                        layout.points[j] = layout.points[i]
                        layout.points[i] = p
    layout.sync(books.accounts)

def live_button_html() -> Html:
    let label: str = ("Show everything" if layout.graph_only else "Graph only")
    html:
        p:
            button id="graph-only" onclick=layout.toggle_graph_only(): label
            button id="tidy" title="Lay the accounts out again, each in its quarter, placed to keep the arrows short and off other accounts" onclick=tidy(): "Tidy up"

# ---------------------------------------------------------------------
# The replay: the transactions one at a time, each highlighted on the graph
# and in the table, the balances as they stood after it
# ---------------------------------------------------------------------

const STEP_MS: int = 1800                # how long each transaction is shown while playing

# The graph drawn: the books as they stood at STEP while replaying, else all of them.
def shown() -> Graph:
    return (replayed if step >= 0 else graph)

def replay_to(i: int):
    step = i
    var upto: Books = books
    upto.entries = books.entries[:i + 1]
    replayed = graph_of(upto)
    var alone: Books = books
    alone.entries = [books.entries[i]]
    now_arrows = []
    for f in graph_of(alone).flows:
        now_arrows.append(f.source.name + "\t" + f.target.name)
    now_accounts = []
    for p in books.entries[i].postings:
        now_accounts.append(p.account)

def tick():
    tick_pending = False
    if not playing:
        return
    if step + 1 < len(books.entries):
        replay_to(step + 1)
        schedule_tick()
    else:
        playing = False                 # the last one stays shown
    redraw()

def schedule_tick():
    if not tick_pending:
        tick_pending = True
        discard_timeout(setTimeout(tick, STEP_MS))

def play():
    if len(books.entries) == 0:
        return
    layout.unfreeze()
    if step < 0 or step + 1 >= len(books.entries):
        replay_to(0)                    # from the first
    playing = True
    schedule_tick()

def pause():
    playing = False

def step_by(d: int):
    playing = False
    if len(books.entries) == 0:
        return
    let start: int = (len(books.entries) if step < 0 and d < 0 else step)
    replay_to(max(0, min(len(books.entries) - 1, start + d)))

def stop_replay():
    playing = False
    step = -1

def replay_html() -> Html:
    let n: int = len(books.entries)
    let caption: str = (f"Transaction {step + 1} of {n}: {books.entries[step].date}, {books.entries[step].what}" if step >= 0 else "")
    html:
        p class="replay":
            if playing:
                button id="pause" onclick=pause(): "Pause"
            else:
                button id="play" onclick=play(): "Play the transactions"
            button id="back" onclick=step_by(-1): "Previous"
            button id="next" onclick=step_by(1): "Next"
            if step >= 0:
                button id="all" onclick=stop_replay(): "Show all"
            if caption != "":
                span class="caption": caption

# The scenario picker, Start over, Save as, and what the scenario is about.
def scenario_option_html(i: int) -> Html:
    let name: str = scenario_names[i]
    let title: str = scenario_titles[i]
    html:
        option value=name: title

def scenario_html() -> Html:
    var about: []str = (books.about.split("\n") if books.about != "" else [])
    html:
        div class="scenario":
            p:
                strong: "Scenario "
                select id="scenario" onchange=choose_scenario():
                    for i in range(len(scenario_names)):
                        + scenario_option_html(i)
                button id="start-over" onclick=start_over(): "Start over"
                button id="save-as" onclick=save_as(): "Save as..."
            for line in about:
                p class="about": line

def last_date() -> str:
    return (books.entries[len(books.entries) - 1].date if len(books.entries) > 0 else "")

def record_html() -> Html:
    let message_class: str = ("message refused" if refused else "message")
    let hint: str = ("To record a transaction, click the account the money leaves: it freezes. Then drag an arrow from it to the account the money reaches."
                     if layout.source == "" else
                     f"{layout.source} is frozen: drag an arrow from it to the account the money reaches. Click {layout.source} again, or press Escape, to let it go.")
    html:
        div class="record":
            + replay_html()
            p: hint
            if message != "":
                p class=message_class: message

# The accounts, one row each with its number, kind and balance and a button
# to delete it, and a last row to open a new one.
def account_row_html(i: int) -> Html:
    let a: AccountRow = books.accounts[i]
    let css: str = css_of(shown().account(a.name))
    html:
        tr:
            td: a.number
            td class=css: a.name
            td: kind_text(a.kind)
            td class="num": money(shown().balance(a.name))
            td:
                button class="delete" onclick=delete_account(a.name): "Delete"

def accounts_html() -> Html:
    html:
        table class="accounts":
            tr:
                th: "Number"
                th: "Account"
                th: "Kind"
                th: "Balance"
                th: ""
            for i in range(len(books.accounts)):
                + account_row_html(i)
            tr class="new":
                td:
                    input id="number" placeholder="613100" size="8"
                td:
                    input id="name" placeholder="a new account" size="16"
                td:
                    select id="kind":
                        option value="asset": "asset"
                        option value="liability": "liability"
                        option value="equity": "equity"
                        option value="revenue": "revenue"
                        option value="expense": "expense"
                td: ""
                td:
                    button id="open" onclick=open_account(): "Open"

const ACCOUNTS_TEXT: str = "Every account, with its number in the chart of accounts, its kind and its balance. An account starts at zero; money coming in adds to it, money going out subtracts, and as every transaction is counted once as positive and once as negative, all the balances add up to zero: the books balance. Open a new account on the last row; an account can be deleted once no transaction touches it."

# A VAT rate as the popup offers it: its member's name, its percentage shown.
def vat_option_html(rate: VatRate_T) -> Html:
    let name: str = str(rate)
    html:
        option value=name: vat_text(rate)

# The transaction from the frozen account to the one the arrow was dropped
# on: when, what, how much. Enter records it, Escape closes it.
def popup_html() -> Html:
    let title: str = f"{layout.source}  →  {layout.target}"
    let date: str = last_date()
    html:
        div:
            div class="backdrop" onclick=close_popup()
            div class="popup":
                h3: title
                label: "Date"
                input id="date" value=date placeholder="2012-01-31"
                label: "What happened"
                input id="what" placeholder="a chair for the office"
                label: "Amount, before VAT"
                input id="amount" placeholder="605.00"
                label: "VAT"
                select id="vat":
                    for rate in VatRate_T:
                        + vat_option_html(rate)
                if popup_message != "":
                    p class="message refused": popup_message
                button id="record" onclick=record_entry(): "Record"
                button id="cancel" onclick=close_popup(): "Cancel"

# The transactions as the books write them, one row each, with what each did
# to every account, and a button to delete it.
def postings_text(e: Entry) -> str:
    var parts: []str = []
    for p in e.postings:
        parts.append(f"{p.account} {signed(p.amount)}")
    return ", ".join(parts)

def journal_row_html(i: int) -> Html:
    let e: Entry = books.entries[i]
    let css: str = ("" if step < 0 else ("now" if i == step else ("later" if i > step else "")))
    html:
        tr class=css:
            td: e.date
            td: e.what
            td: postings_text(e)
            td:
                button class="delete" onclick=delete_entry(i): "Delete"

def journal_html() -> Html:
    html:
        table:
            tr:
                th: "Date"
                th: "Transaction"
                th: "What it did to each account"
                th: ""
            for i in range(len(books.entries)):
                + journal_row_html(i)

# The balance sheet's lines and the titles of its sides, under the graph.
def sides_html() -> Html:
    let x: float = layout.split_x
    let y: float = layout.pl_y
    let down: str = f"M {px(x)} {px(layout.top_y + 8.0)} L {px(x)} {px(layout.height - 8.0)}"
    let across: str = f"M 8 {px(y)} L {px(layout.width - 8.0)} {px(y)}"
    let lx: str = px(x - 16.0)
    let rx: str = px(x + 16.0)
    let ty: str = px(layout.top_y + 28.0)
    let by: str = px(y + 30.0)
    html:
        g class="sides":
            path class="split" d=down
            stext class="side left" x=lx y=ty: "Activa: what the company owns"
            stext class="side right" x=rx y=ty: "Passiva: what it owes, to its owners and others"
            if layout.has_pl:
                path class="split" d=across
                stext class="side left" x=lx y=by: "Costs (charges)"
                stext class="side right" x=rx y=by: "Revenue (produits)"

def live_graph_html(g: Graph) -> Html:
    let rubber: str = (layout.rubber_d() if layout.drawing else "")
    html:
        svg id="graph" viewBox=layout.view_box() class="graph":
            defs:
                marker id="arrow" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto":
                    polygon points="0 0, 10 3.5, 0 7"
                marker id="arrow-now" markerWidth="4.3" markerHeight="3" refX="3.9" refY="1.5" orient="auto":
                    polygon class="now" points="0 0, 4.3 1.5, 0 3"
            + sides_html()
            for f in g.flows:
                + live_arrow_html(g, f)
            for a in g.accounts:
                + live_node_html(g, a)
            if layout.drawing and rubber != "":
                path class="rubber" d=rubber
            if layout.tip != "":
                + layout.tip_html()

# ---------------------------------------------------------------------
# The mouse: a press on a node grabs it (above), these move it and drop it
# ---------------------------------------------------------------------

def on_move(e: Event):
    let m: MouseEvent = MouseEvent(e)
    let box: BoundingRect = document.getElementById("graph").getBoundingClientRect()
    let scale: float = layout.width / box.width    # the svg is drawn at the page's width
    layout.mouse_x = (float(m.clientX) - box.left) * scale
    layout.mouse_y = (float(m.clientY) - box.top) * scale
    if layout.drawing and m.buttons == 0:               # let go where on_up did not see it: no arrow
        layout.drawing = False
    layout.move_to(layout.mouse_x, layout.mouse_y)      # when an account is held
    if layout.held >= 0 or layout.tip != "" or layout.drawing:
        redraw()

def on_up(e: Event):
    let was_open: bool = layout.popup
    layout.release()
    redraw()
    if layout.popup and not was_open:
        discard_timeout(setTimeout(focus_what, 30))       # the popup is drawn: type straight into it


def on_key(e: Event):
    let k: KeyboardEvent = KeyboardEvent(e)
    if k.key == "Escape":
        close_popup()
        redraw()
    elif k.key == "Enter" and layout.popup:
        record_entry()
        redraw()

const APP_TITLE: str = "Accounting, as graph theory"
const APP_INTRO: str = "Your books, as the ledger keeps them. Pick a scenario below: each is a small company's books showing one idea, yours to change; Start over brings it back as it was, Save as keeps your version as a scenario of its own. To record a transaction, click the account the money leaves, so that it freezes, then drag an arrow from it to the account the money reaches, and say when, what and how much; with VAT, the amount is before VAT and the VAT goes to its own account. Transactions are listed below the graph, accounts further down; each has a Delete button there, and a new account is opened on the last row of the accounts. Drag the accounts about within their quarters, and Tidy up lays them out again. Hover over an account or an arrow to see its transactions; Play the transactions replays them one at a time, each highlighted, with the balances as they stood after it."

def main():
    def render() -> Html:
        var sections: []Html = [
            section_html("Accounts are nodes, transactions are edges",
                GRAPH_TEXT + " Drag an account to move it.",
                [record_html(), live_graph_html(shown()), journal_html()])]
        sections.append(section_html("Accounts", ACCOUNTS_TEXT, [accounts_html()]))
        let after: []Html = sections_after_graph(shown())
        for i in range(1, len(after)):          # its first, the balances, is the table above
            sections.append(after[i])
        let wide: str = ("wide" if layout.graph_only else "")
        html:
            div class=wide:
                style: STYLE + LIVE_STYLE
                + live_button_html()
                if layout.popup:
                    + popup_html()
                if layout.graph_only:
                    + record_html()
                    + live_graph_html(shown())
                    + journal_html()
                else:
                    h1: APP_TITLE
                    p: APP_INTRO
                    + scenario_html()
                    for s in sections:
                        + s

    setRenderer(render)
    document.addEventListener("mousemove", on_move)
    document.addEventListener("mouseup", on_up)
    document.addEventListener("keydown", on_key)
    load()
    load_scenarios()

if __name__ == "__main__":       # not when another module imports this
    main()
