#!/usr/bin/env ady2nim
#ady2nim-args js
"""The books of the ledger, drawn in the browser and kept by clicking: the
accounts are nodes to drag, the money that moved between them arrows, and
a click, a dragged arrow and an amount record a transaction.

    make app       (builds the page and ledger_server, runs it, opens the page)

ledger_server.ady serves this page and the books (books_text.ady); the page
asks for the books when it starts and after each change. A transaction or an
account is checked here first, as the ledger checks it (Graph.check), then
sent to the server, which records it unless the books refuse it.

Needs karax: `nimble install karax@1.5.0`.
"""
from dom nimport Event, MouseEvent, BoundingRect, document, window, getElementById, getBoundingClientRect, addEventListener
from dom nimport value, Element, InputElement, confirm, prompt, focus, setTimeout, TimeOut, KeyboardEvent
from karax/karax nimport setRenderer, redraw
from math nimport sqrt
from karax/kajax nimport ajaxGet, ajaxPost
from accounting_model import Account, BookFailure_T, Cents_T, Entry, Flow, Graph, Kind_T, Posting, VatRate_T, entry, moves, purchase_with_vat, sale_with_vat, vat_text
from accounting_gui import STYLE, GRAPH_TEXT, NODE_RADIUS, Point, Shape, circles, boxes, box_html, rim, covers, css_of, money, px, signed, toward, Route, routes_of, tip_of, account_tip, to_html, section_html, sections_after_graph
from books_text import AccountRow, Books, Ratio, account_line, closing_entries, entry_lines, graph_of, kind_named, kind_text, parse_books, ratios_of

const WIDTH: float = 980.0
const HEIGHT: float = 670.0
const ROW_STEP: float = 120.0

# Account number A before B: by length, then digit by digit.
def number_before(a: str, b: str) -> bool:
    return len(a) < len(b) or (len(a) == len(b) and a < b)

