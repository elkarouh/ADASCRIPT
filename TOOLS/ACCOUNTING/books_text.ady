"""The books as text, the way the ledger's server and the page in the browser
pass them to each other: one line per account, per transaction and per
posting, the fields separated by tabs.

    # a line starting with # is a comment
    title     A chair
    about     The company buys a chair, and pays VAT on it.
    currency  USD
    account   550000  asset  Bank account
    entry     2011-01-04  A chair (21% VAT)  2
    posting   Bank account  -60500
    posting   Furniture  50000
    posting   VAT to recover  10500

A title and an about line (there may be several) say what the books are
for: a scenario (scenarios/*.books) says what it shows. Amounts are in cents. An entry from the ledger ends with its number there,
by which the page asks for it to be deleted; one the page writes has none. The server builds the text from its database and the
page reads it; the page writes one account or one entry the same way, and
the server reads it. Nothing here needs a database or a browser, so both
compile it.
"""
from accounting_model import BookFailure_T, Cents_T, Entry, Graph, Kind_T, Posting, colour_of

# An account as a chart of accounts lists it.
type AccountRow is record:
    number: str
    kind:   Kind_T
    name:   str

type Books is record:
    currency: str
    accounts: []AccountRow
    entries:  []Entry
    ids:      []int                 # the ledger's number of each entry, 0 for none
    title:    str                   # what the books are, in a few words, or ""
    about:    str                   # what they show, lines apart, or ""

def bad(detail: str) -> BookFailure_T:
    return BookFailure_T(detail)

def kind_named(word: str) -> Kind_T | !BookFailure_T:
    let k: Kind_T | !ParseFailure_T = parse_enum(Kind_T, word.upper())
    if k is ParseFailure_T:
        return bad(f"{word} is not a kind of account: asset, liability, equity, revenue or expense")
    else:
        return k

def kind_text(k: Kind_T) -> str:
    return str(k).lower()

# A field as it may go between tabs: no tab, no line break.
def field(s: str) -> str:
    return s.replace("\t", " ").replace("\n", " ").replace("\r", " ").strip()

def account_line(a: AccountRow) -> str:
    return f"account\t{field(a.number)}\t{kind_text(a.kind)}\t{field(a.name)}"

def entry_lines(e: Entry, id: int = 0) -> str:
    var text: str = f"entry\t{field(e.date)}\t{field(e.what)}" + (f"\t{id}" if id > 0 else "")
    for p in e.postings:
        text += "\n" + f"posting\t{field(p.account)}\t{int(p.amount)}"
    return text

def text_of_books(b: Books) -> str:
    var lines: []str = []
    if b.title != "":
        lines.append(f"title\t{field(b.title)}")
    if b.about != "":
        for line in b.about.split("\n"):
            lines.append(f"about\t{field(line)}")
    lines.append(f"currency\t{field(b.currency)}")
    for a in b.accounts:
        lines.append(account_line(a))
    for i in range(len(b.entries)):
        lines.append(entry_lines(b.entries[i], b.ids[i]))
    return "\n".join(lines) + "\n"

# TEXT read back. An entry's postings are the posting lines that follow it.
def parse_books(text: str) -> Books | !BookFailure_T:
    var b: Books = Books("", [], [], [], "", "")
    var n: int = 0
    for line in text.split("\n"):
        n += 1
        if line.strip() == "" or line.startswith("#"):
            continue
        let f: []str = line.split("\t")
        if f[0] == "currency" and len(f) == 2:
            b.currency = f[1]
        elif f[0] == "title" and len(f) == 2:
            b.title = f[1]
        elif f[0] == "about" and len(f) == 2:
            if b.about != "":
                b.about += "\n"
            b.about += f[1]
        elif f[0] == "account" and len(f) == 4:
            let kind: Kind_T | !BookFailure_T = kind_named(f[2])
            if kind is BookFailure_T:
                return bad(f"line {n}: {kind.detail}")
            else:
                b.accounts.append(AccountRow(f[1], kind, f[3]))
        elif f[0] == "entry" and (len(f) == 3 or len(f) == 4):
            let id: int | !ParseFailure_T = parse_int(f[3] if len(f) == 4 else "0")
            if id is ParseFailure_T:
                return bad(f"line {n}: {f[3]} is not an entry's number")
            else:
                b.entries.append(Entry(f[1], f[2], []))
                b.ids.append(id)
        elif f[0] == "posting" and len(f) == 3 and len(b.entries) > 0:
            let amount: int | !ParseFailure_T = parse_int(f[2])
            if amount is ParseFailure_T:
                return bad(f"line {n}: {f[2]} is not an amount in cents")
            else:
                b.entries[len(b.entries) - 1].postings.append(Posting(f[1], Cents_T(amount)))
        else:
            return bad(f"line {n}: cannot read '{line}'")
    return b

# The books as a graph: the accounts in their order, every entry posted.
def graph_of(b: Books) -> Graph:
    var g: Graph = Graph()
    for a in b.accounts:
        g.add_account(a.name, colour_of(a.kind))
    for e in b.entries:
        g.post(e)
    return g
