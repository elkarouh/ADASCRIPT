#!/usr/bin/env ady2nim
"""beancount -- the books of a Beancount file, read as Books.

Beancount (https://beancount.github.io) is a plain-text double-entry format:

    2013-01-06 * "RiverBank Properties" "Paying the rent"
      Expenses:Home:Rent          2400.00 USD
      Assets:US:BofA:Checking

Each account a transaction touches becomes an account (Assets, Liabilities,
Equity, Income and Expenses give the five kinds), each transaction an
entry. Amounts are taken in the file's operating currency: a posting in
another one counts at its cost ({53.60 USD}) or its price (@ 105.75 USD),
and one with neither (vacation hours, say) is left out, with the posting
that balances it. An account is named by its last part, or by as many last parts
of its path as tell it from the others. Prices,
balance assertions, events and the like are ignored.

Transactions are made into entries by plain_books.ady: a pay slip, with
several debits against several credits, becomes two entries through a
Clearing account, and one that does not add up in the operating currency
is left out; both are counted in the books' description.
"""
from os nimport fileExists
from math nimport round
from accounting_model import BookFailure_T
from books_text import Books, bad
from plain_books import Collector, Leg, digits_only, is_account

# The words of S, apart at spaces and tabs, a quoted string being one.
def words_of(s: str) -> []str:
    var found: []str = []
    var current: str = ""
    var quoted: bool = False
    for c in s:
        if c == '"':
            quoted = not quoted
            current += c
        elif (c == ' ' or c == '\t') and not quoted:
            if current != "":
                found.append(current)
            current = ""
        else:
            current += c
    if current != "":
        found.append(current)
    return found

# The strings between quotes in S, in order.
def quoted_in(s: str) -> []str:
    var found: []str = []
    var current: str = ""
    var inside: bool = False
    for c in s:
        if c == '"':
            if inside:
                found.append(current)
                current = ""
            inside = not inside
        elif inside:
            current += c
    return found

def is_date(word: str) -> bool:
    return len(word) >= 10 and word[4] == '-' and word[7] == '-' and digits_only(word[:4]) and digits_only(word[5:7]) and digits_only(word[8:10])

# Whether WORD is a number such as 1,234.50 or -3, and its value.
def is_num(word: str) -> bool:
    let r: float | !ParseFailure_T = parse_float(word.replace(",", ""))
    return not (r is ParseFailure_T)

def num(word: str) -> float:
    let r: float | !ParseFailure_T = parse_float(word.replace(",", ""))
    if r is ParseFailure_T:
        return 0.0
    else:
        return r

# The posting line WORDS (an account, then perhaps AMOUNT COMMODITY, a {cost} and a @ price)
# as a Leg in the operating currency OPCUR.
def line_of(w: []str, opcur: str) -> Leg:
    let account: str = w[0]
    if len(w) == 1:
        return Leg(account, 0, False, True)
    if not is_num(w[1]) or len(w) < 3:
        return Leg(account, 0, True, False)
    let units: float = num(w[1])
    let currency: str = w[2]
    if currency == opcur:
        return Leg(account, int(round(units * 100.0)), True, True)
    # the rest, between the braces for a cost, after @ for a price
    var cost: float = 0.0
    var price: float = 0.0
    var total: float = 0.0
    var found_cost: bool = False
    var found_price: bool = False
    var found_total: bool = False
    for i in range(3, len(w)):
        var word: str = w[i]
        if word.startswith("{{"):
            word = word[2:]
        elif word.startswith("{"):
            word = word[1:]
        if word.endswith("}}"):
            word = word[:len(word) - 2]
        elif word.endswith("}"):
            word = word[:len(word) - 1]
        if is_num(word) and i + 1 < len(w) and w[i + 1].replace("}", "") == opcur:
            if w[i - 1] == "@@":
                total = num(word)
                found_total = True
            elif w[i - 1] == "@":
                price = num(word)
                found_price = True
            else:
                cost = num(word)                # {53.60 USD}: what the units cost
                found_cost = True
    if found_cost:                              # a lot is counted at its cost; the gain is another posting
        return Leg(account, int(round(units * cost * 100.0)), True, True)
    if found_total:
        let sign: float = (1.0 if units >= 0.0 else -1.0)
        return Leg(account, int(round(sign * total * 100.0)), True, True)
    if found_price:
        return Leg(account, int(round(units * price * 100.0)), True, True)
    return Leg(account, 0, True, False)

# The books of the Beancount file at PATH.
def books_of_beancount(path: str) -> Books | !BookFailure_T:
    if not fileExists(path):
        return bad(f"there is no file {path}")
    let read: str | !PathFailure_T = Path(path).read_text()
    if read is PathFailure_T:
        return bad(f"{read.op} {read.path}: {read.reason}")
    let text: str = read
    var opcur: str = ""
    var collector: Collector = Collector()
    var date: str = ""
    var what: str = ""
    var lines: []Leg = []
    var open_entry: bool = False
    var all_lines: []str = text.split("\n")
    all_lines.append("")                    # a last, unindented line ends the last transaction
    for raw in all_lines:
        let line: str = raw.replace("\r", "")
        let indented: bool = line.startswith(" ") or line.startswith("\t")
        if open_entry and indented:
            let w: []str = words_of(line)
            if len(w) > 0 and is_account(w[0]):
                lines.append(line_of(w, opcur))
            continue
        if open_entry:
            open_entry = False
            collector.add(date, what, lines)
        if line.startswith("option") and "operating_currency" in line:
            let q: []str = quoted_in(line)
            if len(q) >= 2 and opcur == "":
                opcur = q[1]
            continue
        let w: []str = words_of(line)
        if len(w) >= 2 and is_date(w[0]) and (w[1] == "*" or w[1] == "!" or w[1] == "txn" or w[1] == "?"):
            let strings: []str = quoted_in(line)
            date = w[0][:10]
            var parts: []str = []
            for q in strings:
                if q != "":
                    parts.append(q)
            what = (" - ".join(parts) if len(parts) > 0 else "(no description)")
            lines = []
            open_entry = True
    if opcur == "":
        opcur = "USD"
    return collector.books(path, "Beancount", opcur)
