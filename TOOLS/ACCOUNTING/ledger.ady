#!/usr/bin/env ady2nim
"""ledger -- the books of accounting_model.ady, kept in an SQLite database.

    ledger [--config FILE] [--db FILE] COMMAND ...

    init                          create the database, with the accounts of the config file
    example                       init, then record the example company's year
    account NUMBER KIND NAME...   open an account: KIND is asset, liability, equity,
                                  revenue or expense
    add DATE WHAT ACCOUNT=AMOUNT...
                                  record a transaction: each ACCOUNT (a number or a name)
                                  gets AMOUNT, negative to take it out; they add up to zero
    show                          the accounts and their balances, and the statements
    journal                       every transaction, numbered, with what it did to each account
    delete NUMBER                 delete transaction NUMBER, as journal numbers it
    delete-account ACCOUNT        delete an account no transaction touches
    load FILE                     write the books of FILE (scenarios/*.books) into an empty ledger
    export                        the books as text, as load reads them

The config file (accounting.conf in the current directory, or --config) names the
database and holds the chart of accounts; --db names another database.
A transaction or an account that does not fit the books is refused, and
nothing is written.

    ledger example
    ledger add 2012-01-02 "Printer paper" "Bank account=-12.10" Food=10.00 "VAT to recover=2.10"
    ledger show
"""
from db import DB
from math nimport round
from accounting_model import BookFailure_T, Cents_T, Entry, Graph, Kind_T, Posting, example_entries, money_text
from books_text import AccountRow, Books, bad, graph_of, kind_named, kind_text, parse_books, text_of_books

# ---------------------------------------------------------------------
# The config file
# ---------------------------------------------------------------------

type Config is record:
    database: Path
    currency: str
    accounts: []AccountRow

def is_number(word: str) -> bool:
    if len(word) == 0:
        return False
    for c in word:
        if not (c >= '0' and c <= '9'):
            return False
    return True

# The settings and accounts of the config file at PATH. A relative database
# path is taken from the config file's directory.
def read_config(path: Path) -> Config | !BookFailure_T:
    let text: str | !PathFailure_T = path.read_text()
    if text is PathFailure_T:
        return bad(f"{text.op} {text.path}: {text.reason}")
    var config: Config = Config(path.parent / "accounting.db", "USD", [])
    var n: int = 0
    for raw in text.split("\n"):
        n += 1
        let line: str = raw.split("#")[0].strip()
        if line == "":
            continue
        let words: []str = line.split()
        let rest: str = line[len(words[0]):].strip()
        if is_number(words[0]):
            if len(words) < 3:
                return bad(f"{path}:{n}: an account is: number kind name")
            let kind: Kind_T | !BookFailure_T = kind_named(words[1])
            if kind is BookFailure_T:
                return bad(f"{path}:{n}: {kind.detail}")
            else:
                config.accounts.append(AccountRow(words[0], kind, rest[len(words[1]):].strip()))
        elif words[0] == "database":
            config.database = path.parent / rest
        elif words[0] == "currency":
            config.currency = rest
        else:
            return bad(f"{path}:{n}: no setting {words[0]}")
    return config

# ---------------------------------------------------------------------
# The database: accounts, transactions, and the postings of each transaction
# ---------------------------------------------------------------------

const SCHEMA: []str = [
    """CREATE TABLE IF NOT EXISTS accounts (
        number TEXT PRIMARY KEY,
        name   TEXT NOT NULL UNIQUE,
        kind   TEXT NOT NULL CHECK (kind IN ('asset', 'liability', 'equity', 'revenue', 'expense')))""",
    """CREATE TABLE IF NOT EXISTS transactions (
        id   INTEGER PRIMARY KEY,
        date TEXT NOT NULL,
        what TEXT NOT NULL)""",
    """CREATE TABLE IF NOT EXISTS postings (
        tx      INTEGER NOT NULL REFERENCES transactions(id),
        account TEXT NOT NULL REFERENCES accounts(number),
        amount  INTEGER NOT NULL)""",
    """CREATE TABLE IF NOT EXISTS settings (
        key   TEXT PRIMARY KEY,
        value TEXT NOT NULL)"""]

class Ledger:
    var db: DB

    def __init__(self, path: str):
        self.db = DB(path)
        for statement in SCHEMA:
            self.db.exec(statement)

    def close(self):
        self.db.close()

    # A setting the books keep: their title, what they are about, their
    # currency; "" when there is none.
    def setting(self, key: str) -> str:
        return self.db.value("SELECT value FROM settings WHERE key IS ?", [key])

    def set_setting(self, key: str, value: str):
        self.db.exec("INSERT OR REPLACE INTO settings (key, value) VALUES (?, ?)", [key, value])

    def number_of(self, account: str) -> str:
        return self.db.value("SELECT number FROM accounts WHERE name IS ?", [account])

    # The account named or numbered WORD, by its name; "" when there is none.
    def name_of(self, word: str) -> str:
        let name: str = self.db.value("SELECT name FROM accounts WHERE number IS ?", [word])
        return (name if name != "" else self.db.value("SELECT name FROM accounts WHERE name IS ?", [word]))

    def open_account(self, number: str, kind: Kind_T, name: str) -> None | !BookFailure_T:
        if not is_number(number):
            return bad(f"{number}: an account number is digits")
        if name == "":
            return bad(f"{number}: an account needs a name")
        if self.db.value("SELECT name FROM accounts WHERE number IS ?", [number]) != "":
            return bad(f"there is already an account {number}")
        if self.number_of(name) != "":
            return bad(f"there is already an account named {name}")
        self.db.exec("INSERT INTO accounts (number, name, kind) VALUES (?, ?, ?)",
                     [number, name, kind_text(kind)])

    # Entry E, once the books as they are accept it (Graph.check), in one
    # database transaction.
    def record(self, e: Entry) -> None | !BookFailure_T:
        do:
            self.graph().check(e)
        self.db.exec("BEGIN")
        try:
            self.db.exec("INSERT INTO transactions (date, what) VALUES (?, ?)", [e.date, e.what])
            let tx: str = self.db.value("SELECT last_insert_rowid()")
            for p in e.postings:
                self.db.exec("INSERT INTO postings (tx, account, amount) VALUES (?, ?, ?)",
                             [tx, self.number_of(p.account), str(int(p.amount))])
            self.db.exec("COMMIT")
        except:                         # the database failed: nothing of the entry stays
            self.db.exec("ROLLBACK")
            raise

    # The transactions, by date, each with its postings in the order written.
    def entries(self) -> []Entry:
        return self.books("").entries

    # The transactions, by date, each with its postings in the order written,
    # and their numbers.
    def numbered_entries(self) -> ([]Entry, []int):
        var found: []Entry = []
        var ids: []int = []
        for t in self.db.rows("SELECT id, date, what FROM transactions ORDER BY date, id"):
            var postings: []Posting = []
            for p in self.db.rows("""SELECT a.name, p.amount FROM postings p
                                     JOIN accounts a ON a.number = p.account
                                     WHERE p.tx IS ? ORDER BY p.rowid""", [t[0]]):
                postings.append(Posting(p[0], Cents_T(int(p[1]))))
            found.append(Entry(t[1], t[2], postings))
            ids.append(int(t[0]))
        return (found, ids)

    # Transaction ID, gone, and its postings with it.
    def delete_entry(self, id: int) -> None | !BookFailure_T:
        if self.db.value("SELECT id FROM transactions WHERE id IS ?", [str(id)]) == "":
            return bad(f"there is no transaction {id}")
        self.db.exec("BEGIN")
        try:
            self.db.exec("DELETE FROM postings WHERE tx IS ?", [str(id)])
            self.db.exec("DELETE FROM transactions WHERE id IS ?", [str(id)])
            self.db.exec("COMMIT")
        except:
            self.db.exec("ROLLBACK")
            raise

    # The account named or numbered WORD, closed: only when no transaction
    # touches it, for the books keep what was recorded.
    def delete_account(self, word: str) -> None | !BookFailure_T:
        let name: str = self.name_of(word)
        if name == "":
            return bad(f"there is no account {word}")
        let used: str = self.db.value("SELECT COUNT(DISTINCT tx) FROM postings WHERE account IS ?", [self.number_of(name)])
        if used != "0":
            return bad(f"{name} is in {used} transaction{('' if used == '1' else 's')}: delete {('it' if used == '1' else 'them')} first")
        self.db.exec("DELETE FROM accounts WHERE name IS ?", [name])

    def kinds(self) -> [][]str:
        return self.db.rows("SELECT number, name, kind FROM accounts ORDER BY number")

    # The accounts in the order they were opened, and the entries; the
    # currency the books keep, or CURRENCY.
    def books(self, currency: str) -> Books:
        var accounts: []AccountRow = []
        for row in self.db.rows("SELECT number, kind, name FROM accounts ORDER BY rowid"):
            let kind: Kind_T | !BookFailure_T = kind_named(row[1])
            if kind is BookFailure_T:
                raise ValueError(f"the database has an account of kind {row[1]}")
            else:
                accounts.append(AccountRow(row[0], kind, row[2]))
        let (entries, ids) = self.numbered_entries()
        let kept: str = self.setting("currency")
        return Books((kept if kept != "" else currency), accounts, entries, ids,
                     self.setting("title"), self.setting("about"))

    # Books B (a scenario, books_text.ady) written into an empty ledger: its
    # title, about and currency, its accounts, then its transactions in order.
    def load(self, b: Books) -> None | !BookFailure_T:
        if self.count("transactions") > 0:
            return bad("the ledger has transactions already; books are loaded into an empty one")
        self.set_setting("title", b.title)
        self.set_setting("about", b.about)
        if b.currency != "":
            self.set_setting("currency", b.currency)
        for a in b.accounts:
            if self.name_of(a.number) == "":
                do:
                    self.open_account(a.number, a.kind, a.name)
        for e in b.entries:
            do:
                self.record(e)

    def graph(self) -> Graph:
        return graph_of(self.books(""))

    def count(self, table: str) -> int:
        return int(self.db.value(f"SELECT COUNT(*) FROM {table}"))

# The accounts of CONFIG that the ledger does not have yet, opened.
def open_chart(ledger: Ledger, config: Config) -> int | !BookFailure_T:
    var opened: int = 0
    for a in config.accounts:
        if ledger.name_of(a.number) == "":
            do:
                ledger.open_account(a.number, a.kind, a.name)
            opened += 1
    return opened

# The example company's year, recorded in an empty ledger.
def record_example(ledger: Ledger) -> None | !BookFailure_T:
    if ledger.count("transactions") > 0:
        return bad("the ledger has transactions already; the example goes in an empty one")
    for e in example_entries():
        do:
            ledger.record(e)

# ---------------------------------------------------------------------
# The command line
# ---------------------------------------------------------------------

const USAGE: str = """usage: ledger [--config FILE] [--db FILE] COMMAND ...

    init                          create the database, with the accounts of the config file
    example                       init, then record the example company's year
    account NUMBER KIND NAME...   open an account: KIND is asset, liability, equity,
                                  revenue or expense
    add DATE WHAT ACCOUNT=AMOUNT...
                                  record a transaction: each ACCOUNT (a number or a name)
                                  gets AMOUNT, negative to take it out; they add up to zero
    show                          the accounts and their balances, and the statements
    journal                       every transaction, numbered, with what it did to each account
    delete NUMBER                 delete transaction NUMBER, as journal numbers it
    delete-account ACCOUNT        delete an account no transaction touches
    load FILE                     write the books of FILE (scenarios/*.books) into an empty ledger
    export                        the books as text, as load reads them"""

# 12.10 or -605 as cents.
def cents_of(word: str) -> Cents_T | !BookFailure_T:
    let f: float | !ParseFailure_T = parse_float(word.replace(",", ""))
    if f is ParseFailure_T:
        return bad(f"{word} is not an amount")
    else:
        return Cents_T(int(round(f * 100.0)))

# ACCOUNT=AMOUNT as a posting; the account a number or a name.
def posting_of(ledger: Ledger, word: str) -> Posting | !BookFailure_T:
    let at: int = word.rfind("=")
    if at <= 0:
        return bad(f"{word}: a posting is ACCOUNT=AMOUNT")
    let name: str = ledger.name_of(word[:at])
    if name == "":
        return bad(f"there is no account {word[:at]}")
    do:
        amount <- cents_of(word[at + 1:])
    return Posting(name, amount)

def signed_text(c: Cents_T) -> str:
    return ("+" if c > 0 else "") + money_text(c)

def show(ledger: Ledger, config: Config):
    let g: Graph = ledger.graph()
    print f"Accounts, in {config.currency}"
    for row in ledger.kinds():
        print f"  {row[0]}  {row[1]:<18} {row[2]:<10} {money_text(g.balance(row[1])):>12}"
    print ""
    print "Profit and loss"
    for l in g.profit_and_loss():
        print f"  {l.label:<36} {money_text(l.amount):>12}"
    print f"  {'Profit':<36} {money_text(g.profit()):>12}"
    print ""
    print "Balance sheet"
    for l in g.assets_and_liabilities():
        print f"  {l.label:<36} {money_text(l.amount):>12}"
    print f"  {'Assets less liabilities':<36} {money_text(g.net_assets()):>12}"
    for l in g.equity_lines():
        print f"  {l.label:<36} {money_text(l.amount):>12}"
    print f"  {'Equity':<36} {money_text(g.equity()):>12}"
    print ""
    print ("The books balance." if g.total() == 0 and g.net_assets() == g.equity() else "THE BOOKS DO NOT BALANCE.")

def journal(ledger: Ledger):
    let (entries, ids) = ledger.numbered_entries()
    for i in range(len(entries)):
        let e: Entry = entries[i]
        print f"{ids[i]:>4}  {e.date}  {e.what}"
        for p in e.postings:
            print f"    {p.account:<20} {signed_text(p.amount):>12}"

def main():
    var conf_path: Path = Path("accounting.conf")
    var db_path: str = ""
    var words: []str = []
    var i: int = 0
    let args: []str = $@
    while i < len(args):
        if args[i] == "--config" and i + 1 < len(args):
            conf_path = Path(args[i + 1])
            i += 2
        elif args[i] == "--db" and i + 1 < len(args):
            db_path = args[i + 1]
            i += 2
        elif args[i] == "-h" or args[i] == "--help":
            print USAGE
            quit(0)
        else:
            words.append(args[i])
            i += 1
    die("no command, see -h") if len(words) == 0

    let read: Config | !BookFailure_T = read_config(conf_path)
    if read is BookFailure_T:
        die(read.detail)
    else:
        let config: Config = read
        var ledger: Ledger = Ledger(db_path if db_path != "" else str(config.database))
        let command: str = words[0]
        var done: None | !BookFailure_T = None
        case command:
            when "init":
                let opened: int | !BookFailure_T = open_chart(ledger, config)
                if opened is BookFailure_T:
                    done = opened
                else:
                    print f"{opened} accounts opened"
            when "example":
                let opened: int | !BookFailure_T = open_chart(ledger, config)
                if opened is BookFailure_T:
                    done = opened
                else:
                    done = record_example(ledger)
                    if done is None:
                        print f"{ledger.count('transactions')} transactions recorded"
            when "account":
                if len(words) < 4:
                    die("account NUMBER KIND NAME")
                let kind: Kind_T | !BookFailure_T = kind_named(words[2])
                if kind is BookFailure_T:
                    done = kind
                else:
                    done = ledger.open_account(words[1], kind, " ".join(words[3:]))
                    if done is None:
                        print f"account {words[1]} opened"
            when "add":
                if len(words) < 5:
                    die("add DATE WHAT ACCOUNT=AMOUNT ACCOUNT=AMOUNT...")
                var postings: []Posting = []
                for w in words[3:]:
                    let p: Posting | !BookFailure_T = posting_of(ledger, w)
                    if p is BookFailure_T:
                        die(p.detail)
                    else:
                        postings.append(p)
                done = ledger.record(Entry(words[1], words[2], postings))
                if done is None:
                    print "recorded"
            when "show":
                show(ledger, config)
            when "journal":
                journal(ledger)
            when "delete":
                if len(words) != 2:
                    die("delete NUMBER   (the transaction's number, as journal shows it)")
                let id: int | !ParseFailure_T = parse_int(words[1])
                if id is ParseFailure_T:
                    die(f"{words[1]} is not a transaction's number")
                else:
                    done = ledger.delete_entry(id)
                    if done is None:
                        print f"transaction {id} deleted"
            when "load":
                if len(words) != 2:
                    die("load FILE")
                let text: str | !PathFailure_T = Path(words[1]).read_text()
                if text is PathFailure_T:
                    die(f"{text.op} {text.path}: {text.reason}")
                else:
                    let loaded: Books | !BookFailure_T = parse_books(text)
                    if loaded is BookFailure_T:
                        die(f"{words[1]}: {loaded.detail}")
                    else:
                        done = ledger.load(loaded)
                        if done is None:
                            print f"{ledger.count('accounts')} accounts, {ledger.count('transactions')} transactions loaded"
            when "export":
                stdout.write(text_of_books(ledger.books(config.currency)))
            when "delete-account":
                if len(words) < 2:
                    die("delete-account ACCOUNT")
                done = ledger.delete_account(" ".join(words[1:]))
                if done is None:
                    print "account deleted"
            when others:
                die(f"no command {command}, see -h")
        ledger.close()
        if done is BookFailure_T:
            die(done.detail)

if __name__ == "__main__":
    main()
