#!/usr/bin/env ady2nim
"""The accounting model on its own, no GUI: the article's figures, with the
VAT on the chair and on customer 1's order, the credit note to customer 2,
the material bought on credit and the loan, that kleppmann() adds.

    ady2nim c -r test_accounting_model.ady
"""
from accounting_model import BookFailure_T, Cents_T, Entry, Flow, Graph, Posting, moves, Transaction, example_entries, kleppmann

let g: Graph = kleppmann()

# The two checks the article names.
assert g.total() == 0
assert g.net_assets() == g.equity()

# Balances, in cents.
assert g.balance("Bank") == 3133500    # the chair cost 500 + 105 VAT, customer 1 paid
                                                # 5,000 + 1,050, the loan brings 10,000 less 1,000,
                                                # half the supplier's 1,210 is paid, and 2,000 of salary
                                                # for the software
assert g.balance("Credit card") == -800
assert g.balance("Furniture and equipment") == 37500
assert g.balance("Trade receivables") == 200000  # customer A paid, customer B owes 2,000
assert g.balance("Sales") == -950000
assert g.balance("Share capital") == -2500000
assert g.balance("Food") == 1300
assert g.balance("VAT receivable") == 94500    # 21% of 500, 3,000 and 1,000, to claim back
assert g.balance("Goods for resale") == 100000            # counted at the year end: 1,000 left
assert g.balance("Trade payables") == -423500       # 3,630 and 1,210 owed, 605 paid
assert g.balance("Purchases") == 400000        # 3,000 and 1,000 of material bought
assert g.balance("Change in stock") == -100000 # 1,000 of it still in stock: a cost of 3,000 for the year
assert g.balance("Wages and salaries") == 1000000         # 8,000 of salaries and 2,000 for the software
assert g.balance("Own work capitalised") == -200000   # ... which this cancels out of the year's costs
assert g.balance("Software") == 150000         # the software, 2,000 less a quarter
assert g.balance("Depreciation") == 62500      # a quarter of the chair's 500 and of the software's 2,000
assert g.balance("Bank loans") == -900000           # 10,000 borrowed, 1,000 repaid
assert g.balance("VAT payable") == -105000      # 21% of 5,000, owed to the tax office

# The statements.
assert g.profit() == -213800         # the material sold for 5,000 cost 3,000; the software
                                     # costs this year only its depreciation, 500
assert g.net_assets() == 2286200       # the loan and the stock change assets and liabilities alike
assert g.equity() == 2286200
assert len(g.profit_and_loss()) == 7       # the stock increase is a credit, so it lists as a revenue
assert g.profit_and_loss()[0].label == "Revenue: Sales"

# Two transactions between the same accounts, the same way, are one flow:
# both sales go from Sales to Trade receivables, and both customers' payments
# from Trade receivables to Bank. The credit note goes the other way, so it is
# a flow of its own. The chair is two edges, one to Furniture and equipment and
# one to VAT receivable; customer A's sale two, one from Sales and one from VAT
# payable; the stock is two, from Trade payables; so is the material bought for
# stock; the salary for the software adds Bank to Wages and salaries; the loan
# and its repayment go opposite ways, so they are two flows.
assert len(g.edges) == 26
assert len(g.flows) == 19

# A flow's transactions, with their dates: Share capital to Bank is two.
var capital_to_bank: Flow = g.flows[0]
for f in g.flows:
    if f.source.name == "Share capital" and f.target.name == "Bank":
        capital_to_bank = f
let ts: []Transaction = g.transactions_of(capital_to_bank)
assert len(ts) == 2
assert ts[0].date == "2011-01-05" and ts[1].date == "2011-03-01"
assert ts[0].amount + ts[1].amount == capital_to_bank.amount

# an account's transactions, signed and added up, give its balance
for a in g.accounts:
    var sum: Cents_T = 0
    for t in g.transactions_for(a):
        sum += (t.amount if t.target == a else Cents_T(-int(t.amount)))
    assert sum == a.balance

# every example entry passes the check a ledger makes, and these do not
for e in example_entries():
    assert g.check(e) is None
assert g.check(Entry("2012-01-01", "", [Posting("Bank", -100), Posting("Food", 90)])) is BookFailure_T
assert g.check(Entry("2012-01-01", "", [Posting("Petty cash", -100), Posting("Food", 100)])) is BookFailure_T

# The direction of an arrow: the account money leaves, then the one it reaches.
var chair: Entry = example_entries()[0]
for e in example_entries():
    if e.what.startswith("A chair"):
        chair = e
assert moves(chair, "Bank", "Furniture and equipment")
assert moves(chair, "Bank", "VAT receivable")          # one entry, two flows
assert not moves(chair, "Furniture and equipment", "Bank")
assert not moves(chair, "Bank", "Sales")

print "accounting model: all checks passed"
