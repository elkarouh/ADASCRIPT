#!/usr/bin/env ady2nim
"""htmx_page.ady: the settings read from a query, the groups, and the page drawn.

    ady2nim c -r test_htmx.ady
"""
from accounting_model import BookFailure_T, Cents_T, Entry, Kind_T, Posting, ASSET, EXPENSE, LIABILITY, REVENUE
from books_text import AccountRow, Books
from htmx_page import Grouped, Params, all_text, auto_detail, dates_of, entry_of, fresh_params, grouped, params_of, replayable, replayable_by, shell_text, slider_position, upto

def row(number: str, kind: Kind_T, name: str) -> AccountRow:
    return AccountRow(number, kind, name)

def pay(date: str, what: str, from_name: str, to_name: str, cents: int) -> Entry:
    return Entry(date, what, [Posting(from_name, Cents_T(-cents)), Posting(to_name, Cents_T(cents))])

let accounts: []AccountRow = [row("100000", ASSET, "Bank"), row("101000", ASSET, "Cash"), row("102000", ASSET, "Savings"),
                              row("610000", EXPENSE, "Rent"), row("610100", EXPENSE, "Energy"), row("700000", REVENUE, "Sales")]
let entries: []Entry = [pay("2024-01-01", "takings", "Sales", "Bank", 1000), pay("2024-01-02", "cash", "Sales", "Cash", 500),
                        pay("2024-01-03", "to savings", "Bank", "Savings", 300), pay("2024-01-04", "rent", "Bank", "Rent", 200),
                        pay("2024-01-05", "energy", "Cash", "Energy", 50)]
let b: Books = Books("USD", accounts, entries, [0, 0, 0, 0, 0], "Test", "")

# the query
let p: Params = params_of("scenario=x&tab=Accounts&detail=2&fold=5&opened=10%2F1%7C61%2F2&toggle=61%2F2&go=Statements")
assert p.scenario == "x" and p.tab == "Accounts" and p.detail == "2" and p.fold == 5
assert p.opened == ["10/1", "61/2"]
assert p.toggle == "61/2" and p.go == "Statements"
assert params_of("").detail == "" and params_of("").tab == "Transactions"

# grouped by 2 digits: Bank, Cash and Savings are one asset group (10), Rent and Energy one expense group (61)
let two: Grouped = grouped(b, 2, 0, [], [])
assert len(two.names) == 2
assert len(two.books.accounts) == 3          # the two groups and Sales
# the transfer to savings is inside the group: it is gone
assert len(two.books.entries) == 4
assert len(two.members[0].split("\n")) == 3
# an opened group is its accounts again
let opened: Grouped = grouped(b, 2, 0, [two.keys[0]], [])
assert len(opened.names) == 1 and len(opened.books.accounts) == 5
# nothing grouped
assert len(grouped(b, 0, 0, [], []).names) == 0
# folded: fewer than 2 transactions: Savings alone stays, Rent and Energy are one quiet expense group
let quiet: Grouped = grouped(b, 0, 2, [], [])
assert len(quiet.names) == 1
assert auto_detail(b) == 0                                            # few accounts: not grouped

# the page: a group is clickable, the controls and tabs are there, htmx's attributes have hyphens
let text: str = all_text(b, ["x"], ["X"], "x", params_of("detail=2&go=Accounts"))
assert "data-hx-get=\"/h/all\"" in text
assert "name=\"detail\"" not in text                                  # six accounts: no grouping controls
assert "data_hx" not in text
let big: str = all_text(Books("USD", accounts, entries, [0, 0, 0, 0, 0], "Test", ""), ["x"], ["X"], "x", params_of("detail=2"))
assert "class=\"node group\"" in big                                       # grouped by the URL, whatever the number of accounts
assert "<table" in text and "Savings" in text
assert "<script src=\"/htmx.min.js\"" in shell_text()
# dragged accounts: the position is read, drawn at, and tidy forgets it
assert params_of("pos=100000%2F0%40600.0%2C300.0%7C610000%2F2%4040.5%2C50").pos == "100000/0@600.0,300.0|610000/2@40.5,50"
assert params_of("tidy=1").tidy and not params_of("").tidy
let moved: str = all_text(b, ["x"], ["X"], "x", params_of("pos=100000%2F0%40600.0%2C300.0"))
assert "data_x=\"600.0\" data_y=\"300.0\"" in moved
assert "data_x=\"600.0\"" not in all_text(b, ["x"], ["X"], "x", params_of("pos=100000%2F0%40600.0%2C300.0&tidy=1"))
assert "<script src=\"/drag.js\"" in shell_text()
# the popup's transaction
let vat_books: Books = Books("USD", [row("550000", ASSET, "Bank"), row("700000", REVENUE, "Sales"), row("610000", EXPENSE, "Rent"),
                                    row("411000", ASSET, "VAT receivable"), row("451000", LIABILITY, "VAT payable")], [], [], "T", "")

def popup(source: str, target: str, date: str, what: str, howmuch: str, vat: str) -> Params:
    var p: Params = fresh_params("Transactions")
    p.source = source
    p.target = target
    p.date = date
    p.what = what
    p.howmuch = howmuch
    p.vat = vat
    return p

def posting_amounts(made: Entry | !BookFailure_T) -> []int:
    var cents: []int = []
    case made:
        when BookFailure_T:
            cents.append(0)
        when Entry:
            for p in made.postings:
                cents.append(int(p.amount))
    return cents

assert posting_amounts(entry_of(vat_books, popup("Bank", "Rent", "2024-02-01", "rent", "1,000.50", "NO_VAT"))) == [-100050, 100050]
# a purchase with 21% VAT: the bank pays the rent and the VAT, which is claimed back
assert posting_amounts(entry_of(vat_books, popup("Bank", "Rent", "2024-02-01", "rent", "100", "STANDARD"))) == [-12100, 10000, 2100]
# a sale with 21% VAT: the customer (here the bank) owes the sale and the VAT
assert posting_amounts(entry_of(vat_books, popup("Sales", "Bank", "2024-02-01", "sale", "100", "STANDARD"))) == [-10000, -2100, 12100]
assert entry_of(vat_books, popup("Bank", "Rent", "2024", "x", "1", "NO_VAT")) is BookFailure_T         # the date
assert entry_of(vat_books, popup("Bank", "Rent", "2024-02-01", "", "1", "NO_VAT")) is BookFailure_T    # no description
assert entry_of(vat_books, popup("Bank", "Rent", "2024-02-01", "x", "abc", "NO_VAT")) is BookFailure_T # not a number
assert entry_of(vat_books, popup("Bank", "Rent", "2024-02-01", "x", "0", "NO_VAT")) is BookFailure_T    # nothing

# the page: a frozen account, the popup when both ends are there, and neither for an unknown account
let frozen: str = all_text(vat_books, ["x"], ["X"], "x", params_of("freeze=Bank"))
assert "class=\"node from\"" in frozen and "id=\"popup\"" not in frozen
let drawn: str = all_text(vat_books, ["x"], ["X"], "x", params_of("source=Bank&target=Rent"))
assert "id=\"popup\"" in drawn and "Bank  →  Rent" in drawn
assert "id=\"popup\"" not in all_text(vat_books, ["x"], ["X"], "x", params_of("source=Bank&target=Nothing"))
assert "id=\"popup\"" not in all_text(vat_books, ["x"], ["X"], "x", params_of("source=Bank&target=Rent&cancel=1"))
# the replay: five transactions on five days, those touching Bank being 1, 3 and 4 (numbers 0, 2, 3)
assert dates_of(b) == ["2024-01-01", "2024-01-02", "2024-01-03", "2024-01-04", "2024-01-05"]
assert replayable(b, "") == [0, 1, 2, 3, 4]
assert replayable(b, "Bank") == [0, 2, 3]
assert replayable_by(b, "", -1, 1) == 0 and replayable_by(b, "", -1, -1) == 4        # from the first, going back from the last
assert replayable_by(b, "", 2, 1) == 3 and replayable_by(b, "", 2, -1) == 1
assert replayable_by(b, "", 4, 1) == 4                                               # the last one stays
assert replayable_by(b, "Bank", 0, 1) == 2 and replayable_by(b, "Bank", 1, 1) == 2 and replayable_by(b, "Bank", 1, -1) == 0
assert slider_position(b, -1) == 4 and slider_position(b, 2) == 2
assert len(upto(b, 1).entries) == 2 and len(upto(b, -1).entries) == 5
let seen: str = all_text(b, ["x"], ["X"], "x", params_of("step=1&act=next"))
assert "Transaction 3 of 5, 2024-01-03" in seen
assert "name=\"step\" value=\"2\"" in seen and "class=\"now\"" in seen
assert "class=\"ticker\"" in all_text(b, ["x"], ["X"], "x", params_of("step=0&playing=1&act=tick"))
assert "class=\"ticker\"" not in all_text(b, ["x"], ["X"], "x", params_of("step=0&playing=1&act=pause"))
assert "name=\"step\" value=\"-1\"" in all_text(b, ["x"], ["X"], "x", params_of("step=3&act=all"))
# a frozen account: Play replays its transactions alone
let alone: str = all_text(b, ["x"], ["X"], "x", params_of("source=Rent&act=play"))
assert "Rent: transaction 1 of 1 (number 4 of 5)" in alone
# the T-accounts and the ratios
let ts: str = all_text(b, ["x"], ["X"], "x", params_of("go=T-accounts"))
assert "class=\"taccount\"" in ts and "class=\"tdebit\"" in ts and "Balance" in ts
assert "Current ratio" in all_text(b, ["x"], ["X"], "x", params_of("go=Statements"))
# the exercise: the first transaction is Sales to Bank
let ask: str = all_text(b, ["x"], ["X"], "x", params_of("act=exercise"))
assert "Exercise: transaction 1 of 5, 2024-01-01, 0 right so far" in ask and "Show the answer" in ask
assert "name=\"ex\" value=\"0\"" in ask
let right: str = all_text(b, ["x"], ["X"], "x", params_of("ex=0&score=0&tries=0&source=Sales&target=Bank"))
assert "Right: money leaves Sales and reaches Bank" in right and "name=\"ex\" value=\"1\"" in right and "name=\"score\" value=\"1\"" in right
let wrong: str = all_text(b, ["x"], ["X"], "x", params_of("ex=0&score=0&tries=0&source=Bank&target=Sales"))
assert "Other way round" in wrong and "name=\"tries\" value=\"1\"" in wrong and "class=\"refused\"" in wrong
let lost: str = all_text(b, ["x"], ["X"], "x", params_of("ex=0&score=0&tries=0&source=Bank&target=Rent"))
assert "Not Bank to Rent" in lost and "Or press Show the answer" not in lost
assert "Or press Show the answer" in all_text(b, ["x"], ["X"], "x", params_of("ex=0&score=0&tries=1&source=Bank&target=Rent"))     # the second miss
assert "The answer: " in all_text(b, ["x"], ["X"], "x", params_of("ex=0&act=answer"))
let last: str = all_text(b, ["x"], ["X"], "x", params_of("ex=4&score=3&tries=0&source=Cash&target=Energy"))
assert "That was the last one: 4 right at the first try, out of 5" in last and "Exercise finished" in last
let stopped: str = all_text(b, ["x"], ["X"], "x", params_of("ex=2&score=1&act=stopex"))
assert "Exercise stopped: 1 right" in stopped and "name=\"ex\" value=\"-1\"" in stopped and "name=\"step\" value=\"-1\"" in stopped
assert "Exercise" not in all_text(b, ["x"], ["X"], "x", params_of("detail=2")).replace("Exercise stopped", "")           # not while grouped

# merging shift-clicked accounts into a group of one's own
let picking: str = all_text(b, ["x"], ["X"], "x", params_of("pick=Bank"))
assert "name=\"picked\" value=\"Bank\"" in picking and "node picked" in picking
assert "Merge the picked" in all_text(b, ["x"], ["X"], "x", params_of("picked=Bank%7CCash"))
let made: Grouped = grouped(b, 0, 0, [], ["Money~Bank~Cash"])
assert len(made.names) == 1 and made.names[0] == "Money" and len(made.books.accounts) == 5
assert len(made.books.entries) == 5                              # every transaction still moves money between two nodes
let merged: str = all_text(b, ["x"], ["X"], "x", params_of("picked=Bank%7CCash&mergename=Money&act=merge"))
assert "name=\"merges\" value=\"Money~Bank~Cash\"" in merged and "name=\"picked\" value=\"\"" in merged
assert "Merge accounts of one kind only" in all_text(b, ["x"], ["X"], "x", params_of("picked=Bank%7CRent&mergename=Mixed&act=merge"))
assert "There is already an account" in all_text(b, ["x"], ["X"], "x", params_of("picked=Bank%7CCash&mergename=Rent&act=merge"))

# help, debits and credits, the buttons that change the books
let helped: str = all_text(b, ["x"], ["X"], "x", params_of("act=help&go=Accounts"))
assert "name=\"help\" value=\"1\"" in helped and "Hide help" in helped and "Every account, with its number" in helped
assert "Every account, with its number" not in all_text(b, ["x"], ["X"], "x", params_of("go=Accounts"))
let journal: str = all_text(b, ["x"], ["X"], "x", params_of("dc=1"))
assert "<th>Debit</th>" in journal and "class=\"entry\"" in journal and "Plus and minus" in journal
assert "Debit and credit" in all_text(b, ["x"], ["X"], "x", params_of(""))
let books_page: str = all_text(b, ["x"], ["X"], "x", params_of("go=Accounts"))
assert "data-hx-post=\"/h/do\"" in books_page and "name=\"acctname\"" in books_page and "Delete the account Bank?" in books_page
assert "Delete the transaction of 2024-01-01, takings?" in all_text(b, ["x"], ["X"], "x", params_of(""))
assert "Start over" in books_page and "Delete scenario" in books_page and "Save as..." in books_page and "value=\"x_mine\"" in books_page
assert "Close the year" in books_page                              # the revenue and costs are not zero

print "htmx page: all checks passed"
