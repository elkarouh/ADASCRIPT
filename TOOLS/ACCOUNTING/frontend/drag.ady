#!/usr/bin/env ady2nim
#ady2nim-args js
"""drag -- the one script of our own in the htmx page (htmx_page.ady): an
account is dragged with the mouse. The server draws everything else.

A node is a <g class="node" data_id=".." data_x=".." data_y=".."> (its id and
its centre in the drawing's units). Pressing on it and moving the mouse
moves it, as a translation. While it moves, the arrows are routed again, in the browser, as the server will. Letting go writes the new centre into the form's
hidden field `pos`, and clicks the hidden Redraw button, which asks the
server for the page again, with the arrows drawn to the new place.
A press that does not move is a click, and goes on to htmx; with the shift key
held it picks the account, to be merged with others (the field `pick`).

The frozen account (class "from") is not moved: dragging from it draws an
arrow, a red line to the mouse. Let go over another account, and its name goes
into the hidden field `target` before the same Redraw: the server answers with
the popup that asks when, what and how much.
"""
from shared/accounting_model import Account, Cents_T, Flow, Graph, GREEN
from shared/accounting_gui import Point, Route, boxes, routes_of
from dom nimport Event, Element, InputElement, MouseEvent, BoundingRect, Node, document, getBoundingClientRect, addEventListener, getAttribute, setAttribute, querySelector, querySelectorAll, click, stopPropagation, preventDefault, closest, value

const WIDTH: float = 980.0
const MOVED: float = 4.0                # pixels before a press is a drag

var held: Node = nil                    # the node pressed, or nil
var held_id: str = ""
var held_name: str = ""
var down_x: float = 0.0                 # where the mouse went down, in pixels
var down_y: float = 0.0
var centre_x: float = 0.0               # the node's centre when pressed, in the drawing's units
var centre_y: float = 0.0
var now_x: float = 0.0                  # and where it has been dragged to
var now_y: float = 0.0
var arrowing: bool = False             # the node pressed is the frozen one: an arrow is drawn from it
var moved: bool = False
var dragged: bool = False               # a drag has just ended: the click that follows is not a click

def float_of(text: str) -> float:
    let r: float | !ParseFailure_T = parse_float(text)
    if r is ParseFailure_T:
        return 0.0
    else:
        return r

def number_of(node: Node, attr: str) -> float:
    return float_of(str(node.getAttribute(cstring(attr))))

# How many drawing units a pixel is.
def scale() -> float:
    let box: BoundingRect = document.querySelector("svg.graph").getBoundingClientRect()
    return WIDTH / box.width

def on_down(e: Event):
    let m: MouseEvent = MouseEvent(e)
    if m.button != 0:
        return
    let node: Node = e.target.closest("g.node")
    if node == nil:
        return
    held = node
    arrowing = " from" in (" " + str(node.getAttribute(cstring("class"))) + " ")
    held_id = str(node.getAttribute(cstring("data_id")))
    held_name = str(node.getAttribute(cstring("data_name")))
    down_x = float(m.clientX)
    down_y = float(m.clientY)
    centre_x = number_of(node, "data_x")
    centre_y = number_of(node, "data_y")
    now_x = centre_x
    now_y = centre_y
    moved = False
    e.preventDefault()                  # no text selected while dragging

# While NAME is dragged to (X, Y), every arrow is routed again, here, by the same routes_of the
# server uses (accounting_gui.ady, compiled to JavaScript too), from what the page holds: the
# nodes (data_name, data_x, data_y, data_h) and the arrows (data_from, data_to, data_amount).
# Letting go asks the server, which draws the page again; it comes out the same.
def follow(name: str, x: float, y: float):
    var names: []str = []
    var points: []Point = []
    var tall: []float = []
    var g: Graph = Graph()
    var made: []Account = []
    for n in document.querySelectorAll("g.node"):
        let who: str = str(n.getAttribute(cstring("data_name")))
        names.append(who)
        points.append(Point(x, y) if who == name else Point(number_of(n, "data_x"), number_of(n, "data_y")))
        tall.append(number_of(n, "data_h"))
        made.append(g.add_account(who, GREEN))
    var arrows: []Node = []
    for a in document.querySelectorAll("g[data_from]"):
        let i: int = names.index(str(a.getAttribute(cstring("data_from"))))
        let j: int = names.index(str(a.getAttribute(cstring("data_to"))))
        g.flows.append(Flow(made[i], made[j], Cents_T(int(number_of(a, "data_amount")))))
        arrows.append(a)
    let height: float = float_of(str(document.querySelector("svg.graph").getAttribute(cstring("viewBox"))).split(" ")[3])
    let routes: []Route = routes_of(g, names, points, tall, Point(WIDTH, height), [], [], boxes())
    for k in range(len(arrows)):
        for p in arrows[k].querySelectorAll("path"):
            p.setAttribute(cstring("d"), cstring(routes[k].d))
        let label: Node = arrows[k].querySelector("text.amount")
        if label != nil:
            label.setAttribute(cstring("x"), cstring(f"{routes[k].label.x:.1f}"))
            label.setAttribute(cstring("y"), cstring(f"{routes[k].label.y:.1f}"))

def on_move(e: Event):
    if held == nil:
        return
    let m: MouseEvent = MouseEvent(e)
    let dx: float = float(m.clientX) - down_x
    let dy: float = float(m.clientY) - down_y
    if not moved and abs(dx) < MOVED and abs(dy) < MOVED:
        return
    moved = True
    let k: float = scale()
    if arrowing:
        now_x = centre_x + dx * k
        now_y = centre_y + dy * k
        document.querySelector("#rubber").setAttribute(cstring("d"), cstring(f"M {centre_x:.1f} {centre_y:.1f} L {now_x:.1f} {now_y:.1f}"))
        return
    now_x = max(110.0, min(WIDTH - 110.0, centre_x + dx * k))
    now_y = max(20.0, centre_y + dy * k)
    held.setAttribute(cstring("transform"), cstring(f"translate({now_x - centre_x:.1f},{now_y - centre_y:.1f})"))
    follow(held_name, now_x, now_y)

# The field pos holds "id@x,y|id@x,y": ID's entry replaced, or added.
def with_position(pos: str, id: str, x: float, y: float) -> str:
    var kept: []str = []
    for entry in pos.split("|"):
        if entry != "" and not entry.startswith(id + "@"):
            kept.append(entry)
    kept.append(f"{id}@{x:.1f},{y:.1f}")
    return "|".join(kept)

# The name of the account (not a group) the point (X, Y) is over, other than the one named FROM, or "".
def account_at(x: float, y: float, from_name: str) -> str:
    for n in document.querySelectorAll("g.node"):
        let name: str = str(n.getAttribute(cstring("data_name")))
        let cls: str = " " + str(n.getAttribute(cstring("class"))) + " "
        if name != from_name and not (" group " in cls):
            let half_h: float = number_of(n, "data_h")
            if abs(x - number_of(n, "data_x")) <= 110.0 and abs(y - number_of(n, "data_y")) <= half_h:
                return name
    return ""

def on_up(e: Event):
    if held == nil:
        return
    let was_moved: bool = moved
    let drawn: bool = arrowing
    let from_name: str = str(held.getAttribute(cstring("data_name")))
    held = nil
    arrowing = False
    if was_moved and drawn:
        dragged = True                  # no click after the arrow
        document.querySelector("#rubber").setAttribute(cstring("d"), cstring(""))
        let over: str = account_at(now_x, now_y, from_name)
        if over != "":
            let field: InputElement = InputElement(document.querySelector("input[name=target]"))
            field.value = cstring(over)
            dragged = False
            document.querySelector("#redraw").click()
            dragged = True
        return
    if was_moved:
        let field: InputElement = InputElement(document.querySelector("input[name=pos]"))
        field.value = cstring(with_position(str(field.value), held_id, now_x, now_y))
        document.querySelector("#redraw").click()
        dragged = True                  # after the click above, which must go through

# The click after a drag is swallowed before htmx sees it: a group is not opened by being moved.
def on_click(e: Event):
    if dragged:
        dragged = False
        e.stopPropagation()
        return
    let m: MouseEvent = MouseEvent(e)
    if m.shiftKey:                      # a shift-click picks an account to merge with others, or lets it go
        let node: Node = e.target.closest("g.node")
        if node != nil and not (" group " in (" " + str(node.getAttribute(cstring("class"))) + " ")):
            e.stopPropagation()
            let field: InputElement = InputElement(document.querySelector("input[name=pick]"))
            field.value = node.getAttribute(cstring("data_name"))
            dragged = False
            document.querySelector("#redraw").click()
            field.value = cstring("")

document.addEventListener("mousedown", on_down)
document.addEventListener("mousemove", on_move)
document.addEventListener("mouseup", on_up)
document.addEventListener("click", on_click, True)
