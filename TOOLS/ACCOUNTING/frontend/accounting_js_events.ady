#!/usr/bin/env ady2nim
#ady2nim-args js
"""accounting_js_events -- the events that stay in the browser: an account dragged with
the mouse, and an arrow drawn from one. Every other event is declared in the HTML (hx-*
attributes, accounting_page.ady) and handled on the server (accounting_events.ady).

The accounts and arrows are the page's own text (the hidden pre#books, see accounting_page.ady),
read into a BooksView when htmx has drawn the page. Where each account is drawn is computed from
them (shared/layout.ady), not read off the drawing: while one is dragged, every account is laid
out again and every arrow routed again, here, by the same code the server uses (shared/routes.ady).
Letting go writes the new centre into the form's hidden field `pos`, and clicks the hidden Redraw
button, which asks the server for the page again, with the arrows drawn to the new place.
A press that does not move is a click, and goes on to htmx; with the shift key
held it picks the account, to be merged with others (the field `pick`).

The frozen account (class "from") is not moved: dragging from it draws an
arrow, a red line to the mouse. Let go over another account, and its name goes
into the hidden field `target` before the same Redraw: the server answers with
the popup that asks when, what and how much.
The drag itself (the mouse, when a press becomes a drag, the click after it) is the standard
library's svg_drag, and the page (finding elements, forms, clicks) its browser module, both
in TO_NIM/STDLIB. This file says only what a drag means in this app: `moved_cb`, `dropped_cb`, and
`clicked_cb` for the shift-click.
"""
from shared/routes import Point_T, Route_T, boxes, routes_of
from shared/layout import Arrow_T, Layout_T, Slot_T, arrows_of, layout_of_slots, slots_of, with_position
from browser import Element_T, Event_T, Click_T, page, text, field, on, stop, listen
from svg_drag import Hooks_T, Unit_T, Spot_T, shift, draggable

const WIDTH: Unit_T = 980.0     # the drawing's width (the svg's viewBox); its height varies
const HALF_W: Unit_T = 110.0    # half an account's box, as boxes() in shared/routes.ady

# shared/routes.ady and shared/layout.ady work in plain floats (Point_T): these convert.
def point_of(s: Spot_T) -> Point_T:
    return Point_T(float(s.x), float(s.y))

def spot_at_point(p: Point_T) -> Spot_T:
    return Spot_T(x=Unit_T(p.x), y=Unit_T(p.y))

# The account the element EL draws: its id (number and kind, as the server names it), and its name.
def data_id(el: Element_T) -> str:
    return el.data("id")

def data_name(el: Element_T) -> str:
    return el.data("name")

# ---- The books as the page holds them ----

# The accounts and arrows as the server keeps them (the hidden pre#books), and where each account
# is drawn now: the layout of the accounts, with the reader's places (the field pos) and any
# account dragged since, which is put into pos as the drag goes on. The views are built again each
# time htmx draws the page (see page_drawn).
class BooksView:
    var slots: []Slot_T                 # the accounts, in the server's order
    var arrows: []Arrow_T               # the arrows, each from one account to another
    var pos: str                        # where the reader has dragged accounts: "id@x,y|..."
    var layout: Layout_T                # where everything is drawn

    def __init__(self):
        var kept: str = ""
        var pos: str = ""
        let el: ?Element_T = page.find("pre#books")
        if el is not None:                  # no page yet, the first time: an empty one
            kept = el.text()
            pos = page.field("pos")
        self.slots = slots_of(kept)
        self.arrows = arrows_of(kept)
        self.pos = pos
        self.layout = layout_of_slots(self.slots, self.pos)

    # Where the account at index K is drawn, and what it is called.
    def index_of(self, id: str) -> int:
        for k in range(len(self.slots)):
            if self.slots[k].id == id:
                return k
        return -1

    # The name of the account AT is over, other than FROM_NAME, or "".
    def account_at(self, at: Point_T, from_name: str) -> str:
        for k in range(len(self.slots)):
            let s: Slot_T = self.slots[k]
            let c: Point_T = self.layout.points[k]
            if s.name != from_name and not s.group:
                if abs(at.x - c.x) <= float(HALF_W) and abs(at.y - c.y) <= s.tall:
                    return s.name
        return ""

    # AT, kept inside the quarter of account ID: the assets on the left above the split and the liabilities
    # and equity on the right, the costs and revenue below it, as shared/layout.ady lays them out.
    def within_quarter(self, id: str, at: Point_T) -> Point_T:
        let k: int = self.index_of(id)
        if k < 0:
            return at
        let q: int = self.slots[k].quarter
        var x0: float = float(HALF_W)
        var x1: float = float(WIDTH) / 2.0 - float(HALF_W)
        if q % 2 == 1:
            x0 = float(WIDTH) / 2.0 + float(HALF_W)
            x1 = float(WIDTH) - float(HALF_W)
        var y0: float = 60.0
        var y1: float = self.layout.split_y - 20.0
        if q >= 2:
            y0 = self.layout.split_y + 50.0
            y1 = self.layout.height - 20.0
        return Point_T(max(x0, min(x1, at.x)), max(y0, min(y1, at.y)))

    # The account ID is dragged to AT: it is laid out there, and every arrow is routed again from the
    # layout, as the server will route them when the page is drawn again.
    def move(self, id: str, at: Point_T):
        self.pos = with_position(self.pos, id, at)
        self.layout = layout_of_slots(self.slots, self.pos)
        var names: []str = []
        var tall: []float = []
        for s in self.slots:
            names.append(s.name)
            tall.append(s.tall)
        var sources: []str = []
        var targets: []str = []
        var labels: []str = []
        for a in self.arrows:
            sources.append(a.source)
            targets.append(a.target)
            labels.append(a.label)
        let size: Point_T = Point_T(float(WIDTH), self.layout.height)
        let routes: []Route_T = routes_of(sources, targets, labels, names, self.layout.points, tall, size, [], [], boxes())
        # routes[k] is the way for arrow k: its curve, and where its amount goes
        for k in range(len(self.arrows)):
            let el: ?Element_T = page.find(f"g[data_from=\"{self.arrows[k].source}\"][data_to=\"{self.arrows[k].target}\"]")
            if el is not None:
                for p in el.all("path"):
                    p.trace(routes[k].d)
                let label: ?Element_T = el.find("text.amount")
                if label is not None:
                    label.place_at(spot_at_point(routes[k].label))

var books: BooksView = BooksView()       # the page is read again each time htmx draws it (page_drawn)

# The red dashed line of an arrow being drawn, from the frozen account to the mouse ("" hides it).
def rubber(d: str):
    page.element("#rubber").trace(d)

# Ask the server for the page again: the button #redraw sends the page's form (hx-get="/h/all",
# see accounting_page.ady), hidden fields included, and htmx puts the answer in place.
def redraw():
    page.press("#redraw")

# ---- What a drag means here ----

# While NODE is dragged. The frozen account (class "from") stays where it is: a line runs from
# it to the mouse, the arrow being drawn. Any other account goes where the mouse takes it,
# kept clear of the sides and the top, and the arrows follow.
def moved_cb(node: Element_T, centre: Spot_T, wanted: Spot_T) -> Spot_T:
    if node.has_class("from"):
        rubber(f"M {centre.x:.1f} {centre.y:.1f} L {wanted.x:.1f} {wanted.y:.1f}")
        return wanted                   # the arrow's tip
    let now: Point_T = books.within_quarter(data_id(node), point_of(wanted))
    let spot: Spot_T = spot_at_point(now)
    shift(node, centre, spot)
    books.move(data_id(node), now)
    return spot

# NODE let go at AT.
def dropped_cb(node: Element_T, at: Spot_T):
    if node.has_class("from"):
        # the arrow: let go over another account, its name goes into the hidden field target,
        # and the server answers with the popup that asks when, what and how much. Let go over
        # nothing, the arrow is just dropped.
        rubber("")
        let over: str = books.account_at(point_of(at), data_name(node))
        if over != "":
            page.fill("target", over)
            redraw()
        return
    # an account moved: its new place goes into the hidden field pos
    page.fill("pos", with_position(page.field("pos"), data_id(node), point_of(at)))
    redraw()

# A click with shift held picks an account to merge with others, or lets it go: its name goes
# into the hidden field pick, and the page is asked for again. Other clicks go on to htmx.
def clicked_cb(c: Click_T):
    if not c.shift:
        return
    let node: ?Element_T = c.on("g.node")
    if node is not None and not node.has_class("group"):
        c.stop()                        # not an ordinary click: htmx must not see it
        page.fill("pick", data_name(node))
        redraw()
        page.fill("pick", "")           # htmx has read the form by now: the next redraw picks nothing

# The page was drawn again by the server: the books are read off the new drawing's text.
def page_drawn(e: Event_T):
    books = BooksView()

listen("htmx:afterSwap", page_drawn)
draggable("g.node", "svg.graph", WIDTH, Hooks_T(moved_cb=moved_cb, dropped_cb=dropped_cb, clicked_cb=clicked_cb))
