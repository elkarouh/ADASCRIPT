#!/usr/bin/env ady2nim
#ady2nim-args js
"""accounting_js_events -- the events that stay in the browser: an account dragged with
the mouse, and an arrow drawn from one. Every other event is declared in the HTML (hx-*
attributes, accounting_page.ady) and handled on the server (accounting_events.ady).

A node is a <g class="node" data_id=".." data_x=".." data_y=".."> (its id and
its centre in the drawing's units). Pressing on it and moving the mouse
moves it, as a translation. While it moves, the arrows are routed again, in the browser, as the server will. Letting go writes the new centre into the form's
hidden field `pos`, and clicks the hidden Redraw button, which asks the
server for the page again, with the arrows drawn to the new place.
A press that does not move is a click, and goes on to htmx; with the shift key
held it picks the account, to be merged with others (the field `pick`).

The frozen account (class "from") is not moved: dragging from it draws an
arrow, a red line to the mouse. Let go over another account, and its name goes
into the hidden field `target` before the same Redraw: the server answers with
the popup that asks when, what and how much.
"""

# ---- A few browser words, for a reader who does not write front ends ----
#
# The DOM ("document object model") is the page as the browser holds it: a tree of elements,
# one per HTML tag. `document` is its root. Each element is a `Node` here, and the same
# calls work on all of them:
#   querySelector("css")     the first element below that matches a CSS selector, or nil
#                            ("g.node" = a <g> of class node, "#rubber" = the element with
#                            id="rubber", "input[name=pos]" = the <input> named pos,
#                            "g[data_from]" = a <g> that has a data_from attribute)
#   querySelectorAll("css")  all of them
#   closest("css")           this element or the nearest one above it that matches
#   getAttribute / setAttribute   read or write one attribute, as text
# The drawing is SVG, which is HTML for pictures: a <g> groups shapes, a <path d="M x1 y1
# L x2 y2"> is a line from (x1, y1) to (x2, y2), and transform="translate(dx,dy)" shifts a
# group without changing what is in it.
#
# The browser calls a function of ours, a "listener", for each event it is given (the last
# four lines of this file). An event is a value describing what happened: for the mouse, which
# button, whether shift was held, and where (clientX, clientY, in pixels from the window's top
# left). A click is three events in this order: mousedown, mouseup, click. Every event goes
# down the tree to the element it is for and then back up; htmx listens at the top, on the
# way back up. cstring is the browser's own string type: Nim strings are converted at each call.

from shared/routes import Point, Route, boxes, routes_of
from dom nimport Event, Element, InputElement, MouseEvent, BoundingRect, Node, document, getBoundingClientRect, addEventListener, getAttribute, setAttribute, querySelector, querySelectorAll, click, stopPropagation, preventDefault, closest, value

# ---- Two units: the mouse's and the drawing's ----
#
# The mouse reports pixels; the server keeps an account's place in the drawing's own units,
# 980 wide, whatever size the drawing has on the screen. `distinct` makes them two types, so
# adding a pixel to a drawing unit does not compile. The only way across is the scale.
# shared/routes.ady, which the server uses too, works in plain floats (its Point): point_of
# hands it a Spot.

type Pixel_T is distinct float          # on the screen, as the mouse reports it
type Unit_T is distinct float           # in the drawing, as the server keeps an account's place
type Scale_T is Unit_T / Pixel_T        # drawing units a pixel: pixels * scale = units

type Screen is tuple:                   # a place on the screen
    x: Pixel_T
    y: Pixel_T

type Spot is tuple:                     # a place in the drawing
    x: Unit_T
    y: Unit_T

const WIDTH: Unit_T = 980.0             # the drawing's width (the svg's viewBox); its height varies
const HALF_W: Unit_T = 110.0            # half an account's box, as boxes() in shared/routes.ady
const TOP: Unit_T = 20.0                # how near the top an account may go
const MOVED: Pixel_T = 4.0              # how far a press goes before it is a drag

# ---- The drag, as a small state machine ----
#
#                                         mousemove more than 4 px
#                                    +---------------------------------> DRAGGING (an account moves)
#            mousedown on a node     |                                       |
#   IDLE  ------------------------> PRESSED                                  | mouseup: tell the
#    ^  ^                            |  |   (the frozen account)             | server, then
#    |  +--- mouseup (a click) ------+  +---------------------------> ARROWING (a red line follows)
#    |                                                                       | mouseup
#    +-------------- click (the browser's, swallowed) ----- DROPPED  <-------+
#
# IDLE: nothing pressed. PRESSED: an account is held but has not moved, so letting go is a
# click, which goes on to htmx. DRAGGING: an account is being moved. ARROWING: the press was
# on the frozen account (class "from"), which does not move: an arrow is drawn from it to the
# mouse instead. DROPPED: a drag or an arrow has just ended, and the click the browser sends
# after it is not a click.
type Phase_T is enum IDLE, PRESSED, DRAGGING, ARROWING, DROPPED

# Everything the drag knows, in one value. It is a variant record: which fields exist depends
# on the phase. While PRESSED, DRAGGING or ARROWING it holds an account; while IDLE or DROPPED
# it has no fields at all, so reading `grip.node` then is an error (Nim raises), not a stale value.
#
# A value is built by naming its phase like a function: `PRESSED(node, id, ...)` fills the
# fields in the order declared below, and `IDLE()` is a grip in phase IDLE, with nothing in it.
# The parentheses matter: bare `IDLE` is the enum member (a Phase_T), `IDLE()` the record (a
# Grip_T), and `grip` is a Grip_T. So `grip = IDLE()` sets the drag back to nothing, and
# `grip.phase == IDLE` asks which phase it is in.
type Grip_T (phase: Phase_T) is record:
    case phase is
        when PRESSED | DRAGGING | ARROWING:
            node:   Node                # the <g class="node"> held
            id:     str                 # its data_id: the key of its place in the field pos
            name:   str                 # its data_name: the account's name
            frozen: bool                # it is the frozen account: moving draws an arrow
            down:   Screen              # where the mouse went down
            centre: Spot                # the account's centre then
            now:    Spot                # and where the mouse has taken it (or the arrow's tip)
        when others:
            pass

var grip: Grip_T = IDLE()               # the one drag there is; nothing held at first

# ---- Reading the page ----

# The number in attribute ATTR of NODE ("data_x", "data_y", "data_h"), as drawing units; 0 if
# it is not a number. The server writes these attributes when it draws the page
# (accounting_page.ady).
def unit_of(node: Node, attr: str) -> Unit_T:
    let r: float | !ParseFailure_T = parse_float(str(node.getAttribute(cstring(attr))))
    if r is ParseFailure_T:
        return 0.0
    return Unit_T(r)

# Where an account's centre is, as the server last drew it.
def spot_of(node: Node) -> Spot:
    return Spot(x=unit_of(node, "data_x"), y=unit_of(node, "data_y"))

# The same place as shared/routes.ady wants it: plain floats.
def point_of(s: Spot) -> Point:
    return Point(float(s.x), float(s.y))

# Where the mouse was when event M happened.
def screen_of(m: MouseEvent) -> Screen:
    return Screen(x=Pixel_T(float(m.clientX)), y=Pixel_T(float(m.clientY)))

# Whether NODE has the CSS class WORD ("from", "group"): class="node from" holds several.
def has_class(node: Node, word: str) -> bool:
    return f" {word} " in " " + str(node.getAttribute(cstring("class"))) + " "

# How many drawing units a pixel is: the drawing is scaled to fit the page, so this is asked
# each time (the window may have been resized). getBoundingClientRect is the element's size
# and place on the screen, in pixels.
def scale() -> Scale_T:
    let box: BoundingRect = document.querySelector("svg.graph").getBoundingClientRect()
    return WIDTH / Pixel_T(box.width)   # units / pixels: a Scale_T

# The drawing's height: the last of the four numbers of its viewBox, "0 0 980 670".
def height() -> Unit_T:
    let r: float | !ParseFailure_T = parse_float(str(document.querySelector("svg.graph").getAttribute(cstring("viewBox"))).split(" ")[3])
    if r is ParseFailure_T:
        return 0.0
    return Unit_T(r)

# The name of the account (not a group) the point AT is over, other than FROM_NAME, or "".
def account_at(at: Spot, from_name: str) -> str:
    for n in document.querySelectorAll("g.node"):
        let name: str = str(n.getAttribute(cstring("data_name")))
        if name != from_name and not has_class(n, "group"):
            let c: Spot = spot_of(n)
            if abs(at.x - c.x) <= HALF_W and abs(at.y - c.y) <= unit_of(n, "data_h"):
                return name
    return ""

# ---- Changing the page ----

# While NAME is dragged to AT, every arrow is routed again, here, by the same routes_of the
# server uses (shared/routes.ady, compiled to JavaScript too), from what the page holds: the
# accounts (data_name, data_x, data_y, data_h) and the arrows (<g data_from=".." data_to="..">,
# each holding its <path>s and a <text class="amount">). Only the browser's copy changes;
# letting go asks the server, which draws the page again, and it comes out the same.
def follow(name: str, at: Spot):
    # the accounts: their names, centres (NAME's at AT) and half heights, in page order
    var names: []str = []
    var points: []Point = []
    var tall: []float = []
    for n in document.querySelectorAll("g.node"):
        let who: str = str(n.getAttribute(cstring("data_name")))
        names.append(who)
        points.append(point_of(at if who == name else spot_of(n)))
        tall.append(float(unit_of(n, "data_h")))
    # the arrows: which accounts each joins, and the amount written on it
    var arrows: []Node = []
    var sources: []str = []
    var targets: []str = []
    var texts: []str = []
    for a in document.querySelectorAll("g[data_from]"):
        sources.append(str(a.getAttribute(cstring("data_from"))))
        targets.append(str(a.getAttribute(cstring("data_to"))))
        let words: Node = a.querySelector("text.amount")
        texts.append(str(words.textContent) if words != nil else "")
        arrows.append(a)
    let size: Spot = Spot(x=WIDTH, y=height())
    let routes: []Route = routes_of(sources, targets, texts, names, points, tall, point_of(size), [], [], boxes())
    # routes[k] is the way for arrows[k]: its curve and where its amount goes
    for k in range(len(arrows)):
        for p in arrows[k].querySelectorAll("path"):
            p.setAttribute(cstring("d"), cstring(routes[k].d))
        let label: Node = arrows[k].querySelector("text.amount")
        if label != nil:
            label.setAttribute(cstring("x"), cstring(f"{routes[k].label.x:.1f}"))
            label.setAttribute(cstring("y"), cstring(f"{routes[k].label.y:.1f}"))

# The field pos holds every account the user has moved, "id@x,y|id@x,y": ID's entry replaced,
# or added. The server lays the accounts out, then puts these where they were dropped.
def with_position(pos: str, id: str, at: Spot) -> str:
    var kept: []str = []
    for entry in pos.split("|"):
        if entry != "" and not entry.startswith(id + "@"):
            kept.append(entry)
    kept.append(f"{id}@{at.x:.1f},{at.y:.1f}")
    return "|".join(kept)

# The hidden <input name=NAME> of the page's form. Its button #redraw sends the form to the
# server (hx-get="/h/all", see accounting_page.ady), which answers with the page drawn again.
def field_named(name: str) -> InputElement:
    return InputElement(document.querySelector(cstring(f"input[name={name}]")))

# The red dashed line of an arrow being drawn, from the frozen account to the mouse ("" hides it).
def rubber(d: str):
    document.querySelector("#rubber").setAttribute(cstring("d"), cstring(d))

# ---- The listeners: what each mouse event does, by phase ----

# A button went down. If it is the left one (button 0) and on an account, hold that account.
def on_down(e: Event):
    let m: MouseEvent = MouseEvent(e)
    if m.button != 0:
        return
    let node: Node = e.target.closest("g.node")   # the press may be on the box or the text inside
    if node == nil:
        return                          # not on an account: leave the event to htmx
    let centre: Spot = spot_of(node)
    grip = PRESSED(node, str(node.getAttribute(cstring("data_id"))), str(node.getAttribute(cstring("data_name"))),
                   has_class(node, "from"), screen_of(m), centre, centre)
    e.preventDefault()                  # stop the browser's own drag, which selects text

# The mouse moved. The browser sends this many times a second, whether a button is down or not.
def on_move(e: Event):
    case grip.phase:
        when PRESSED | DRAGGING | ARROWING:
            let at: Screen = screen_of(MouseEvent(e))
            let dx: Pixel_T = at.x - grip.down.x   # how far from where it went down
            let dy: Pixel_T = at.y - grip.down.y
            if grip.phase == PRESSED and abs(dx) < MOVED and abs(dy) < MOVED:
                return                  # not yet a drag: a hand shakes, and it may still be a click
            let k: Scale_T = scale()    # pixels * scale = drawing units
            if grip.frozen:
                # the frozen account stays; a line runs from it to the mouse
                let tip: Spot = Spot(x=grip.centre.x + dx * k, y=grip.centre.y + dy * k)
                grip = ARROWING(grip.node, grip.id, grip.name, grip.frozen, grip.down, grip.centre, tip)
                rubber(f"M {grip.centre.x:.1f} {grip.centre.y:.1f} L {tip.x:.1f} {tip.y:.1f}")
            else:
                # the account's new centre, kept clear of the sides and the top
                let now: Spot = Spot(x=max(HALF_W, min(WIDTH - HALF_W, grip.centre.x + dx * k)), y=max(TOP, grip.centre.y + dy * k))
                grip = DRAGGING(grip.node, grip.id, grip.name, grip.frozen, grip.down, grip.centre, now)
                # shift the account's picture by how far it has come; its data_x/data_y stay the
                # old centre until the server draws the page again
                grip.node.setAttribute(cstring("transform"), cstring(f"translate({now.x - grip.centre.x:.1f},{now.y - grip.centre.y:.1f})"))
                follow(grip.name, now)
        when others:
            pass                        # nothing held: an ordinary mouse move

# The button came up.
def on_up(e: Event):
    case grip.phase:
        when PRESSED:
            grip = IDLE()               # it never moved: a click, which the browser sends next and htmx handles
        when DRAGGING:
            # tell the server the account's new place, the way a form is sent: fill in the
            # hidden field and click the form's button
            let pos: InputElement = field_named("pos")
            pos.value = cstring(with_position(str(pos.value), grip.id, grip.now))
            document.querySelector("#redraw").click()
            grip = DROPPED()            # after the click above, which on_click must let through
        when ARROWING:
            rubber("")
            let over: str = account_at(grip.now, grip.name)
            if over != "":
                # let go over another account: the server answers with the popup that asks
                # when, what and how much
                field_named("target").value = cstring(over)
                grip = IDLE()           # so that on_click lets the click below through
                document.querySelector("#redraw").click()
            grip = DROPPED()            # let go over nothing: the arrow is just dropped
        when others:
            pass

# A click. The browser sends one after every mouseup, a drag's too; htmx would take that one
# as a click on the account (which opens a group, or freezes the account). So after a drag
# (DROPPED) the click is stopped here, before htmx sees it.
# A click with shift held picks an account to merge with others, or lets it go: its name goes
# into the hidden field pick, and the page is asked for again.
def on_click(e: Event):
    if grip.phase == DROPPED:
        grip = IDLE()
        e.stopPropagation()             # the event goes no further up the tree, so htmx never sees it
        return
    if MouseEvent(e).shiftKey:
        let node: Node = e.target.closest("g.node")
        if node != nil and not has_class(node, "group"):
            e.stopPropagation()         # not an ordinary click: htmx must not see it either
            let pick: InputElement = field_named("pick")
            pick.value = node.getAttribute(cstring("data_name"))
            document.querySelector("#redraw").click()
            pick.value = cstring("")    # htmx has read the form by now: the next redraw picks nothing

# Ask the browser to call our functions. They listen on the whole document, so a drag goes on
# when the mouse leaves the account. The click listener gets True ("capture"): it is called on
# the way down the tree, before htmx, which listens on the way up.
document.addEventListener("mousedown", on_down)
document.addEventListener("mousemove", on_move)
document.addEventListener("mouseup", on_up)
document.addEventListener("click", on_click, True)
