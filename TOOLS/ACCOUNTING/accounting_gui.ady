#!/usr/bin/env ady2nim
"""Accounting for computer scientists, as a web page.

    ady2nim c -r accounting_gui.ady > accounting_gui.html   (or: make gui)

The accounting itself is accounting_model.ady: Account and Graph objects
with no GUI in them, tested on their own by test_accounting_model.ady. This
file only renders them: the graph drawn as an SVG (circles for the accounts,
arrows for the money flowing), the transactions, the balances, the profit and
loss statement and the balance sheet. See Martin Kleppmann's "Accounting for
Computer Scientists" (2011,
https://martin.kleppmann.com/2011/03/07/accounting-for-computer-scientists.html).

Needs karax: `nimble install karax@1.5.0`.
"""
from math nimport sqrt
from accounting_model import Account, Cents_T, Colour_T, Dollars_T, Flow, Graph, Line, Transaction, kleppmann

const STYLE: str = """
body { font-family: sans-serif; max-width: 52em; margin: 2em auto; padding: 0 1em; line-height: 1.45; }
table { border-collapse: collapse; margin: 1em 0; }
th, td { border: 1px solid #bbb; padding: 0.3em 0.7em; text-align: left; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
td.green { background: #d6f0d6; }
td.blue { background: #d6e6f8; }
td.pink { background: #f8d6e6; }
svg.graph { width: 100%; height: auto; margin: 1em 0; }
path.edge { fill: none; stroke: #555; stroke-width: 1.5; marker-end: url(#arrow); }
path.hit { fill: none; stroke: transparent; stroke-width: 12; }
g.arrow:hover path.edge { stroke: #000; stroke-width: 2.5; }
polygon { fill: #555; }
circle.green, rect.green { fill: #d6f0d6; stroke: #5a9a5a; stroke-width: 1.5; }
circle.liability, rect.liability { fill: #e3d6f5; stroke: #7a52b0; stroke-width: 1.5; }
circle.revenue, rect.revenue { fill: #a9cdf5; stroke: #1f5fa8; stroke-width: 1.5; }
circle.expense, rect.expense { fill: #fbd29c; stroke: #c06a00; stroke-width: 1.5; }
circle.untouched, rect.untouched { fill: #fff; stroke: #999; stroke-width: 1.5; }
td.untouched { background: #fff; }
circle.pink, rect.pink { fill: #f8d6e6; stroke: #b05a85; stroke-width: 1.5; }
text.label { text-anchor: middle; dominant-baseline: middle; font-size: 11px; }
text.boxname { text-anchor: start; dominant-baseline: middle; font-size: 12px; }
text.boxbalance { text-anchor: end; dominant-baseline: middle; font-size: 12px; font-variant-numeric: tabular-nums; }
text.amount { text-anchor: middle; font-size: 11px; font-weight: bold; paint-order: stroke; stroke: #fff; stroke-width: 3px; }
table.statement { min-width: 22em; }
tr.total td { font-weight: bold; border-top: 2px solid #333; }
"""

const NODE_RADIUS: float = 42.0

# How accounts are drawn: as circles, NODE_RADIUS round, or as boxes with
# the name and the balance, stacked like the lines of a balance sheet.
type Shape is record:
    boxes: bool
    half_w: float       # half the width, or the radius
    half_h: float       # half the height, or the radius

def circles() -> Shape:
    return Shape(False, NODE_RADIUS, NODE_RADIUS)

def boxes() -> Shape:
    return Shape(True, 110.0, 15.0)

# 1234567 cents -> "12,345.67": Dollars_T converts, the format groups.
def money(c: Cents_T) -> str:
    return f"{Dollars_T(c):,.2f}"

def px(v: float) -> str:
    return f"{v:.1f}"

def css_of(a: Account) -> str:
    case a.colour:
        when GREEN:
            return ("liability" if a.balance < 0 else "green")      # an asset is owned, a liability owed
        when BLUE:
            if a.balance == 0:
                return "untouched"                                  # neither yet: nothing went through it
            return ("revenue" if a.balance < 0 else "expense")    # revenue is a negative balance
        when PINK:
            return "pink"

# ---------------------------------------------------------------------
# The layout: where each account sits in the drawing
# ---------------------------------------------------------------------

type Point is record:
    x: float
    y: float

# Where account A is drawn: the example's accounts each have a place;
# another is at (-1, -1), and the page that shows it finds it one.
def place(a: Account) -> Point:
    case a.name:
        when "VAT payable":
            return Point(80.0, 50.0)
        when "Sales":
            return Point(80.0, 190.0)
        when "Trade receivables":
            return Point(270.0, 50.0)
        when "Share capital":
            return Point(80.0, 330.0)
        when "Credit card":
            return Point(480.0, 50.0)
        when "Bank":
            return Point(480.0, 190.0)
        when "VAT receivable":
            return Point(270.0, 330.0)
        when "Furniture and equipment":
            return Point(480.0, 330.0)
        when "Wages and salaries":
            return Point(700.0, 190.0)
        when "Food":
            return Point(700.0, 50.0)
        when "Trade payables":
            return Point(270.0, 470.0)
        when "Goods for resale":
            return Point(480.0, 470.0)
        when "Bank loans":
            return Point(700.0, 470.0)
        when "Purchases":
            return Point(480.0, 610.0)
        when "Change in stock":
            return Point(270.0, 610.0)
        when "Interest expense":
            return Point(900.0, 50.0)
        when "Own work capitalised":
            return Point(900.0, 190.0)
        when "Software":
            return Point(900.0, 330.0)
        when "Depreciation":
            return Point(700.0, 330.0)
        when others:
            return Point(-1.0, -1.0)          # no place of its own: the page finds one

# ---------------------------------------------------------------------
# Rendering: a to_html for each thing of the model that is drawn, called as
# a method (a.to_html(p, tip), g.to_html()) though the model knows nothing of it
# ---------------------------------------------------------------------

# +5,000.00 or -500.00: the change a transaction makes to an account.
def signed(c: Cents_T) -> str:
    return ("+" if c >= 0 else "-") + money(Cents_T(abs(int(c))))

# What hovering over account A shows: its balance, then each transaction that
# touches it with its date, the change it made and the balance after it.
def account_tip(g: Graph, a: Account) -> str:
    var tip: str = f"{a.name}: balance {money(a.balance)}"
    var running: Cents_T = 0
    for t in g.transactions_for(a):
        let change: Cents_T = (t.amount if t.target == a else Cents_T(-int(t.amount)))
        running += change
        tip += "\n" + f"{t.date}   {signed(change)}   -> {money(running)}   {t.what}"
    return tip

# A name as it fits in a node: on one line, or, when long, on two, broken
# at the space nearest its middle.
def label_lines(name: str) -> []str:
    if len(name) <= 14:
        return [name]
    var best: int = -1
    for i in range(len(name)):
        if name[i] == ' ' and (best < 0 or abs(i - len(name) // 2) < abs(best - len(name) // 2)):
            best = i
    if best < 0:
        return [name]
    return [name[:best], name[best + 1:]]

# An account as a node at P: a circle with its name in it. TIP shows when the
# mouse is over it, as for an arrow below.
def to_html(a: Account, p: Point, tip: str) -> Html:
    let cx: str = px(p.x)
    let cy: str = px(p.y)
    let css: str = css_of(a)
    let lines: []str = label_lines(a.name)
    let first: str = lines[0]
    let second: str = (lines[1] if len(lines) == 2 else "")
    let y1: str = (px(p.y - 7.0) if second != "" else cy)
    let y2: str = px(p.y + 7.0)
    html:
        g:
            if tip != "":
                title: tip
            circle class=css cx=cx cy=cy r="42"
            stext class="label" x=cx y=y1: first
            if second != "":
                stext class="label" x=cx y=y2: second

# An account as a box at P, its name on the left and its balance on the
# right, as on a line of a balance sheet (without its sign: the colour, and
# the side of the drawing, say whether it is owned or owed).
# NAME cut to fit ROOM pixels of the box's 12px text, ending in "..." when it is cut.
def fit_name(name: str, room: float) -> str:
    let chars: int = int(room / 6.6)
    if len(name) <= chars or chars < 4:
        return name
    return name[:chars - 1] + "\u2026"

def box_html(a: Account, p: Point, shape: Shape) -> Html:
    let left: str = px(p.x - shape.half_w)
    let top: str = px(p.y - shape.half_h)
    let w: str = px(2.0 * shape.half_w)
    let h: str = px(2.0 * shape.half_h)
    let css: str = css_of(a)
    let nx: str = px(p.x - shape.half_w + 8.0)
    let bx: str = px(p.x + shape.half_w - 8.0)
    let cy: str = px(p.y)
    let balance: str = money(a.balance if a.balance >= 0 else -a.balance)
    let shown_name: str = fit_name(a.name, 2.0 * shape.half_w - 16.0 - 10.0 - 6.7 * float(len(balance)))
    html:
        g:
            rect class=css x=left y=top width=w height=h rx="5"
            stext class="boxname" x=nx y=cy: shown_name
            stext class="boxbalance" x=bx y=cy: balance

# The point D along the way from P to Q.
def toward(p: Point, q: Point, d: float) -> Point:
    let dx: float = q.x - p.x
    let dy: float = q.y - p.y
    let length: float = sqrt(dx * dx + dy * dy)
    return Point(p.x + dx / length * d, p.y + dy / length * d)

# Where the line from an account at C toward Q leaves its SHAPE, EXTRA
# further out.
def rim(c: Point, q: Point, shape: Shape, extra: float) -> Point:
    if not shape.boxes:
        return toward(c, q, shape.half_w + extra)
    let dx: float = q.x - c.x
    let dy: float = q.y - c.y
    var scale: float = 1000000.0
    if dx != 0.0:
        scale = min(scale, (shape.half_w + extra) / abs(dx))
    if dy != 0.0:
        scale = min(scale, (shape.half_h + extra) / abs(dy))
    return Point(c.x + dx * scale, c.y + dy * scale)

# Whether P is within MARGIN of the account at C, drawn as SHAPE.
def covers(c: Point, p: Point, shape: Shape, margin: float) -> bool:
    if shape.boxes:
        return abs(p.x - c.x) < shape.half_w + margin and abs(p.y - c.y) < shape.half_h + margin
    return (p.x - c.x) * (p.x - c.x) + (p.y - c.y) * (p.y - c.y) < (shape.half_w + margin) * (shape.half_w + margin)

# Every arrow is a spline: a smooth curve from one account, through two
# waypoints, to the other. The waypoints sit a third and two thirds of the
# way along, each pushed to one side or the other, so that a long arrow can
# weave between the accounts in its way instead of bowing wide around them
# all; even the least push bows it a little, so that arrows between
# accounts on one line do not lie on top of each other.
const CURVE: float = 18.0

# An arrow's route, and where its amount is written.
type Route is record:
    d: str              # the SVG path
    samples: []Point    # points along it, from start to end
    label: Point

# The route from A to B with its waypoints pushed S1 and S2 to its right (as
# seen going from A to B; to the left when negative).
def route_points(a: Point, b: Point, s1: float, s2: float, shape: Shape) -> []Point:
    let dx: float = b.x - a.x
    let dy: float = b.y - a.y
    let length: float = sqrt(dx * dx + dy * dy)
    let nx: float = -dy / length
    let ny: float = dx / length
    let w1: Point = Point(a.x + dx / 3.0 + nx * s1, a.y + dy / 3.0 + ny * s1)
    let w2: Point = Point(a.x + dx * 2.0 / 3.0 + nx * s2, a.y + dy * 2.0 / 3.0 + ny * s2)
    return [rim(a, w1, shape, 0.0), w1, w2, rim(b, w2, shape, 2.0)]   # the head stops short

# The spline through the route's points (Catmull-Rom) is one cubic curve
# from each point to the next; these are the control points of curve I.
def first_control(pts: []Point, i: int) -> Point:
    let before: Point = pts[max(i - 1, 0)]
    return Point(pts[i].x + (pts[i + 1].x - before.x) / 6.0, pts[i].y + (pts[i + 1].y - before.y) / 6.0)

def second_control(pts: []Point, i: int) -> Point:
    let after: Point = pts[min(i + 2, len(pts) - 1)]
    return Point(pts[i + 1].x - (after.x - pts[i].x) / 6.0, pts[i + 1].y - (after.y - pts[i].y) / 6.0)

# The point at S (0 to the number of curves) along the spline through PTS.
def spline_at(pts: []Point, s: float) -> Point:
    let i: int = min(max(int(s), 0), len(pts) - 2)
    let t: float = min(max(s - float(i), 0.0), 1.0)
    let c1: Point = first_control(pts, i)
    let c2: Point = second_control(pts, i)
    let a: Point = pts[i]
    let b: Point = pts[i + 1]
    let u: float = 1.0 - t
    return Point(u * u * u * a.x + 3.0 * u * u * t * c1.x + 3.0 * u * t * t * c2.x + t * t * t * b.x,
                 u * u * u * a.y + 3.0 * u * u * t * c1.y + 3.0 * u * t * t * c2.y + t * t * t * b.y)

# The spline as an SVG path.
def spline_d(pts: []Point) -> str:
    var d: str = f"M {px(pts[0].x)} {px(pts[0].y)}"
    for i in range(len(pts) - 1):
        let c1: Point = first_control(pts, i)
        let c2: Point = second_control(pts, i)
        d += f" C {px(c1.x)} {px(c1.y)} {px(c2.x)} {px(c2.y)} {px(pts[i + 1].x)} {px(pts[i + 1].y)}"
    return d

# Whether the spline through PTS keeps clear of the accounts at OTHERS, and
# inside the drawing, SIZE wide and high, with room for its amount.
def clear_of(pts: []Point, others: []Point, size: Point, shape: Shape) -> bool:
    return hits(pts, others, size, shape) == 0

# How many points along the spline through PTS fall on an account at OTHERS
# or outside the drawing.
def hits(pts: []Point, others: []Point, size: Point, shape: Shape) -> int:
    var count: int = 0
    for k in range(1, 10 * (len(pts) - 1)):
        let p: Point = spline_at(pts, float(k) / 10.0)
        if p.x < 40.0 or p.x > size.x - 40.0 or p.y < 20.0 or p.y > size.y - 20.0:
            count += 1
        for o in others:
            if covers(o, p, shape, 8.0):
                count += 1
    return count

# The route of F's arrow, from A to B: of the waypoints' pushes, the least
# (and the least crooked) that keeps it clear of the accounts at OTHERS and
# inside the drawing; if none does, the least. Money flowing both ways
# between two accounts makes two arrows, each pushed to its own right, so
# that both, and their amounts, show.
def route_of(g: Graph, f: Flow, a: Point, b: Point, others: []Point, size: Point, shape: Shape) -> []Point:
    var shifts: []float = [CURVE, -CURVE, 40.0, -40.0, 70.0, -70.0, 100.0, -100.0, 140.0, -140.0, 180.0, -180.0]
    for other in g.flows:
        if other.source == f.target and other.target == f.source:
            shifts = [30.0, 60.0, 100.0, 150.0, 190.0]
    var best: []Point = route_points(a, b, shifts[0], shifts[0], shape)
    var best_cost: float = 1000000.0
    for s1 in shifts:
        for s2 in shifts:
            let cost: float = abs(s1) + abs(s2) + abs(s1 - s2)
            if cost < best_cost:
                let pts: []Point = route_points(a, b, s1, s2, shape)
                if clear_of(pts, others, size, shape):
                    best = pts
                    best_cost = cost
    if best_cost < 1000000.0:
        return best
    var fewest: int = 1000000                   # none is clear: the one over the fewest accounts
    for s1 in shifts:
        for s2 in shifts:
            let pts: []Point = route_points(a, b, s1, s2, shape)
            let count: int = hits(pts, others, size, shape)
            let cost: float = abs(s1) + abs(s2) + abs(s1 - s2)
            if count < fewest or (count == fewest and cost < best_cost):
                best = pts
                fewest = count
                best_cost = cost
    return best

# Where an amount TEXT goes along an arrow, at SAMPLES: beside it, at the
# first of a few spots, from the middle outwards, where it covers neither an
# account at CENTRES (half as high as TALL says) nor an amount already written, whose middles are at
# TAKEN and half-widths in HALVES.
def label_spot(samples: []Point, text: str, centres: []Point, tall: []float, taken: []Point, halves: []float, shape: Shape, size: Point) -> Point:
    let half: float = 3.3 * float(len(text)) + 3.0
    var first: Point = Point(0.0, 0.0)
    var tried: bool = False
    let last: int = len(samples) - 1
    for along in [0.5, 0.42, 0.58, 0.33, 0.67, 0.25, 0.75, 0.17, 0.83]:
        let k: int = min(max(int(along * float(last) + 0.5), 1), last - 1)
        let p: Point = samples[k]
        let q: Point = samples[k + 1]
        let o: Point = samples[k - 1]
        let dx: float = q.x - o.x
        let dy: float = q.y - o.y
        let length: float = max(sqrt(dx * dx + dy * dy), 0.001)
        for side in [10.0, -10.0]:
            let spot: Point = Point(p.x - dy / length * side, p.y + dx / length * side)    # the amount's middle
            if not tried:
                first = spot
                tried = True
            var free: bool = spot.x - half > 2.0 and spot.x + half < size.x - 2.0     # inside the drawing
            for k in range(len(centres)):
                if abs(spot.x - centres[k].x) < shape.half_w + half and abs(spot.y - centres[k].y) < tall[k] + 7.0:
                    free = False
            for i in range(len(taken)):
                if abs(spot.x - taken[i].x) < half + halves[i] + 2.0 and abs(spot.y - taken[i].y) < 13.0:
                    free = False
            if free:
                return Point(spot.x, spot.y + 4.0)      # the text's baseline
    return Point(first.x, first.y + 4.0)

# Between boxes, an arrow is one cubic curve that leaves the side of a box
# and enters the side of the other square to it, as flows are drawn in a
# Sankey diagram: across the middle from one column to the other, or, from
# a box to another in its own column, out of their outer sides and back, a
# bracket like a T-account's.

# Which side of the box at A an arrow to B leaves (-1 left, 1 right).
def side_of(a: Point, b: Point, size: Point, shape: Shape) -> float:
    if abs(a.x - b.x) > 2.0 * shape.half_w:
        return (1.0 if b.x > a.x else -1.0)
    return (-1.0 if a.x < size.x / 2.0 else 1.0)     # the same column: its outer side

# The curve's ends and control points, from the box at A to the one at B,
# leaving and entering PORT_A and PORT_B below their middles.
def box_curve(a: Point, b: Point, port_a: float, port_b: float, size: Point, shape: Shape) -> []Point:
    let out: float = side_of(a, b, size, shape)
    let start: Point = Point(a.x + out * shape.half_w, a.y + port_a)
    if abs(a.x - b.x) > 2.0 * shape.half_w:
        let stop: Point = Point(b.x - out * (shape.half_w + 2.0), b.y + port_b)
        let k: float = abs(stop.x - start.x) / 2.0
        return [start, Point(start.x + out * k, start.y), Point(stop.x - out * k, stop.y), stop]
    let stop: Point = Point(b.x + out * (shape.half_w + 2.0), b.y + port_b)
    var k: float = 30.0 + 0.25 * abs(b.y - a.y)
    if out < 0.0:
        k = min(k, start.x - 12.0)                   # not out of the drawing
    else:
        k = min(k, size.x - 12.0 - start.x)
    return [start, Point(start.x + out * k, start.y), Point(stop.x + out * k, stop.y), stop]

# The point at T (0 to 1) along the cubic curve C.
def bezier_at(c: []Point, t: float) -> Point:
    let u: float = 1.0 - t
    return Point(u * u * u * c[0].x + 3.0 * u * u * t * c[1].x + 3.0 * u * t * t * c[2].x + t * t * t * c[3].x,
                 u * u * u * c[0].y + 3.0 * u * u * t * c[1].y + 3.0 * u * t * t * c[2].y + t * t * t * c[3].y)

# Where each arrow leaves and enters its boxes, below their middles: the
# arrows on one side of a box spread along it, in the order of the boxes at
# their other ends, top to bottom, so that they do not cross there. Two
# numbers a flow, its start's and its end's.
def ports_of(g: Graph, names: []str, points: []Point, size: Point, shape: Shape, tall: []float) -> []float:
    var ports: []float = []
    var ends: []int = []                # for each end of each flow: its box,
    var sides: []float = []             # the side it is on,
    var heights: []float = []           # and how high the box at the other end is
    for f in g.flows:
        let i: int = names.index(f.source.name)
        let j: int = names.index(f.target.name)
        let out: float = side_of(points[i], points[j], size, shape)
        let into: float = (-out if abs(points[i].x - points[j].x) > 2.0 * shape.half_w else out)
        ends.append(i)
        sides.append(out)
        heights.append(points[j].y)
        ends.append(j)
        sides.append(into)
        heights.append(points[i].y)
        ports.append(0.0)
        ports.append(0.0)
    for e in range(len(ends)):
        var count: int = 0
        var rank: int = 0
        for o in range(len(ends)):
            if ends[o] == ends[e] and sides[o] == sides[e]:
                count += 1
                if heights[o] < heights[e] or (heights[o] == heights[e] and o < e):
                    rank += 1
        ports[e] = (float(rank + 1) / float(count + 1) * 2.0 - 1.0) * (tall[ends[e]] - 3.0)
    return ports

# The arrows of G, as the accounts NAMES sit at POINTS, drawn as SHAPE (each
# box half as high as TALL says), in
# a drawing SIZE wide and high: each one's route, then each one's amount, placed clear of
# those already placed and of other text, whose middles are at TAKEN and
# half-widths in HALVES.
def routes_of(g: Graph, names: []str, points: []Point, tall: []float, size: Point, words: []Point, widths: []float, shape: Shape) -> []Route:
    var routes: []Route = []
    var taken: []Point = words
    var halves: []float = widths
    let ports: []float = (ports_of(g, names, points, size, shape, tall) if shape.boxes else [])
    for n in range(len(g.flows)):
        let f: Flow = g.flows[n]
        let i: int = names.index(f.source.name)
        let j: int = names.index(f.target.name)
        var d: str = ""
        var samples: []Point = []
        if shape.boxes:
            let c: []Point = box_curve(points[i], points[j], ports[2 * n], ports[2 * n + 1], size, shape)
            d = f"M {px(c[0].x)} {px(c[0].y)} C {px(c[1].x)} {px(c[1].y)} {px(c[2].x)} {px(c[2].y)} {px(c[3].x)} {px(c[3].y)}"
            for k in range(31):
                samples.append(bezier_at(c, float(k) / 30.0))
        else:
            var others: []Point = []
            for k in range(len(points)):
                if k != i and k != j:
                    others.append(points[k])
            let pts: []Point = route_of(g, f, points[i], points[j], others, size, shape)
            d = spline_d(pts)
            for k in range(31):
                samples.append(spline_at(pts, float(k) / 10.0))
        let text: str = money(f.amount)
        let label: Point = label_spot(samples, text, points, tall, taken, halves, shape, size)
        taken.append(Point(label.x, label.y - 4.0))
        halves.append(3.3 * float(len(text)) + 3.0)
        routes.append(Route(d, samples, label))
    return routes

# What hovering over F's arrow shows: each of its transactions, one a line,
# with its date and amount.
def tip_of(g: Graph, f: Flow) -> str:
    var tip: str = f"{f.source.name} to {f.target.name}"
    for t in g.transactions_of(f):
        tip += f"\n{t.date}   {money(t.amount)}   {t.what}"
    return tip

# A flow as an arrow along ROUTE, with its amount where the route says. TIP
# shows when the mouse is over it, as the browser's tooltip (the live page,
# which cannot, passes "" and shows its own): a wider invisible path under
# the arrow makes it easy to point at.
def to_html(f: Flow, route: Route, tip: str) -> Html:
    let d: str = route.d
    let lx: str = px(route.label.x)
    let ly: str = px(route.label.y)
    html:
        g class="arrow":
            if tip != "":
                title: tip
            path class="hit" d=d
            path class="edge" d=d
            stext class="amount" x=lx y=ly: money(f.amount)

def to_html(g: Graph) -> Html:
    var names: []str = []
    var points: []Point = []
    var tall: []float = []
    for a in g.accounts:
        names.append(a.name)
        points.append(place(a))
        tall.append(NODE_RADIUS)
    let routes: []Route = routes_of(g, names, points, tall, Point(980.0, 670.0), [], [], circles())
    html:
        svg viewBox="0 0 980 670" class="graph":
            defs:
                marker id="arrow" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto":
                    polygon points="0 0, 10 3.5, 0 7"
            for i in range(len(g.flows)):
                + to_html(g.flows[i], routes[i], tip_of(g, g.flows[i]))
            for a in g.accounts:
                + a.to_html(place(a), account_tip(g, a))

def to_html(edges: []Transaction) -> Html:
    html:
        table:
            tr:
                th: "Date"
                th: "Transaction"
                th: "From"
                th: "To"
                th: "Amount"
            for t in edges:
                tr:
                    td: t.date
                    td: t.what
                    td class=css_of(t.source): t.source.name
                    td class=css_of(t.target): t.target.name
                    td class="num": money(t.amount)

def to_html(accounts: []Account) -> Html:
    html:
        table:
            tr:
                th: "Account"
                th: "Balance"
            for a in accounts:
                tr:
                    td class=css_of(a): a.name
                    td class="num": money(a.balance)

def to_html(lines: []Line, total_label: str, total: Cents_T) -> Html:
    html:
        table class="statement":
            for l in lines:
                tr:
                    td: l.label
                    td class="num": money(l.amount)
            tr class="total":
                td: total_label
                td class="num": money(total)

def section_html(title: str, text: str, parts: []Html) -> Html:
    html:
        section:
            h2: title
            p: text
            for part in parts:
                + part

def page_html(title: str, text: str, sections: []Html) -> Html:
    html:
        html lang="en":
            head:
                meta charset="utf-8"
                title: title
                style: STYLE
            body:
                h1: title
                p: text
                for s in sections:
                    + s

# The page's sections, below the graph; accounting_live.ady shows them too.
def sections_after_graph(g: Graph, with_text: bool = True) -> []Html:
    let t: bool = with_text
    return [
        section_html("Balances",
            ("" if not t else "An account starts at zero. Money coming in adds to it, money going out subtracts. Every transaction is counted once as positive and once as negative, so all the balances add up to zero: that is what accountants call balancing the books."),
            [g.accounts.to_html()]),
        section_html("Profit and loss",
            ("" if not t else "Only the blue accounts: revenue less expenses. A negative balance on a blue account is revenue, so the sign flips when it is reported."),
            [g.profit_and_loss().to_html("Profit", g.profit())]),
        section_html("Balance sheet",
            ("" if not t else "The green accounts on one side, the pink accounts and the profit on the other. Profit is not cash: the bank holds less than the 25,000 invested plus the sales, because customers may still owe part of their orders."),
            [g.assets_and_liabilities().to_html("Assets less liabilities", g.net_assets()),
             g.equity_lines().to_html("Total equity", g.equity())]),
    ]

const GRAPH_TEXT: str = "Each arrow is an edge of the graph: an amount flowing from one account to another, and several transactions between the same two accounts are drawn as one arrow with their sum. An account can be a bank account, a card, a customer, or an abstract category such as food or furniture. Accounts are coloured: green for what the company owns (assets) and purple for what it owes (liabilities), blue for revenue and orange for expense, pink for the money its shareholders put in."

const TITLE: str = "Accounting for computer scientists"
const INTRO: str = "Basic accounting is graph theory. The company below is the example of Martin Kleppmann's article of that name, worked out by a program."

def main():
    let books: Graph = kleppmann()
    assert books.total() == 0                   # the books balance
    assert books.net_assets() == books.equity()     # and so does the balance sheet

    var sections: []Html = [
        section_html("Accounts are nodes, transactions are edges", GRAPH_TEXT,
            [books.to_html(), books.edges.to_html()])]
    for s in sections_after_graph(books):
        sections.append(s)
    print "<!doctype html>"
    print page_html(TITLE, INTRO, sections)

if __name__ == "__main__":       # not when accounting_live.ady imports this
    main()
