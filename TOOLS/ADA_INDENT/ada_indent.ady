#!/usr/bin/env ady2nim
#ady2nim-args c -d:release --opt:speed
# ada_indent.ady - a simplified Ada source re-indenter, written in Adascript.
#
# This is NOT a full Ada parser. It implements only the slice of Ada grammar
# that matters for indentation: the keywords that open, close, or split an
# indented block. Everything else is treated as an ordinary statement line.
#
# The model is a stack machine. Each open construct pushes a frame; the
# display indent of a line is the stack depth (times the indent width), with
# small adjustments for keywords that align with their opener rather than the
# block body (end / elsif / else / when / exception / or / private / begin).

const INDENT_WIDTH: Natural = 2

# The indentation-significant constructs. A frame is pushed for each open block; the kind is only consulted where it
# changes behaviour (PKG/DECLARE become BLOCK at 'begin'; WHEN frames are popped specially at 'end').
type Block_T is enum:
    PKG          # package / subprogram / task / protected / type spec opened by trailing 'is'
    TYPE_HEADER  # 'type T is' on its own line - pairs with RECORD below it
    DECLARE      # a declare block (block label or bare 'declare')
    BLOCK        # a begin ... end region (statement part)
    IF           # if ... then
    LOOP         # [while/for] ... loop
    CASE         # case ... is
    WHEN         # when ... =>   (case alternative or exception handler)
    RECORD       # record  ... end record
    SELECT       # select ... end select
    DO           # accept ... do  /  return ... do  (extended return)
    GENERIC      # 'generic' - its formal part, closed by the unit it introduces

# Scanner state for string-literal tracking inside a single line.
type Str_State_T is enum:
    CODE               # outside any string literal
    INSIDE_STRING_LIT  # inside a double-quoted string literal

# Kind of a parenthesised expression, for indentation purposes.
type Paren_Kind_T is enum:
    OUTSIDE    # sentinel: entry_top_kind when the paren stack is empty
    PLAIN      # plain parenthesis
    IF_EXPR    # (if ... then ... else ...)
    CASE_EXPR  # (case ... is when ...)
    FOR_EXPR   # (for ... => ...)  quantified or iterated expression

# The keywords that make a '(' more than a plain one. Anything else after the
# '(' -- an operand, another '(', or nothing at all -- leaves it PLAIN.
const PAREN_KIND: {str}Paren_Kind_T = {
    "if": IF_EXPR, "case": CASE_EXPR, "for": FOR_EXPR,
}

# ---------------------------------------------------------------------------
# Lexical helpers - all work on a single physical line.
# ---------------------------------------------------------------------------
nimport strscan

def code_positions(s: str) -> (Natural, char):
    """Yield (index, character) for each character of s that is outside a string
    or character literal.

    The input must already have comments removed (see strip_code). Double-quoted
    strings are skipped whole. A character literal ('x') is detected as a quote,
    any single character, then a closing quote; a quote followed by a letter that
    is NOT followed by a closing quote is an attribute tick (X'Image) and is left
    alone - the letter and everything after it are yielded normally.

    The index comes back with the character because a caller that only counts
    (paren_delta) and one that has to look at what follows (scan_parens) both
    need this rule, and a second copy of it in the second caller is a copy that
    can drift.
    """
    var i: Natural = 0
    let n: Natural = len(s)
    while i < n:
        case s[i]:
            when '"':
                i = skip_quoted(s, i, '"')
            when '\'' if i + 2 < n and s[i + 2] == '\'':
                i += 3                           # character literal: skip 'x' whole
            when others:
                yield (i, s[i])
                i += 1

def paren_delta(line: str) -> int:          # int: ')' without '(' makes it negative
    """Net '(' minus ')' on the line, ignoring parens inside string and character
    literals. The input must already have comments removed (see strip_code)."""
    var depth: int = 0                      # int: a line may close more than it opens
    for _i, c in code_positions(line):
        case c:
            when '(': depth += 1
            when ')': depth -= 1
            when others: pass
    return depth

def last_word(code: str) -> str:
    """Lowercased final token, after dropping a trailing ';'. '' if empty.

    The token is cut back to its trailing identifier, so a keyword written hard
    against the punctuation before it -- 'Ids_File : in out Text_IO.File_Type)is',
    which Ada's free format allows -- comes back as 'is' and still reads as the
    block opener it is. Without the cut the whole blob is the token, no frame is
    pushed for the subprogram, and its declarative part indents as a continuation
    of the parameter list instead.

    A token not ending in an identifier character ('=>', 'Boolean)') is returned
    whole, as before: the callers compare against keywords, so cutting those
    would change nothing and only lose information.
    """
    let parts: []str = code.strip().rstrip(";").split()
    return "" if len(parts) == 0
    let tok: str = parts[-1]
    return tok.lower() if not is_ident_ch(tok[len(tok) - 1])
    var i: Natural = len(tok)
    while i > 0 and is_ident_ch(tok[i - 1]):
        i -= 1
    return tok[i:].lower()

def ends_with_condition_then(code_s: str) -> bool:
    """True if the line's final token is the 'then' that ENDS an if/elsif
    condition, rather than the 'then' of the 'and then' connective.

    'and then' is one operator. A condition broken after it continues on the
    next line, so the line has not reached its 'then' at all -- but its last
    word is 'then' all the same, and every place that asks 'does the condition
    end here' was fooled by it: the tracker closed the condition early, and the
    real 'then' further down then opened a second frame.
    """
    return False if last_word(code_s) != "then"
    # The word before that 'then', cut the way last_word() cuts: splitting on
    # blanks alone would miss the 'then' in ')then', which Ada's free format
    # allows and which real sources write -- the whole point of that cut.
    let head: str = code_s.strip().rstrip(";").strip()
    return last_word(head[:len(head) - 4]) != "and"


def code_words(code_s: str) -> []str:
    """The identifier words of a line at the TOP level, with string and
    character literals skipped whole and anything inside parentheses left out.

    Both exclusions keep a keyword from being counted where it is not one: not
    in a literal, and not inside a parenthesis, where 'if' and 'case' begin an
    EXPRESSION -- '(if A then B else C)' opens no block and has no 'end'."""
    var i: Natural = 0
    var depth: Natural = 0
    let n: Natural = len(code_s)
    while i < n:
        if code_s[i] == '"':
            i = skip_quoted(code_s, i, '"')
        elif code_s[i] == '\'' and i + 2 < n and code_s[i + 2] == '\'':
            i += 3
        elif code_s[i] == '(':
            depth += 1
            i += 1
        elif code_s[i] == ')':
            depth = max(0, depth - 1)
            i += 1
        elif is_ident_ch(code_s[i]):
            var j: Natural = i
            while j < n and is_ident_ch(code_s[j]):
                j += 1
            if depth == 0:
                result.append(code_s[i:j].lower())
            i = j
        else:
            i += 1


def record_delta(code_s: str) -> int:          # int: 'end record' makes it negative
    """Net component lists the line opens: +1 for a 'record' that opens one,
    -1 for the 'record' of an 'end record', and 0 for the 'null record' of a
    type that has none.

    The dispatches key on a line's LAST word, which is enough while the opener
    is the last thing on it. 'type T is record Title : String_Ptr_T;' puts the
    opener in the middle, with the first component already beside it, so the
    last word belongs to that component and no dispatch ever sees the 'record'.
    """
    var delta: int = 0
    var prev: str = ""
    for w in code_words(code_s):
        if w == "record":
            if prev == "end":
                delta -= 1
            elif prev != "null":
                delta += 1
        prev = w
    return delta


def has_condition_then(code_s: str) -> bool:
    """True if a top-level 'then' on this line ends a condition.

    The 'then' of an 'and then' is a connective and ends nothing, and one
    inside parentheses belongs to an if-EXPRESSION. What remains marks a line
    on which an if statement's condition is complete -- so the statement is
    open from here, whatever else the line goes on to say.
    """
    var prev: str = ""
    for w in code_words(code_s):
        if w == "then" and prev != "and":
            return True
        prev = w
    return False


def if_delta(code_s: str) -> int:               # int: 'end if' makes it negative
    """Net if statements the line opens: +1 for each 'if' that starts one, -1
    for the 'if' of an 'end if'.

    A branch complete on its own line -- 'if C then return "X";' -- still opens
    the statement, because the elsif/else/end below belong to it. The trailing
    ';' is the branch's, not the statement's, and the 'then' sits in the middle
    of the line where no dispatch on the last word can see it. 'elsif' is its
    own word and never counts: the frame it continues is already open.
    """
    var delta: int = 0
    var prev: str = ""
    for w in code_words(code_s):
        if w == "if":
            if prev == "end":
                delta -= 1
            else:
                delta += 1
        prev = w
    return delta


def unmatched_ends(code_s: str) -> Natural:
    """How many 'end's on the line close something opened on an EARLIER line.

    Each top-level opener on the line is paired with the next 'end' after it;
    what is left over closes outer frames. 'end if; end loop;' closes two,
    'null; end loop; end if;' closes two, 'if B then null; end if;' closes
    none, and 'procedure P is begin null; end P;' closes none. A unit head's
    'is' opens (as in 'package P is end P;'), but so does its 'begin' where
    there is one, and both answer to the same 'end' - so only the innermost
    open is paired and the rest simply stay open, which is harmless: this
    counts closers, not openers.
    """
    var open_: Natural = 0
    var prev: str = ""
    let head: bool = lead_keyword(code_s) in ("package", "procedure", "function",
                                              "task", "protected", "entry")
    for w in code_words(code_s):
        if w == "end":
            if open_ > 0:
                open_ -= 1
            else:
                result += 1
        elif prev != "end" and w in ("if", "loop", "case", "select", "begin", "do"):
            open_ += 1
        elif w == "record" and prev != "end" and prev != "null":
            open_ += 1
        elif w == "is" and head and open_ == 0:
            open_ += 1
        prev = w


def is_then_abort(code_s: str) -> bool:
    """True for the 'then abort' line splitting an asynchronous select."""
    " ".join(code_s.lower().split()) == "then abort"


def stmt_incomplete(code_s: str) -> bool:
    """True if a (comment-stripped) code line continues onto the next line.

    In Ada nearly every statement and declaration ends with ';'. The only
    unterminated lines that are nonetheless complete are the structural keyword
    lines: openers ending in is/then/loop/record/select/do, choice lines ending
    in '=>', block/loop label lines ending in ':', and the lone splitter/opener
    keywords (begin/declare/else/...). Any other line that does not end in ';' is a
    logical line split across physical lines, so the next line is a continuation.
    """
    # A trailing ':' marks a block/loop label ('Find_Model :', 'Log_Changes:'),
    # which is a complete prefix - the labelled construct on the next line stays
    # at the label's level rather than indenting as a continuation. (':=' ends in
    # '=', not ':', so an unfinished assignment is unaffected.)
    # A '<<Label>>' statement label is complete as well: '>>' is no operator,
    # so nothing continues after it.
    return False if code_s == "" or code_s.endswith((";", "=>", ":", ">>"))
    let lw: str = lead_ident(code_s).lower()
    # 'separate (Parent)' is a complete compilation-unit prefix despite content.
    return False if lw == "separate"
    # A *bare* splitter/opener keyword line (just the keyword, nothing trailing)
    # is complete. The 'code_s.lower() == lw' guard matters because the same
    # words occur inside expressions: e.g. the 'else ...)' line closing an
    # if-EXPRESSION continues the surrounding statement and must NOT be mistaken
    # for a complete statement-level 'else'.
    if code_s.lower() == lw and lw in ("begin", "declare", "else", "exception",
            "or", "private", "select", "generic"):
        return False
    return False if is_then_abort(code_s)
    let lt: str = last_word(code_s)
    # 'subtype T is' is not a block opener - the type name follows on the next
    # line as a plain continuation, with no matching 'end'.
    return True if lt == "is" and lw == "subtype"
    # Block openers, plus the '[not] overriding' indicator on its own line.
    # 'begin' and 'declare' belong here for the same reason as the rest: a line
    # ENDING in one is a complete opener, so the next line is the block's first
    # statement rather than a continuation of this one. The bare-keyword test
    # above catches them only when they stand alone, which misses
    # 'procedure X (...) is begin' and 'Outer : declare'.
    return lt not in ("is", "then", "loop", "record", "select", "do",
                      "overriding", "begin", "declare")


def starts_with_operator(code_s: str) -> bool:
    """True if the line begins with a binary/assignment operator - either a
    symbol (:=, =>, =, &, +, -, *, /, <, >, |, ..) or a word operator
    (and, or, xor, mod, rem, covering 'and then'/'or else'). Such a continuation
    takes one extra indent level so it stands out from the operand it continues."""
    return False if code_s == ""
    case code_s[0]:
        when ':': len(code_s) > 1 and code_s[1] == '='   # ':=', not a bare ':'
        when '.': len(code_s) > 1 and code_s[1] == '.'   # '..' range
        when '=' | '&' | '+' | '-' | '*' | '/' | '<' | '>' | '|': True
        when others: lead_ident(code_s).lower() in ("and", "or", "xor", "mod", "rem")

def is_term_continuation(code_s: str) -> bool:
    """True if the line continues a value (sub-)expression across a line break,
    rather than starting a new term or binding. Such a line nests one level past
    where its expression began. It qualifies when it opens an argument list with
    '(' or starts with a value operator: arithmetic / relational / concatenation
    / range (=, &, +, -, *, /, <, >, .., mod, rem) or a boolean connective
    (and / or / and then / or else, including 'and not' / 'or not').

    Excluded (these stay at the base continuation level): the binding operators
    ':=' and '=>', the choice separator '|' (handled with the 'when' choice
    list), and 'xor'.

    NOTE: inside a multi-line if/elsif condition the boolean connectives are
    kept at the base level instead - that exception lives in the cond_state
    branch (its 'lw != and/or' guard), not here, because the rule differs
    between a free value expression (connectives indent under their operand)
    and a condition (connectives align under the 'if')."""
    return False if code_s == ""
    return True if code_s.startswith("(")
    return False if not starts_with_operator(code_s) or code_s.startswith((":=", "=>", "|"))
    let w: str = lead_ident(code_s).lower()
    if w in ("and", "or"):
        # Boolean connectives join successive operands of a value expression;
        # each continuation sits one level past where the expression began.
        return True
    return w != "xor"

def body_follows_arrow(text: str) -> bool:
    """True if `text` - what follows a '(for' - reaches that expression's own
    '=>' and has more code after it on the same line.

    '(for some X of Y => P' starts its predicate beside the arrow, so a line
    continuing it continues P, exactly as in a plain parenthesis. With the arrow
    at the end of the line the predicate starts on the next line, one level in,
    and its continuations one level further (see FOR_EXPR in indent_line).
    """
    var depth: int = 0                      # int: goes to -1 at the closing ')'
    for k, ch in code_positions(text):
        case ch:
            when '(': depth += 1
            when ')':
                return False if depth == 0
                depth -= 1
            when '=':
                if depth == 0 and k + 1 < len(text) and text[k + 1] == '>':
                    let rest: str = text[k + 2:].strip()
                    return rest != "" and not rest.startswith("--")
            when others: pass
    False


def scan_parens(text: str, base_depth: Natural, base_col: Natural) -> [](int, int, Paren_Kind_T):
    """Find every '(' opened in a line and how its continuations should align.

    Returns one tuple (paren_level, align_col, kind) per opening parenthesis:
    paren_level is the depth just inside the '(', align_col is the absolute
    output column to align continuations to (base_col is the column at which
    text[0] renders), and kind is PLAIN, IF_EXPR, CASE_EXPR, or FOR_EXPR. For a
    plain '(' the alignment column is the first non-blank character after it
    (the first item), or one indent level in if the '(' ends the line. For
    '(if'/'(case'/'(for' the column is the keyword itself, which the caller
    offsets per the expression's syntax. String and character literals
    are skipped so a '(' written as '(' (or in "(") is not recorded; otherwise
    this is a best-effort scan.
    """
    var openers: [](int, int, Paren_Kind_T) = []
    var depth: int = base_depth             # int: a line may close more than it opens
    let n: Natural = len(text)
    for i, ch in code_positions(text):
        if ch == ')':
            depth -= 1
        elif ch == '(':
            depth += 1
            # The first item after the '(' is what continuations align to, and
            # the keyword it starts with, if any, is what kind of paren this is.
            # A '(' that ends the line has no item to align to, so the column is
            # one level in -- and no keyword either, so it is PLAIN.
            let j: Natural = skip_ch(text, i + 1, ' ')
            let kw: str = lead_ident(text[j:]).lower()
            var kind: Paren_Kind_T = PAREN_KIND.get(kw, PLAIN)
            # A '(for' whose predicate starts beside its arrow is continued like
            # a plain parenthesis (the alignment column is the same: the 'for').
            if kind == FOR_EXPR and body_follows_arrow(text[i + 1:]):
                kind = PLAIN
            openers.append((depth,
                            base_col + (j if j < n else INDENT_WIDTH),
                            kind))
    return openers


# ---------------------------------------------------------------------------
# Construct names - the anchors an 'end' line is checked against.
# ---------------------------------------------------------------------------

# Keywords that qualify a declaration rather than name it. They are skipped on
# the way to the name: 'package body Parent.Child is' names Parent.Child.
const NAME_QUALIFIER: []str = ["package", "procedure", "function", "task",
                                "protected", "entry", "type", "subtype",
                                "generic", "overriding", "not", "separate",
                                "body"]

# The words that may open a named declaration. 'body' is absent on purpose: it
# never leads a line, so a line starting with it is not a declaration head.
const NAME_OPENER: []str = ["package", "procedure", "function", "task",
                             "protected", "entry", "type", "subtype",
                             "generic", "overriding", "not", "separate"]

# 'end <kw>' names a construct KIND, not an instance, so it carries no name to
# match a frame against.
const END_KEYWORD: []str = ["if", "loop", "case", "record", "select", "return"]

# Words that can never appear inside an expression or a condition, so a line
# that starts with one begins a new statement or declaration whatever state the
# previous lines left behind. They are the resynchronisation points for an
# unclosed '(' or an 'if' whose 'then' never came: without them that state is
# never cleared, and every line to the end of the file is read as part of one
# endless expression. Words that DO occur inside expressions are left out on
# purpose - 'if', 'case', 'for', 'else', 'elsif', 'when', 'return', 'raise',
# 'with', 'null', 'new', 'not' - as is 'is', which continues a header.
const RESYNC_WORD: []str = ["begin", "end", "declare", "exception", "package",
                             "procedure", "function", "pragma", "type",
                             "subtype", "use", "loop", "while", "exit", "goto",
                             "delay", "accept", "entry", "task", "protected",
                             "generic", "separate", "select"]


def lead_words(code_s: str) -> []str:
    """The run of whole identifiers at the front of code_s, in order.

    Scanning stops at the first character that is neither part of an identifier
    nor a blank - '(', ':', ';' - so 'procedure P (A : Integer;' yields
    ['procedure', 'P'] whether or not a space precedes the '('. A '.' counts as
    part of the identifier: a child unit is written 'Parent.Child' in both its
    declaration and its 'end', so the two match only if the dots survive here.
    """
    var i: Natural = 0
    let n: Natural = len(code_s)
    while i < n:
        i = skip_space(code_s, i)
        break if i >= n
        break if not is_ident_ch(code_s[i]) and code_s[i] != '.'
        var j: Natural = i
        while j < n and (is_ident_ch(code_s[j]) or code_s[j] == '.'):
            j += 1
        result.append(code_s[i:j])
        i = j


def declared_name(code_s: str) -> str:
    """The name a block-opening line gives its construct, or ''.

    Two forms carry a name. A declaration names itself after its qualifiers
    ('procedure P (', 'task body T is'), and a block or loop label names itself
    with a trailing colon ('Outer : declare', 'Outer :' on its own line). Every
    other line - 'begin', 'if X then', 'case Y is' - is unnamed, and an unnamed
    frame is never used to contradict an 'end'.
    """
    let ws: []str = lead_words(code_s)
    return "" if len(ws) == 0
    if ws[0].lower() in NAME_OPENER:
        var i: Natural = 0
        while i < len(ws) and ws[i].lower() in NAME_QUALIFIER:
            i += 1
        return ws[i] if i < len(ws) else ""
    # A label: one identifier, a ':', then either nothing (the label sits on its
    # own line) or the construct it labels. 'X : Integer := 0;' has the same
    # shape and is a variable, not a label, so the word after the colon has to
    # be one that opens a block - otherwise every local declaration would be
    # taken for a label and would misname the next frame.
    let after: Natural = skip_space(code_s, len(ws[0]))
    return "" if after >= len(code_s) or code_s[after] != ':'
    return "" if after + 1 < len(code_s) and code_s[after + 1] == '='
    let rest: str = code_s[after + 1:].strip()
    if rest == "" or lead_ident(rest).lower() in ("declare", "begin", "for", "while", "loop"):
        return ws[0]
    return ""


def lead_keyword(code_s: str) -> str:
    """The lowercased keyword saying what a declaration declares, or ''.

    '[not] overriding' and the 'private' of a private library unit are
    indicators attached to a declaration, not the declaration's own keyword, so
    a line can open with one and still be a function. Skipping them is what
    lets the expression-function deferral see 'overriding function F ... is'
    for what it is; read literally, that line begins with 'overriding' and so
    opens a block that nothing ever closes.

    The bare 'private' that splits a package spec never reaches here: it is
    handled as a splitter, and has no declaration after it to name.
    """
    let ws: []str = lead_words(code_s)
    var i: Natural = 0
    while i < len(ws) and ws[i].lower() in ("not", "overriding", "private"):
        i += 1
    return ws[i].lower() if i < len(ws) else ""


def end_name(code_s: str) -> str:
    """The construct name an 'end' line closes, or ''.

    'end Foo;' -> 'Foo'; 'end loop Outer;' -> 'Outer'; 'end;', 'end if;' and
    'end record;' -> '', because those name a kind rather than an instance.
    """
    let ws: []str = lead_words(code_s)
    return "" if len(ws) == 0 or ws[0].lower() != "end"
    var i: Natural = 1
    if i < len(ws) and ws[i].lower() in END_KEYWORD:
        i += 1
    return ws[i] if i < len(ws) else ""


# ---------------------------------------------------------------------------
# The indenter proper (where the real interesting logic sits).
# ---------------------------------------------------------------------------

class Indenter:
    stack: []Block_T = []
    frame_names: []str = []      # name of each open frame, '' when it has none;
                                 # kept exactly in step with `stack` by _push/_pop
    closed_names: []str = []     # named frames closed by a nameless 'end' (most recent
                                 # last): an 'end X;' naming one of them finds X already
                                 # gone because an earlier 'end' was stray, not because
                                 # the frame on top is misnamed - see the 'end' arm
    unopened_heads: []str = []   # declaration heads that have neither opened a frame
                                 # nor ended in ';' (a spec): an 'end X;' for one of
                                 # them closes a head that was mangled, and must not
                                 # close the frame around it (see the 'end' arm)
    pending_label: str = ""      # a bare 'Outer :' label line awaiting its block
    frame_name: str = ""         # the name declared by the logical line being read
    spec_name: str = ""          # name of the deferred 'function ... is' header: the
                                 # body arrives on a later line, which overwrites
                                 # frame_name before the deferred push happens
    lnum: Natural = 0            # physical line number, for diagnostics
    warn: bool = True            # report 'end' lines that contradict the stack
    paren_depth: Natural = 0
    pending_spec: bool = False   # a 'function ... is' header whose body kind is not yet known
    cont_kw: str = ""            # the keyword that opened the declaration being continued:
                                 # 'function', 'type', 'subtype', 'case', ... The 'is' ending a
                                 # header may land on a later physical line, where the first word
                                 # is a parameter name or 'return', so the question 'what is being
                                 # declared here' is only answerable from the line that opened it
    pending_inst: bool = False   # an 'X is\nnew Y' generic instantiation PKG frame to pop when done
    cond_state: Natural = 0      # 1 = inside multi-line 'if' condition, 2 = 'elsif'
    cond_base: Natural = 0       # display depth of the opening if/elsif
    cond_value_base: Natural = 0 # display level of the line holding the current condition term
    in_cont: bool = False        # previous line was an unterminated statement/declaration
    value_base: Natural = 0      # display level where the current statement's value expression starts
    spill_col: int = -1          # column for the continuation lines of a sub-expression
                                 # that began on a continuation line: an aspect's value
                                 # spilled past its '=>' ('with Static_Predicate =>'), or
                                 # an exit/entry condition on its own 'when' line. -1: none
    paren_stack: [](int, int, Paren_Kind_T) = []  # (paren_level, align_col, kind) for every open '('
    paren_cont: bool = False    # prev line within plain paren ended without ',' (arg-list continuation)
    arrow_level: Natural = 0    # innermost paren level with an active '=>' named-value spill (0 = none)
    paren_next_lead: Natural = 0         # column where the next code line in this paren will land
    paren_next_lead_depth: int = -1      # paren_depth that paren_next_lead applies to (-1 = none)
    paren_prev_lead: Natural = 0         # actual lead column of the previous code line in this paren
                                         # (valid when paren_next_lead_depth == entry depth)

    def _push_frame(self, kind: Block_T, name: str = ""):
        """Open a frame. Every push goes through here so that `frame_names`
        cannot drift out of step with `stack` - a drift would make an 'end'
        match the wrong construct, which is worse than not matching at all."""
        self.stack.append(kind)
        self.frame_names.append(name)
        if name != "":
            self._forget_head(name)

    def _forget_head(self, name: str):
        """Drop `name` from unopened_heads, if it is there."""
        var kept: []str = []
        for h in self.unopened_heads:
            if h != name.lower():
                kept.append(h)
        self.unopened_heads = kept

    def _pop_frame(self):
        """Close the innermost frame, if there is one."""
        if self.stack:
            self.stack.pop()
            self.frame_names.pop()

    def _close_named(self, name: str) -> bool:
        """Close frames up to and including the innermost one called `name`.

        Returns False when no open frame carries that name, leaving the stack
        untouched - the caller then falls back to closing one frame, which is
        what a nameless 'end' does.

        This is the indenter's one chance to notice that its stack has drifted
        from the source. A frame that was opened in error (a construct parsed
        as a block when it opens none) is never closed by an 'end' of its own,
        so it would otherwise shift every following line to the end of the
        file. Finding the name further down means exactly that: the frames
        above it were never real, and dropping them re-grounds the stack on
        the source instead of compounding the error.
        """
        var i: int = len(self.stack) - 1      # int: the scan runs down past 0
        while i >= 0:
            if self.frame_names[i].lower() == name.lower():
                while len(self.stack) > i:
                    self._pop_frame()
                return True
            i -= 1
        return False

    def _closed_depth(self, name: str) -> int:
        """The stack depth a nameless 'end' left when it closed the frame called
        `name` (see closed_names), or -1 when no such frame was closed."""
        var i: int = len(self.closed_names) - 1   # int: the scan runs down past 0
        while i >= 0:
            let nd: []str = self.closed_names[i].split(":")
            if nd[0] == name.lower():
                return int(nd[1])
            i -= 1
        -1

    def _close_kind(self, kind: Block_T, word: str):
        """Close the innermost open frame of `kind` - an 'end if', 'end loop',
        ... names the kind of construct it closes, so it can only close one of
        that kind.

        The search stops at the body it is in (a package, a type, or a named
        block, which is how a subprogram body is kept): a closer never reaches
        through a body boundary to match a construct outside it. Frames it has
        to step over to reach the match were never closed and are dropped with
        it. When there is no match the closer is stray and closes nothing, which
        keeps a single extra 'end if;' from shifting the rest of the file one
        level out.
        """
        var i: int = len(self.stack) - 1      # int: the scan runs down past 0
        while i >= 0:
            if self.stack[i] == kind:
                var dropped: Natural = 0
                for j in range(i + 1, len(self.stack)):
                    if self.stack[j] != WHEN:
                        dropped += 1
                while len(self.stack) > i:
                    self._pop_frame()
                if dropped > 0:
                    self._warn(f"'end {word}' closes an outer '{word}': "
                               f"dropped {dropped} unclosed frame(s) to resynchronise")
                return
            if self.stack[i] == PKG or self.stack[i] == TYPE_HEADER or \
                    ((self.stack[i] == BLOCK or self.stack[i] == DECLARE) and self.frame_names[i] != ""):
                break
            i -= 1
        self._warn(f"'end {word}' has no open '{word}' to close: ignored")

    def _resync_expression(self, why: str):
        """Abandon an expression or condition that never finished.

        Called on a line that cannot continue one (see RESYNC_WORD). An 'if'
        that was still looking for its 'then' is taken to have opened its
        statement anyway, since its body and 'end if' will follow and must pair
        with a frame.
        """
        self._warn(why)
        if self.cond_state == 1:
            self._push_frame(IF)
        self.cond_state = 0
        self.paren_depth = 0
        self.paren_stack = []
        self.paren_cont = False
        self.arrow_level = 0
        self.paren_next_lead_depth = -1
        self.in_cont = False

    def _warn(self, msg: str):
        """Report a desynchronisation on stderr, never on stdout: the indented
        text is the output, and a formatter that pollutes it is unusable in a
        pipe."""
        if self.warn:
            stderr.writeLine(f"ada_indent: line {self.lnum}: {msg}")

    def dump_state(self) -> str:
        """Serialize the full indenter state to a compact, opaque string."""
        # 'KIND:name' per frame, name empty when the construct has none. The two
        # travel as one field so a restored stack cannot come back with its names
        # offset by one, which would silently mis-anchor every later 'end'.
        var stack_names: []str = []
        for i in range(len(self.stack)):
            stack_names.append(str(self.stack[i]) + ":" + self.frame_names[i])
        var ps_parts: []str = []
        for t in self.paren_stack:
            ps_parts.append(str(t[0]) + ":" + str(t[1]) + ":" + str(t[2]))
        var parts: []str = [
            "stack=" + ",".join(stack_names),
            "cn="    + ",".join(self.closed_names),
            "uh="    + ",".join(self.unopened_heads),
            "pd="    + str(self.paren_depth),
            "ps="    + ("T" if self.pending_spec    else "F"),
            "ck="    + self.cont_kw,
            "pl="    + self.pending_label,
            "fn="    + self.frame_name,
            "sn="    + self.spec_name,
            "ln="    + str(self.lnum),
            "pi="    + ("T" if self.pending_inst    else "F"),
            "cs="    + str(self.cond_state),
            "cb="    + str(self.cond_base),
            "cvb="   + str(self.cond_value_base),
            "ic="    + ("T" if self.in_cont         else "F"),
            "vb="    + str(self.value_base),
            "sc="    + str(self.spill_col),
            "psk="   + ";".join(ps_parts),
            "pc="    + ("T" if self.paren_cont      else "F"),
            "al="    + str(self.arrow_level),
            "pnl="   + str(self.paren_next_lead),
            "pnld="  + str(self.paren_next_lead_depth),
            "ppl="   + str(self.paren_prev_lead),
        ]
        return "|".join(parts)

    def load_state(self, s: str):
        """Restore indenter state from a string previously produced by dump_state."""
        self.stack               = []
        self.frame_names         = []
        self.closed_names        = []
        self.unopened_heads      = []
        self.pending_label       = ""
        self.frame_name          = ""
        self.spec_name           = ""
        self.lnum                = 0
        self.paren_depth         = 0
        self.pending_spec        = False
        self.cont_kw             = ""
        self.pending_inst        = False
        self.cond_state          = 0
        self.cond_base           = 0
        self.cond_value_base     = 0
        self.in_cont             = False
        self.value_base          = 0
        self.spill_col          = -1
        self.paren_stack         = []
        self.paren_cont          = False
        self.arrow_level         = 0
        self.paren_next_lead     = 0
        self.paren_next_lead_depth = -1
        self.paren_prev_lead     = 0
        for part in s.split("|"):
            let eq: int = part.find("=")       # int: find answers -1 when absent
            continue if eq < 0
            let key: str = part[:eq]
            let val: str = part[eq + 1:]
            case key:
                when "stack" if val != "":
                     for entry in val.split(","):
                         let c: int = entry.find(":")   # int: -1 when absent
                         if c < 0:
                             self._push_frame(Block_T(entry))
                         else:
                             self._push_frame(Block_T(entry[:c]), entry[c + 1:])
                when "pd": self.paren_depth = int(val)
                when "ps": self.pending_spec = val == "T"
                when "ck": self.cont_kw = val
                when "pl": self.pending_label = val
                when "fn": self.frame_name = val
                when "sn": self.spec_name = val
                when "ln": self.lnum = int(val)
                when "pi": self.pending_inst = val == "T"
                when "cs": self.cond_state = int(val)
                when "cb": self.cond_base = int(val)
                when "cvb": self.cond_value_base = int(val)
                when "ic": self.in_cont = val == "T"
                when "vb": self.value_base = int(val)
                when "sc": self.spill_col = int(val)
                when "psk" if val != "":
                    for entry in val.split(";"):
                        let ep: []str = entry.split(":")
                        if len(ep) == 3:
                            self.paren_stack.append((int(ep[0]), int(ep[1]), Paren_Kind_T(ep[2])))
                when "pc": self.paren_cont = val == "T"
                when "al": self.arrow_level = int(val)
                when "pnl": self.paren_next_lead = int(val)
                when "pnld": self.paren_next_lead_depth = int(val)
                when "ppl": self.paren_prev_lead = int(val)
                when "cn" if val != "": self.closed_names = val.split(",")
                when "uh" if val != "": self.unopened_heads = val.split(",")
                when others: pass

    def _open_trailing(self, code_s: str, lw: str):
        """Open the block that the line's last word opens, if any.

        The one place that knows which trailing keyword opens which frame. It is
        asked from three places - an ordinary statement or declaration line, a
        line that closes the last open parenthesis ('... Y : T) is'), and a
        case/handler arm whose body starts beside its arrow ('when X => if C
        then') - which differ only in when they may ask. Three copies of the
        answer had drifted apart before (')is' on a type, ')then', 'when X =>
        begin' each worked in one and not another), so they share this one.

        A line ending in ';' is a whole declaration or statement and opens
        nothing, however it ends: last_word() drops that ';', so a complete
        one-liner whose final token is a block keyword - 'type T is null
        record;', 'for I in 1 .. 3 loop Put (I); end loop;' - would otherwise
        push a frame that no 'end' ever closes.
        """
        return if code_s.endswith(";")
        case last_word(code_s):
            when "is":
                # What 'is' opens depends on what is being declared, which the
                # line that OPENED the declaration says: a header whose
                # parameter list spans lines puts its 'is' on a later line,
                # where the first word is a parameter name or 'return'. cont_kw
                # carries that opening keyword across the continuation.
                #  - function: a real body or an expression function - defer the
                #    decision to the next line (pending_spec), since an
                #    expression function has no 'end' to pop a frame with.
                #  - type: TYPE_HEADER, to pair with the 'record' under it.
                #  - subtype: nothing; the rest of the declaration follows.
                #  - case, or an arm body 'when X => case Y is': CASE.
                #  - anything else (package, procedure, task, ...): PKG.
                if self.cont_kw == "function":
                    self.pending_spec = True
                    self.spec_name = self.frame_name     # the body's push comes later
                elif self.cont_kw == "type":
                    self._push_frame(TYPE_HEADER, self.frame_name)
                elif self.cont_kw != "subtype":
                    if self.cont_kw in ("case", "when"):
                        self._push_frame(CASE)
                    else:
                        self._push_frame(PKG, self.frame_name)
            when "then" if ends_with_condition_then(code_s):
                self._push_frame(IF)
            when "loop": self._push_frame(LOOP, self.frame_name)
            when "record" if lw != "null": self._push_frame(RECORD)
            when "select": self._push_frame(SELECT)
            when "do": self._push_frame(DO)
            when "declare": self._push_frame(DECLARE, self.frame_name)
            when "begin":
                # 'procedure X (...) is begin' puts the header and the start of
                # the statement part on one line. Spelled over two lines the
                # 'is' pushes a frame and the 'begin' turns it into the
                # statement part - one frame either way, so push it here. A line
                # that STARTS with 'begin' never gets here: it converts the
                # frame already open instead.
                self._push_frame(BLOCK, self.frame_name)
            when others: pass

    def _push_parens(self, text: str, base_col: Natural, base_depth: Natural, new_depth: Natural):
        """Record parentheses opened on this line and drop any now closed."""
        for opener in scan_parens(text, base_depth, base_col):
            self.paren_stack.append(opener)
        while self.paren_stack and self.paren_stack[-1][0] > new_depth:
            self.paren_stack.pop()

    def indent_line(self, line: str) -> str:
        """Process one raw line and return it re-indented."""
        let out: str = self.indent_raw(line)
        # A declaration that ends in ';' at the outer level is complete without
        # a body - a spec, a renaming, an instantiation, an expression function
        # - so its head is not one waiting for a frame.
        if self.paren_depth == 0 and self.frame_name != "" and \
                strip_line_comment(line, "--", '"').rstrip().endswith(";"):
            self._forget_head(self.frame_name)
        out

    def indent_raw(self, line: str) -> str:
        """indent_line proper: re-indent one raw line."""
        let raw2: str = line.rstrip()
        # Ada's conventions for the library's generic stripper: '--' opens a
        # comment, '"' delimits a string, so a '--' inside one is not a
        # comment. Character literals and doubled quotes are not modelled.
        self.lnum += 1
        let code: str = strip_line_comment(raw2, "--", '"')
        let code_s: str = code.strip()
        let emit_text: str = raw2.strip()

        return "" if emit_text == ""

        # A comment-only line (text remains, but nothing is left after stripping
        # the '--' comment) is transparent to the parser: indent it to the
        # current continuation context but leave ALL state untouched
        # (in_cont / cond_state / paren_depth / pending_spec / paren_stack), so
        # the next real line indents exactly as if the comment were not there.
        # Without this the trailing in_cont update would clear a pending
        # statement continuation, dropping the line after the comment back to
        # the base level (and a comment after 'function ... is' would wrongly
        # resolve the deferred spec).
        if code_s == "":
            # Inside a parenthesis a comment follows the surrounding lines: align
            # it with the previous code line in this same paren (which, in a list
            # or expression, sits at the same level as the line that follows it).
            # When no line has been emitted at this paren level yet - the comment
            # sits right after the line that opened the paren, or after an inner
            # paren just closed back to it - derive the level from the paren kind,
            # mirroring where the next code line would land:
            #   '(if'   -> the then/else/elsif column (acol);
            #   '(case' -> the 'when' level (acol + one);
            #   '(for'  -> the body level (acol + one);
            #   plain   -> the item column, plus one level when the opening line
            #              left its item unfinished (paren_cont) so an operator/
            #              term continuation - not a new item - follows.
            if self.paren_depth > 0 and self.paren_stack:
                let ptop: (int, int, Paren_Kind_T) = self.paren_stack[-1]
                if self.paren_next_lead_depth == self.paren_depth:
                    return " " * self.paren_next_lead + emit_text
                # No peer code line yet at this paren depth (comment sits right
                # after the paren opener, or after an inner paren just closed back
                # to this level). Derive the indent from the paren kind, mirroring
                # where the first/next code line at this level lands.
                var pfall: Natural = ptop[1]
                case ptop[2]:
                    when CASE_EXPR | FOR_EXPR:
                        pfall += INDENT_WIDTH
                    when PLAIN if self.paren_cont:
                        pfall += INDENT_WIDTH
                    when others:
                        pass
                return " " * pfall + emit_text
            # Outside parentheses a comment is indented like the line that would
            # follow it. Inside a multi-line if/elsif condition it aligns with the
            # connective (and then / or else) level, which is cond_base + 1.
            # cond_value_base is initialised to cond_base and only bumped to
            # cond_base + 1 once the first connective is processed, so use
            # max(cond_value_base, cond_base + 1) to get the right level even
            # when the comment immediately follows the 'if'/'elsif' opener before
            # any 'and then'/'or else' has been seen. When an unfinished value
            # statement (in_cont) is interrupted, the next line is a continuation,
            # so the comment takes that continuation indent, one level past where
            # the value began. Otherwise the next line is a fresh instruction at
            # the current block level.
            if self.cond_state > 0:
                let clvl: Positive = max(self.cond_value_base, self.cond_base + 1)
                return " " * (max(0, clvl) * INDENT_WIDTH) + emit_text
            if self.in_cont and self.spill_col >= 0:
                return " " * self.spill_col + emit_text
            if self.in_cont:
                return " " * (max(0, self.value_base + 1) * INDENT_WIDTH) + emit_text
            # After a deferred 'function ... is' header the next instruction is
            # the body - a declaration or expression one level deeper - so a
            # comment documenting it sits at that body level, not at the header's.
            let blvl: Natural = len(self.stack) + (1 if self.pending_spec else 0)
            return " " * (max(0, blvl) * INDENT_WIDTH) + emit_text

        # A line that cannot be part of an expression ends whatever expression
        # or condition the previous lines left open.
        if (self.paren_depth > 0 or self.cond_state > 0) and \
                lead_ident(code_s).lower() in RESYNC_WORD:
            self._resync_expression(f"'{lead_ident(code_s)}' inside an unfinished "
                                    + ("parenthesis" if self.paren_depth > 0 else "'if' condition")
                                    + ": state reset")
        elif self.in_cont and lead_ident(code_s).lower() in RESYNC_WORD:
            self.in_cont = False       # the previous line lacked its ';'
        # A condition line never ends in ';': an 'if' that reaches one without
        # its 'then' is over, and this line is the first of its body.
        elif self.cond_state > 0 and self.paren_depth == 0 and code_s.endswith(";"):
            self._resync_expression("'if' condition ended without 'then'")

        let entry_depth: Natural = self.paren_depth
        # When we are outside all parens, clear the plain-paren continuation flag
        # and the named-value spill state so stale paren context does not leak.
        if entry_depth == 0:
            self.paren_cont = False
            self.arrow_level = 0
        let cont: Natural = 1 if (self.paren_depth > 0 or self.in_cont) else 0
        let lw: str = lead_ident(code_s).lower()
        # Remember, for the whole logical line, whether it started with 'function'.
        # A parameter list spanning several physical lines puts the 'is' that ends
        # the header on a later line, where lw is a parameter name -- but the
        # expression-function deferral below still has to recognise the header.
        if cont == 0:
            self.cont_kw = lead_keyword(code_s)
            # The name this logical line declares, remembered for the 'end' that
            # will close it. A bare 'Outer :' label line declares a name but opens
            # nothing, so the name waits for the declare/begin/for/while it labels.
            let dn: str = declared_name(code_s)
            # Only heads whose construct ends in 'end <name>;' - not types, whose
            # 'end' is 'end record'. The entry goes as soon as the head opens
            # its frame (_push_frame) or turns out to be a spec (indent_line).
            if dn != "" and self.cont_kw != "type" and self.cont_kw != "subtype":
                self._forget_head(dn)
                self.unopened_heads.append(dn.lower())
                if len(self.unopened_heads) > 8:
                    self.unopened_heads = self.unopened_heads[1:]
            if dn != "" and code_s.endswith(":"):
                self.pending_label = dn
                self.frame_name = ""
            else:
                self.frame_name = dn if dn != "" else self.pending_label
                self.pending_label = ""
        var disp: int = len(self.stack)      # int: the 'end' cases take it to len-1, so -1
        # Whether the stale-TYPE_HEADER pop below fired on this line. A 'new' that
        # follows a 'type T is' continues a DERIVED TYPE, not a generic
        # instantiation, and the frame it belongs to has just been discarded --
        # so the PKG now on top is somebody else's and must not be marked for
        # removal. Without this the enclosing package's frame was the one taken.
        var popped_type_header: bool = False

        # A 'type T is' that turns out to be an enum, derived, or other non-record
        # type pushed TYPE_HEADER waiting for 'record'. When the declaration finishes
        # (no open parens, no continuation) without ever seeing 'record', the type is
        # complete - pop the stale frame so subsequent lines return to the enclosing
        # scope level.  (A record type is handled separately: 'record' pushes RECORD
        # and pops TYPE_HEADER in the keyword dispatch below.)
        # Guard: do NOT pop if this line IS 'record' - let the keyword dispatch handle it.
        if not self.in_cont and self.paren_depth == 0 and self.stack and \
          self.stack[-1] == TYPE_HEADER and lw != "record" and not code_s.startswith("("):
            self._pop_frame()
            disp = len(self.stack)
            popped_type_header = True

        # The formal part of a generic ends where the unit it parameterises
        # begins. Formals are 'type', 'with procedure', 'with package', object
        # declarations - none starts with one of these three words.
        if cont == 0 and self.stack and self.stack[-1] == GENERIC and \
                lw in ("package", "procedure", "function"):
            self._pop_frame()
            disp = len(self.stack)

        # An 'X is\nnew Y;' generic instantiation pushed a PKG for 'X is'. Once the
        # 'new' statement finishes (no open parens, no continuation), pop it so the
        # next declaration or 'begin' aligns at the correct enclosing scope level.
        if self.pending_inst and not self.in_cont and self.paren_depth == 0:
            self.pending_inst = False
            if self.stack and self.stack[-1] == PKG:
                self._pop_frame()
                disp = len(self.stack)

        # Resolve a deferred 'function ... is' header (set on the previous line).
        # If the body begins with '(' it is an expression function: indent the
        # expression one level and push no frame. Otherwise it is a real
        # subprogram body, so perform the deferred push and fall through.
        if self.pending_spec:
            self.pending_spec = False
            if code_s.startswith("("):
                self.in_cont = False
                let lead_e: Natural = max(0, len(self.stack) + 1 + cont) * INDENT_WIDTH
                self.paren_depth = max(0, self.paren_depth + paren_delta(code))
                # Fresh paren with no peer line yet: use the kind-aware fallback.
                self.paren_next_lead_depth = -1
                self._push_parens(emit_text, lead_e, entry_depth, self.paren_depth)
                return " " * lead_e + emit_text
            else:
                self._push_frame(PKG, self.spec_name)
                disp = len(self.stack)

        # Inside an unclosed parenthesis the line is a continuation of an
        # expression / list, so statement keywords (then/else/elsif/when) are
        # operators here, not statement parts. It is aligned by absolute column
        # to the innermost open parenthesis:
        #   plain '('  -> under the first item after the '(';
        #   '(if'      -> then/else/elsif under the 'if', condition past it;
        #   '(case'    -> when clauses one level in from the 'case', clause
        #                 bodies one level deeper still.
        # This is checked before the cond_state branch so that lines inside a
        # parenthesis opened within a multi-line if/elsif condition are aligned
        # to that parenthesis (the condition tracker records those parens).
        # If the line also closes the parentheses and opens a block (a
        # multi-line parameter list ending in ') is', ') return T is', ') loop',
        # ...) the block frame is pushed here, after the line is aligned.
        if self.paren_depth > 0:
            # Drop any parentheses that have already closed.
            while self.paren_stack and self.paren_stack[-1][0] > entry_depth:
                self.paren_stack.pop()
            var lead: Natural = max(0, len(self.stack) + cont) * INDENT_WIDTH
            var entry_top_level: Natural = 0
            var entry_top_kind: Paren_Kind_T = OUTSIDE
            # Whether this line took the operator/term-continuation extra indent.
            # A comment following a NON-continuation line (an arm-body head or a
            # plain item) whose item is unfinished must anticipate the operator
            # continuation that comes next, which sits one level deeper; a comment
            # after a line that already took that extra stays at the same level.
            var was_cont: bool = False
            var acol: Natural = 0
            if self.paren_stack:
                let top: (int, int, Paren_Kind_T) = self.paren_stack[-1]
                acol = top[1]
                entry_top_level = top[0]
                entry_top_kind = top[2]
                case entry_top_kind:
                    when _ if entry_top_kind != PLAIN and code_s.startswith(")"):
                        # A line that begins by closing an '(if'/'(case'/'(for'
                        # expression aligns the ')' under the opening '(' - one
                        # column left of the keyword that acol points at -
                        # rather than taking the body/condition continuation
                        # indent.
                        lead = max(0, acol - 1)
                    when IF_EXPR:
                        if lw in ("then", "else", "elsif"):
                            lead = acol
                        else:
                            # Condition continuation: one indent level past the
                            # 'if' (so it sits one level in from the then/else,
                            # which align with the 'if'). Uses INDENT_WIDTH,
                            # not the literal width of 'if ', to stay
                            # consistent with the case-expr arms below and the
                            # if-statement condition continuation.
                            lead = acol + INDENT_WIDTH
                    when CASE_EXPR:
                        if lw == "when":
                            lead = acol + INDENT_WIDTH
                        else:
                            lead = acol + 2 * INDENT_WIDTH
                            # An arm body spanning several lines is an
                            # expression: a continuation line that starts with
                            # an operator (or else, and then, &, ...) takes one
                            # extra level past the arm body, exactly as inside
                            # a plain parenthesis. A leading '=>' is excluded -
                            # that is the arm's result arrow (its choices
                            # spilled onto earlier lines), which stays at the
                            # arm-body level rather than being treated as an
                            # operator.
                            if starts_with_operator(code_s) and not code_s.startswith("=>"):
                                lead += INDENT_WIDTH
                                was_cont = True
                    when FOR_EXPR:
                        # '(for some/all ... => predicate' (a quantified
                        # expression) or '(for I in ... => value' (an iterated
                        # component): the body after the iterator sits one
                        # level past the 'for', mirroring the '(if'/'(case'
                        # bodies. A leading operator takes one more level; a
                        # leading '=>' (the predicate arrow spilled onto its
                        # own line) stays at the body level.
                        lead = acol + INDENT_WIDTH
                        if starts_with_operator(code_s) and not code_s.startswith("=>"):
                            lead += INDENT_WIDTH
                            was_cont = True
                    when others:
                        # A named association whose value spilled past a
                        # trailing '=>' (arrow_level marks the paren it
                        # happened in) starts its value one level past the item
                        # column; everything else is a plain list item at the
                        # item column.
                        let vbase: Natural = acol + (INDENT_WIDTH if self.arrow_level == top[0] else 0)
                        lead = vbase
                        # A continuation that starts with an operator (&, +,
                        # and, or else, ...) takes one extra level past the
                        # value/items. A '(' on a continuation line is the
                        # argument list of the expression on the previous line
                        # (which ended without ','), so it also nests one level
                        # deeper.
                        if starts_with_operator(code_s):
                            lead = vbase + INDENT_WIDTH
                            was_cont = True
                        elif code_s.startswith("(") and self.paren_cont:
                            # An argument list '(' opening a continuation line
                            # is the call's arguments, so it nests one level
                            # past the call name - which sits on the previous
                            # code line. When that previous line was itself an
                            # operator/term continuation (deeper than the item
                            # column), the '(' must compound past it rather
                            # than flatten back to the item column. Use the
                            # previous line's actual lead when it was at this
                            # same paren depth; otherwise fall back to the item
                            # column.
                            lead = vbase + INDENT_WIDTH
                            if self.paren_next_lead_depth == entry_depth:
                                lead = max(lead, self.paren_prev_lead + INDENT_WIDTH)
                            was_cont = True
            let new_depth: int = self.paren_depth + paren_delta(code)  # int: delta may be negative
            self.in_cont = stmt_incomplete(code_s)
            # Track whether this line ended without a comma: if so, a '(' opening
            # the next line is the argument list of the expression here (not a new
            # list element) and deserves an extra indent level inside plain parens.
            self.paren_cont = self.in_cont and not code_s.endswith(",")
            self.paren_depth = max(0, new_depth)
            # Track the named-association arrow spill state:
            # - A plain-paren line that ends with '=>' (value on next line): arm
            #   that spill for this paren level so following lines align to value.
            # - A line that ends with ',' closes the association: clear the spill.
            # - When the paren itself closes (depth drops): clear.
            if entry_top_kind == PLAIN:
                if code_s.endswith("=>"):
                    self.arrow_level = entry_top_level
                elif self.arrow_level == entry_top_level and code_s.endswith(","):
                    self.arrow_level = 0
            if self.arrow_level > 0 and self.paren_depth < self.arrow_level:
                self.arrow_level = 0
            # A ',' back at the spilled association's own paren level ends it,
            # whichever paren the line started in: 'when B => V),' closes a
            # '(case' that was the value of 'Start_FL =>', and the next item
            # returns to the item column.
            if self.arrow_level > 0 and self.paren_depth == self.arrow_level \
                    and code_s.endswith(","):
                self.arrow_level = 0
            # Compute where the next code line in this paren will land, for use by
            # any comment that follows before it arrives.
            let complete_assoc: bool = "=>" in code_s and not code_s.endswith("=>")
            if entry_top_kind != OUTSIDE and code_s.endswith(","):
                # Comma closes the current element; next is a fresh item.
                var pnext: Natural = acol
                if entry_top_kind in (CASE_EXPR, FOR_EXPR):
                    pnext += INDENT_WIDTH
                self.paren_next_lead = pnext
            elif entry_top_kind == PLAIN and complete_assoc:
                # Complete named association ('X => Y') in a plain paren: next is
                # a fresh item at the item column (not an operator continuation).
                self.paren_next_lead = acol
            elif entry_top_kind != IF_EXPR and self.paren_cont and not was_cont:
                # Unfinished non-continuation item (arm-body head or plain item):
                # anticipate the operator continuation that follows, one level
                # deeper. '(if' structural lines are excluded.
                self.paren_next_lead = lead + INDENT_WIDTH
            else:
                # Already a continuation, or kind-1 structural, or closed item:
                # the next line chains at the same level.
                self.paren_next_lead = lead
            self.paren_prev_lead = lead
            self.paren_next_lead_depth = entry_depth
            self._push_parens(emit_text, lead, entry_depth, self.paren_depth)
            # A line that closes back out of all parentheses and ends in a block
            # opener opens that block.
            if new_depth <= 0 and (code_s.endswith(",") or not self.in_cont):
                self.spill_col = -1         # the aspect's value ends here
            if new_depth <= 0:
                if self.cond_state > 0 and ends_with_condition_then(code_s):
                    # A multi-line if/elsif condition closed its parens and
                    # reached 'then' on the same line: end it like cond_state.
                    if self.cond_state == 1:
                        self._push_frame(IF)
                    self.cond_state = 0
                else:
                    self._open_trailing(code_s, lw)
            return " " * lead + emit_text

        # Multi-line if/elsif condition (outside any parenthesis): continuation
        # lines are one level deeper than the 'if'/'elsif'. When 'then' appears
        # the IF frame is pushed (for 'if' only - for 'elsif' it is already on
        # the stack) and 'then' snaps back to the opener level. Parens opened in
        # the condition are recorded so the lines inside them are aligned by the
        # branch above.
        if self.cond_state > 0:
            if ends_with_condition_then(code_s) or lw == "then":
                disp = self.cond_base
                if self.cond_state == 1:
                    self._push_frame(IF)
                self.cond_state = 0
            elif is_term_continuation(code_s) and lw != "and" and lw != "or":
                # A line that continues the previous term across the break (>=,
                # &, '(', ...) nests one level past the line that holds that term
                # - which may be the opener itself (call name on the 'if'/'elsif'
                # line) or a preceding 'and then' connective line. 'and not' /
                # 'or not' are excluded here even though is_term_continuation
                # returns True for them: inside a condition they are connectives,
                # not value operators.
                disp = self.cond_value_base + 1
            else:
                # The 'and'/'or'/'xor' connectives join condition terms and sit
                # at the base continuation level. Each starts a fresh term, so a
                # following term continuation nests one level past this line.
                disp = self.cond_base + 1
                self.cond_value_base = self.cond_base + 1
            self.in_cont = False
            # cond_state lines are outside parentheses (inside-paren lines are
            # handled above), so they use only the if/elsif-relative depth - no
            # 'cont', which could otherwise leak in from a preceding paren line.
            let lead_c: Natural = max(0, disp) * INDENT_WIDTH
            self.paren_depth = max(0, self.paren_depth + paren_delta(code))
            # When this cond_state line opens a paren and leaves it unclosed,
            # record whether the last item before the end of line was
            # comma-terminated. A following '(' on the next line is the argument
            # list of an unfinished item (not a new element) when it is not, and
            # the comment fallback needs this to align with operator continuations.
            self.paren_cont = self.paren_depth > 0 and not code_s.endswith(",")
            # This line is outside any paren at entry, so any paren it opens is
            # fresh with no peer line yet. Invalidate paren_next_lead so a comment
            # inside uses the kind-aware fallback, not a stale lead from a sibling
            # paren that has since closed.
            self.paren_next_lead_depth = -1
            self._push_parens(emit_text, lead_c, entry_depth, self.paren_depth)
            return " " * lead_c + emit_text

        case lw:
            when "end":
                while self.stack and self.stack[-1] == WHEN:
                    self._pop_frame()
                # 'end Foo;' names the construct it closes, which is the only
                # place the source states the block structure outright rather
                # than leaving it to be inferred. Check the name against the
                # frame being closed: when it names a frame further down, the
                # frames above it were opened in error and are dropped here, so
                # a mis-parse costs the lines up to this 'end' instead of every
                # line to the end of the file.
                let en: str = end_name(code_s)
                let ews: []str = lead_words(code_s)
                let ekw: str = ews[1].lower() if len(ews) > 1 and ews[1].lower() in END_KEYWORD else ""
                let top_name: str = self.frame_names[-1] if self.stack else ""
                let before: Natural = len(self.stack)
                if ekw != "":
                    # 'end if', 'end loop', ...: the kind is stated, so match
                    # on it (a loop label, if any, is only a check on the kind).
                    case ekw:
                        when "if": self._close_kind(IF, ekw)
                        when "loop": self._close_kind(LOOP, ekw)
                        when "case": self._close_kind(CASE, ekw)
                        when "record": self._close_kind(RECORD, ekw)
                        when "select": self._close_kind(SELECT, ekw)
                        when others: self._close_kind(DO, ekw)    # 'end return'
                elif en == "" or top_name.lower() == en.lower():
                    # the ordinary, matching case. A nameless 'end' closing a
                    # named frame is remembered: if it was stray, the frame's
                    # own 'end X;' arrives later and must not close another.
                    if en == "" and top_name != "":
                        self.closed_names.append(top_name.lower() + ":" + str(len(self.stack) - 1))
                        if len(self.closed_names) > 8:
                            self.closed_names = self.closed_names[1:]
                    self._pop_frame()
                elif self._close_named(en):
                    # _close_named popped the matching frame plus everything
                    # above it; all but the match were never really open.
                    let stale: Natural = before - len(self.stack) - 1
                    self._warn(f"'end {en}' closes an outer construct: "
                               f"dropped {stale} unclosed frame(s) to resynchronise")
                elif self._closed_depth(en) >= 0:
                    # X is not open because a nameless 'end' already closed it:
                    # that one was stray, and closing another frame here would
                    # carry its error on to the end of the file. Return to the
                    # depth that 'end' left, which is where X's end belongs;
                    # anything opened since belonged to X and is closed with it.
                    let depth: Natural = self._closed_depth(en)
                    while len(self.stack) > depth:
                        self._pop_frame()
                    self._warn(f"'end {en}' closes a construct an earlier 'end' "
                               "already closed")
                elif top_name == "":
                    self._pop_frame()                      # unnamed frame: nothing to contradict
                elif en.lower() in self.unopened_heads:
                    # X was declared a few lines up but has no frame, so its
                    # head never opened one (a mangled header). The frame on
                    # top is some outer construct that this 'end' must leave
                    # open.
                    self._warn(f"'end {en}' closes '{en}', whose header opened "
                               "no block: ignored")
                else:
                    self._warn(f"'end {en}' does not match the open '{top_name}'")
                    self._pop_frame()
                disp = len(self.stack)
                # 'type T is' on its own line pushes TYPE_HEADER, then the
                # following 'record' line pushes RECORD. 'end record' closes
                # only RECORD; pop the paired TYPE_HEADER so that the lines
                # AFTER this one resume at the enclosing scope level.
                # disp is set first so 'end record' itself aligns with 'record'.
                if last_word(code_s) == "record" and self.stack and self.stack[-1] == TYPE_HEADER:
                    self._pop_frame()

            when "begin":
                if self.stack and (self.stack[-1] == PKG or self.stack[-1] == DECLARE):
                    disp = len(self.stack) - 1
                    self.stack[-1] = BLOCK
                else:
                    disp = len(self.stack)
                    self._push_frame(BLOCK, self.frame_name)

            when "when" if (cont == 0 or (self.cont_kw != "entry" and self.cont_kw != "exit")):
                # (A 'when' continuing an 'exit Name' or an entry header -
                # 'entry E (...)' then 'when C is' - is a condition, not an
                # alternative. It goes the ordinary way below, where the
                # barrier's trailing 'is' opens the entry body.)
                if self.stack and self.stack[-1] == WHEN:
                    self._pop_frame()
                disp = len(self.stack)
                # An alternative belongs to a case statement, a select or an
                # exception handler. A handler's frame is the BLOCK of its
                # 'begin', or the DO of an extended return or an accept - both
                # 'return R : T do' and 'accept E do' may end in 'exception'.
                # Anywhere else the 'when' is left over from a construct that
                # lost its opener - a case expression whose '(' was never
                # closed, say - and a WHEN frame for it would never be popped.
                if self.stack and (self.stack[-1] == CASE or self.stack[-1] == SELECT
                                   or self.stack[-1] == BLOCK or self.stack[-1] == DO):
                    self._push_frame(WHEN)
                    # The arm body may start on the same line as its '=>' and open a
                    # block of its own: 'when X => if C then', 'when X => for I in
                    # ... loop'. The WHEN frame is the alternative, not that block,
                    # so without a frame for it the block's own 'end' closes the
                    # alternative instead and every 'end' after it is one frame out.
                    # As at statement level, a trailing keyword inside an unclosed
                    # paren is part of an expression, not an opener.
                    if paren_delta(code) <= 0:
                        self._open_trailing(code_s, lw)
                else:
                    self._warn("'when' outside a case, select or exception handler: "
                               "no alternative opened")

            when "elsif":
                disp = len(self.stack) - 1
                if not ends_with_condition_then(code_s) and stmt_incomplete(code_s):
                    self.cond_state = 2
                    # max(0, ...): an 'elsif' with nothing open takes disp to -1,
                    # and these two are Natural, so the store itself would raise.
                    self.cond_base = max(0, disp)
                    self.cond_value_base = max(0, disp)

            when "generic" if code_s.lower() == "generic":
                self._push_frame(GENERIC)

            when "else" | "exception" | "or" | "private" | "then" if \
                    (lw != "private" or code_s.lower() == "private") and \
                    (lw != "then" or is_then_abort(code_s)):
                # 'private' reaches here only as the section splitter of a
                # package spec, which stands alone on its line. As the privacy
                # indicator of a library unit -- 'private package P is',
                # 'private function F ... is' -- it qualifies a declaration that
                # has to open its own frame, so those lines fall through to the
                # dispatch below instead.
                #
                # 'then abort' splits an asynchronous select the same way,
                # between its triggering and its abortable part.
                #
                # A select alternative ends without popping the WHEN frame
                # (only 'end' and 'when' pop it). 'or'/'else' splitting the
                # select must clear it first so they align with 'select'.
                while self.stack and self.stack[-1] == WHEN:
                    self._pop_frame()
                if cont == 0:
                    disp = len(self.stack) - 1

            when others:
                # 'package/procedure X is\nnew Y' is a generic instantiation.
                # The PKG pushed for 'X is' has no body; mark it for removal once
                # the 'new' statement ends (paren closes, no continuation left).
                if lw == "new" and cont == 0 and not popped_type_header \
                        and self.stack and self.stack[-1] == PKG:
                    self.pending_inst = True
                disp = len(self.stack)
                let last: str = last_word(code_s)
                # A trailing block keyword opens a block only when it sits at the
                # top level of the line. If the line ends with a net-open '(' the
                # keyword is inside that parenthesis - part of an expression such
                # as ':= (case X is' or ':= (if C then' - so it must NOT push a
                # block frame (which would shift every following line).
                if paren_delta(code) <= 0:
                    # A 'record' continuing a type declaration - 'type T is new
                    # X with' or 'type T is tagged' with 'record' below - stands
                    # one continuation level in, so its components go one level
                    # deeper than a record under a plain 'is'. Give it the same
                    # frame pair 'type T is' + 'record' gets: TYPE_HEADER under
                    # the RECORD, both closed by 'end record'.
                    # Only a line that STARTS with the record's own words: one
                    # that merely ends in 'record' - '(D : X) is record', a
                    # discriminant part closing the header - has its record
                    # opened by the 'is', exactly as on a one-line header, and
                    # its components belong one level past the 'type'.
                    if cont > 0 and last_word(code_s) == "record" \
                            and lw in ("record", "with", "limited", "tagged", "abstract") \
                            and not code_s.endswith(";") \
                            and not (self.stack and self.stack[-1] == TYPE_HEADER):
                        self._push_frame(TYPE_HEADER, self.frame_name)
                    self._open_trailing(code_s, lw)
                # A 'record' that opens a component list part-way along the line
                # ('type T is record F : X;'). Outside the guard above, because
                # such a line ends with the first component's ';' and so opens
                # nothing by that rule -- yet the component list is open, and an
                # 'end record;' below would otherwise pop a frame belonging to
                # something else. Only when the opener is not the last word:
                # there the dispatch has already handled it.
                if last != "record" and record_delta(code) > 0:
                    self._push_frame(RECORD)
                # The same for an if statement whose first branch is complete on
                # the opening line ('if C then return "X";'): its 'then' is
                # mid-line and its ';' closes the branch, not the statement, so
                # neither the dispatch nor the ';' rule sees the opener.
                # Two lines are not this: one ending in the condition's own
                # 'then', which the dispatch above has already pushed for, and
                # one where the condition does not finish at all -- a multi-line
                # condition belongs to the tracker, which pushes when its 'then'
                # finally arrives.
                # 'if A then if B then' opens two, the trailing one pushed above.
                if has_condition_then(code):
                    var extra_ifs: int = if_delta(code) - (1 if ends_with_condition_then(code_s) else 0)
                    while extra_ifs > 0:
                        self._push_frame(IF)
                        extra_ifs -= 1
                # stmt_incomplete(): 'if C then X; end if;' on one line starts
                # with 'if' and does not end with 'then', but it is a whole
                # statement, not a condition still looking for its 'then'. It
                # ends with ';', so only a line that genuinely continues opens
                # the condition tracker -- otherwise every following line is
                # read as part of a condition that never closes.
                if lw == "if" and not ends_with_condition_then(code_s) \
                        and stmt_incomplete(code_s):
                    self.cond_state = 1
                    self.cond_base = disp
                    self.cond_value_base = disp

        # 'end's the line reaches part-way along, after something the dispatch
        # above has already claimed: 'else return Deactivated; end if;' is an
        # 'else' line by its first word, and 'end if; end loop;' is one 'end'
        # line to the dispatch, which closes one frame. The rest close theirs
        # here. A leading 'end' has its own arm and has popped already. disp is
        # fixed by now, so this only moves the lines below.
        var extra_ends: int = unmatched_ends(code_s) - (1 if lw == "end" else 0)
        while extra_ends > 0:
            while self.stack and self.stack[-1] == WHEN:
                self._pop_frame()
            self._pop_frame()
            extra_ends -= 1

        # A multi-line if/elsif condition is tracked by cond_state, not here, so
        # only flag a general statement continuation when not in that mode.
        self.in_cont = False if self.cond_state > 0 else stmt_incomplete(code_s)
        self.paren_depth = max(0, self.paren_depth + paren_delta(code))
        # If this statement line opened a parenthesis and the text inside it ends
        # without a comma, the expression that is the paren's first item is not
        # finished - its argument list '(' on the next line is a continuation, not
        # a new list element, so it nests one level deeper. (When no paren is open
        # the next line resets this flag on entry, so setting it here is benign.)
        self.paren_cont = self.in_cont and not code_s.endswith(",")
        # When a named-association list opens on this line with the value
        # on the next ('(Title =>\n   "..."'), the paren path's arrow_level
        # logic cannot fire (this line was outside all parens at entry).
        # Mirror it here so the next line gets acol + INDENT_WIDTH.
        if self.paren_depth > 0 and code_s.endswith("=>"):
            self.arrow_level = self.paren_depth

        # Track where the current statement's value expression begins, so that a
        # term continuation below can nest one level past it. A non-continuation
        # line is the statement head (the expression starts there); a ':=' that
        # leads a continuation line moves the start to that line (the value
        # begins after the ':=').
        if cont == 0:
            # max(0, ...): 'else' / 'exception' / 'or' / 'private' closing a
            # block that was never opened takes disp to -1, and value_base is
            # Natural, so the store itself would raise. A clamp is not a fix for
            # a depth that went wrong -- it is the guarantee that no input, however
            # malformed, takes the formatter down instead of indenting it.
            self.value_base = max(0, disp)
        elif code_s.startswith(":="):
            self.value_base = disp + cont

        var lead_n: Natural = max(0, disp + cont) * INDENT_WIDTH
        # A term continuation (a value operator -, +, &, >=, ... or an argument list
        # opening with '(') continues the value expression, so it sits one level
        # past where that expression began (value_base). This nests it under the
        # line it continues - e.g. the '- ...' / '(args)' under a continued ':= F' -
        # while a chain of such continuations all align at the same level rather
        # than escalating. The boolean connectives and bindings (':=', '=>') are
        # excluded by is_term_continuation and keep the plain continuation level,
        # so they align with any comments that document them. Applied before
        # _push_parens so the inner items align to this line's '('.
        if cont > 0 and is_term_continuation(code_s):
            lead_n = max(0, self.value_base + 1) * INDENT_WIDTH
        # A '|' continuation extends a 'when' choice list or a membership test.
        # It aligns at the arm-body level (disp, one indent width above 'when'),
        # which is the GNAT style: '|' and the arm body share the same column.
        if cont > 0 and code_s.startswith("|"):
            lead_n = max(0, disp) * INDENT_WIDTH
        # Standalone block-opener keywords that terminate a multi-line header
        # (e.g. 'for C in expr\n  .. expr\nloop', 'task type T with ... is')
        # are not value continuations - snap back to the declaration level.
        # Exception: 'is new' is a generic instantiation (a true continuation).
        if lw in ("loop", "do") and cont > 0:
            lead_n = max(0, disp) * INDENT_WIDTH
        if lw == "is" and cont > 0 and lead_ident(code_s[2:]).lower() != "new":
            lead_n = max(0, disp) * INDENT_WIDTH
        # An aspect whose value spilled past its arrow ('with Static_Predicate
        # =>' with the predicate on the next line): the value sits one level
        # past the aspect, and its own continuation lines ('and ...', '& ...',
        # '| ...') one level past the value. The arrow is told apart from a
        # case alternative's by the 'when' - on this line, or on the line that
        # opened a choice list continued here ('| B =>'). A ',' starts the next
        # aspect and a ';' ends the declaration; either ends the value.
        #
        # The same holds for a condition on its own 'when' line continuing an
        # 'exit Name' or an entry header: 'and then ...' below it continues
        # that condition, so it sits one level past the 'when' (spill_col is
        # then the 'when' line's own column, set below).
        if self.spill_col >= 0 and cont > 0:
            lead_n = self.spill_col
            if is_term_continuation(code_s) or code_s.startswith("|"):
                lead_n += INDENT_WIDTH
        if cont == 0 or code_s.endswith(",") or not self.in_cont:
            self.spill_col = -1
        if cont > 0 and lw == "when" and self.in_cont:
            # The condition's head is the 'when' line itself (unlike an aspect,
            # whose value starts on the NEXT line), so its continuations - an
            # 'and then' is a term continuation - land one level past it.
            self.spill_col = lead_n
        if self.paren_depth == 0 and code_s.endswith("=>") and self.cont_kw != "when" \
                and "when" not in code_words(code_s):
            self.spill_col = lead_n + INDENT_WIDTH
            self.in_cont = True
        # As in the cond_state branch: this line is outside any paren at entry, so
        # any paren it opens is fresh. Invalidate paren_next_lead so a comment in
        # that paren uses the kind-aware fallback, not a stale sibling lead.
        self.paren_next_lead_depth = -1
        self._push_parens(emit_text, lead_n, entry_depth, self.paren_depth)
        " " * lead_n + emit_text


def usage():
    """The -h/--help text, on stdout."""
    print f"""Usage: ada_indent [OPTIONS] [FILE]

Indent Ada source code.  Reads FILE, or stdin when FILE is omitted.
Output is written to stdout; each source line is replaced by its
correctly-indented form (indentation step: 2 spaces, spaces only).

Options:
  -h, --help          Show this help and exit.
  --emit-state        After each output line emit a state snapshot on a separate line of the
                      form  ##STATE:<data>  that captures the indenter's full parse state.
                      Consumed by emacs integration to enable incremental re-indentation.
  --state <data>      Restore the indenter from a previously-emitted state snapshot before processing
                      the first input line.  Must  precede the lines the snapshot refers to.
  -q, --quiet         Suppress the stderr diagnostics reported when an 'end' line contradicts
                      the block structure seen so far.  The indenting is unaffected: the same
                      resynchronisation happens either way, it is just not reported.
"""

def main() -> Natural:
    var ind: Indenter = Indenter()
    var do_emit_state: bool = False
    var file_arg: Path            # empty until a non-option argument names one
    var args: []str = $@
    var ai: Natural = 0
    while ai < $#:
        let a: str = args[ai]
        case a:
            when "-h" | "--help":
                usage()
                return 0
            when "--emit-state":
                do_emit_state = True
            when "-q" | "--quiet":
                ind.warn = False
            when "--state":
                if ai + 1 < $#:
                    ai += 1
                    ind.load_state(args[ai])
            when others:
                file_arg = Path(a)
        ai += 1

    let f: File = (open(file_arg) if file_arg != "" else stdin)
    for line in f.lines:
        print ind.indent_line(line)
        if do_emit_state:
            print "##STATE:" + ind.dump_state()

if __name__ == "__main__":
    quit(main())
