--  GNAT project for the Ada translation of ada_indent.
--
--    gprbuild -P ada_indent.gpr            -- builds bin/ada_indent
--    gprbuild -P ada_indent.gpr -XMODE=debug
project Ada_Indent is

   type Mode_Type is ("release", "debug");
   Mode : Mode_Type := external ("MODE", "release");

   for Source_Dirs use ("src");
   for Object_Dir use "obj/" & Mode;
   for Exec_Dir use "bin";
   for Main use ("ada_indent.adb");

   package Compiler is
      case Mode is
         when "release" =>
            for Default_Switches ("Ada") use ("-O2", "-gnat2012", "-gnatwa", "-gnatQ");
         when "debug" =>
            for Default_Switches ("Ada") use
              ("-g", "-O0", "-gnat2012", "-gnata", "-gnato", "-fstack-check",
               "-gnatwa", "-gnatVa", "-gnatQ");
      end case;
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-E");
   end Binder;

end Ada_Indent;
