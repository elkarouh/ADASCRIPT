"""
baselines — a TACT baseline and what it holds on disk: its builds, which
read their Tlogs, and its replays.

Depends on `tcheck_common`, `tlog` and `replays`, siblings inside LIBS/,
nimported by their bare names.
"""

nimport os
nimport tcheck_common
nimport tlog
nimport replays

# ---------------------------------------------------------------------------
# Builds
# ---------------------------------------------------------------------------

def build_type_from(build_name: BuildName_T) -> ?BuildType:
    """Extract the build type (IP, OP, SIP) from a build directory name.

    build_type_from("build_G!31.IP.L8") -> IP
    """
    # Explicit `return` on every branch: a tail expression does not work
    # under a `?T` return type, whichever branch it is on -- a value comes
    # out `some(IP)` where the case is typed `BT`, and a bare `None` reaches
    # Nim as `nil` and makes isNil ambiguous. Written up in TODO.md.
    case build_name:
        when /\.IP\./:  return IP
        when /\.OP\./:  return OP
        when /\.SIP\./: return SIP
        when others:    return None

class Build:
    """One build of one baseline, e.g. build_G!31.IP.L8 of 30.0.0.121.

    It knows where it lives, so nothing is handed a build and a directory
    to join by hand -- the saved_logs, tacot_corico and Tlog paths were
    each spelled out at every place that needed one.

    It holds its baseline's number, all it needs of the baseline; the
    Baseline lists its builds.
    """
    name       : BuildName_T  = "" # e.g. build_G!31.IP.L8
    btype      : BuildType    = IP
    baseline_nr: BaselineNr_T = "" # the baseline it is a build of
    dir        : Path         = Path("")
    # the Tlogs it has, each read once, here: by subtype, and for each the
    # normal pass's before the mrun's
    tlogs      : []Tlog

    def __init__(self, name: BuildName_T, btype: BuildType, baseline_nr: BaselineNr_T, baseline_dir: Path):
        self.name = name
        self.btype = btype
        self.baseline_nr = baseline_nr
        self.dir = baseline_dir / name
        for subtype in BuildSubtype:
            for pass_ in BuildPass:
                let path: Path = self.tlog_path(subtype, pass_)
                if -f path:
                    self.tlogs.append(Tlog(path, subtype, pass_))

    def tlog(self, subtype: BuildSubtype, pass_: BuildPass) -> ?Tlog:
        """Its Tlog of SUBTYPE for PASS_, if it has one."""
        for t in self.tlogs:
            return t if t.subtype == subtype and t.build_pass == pass_
        return None

    def saved_logs(self) -> Path:
        self.dir / "saved_logs"

    def tacot_dir(self, pass_: BuildPass) -> Path:
        """The tacot_corico directory for a given pass."""
        case pass_:
            when normal: self.saved_logs() / "tacot_corico.LATEST"
            when mrun:   self.saved_logs() / "tacot_corico_mrun.LATEST_GOOD"

    def tlog_path(self, subtype: BuildSubtype, pass_: BuildPass) -> Path:
        """Where the Tlog of SUBTYPE for PASS_ is, whether or not it exists yet."""
        self.tacot_dir(pass_) / "TACT_REGRESS_LOGS" / "LATEST" / tlog_filename(subtype, pass_)

    def process_subtype(self, subtype: BuildSubtype):
        """Process one subtype of the build, for both normal and mrun passes."""
        def lo_build_checks(tacot_corico_latest: Path):
            """Check for FORCE_TRACE errors in LO build logs."""
            let lo_logdir: Path = tacot_corico_latest / "work" / "logging-lo"
            if -e lo_logdir:
                puts("SyB", "Doing lo-build checks in " + lo_logdir, NEWLINE=True)
                grep_force_trace_in_dir(lo_logdir / "LOGS")
                grep_force_trace_in_dir(lo_logdir / "LOGS_others")
        for pass_ in BuildPass:
            if pass_ == mrun and (self.btype != IP or subtype != in_test):
                continue # we are only interested in "IP in" for the mrun pass
            self.show_tlog(subtype, pass_)
            if subtype == lo and pass_ == normal:
                lo_build_checks(self.tacot_dir(pass_))

    def show_tlog(self, subtype: BuildSubtype, pass_: BuildPass):
        """Show the Tlog of SUBTYPE for PASS_ if there is one, or a 'not
        ready' message."""
        let sl: str = subtype_label(subtype)

        let found: ?Tlog = self.tlog(subtype, pass_)
        if found is not None:
            let tlog: Tlog = found
            stdout.write("=======================================  ")
            puts("SWr", tlog.file.name)
            stdout.write(" ")
            puts("SWb", " (" + self.name + ")")
            print "  ======================================="
            tlog.show(ONLY_NEW)
            if tlog.new_failing'Length > 0 or tlog.crashed'Length > 0:
                HAS_NEW_FAILURES = True
            print
            return

        case self.btype:
            when IP:
                return if subtype not in (in_test, mono)
            when OP:
                return if subtype not in (in_test, assert_test)
            when others:
                return
        case pass_:
            when normal: puts("SWb", f"\"{self.btype} {sl}\" build not ready yet", NEWLINE=True)
            when mrun:   puts("SWb", f"\"{self.btype} {sl} mrun\" build not ready yet", NEWLINE=True)

    def show_padactl(self):
        """Show the Padactl/CRC summary from the IP self."""
        hr('#')
        puts("SWr", "Padactl", NEWLINE=True)
        let padactl_file: Path = self.saved_logs() / "Padactl.LATEST" / "Padactl.summary"
        if -f padactl_file:
            hr('-')
            puts("SWb", str(padactl_file), NEWLINE=True)
            let r = shell: grep -A20 delta {padactl_file}
            if r.output.strip() != "":
                print r.output.rstrip("\n")
            let r2 = shell: grep -A20 -i 'summary of last changes' {padactl_file}
            if r2.output.strip() != "":
                print r2.output.rstrip("\n")
            echo_emacs(padactl_file)
        else:
            puts("SWb", "WARNING: No CRC summary file found!", NEWLINE=True)

    def check_test_programs(self, fast_mode: bool):
        """Find or run check_run_test_programs_log from the IP self."""
        let baseline: BaselineNr_T = self.baseline_nr
        let work: Path = self.tacot_dir(normal) / "work"
        print
        hr('#')
        puts("SWr", "Check build closure and test programs.", NEWLINE=True)
        puts("USBy", "CHECK RUN TEST PROGRAMS LOG FOR " + str(self.dir) + " ...", NEWLINE=True)
        let find_lines: []str = shellLines: find {work} -type f -name 'check_run_test_programs.log' -print -quit
        var logfile: Path = Path("")
        if find_lines'Length > 0:
            logfile = Path(find_lines[0])

        if logfile == "":
            if fast_mode:
                puts("SWb", "check_run_test_programs_log not yet complete and we are in fast mode -> skip this check.", NEWLINE=True)
            else:
                puts("SWb", "check_run_test_programs_log not yet complete -> execute the program manually. This can take some minutes (run with -f to disable the execution).", NEWLINE=True)
                let build_subtype: str = self.name.replace("build_", "")
                let rc: int = shell: cd /tmp && echo check_run_test_programs_log | Ccontext -b "TACT.TACT_CONFIG.{baseline}" -e "{build_subtype}" 2>&1
        else:
            let mktemp_lines: []str = shellLines: cfmu_mktemp
            let full_report: Path = Path(mktemp_lines[0]) if mktemp_lines'Length > 0 else Path("/tmp/tcheck_report.txt")
            print "Full report is found in " + full_report + "."
            print
            let cp_rc: int = shell: cp {logfile} {full_report}
            let filtered = shell: grep -v 'Running.*setup' {full_report} | grep -v 'Checking for errors' | grep -v 'No errors found in' | grep -v -E '^[0-9.]+:\s+\S+\s+INFORMATION:' | grep -E '\S'
            if filtered.output.strip() != "":
                print filtered.output.rstrip("\n")

def grep_force_trace_in_dir(dir: Path):
    """Grep for missing 'if Debug.Trace' guards in LO build logs."""
    if not -d dir:
        puts("SWb", "WARNING: '" + dir + "' does not exist!", NEWLINE=True)
        return
    puts("SWb", "Grep in " + dir + " to detect missing 'if Debug.Trace (...) then' (100 first errors, no matches means no errors detected):", NEWLINE=True)
    let r = shell: for f in {dir}/*_out_*; do [ -e "$f" ] && grep -H -n -B1 '!!! ERROR : FORCE_TRACE message above' "$f" | grep -v '^--[[:space:]]*$'; done | head -n 100
    if r.output.strip() != "":
        print r.output.rstrip("\n")

# ---------------------------------------------------------------------------
# Baselines
# ---------------------------------------------------------------------------

class Baseline:
    """One TACT baseline: its number and the directory holding its builds.

    What most of this program does is compare a baseline with the one
    before it, and that is `bl.previous()` -- the number arithmetic and
    the directory it implies were rebuilt by hand at every call site.

    Its builds and replays are listed only when asked, by find_builds()
    and find_replays(): creating one lists nothing, so `previous()` costs
    nothing and cannot fail on a baseline whose directory is gone.

    """
    nr     : BaselineNr_T = "" # e.g. 30.0.0.121
    dir    : Path         = Path("")
    builds : []Build            # its build_G!* builds, once find_builds() has run
    replays: []Replay           # its replays' logs, once find_replays() has run

    def __init__(self, nr: BaselineNr_T):
        self.nr = nr
        self.dir = TACT_ROOT / ("TACT_CONFIG." + nr)

    def previous(self) -> Baseline:
        let (head, tail) = self.nr.rsplit(".", 1)
        return Baseline(f"{head}.{int(tail) - 1}")

    def saved_logs_dir(self, btype: BuildType) -> Path:
        """The saved_logs directory of this baseline's build of BTYPE."""
        var env_id: str = $CM_ENV_ID
        case btype:
            when IP:  env_id = env_id.replace(".OP.", ".IP.")
            when OP:  env_id = env_id.replace(".IP.", ".OP.")
            when SIP: env_id = env_id.replace(".IP.", ".SIP.")
        self.dir / ("build_" + env_id) / "saved_logs"

    def find_builds(self):
        """List the baseline's build_G!* directories into builds, as the
        builds they are."""
        let SKIP_BUILD_PATTERNS: []str = ["92", "94", "95", "98", "30"]
        let basedir: Path = self.dir
        let listing: []str = shellLines: ls -1d {basedir}/build_G!*
        self.builds = []
        for line in listing:
            continue if line == ""
            let basename: str = Path(line).name # e.g. build_G!31.IP.L8
            continue if any(pat in basename for pat in SKIP_BUILD_PATTERNS)
            let bt: ?BuildType = build_type_from(basename)
            continue if bt is None
            self.builds.append(Build(basename, bt, self.nr, self.dir))

    def find_replays(self):
        """List the replays' logs into replays, one per replay type, in
        canonical order."""
        let basedir: Path = self.dir
        let listing: []str = shellLines: ls -d {basedir}/build_*OP*/saved_logs/Treplay_*.log

        var type_to_file: [ReplayType]Path
        for found in listing:
            continue if found == ""
            let log: Path = Path(found)
            let rt: ?ReplayType = replay_type_from(log)
            continue if rt is None
            type_to_file[rt] = log

        self.replays = []
        for rtype, filepath in enumerate(type_to_file):
            continue if filepath == ""
            self.replays.append((rtype: rtype, file: filepath))

    def replay_log_dir(self, rtype: ReplayType) -> Path | !Failure_T:
        """The newest replay log dir of RTYPE, from this baseline backwards.

        Replays run on the OP build, so that is the saved_logs searched.
        """
        let dir_pat: Glob_T = replay_dir_pattern(rtype)
        var bl: Baseline = self
        var dir: Path = bl.saved_logs_dir(OP)
        var attempts: int = 0
        while attempts < 20:
            let listing: []str = shellLines: ls -d {dir}/replay_dir*{dir_pat}*/work/logging/LOGS
            if listing'Length > 0 and listing[0] != "":
                return Path(listing[0])
            bl = bl.previous()
            dir = bl.saved_logs_dir(OP)
            stderr.writeLine(PROG + ": trying " + dir)
            attempts += 1
        return Failure_T(message="no replay log dir found")

    def scan_regression_tests(self, btype: BuildType, subtype: BuildSubtype) -> Path | !Failure_T:
        """Scan the logs of the BTYPE build's SUBTYPE regression tests for errors
        and core dumps; the report, normalized for diffing."""
        # saved_logs_dir(btype) is already the BTYPE build. This used to rewrite
        # "OP" to "IP" (or back) across the whole path string as well, which was
        # a no-op on a real TACT path and mangled any other: a checkout under
        # .../ADASCRIPT/... came out as .../ADASCROPT/... for an OP scan.
        let sl: str = subtype_label(subtype)
        var log_dir: Path = Path("")
        let work: Path = self.saved_logs_dir(btype) / "tacot_corico.LATEST" / "work" / ("logging-" + sl)
        case subtype:
            when mono:
                log_dir = work / "LOGS_mono"
            when others:
                log_dir = work / "LOGS_others"
        return Failure_T(message="log dir does not exist: " + log_dir) if not -d log_dir
        puts("USBy", "scanning " + log_dir, NEWLINE=True)
        let tacot_root: Path = log_dir.parent.parent.parent
        find_core_dumps(tacot_root)
        var report: str = ""
        case subtype:
            when mono:
                let mono_out: Path = log_dir / "mono.out"
                if -f mono_out:
                    let hits: str = grep_logfile(mono_out)
                    report = hits
            when others:
                let out_files: []str = shellLines: ls {log_dir}/*1_out_01
                for f in out_files:
                    continue if f == ""
                    hr('#')
                    puts("SWb", Path(f).name, NEWLINE=True)
                    hr('#')
                    let hits: str = grep_logfile(Path(f))
                    if hits != "":
                        report = report + "##### " + Path(f).name + " #####\n" + hits + "\n"
        return make_report(report, self.nr, "regression_" + btype'Image + "_" + sl)

    def show_failed_tests(self, btype: BuildType, subtype: BuildSubtype, n_baselines: int = 15) -> str:
        """The BTYPE SUBTYPE tests failing in this baseline and the N_BASELINES - 1
        before it, printed and returned."""
        var baseline: Baseline = self
        let sl: str = subtype_label(subtype)
        var ip_env: str = $CM_ENV_ID
        var op_env: str = ip_env.replace(".IP.", ".OP.")
        ip_env = ip_env.replace(".OP.", ".IP.")
        var result: str = ""
        for iteration in range(n_baselines):
            let bl: BaselineNr_T = baseline.nr
            let header: str = f"FAILED {btype} REGRESSION TESTS logging-{sl} for BASELINE {bl}"
            hr('-')
            puts("SWr", header, NEWLINE=True)
            result = result + header + "\n"
            var env: str = ip_env
            var suffix: str = "failed-in"
            case subtype:
                when mono:
                    env = ip_env
                    suffix = "failed-mono"
                when in_test:
                    case btype:
                        when IP:  env = ip_env
                        when OP:  env = op_env
                        when others: pass
                    suffix = "failed-in"
                when assert_test:
                    env = op_env
                    suffix = "failed-assert"
                when others: pass
            let r = shell: nl {TACT_ROOT}/test_reports/TACT.TACT_CONFIG.{bl}-{env}*/general.results.{suffix}
            if r.output.strip() != "":
                print r.output.rstrip("\n")
                result = result + r.output
            baseline = baseline.previous()
        return result

def grep_logfile(filepath: Path, max_errors: Positive = 100) -> str:
    # No `2>/dev/null` on any of these: a capturing shell keeps the two
    # streams apart, so what rg says about a file it cannot read is in
    # r.stderr and never in r.output. A missing log is the ordinary case
    # here, which is why the redirect was on every line to begin with.
    let r = shell(join = ";"):
        rg -l analyze_core {filepath}
        rg FATAL {filepath} | head -{max_errors}
        rg 'SEVERE.*Description' {filepath} | head -{max_errors}
        pyrg RAISED_EXCEPTION {filepath} | head -100
        pyrg EDIFF_FILES {filepath} | head -100
    let output: str = r.output.strip()
    if output != "":
        print output
    return output

# ---------------------------------------------------------------------------
# Tests: ady2nim c LIBS/baselines.ady && LIBS/baselines
# The real Tlog and replay logs are in test/samples, beside LIBS/.
# ---------------------------------------------------------------------------

if __name__ == "__main__":
    let samples: Path = Path($0).parent.parent / "test" / "samples"
    let tmp: Path = Path(run(["mktemp", "-d", "-t", "baselines.XXXXXX"]).output.strip())
    let PREQUAL: str = "Treplay_G31.OP.L8_30.0.0.133_2026.09.23_213300-run_prequal.NJrqM.log"
    let PERFORMANCE: str = "Treplay_G31.OP.L8_30.0.0.133_2026.09.23_213146-performance.MOJ0V.log"

    # --- a build's type, from its directory's name ----------------------------
    def build_type(name: BuildName_T) -> str:
        let bt: ?BuildType = build_type_from(name)
        return "none" if bt is None
        return f"{bt}"
    assert build_type("build_G!31.IP.L8") == "IP"
    assert build_type("build_G!31.OP.L8") == "OP"
    assert build_type("build_default_Linux") == "none"

    # --- a baseline, and what it holds --------------------------------------
    let bl: Baseline = Baseline("30.0.0.133")
    assert bl.previous().nr == "30.0.0.132"
    assert bl.dir == TACT_ROOT / "TACT_CONFIG.30.0.0.133"

    # its builds and replays, in a baseline directory made here
    var here: Baseline = Baseline("30.0.0.133")
    here.dir = tmp / "TACT_CONFIG.30.0.0.133"
    for name in ["build_G!31.IP.L8", "build_G!31.OP.L8", "build_G!92.IP.L8", "build_default_Linux"]:
        (here.dir / name / "saved_logs").mkdir()
    # the IP build has a Tlog, of 'in' for the normal pass
    let ip_tlog: Path = here.dir / "build_G!31.IP.L8" / "saved_logs" / "tacot_corico.LATEST" / "TACT_REGRESS_LOGS" / "LATEST" / "Tlog-in.log"
    ip_tlog.parent.mkdir()
    run(["cp", str(samples / "Tlog-in.log"), str(ip_tlog)])
    here.find_builds()
    assert [b.name for b in here.builds] == ["build_G!31.IP.L8", "build_G!31.OP.L8"]
    assert here.builds[1].btype == OP and here.builds[1].baseline_nr == "30.0.0.133"
    assert here.builds[0].tlog_path(in_test, normal) == ip_tlog
    # read when the build is found, and asked of it after
    assert [t.file for t in here.builds[0].tlogs] == [ip_tlog]
    assert len(here.builds[1].tlogs) == 0
    let in_tlog: ?Tlog = here.builds[0].tlog(in_test, normal)
    assert in_tlog is not None and in_tlog.reference == "30.0.0.131"
    assert here.builds[0].tlog(in_test, mrun) is None and here.builds[0].tlog(mono, normal) is None
    for name in [PERFORMANCE, PREQUAL]:
        run(["cp", str(samples / name), str(here.dir / "build_G!31.OP.L8" / "saved_logs")])
    here.find_replays()
    assert [r.rtype for r in here.replays] == [run_prequal, performance]   # in canonical order

    # what is not there: why, rather than an empty path
    let scanned: Path | !Failure_T = here.scan_regression_tests(IP, mono)
    assert scanned is Failure_T and scanned.message.startswith("log dir does not exist: ")
    let replay_dir: Path | !Failure_T = here.replay_log_dir(performance)
    assert replay_dir is Failure_T and replay_dir.message == "no replay log dir found"

    run(["rm", "-rf", str(tmp)])
    print "baselines: all tests passed"
