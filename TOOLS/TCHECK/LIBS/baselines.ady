"""
baselines — a TACT baseline and what it holds on disk: its builds, which
read their Tlogs, and its replays.

Depends on `tcheck_common`, `tlog` and `replays`, siblings inside LIBS/,
nimported by their bare names.
"""

nimport os
nimport tcheck_common
nimport tlog
nimport replays

# ---------------------------------------------------------------------------
# A build's test programs: its check_run_test_programs.log
# ---------------------------------------------------------------------------

# a difference the ksh style scanner sees with the previous baseline: the
# component and the check it is of, and the ediff the log gives to see it
type StyleDiff is record:
    component: str    # COMMON_CONFIG
    check    : str    # VAR_CHECK
    ediff    : str    # (ediff-files "<the baseline's result>" "<this build's>"); "" if not given

# one finding of the ksh style scanner's: the script, what kind, and the
# variable (or whatever the check names), from a "./<script>:XXX:<name>"
# under the heading of its kind
type StyleFinding is record:
    script: str    # ./sources/regression_testing.ksh
    kind  : str    # used not defined
    name  : str    # CM_HOST

# a script whose findings are not the previous baseline's: its new findings
# and its gone ones, a "<kind>: <names>" each
type ScriptChange is record:
    script: str
    new   : []str  # used not defined: CM_HOST PERL_VERSION
    gone  : []str  # defined not used: OLD_WORK_DIR

def style_kind(heading: str) -> str:
    """The kind of findings a heading of the scanner's is of.

    style_kind("The following variables seem to be used not defined:") -> "used not defined"
    style_kind("default define_configuration var assigned, it is likely a bug:") -> "default define_configuration var assigned"
    """
    heading.rstrip(":").split(",")[0].replace("The following variables seem to be ", "")

def style_findings(file: Path) -> []StyleFinding:
    """The findings in FILE, a result of the ksh style scanner's."""
    var findings: []StyleFinding = []
    var kind: str = ""
    for line in file.lines:
        if line == /^(?P<script>\.\/[^:]+):[^:]*:(?P<name>.+)$/:
            findings.append(StyleFinding($+{script}, kind, $+{name}))
        elif line.endswith(":") and not line.startswith(" "):
            kind = style_kind(line)
    findings

def ediff_files(ediff: str) -> []Path:
    """The two files an ediff link compares, in CM_OT; none if EDIFF is not
    one."""
    return [] if ediff != /^\(ediff-files "(?P<a>[^"]+)" "(?P<b>[^"]+)"\)$/
    [in_cm_ot($+{a}), in_cm_ot($+{b})]

def in_cm_ot(file: str) -> Path:
    """FILE, a /cm/ot/... path as a log names it, in CM_OT: the same unless
    TCHECK_CM_OT says otherwise."""
    return CM_OT / file.removeprefix("/cm/ot/") if file.startswith("/cm/ot/")
    return Path(file)

def by_kind(findings: []StyleFinding, script: str) -> []str:
    """SCRIPT's FINDINGS, a "<kind>: <names>" for each kind."""
    var kinds: []str = []
    for f in findings:
        if f.script == script and f.kind not in kinds:
            kinds.append(f.kind)
    [k + ": " + " ".join([f.name for f in findings if f.script == script and f.kind == k]) for k in kinds]

def changed_scripts(baseline: Path, current: Path) -> []ScriptChange:
    """The scripts whose findings in CURRENT are not the same as in BASELINE,
    two results of the ksh style scanner's. Compared as sets: a finding
    that only moved in the file is no change."""
    let before: []StyleFinding = style_findings(baseline)
    let after: []StyleFinding = style_findings(current)
    let new: []StyleFinding = [f for f in after if f not in before]
    let gone: []StyleFinding = [f for f in before if f not in after]
    var scripts: []str = []
    for f in new + gone:
        if f.script not in scripts:
            scripts.append(f.script)
    [ScriptChange(s, by_kind(new, s), by_kind(gone, s)) for s in scripts]

def masked(line: str) -> str:
    """LINE with the baseline numbers in it -- 30.0.0.132 -- as <nr>, to be
    compared with the same line of another baseline's."""
    var out: str = line
    out = s/\d+\.\d+\.\d+\.\d+/<nr>/g
    out

def diff_summaries(before: []str, after: []str) -> []str:
    """How summary AFTER differs from BEFORE: its lines BEFORE has not,
    "+ ", then BEFORE's lines it has not, "- "."""
    let added: []str = marked(after, before, "+ ")
    let removed: []str = marked(before, after, "- ")
    added + removed

def keyed(lines: []str) -> []str:
    """LINES of a summary, each after what it is under and a newline: a
    script line (indented four) after its style difference, a line on who
    changed it (indented six) after both -- the same line under another is
    another line."""
    var keys: []str = []
    var heading: str = ""
    var script: str = ""
    for line in lines:
        if line.startswith("      "):
            keys.append(heading + "\n" + script + "\n" + line)
        elif line.startswith("    "):
            script = line
            keys.append(heading + "\n" + line)
        else:
            heading = line
            keys.append(line)
    keys

def marked(lines: []str, other: []str, mark: str) -> []str:
    """LINES that OTHER has not, each after MARK. A line under another --
    a script under its style difference, who changed it under the script
    -- comes after what it is under, unmarked when OTHER has that too, so
    as to say which one it is."""
    let others: []str = keyed(other)
    var out: []str = []
    for key in keyed(lines):
        continue if key in others
        let parts: []str = key.split("\n")
        for i in range(len(parts) - 1):
            let above: str = "\n".join(parts[0 .. i])
            if above in others and ("  " + parts[i]) not in out:
                out.append("  " + parts[i])
        out.append(mark + parts[len(parts) - 1])
    out

# the SEVERE messages of one of the test programs: how many, and the first
type ProgramErrors is record:
    program: str      # param_shared_cleanup_ftok
    count  : int
    first  : str      # dbspy -D ./env_imp_regress/... failed with exit code 42 : ...

class TestProgramsLog:
    """A build's check_run_test_programs.log -- its build closure and test
    programs checked -- read for what failed, each once. The log repeats
    the messages of each sub-build that ran a check, and gives a ksh style
    difference in six lines, of which the ediff is the one to act on."""
    file       : Path
    verdict    : []str            # check_run_test_programs_log's own: what failed
    style_diffs: []StyleDiff
    errors     : []ProgramErrors  # the other programs' SEVERE messages, by program
    docgen     : []str            # docgen's: "block not included: ..."
    missing    : []str            # "... No such file or directory"
    # who changed each file, by its path in its component, per the
    # baseline's changes report: shown under the scripts of a style
    # difference; or why there is no report to say
    changes    : {str}[]str
    no_changes : str

    def __init__(self, file: Path):
        self.file = file
        self.changes = {:}
        self.no_changes = ""
        var seen: {}str = {}
        for line in file.lines:
            continue if line in seen     # a sub-build's messages again
            seen.add(line)
            if line == /^\d{6}\.\d{6}: (?P<program>\S+): SEVERE: (?P<message>.*)$/:
                let program: str = $+{program}
                let message: str = $+{message}.strip()
                continue if message == ""
                case program:
                    when "check_run_test_programs_log":
                        self.verdict.append(message)
                    when "check_new_ksh_style_errors":
                        if message == /previous baseline check of (?P<component>\S+) scripts .*\.DIFF\.(?P<check>\w+)"/:
                            self.style_diffs.append(StyleDiff($+{component}, $+{check}, ""))
                        elif message.startswith("(ediff-files ") and len(self.style_diffs) > 0:
                            self.style_diffs[len(self.style_diffs) - 1].ediff = message
                    when others:
                        self.add_error(program, message)
            elif line == /^SEVERE: (?P<message>.*)$/:
                self.docgen.append($+{message})
            elif "No such file or directory" in line:
                self.missing.append(line)

    def add_error(self, program: str, message: str):
        """MESSAGE, one more SEVERE of PROGRAM's."""
        for i in range(len(self.errors)):
            if self.errors[i].program == program:
                self.errors[i].count += 1
                return
        self.errors.append(ProgramErrors(program, 1, message))

    def summary(self, limit: int = 5, read_results: bool = True, links: bool = True) -> []str:
        """What failed, a line each: the verdict; each style difference,
        with its ediff if LINKS and, READ_RESULTS and its two files there,
        the scripts it is in; each program's SEVERE messages, how many and
        the first; LIMIT of docgen's; the files missing."""
        var lines: []str = []
        if len(self.verdict) + len(self.style_diffs) + len(self.errors) + len(self.docgen) + len(self.missing) == 0:
            return ["no SEVERE message"]
        lines = lines + self.verdict
        if len(self.style_diffs) > 0:
            lines.append(f"{len(self.style_diffs)} ksh style differences with the previous baseline:")
            if read_results and self.no_changes != "":
                lines.append("  who changed their scripts: " + self.no_changes)
            for diff in self.style_diffs:
                let link: str = "  #emacs:" + diff.ediff if links and diff.ediff != "" else ""
                lines.append(f"  {diff.component} {diff.check}" + link)
                if read_results:
                    lines = lines + script_lines(diff, self.changes)
        for e in self.errors:
            lines.append(f"{e.count:>3} SEVERE from {e.program}: {e.first}")
        if len(self.docgen) > 0:
            lines.append(f"{len(self.docgen)} docgen errors:")
            for message in self.docgen[0 ..< min(limit, len(self.docgen))]:
                lines.append("  " + message)
            if len(self.docgen) > limit:
                lines.append(f"  ... and {len(self.docgen) - limit} more")
        for line in self.missing:
            lines.append("missing: " + line)
        lines

# a script's path, bold yellow, to stand out from its findings
const SCRIPT_COLOR: ColorSpec_T = "SY"

def script_lines(diff: StyleDiff, changes: {str}[]str) -> []str:
    """The scripts DIFF is in, a line each, its path highlighted: its new
    findings, its gone ones; under it, who changed it per CHANGES (see
    TestProgramsLog.changes), or that nobody did, when CHANGES knows of any
    change. None if its two files are not there to read."""
    let files: []Path = ediff_files(diff.ediff)
    return [] if len(files) != 2 or not -f files[0] or not -f files[1]
    var lines: []str = []
    for change in changed_scripts(files[0], files[1]):
        let new: []str = ["new " + k for k in change.new]
        let gone: []str = ["gone " + k for k in change.gone]
        lines.append("    " + colored(SCRIPT_COLOR, change.script) + "  " + "; ".join(new + gone))
        let key: str = diff.component + "/" + change.script.removeprefix("./")
        if key in changes:
            for line in changes[key]:
                lines.append("      " + line)
        elif len(changes) > 0:
            lines.append("      not in the changes report")
    lines

# ---------------------------------------------------------------------------
# Builds
# ---------------------------------------------------------------------------

def build_type_from(build_name: BuildName_T) -> ?BuildType:
    """Extract the build type (IP, OP, SIP) from a build directory name.

    build_type_from("build_G!31.IP.L8") -> IP
    """
    # Explicit `return` on every branch: a tail expression does not work
    # under a `?T` return type, whichever branch it is on -- a value comes
    # out `some(IP)` where the case is typed `BT`, and a bare `None` reaches
    # Nim as `nil` and makes isNil ambiguous. Written up in TODO.md.
    case build_name:
        when /\.IP\./:  return IP
        when /\.OP\./:  return OP
        when /\.SIP\./: return SIP
        when others:    return None

class Build:
    """One build of one baseline, e.g. build_G!31.IP.L8 of 30.0.0.121.

    It knows where it lives, so nothing is handed a build and a directory
    to join by hand -- the saved_logs, tacot_corico and Tlog paths were
    each spelled out at every place that needed one.

    It holds its baseline's number, all it needs of the baseline; the
    Baseline lists its builds.
    """
    name       : BuildName_T  = "" # e.g. build_G!31.IP.L8
    btype      : BuildType    = IP
    baseline_nr: BaselineNr_T = "" # the baseline it is a build of
    dir        : Path         = Path("")
    # the Tlogs it has, each read once, here: by subtype, and for each the
    # normal pass's before the mrun's
    tlogs      : []Tlog

    def __init__(self, name: BuildName_T, btype: BuildType, baseline_nr: BaselineNr_T, baseline_dir: Path):
        self.name = name
        self.btype = btype
        self.baseline_nr = baseline_nr
        self.dir = baseline_dir / name
        for subtype in BuildSubtype:
            for pass_ in BuildPass:
                let path: Path = self.tlog_path(subtype, pass_)
                if -f path:
                    self.tlogs.append(Tlog(path, subtype, pass_))

    def tlog(self, subtype: BuildSubtype, pass_: BuildPass) -> ?Tlog:
        """Its Tlog of SUBTYPE for PASS_, if it has one."""
        for t in self.tlogs:
            return t if t.subtype == subtype and t.build_pass == pass_
        return None

    def saved_logs(self) -> Path:
        self.dir / "saved_logs"

    def tacot_dir(self, pass_: BuildPass) -> Path:
        """The tacot_corico directory for a given pass."""
        case pass_:
            when normal: self.saved_logs() / "tacot_corico.LATEST"
            when mrun:   self.saved_logs() / "tacot_corico_mrun.LATEST_GOOD"

    def tlog_path(self, subtype: BuildSubtype, pass_: BuildPass) -> Path:
        """Where the Tlog of SUBTYPE for PASS_ is, whether or not it exists yet."""
        self.tacot_dir(pass_) / "TACT_REGRESS_LOGS" / "LATEST" / tlog_filename(subtype, pass_)

    def process_subtype(self, subtype: BuildSubtype, asked: bool = False):
        """Process one subtype of the build, for both normal and mrun passes;
        ASKED when -focus asked for it, so that its Tlog missing is said."""
        def lo_build_checks(tacot_corico_latest: Path):
            """Check for FORCE_TRACE errors in LO build logs."""
            let lo_logdir: Path = tacot_corico_latest / "work" / "logging-lo"
            if -e lo_logdir:
                puts("SyB", "Doing lo-build checks in " + lo_logdir, NEWLINE=True)
                grep_force_trace_in_dir(lo_logdir / "LOGS")
                grep_force_trace_in_dir(lo_logdir / "LOGS_others")
        for pass_ in BuildPass:
            if pass_ == mrun and (self.btype != IP or subtype != in_test):
                continue # we are only interested in "IP in" for the mrun pass
            self.show_tlog(subtype, pass_, asked)
            if subtype == lo and pass_ == normal:
                lo_build_checks(self.tacot_dir(pass_))

    def show_tlog(self, subtype: BuildSubtype, pass_: BuildPass, asked: bool = False):
        """Show the Tlog of SUBTYPE for PASS_ if there is one, or say that
        it is not there, and where it was looked for: for the subtypes each
        build type is expected to have, or for any when ASKED for it."""
        let sl: str = subtype_label(subtype)

        let found: ?Tlog = self.tlog(subtype, pass_)
        if found is not None:
            let tlog: Tlog = found
            stdout.write("=======================================  ")
            puts("SWr", tlog.file.name)
            stdout.write(" ")
            puts("SWb", " (" + self.name + ")")
            print "  ======================================="
            tlog.show(ONLY_NEW)
            if tlog.new_failing'Length > 0 or tlog.crashed'Length > 0:
                HAS_NEW_FAILURES = True
            print
            return

        if not asked:
            case self.btype:
                when IP:
                    return if subtype not in (in_test, mono)
                when OP:
                    return if subtype not in (in_test, assert_test)
                when others:
                    return
        case pass_:
            when normal: puts("SWb", f"\"{self.btype} {sl}\" build not ready yet", NEWLINE=True)
            when mrun:   puts("SWb", f"\"{self.btype} {sl} mrun\" build not ready yet", NEWLINE=True)
        print "  no Tlog at " + self.tlog_path(subtype, pass_)

    def show_padactl(self):
        """Show the Padactl/CRC summary from the IP self."""
        hr('#')
        puts("SWr", "Padactl", NEWLINE=True)
        let padactl_file: Path = self.saved_logs() / "Padactl.LATEST" / "Padactl.summary"
        if -f padactl_file:
            hr('-')
            puts("SWb", str(padactl_file), NEWLINE=True)
            let r = shell: grep -A20 delta {padactl_file}
            if r.output.strip() != "":
                print r.output.rstrip("\n")
            let r2 = shell: grep -A20 -i 'summary of last changes' {padactl_file}
            if r2.output.strip() != "":
                print r2.output.rstrip("\n")
            echo_emacs(padactl_file)
        else:
            puts("SWb", "WARNING: No CRC summary file found!", NEWLINE=True)

    def test_programs_log(self) -> ?Path:
        """The build's check_run_test_programs.log, the newest if there
        are several -- a test's LOGS directory may hold one of its own;
        none before check_run_test_programs_log has run."""
        let work: Path = self.tacot_dir(normal) / "work"
        let found: []str = shellLines: find {work} -type f -name 'check_run_test_programs.log' -printf '%T@ %p\n' | sort -n | tail -1 | cut -d' ' -f2-
        return None if found'Length == 0 or found[0] == ""
        return Path(found[0])

    def check_test_programs(self, fast_mode: bool, verbose: bool, changes: {str}[]str, no_changes: str):
        """Find or run check_run_test_programs_log from the IP self; what
        its log says failed, summed up -- VERBOSE lists all docgen's --
        with who changed the scripts of a style difference, per CHANGES,
        or NO_CHANGES, why nothing says (see TestProgramsLog.changes)."""
        let baseline: BaselineNr_T = self.baseline_nr
        print
        hr('#')
        puts("SWr", "Check build closure and test programs.", NEWLINE=True)
        puts("USBy", "CHECK RUN TEST PROGRAMS LOG FOR " + str(self.dir) + " ...", NEWLINE=True)
        let logfile: ?Path = self.test_programs_log()
        if logfile is None:
            if fast_mode:
                puts("SWb", "check_run_test_programs_log not yet complete and we are in fast mode -> skip this check.", NEWLINE=True)
            else:
                puts("SWb", "check_run_test_programs_log not yet complete -> execute the program manually. This can take some minutes (run with -f to disable the execution).", NEWLINE=True)
                let build_subtype: str = self.name.replace("build_", "")
                let rc: int = shell: cd /tmp && echo check_run_test_programs_log | Ccontext -b "TACT.TACT_CONFIG.{baseline}" -e "{build_subtype}" 2>&1
        else:
            # what failed, each once: the log itself was printed, all but
            # its INFORMATION lines -- the same messages once per sub-build
            var log: TestProgramsLog = TestProgramsLog(logfile)
            log.changes = changes
            log.no_changes = no_changes
            print emacs_link(logfile)
            for line in log.summary(1000 if verbose else 5):
                print "  " + line

def grep_force_trace_in_dir(dir: Path):
    """Grep for missing 'if Debug.Trace' guards in LO build logs."""
    if not -d dir:
        puts("SWb", "WARNING: '" + dir + "' does not exist!", NEWLINE=True)
        return
    puts("SWb", "Grep in " + dir + " to detect missing 'if Debug.Trace (...) then' (100 first errors, no matches means no errors detected):", NEWLINE=True)
    let r = shell: for f in {dir}/*_out_*; do [ -e "$f" ] && grep -H -n -B1 '!!! ERROR : FORCE_TRACE message above' "$f" | grep -v '^--[[:space:]]*$'; done | head -n 100
    if r.output.strip() != "":
        print r.output.rstrip("\n")

# ---------------------------------------------------------------------------
# Baselines
# ---------------------------------------------------------------------------

def build_env_id(env_id: str, btype: BuildType) -> str:
    """ENV_ID -- $CM_ENV_ID, G!31.IP.L8 or G!31.OP.L8, whichever the tool
    was launched with -- made that of the build of BTYPE: G!31.OP.L8 for
    OP. The build type says which build's logs are read -- a replay's are
    always the OP build's, a Csystem log the IP build's -- not the
    environment it was launched in."""
    var built: str = env_id
    for other in BuildType:
        built = built.replace(f".{other}.", f".{btype}.")
    built

# where a baseline's replays leave their logs: in its OP build's saved_logs
let REPLAY_LOGS: Glob_T = "build_*OP*/saved_logs/Treplay_*.log"

class Baseline:
    """One TACT baseline: its number and the directory holding its builds.

    What most of this program does is compare a baseline with the one
    before it, and that is `bl.previous()` -- the number arithmetic and
    the directory it implies were rebuilt by hand at every call site.

    Its builds and replays are listed only when asked, by find_builds()
    and find_replays(): creating one lists nothing, so `previous()` costs
    nothing and cannot fail on a baseline whose directory is gone.

    """
    nr     : BaselineNr_T = "" # e.g. 30.0.0.121
    dir    : Path         = Path("")
    builds : []Build            # its build_G!* builds, once find_builds() has run
    # the build_G!* directories find_builds() set aside: a variant it skips
    # (92, 94, 95, 98, 30) or a name that says no IP, OP or SIP
    set_aside: []BuildName_T
    replays: []Replay           # its replays' logs, once find_replays() has run

    def __init__(self, nr: BaselineNr_T):
        self.nr = nr
        self.dir = TACT_ROOT / ("TACT_CONFIG." + nr)

    def previous(self) -> Baseline:
        let (head, tail) = self.nr.rsplit(".", 1)
        return Baseline(f"{head}.{int(tail) - 1}")

    def build(self, btype: BuildType) -> Build:
        """Its build of BTYPE, whichever build $CM_ENV_ID names, whether
        or not it is there."""
        Build("build_" + build_env_id($CM_ENV_ID, btype), btype, self.nr, self.dir)

    def compare_test_programs(self, older: Baseline, changes: {str}[]str, no_changes: str):
        """The summary of its IP build's check_run_test_programs.log, diffed
        with OLDER's: without the ediff links, whose files are named after
        a pid, and with the baseline numbers masked, so that only a change
        in what fails shows. Both say who changed the scripts per CHANGES,
        this baseline's, or NO_CHANGES why nothing does: a script new here
        comes with who changed it."""
        puts("SWr", f"Compare the check_run_test_programs.log summary with {older.nr}'s:", NEWLINE=True)
        let mine: ?Path = self.build(IP).test_programs_log()
        let theirs: ?Path = older.build(IP).test_programs_log()
        if mine is not None and theirs is not None:
            print "  " + emacs_link(theirs)
            var old_log: TestProgramsLog = TestProgramsLog(theirs)
            var new_log: TestProgramsLog = TestProgramsLog(mine)
            old_log.changes = changes
            old_log.no_changes = no_changes
            new_log.changes = changes
            new_log.no_changes = no_changes
            let before: []str = [masked(line) for line in old_log.summary(1000, links=False)]
            let after: []str = [masked(line) for line in new_log.summary(1000, links=False)]
            let changes: []str = diff_summaries(before, after)
            if len(changes) == 0:
                print "  the same summary"
            for line in changes:
                print "  " + line
        elif mine is None:
            print f"  none in {self.build(IP).dir}"
        else:
            print f"  none in {older.build(IP).dir}"

    def saved_logs_dir(self, btype: BuildType) -> Path:
        """The saved_logs directory of this baseline's build of BTYPE,
        whichever build $CM_ENV_ID names."""
        self.dir / ("build_" + build_env_id($CM_ENV_ID, btype)) / "saved_logs"

    def find_builds(self):
        """List the baseline's build_G!* directories into builds, as the
        builds they are."""
        let SKIP_BUILD_PATTERNS: []str = ["92", "94", "95", "98", "30"]
        let basedir: Path = self.dir
        let listing: []str = shellLines: ls -1d {basedir}/build_G!*
        self.builds = []
        self.set_aside = []
        for line in listing:
            continue if line == ""
            let basename: str = Path(line).name # e.g. build_G!31.IP.L8
            let bt: ?BuildType = build_type_from(basename)
            let skipped: bool = bt is None or any(pat in basename for pat in SKIP_BUILD_PATTERNS)
            if skipped:
                self.set_aside.append(basename)
            continue if bt is None
            continue if skipped
            self.builds.append(Build(basename, bt, self.nr, self.dir))

    def find_replays(self):
        """List the replays' logs into replays, one per replay type, in
        canonical order."""
        let basedir: Path = self.dir
        let listing: []str = shellLines: ls -d {basedir}/{REPLAY_LOGS}

        var type_to_file: [ReplayType]Path
        for found in listing:
            continue if found == ""
            let log: Path = Path(found)
            let rt: ?ReplayType = replay_type_from(log)
            continue if rt is None
            type_to_file[rt] = log

        self.replays = []
        for rtype, filepath in enumerate(type_to_file):
            continue if filepath == ""
            self.replays.append((rtype: rtype, file: filepath))

    def replay_log_dir(self, rtype: ReplayType) -> Path | !Failure_T:
        """The newest replay log dir of RTYPE, from this baseline backwards.

        Replays run on the OP build, so that is the saved_logs searched.
        """
        let wanted: Glob_T = f"replay_dir*{replay_dir_pattern(rtype)}*/work/logging/LOGS"
        var bl: Baseline = self
        for attempt in range(20):
            if attempt > 0:
                bl = bl.previous()
            let dir: Path = bl.saved_logs_dir(OP)
            let listing: []str = shellLines: ls -d {dir}/{wanted}
            if listing'Length > 0 and listing[0] != "":
                return Path(listing[0])
        # what was looked for, and how far back: it said "trying <dir>"
        # for each of the twenty, and then only that none was found
        return Failure_T(message=f"no {rtype} replay dir: no {self.saved_logs_dir(OP)}/{wanted}, nor in the baselines before, back to {bl.nr}")

    def scan_regression_tests(self, btype: BuildType, subtype: BuildSubtype) -> Path | !Failure_T:
        """Scan the logs of the BTYPE build's SUBTYPE regression tests for errors
        and core dumps; the report, normalized for diffing."""
        # saved_logs_dir(btype) is already the BTYPE build. This used to rewrite
        # "OP" to "IP" (or back) across the whole path string as well, which was
        # a no-op on a real TACT path and mangled any other: a checkout under
        # .../ADASCRIPT/... came out as .../ADASCROPT/... for an OP scan.
        let sl: str = subtype_label(subtype)
        var log_dir: Path = Path("")
        let work: Path = self.saved_logs_dir(btype) / "tacot_corico.LATEST" / "work" / ("logging-" + sl)
        case subtype:
            when mono:
                log_dir = work / "LOGS_mono"
            when others:
                log_dir = work / "LOGS_others"
        return Failure_T(message="log dir does not exist: " + log_dir) if not -d log_dir
        puts("USBy", "scanning " + log_dir, NEWLINE=True)
        let tacot_root: Path = log_dir.parent.parent.parent
        find_core_dumps(tacot_root)
        var report: str = ""
        case subtype:
            when mono:
                let mono_out: Path = log_dir / "mono.out"
                if -f mono_out:
                    let hits: str = grep_logfile(mono_out)
                    report = hits
            when others:
                let out_files: []str = shellLines: ls {log_dir}/*1_out_01
                for f in out_files:
                    continue if f == ""
                    hr('#')
                    puts("SWb", Path(f).name, NEWLINE=True)
                    hr('#')
                    let hits: str = grep_logfile(Path(f))
                    if hits != "":
                        report = report + "##### " + Path(f).name + " #####\n" + hits + "\n"
        return make_report(report, self.nr, "regression_" + btype'Image + "_" + sl)

    def show_failed_tests(self, btype: BuildType, subtype: BuildSubtype, n_baselines: int = 15) -> str:
        """The BTYPE SUBTYPE tests failing in this baseline and the N_BASELINES - 1
        before it, printed and returned."""
        var baseline: Baseline = self
        let sl: str = subtype_label(subtype)
        var result: str = ""
        for iteration in range(n_baselines):
            let bl: BaselineNr_T = baseline.nr
            let header: str = f"FAILED {btype} REGRESSION TESTS logging-{sl} for BASELINE {bl}"
            hr('-')
            puts("SWr", header, NEWLINE=True)
            result = result + header + "\n"
            # the build the results are of: mono runs in IP, assert in OP,
            # in in the build asked for
            var build: BuildType = btype
            var suffix: str = "failed-in"
            case subtype:
                when mono:
                    build = IP
                    suffix = "failed-mono"
                when assert_test:
                    build = OP
                    suffix = "failed-assert"
                when others: pass
            let env: str = build_env_id($CM_ENV_ID, build)
            let r = shell: nl {TACT_ROOT}/test_reports/TACT.TACT_CONFIG.{bl}-{env}*/general.results.{suffix}
            if r.output.strip() != "":
                print r.output.rstrip("\n")
                result = result + r.output
            baseline = baseline.previous()
        return result

def grep_logfile(filepath: Path, max_errors: Positive = 100) -> str:
    # No `2>/dev/null` on any of these: a capturing shell keeps the two
    # streams apart, so what rg says about a file it cannot read is in
    # r.stderr and never in r.output. A missing log is the ordinary case
    # here, which is why the redirect was on every line to begin with.
    let r = shell(join = ";"):
        rg -l analyze_core {filepath}
        rg FATAL {filepath} | head -{max_errors}
        rg 'SEVERE.*Description' {filepath} | head -{max_errors}
        pyrg RAISED_EXCEPTION {filepath} | head -100
        pyrg EDIFF_FILES {filepath} | head -100
    let output: str = r.output.strip()
    if output != "":
        print output
    return output

# ---------------------------------------------------------------------------
# Tests: ady2nim c LIBS/baselines.ady && LIBS/baselines
# The real Tlog and replay logs are in test/samples, beside LIBS/.
# ---------------------------------------------------------------------------

if __name__ == "__main__":
    let samples: Path = Path($0).parent.parent / "test" / "samples"
    let tmp: Path = Path(run(["mktemp", "-d", "-t", "baselines.XXXXXX"]).output.strip())
    let PREQUAL: str = "Treplay_G31.OP.L8_30.0.0.133_2026.09.23_213300-run_prequal.NJrqM.log"
    let PERFORMANCE: str = "Treplay_G31.OP.L8_30.0.0.133_2026.09.23_213146-performance.MOJ0V.log"

    # --- a build's test programs: the real log, as build_info printed it -------
    let programs: TestProgramsLog = TestProgramsLog(samples / "check_run_test_programs.log")
    assert programs.verdict == [
        "Ccheck_build_closure -s -t -b ELD.ELD_CONFIG.30.0.0.132 failed with exit code 1",
        "Ccheck_build_closure -s -t -b TACT.UIF.30.0.0.132 failed with exit code 1",
        "Test failed because one or more Ccheck_build_closure calls failed (last failure was Ccheck_build_closure -s -t -b TACT.UIF.30.0.0.132 failed with exit code 1",
        "There are KSH-style errors reported.",
        "There are docgen errors reported."]
    # each once, though COMMON_CONFIG's is in the log twice
    assert [d.component + " " + d.check for d in programs.style_diffs] == [
        "COMMON_CONFIG VAR_CHECK", "ELD_CONFIG STABLE_CHECKS", "ELD_CONFIG VAR_CHECK", "ADA_PRIM VAR_CHECK",
        "TACOT_SCR STABLE_CHECKS", "TACOT_SCR VAR_CHECK", "TACT_CONFIG VAR_CHECK"]
    assert programs.style_diffs[0].ediff.startswith("(ediff-files \"/cm/ot/TOOL/COMMON_CONFIG.30.0.0.105/")
    assert [e.program + " " + str(e.count) for e in programs.errors] == [
        "param_shared_cleanup_ftok 3", "check_result_equal_template 2", "check_oracle_and_perl 2"]
    assert programs.errors[0].first.startswith("dbspy -D ./env_imp_regress/1.545.cpg/NUM_MESSAGES.ftok failed")
    # the %see line is in twice, and counted once
    assert len(programs.docgen) == 10 and programs.docgen[0].startswith("block not included: tacot.tact.flight")
    assert len(programs.missing) == 1 and programs.missing[0].startswith("ldd: /cm/ot/TOOL/PERL.30.0.0.14/")
    let summed: []str = programs.summary(2, read_results=False)
    assert summed[5] == "7 ksh style differences with the previous baseline:"
    assert summed[13] == "  3 SEVERE from param_shared_cleanup_ftok: dbspy -D ./env_imp_regress/1.545.cpg/NUM_MESSAGES.ftok failed with exit code 42 : dbspy: file ./env_imp_regress/1.545.cpg/NUM_MESSAGES.ftok cannot be opened"
    assert summed[16] == "10 docgen errors:" and summed[19] == "  ... and 8 more"
    assert len(summed) == 21

    # --- the summary, diffed with another baseline's ----------------------
    assert masked("Ccheck_build_closure -s -t -b ELD.ELD_CONFIG.30.0.0.132 failed") == "Ccheck_build_closure -s -t -b ELD.ELD_CONFIG.<nr> failed"
    assert programs.summary(2, read_results=False, links=False)[6] == "  COMMON_CONFIG VAR_CHECK"
    let summed_before: []str = ["2 ksh style differences with the previous baseline:",
        "  COMMON_CONFIG VAR_CHECK", "    ./a.ksh  new used not defined: X",
        "  ELD_CONFIG VAR_CHECK", "    ./b.ksh  new used not defined: Y",
        "  1 SEVERE from p: gone since"]
    let summed_after: []str = ["2 ksh style differences with the previous baseline:",
        "  COMMON_CONFIG VAR_CHECK", "    ./a.ksh  new used not defined: X", "    ./c.ksh  new used not defined: Z",
        "  TACT_CONFIG VAR_CHECK", "    ./d.ksh  new used not defined: W"]
    assert diff_summaries(summed_before, summed_before) == []
    # who changed a script: under it; the same line under another script is
    # another line
    let attributed_before: []str = ["  A", "    ./a.ksh", "      not in the changes report"]
    let attributed_after: []str = ["  A", "    ./a.ksh", "      not in the changes report",
        "    ./b.ksh", "      not in the changes report", "    ./c.ksh", "      changed by x.y: 1a SC-1"]
    assert diff_summaries(attributed_before, attributed_after) == [
        "  " + "  A", "+     ./b.ksh", "+       not in the changes report",
        "+     ./c.ksh", "+       changed by x.y: 1a SC-1"]
    # the same script line, under another style difference: a change
    assert diff_summaries(["  A", "    ./a.ksh"], ["  A", "  B", "    ./a.ksh"]) == ["+   B", "+     ./a.ksh", "  " + "  A", "-     ./a.ksh"]
    # a new script under a style difference both have: that one, unmarked, above it
    assert diff_summaries(summed_before, summed_after) == [
        "  " + "  COMMON_CONFIG VAR_CHECK", "+     ./c.ksh  new used not defined: Z",
        "+   TACT_CONFIG VAR_CHECK", "+     ./d.ksh  new used not defined: W",
        "-   ELD_CONFIG VAR_CHECK", "-     ./b.ksh  new used not defined: Y",
        "-   1 SEVERE from p: gone since"]

    # --- the scripts a style difference is in: a real result, and a baseline
    # made from it by hand --------------------------------------------------
    assert style_kind("The following variables seem to be used not defined:") == "used not defined"
    assert style_kind("default define_configuration var assigned, it is likely a bug:") == "default define_configuration var assigned"
    let result_file: Path = samples / "COMMON_CONFIG.RESULT.VAR_CHECK"
    let baseline_file: Path = samples / "COMMON_CONFIG.BASELINE.RESULT.VAR_CHECK.txt"
    let findings: []StyleFinding = style_findings(result_file)
    assert len(findings) == 25
    assert findings[0] == StyleFinding("./generated/application_profile.ksh", "used not defined", "NEW_PATH")
    assert findings[9] == StyleFinding("./sources/find_current_ops_testing.ksh", "default define_configuration var assigned", "CONFIGURATION_TYPE")
    assert ediff_files(programs.style_diffs[0].ediff) == [
        Path("/cm/ot/TOOL/COMMON_CONFIG.30.0.0.105/build_G.31.IP.L8/sources/test/new_COMMON_CONFIG_style_errors_test.BASELINE.RESULT.VAR_CHECK.txt"),
        Path("/cm/ot/TOOL/COMMON_CONFIG!30.0.0.105/build_G!31.IP.L8/user_output/KSH_STYLE_SCANNER/COMMON_CONFIG.RESULT.VAR_CHECK.25367")]
    assert ediff_files("(ediff-files \"a\")") == []
    # cfmu_ops_branch_setup.ksh's two findings are the other way round: no change
    let changes: []ScriptChange = changed_scripts(baseline_file, result_file)
    assert changes == [
        ScriptChange("./sources/find_current_ops.ksh", ["used not defined: CFMU_REGRESS_TEST_FTPS_DIR"], []),
        ScriptChange("./sources/regression_testing.ksh", ["used not defined: CM_HOST PERL_VERSION"], ["defined not used: OLD_WORK_DIR"])]
    assert changed_scripts(result_file, result_file) == []
    let style_diff: StyleDiff = StyleDiff("COMMON_CONFIG", "VAR_CHECK", "(ediff-files \"" + baseline_file + "\" \"" + result_file + "\")")
    let nobody: {str}[]str = {:}
    let lines: []str = script_lines(style_diff, nobody)
    assert lines == [
        "    \x1b[1;33m./sources/find_current_ops.ksh\x1b[0m  new used not defined: CFMU_REGRESS_TEST_FTPS_DIR",
        "    \x1b[1;33m./sources/regression_testing.ksh\x1b[0m  new used not defined: CM_HOST PERL_VERSION; gone defined not used: OLD_WORK_DIR"]
    # under each, who changed it, per the changes report; that nobody did
    var changed: {str}[]str = {:}
    changed["COMMON_CONFIG/sources/regression_testing.ksh"] = ["changed by abc.fix_env: 1a2b3c SC-1"]
    assert script_lines(style_diff, changed) == [lines[0], "      not in the changes report",
        lines[1], "      changed by abc.fix_env: 1a2b3c SC-1"]

    # --- a build's type, from its directory's name ----------------------------
    def build_type(name: BuildName_T) -> str:
        let bt: ?BuildType = build_type_from(name)
        return "none" if bt is None
        return f"{bt}"
    assert build_type("build_G!31.IP.L8") == "IP"
    assert build_type("build_G!31.OP.L8") == "OP"
    assert build_type("build_default_Linux") == "none"

    # --- the build of a type, whichever $CM_ENV_ID names ----------------------
    for launched in ["G!31.IP.L8", "G!31.OP.L8", "G!31.SIP.L8"]:
        assert build_env_id(launched, IP) == "G!31.IP.L8"
        assert build_env_id(launched, OP) == "G!31.OP.L8"
        assert build_env_id(launched, SIP) == "G!31.SIP.L8"

    # --- a baseline, and what it holds --------------------------------------
    let bl: Baseline = Baseline("30.0.0.133")
    assert bl.previous().nr == "30.0.0.132"
    assert bl.dir == TACT_ROOT / "TACT_CONFIG.30.0.0.133"

    # its builds and replays, in a baseline directory made here
    var here: Baseline = Baseline("30.0.0.133")
    here.dir = tmp / "TACT_CONFIG.30.0.0.133"
    for name in ["build_G!31.IP.L8", "build_G!31.OP.L8", "build_G!92.IP.L8", "build_default_Linux"]:
        (here.dir / name / "saved_logs").mkdir()
    # the IP build has a Tlog, of 'in' for the normal pass
    let ip_tlog: Path = here.dir / "build_G!31.IP.L8" / "saved_logs" / "tacot_corico.LATEST" / "TACT_REGRESS_LOGS" / "LATEST" / "Tlog-in.log"
    ip_tlog.parent.mkdir()
    run(["cp", str(samples / "Tlog-in.log"), str(ip_tlog)])
    here.find_builds()
    assert [b.name for b in here.builds] == ["build_G!31.IP.L8", "build_G!31.OP.L8"]
    assert here.set_aside == ["build_G!92.IP.L8"]    # build_default_Linux is no build_G!*
    assert here.builds[1].btype == OP and here.builds[1].baseline_nr == "30.0.0.133"
    assert here.builds[0].tlog_path(in_test, normal) == ip_tlog
    # read when the build is found, and asked of it after
    assert [t.file for t in here.builds[0].tlogs] == [ip_tlog]
    assert len(here.builds[1].tlogs) == 0
    let in_tlog: ?Tlog = here.builds[0].tlog(in_test, normal)
    assert in_tlog is not None and in_tlog.reference == "30.0.0.131"
    assert here.builds[0].tlog(in_test, mrun) is None and here.builds[0].tlog(mono, normal) is None
    for name in [PERFORMANCE, PREQUAL]:
        run(["cp", str(samples / name), str(here.dir / "build_G!31.OP.L8" / "saved_logs")])
    here.find_replays()
    assert [r.rtype for r in here.replays] == [run_prequal, performance]   # in canonical order

    # what is not there: why, rather than an empty path
    let scanned: Path | !Failure_T = here.scan_regression_tests(IP, mono)
    assert scanned is Failure_T and scanned.message.startswith("log dir does not exist: ")
    # replay_log_dir looks back through the baselines before this one, in
    # the CM tree: asked of 30.0.0.133, it finds 30.0.0.132's replays on a
    # machine that has them. Asked of a baseline no CM tree holds.
    let nowhere: Baseline = Baseline("0.0.0.20")
    let replay_dir: Path | !Failure_T = nowhere.replay_log_dir(performance)
    assert replay_dir is Failure_T and replay_dir.message.startswith("no performance replay dir: no ") and replay_dir.message.endswith("/replay_dir*TAC_LO3*/work/logging/LOGS, nor in the baselines before, back to 0.0.0.1")

    run(["rm", "-rf", str(tmp)])
    print "baselines: all tests passed"
