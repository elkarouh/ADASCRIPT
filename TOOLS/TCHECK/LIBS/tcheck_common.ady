"""
tcheck_common — what every part of Tcheck_tact uses: the domain's named
types, colored output, the settings the command line gives, the CM tree,
the build enums, and the helpers several modules share. A leaf: it
nimports nothing of Tcheck_tact's.
"""

nimport os

# Why something the report looks for is not there: a log directory, a
# changes report. The report goes on without it, having said so.
type Failure_T is record:
    message: str

# ---------------------------------------------------------------------------
# The domain's values, named for what they are rather than how they are held
# ---------------------------------------------------------------------------
type BaselineNr_T   is str   # a baseline's number: 30.0.0.132
type BaselineName_T is str   # a baseline's full name: TACT.TACT_CONFIG.30.0.0.131, IFPS.CUA_IDL.30.0.0.122
type BuildName_T    is str   # a build's directory: build_G!31.IP.L8
type BuildLabel_T   is str   # a build type and subtype, as the report shows them: "IP in"
type TestName_T     is str   # a regression test: env_updates_prior_stop.1.el
type Ticket_T       is str   # an SC ticket: SC-134300
type Review_T       is str   # "dpt, gru on 260922.151702", "(review-ok: no)" after it if not ok
type NmFile_T       is str   # <system>/<subsystem>/<path>: a file, as the changes report names it
type InSub_T        is str   # a file's path in its submodule: sources/b.adb
type Extension_T    is str   # a file's extension, without the dot: adb; "" for none
type Rev_T          is str   # a git revision: c3fb81031^, a baseline's tag
type Link_T         is str   # an #emacs: link, clickable in the report's buffer
type Command_T      is str   # a shell command line
type Glob_T         is str   # a file-name pattern: build_G!31.*
type ColorSpec_T    is str   # a colour, as the ksh original spelled it: SWr
type Tool_T         is str   # a visual diff tool: meld, kompare

# ---------------------------------------------------------------------------
# ANSI color helpers
# ---------------------------------------------------------------------------
# The ksh version encodes colors as a spec string like "SWr" where:
#   Style:   S=bold(1) D=dim(2) I=italic(3) U=underline(4) F=blink(5) N=overline(7) H=hidden(8) T=strike(9)
#   Fg:      K=black(30) R=red(31) G=green(32) Y=yellow(33) B=blue(34) M=magenta(35) C=cyan(36) W=white(37)
#   Bg:      k=black(40) r=red(41) g=green(42) y=yellow(43) b=blue(44) m=magenta(45) c=cyan(46) w=white(47)

let ANSI_CODES: {char}str = {
    'S': "1", 'D': "2", 'I': "3", 'U': "4", 'F': "5", 'N': "7", 'H': "8", 'T': "9",
    'K': "30", 'R': "31", 'G': "32", 'Y': "33", 'B': "34", 'M': "35", 'C': "36", 'W': "37",
    'k': "40", 'r': "41", 'g': "42", 'y': "43", 'b': "44", 'm': "45", 'c': "46", 'w': "47"
}

var COLORED: bool = True
var BATCH: bool = False
# -tool NAME: the visual diff tool -- meld, kompare, kdiff3, ... With it
# (and not -batch) the list of changes links its diffs to NAME rather than
# to Emacs ediff; troubleshoot mode compares with it, meld when none is
# given. "" when none is.
var DIFF_TOOL: Tool_T = ""
var ONLY_NEW: bool = False
# Set by Build.show_tlog when a Tlog it shows reports a new or crashed test;
# read once at the end (Report.found_new_failures) for the exit status.
var HAS_NEW_FAILURES: bool = False

# The CM tree; overridable so the program can be run against a copy of one.
let CM_OT: Path = Path(${TCHECK_CM_OT:-"/cm/ot"})
let TACT_ROOT: Path = CM_OT / "TACT"

def ansi_escape(spec: ColorSpec_T) -> str:
    """Turn a color spec like 'sWr' into an ANSI escape sequence."""
    let codes: []str = [ANSI_CODES[ch] for ch in spec if ch in ANSI_CODES]
    return "\x1b[" + ";".join(codes) + "m" if codes else ""

def colored(spec: ColorSpec_T, text: str) -> str:
    """TEXT in the color given by SPEC, to stand out in a line; as it is
    when not COLORED."""
    const RESET: str = "\x1b[0m"
    return text if not COLORED
    ansi_escape(spec) + text + RESET

def puts(spec: ColorSpec_T, text: str, NEWLINE: bool = False):
    """Print TEXT in the color given by SPEC, without a trailing newline."""
    stdout.write(colored(spec, text))
    if NEWLINE:
        print

def hr(c: char = '#', length: int = 80):
    print c * length

# ---------------------------------------------------------------------------
# Build / subtype enums
# ---------------------------------------------------------------------------

type BuildSubtype is enum in_test, mono, assert_test, lo, hi, memcheck, with_secondary
type BuildType is enum IP, OP, SIP
type BuildPass is enum normal, mrun

def subtype_label(st: BuildSubtype) -> str:
    """The file-system name for a subtype ('in' not 'in_test')."""
    let name: str = st'Image
    name.replace("_test", "")

def parse_subtype(arg: str) -> BuildSubtype:
    """Parse a subtype name from a command-line argument."""
    for st in BuildSubtype:
        if subtype_label(st) == arg:
            return st
    die("invalid subtype: " + arg)

# ---------------------------------------------------------------------------
# Helpers used throughout
# ---------------------------------------------------------------------------

def newest(dir: Path, pattern: Glob_T) -> ?Path:
    """The most recently modified entry of DIR matching the glob PATTERN,
    if any does."""
    let found: []str = shellLines: ls -dt {!dir}/{pattern} 2>/dev/null | head -n 1
    return None if len(found) == 0 or found[0] == ""
    Path(found[0])

def warned(r: Path | !Failure_T) -> Path | !Failure_T:
    """R, its failure said first: what is missing is shown where it was
    looked for, and the report goes on without it."""
    if r is Failure_T:
        puts("SWb", r.message, NEWLINE=True)
    return r

def troubleshoot_tool() -> Tool_T:
    """What troubleshoot mode compares two files with: the -tool diff tool,
    or meld."""
    DIFF_TOOL if DIFF_TOOL != "" else "meld"

def emacs_link(filepath: Path) -> Link_T:
    """An #emacs: link that opens FILEPATH."""
    # Not an f-string: Emacs's adascript-mode loses track of the strings
    # after f"...#...\"...\"" once a # has been in a string or char before.
    "#emacs:(progn(find-file \"" + str(filepath) + "\"))"

def echo_emacs(filepath: Path):
    """Print an #emacs: link for FILEPATH."""
    puts("SBw", "Look for details in:", NEWLINE=True)
    print emacs_link(filepath)

def find_core_dumps(dir: Path):
    # find core files bigger than 600MB
    let r = shell: fd -l --size +600M core {dir}
    if r.output.strip() != "":
        puts("SWr", "CORE DUMPS:", NEWLINE=True)
        print r.output.rstrip("\n")

def make_report(content: str, bl: BaselineNr_T, report_name: str) -> Path:
    let rc0: int = shell: mkdir -p /tmp/reports
    let report_file: Path = Path("/tmp/reports") / (report_name + "_" + bl + ".txt")
    writeFile(report_file, content)
    let rc: int = shell: make_comparable {report_file} {bl} 2>/dev/null
    return report_file

# ---------------------------------------------------------------------------
# Tests: ady2nim -r LIBS/tcheck_common.ady
# ---------------------------------------------------------------------------

if __name__ == "__main__":
    # a color spec: its letters' codes in order, an unknown letter skipped
    assert ansi_escape("SWr") == "\x1b[1;37;41m"
    assert ansi_escape("Kx") == "\x1b[30m"
    assert ansi_escape("") == ""
    assert colored("SC", "./a.ksh") == "\x1b[1;36m./a.ksh\x1b[0m"

    # a subtype by its name on disk and on the command line: 'in', not 'in_test'
    assert subtype_label(in_test) == "in"
    assert subtype_label(assert_test) == "assert"
    assert subtype_label(mono) == "mono"
    for st in BuildSubtype:
        assert parse_subtype(subtype_label(st)) == st

    # troubleshoot mode compares with the -tool diff tool, else meld
    assert troubleshoot_tool() == "meld"
    DIFF_TOOL = "kompare"
    assert troubleshoot_tool() == "kompare"
    DIFF_TOOL = ""

    # newest: the latest entry matching the glob; None when none does
    let dir: Path = Path(run(["mktemp", "-d", "-t", "tcheck_common.XXXXXX"]).output.strip())
    run(["touch", "-d", "2026-01-01", str(dir / "build_old")])
    run(["touch", "-d", "2026-02-01", str(dir / "build_new")])
    run(["touch", str(dir / "other")])
    let latest: ?Path = newest(dir, "build_*")
    assert latest is not None and latest == dir / "build_new"
    assert newest(dir, "none_*") is None
    run(["rm", "-rf", str(dir)])

    print "tcheck_common: all tests passed"
