#!/usr/bin/env ady2nim
#ady2nim-args c -d:release
"""Ttroubleshoot — troubleshoot TACT baseline builds.

Scans regression test logs, replay logs, and build closure logs for a
baseline, comparing current and previous baselines side by side.

Translated from hek-troubleshoot.sh. Shares types and helpers with
Tcheck_tact.ady for an eventual merge.
"""

nimport os

# ---------------------------------------------------------------------------
# ANSI color helpers (shared with Tcheck_tact)
# ---------------------------------------------------------------------------

let ANSI_CODES: {str}str = {
    "S": "1", "D": "2", "I": "3", "U": "4", "F": "5", "N": "7", "H": "8", "T": "9",
    "s": "1", "d": "2", "i": "3", "u": "4", "f": "5", "n": "7", "h": "8", "t": "9",
    "K": "30", "R": "31", "G": "32", "Y": "33", "B": "34", "M": "35", "C": "36", "W": "37",
    "k": "40", "r": "41", "g": "42", "y": "43", "b": "44", "m": "45", "c": "46", "w": "47"
}
let RESET: str = "\x1b[0m"
var COLORED: bool = False

def ansi_escape(spec: str) -> str:
    var codes: []str = []
    for ch in spec:
        let s: str = str(ch)
        if s in ANSI_CODES:
            codes.append(ANSI_CODES[s])
    if codes'Length == 0:
        return ""
    return "\x1b[" + ";".join(codes) + "m"

def cecho(spec: str, text: str):
    if COLORED:
        print ansi_escape(spec) + text + RESET
    else:
        print text

def cechon(spec: str, text: str):
    if COLORED:
        stdout.write(ansi_escape(spec) + text + RESET)
    else:
        stdout.write(text)

def hr(c: char = '#', length: int = 80):
    print c * length

def echo_emacs(filepath: str):
    cecho("sBw", "Look for details in:")
    print f"#emacs:(progn(find-file \"{filepath}\"))"

# ---------------------------------------------------------------------------
# Enums (shared with Tcheck_tact)
# ---------------------------------------------------------------------------

type BuildSubtype is enum in_test, mono, assert_test, lo, hi, memcheck, with_secondary
type BuildType is enum IP, OP, SIP
type BuildPass is enum normal, mrun
type ReplayType is enum run_prequal, performance, simca, full_simca, oldest_date, all_autolink

type Build is tuple:
    name  : str
    btype : BuildType

def subtype_label(st: BuildSubtype) -> str:
    let name: str = st'Image
    return name.replace("_test", "")

# ---------------------------------------------------------------------------
# Baseline arithmetic
# ---------------------------------------------------------------------------

def previous_baseline_nr(baseline: str) -> str:
    """previous_baseline_nr("28.0.0.432") -> "28.0.0.431" """
    let parts: []str = baseline.split(".")
    let release: int = int(parts[-1])
    let main: str = ".".join(parts[0:-1])
    return main + "." + str(release - 1)

def baseline_from_context() -> str:
    """Extract the short baseline from $CONTEXT_CM_BASELINE.

    TACT.TACT_CONFIG.30.0.0.129 -> 30.0.0.129
    """
    let ctx: str = $CONTEXT_CM_BASELINE
    if ctx == "":
        die("no baseline given and CONTEXT_CM_BASELINE is not set")
    let parts: []str = ctx.split(".")
    if parts'Length < 3:
        die("cannot parse CONTEXT_CM_BASELINE: " + ctx)
    return ".".join(parts[2:])

def basedir_for(baseline: str) -> Path:
    return Path("/cm/ot/TACT/TACT_CONFIG." + baseline)

def saved_logs_dir(baseline: str, btype: BuildType) -> str:
    """The saved_logs directory for a baseline and build type.

    $CM_ENV_ID is e.g. G!31.IP.L8; replace the IP/OP part to match btype.
    """
    var env_id: str = $CM_ENV_ID
    case btype:
        when IP:  env_id = env_id.replace(".OP.", ".IP.")
        when OP:  env_id = env_id.replace(".IP.", ".OP.")
        when SIP: env_id = env_id.replace(".IP.", ".SIP.")
    return str(basedir_for(baseline)) + "/build_" + env_id + "/saved_logs"

def compute_baseline_prevdir(cur_dir: str) -> str:
    """Decrement the release number and replace dated tacot_corico with .LATEST."""
    let parts: []str = cur_dir.split("/")
    var new_parts: []str = []
    for part in parts:
        if part.startswith("TACT_CONFIG."):
            var config_parts: []str = part.split(".")
            let release: int = int(config_parts[-1])
            config_parts[-1] = str(release - 1)
            new_parts.append(".".join(config_parts))
        elif part.startswith("tacot_corico_"):
            new_parts.append("tacot_corico.LATEST")
        else:
            new_parts.append(part)
    return "/".join(new_parts)

# ---------------------------------------------------------------------------
# Log scanning
# ---------------------------------------------------------------------------

def grep_logfile(filepath: str, max_errors: Positive = 100) -> str:
    """Grep a log file for key error patterns. Prints and returns the matches (max 100 lines per pattern)."""
    # The subshell was there to carry one `2>/dev/null` for the group; a
    # capturing shell keeps the streams apart on its own, so neither is
    # needed and the block form says the same thing in five lines.
    let r = shell(join = ";"):
        rg -l analyze_core {filepath}
        rg FATAL {filepath} | head -{max_errors}
        rg 'SEVERE.*Description' {filepath} | head -{max_errors}
        pyrg RAISED_EXCEPTION {filepath} | head -100
        pyrg EDIFF_FILES {filepath} | head -100
    let output: str = r.output.strip()
    if output != "":
        print output
    return output

def find_core_dumps(dir: str):
    """Find core files larger than 600M in a directory."""
    let r = shell: fdcore {dir}
    if r.output.strip() != "":
        cecho("sWr", "CORE DUMPS:")
        print r.output.rstrip("\n")

def make_report(content: str, baseline: str, report_name: str) -> str:
    """Write content to a report file and run make_comparable.ksh on it."""
    let rc0: int = shell: mkdir -p /tmp/reports
    let report_file: str = "/tmp/reports/" + report_name + "_" + baseline + ".txt"
    writeFile(report_file, content)
    let rc: int = shell: make_comparable.ksh {report_file} {baseline} 2>/dev/null
    return report_file

def process_system_build_log(subsystem: str, build_name: str):
    let file: str = subsystem + "/" + build_name + "/Csystem_build.log"
    if not -f Path(file):
        return
    stdout.write("\t")
    print "processing " + file
    let r = shell: grep -E '(SEVERE|FATAL) : Error' {file}
    if r.output.strip() != "":
        var seen: {}str = {}
        for line in r.output.split("\n"):
            continue if line in seen
            seen.add(line)
            print line
        stdout.write("\t")
        echo_emacs(file)
        print ""
    else:
        print "\t\t-->   NO FATAL OR SEVERE ERROR"

def process_run_test_programs(subsystem: str, build_name: str):
    let file: str = subsystem + "/" + build_name + "/run_test_programs.log"
    if not -f Path(file):
        return
    let content: str = readFile(file)
    if "Test statistics :" not in content:
        return
    stdout.write("\t")
    print "processing " + file
    let r = shell: grep -o -P '(?<=Test statistics : )[1-9][0-9]* failed.*' {file}
    if r.output.strip() != "":
        stdout.write("\t\t-->   ")
        print r.output.strip()
        stdout.write("\t\t-->   ")
        echo_emacs(file)
        let fatals = shell: grep -E 'FATAL : Error' {file}
        if fatals.output.strip() != "":
            var seen: {}str = {}
            for line in fatals.output.split("\n"):
                continue if line in seen
                seen.add(line)
                print line
    else:
        stdout.write("\t\t-->   ")
        print "ALL TESTS SUCCESSFUL"

def check_build_closure(baseline: str):
    let basedir: Path = basedir_for(baseline)
    if not -d basedir:
        cecho("sWb", "DIR " + str(basedir) + " does not exist")
        return
    cecho("sWr", "CHECK BUILD CLOSURE")
    let subsystems: []str = shellLines: echo {basedir} | Psort
    let build_listing: []str = shellLines: ls -1d {basedir}/build_G!*
    var builds: []str = []
    for line in build_listing:
        continue if line == ""
        builds.append(Path(line).name)
    for subsystem in subsystems:
        continue if subsystem == ""
        for build_name in builds:
            process_system_build_log(subsystem, build_name)
            process_run_test_programs(subsystem, build_name)
            break
        print ""

# ---------------------------------------------------------------------------
# Replay troubleshooting
# ---------------------------------------------------------------------------

def replay_dir_pattern(replay_type: str) -> str:
    """Map a replay type name to the directory pattern used on disk."""
    case replay_type:
        when "performance": return "TAC_LO3"
        when "prequal":     return "run_prequal"
        when others:        return replay_type

def get_replay_log_dir(build_dir: str, replay_type: str) -> str:
    """Find the replay LOGS directory, searching backwards through baselines."""
    let dir_pat: str = replay_dir_pattern(replay_type)
    var dir: str = build_dir
    var attempts: int = 0
    while attempts < 20:
        let listing: []str = shellLines: ls -d {dir}/replay_dir*{dir_pat}*/work/logging/LOGS
        if listing'Length > 0 and listing[0] != "":
            return listing[0]
        dir = compute_baseline_prevdir(dir)
        stderr.writeLine(PROG + ": trying " + dir)
        attempts += 1
    return ""

def scan_replay_dir(replay_log_dir: str, baseline: str, replay_type: str) -> str:
    """Scan a replay log directory and write a comparable report. Returns the report path."""
    if replay_log_dir == "":
        cecho("sWb", "no replay log dir found")
        return ""
    cecho("usBy", "REPLAY DIR: " + replay_log_dir)
    # Check for core dumps in the replay_dir (three levels up from LOGS).
    let replay_root: str = str(Path(replay_log_dir).parent.parent.parent)
    find_core_dumps(replay_root)
    # Collect report content.
    var report: str = ""
    let check_result: []str = shellLines: ls {replay_log_dir}/*check_logs.result.svlog
    for f in check_result:
        continue if f == ""
        cecho("sWb", "check_logs.result.svlog:")
        let content: str = readFile(f)
        print content
        report = report + content + "\n"
    let check_run: []str = shellLines: ls {replay_log_dir}/*check_logs.run.svlog
    for f in check_run:
        continue if f == ""
        cecho("sWb", "check_logs.run.svlog:")
        let content: str = readFile(f)
        print content
        report = report + content + "\n"
    return make_report(report, baseline, f"replay-{replay_type}")

# ---------------------------------------------------------------------------
# Regression test scanning
# ---------------------------------------------------------------------------

def scan_regression_tests(build_dir: str, btype: BuildType, subtype: BuildSubtype, baseline: str) -> str:
    """Scan regression test logs and write a comparable report. Returns the report path."""
    var dir: str = build_dir
    case btype:
        when IP: dir = dir.replace("OP", "IP")
        when OP: dir = dir.replace("IP", "OP")
        when others: pass

    let sl: str = subtype_label(subtype)
    var log_dir: str = ""
    case subtype:
        when mono:
            log_dir = dir + "/tacot_corico.LATEST/work/logging-" + sl + "/LOGS_mono"
        when others:
            log_dir = dir + "/tacot_corico.LATEST/work/logging-" + sl + "/LOGS_others"

    if not -d Path(log_dir):
        cecho("sWb", "log dir does not exist: " + log_dir)
        return ""

    cecho("usBy", "scanning " + log_dir)
    # Check for core dumps three levels up (tacot_corico root).
    let tacot_root: str = str(Path(log_dir).parent.parent.parent)
    find_core_dumps(tacot_root)
    # Collect report content.
    var report: str = ""
    case subtype:
        when mono:
            let mono_out: str = log_dir + "/mono.out"
            if -f Path(mono_out):
                let hits: str = grep_logfile(mono_out)
                report = hits
        when others:
            let out_files: []str = shellLines: ls {log_dir}/*1_out_01
            for f in out_files:
                continue if f == ""
                hr("#")
                cecho("sWb", Path(f).name)
                hr("#")
                let hits: str = grep_logfile(f)
                if hits != "":
                    report = report + "##### " + Path(f).name + " #####\n" + hits + "\n"
    return make_report(report, baseline, "regression_" + btype'Image + "_" + sl)

def show_failed_tests(build_dir: str, btype: BuildType, subtype: BuildSubtype, n_baselines: int = 15) -> str:
    """Show and return failed test lists for the last N baselines."""
    var dir: str = build_dir
    case btype:
        when IP: dir = dir.replace("OP", "IP")
        when OP: dir = dir.replace("IP", "OP")
        when others: pass

    var baseline: str = ""
    for part in dir.split("/"):
        if part.startswith("TACT_CONFIG."):
            baseline = part.replace("TACT_CONFIG.", "")
            break

    let sl: str = subtype_label(subtype)
    var ip_env: str = $CM_ENV_ID
    var op_env: str = ip_env.replace(".IP.", ".OP.")
    ip_env = ip_env.replace(".OP.", ".IP.")
    var result: str = ""
    for iteration in range(n_baselines):
        let header: str = f"FAILED {btype'Image} REGRESSION TESTS logging-{sl} for BASELINE {baseline}"
        hr("-")
        cecho("sWr", header)
        result = result + header + "\n"
        var env: str = ip_env
        var suffix: str = "failed-in"
        case subtype:
            when mono:
                env = ip_env
                suffix = "failed-mono"
            when in_test:
                case btype:
                    when IP:  env = ip_env
                    when OP:  env = op_env
                    when others: pass
                suffix = "failed-in"
            when assert_test:
                env = op_env
                suffix = "failed-assert"
            when others: pass
        let r = shell: nl /cm/ot/TACT/test_reports/TACT.TACT_CONFIG.{baseline}-{env}*/general.results.{suffix}
        if r.output.strip() != "":
            print r.output.rstrip("\n")
            result = result + r.output
        baseline = previous_baseline_nr(baseline)
    return result

# ---------------------------------------------------------------------------
# Options and main
# ---------------------------------------------------------------------------

def usage():
    print f"Usage: {PROG} <mode> [options] [<BASELINE>]"
    print ""
    print "  BASELINE is e.g. 30.0.0.129. If omitted, derived from $CONTEXT_CM_BASELINE."
    print ""
    print "Modes:"
    print "  build_info               Compare Csystem_build.log and check build closure"
    print "  ip <subtype>                    Troubleshoot IP regression tests (in, mono)"
    print "  op <subtype>                    Troubleshoot OP regression tests (in, assert)"
    print "  replay <replay-type>            Troubleshoot replays (prequal, performance, simca, full_simca)"
    quit(1)

def parse_baseline(args: []str, first_positional: int) -> str:
    if args'Length > first_positional:
        return args[first_positional]
    return baseline_from_context()

def parse_subtype(arg: str, valid: []str) -> BuildSubtype:
    """Parse a subtype name from the command line."""
    for st in BuildSubtype:
        if subtype_label(st) == arg:
            return st
    die("invalid subtype: " + arg + " (expected " + ", ".join(valid) + ")")

def show_detailed_build_info(baseline: str):
    let prev_baseline: str = previous_baseline_nr(baseline)
    let cur_build: str = saved_logs_dir(baseline, IP).replace("/saved_logs", "")
    let prev_build: str = saved_logs_dir(prev_baseline, IP).replace("/saved_logs", "")
    let prev_log: str = prev_build + "/Csystem_build.log"
    let cur_log: str = cur_build + "/Csystem_build.log"
    cecho("sWr", "Compare Csystem_build.log:")
    print "  prev: " + prev_log
    print "  cur:  " + cur_log
    let rc: int = shell: hcmp {prev_log} {cur_log}
    check_build_closure(baseline)

def show_detailed_regression_tests(baseline: str, btype: BuildType, subtype: BuildSubtype):
    let prev_baseline: str = previous_baseline_nr(baseline)
    let cur_dir: str = saved_logs_dir(baseline, btype)
    let prev_dir: str = saved_logs_dir(prev_baseline, btype)
    let prev_report: str = scan_regression_tests(prev_dir, btype, subtype, prev_baseline)
    let cur_report: str = scan_regression_tests(cur_dir, btype, subtype, baseline)
    if prev_report != "" and cur_report != "":
        let meld_rc: int = shell: meld {prev_report} {cur_report} &
    let failed_file: str = "/tmp/reports/failed_tests"
    let failed_output: str = show_failed_tests(cur_dir, btype, subtype)
    writeFile(failed_file, failed_output)
    let emacs_rc: int = shell: emacs {!failed_file} &

def show_detailed_replays(baseline: str, replay_type: str):
    let prev_baseline: str = previous_baseline_nr(baseline)
    let cur_dir: str = saved_logs_dir(baseline, OP)
    let prev_dir: str = saved_logs_dir(prev_baseline, OP)
    let prev_log: str = get_replay_log_dir(prev_dir, replay_type)
    let cur_log: str = get_replay_log_dir(cur_dir, replay_type)
    let prev_report: str = scan_replay_dir(prev_log, prev_baseline, replay_type)
    let cur_report: str = scan_replay_dir(cur_log, baseline, replay_type)
    if prev_report != "" and cur_report != "":
        let meld_rc: int = shell: meld {prev_report} {cur_report} &

def run():
    let args: []str = $@
    if args'Length == 0:
        usage()

    let mode: str = args[0]

    case mode:
        when "build_info":
            show_detailed_build_info(parse_baseline(args, 1))

        when "ip":
            if args'Length < 2:
                die("ip mode requires a subtype (in, mono)")
            let subtype: BuildSubtype = parse_subtype(args[1], ["in", "mono"])
            show_detailed_regression_tests(parse_baseline(args, 2), IP, subtype)

        when "op":
            if args'Length < 2:
                die("op mode requires a subtype (in, assert)")
            let subtype: BuildSubtype = parse_subtype(args[1], ["in", "assert"])
            show_detailed_regression_tests(parse_baseline(args, 2), OP, subtype)

        when "replay":
            if args'Length < 2:
                die("replay mode requires a type (prequal, performance, simca, full_simca)")
            let REPLAY_NAMES: []str = ["prequal", "performance", "simca", "full_simca"]
            let replay_type: str = args[1]
            if replay_type not in REPLAY_NAMES:
                die("unknown replay type: " + replay_type + " (expected prequal, performance, simca, full_simca)")
            show_detailed_replays(parse_baseline(args, 2), replay_type)

        when others:
            stderr.writeLine("Unknown mode: " + mode)
            usage()

run()
