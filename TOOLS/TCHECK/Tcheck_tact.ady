#!/usr/bin/env ady2nim
#ady2nim-args c -d:release
"""Tcheck_tact — report the status of a TACT baseline build.

Scans Tlog files for test results (crashed, failing, successful),
replay status, gnatcheck/Padactl summary, and file changes.

Translated from the ksh original in TOOL/COMMON_UTILS.
"""

nimport os
nimport time

# ---------------------------------------------------------------------------
# The domain's values, named for what they are rather than how they are held
# ---------------------------------------------------------------------------
type BaselineNr_T   is str   # a baseline's number: 30.0.0.132
type BaselineName_T is str   # a baseline's full name: TACT.TACT_CONFIG.30.0.0.131, IFPS.CUA_IDL.30.0.0.122
type BuildName_T    is str   # a build's directory: build_G!31.IP.L8
type BuildLabel_T   is str   # a build type and subtype, as the report shows them: "IP in"
type TestName_T     is str   # a regression test: env_updates_prior_stop.1.el
type Ticket_T       is str   # an SC ticket: SC-134300
type Review_T       is str   # "dpt, gru on 260922.151702", "(review-ok: no)" after it if not ok
type NmFile_T       is str   # <system>/<subsystem>/<path>: a file, as the changes report names it
type InSub_T        is str   # a file's path in its submodule: sources/b.adb
type Extension_T    is str   # a file's extension, without the dot: adb; "" for none
type Rev_T          is str   # a git revision: c3fb81031^, a baseline's tag
type Link_T         is str   # an #emacs: link, clickable in the report's buffer
type Command_T      is str   # a shell command line
type Glob_T         is str   # a file-name pattern: build_G!31.*
type ColorSpec_T    is str   # a colour, as the ksh original spelled it: SWr
type Tool_T         is str   # a visual diff tool: meld, kompare

# ---------------------------------------------------------------------------
# ANSI color helpers
# ---------------------------------------------------------------------------
# The ksh version encodes colors as a spec string like "SWr" where:
#   Style:   S=bold(1) D=dim(2) I=italic(3) U=underline(4) F=blink(5) N=overline(7) H=hidden(8) T=strike(9)
#   Fg:      K=black(30) R=red(31) G=green(32) Y=yellow(33) B=blue(34) M=magenta(35) C=cyan(36) W=white(37)
#   Bg:      k=black(40) r=red(41) g=green(42) y=yellow(43) b=blue(44) m=magenta(45) c=cyan(46) w=white(47)

let ANSI_CODES: {char}str = {
    'S': "1", 'D': "2", 'I': "3", 'U': "4", 'F': "5", 'N': "7", 'H': "8", 'T': "9",
    'K': "30", 'R': "31", 'G': "32", 'Y': "33", 'B': "34", 'M': "35", 'C': "36", 'W': "37",
    'k': "40", 'r': "41", 'g': "42", 'y': "43", 'b': "44", 'm': "45", 'c': "46", 'w': "47"
}

var COLORED: bool = True
var BATCH: bool = False
# -tool NAME: the visual diff tool -- meld, kompare, kdiff3, ... With it
# (and not -batch) the list of changes links its diffs to NAME rather than
# to Emacs ediff; troubleshoot mode compares with it, meld when none is
# given. "" when none is.
var DIFF_TOOL: Tool_T = ""
var ONLY_NEW: bool = False
# Set by any Tlog that reports a new or crashed test; read once at the end
# to decide the exit status.
var HAS_NEW_FAILURES: bool = False

def ansi_escape(spec: ColorSpec_T) -> str:
    """Turn a color spec like 'sWr' into an ANSI escape sequence."""
    let codes: []str = [ANSI_CODES[ch] for ch in spec if ch in ANSI_CODES]
    return "\x1b[" + ";".join(codes) + "m" if codes else ""

def puts(spec: ColorSpec_T, text: str, NEWLINE: bool = False):
    """Print TEXT in the color given by SPEC, without a trailing newline."""
    const RESET: str = "\x1b[0m"
    stdout.write(ansi_escape(spec) + text + RESET if COLORED else text)
    if NEWLINE:
        print

def hr(c: char = '#', length: int = 80):
    print c * length

# ---------------------------------------------------------------------------
# Build / subtype enums
# ---------------------------------------------------------------------------

type BuildSubtype is enum in_test, mono, assert_test, lo, hi, memcheck, with_secondary
type BuildType is enum IP, OP, SIP
type BuildPass is enum normal, mrun
type FocusDomain is enum no_focus, focus_IP, focus_OP, focus_SIP, focus_replay, focus_build_info, focus_changes
type ReplayType is enum run_prequal, performance, simca, full_simca, oldest_date, all_autolink
# what a replay's log says of it
type ReplayStatus is enum succeeded, failed, not_started, busy

type Replay is tuple:
    rtype : ReplayType
    file  : Path

# ---------------------------------------------------------------------------
# Baselines
# ---------------------------------------------------------------------------

# The CM tree; overridable so the program can be run against a copy of one.
let CM_OT: Path = Path(${TCHECK_CM_OT:-"/cm/ot"})
let TACT_ROOT: Path = CM_OT / "TACT"

def subtype_label(st: BuildSubtype) -> str:
    """The file-system name for a subtype ('in' not 'in_test')."""
    let name: str = st'Image
    name.replace("_test", "")

def tlog_filename(subtype: BuildSubtype, pass_: BuildPass) -> str:
    """The Tlog filename for a subtype and pass."""
    let sl: str = subtype_label(subtype)
    case pass_:
        when normal: "Tlog-" + sl + ".log"
        when mrun: "Tlog-mrun-" + sl + ".log"

def build_type_from(build_name: BuildName_T) -> ?BuildType:
    """Extract the build type (IP, OP, SIP) from a build directory name.

    build_type_from("build_G!31.IP.L8") -> IP
    """
    # Explicit `return` on every branch: a tail expression does not work
    # under a `?T` return type, whichever branch it is on -- a value comes
    # out `some(IP)` where the case is typed `BT`, and a bare `None` reaches
    # Nim as `nil` and makes isNil ambiguous. Written up in TODO.md.
    case build_name:
        when /\.IP\./:  return IP
        when /\.OP\./:  return OP
        when /\.SIP\./: return SIP
        when others:    return None

def replay_type_from(file: Path) -> ?ReplayType:
    """Extract the replay type from a Treplay log's name.

    Treplay_G!31.OP.L8_30.0.0.128_2026.09.16_22:01:59-performance.dt6Uo.log
    """
    case file.name:
        when /run_prequal/:   return run_prequal
        when /performance/:   return performance
        when /full_simca/:    return full_simca
        when /simca/:         return simca
        when /oldest_date/:   return oldest_date
        when /all_autolink/:  return all_autolink
        when others:          return None

class Build:
    """One build of one baseline, e.g. build_G!31.IP.L8 of 30.0.0.121.

    It knows where it lives, so nothing is handed a build and a directory
    to join by hand -- the saved_logs, tacot_corico and Tlog paths were
    each spelled out at every place that needed one.

    It holds its baseline's number, all it needs of the baseline; the
    Baseline lists its builds.
    """
    name       : BuildName_T  = "" # e.g. build_G!31.IP.L8
    btype      : BuildType    = IP
    baseline_nr: BaselineNr_T = "" # the baseline it is a build of
    dir        : Path         = Path("")

    def __init__(self, name: BuildName_T, btype: BuildType, baseline_nr: BaselineNr_T, baseline_dir: Path):
        self.name = name
        self.btype = btype
        self.baseline_nr = baseline_nr
        self.dir = baseline_dir / name

    def saved_logs(self) -> Path:
        self.dir / "saved_logs"

    def tacot_dir(self, pass_: BuildPass) -> Path:
        """The tacot_corico directory for a given pass."""
        case pass_:
            when normal: self.saved_logs() / "tacot_corico.LATEST"
            when mrun:   self.saved_logs() / "tacot_corico_mrun.LATEST_GOOD"

    def tlog_path(self, subtype: BuildSubtype, pass_: BuildPass) -> Path:
        """Where the Tlog of SUBTYPE for PASS_ is, whether or not it exists yet."""
        self.tacot_dir(pass_) / "TACT_REGRESS_LOGS" / "LATEST" / tlog_filename(subtype, pass_)

    def process_subtype(self, subtype: BuildSubtype):
        """Process one subtype of the build, for both normal and mrun passes."""
        def lo_build_checks(tacot_corico_latest: Path):
            """Check for FORCE_TRACE errors in LO build logs."""
            let lo_logdir: Path = tacot_corico_latest / "work" / "logging-lo"
            if -e lo_logdir:
                puts("SyB", "Doing lo-build checks in " + lo_logdir, NEWLINE=True)
                grep_force_trace_in_dir(lo_logdir / "LOGS")
                grep_force_trace_in_dir(lo_logdir / "LOGS_others")
        for pass_ in BuildPass:
            if pass_ == mrun and (self.btype != IP or subtype != in_test):
                continue # we are only interested in "IP in" for the mrun pass
            self.show_tlog(subtype, pass_)
            if subtype == lo and pass_ == normal:
                lo_build_checks(self.tacot_dir(pass_))

    def show_tlog(self, subtype: BuildSubtype, pass_: BuildPass):
        """Show a Tlog file's summary if it exists, or a 'not ready' message."""
        let full_path: Path = self.tlog_path(subtype, pass_)
        let sl: str = subtype_label(subtype)

        if -f full_path:
            stdout.write("=======================================  ")
            puts("SWr", full_path.name)
            stdout.write(" ")
            puts("SWb", " (" + self.name + ")")
            print "  ======================================="
            process_Tlog(full_path, subtype)
            print
            return

        case self.btype:
            when IP:
                return if subtype not in (in_test, mono)
            when OP:
                return if subtype not in (in_test, assert_test)
            when others:
                return
        case pass_:
            when normal: puts("SWb", f"\"{self.btype} {sl}\" build not ready yet", NEWLINE=True)
            when mrun:   puts("SWb", f"\"{self.btype} {sl} mrun\" build not ready yet", NEWLINE=True)

    def show_padactl(self):
        """Show the Padactl/CRC summary from the IP self."""
        hr('#')
        puts("SWr", "Padactl", NEWLINE=True)
        let padactl_file: Path = self.saved_logs() / "Padactl.LATEST" / "Padactl.summary"
        if -f padactl_file:
            hr('-')
            puts("SWb", str(padactl_file), NEWLINE=True)
            let r = shell: grep -A20 delta {padactl_file}
            if r.output.strip() != "":
                print r.output.rstrip("\n")
            let r2 = shell: grep -A20 -i 'summary of last changes' {padactl_file}
            if r2.output.strip() != "":
                print r2.output.rstrip("\n")
            echo_emacs(padactl_file)
        else:
            puts("SWb", "WARNING: No CRC summary file found!", NEWLINE=True)

    def check_test_programs(self, fast_mode: bool):
        """Find or run check_run_test_programs_log from the IP self."""
        let baseline: BaselineNr_T = self.baseline_nr
        let work: Path = self.tacot_dir(normal) / "work"
        print
        hr('#')
        puts("SWr", "Check build closure and test programs.", NEWLINE=True)
        puts("USBy", "CHECK RUN TEST PROGRAMS LOG FOR " + str(self.dir) + " ...", NEWLINE=True)
        let find_lines: []str = shellLines: find {work} -type f -name 'check_run_test_programs.log' -print -quit
        var logfile: Path = Path("")
        if find_lines'Length > 0:
            logfile = Path(find_lines[0])

        if logfile == "":
            if fast_mode:
                puts("SWb", "check_run_test_programs_log not yet complete and we are in fast mode -> skip this check.", NEWLINE=True)
            else:
                puts("SWb", "check_run_test_programs_log not yet complete -> execute the program manually. This can take some minutes (run with -f to disable the execution).", NEWLINE=True)
                let build_subtype: str = self.name.replace("build_", "")
                let rc: int = shell: cd /tmp && echo check_run_test_programs_log | Ccontext -b "TACT.TACT_CONFIG.{baseline}" -e "{build_subtype}" 2>&1
        else:
            let mktemp_lines: []str = shellLines: cfmu_mktemp
            let full_report: Path = Path(mktemp_lines[0]) if mktemp_lines'Length > 0 else Path("/tmp/tcheck_report.txt")
            print "Full report is found in " + full_report + "."
            print
            let cp_rc: int = shell: cp {logfile} {full_report}
            let filtered = shell: grep -v 'Running.*setup' {full_report} | grep -v 'Checking for errors' | grep -v 'No errors found in' | grep -v -E '^[0-9.]+:\s+\S+\s+INFORMATION:' | grep -E '\S'
            if filtered.output.strip() != "":
                print filtered.output.rstrip("\n")

class Baseline:
    """One TACT baseline: its number and the directory holding its builds.

    What most of this program does is compare a baseline with the one
    before it, and that is `bl.previous()` -- the number arithmetic and
    the directory it implies were rebuilt by hand at every call site.

    Its builds and replays are listed only when asked, by find_builds()
    and find_replays(): creating one lists nothing, so `previous()` costs
    nothing and cannot fail on a baseline whose directory is gone.

    """
    nr     : BaselineNr_T = "" # e.g. 30.0.0.121
    dir    : Path         = Path("")
    builds : []Build            # its build_G!* builds, once find_builds() has run
    replays: []Replay           # its replays' logs, once find_replays() has run

    def __init__(self, nr: BaselineNr_T):
        self.nr = nr
        self.dir = TACT_ROOT / ("TACT_CONFIG." + nr)

    def previous(self) -> Baseline:
        let (head, tail) = self.nr.rsplit(".", 1)
        return Baseline(f"{head}.{int(tail) - 1}")

    def saved_logs_dir(self, btype: BuildType) -> Path:
        """The saved_logs directory of this baseline's build of BTYPE."""
        var env_id: str = $CM_ENV_ID
        case btype:
            when IP:  env_id = env_id.replace(".OP.", ".IP.")
            when OP:  env_id = env_id.replace(".IP.", ".OP.")
            when SIP: env_id = env_id.replace(".IP.", ".SIP.")
        self.dir / ("build_" + env_id) / "saved_logs"

    def find_builds(self):
        """List the baseline's build_G!* directories into builds, as the
        builds they are."""
        let SKIP_BUILD_PATTERNS: []str = ["92", "94", "95", "98", "30"]
        let basedir: Path = self.dir
        let listing: []str = shellLines: ls -1d {basedir}/build_G!*
        self.builds = []
        for line in listing:
            continue if line == ""
            let basename: str = Path(line).name # e.g. build_G!31.IP.L8
            continue if any(pat in basename for pat in SKIP_BUILD_PATTERNS)
            let bt: ?BuildType = build_type_from(basename)
            continue if bt is None
            self.builds.append(Build(basename, bt, self.nr, self.dir))

    def find_replays(self):
        """List the replays' logs into replays, one per replay type, in
        canonical order."""
        let basedir: Path = self.dir
        let listing: []str = shellLines: ls -d {basedir}/build_*OP*/saved_logs/Treplay_*.log

        var type_to_file: [ReplayType]Path
        for found in listing:
            continue if found == ""
            let log: Path = Path(found)
            let rt: ?ReplayType = replay_type_from(log)
            continue if rt is None
            type_to_file[rt] = log

        self.replays = []
        for rtype, filepath in enumerate(type_to_file):
            continue if filepath == ""
            self.replays.append((rtype: rtype, file: filepath))

    def replay_log_dir(self, rtype: ReplayType) -> Path:
        """The newest replay log dir of RTYPE, from this baseline backwards.

        Replays run on the OP build, so that is the saved_logs searched.
        """
        let dir_pat: Glob_T = replay_dir_pattern(rtype)
        var bl: Baseline = self
        var dir: Path = bl.saved_logs_dir(OP)
        var attempts: int = 0
        while attempts < 20:
            let listing: []str = shellLines: ls -d {dir}/replay_dir*{dir_pat}*/work/logging/LOGS
            if listing'Length > 0 and listing[0] != "":
                return Path(listing[0])
            bl = bl.previous()
            dir = bl.saved_logs_dir(OP)
            stderr.writeLine(PROG + ": trying " + dir)
            attempts += 1
        return Path("")

    def scan_regression_tests(self, btype: BuildType, subtype: BuildSubtype) -> Path:
        """Scan the logs of the BTYPE build's SUBTYPE regression tests for errors
        and core dumps; the report, normalized for diffing."""
        # saved_logs_dir(btype) is already the BTYPE build. This used to rewrite
        # "OP" to "IP" (or back) across the whole path string as well, which was
        # a no-op on a real TACT path and mangled any other: a checkout under
        # .../ADASCRIPT/... came out as .../ADASCROPT/... for an OP scan.
        let sl: str = subtype_label(subtype)
        var log_dir: Path = Path("")
        let work: Path = self.saved_logs_dir(btype) / "tacot_corico.LATEST" / "work" / ("logging-" + sl)
        case subtype:
            when mono:
                log_dir = work / "LOGS_mono"
            when others:
                log_dir = work / "LOGS_others"
        if not -d log_dir:
            puts("SWb", "log dir does not exist: " + log_dir, NEWLINE=True)
            return Path("")
        puts("USBy", "scanning " + log_dir, NEWLINE=True)
        let tacot_root: Path = log_dir.parent.parent.parent
        find_core_dumps(tacot_root)
        var report: str = ""
        case subtype:
            when mono:
                let mono_out: Path = log_dir / "mono.out"
                if -f mono_out:
                    let hits: str = grep_logfile(mono_out)
                    report = hits
            when others:
                let out_files: []str = shellLines: ls {log_dir}/*1_out_01
                for f in out_files:
                    continue if f == ""
                    hr('#')
                    puts("SWb", Path(f).name, NEWLINE=True)
                    hr('#')
                    let hits: str = grep_logfile(Path(f))
                    if hits != "":
                        report = report + "##### " + Path(f).name + " #####\n" + hits + "\n"
        return make_report(report, self.nr, "regression_" + btype'Image + "_" + sl)

    def show_failed_tests(self, btype: BuildType, subtype: BuildSubtype, n_baselines: int = 15) -> str:
        """The BTYPE SUBTYPE tests failing in this baseline and the N_BASELINES - 1
        before it, printed and returned."""
        var baseline: Baseline = self
        let sl: str = subtype_label(subtype)
        var ip_env: str = $CM_ENV_ID
        var op_env: str = ip_env.replace(".IP.", ".OP.")
        ip_env = ip_env.replace(".OP.", ".IP.")
        var result: str = ""
        for iteration in range(n_baselines):
            let bl: BaselineNr_T = baseline.nr
            let header: str = f"FAILED {btype} REGRESSION TESTS logging-{sl} for BASELINE {bl}"
            hr('-')
            puts("SWr", header, NEWLINE=True)
            result = result + header + "\n"
            var env: str = ip_env
            var suffix: str = "failed-in"
            case subtype:
                when mono:
                    env = ip_env
                    suffix = "failed-mono"
                when in_test:
                    case btype:
                        when IP:  env = ip_env
                        when OP:  env = op_env
                        when others: pass
                    suffix = "failed-in"
                when assert_test:
                    env = op_env
                    suffix = "failed-assert"
                when others: pass
            let r = shell: nl {TACT_ROOT}/test_reports/TACT.TACT_CONFIG.{bl}-{env}*/general.results.{suffix}
            if r.output.strip() != "":
                print r.output.rstrip("\n")
                result = result + r.output
            baseline = baseline.previous()
        return result

# ---------------------------------------------------------------------------
# Tlog section parsing
# ---------------------------------------------------------------------------

# The sections of a Tlog that are reported, by the words of their header.
# A Tlog has more -- known failures, errors in log files, mrun failing,
# Check build of ..., the summary -- and every header ends the section
# before it, reported or not: a section running on into the next would take
# its lines for its own (a WARNING line's "Tlog:", a header's "mrun" or
# "Check" were new failures).
type Section is enum CRASHED, NEW_FAILING, NOT_RUN, STILL_FAILING, NOW_OK, UNREPORTED

let SECTION_HEADERS: [](Section, str) = [
    (CRASHED,       "Crashed Tests"),
    (NEW_FAILING,   "New tests failing"),
    (NOT_RUN,       "Tests that did not run"),
    (STILL_FAILING, "Tests still failing"),
    (NOW_OK,        "Following tests are now successful")
]

def is_section_header(line: str) -> bool:
    """Whether LINE opens a section of a Tlog -- every one does, with a row
    of dots: " .............. New tests failing : nb = 3"."""
    line.strip().startswith("..............")

def section_of(header: str) -> Section:
    """The section HEADER opens. Its words are looked for in headers only: a
    line of text may mention a section."""
    for section, words in SECTION_HEADERS:
        return section if words in header
    return UNREPORTED

def extract_test_name(line: str) -> TestName_T:
    """Extract the test name from a Tlog line (second whitespace-separated field)."""
    let parts: []str = line.split()
    return parts[1] if parts'Length > 1 else line.strip()

def is_test_name(name: TestName_T) -> bool:
    """Whether NAME, a Tlog line's second word, names a test: a test is an
    .el file. The sections hold other lines too -- a remark, a pointer to
    the log, an mrun line -- whose second word (all, Check, Tlog:, mrun) is
    no test."""
    name.endswith(".el")

class Tlog:
    """A Tlog's reported sections: the lines of each, as the Tlog wrote them."""
    crashed    : []str
    new_failing: []str
    not_run    : []str
    still_fail : []str
    now_ok     : []str
    # the baseline the Tlog compared its build with, what its new failures
    # are new against: "Tlog: INFO: Actual reference baseline    : 30.0.0.120";
    # "" when it does not say
    reference  : BaselineNr_T

    def __init__(self, filepath: Path, build_subtype: BuildSubtype):
        """Read FILEPATH in one pass: each non-blank line goes to the section
        the last header opened. Only the first section of a name counts; a
        later one is skipped like an unreported one. A mono build's tests that
        did not run are not reported."""
        var seen: {}Section = {}
        var section: Section = UNREPORTED
        for line in filepath.lines:
            continue if line.strip() == ""
            if self.reference == "" and line == /Actual reference baseline\s*:\s*(?P<ref>\S+)/:
                self.reference = $+{ref}
            if is_section_header(line):
                let named: Section = section_of(line)
                section = UNREPORTED if named in seen else named
                seen.add(named)
            else:
                case section:
                    when CRASHED:
                        self.crashed.append(line)
                    when NEW_FAILING:
                        self.new_failing.append(line)
                    when NOT_RUN:
                        if build_subtype != mono:
                            self.not_run.append(line)
                    when STILL_FAILING:
                        self.still_fail.append(line)
                    when NOW_OK:
                        self.now_ok.append(line)
                    when UNREPORTED:
                        pass

    def all_ok(self) -> bool:
        """Whether nothing crashed, newly failed or still fails."""
        self.crashed'Length == 0 and self.new_failing'Length == 0 and self.still_fail'Length == 0

    def show(self, only_new: bool = False):
        """Print the sections, coloured as the ksh version does; ONLY_NEW
        leaves out all but the new failures and crashes."""
        var at_least_one_failing: bool = False

        # New tests failing.
        if self.new_failing'Length == 0:
            if not only_new:
                puts("Kw", "New tests failing")
                print "  ==> None"
                print
        else:
            at_least_one_failing = True
            puts("Kw", "New tests failing", NEWLINE=True)
            for line in self.new_failing:
                stdout.write("\t")
                puts("SKy", extract_test_name(line), NEWLINE=True)
                let emacs_at: int = line.find("#emacs")
                if emacs_at >= 0:
                    print line[emacs_at:]
                else:
                    print
                print

        # Crashed Tests.
        if self.crashed'Length > 0:
            at_least_one_failing = True
            puts("Kw", "Crashed Tests", NEWLINE=True)
            for line in self.crashed:
                print "CRASHED TEST: " + line
                print

        # Tests still failing.
        if self.still_fail'Length == 0:
            if not only_new:
                puts("Kw", "Tests still failing")
                print "  ==> None"
                print
        elif not only_new:
            at_least_one_failing = True
            puts("Kw", "Tests still failing", NEWLINE=True)
            for line in self.still_fail:
                if "Worse" in line or "Better" in line or "Same" in line:
                    print line
                else:
                    stdout.write("\t")
                    puts("SKy", extract_test_name(line), NEWLINE=True)
                    let emacs_at: int = line.find("#emacs")
                    if emacs_at >= 0:
                        print line[emacs_at:]
                    else:
                        print
                print

        # Tests that did not run.
        if self.not_run'Length > 0 and not only_new:
            at_least_one_failing = True
            puts("Kw", "Tests that did not run", NEWLINE=True)
            for line in self.not_run:
                print line
                print

        # Following tests are now successful.
        if self.now_ok'Length == 0:
            if not only_new:
                puts("Kw", "Following tests are now successful")
                print "  ==> None"
                print
        elif not only_new:
            puts("Kw", "Following tests are now successful", NEWLINE=True)
            for line in self.now_ok:
                print line
                print

        if not at_least_one_failing and not only_new:
            print
            puts("Kw", ".............. ALL TESTS ARE SUCCESSFUL !!!!", NEWLINE=True)

    def failed_test_names(self) -> []TestName_T:
        """The tests the new_failing and crashed sections name."""
        var names: []TestName_T = []
        for line in self.new_failing + self.crashed:
            let name: TestName_T = extract_test_name(line)
            if is_test_name(name):
                names.append(name)
        return names

def process_Tlog(filepath: Path, build_subtype: BuildSubtype):
    """Parse and print a Tlog file (backward-compatible wrapper)."""
    let tlog: Tlog = Tlog(filepath, build_subtype)
    tlog.show(ONLY_NEW)
    if tlog.new_failing'Length > 0 or tlog.crashed'Length > 0:
        HAS_NEW_FAILURES = True

def echo_emacs(filepath: Path):
    """Print an #emacs: link for FILEPATH."""
    puts("SBw", "Look for details in:", NEWLINE=True)
    print f"#emacs:(progn(find-file \"{filepath}\"))"

# ---------------------------------------------------------------------------
# Replay logs
# ---------------------------------------------------------------------------

class ReplayLog:
    """What a Treplay log says of its replay, read in one pass."""
    file         : Path
    status       : ReplayStatus
    severe_errors: []str   # its ERROR_REPORT.SEVERE lines
    terminated   : bool    # whether it says "Replay terminated"

    def __init__(self, file: Path):
        """The verdict is that of the last UNINSTALL step when it has one;
        else the log is waiting for the replay to end, or has not started."""
        self.file = file
        var verdict: str = ""        # the rest of the last UNINSTALL line
        var waiting: bool = False
        for line in file.lines:
            if "Executed UNINSTALL:" in line:
                let (_, after) = line.rsplit("Executed UNINSTALL:", 1)
                verdict = after
            if "Waiting for this replay to be finished" in line:
                waiting = True
            if "ERROR_REPORT.SEVERE" in line:
                self.severe_errors.append(line)
            if "Replay terminated" in line:
                self.terminated = True
        if "YES" in verdict:
            self.status = succeeded
        elif "NO" in verdict:
            self.status = failed
        elif waiting:
            self.status = busy
        else:
            self.status = not_started

    def show(self, verbose: bool):
        """The verdict, with a link to the log when the replay failed, and
        with VERBOSE its severe errors, each from its file's name on."""
        case self.status:
            when succeeded:
                puts("SWb", "==> WAS SUCCESSFUL", NEWLINE=True)
            when failed:
                puts("SWr", "==> FAILED", NEWLINE=True)
                echo_emacs(self.file)
                print
                if verbose:
                    for line in self.severe_errors:
                        let basename_at: int = line.rfind("/")
                        if basename_at >= 0:
                            print line[basename_at + 1:]
                        else:
                            print line
            when not_started:
                puts("SWb", "---> WARNING: it looks like the replay hasn't started", NEWLINE=True)
            when busy:
                puts("SWb", "IS STILL BUSY", NEWLINE=True)

def process_replay(replay: Replay, verbose: bool):
    """Check the status of a single replay (successful / failed / running)."""
    let label: str = f"\"{replay.rtype}\""
    puts("SWb", f"{label:<14} replay ")
    ReplayLog(replay.file).show(verbose)
    hr('-')

# ---------------------------------------------------------------------------
# Build processing (test results per build)
# ---------------------------------------------------------------------------

def grep_force_trace_in_dir(dir: Path):
    """Grep for missing 'if Debug.Trace' guards in LO build logs."""
    if not -d dir:
        puts("SWb", "WARNING: '" + dir + "' does not exist!", NEWLINE=True)
        return
    puts("SWb", "Grep in " + dir + " to detect missing 'if Debug.Trace (...) then' (100 first errors, no matches means no errors detected):", NEWLINE=True)
    let r = shell: for f in {dir}/*_out_*; do [ -e "$f" ] && grep -H -n -B1 '!!! ERROR : FORCE_TRACE message above' "$f" | grep -v '^--[[:space:]]*$'; done | head -n 100
    if r.output.strip() != "":
        print r.output.rstrip("\n")

# ---------------------------------------------------------------------------
# List all changes: who committed what, per the CFMUTEST changes report
# ---------------------------------------------------------------------------
#
# A TACT baseline is tested by a CFMUTEST baseline, and each CFMUTEST
# baseline has a changes report: for each component, the merges since the
# previous baseline and the files their commits changed, added or removed.
#
#   ===== Differences between TACT.UIF.30.0.0.129 and TACT.UIF.30.0.0.130
#         Merge from <- 6627849d2 testadm.integration_30 RELATED_CHANGES="SC-1 SC-2 "
#         Merge from <- a2721a86a acicek.transmit_esb RELATED_CHANGES="SC-1 SC-2 "
#         Merge from <- c3fb81031 CFMUTEST.CFMUTEST_CONFIG.30.0.0.104 review-ok: yes; ...
#         changed c3fb81031:TACT/UIF/sources/query_mgr_task.adb RELATED_CHANGES=" " ...
#
# A change is credited to the nearest user branch merged above it in its
# section -- <user>.<branch> -- skipping integration merges (testadm, and
# any other ...adm) and baseline syncs (CFMUTEST.CFMUTEST_CONFIG.<nr>).
# Where a section merges several people's branches that is a guess, and
# the only one the report allows.

let CFMUTEST_ROOT: Path = CM_OT / "CFMUTEST"

# a user branch as the report names it: <user>.<branch>
type BranchName is str
type Committer is str
type CommitHash is str

type ChangeKind is enum CHANGED, ADDED, DELETED

# The DIFF and NET DIFF lines are #emacs: links, clickable in an Emacs
# buffer like the report's own: side by side in Emacs (vc-version-ediff),
# or under -tool in that tool, started without an output buffer.

def elisp_string(text: str) -> str:
    """TEXT as an Emacs Lisp string literal."""
    "\"" + text.replace("\\", "\\\\").replace("\"", "\\\"") + "\""

def nm_cache() -> Path:
    """Where the diff links clone NM's repositories, from Bitbucket, when
    there is no workspace: $TCHECK_NM_CACHE, or ~/Downloads/.cache/tcheck/NM."""
    return Path($TCHECK_NM_CACHE) if $TCHECK_NM_CACHE != ""
    Path($HOME) / "Downloads" / ".cache" / "tcheck" / "NM"

def nm_root() -> Path:
    """The NM workspace, or, without one, the cache standing in for it."""
    return Path($CMA_WORKSPACE_NM_REPOSITORY_DIRECTORY) if $CMA_WORKSPACE_NM_REPOSITORY_DIRECTORY != ""
    nm_cache()

class FileChange:
    """A file a branch changed, added or deleted, as the changes report
    lists it: its kind of change, the commits that made it and what they
    say of it; and how to look at it -- the DIFF and NET DIFF links."""
    kind:    ChangeKind
    # the path in the report: <system>/<subsystem>/...
    file:    NmFile_T
    # every commit of the branch that touched it, in report order
    commits: []CommitHash
    # the SC tickets those commits name
    tickets: []Ticket_T
    # "<reviewers> on <date>", once per review the report gives them
    reviews: []Review_T
    # the component's baselines the change lies between, as tags in its
    # submodule: "Differences between IFPS.CUA_IDL.30.0.0.122 and ...123"
    from_baseline: BaselineNr_T
    to_baseline:   BaselineNr_T

    def __init__(self, kind: ChangeKind, file: NmFile_T, from_baseline: BaselineNr_T, to_baseline: BaselineNr_T):
        """The change, before any commit, ticket or review is added to it."""
        self.kind = kind
        self.file = file
        self.from_baseline = from_baseline
        self.to_baseline = to_baseline

    def absorb(self, other: FileChange):
        """OTHER's commits, tickets and reviews, each that is not here yet."""
        for c in other.commits:
            if c not in self.commits:
                self.commits.append(c)
        for t in other.tickets:
            if t not in self.tickets:
                self.tickets.append(t)
        for r in other.reviews:
            if r not in self.reviews:
                self.reviews.append(r)

    def submodule_path(self) -> (Path, InSub_T):
        """The submodule and its path inside it: the report's path is
        <system>/<subsystem>/<rest>, and <system>/<subsystem> is a submodule of
        the NM workspace, where the commits and tags are."""
        let parts: []str = self.file.split("/")
        return (Path(""), self.file) if len(parts) < 3
        (nm_root() / parts[0] / parts[1], "/".join(parts[2:]))

    def emacs_difftool(self, rev1: Rev_T, rev2: Rev_T) -> Link_T:
        """A link starting the -tool diff tool on the file between REV1 and
        REV2, through git difftool."""
        let (sub, rest) = self.submodule_path()
        let where: str = f"-C {sub} " if sub != "" else ""
        let command: Command_T = f"git {where}difftool -y -t {DIFF_TOOL} {rev1} {rev2} -- {rest}"
        f"#emacs:(call-process-shell-command {elisp_string(command)} nil 0)"

    def emacs_ediff(self, rev1: Rev_T, rev2: Rev_T) -> Link_T:
        """A link comparing the file between REV1 and REV2 side by side in
        Emacs, through its own git support."""
        let (sub, rest) = self.submodule_path()
        let path: Path = sub / rest if sub != "" else Path(rest)
        var file: str = elisp_string(str(path))
        if "$" in path:
            file = f"(substitute-in-file-name {file})"
        f"#emacs:(vc-version-ediff (list {file}) {elisp_string(rev1)} {elisp_string(rev2)})"

    def diff_link(self, rev1: Rev_T, rev2: Rev_T) -> Link_T:
        """The link comparing the file between REV1 and REV2 -- checking it
        out first when it needs to be."""
        let link: Link_T = self.emacs_difftool(rev1, rev2) if DIFF_TOOL != "" else self.emacs_ediff(rev1, rev2)
        let checkout: Command_T = self.checkout_command(rev1, rev2)
        return link if checkout == ""
        let form: str = link.removeprefix("#emacs:")
        f"#emacs:(when (eql 0 (shell-command {elisp_string(checkout)})) {form})"

    def checkout_command(self, rev1: Rev_T, rev2: Rev_T) -> Command_T:
        """The Tcheckout command checking the file out alone, for its diff
        between REV1 and REV2: in the NM workspace when its submodule is not
        checked out, or is sparsely without it -- "" otherwise; without a
        workspace, always, in the cache -- which fetches REV1 and REV2 when it
        lacks them."""
        let (sub, rest) = self.submodule_path()
        return "" if sub == ""
        let root: str = $CMA_WORKSPACE_NM_REPOSITORY_DIRECTORY
        return f"Tcheckout -cache {nm_cache()} -rev {rev2} -rev {rev1} {self.file}" if root == ""
        let git_link: Path = sub / ".git"
        let path: Path = sub / rest
        if -e git_link:
            return "" if self.kind == DELETED or -e path
            # missing from a checkout: only a sparse one can take it in
            let sparse = shell: git -C {!sub} config --bool core.sparseCheckout 2>/dev/null
            return "" if sparse.output.strip() != "true"
        f"Tcheckout -root {root} {self.file}"

    def diff_links(self) -> []Link_T:
        """One link per commit: the file in the commit's parent and in the commit."""
        [self.diff_link(c + "^", c) for c in self.commits]

    def net_diff_link(self) -> Link_T:
        """What the component's baseline did to the file, all commits together."""
        self.diff_link(self.from_baseline, self.to_baseline)

    def display(self):
        """FILE <KIND>: <dir>/<base>.<extension>, the base and extension in
        color; then the commits that made the change and their tickets."""
        let p: Path = Path(self.file)
        let name: str = p.name
        let dot: int = name.rfind(".")
        stdout.write(f"FILE {self.kind}: {p.parent}/")
        if dot > 0:
            puts("Ky", name[:dot])
            stdout.write(".")
            puts("Wb", name[dot + 1:], NEWLINE=True)
        else:
            puts("Ky", name, NEWLINE=True)
        print "COMMITS     : " + " ".join(self.commits)
        if len(self.tickets) > 0:
            print "TICKETS     : " + " ".join(self.tickets)
        for r in self.reviews:
            print "REVIEWED BY : " + r
        for command in self.diff_links():
            print "DIFF        : " + command
        if len(self.commits) > 1 and self.from_baseline != "" and self.to_baseline != "":
            print "NET DIFF    : " + self.net_diff_link()

def cfmu_baseline_of(tact_nr: BaselineNr_T) -> BaselineNr_T:
    """The CFMUTEST baseline built on TACT baseline TACT_NR -- the first
    CFMUTEST_CONFIG among what `Psort -b` answers for it -- or "" when
    there is none. Psort -b lists every build on it: the views built on it
    (their own paths) first, then the baselines, the TACT one itself too."""
    # A CM path for Psort, not a file: /cm/ot whatever TCHECK_CM_OT says.
    let tact: Path = Path("/cm/ot/TACT") / ("TACT_CONFIG." + tact_nr)
    for answer in shellIter: echo {!tact} | Psort -b
        if answer == /\/CFMUTEST\/CFMUTEST_CONFIG[!.](?P<nr>[^\/\s]+)$/:
            return $+{nr}
    ""

def committer_of(branch: BranchName) -> Committer:
    branch.split(".")[0]

def user_branch(name: BranchName) -> BranchName:
    """NAME, a merge's source, when it is somebody's branch; "" when it is
    an integration merge (testadm.integration_30, any ...adm) or a baseline
    sync (CFMUTEST.CFMUTEST_CONFIG.30.0.0.104)."""
    return "" if name == /^[A-Z][A-Z0-9_]*\.[A-Z0-9_]+\.\d/
    return "" if "." not in name
    return "" if committer_of(name).endswith("adm")
    return name

def review_of(line: str) -> Review_T:
    """The review a report line records -- "dpt, gru on 260922.151702",
    with "(review-ok: no)" after it unless it was ok -- or ""."""
    return "" if line != /review-ok: (?P<ok>\w+); reviewed-by: (?P<by>[^;]*); review-date: (?P<date>[^;]*);/
    let ok: str = $+{ok}
    let text: str = $+{by}.strip() + " on " + $+{date}.strip()
    text if ok == "yes" else text + " (review-ok: " + ok + ")"

def baseline_nr(component: BaselineName_T) -> BaselineNr_T:
    """The baseline number of "IFPS.CUA_IDL.30.0.0.122": 30.0.0.122."""
    let (system, subsystem, nr) = component.split(".", 2)
    nr

# the report's verbs for a change
let CHANGE_KINDS: {str}ChangeKind = {"changed": CHANGED, "added": ADDED, "removed": DELETED, "deleted": DELETED}

# What a ChangesReport, being read, knows of the section it is in: one per
# component.
class ReportSection:
    # its baselines: "Differences between IFPS.CUA_IDL.30.0.0.122 and ...123"
    from_baseline: BaselineNr_T
    to_baseline:   BaselineNr_T
    # the branch merged last, nearest above the changes that follow;
    # "" after an integration merge
    branch:        BranchName
    # the user branches merged so far, and the tickets each merge lists
    names:         []BranchName
    tickets:       [][]Ticket_T

    def __init__(self, from_baseline: BaselineNr_T, to_baseline: BaselineNr_T):
        self.from_baseline = from_baseline
        self.to_baseline = to_baseline

    def credit(self, tickets: []Ticket_T) -> BranchName:
        """The branch a change with TICKETS is credited to, among the user
        branches merged above it: the one whose merge lists all of the
        change's tickets, else the one that lists any of them, else -- none
        or several -- the nearest."""
        return self.branch if len(tickets) == 0
        let covering: []BranchName = [n for n, ts in zip(self.names, self.tickets) if all([t in ts for t in tickets])]
        return covering[0] if len(covering) == 1
        let sharing: []BranchName = [n for n, ts in zip(self.names, self.tickets) if any([t in ts for t in tickets])]
        return sharing[0] if len(sharing) == 1
        self.branch

def tickets_of(line: str) -> []Ticket_T:
    """The SC tickets a report line lists in RELATED_CHANGES="...", if any."""
    return [] if line != /RELATED_CHANGES="(?P<sc>[^"]*)"/
    $+{sc}.split()

class ChangesReport:
    """A CFMUTEST changes report: the changes it lists, each credited to a
    user branch merged above it in its section (see ReportSection.credit); one entry per
    branch, file and kind of change, with every commit that made it."""
    # in the order each first appears
    committers  : []Committer
    branches    : {Committer}[]BranchName
    files       : {BranchName}[]FileChange
    # changes with no user branch above them in their section
    unattributed: []FileChange

    def __init__(self, report: Path):
        """Read REPORT, section by section."""
        var section: ReportSection = ReportSection("", "")
        var seen: {str}int = {:}
        # a merge's review, for the change its own commit makes: the merge line
        # and the change line then carry the same sha
        var merge_reviews: {CommitHash}Review_T = {:}
        for line in report.lines:
            # Captures are bound first: the calls in each branch match regexes
            # of their own.
            case line.strip():
                when /^===== Differences between (?P<a>\S+) and (?P<b>\S+)/:
                    let a: BaselineName_T = $+{a}
                    let b: BaselineName_T = $+{b}
                    section = ReportSection(baseline_nr(a), baseline_nr(b))
                when /^=====/:
                    # nothing merged yet; the baselines are the last ones named
                    section = ReportSection(section.from_baseline, section.to_baseline)
                when /^Merge from <- (?P<sha>\S+) (?P<name>\S+)/:
                    let merge_sha: CommitHash = $+{sha}
                    let source: BranchName = $+{name}
                    let review: Review_T = review_of(line)
                    if review != "":
                        merge_reviews[merge_sha] = review
                    let merged: BranchName = user_branch(source)
                    if merged != "":
                        section.branch = merged
                        section.names.append(merged)
                        section.tickets.append(tickets_of(line))
                    elif committer_of(source).endswith("adm"):
                        # an integration merge: what follows is nobody's yet
                        section.branch = ""
                when /^(?P<verb>changed|added|removed|deleted)\s+(?P<sha>[0-9a-f]+):(?P<file>\S+)/:
                    let verb: str = $+{verb}
                    let sha: CommitHash = $+{sha}
                    let file: NmFile_T = $+{file}
                    var review: Review_T = review_of(line)
                    if review == "" and sha in merge_reviews:
                        review = merge_reviews[sha]
                    var fc: FileChange = FileChange(CHANGE_KINDS[verb], file, section.from_baseline, section.to_baseline)
                    fc.commits.append(sha)
                    fc.tickets = tickets_of(line)
                    if review != "":
                        fc.reviews.append(review)
                    let owner: BranchName = section.credit(fc.tickets)
                    if owner == "":
                        self.unattributed.append(fc)
                    else:
                        self.add(seen, owner, fc)
                when others:
                    pass

    def add(self, seen: {str}int, owner: BranchName, fc: FileChange):
        """FC, credited to OWNER: a new entry, or its commits, tickets and
        reviews absorbed by OWNER's entry for the same file and kind of change.
        SEEN maps "<branch>\x01<kind>\x01<file>" to that entry's index."""
        let who: Committer = committer_of(owner)
        if who not in self.branches:
            self.committers.append(who)
            self.branches[who] = []
        if owner not in self.files:
            self.branches[who].append(owner)
            self.files[owner] = []
        let key: str = owner + "\x01" + fc.kind'Image + "\x01" + fc.file
        if key not in seen:
            seen[key] = len(self.files[owner])
            self.files[owner].append(FileChange(fc.kind, fc.file, fc.from_baseline, fc.to_baseline))
        self.files[owner][seen[key]].absorb(fc)

    def keep_only(self, user: Committer):
        """Only USER's changes from now on, when USER is not "": the changes
        credited to no branch are nobody's, and go too."""
        return if user == ""
        self.committers = [user] if user in self.committers else []
        self.unattributed = []

def echo_ediff(a: Path, b: Path):
    print f"(ediff-files \"{a}\" \"{b}\")"

def newest(dir: Path, pattern: Glob_T) -> Path:
    """The most recently modified entry of DIR matching the glob PATTERN,
    or Path("") when none does."""
    let found: []str = shellLines: ls -dt {!dir}/{pattern} 2>/dev/null | head -n 1
    Path(found[0]) if len(found) > 0 else Path("")

def troubleshoot_tool() -> Tool_T:
    """What troubleshoot mode compares two files with: the -tool diff tool,
    or meld."""
    DIFF_TOOL if DIFF_TOOL != "" else "meld"

def view_build_of(branch: BranchName) -> Path:
    """BRANCH's view build -- the newest build_* of TACT_CONFIG.<USER>.<BRANCH>,
    e.g. build_default_Linux -- or Path("") when it has none."""
    let who: Committer = committer_of(branch)
    let name: str = branch[len(who) + 1:]
    newest(TACT_ROOT / f"TACT_CONFIG.{who.upper()}.{name.upper()}", "build_*")

def reference_build(reference: BaselineName_T, ref_reports: Path) -> Path:
    """The build of REFERENCE -- "TACT.TACT_CONFIG.30.0.0.132" -- its test
    reports REF_REPORTS were made from: they are named after it,
    TACT.TACT_CONFIG.30.0.0.132-G!31.IP.L8-<host>-<date> for
    TACT_CONFIG.30.0.0.132/build_G!31.IP.L8. Without reports, its newest
    build_G!31.* build. Path("") when that directory does not exist."""
    let baseline_dir: Path = TACT_ROOT / reference.removeprefix("TACT.")
    var build: Path = Path("")
    if ref_reports != "":
        let tag: str = ref_reports.name.removeprefix(reference + "-").split("-")[0]
        build = baseline_dir / ("build_" + tag)
    else:
        build = newest(baseline_dir, "build_G!31.*")
    build if build != "" and -d build else Path("")

def display_branch_info(branch: BranchName, reference: BaselineName_T):
    """The branch the changes came from: its view build -- the build of
    TACT_CONFIG.<USER>.<BRANCH>, e.g. build_default_Linux -- and the
    REFERENCE baseline's build; its test reports next to the reference
    baseline's, with the ediff between their failures. Each said to be
    missing when it is: a branch may be built and its tests not yet run."""
    let who: Committer = committer_of(branch)
    let name: str = branch[len(who) + 1:]
    stdout.write("FROM BRANCH : ")
    puts("Wb", who)
    stdout.write(".")
    puts("Ky", name, NEWLINE=True)
    let view_build: Path = view_build_of(branch)
    if view_build == "":
        print "NO VIEW BUILD FOUND FOR THIS BRANCH"
    else:
        print f"VIEW BUILD DIR: {view_build}"
    let reports: Path = TACT_ROOT / "test_reports"
    let view_reports: Path = newest(reports, f"TACT.TACT_CONFIG.{who.upper()}.{name.upper()}-G!31.*")
    let ref_reports: Path = newest(reports, f"{reference}-G!31.*")
    let ref_build: Path = reference_build(reference, ref_reports)
    if ref_build == "":
        print "NO REFERENCE BUILD FOUND"
    else:
        print f"REFERENCE BUILD DIR: {ref_build}"
    if view_reports == "":
        print "NO TEST REPORTS FOUND FOR THIS BRANCH"
    else:
        print f"VIEW TEST REPORTS DIR: {view_reports}"
        print f"REFERENCE BASELINE DIR: {ref_reports}"
        echo_ediff(ref_reports / "general.results.failed-in", view_reports / "general.results.failed-in")

def changes_report(baseline: BaselineNr_T, warn: bool = True) -> Path:
    """The changes report of the CFMUTEST baseline built on TACT BASELINE,
    or Path("") -- after a warning saying why there is none, if WARN."""
    let cfmu: BaselineNr_T = cfmu_baseline_of(baseline)
    if cfmu == "":
        if warn:
            puts("SWb", f"WARNING: Psort -b names no CFMUTEST baseline for TACT_CONFIG.{baseline}", NEWLINE=True)
        return Path("")
    let report: Path = CFMUTEST_ROOT / "baseline_reports" / f"CFMUTEST.CFMUTEST_CONFIG.{cfmu}.changes_report"
    if not -r report:
        if warn:
            puts("SWb", f"WARNING: no changes report for CFMUTEST_CONFIG {cfmu}: {report}", NEWLINE=True)
        return Path("")
    report

def extension_of(file: NmFile_T) -> Extension_T:
    """FILE's extension, as FileChange.display splits it: after the last dot of
    its name, when that dot does not start it; "" when there is none."""
    let name: str = Path(file).name
    let dot: int = name.rfind(".")
    name[dot + 1:] if dot > 0 else ""

def extension_label(ext: Extension_T) -> str:
    ext if ext != "" else "(no extension)"

def files_of(changes: []FileChange) -> []NmFile_T:
    """The files CHANGES touch, each once: a file changed, added or deleted
    more than once is one file."""
    var files: []NmFile_T = []
    for fc in changes:
        if fc.file not in files:
            files.append(fc.file)
    files

def files_by_type(files: []NmFile_T) -> str:
    """"2 adb, 2 ads" -- how many of FILES have each extension, the
    commonest first."""
    var counts: {Extension_T}int = {:}
    for file in files:
        let ext: Extension_T = extension_of(file)
        counts[ext] = counts.get(ext, 0) + 1
    let order: [](int, Extension_T) = sorted([(-n, ext) for ext, n in counts.items()])
    ", ".join([f"{-n} {extension_label(ext)}" for n, ext in order])

def list_files_by_committer(report: Path, user: Committer):
    """By committer, the most first, how many files REPORT's changes touch,
    and how many of each type (extension); then the branches with no view
    build, if any. A change no branch is credited with is left out: the
    detailed listing lists it. Only USER's, when USER is not ""."""
    var changes: ChangesReport = ChangesReport(report)
    if user != "" and user not in changes.committers:
        puts("SWb", f"No changes by {user}; by: " + ", ".join(changes.committers), NEWLINE=True)
        print
        return
    changes.keep_only(user)
    var files: {Committer}[]NmFile_T = {:}
    for who in changes.committers:
        var theirs: []FileChange = []
        for branch in changes.branches[who]:
            theirs.extend(changes.files[branch])
        files[who] = files_of(theirs)
    # the most files first; as they first appear in the report when as many
    let order: [](int, int, Committer) = sorted([(-len(files[who]), i, who) for i, who in enumerate(changes.committers)])
    var width: int = 0
    var count_width: int = 0
    for who in changes.committers:
        width = max(width, len(who))
        count_width = max(count_width, len(str(len(files[who]))))
    for n, i, who in order:
        let noun: str = "file " if -n == 1 else "files"
        puts("Wb", who)
        print " " * (width - len(who)) + f"  {str(-n).rjust(count_width)} {noun}: " + files_by_type(files[who])
    print
    # the branches not built yet, in the order of the table
    var unbuilt: []BranchName = []
    for n, i, who in order:
        for branch in changes.branches[who]:
            if view_build_of(branch) == "":
                unbuilt.append(branch)
    if len(unbuilt) > 0:
        puts("SWb", "NO VIEW BUILD FOUND FOR THESE BRANCHES", NEWLINE=True)
        for branch in unbuilt:
            print "  " + branch
        print

# A test one of the baseline's Tlogs reports newly failing or crashed:
# see Report.new_failures.
type NewFailure is tuple:
    build: BuildLabel_T # the build type and subtype it fails in: "IP in", "OP assert"
    test:  TestName_T

# One of a baseline's Tlogs: see Report.tlogs.
type TlogAt is tuple:
    build:   BuildLabel_T # the build type and subtype: "IP in"
    subtype: BuildSubtype
    path:    Path

def list_new_failures(against: str, failures: []NewFailure):
    """Each test of FAILURES once, with the build(s) it newly fails in;
    AGAINST, the baselines the Tlogs compared with, or ""."""
    let vs: str = f" vs {against}" if against != "" else ""
    puts("SWr", f"NEWLY FAILED TESTS{vs}", NEWLINE=True)
    if len(failures) == 0:
        let compared: str = f" compared to {against}" if against != "" else ""
        puts("SKg", f"  No new failures{compared}", NEWLINE=True)
        print
        return
    var tests: []TestName_T = []
    var builds: {TestName_T}[]BuildLabel_T = {:}
    for f in failures:
        if f.test not in builds:
            tests.append(f.test)
            builds[f.test] = []
        if f.build not in builds[f.test]:
            builds[f.test].append(f.build)
    var width: int = 0
    for test in tests:
        width = max(width, len(test))
    for test in tests:
        stdout.write("  ")
        puts("SWr", test)
        print " " * (width - len(test)) + "  " + ", ".join(builds[test])
    print

def list_changes(baseline: BaselineNr_T, failures: []NewFailure, against: str, user: Committer):
    """What changed in TACT BASELINE and what broke: by committer -- only
    USER, when not "" -- the files the CFMUTEST baseline built on it
    changed, by type; then FAILURES, the tests its Tlogs report newly
    failing or crashed, each with the build(s) it fails in -- new against
    AGAINST, the Tlogs' reference baselines. The failures are the whole
    baseline's, whoever's changes caused them."""
    hr('#')
    puts("SWr", "CHANGES BY COMMITTER", NEWLINE=True)
    let report: Path = changes_report(baseline)
    if report != "":
        list_files_by_committer(report, user)
    else:
        print # after the warning
    list_new_failures(against, failures)

def list_detailed_changes(baseline: BaselineNr_T, user: Committer):
    """The changes in the CFMUTEST baseline built on TACT BASELINE, by
    committer and branch -- only USER's, when not "": each file, its
    commits, tickets, reviews and diffs. Nothing when there is no changes
    report, or no change by USER: list_changes has said why."""
    let report: Path = changes_report(baseline, warn=False)
    return if report == ""
    var changes: ChangesReport = ChangesReport(report)
    changes.keep_only(user)
    return if user != "" and len(changes.committers) == 0
    hr('#')
    puts("SWr", "LIST OF CHANGES", NEWLINE=True)
    # a branch's build is compared with the baseline before this one
    let reference: BaselineName_T = "TACT.TACT_CONFIG." + Baseline(baseline).previous().nr
    print "DIFF and NET DIFF run in the file's submodule of the NM workspace. Where that is"
    print "not checked out, they check the file out first, alone (Tcheckout): the submodule's"
    print "history, its contents fetched as the diffs need them. A submodule checked out"
    print "already needs the commits and the baseline tags fetched:"
    print "    git -C $CMA_WORKSPACE_NM_REPOSITORY_DIRECTORY/<system>/<subsystem> fetch --tags"
    print "Without a workspace (CMA_WORKSPACE_NM_REPOSITORY_DIRECTORY unset), they clone the"
    print "file's repository from Bitbucket into $TCHECK_NM_CACHE (default"
    print "~/Downloads/.cache/tcheck/NM), and fetch there what it lacks."
    print
    for who in changes.committers:
        stdout.write("===================================== Files committed by user ")
        puts("Wb", who)
        print " ====================================="
        for branch in changes.branches[who]:
            print "---------------------------------"
            display_branch_info(branch, reference)
            for fc in changes.files[branch]:
                print "---------------------------------"
                fc.display()
        print
        print
    if len(changes.unattributed) > 0:
        print "===================================== Files with no branch merged above them ====================================="
        for fc in changes.unattributed:
            fc.display()
        print
    print
    echo_emacs(report)
    print

# ---------------------------------------------------------------------------
# Options
# ---------------------------------------------------------------------------

def usage():
    print "  This script will report the status of a baseline build,"
    print "  scan the size of replay_dirs of all baselines of the same branch."
    print "  See how_to_tactdev for tips for buildmaster."
    print f"  usage: {PROG} [-c] [-s] [-h] [-v] [-f] [-l] [-batch] [-focus <domain> [<detail>] [-short]] [<BASELINE>]"
    print f"  Example: {PROG} -c 30.0.0.120"
    print f"  Example: {PROG} -focus IP mono 30.0.0.120"
    print f"  Example: {PROG} -focus replay run_prequal 30.0.0.120"
    print f"  Example: {PROG} -user alice -short 30.0.0.120      (-focus changes alice)"
    print "Options:"
    print "  -no-color    Plain output, without ANSI colours (colour is the default)."
    print "  -c           Coloured output; the default, kept for older scripts."
    print "  -s           Compute the sizes of replay dirs (no parameter expected for -s)."
    print "  -h           Display this help message and exit."
    print "  -f           Fast mode: skip run check_run_test_programs_log."
    print "  -v           Enable the VERBOSE option (more info)."
    print "  -l           List available builds and replays for the baseline, then exit."
    print "  -batch       Non-interactive: no diff tool and no emacs in troubleshoot mode,"
    print "               and Emacs ediff links in the list of changes whatever -tool says."
    print "  -tool <name> The visual diff tool: meld, kompare, kdiff3, ... In the list of"
    print "               changes the diff links open it (git difftool -t <name>) rather"
    print "               than Emacs ediff; troubleshoot mode compares with it (meld"
    print "               when no -tool is given)."
    print "  -meld        Same as -tool meld; kept for older scripts."
    print "  -only-new    Show only new failures and regressions."
    print "  -exit-code   Exit with non-zero status if new failures are found."
    print "  -focus <domain> [<detail>]"
    print "               Focus on a specific domain and optionally a detail within it."
    print "               domain: IP, OP, SIP, replay, build_info, or changes"
    print "               detail: a build subtype (in, mono, assert, ...), a replay type,"
    print "               or for changes a committer: -focus changes alice, only alice's."
    print "  -short       With -focus, leave out the detailed part: for changes, the files"
    print "               per committer by type, without the list of each file's changes."
    print "  -user <name> Only the changes of committer <name>: -focus changes <name>."
    print "  <BASELINE>   Required if -c or -v is specified, or if no options are given."
    quit(1)

def parse_subtype(arg: str) -> BuildSubtype:
    """Parse a subtype name from a command-line argument."""
    for st in BuildSubtype:
        if subtype_label(st) == arg:
            return st
    die("invalid subtype: " + arg)

class Options:
    colored      : bool = True
    compute_size : bool = False
    verbose      : bool = False
    fast_mode    : bool = False
    list_only    : bool = False
    focus_domain  : FocusDomain  = no_focus
    focus_subtype : BuildSubtype = in_test
    focus_rtype   : ReplayType   = run_prequal
    focus_user    : Committer    = "" # -focus changes <user>: only theirs
    batch         : bool = False
    tool          : Tool_T = "" # -tool: the visual diff tool
    only_new      : bool = False
    short         : bool = False # -short: -focus without the detailed part
    exit_code     : bool = False
    baseline      : BaselineNr_T = "" # e.g. 30.0.0.121

    def __init__(self, argv: []str):
        var i: Natural = 0
        var user: Committer = "" # -user: see after the loop
        while i < argv'Length:
            let arg: str = argv[i]
            case arg:
                when "-c":     self.colored = True
                when "-no-color":  self.colored = False
                when "-s":     self.compute_size = True
                when "-h":     usage()
                when "-v":     self.verbose = True
                when "-f":     self.fast_mode = True
                when "-l":     self.list_only = True
                when "-batch":     self.batch = True
                when "-tool":
                    i += 1
                    die("-tool requires the name of a diff tool, e.g. -tool meld") if i >= argv'Length
                    self.tool = argv[i]
                    # it goes into a shell command: a tool's name, not a command line
                    die(f"-tool: not a diff tool's name: {self.tool}") if self.tool != /^[A-Za-z0-9_.+-]+$/
                when "-meld":      self.tool = "meld"
                when "-only-new":  self.only_new = True
                when "-short":     self.short = True
                when "-user":
                    # -user alice: -focus changes alice, anywhere on the line
                    i += 1
                    die("-user requires a committer's name, e.g. -user alice") if i >= argv'Length
                    user = argv[i]
                when "-exit-code": self.exit_code = True
                when "-focus":
                    i += 1
                    die("-focus requires at least one argument") if i >= argv'Length
                    let domain_arg: str = argv[i]
                    # Peek at the next arg for detail.
                    var detail_arg: str = ""
                    if i + 1 < argv'Length and not argv[i + 1].startswith("-"):
                        let next: str = argv[i + 1]
                        if next != "" and not next[0].isdigit():
                            detail_arg = next
                            i += 1
                    let IP_SUBTYPES: []str = ["in", "mono", "lo", "hi", "memcheck", "with_secondary"]
                    let OP_SUBTYPES: []str = ["in", "assert"]
                    let SIP_SUBTYPES: []str = ["in"]
                    case domain_arg:
                        when "IP":
                            if detail_arg == "":
                                self.focus_domain = focus_IP
                            else:
                                die("invalid subtype for IP: " + detail_arg) if detail_arg not in IP_SUBTYPES
                                self.focus_domain = focus_IP
                                self.focus_subtype = parse_subtype(detail_arg)
                        when "OP":
                            if detail_arg == "":
                                self.focus_domain = focus_OP
                            else:
                                die("invalid subtype for OP: " + detail_arg + " (OP only has in, assert)") if detail_arg not in OP_SUBTYPES
                                self.focus_domain = focus_OP
                                self.focus_subtype = parse_subtype(detail_arg)
                        when "SIP":
                            if detail_arg == "":
                                self.focus_domain = focus_SIP
                            else:
                                die("invalid subtype for SIP: " + detail_arg) if detail_arg not in SIP_SUBTYPES
                                self.focus_domain = focus_SIP
                                self.focus_subtype = parse_subtype(detail_arg)
                        when "replay":
                            die("-focus replay requires a replay type") if detail_arg == ""
                            try:
                                self.focus_domain = focus_replay
                                self.focus_rtype = ReplayType(detail_arg)
                            except:
                                die("invalid replay type: " + detail_arg)
                        when "build_info":
                            die("-focus build_info takes no detail") if detail_arg != ""
                            self.focus_domain = focus_build_info
                        when "changes":
                            # the detail, if any, is a committer: -focus changes alice
                            self.focus_domain = focus_changes
                            self.focus_user = detail_arg
                        when others:
                            die("invalid focus domain: " + domain_arg + " (expected IP, OP, SIP, replay, build_info, changes)")
                when others:
                    if arg.startswith("-"):
                        stderr.writeLine("Invalid option: " + arg)
                        usage()
                    self.baseline = arg
            i += 1
        if user != "":
            let domain: str = self.focus_domain'Image.removeprefix("focus_")
            die(f"-user shows the changes: not with -focus {domain}") if self.focus_domain not in [no_focus, focus_changes]
            die(f"-user {user} and -focus changes {self.focus_user}: one committer only") if self.focus_user not in ["", user]
            self.focus_domain = focus_changes
            self.focus_user = user
        # Colour says nothing about which baseline: -s alone needs none.
        if (self.verbose or self.list_only or self.focus_domain != no_focus or not self.compute_size) and self.baseline == "":
            stderr.writeLine("Error: <BASELINE> is required.")
            usage()

# ---------------------------------------------------------------------------
# Pieces the summary and the new-failures diff are built from
# ---------------------------------------------------------------------------

type BuildSummary is tuple:
    build_name : BuildName_T
    btype      : BuildType
    total_new  : int
    total_still: int
    total_crash: int
    all_ok     : bool

def check_replay_dirs_size():
    """Scan replay directories for disk usage and deletion advice."""
    hr('-')
    puts("SWr", "COMPUTE SIZE OF REPLAY DIRS", NEWLINE=True)
    let listing: []str = shellLines: ls -d {TACT_ROOT}/TACT_CONFIG![0-9]*/build_G!*OP*/saved_logs/replay_dir*
    var total_size: float = 0.0
    for found in listing:
        continue if found == ""
        let replay_dir: Path = Path(found)
        hr('-')
        # Extract replay type from dir name.
        let dir_basename: str = replay_dir.name
        let replay_type: str = dir_basename.split("-")[-1].split(".")[0] if "-" in dir_basename else dir_basename
        # Get size.
        let du_r = shell: du --max-depth=0 -ch {!replay_dir} | head -n1
        let size_line: str = du_r.output.strip()
        let size_str: str = size_line.split()[0] if size_line != "" else "0"
        puts("SBy", f"{replay_dir} ==> {size_str}", NEWLINE=True)
        # Only count sizes in GB.
        continue if not size_str.endswith("G")
        let num_size: float = float(size_str[0:-1])
        # Find the replay log to check if it terminated.
        let saved_logs: Path = replay_dir.parent
        let log_listing: []str = shellLines: ls {saved_logs}/Treplay*{replay_type}*log
        var replay_logfile: Path = Path("")
        if log_listing'Length > 0 and log_listing[0] != "":
            replay_logfile = Path(log_listing[0])
        else:
            let find_r: []str = shellLines: find {replay_dir} -type f -name "*replay_day.log"
            if find_r'Length > 0:
                replay_logfile = Path(find_r[0])
        if replay_logfile != "" and ReplayLog(replay_logfile).terminated:
            total_size = total_size + num_size
            print "\tTO DELETE THIS FAILED REPLAY, 'su cmadm' and then"
            # Check for tactdev_remove script.
            let the_baseline: str = str(saved_logs).split("!")[1].split("/")[0] if "!" in saved_logs else ""
            let remove_cmd: Path = replay_dir / "tact" / the_baseline / "tactdev_remove"
            if -f remove_cmd:
                print "\t\t" + remove_cmd
            else:
                print "\tNo tactdev_remove found, use:"
                print f"\t\trm -fr {replay_dir}"
        else:
            puts("SFBy", "\tTHIS REPLAY IS STILL RUNNING", NEWLINE=True)
            print "\tTo delete it, use the vncviewer from dhdevd01:99 and run:"
            print "\t\tTcleanup_old_replay_users -kill_replay"
    print
    puts("Wb", f"TOTAL SIZE for FAILED REPLAYS is {total_size:.2f}G", NEWLINE=True)
    hr('#')

# ---------------------------------------------------------------------------
# Troubleshoot helpers (from hek-troubleshoot.sh -- detailed prev-vs-current comparisons)
# ---------------------------------------------------------------------------

def grep_logfile(filepath: Path, max_errors: Positive = 100) -> str:
    # No `2>/dev/null` on any of these: a capturing shell keeps the two
    # streams apart, so what rg says about a file it cannot read is in
    # r.stderr and never in r.output. A missing log is the ordinary case
    # here, which is why the redirect was on every line to begin with.
    let r = shell(join = ";"):
        rg -l analyze_core {filepath}
        rg FATAL {filepath} | head -{max_errors}
        rg 'SEVERE.*Description' {filepath} | head -{max_errors}
        pyrg RAISED_EXCEPTION {filepath} | head -100
        pyrg EDIFF_FILES {filepath} | head -100
    let output: str = r.output.strip()
    if output != "":
        print output
    return output

def find_core_dumps(dir: Path):
    # find core files bigger than 600MB
    let r = shell: fd -l --size +600M core {dir}
    if r.output.strip() != "":
        puts("SWr", "CORE DUMPS:", NEWLINE=True)
        print r.output.rstrip("\n")

def make_report(content: str, bl: BaselineNr_T, report_name: str) -> Path:
    let rc0: int = shell: mkdir -p /tmp/reports
    let report_file: Path = Path("/tmp/reports") / (report_name + "_" + bl + ".txt")
    writeFile(report_file, content)
    let rc: int = shell: make_comparable {report_file} {bl} 2>/dev/null
    return report_file

def replay_dir_pattern(rtype: ReplayType) -> Glob_T:
    """What the replay directories of RTYPE have in their names."""
    case rtype:
        when performance: return "TAC_LO3"
        when others:      return rtype'Image

def scan_replay_dir_detailed(replay_log_dir: Path, bl: BaselineNr_T, rtype: ReplayType) -> Path:
    if replay_log_dir == "":
        puts("SWb", "no replay log dir found", NEWLINE=True)
        return Path("")
    puts("USBy", "REPLAY DIR: " + replay_log_dir, NEWLINE=True)
    let replay_root: Path = replay_log_dir.parent.parent.parent
    find_core_dumps(replay_root)
    var report: str = ""
    let check_result: []str = shellLines: ls {replay_log_dir}/*check_logs.result.svlog
    for f in check_result:
        continue if f == ""
        puts("SWb", "check_logs.result.svlog:", NEWLINE=True)
        let content: str = readFile(Path(f))
        print content
        report = report + content + "\n"
    let check_run: []str = shellLines: ls {replay_log_dir}/*check_logs.run.svlog
    for f in check_run:
        continue if f == ""
        puts("SWb", "check_logs.run.svlog:", NEWLINE=True)
        let content: str = readFile(Path(f))
        print content
        report = report + content + "\n"
    return make_report(report, bl, f"replay-{rtype}")

def make_comparable(logfile: Path, bl: BaselineNr_T) -> Path:
    """Normalize a log file for diffing: make_executable_output_comparable + make_comparable + test name normalization."""
    let rc0: int = shell: mkdir -p /tmp/reports
    let out_file: Path = Path("/tmp/reports") / (bl + "_" + logfile.name)
    let rc1: int = shell: make_executable_output_comparable {!logfile} -o {!out_file} 2>/dev/null
    let rc2: int = shell: make_comparable {!out_file} {bl} 2>/dev/null
    # Normalize test names so trivial renames don't show as diffs.
    let rc3: int = shell(join = ";"):
        sd '[vb]1.el' 'test1.el' {out_file}
        sd '[vb]2.el' 'test2.el' {out_file}
        sd '[vb]3.el' 'test3.el' {out_file}
    return out_file

class CsystemLog:
    """A baseline's Csystem_build.log, the log of its IP build. For now it
    is compared as text, normalized so that what always differs --
    timestamps, pids, paths -- does not show; the place for a closer look,
    by what it builds and what fails, when one is wanted."""
    file    : Path
    baseline: BaselineNr_T

    def __init__(self, baseline: Baseline):
        self.file = baseline.saved_logs_dir(IP).parent / "Csystem_build.log"
        self.baseline = baseline.nr

    def comparable(self) -> Path:
        """A normalized copy of the log, under /tmp/reports."""
        make_comparable(self.file, self.baseline)

    def compare_with(self, older: CsystemLog):
        """How this log differs from OLDER's: in the troubleshoot tool, or
        as a diff in batch mode."""
        let before: Path = older.comparable()
        let after: Path = self.comparable()
        if BATCH:
            let rc: int = shell: diff {!before} {!after}
        else:
            let tool: Tool_T = troubleshoot_tool()
            let rc: int = shell: {!tool} {!before} {!after} &

# ---------------------------------------------------------------------------
# The run itself
# ---------------------------------------------------------------------------


class Report:
    """A report on one baseline, shaped by the command-line options.

    The report functions were free functions taking a context; they are
    methods now. What they need is three things -- what was asked for
    (Options), which baseline (Baseline), and what that baseline holds on
    disk (its builds and replays, which the Baseline lists) -- and a
    Report holds exactly those.

    """
    opt     : Options
    cur     : Baseline

    def __init__(self, opt: Options):
        self.opt = opt
        self.cur = Baseline(opt.baseline)
        if not -d self.cur.dir:
            puts("SWb", "DIR " + str(self.cur.dir) + " does not exist", NEWLINE=True)
            quit(1)
        self.cur.find_builds()
        self.cur.find_replays()

    def show_header(self):
        puts("SWr", "AVAILABLE BUILDS for " + str(self.cur.dir) + ":", NEWLINE=True)
        for build in self.cur.builds:
            print build.name
        puts("SWr", "AVAILABLE REPLAYS for " + str(self.cur.dir) + ":", NEWLINE=True)
        for replay in self.cur.replays:
            print replay.rtype'Image + "  " + str(replay.file)
        if self.opt.list_only:
            quit(0)
        hr('#')

    def show_regression_tests(self):
        puts("SWr", "TESTS", NEWLINE=True)
        for build in self.cur.builds:
            case self.opt.focus_domain:
                when focus_IP:  continue if build.btype != IP
                when focus_OP:  continue if build.btype != OP
                when focus_SIP: continue if build.btype != SIP
                when focus_replay | focus_build_info | focus_changes: break
                when no_focus:  pass
            puts("USBy", "PROCESSING " + build.name + " ...", NEWLINE=True)
            for subtype in BuildSubtype:
                continue if self.opt.focus_domain in (focus_IP, focus_OP, focus_SIP) and subtype != self.opt.focus_subtype
                stderr.writeLine(PROG + ": checking " + build.name + " / " + subtype_label(subtype))
                build.process_subtype(subtype)

    def show_replays(self):
        hr('#')
        puts("SWr", "REPLAYS", NEWLINE=True)
        if self.cur.replays'Length == 0:
            puts("SWb", "WARNING: NO REPLAYS FOUND", NEWLINE=True)
        for replay in self.cur.replays:
            continue if self.opt.focus_domain == focus_replay and replay.rtype != self.opt.focus_rtype
            process_replay(replay, self.opt.verbose)

    def show_build_info(self):
        for b in self.cur.builds:
            if b.btype == IP:
                b.show_padactl()
                b.check_test_programs(self.opt.fast_mode)
                break

    def collect_build_summary(self, build: Build) -> BuildSummary:
        """Collect test result counts across all subtypes for one build."""
        var total_new: int = 0
        var total_still: int = 0
        var total_crash: int = 0
        var all_ok: bool = True
        for subtype in BuildSubtype:
            for pass_ in BuildPass:
                let full_path: Path = build.tlog_path(subtype, pass_)
                if -f full_path:
                    let tlog: Tlog = Tlog(full_path, subtype)
                    total_new = total_new + tlog.new_failing'Length
                    total_still = total_still + tlog.still_fail'Length
                    total_crash = total_crash + tlog.crashed'Length
                    if not tlog.all_ok():
                        all_ok = False
        return (build_name: build.name, btype: build.btype,
                total_new: total_new, total_still: total_still,
                total_crash: total_crash, all_ok: all_ok)

    def show_summary(self):
        """Print a one-screen summary of the baseline's health."""
        hr('#')
        puts("SWr", f"SUMMARY for BASELINE {self.cur.nr}", NEWLINE=True)
        for build in self.cur.builds:
            let s: BuildSummary = self.collect_build_summary(build)
            var status: str = ""
            if s.all_ok:
                status = "OK"
            else:
                var parts: []str = []
                if s.total_crash > 0:
                    parts.append(str(s.total_crash) + " crashed")
                if s.total_new > 0:
                    parts.append(str(s.total_new) + " new")
                    HAS_NEW_FAILURES = True
                if s.total_still > 0:
                    parts.append(str(s.total_still) + " still failing")
                status = ", ".join(parts)
            puts("SWb", f"  {s.btype:<4}")
            if s.all_ok:
                puts("SKg", " " + status, NEWLINE=True)
            elif s.total_new > 0 or s.total_crash > 0:
                puts("SWr", " " + status, NEWLINE=True)
            else:
                puts("SKy", " " + status, NEWLINE=True)
        # Replays.
        var replay_ok: int = 0
        var replay_fail: int = 0
        var replay_busy: int = 0
        for replay in self.cur.replays:
            case ReplayLog(replay.file).status:
                when succeeded:          replay_ok += 1
                when failed:             replay_fail += 1
                when not_started | busy: replay_busy += 1
        puts("SWb", "  Replays: ")
        if replay_fail > 0:
            puts("SWr", f"{replay_ok} ok, {replay_fail} FAILED, {replay_busy} running", NEWLINE=True)
        else:
            puts("SKg", f"{replay_ok} ok, {replay_busy} running", NEWLINE=True)
        hr('#')

    def tlogs(self) -> []TlogAt:
        """This baseline's Tlogs, one per build and subtype that has one."""
        var found: []TlogAt = []
        for build in self.cur.builds:
            for subtype in BuildSubtype:
                let path: Path = build.tlog_path(subtype, normal)
                if -f path:
                    found.append((build: f"{build.btype} {subtype_label(subtype)}", subtype: subtype, path: path))
        found

    def new_failures(self) -> []NewFailure:
        """The tests this baseline's Tlogs report newly failing or crashed,
        as they report them -- new against each Tlog's own reference
        baseline -- with the build type and subtype each fails in; in build,
        subtype, Tlog order. Comparing with the previous baseline is for the
        detailed views, where the causes are looked for."""
        var found: []NewFailure = []
        for t in self.tlogs():
            for name in Tlog(t.path, t.subtype).failed_test_names():
                found.append((build: t.build, test: name))
        if len(found) > 0:
            HAS_NEW_FAILURES = True
        found

    def tlog_references(self) -> str:
        """The baselines this baseline's Tlogs compared with, each once, as
        they come: "30.0.0.131", or "30.0.0.131, 30.0.0.129" when a build
        was compared with an older one; "" when none says."""
        var refs: []str = []
        for t in self.tlogs():
            let ref: BaselineNr_T = Tlog(t.path, t.subtype).reference
            if ref != "" and ref not in refs:
                refs.append(ref)
        ", ".join(refs)

    def show_new_failures(self):
        """Show the tests the Tlogs report newly failing or crashed."""
        let against: str = self.tlog_references()
        let vs: str = f" vs {against}" if against != "" else ""
        hr('-')
        puts("SWr", f"NEW FAILURES{vs}", NEWLINE=True)
        let failures: []NewFailure = self.new_failures()
        for f in failures:
            puts("SWr", f"  NEW: {f.build} {f.test}", NEWLINE=True)
        if len(failures) == 0:
            let compared: str = f" compared to {against}" if against != "" else ""
            puts("SKg", f"  No new failures{compared}", NEWLINE=True)

    def write_history(self):
        """Append a one-line summary to ~/.tcheck_history."""
        let history_file: Path = Path($HOME) / ".tcheck_history"
        var total_new: int = 0
        var total_fail: int = 0
        for build in self.cur.builds:
            let s: BuildSummary = self.collect_build_summary(build)
            total_new = total_new + s.total_new
            total_fail = total_fail + s.total_still + s.total_crash
        let timestamp: str = str(int(time.time()))
        let line: str = f"{self.cur.nr} | {total_new} new, {total_fail} total failing | {timestamp}\n"
        let rc: int = shell: echo {!line} >> {!history_file}

    def show_detailed_build_info(self):
        let prev: CsystemLog = CsystemLog(self.cur.previous())
        let cur: CsystemLog = CsystemLog(self.cur)
        puts("SWr", "Compare Csystem_build.log:", NEWLINE=True)
        print f"  prev: {prev.file}"
        print f"  cur:  {cur.file}"
        cur.compare_with(prev)

    def show_detailed_regression_tests(self):
        var btype: BuildType = IP
        case self.opt.focus_domain:
            when focus_IP:  btype = IP
            when focus_OP:  btype = OP
            when others: pass
        let subtype: BuildSubtype = self.opt.focus_subtype
        let prev: Baseline = self.cur.previous()
        let prev_report: Path = prev.scan_regression_tests(btype, subtype)
        let cur_report: Path = self.cur.scan_regression_tests(btype, subtype)
        if prev_report != "" and cur_report != "" and not BATCH:
            let tool: Tool_T = troubleshoot_tool()
            let tool_rc: int = shell: {!tool} {!prev_report} {!cur_report} &
        # made here as well: the scans only make it when they find logs
        let reports: Path = Path("/tmp/reports")
        reports.mkdir()
        let failed_file: Path = reports / "failed_tests"
        let failed_output: str = self.cur.show_failed_tests(btype, subtype)
        writeFile(failed_file, failed_output)
        if not BATCH:
            let emacs_rc: int = shell: emacs -l /home/ekhassan/e.el {!failed_file} &

    def show_detailed_replays(self):
        let rtype: ReplayType = self.opt.focus_rtype
        let prev: Baseline = self.cur.previous()
        let prev_log: Path = prev.replay_log_dir(rtype)
        let cur_log: Path = self.cur.replay_log_dir(rtype)
        let prev_report: Path = scan_replay_dir_detailed(prev_log, prev.nr, rtype)
        let cur_report: Path = scan_replay_dir_detailed(cur_log, self.cur.nr, rtype)
        if prev_report != "" and cur_report != "" and not BATCH:
            let tool: Tool_T = troubleshoot_tool()
            let tool_rc: int = shell: {!tool} {!prev_report} {!cur_report} &

    def run(self):
        if self.opt.compute_size:
            check_replay_dirs_size()
            quit(0)
        # -short: what each focus shows first, without its details
        case self.opt.focus_domain:
            when focus_replay:
                self.show_replays()
                if not self.opt.short:
                    self.show_detailed_replays()
            when focus_IP | focus_OP | focus_SIP:
                self.show_regression_tests()
                if not self.opt.short:
                    self.show_detailed_regression_tests()
            when focus_changes:
                list_changes(self.cur.nr, self.new_failures(), self.tlog_references(), self.opt.focus_user)
                if not self.opt.short:
                    list_detailed_changes(self.cur.nr, self.opt.focus_user)
            when focus_build_info:
                self.show_build_info()
                if not self.opt.short:
                    self.show_detailed_build_info()
            when no_focus:
                self.show_summary()
                self.show_new_failures()
                self.show_header()
                self.show_regression_tests()
                self.show_build_info()
                self.show_replays()
                list_changes(self.cur.nr, self.new_failures(), self.tlog_references(), "")
        self.write_history()
        if self.opt.exit_code and HAS_NEW_FAILURES:
            quit(1)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

let args: []str = $@
if $# == 0:
    usage()

let opt: Options = Options(args)
COLORED = opt.colored
BATCH = opt.batch
DIFF_TOOL = "" if opt.batch else opt.tool
ONLY_NEW = opt.only_new

var report: Report = Report(opt)
report.run()
