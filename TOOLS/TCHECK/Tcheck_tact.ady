#!/usr/bin/env ady2nim
#ady2nim-args c -d:release
"""Tcheck_tact — report the status of a TACT baseline build.

Scans Tlog files for test results (crashed, failing, successful),
replay status, gnatcheck/Padactl summary, and file changes.

Translated from the ksh original in TOOL/COMMON_UTILS.
"""

nimport os
nimport time

let PROG: str = Path($0).name.lstrip(".")

def die(msg: str):
    stderr.writeLine(PROG + ": " + msg)
    quit(1)

# ---------------------------------------------------------------------------
# ANSI color helpers
# ---------------------------------------------------------------------------
# The ksh version encodes colors as a spec string like "sWr" where:
#   Style:   S=bold(1) D=dim(2) I=italic(3) U=underline(4) F=blink(5) N=overline(7) H=hidden(8) T=strike(9)
#            s=bold(1) d=dim(2) i=italic(3) u=underline(4) f=blink(5) n=overline(7) h=hidden(8) t=strike(9)
#   Fg:      K=black(30) R=red(31) G=green(32) Y=yellow(33) B=blue(34) M=magenta(35) C=cyan(36) W=white(37)
#   Bg:      k=black(40) r=red(41) g=green(42) y=yellow(43) b=blue(44) m=magenta(45) c=cyan(46) w=white(47)

let ANSI_CODES: {str}str = {
    "S": "1", "D": "2", "I": "3", "U": "4", "F": "5", "N": "7", "H": "8", "T": "9",
    "s": "1", "d": "2", "i": "3", "u": "4", "f": "5", "n": "7", "h": "8", "t": "9",
    "K": "30", "R": "31", "G": "32", "Y": "33", "B": "34", "M": "35", "C": "36", "W": "37",
    "k": "40", "r": "41", "g": "42", "y": "43", "b": "44", "m": "45", "c": "46", "w": "47"
}
let RESET: str = "\x1b[0m"
var COLORED: bool = False
var BATCH: bool = False

def ansi_escape(spec: str) -> str:
    """Turn a color spec like 'sWr' into an ANSI escape sequence."""
    var codes: []str = []
    for ch in spec:
        let s: str = str(ch)
        if s in ANSI_CODES:
            codes.append(ANSI_CODES[s])
    if codes'Length == 0:
        return ""
    return "\x1b[" + ";".join(codes) + "m"

def cecho(spec: str, text: str):
    """Print TEXT in the color given by SPEC, with a newline."""
    if COLORED:
        print ansi_escape(spec) + text + RESET
    else:
        print text

def cechon(spec: str, text: str):
    """Print TEXT in color, without a trailing newline."""
    if COLORED:
        stdout.write(ansi_escape(spec) + text + RESET)
    else:
        stdout.write(text)

def hr(c: char = '#', length: int = 80):
    print c * length

# ---------------------------------------------------------------------------
# Build / subtype enums
# ---------------------------------------------------------------------------

type BuildSubtype is enum in_test, mono, assert_test, lo, hi, memcheck, with_secondary
type BuildType is enum IP, OP, SIP
type BuildPass is enum normal, mrun
type FocusDomain is enum no_focus, focus_IP, focus_OP, focus_SIP, focus_replay, focus_build_info

type Build is tuple:
    name  : str # e.g. build_G!31.IP.L8
    btype : BuildType

def subtype_label(st: BuildSubtype) -> str:
    """The file-system name for a subtype ('in' not 'in_test')."""
    let name: str = st'Image
    return name.replace("_test", "")

# ---------------------------------------------------------------------------
# Tlog section parsing
# ---------------------------------------------------------------------------

let SECTION_PATTERNS: []str = [
    "Crashed Tests",
    "New tests failing",
    "Tests that did not run",
    "Tests still failing",
    "Following tests are now successful",
    "Following tests contain known failures",
    "Errors in log files",
    "Tlog summary"
]

let REPORTED_PATTERNS: []str = SECTION_PATTERNS[:5] # only interested in the first 5 patterns.

type Section is tuple:
    pattern  : str
    start    : int
    end      : int

def find_sections(filepath: Path) -> []Section:
    """Find each SECTION_PATTERN's first occurrence, in file order."""
    type Hit is tuple:
        line : int
        pat  : str    
    let lines: []str = readFile(str(filepath)).split("\n")
    # Track which patterns have already been matched (first occurrence only).
    var seen: {}str = {}
    var hits: []Hit = []
    for i, line in enumerate(lines):
        for pattern in SECTION_PATTERNS:
            if pattern in line and pattern not in seen:
                hits.append((line: i, pat: pattern))
                seen.add(pattern)
                break
    [(pattern: cur.pat, start: cur.line, end: nxt.line) for cur, nxt in zip(hits, hits[1:])]


def process_Tlog(filepath: Path, build_subtype: BuildSubtype):
    """Parse a Tlog file and print a summary of test results.

    Scans for section headers (Crashed Tests, New tests failing, etc.),
    extracts the lines between consecutive headers, and prints them
    with coloring and formatting matching the ksh version's output.
    """
    let all_lines: []str = readFile(str(filepath)).split("\n")
    let sections: []Section = find_sections(filepath)
    def non_blank_lines(text: []str, start: int, end: int) -> []str:
        """Lines between start (exclusive) and end (exclusive) that are not blank."""
        [line for line in text[start + 1 : end] if line.strip() != ""]

    var at_least_one_failing: bool = False

    for section in sections:
        var is_reported: bool = False
        for rp in REPORTED_PATTERNS:
            if section.pattern == rp:
                is_reported = True
                break
        continue if not is_reported

        let body: []str = non_blank_lines(all_lines, section.start, section.end)

        if body'Length == 0:
            cechon("Kw", section.pattern)
            print "  ==> None"
            print ""
            continue

        # "Tests that did not run" is suppressed for mono builds.
        if section.pattern == "Tests that did not run" and build_subtype == mono:
            continue

        at_least_one_failing = True
        cecho("Kw", section.pattern)

        for line in body:
            if section.pattern == "Tests that did not run":
                print line
            elif section.pattern == "Crashed Tests":
                print "CRASHED TEST: " + line
            elif "Worse" in line or "Better" in line or "Same" in line:
                print line
            else:
                # A failing test line: extract the test name and #emacs: link.
                let parts: []str = line.split()
                let failed_test: str = parts[1] if parts'Length > 1 else line.strip()
                stdout.write("\t")
                cecho("sKy", failed_test)
                let emacs_at: int = line.find("#emacs")
                if emacs_at >= 0:
                    print line[emacs_at:]
                else:
                    print ""
            print ""

    if not at_least_one_failing:
        print ""
        cecho("Kw", ".............. ALL TESTS ARE SUCCESSFUL !!!!")


def echo_emacs(filepath: Path):
    """Print an #emacs: link for FILEPATH."""
    cecho("sBw", "Look for details in:")
    print f"#emacs:(progn(find-file \"{filepath}\"))"

# ---------------------------------------------------------------------------
# Replay logs
# ---------------------------------------------------------------------------

type ReplayType is enum run_prequal, performance, simca, full_simca, oldest_date, all_autolink

def replay_type_from(filename: str) -> ?ReplayType:
    """Extract the replay type from a Treplay log filename.

    Treplay_G!31.OP.L8_30.0.0.128_2026.09.16_22:01:59-performance.dt6Uo.log
    """
    case filename:
        when /run_prequal/:   return run_prequal
        when /performance/:   return performance
        when /full_simca/:    return full_simca
        when /simca/:         return simca
        when /oldest_date/:   return oldest_date
        when /all_autolink/:  return all_autolink
        when others:          return None

type Replay is tuple:
    rtype : ReplayType
    file  : Path

def find_replays_to_be_processed(basedir: Path) -> []Replay:
    """Find replay log files, one per replay type, in canonical order."""
    let listing: []str = shellLines: ls -d {basedir}/build_*OP*/saved_logs/Treplay_*.log 2>/dev/null

    var type_to_file: [ReplayType]str
    for filepath in listing:
        continue if filepath == ""
        let rt: ?ReplayType = replay_type_from(filepath)
        continue if rt is None
        type_to_file[rt.get()] = filepath

    var result: []Replay = []
    for rtype, filepath in enumerate(type_to_file):
        continue if filepath == ""
        result.append((rtype: rtype, file: Path(filepath)))
    return result

def process_replay(replay: Replay, verbose: bool):
    """Check the status of a single replay (successful / failed / running)."""
    let label: str = f"\"{replay.rtype'Image}\""
    cechon("sWb", f"{label:<14} replay ")

    let content: str = readFile(str(replay.file))
    if "Executed UNINSTALL:" in content and "YES" in content.split("Executed UNINSTALL:")[-1].split("\n")[0]:
        cecho("sWb", "==> WAS SUCCESSFUL")
    elif "Executed UNINSTALL:" in content and "NO" in content.split("Executed UNINSTALL:")[-1].split("\n")[0]:
        cecho("sWr", "==> FAILED")
        echo_emacs(replay.file)
        print ""
        if verbose:
            for line in content.split("\n"):
                continue if "ERROR_REPORT.SEVERE" not in line
                let basename_at: int = line.rfind("/")
                if basename_at >= 0:
                    print line[basename_at + 1:]
                else:
                    print line
    elif "Waiting for this replay to be finished" not in content:
        cecho("sWb", "---> WARNING: it looks like the replay hasn't started")
    else:
        cecho("sWb", "IS STILL BUSY")
    hr('-')

# ---------------------------------------------------------------------------
# Build processing (test results per build)
# ---------------------------------------------------------------------------

def grep_force_trace_in_dir(dir: str):
    """Grep for missing 'if Debug.Trace' guards in LO build logs."""
    if not -d Path(dir):
        cecho("sWb", "WARNING: '" + dir + "' does not exist!")
        return
    cecho("sWb", "Grep in " + dir + " to detect missing 'if Debug.Trace (...) then' (100 first errors, no matches means no errors detected):")
    let r = shell: for f in {dir}/*_out_*; do [ -e "$f" ] && grep -H -n -B1 '!!! ERROR : FORCE_TRACE message above' "$f" | grep -v '^--[[:space:]]*$'; done 2>/dev/null | head -n 100
    if r.output.strip() != "":
        print r.output.rstrip("\n")

def build_type_from(build_name: str) -> ?BuildType:
    """Extract the build type (IP, OP, SIP) from a build directory name.

    build_type_from("build_G!31.IP.L8") -> IP
    """
    case build_name:
        when /\.IP\./:  return IP
        when /\.OP\./:  return OP
        when /\.SIP\./: return SIP
        when others:    return None # BUG, implicit return not possible with optional type.

def show_tlog_if_present(build: Build, subtype: BuildSubtype,
                         pass_: BuildPass, tacot_corico_dir: str):
    """Show a Tlog file's summary if it exists, or a 'not ready' message."""
    def tlog_filename(subtype: BuildSubtype, pass_: BuildPass) -> str:
        """The Tlog filename for a subtype and pass."""
        let sl: str = subtype_label(subtype)
        case pass_:
            when normal: "Tlog-" + sl + ".log"
            when mrun: "Tlog-mrun-" + sl + ".log"    
    let file: str = tlog_filename(subtype, pass_)
    let full_path: Path = Path(tacot_corico_dir) / "TACT_REGRESS_LOGS" / "LATEST" / file
    let sl: str = subtype_label(subtype)

    if -f full_path:
        stdout.write("=======================================  ")
        cechon("sWr", full_path.name)
        stdout.write(" ")
        cechon("sWb", " (" + build.name + ")")
        print "  ======================================="
        process_Tlog(full_path, subtype)
        print ""
        return

    case build.btype:
        when IP:
            return if subtype not in (in_test, mono)
        when OP:
            return if subtype not in (in_test, assert_test)
        when others:
            return
    if pass_ == mrun:
        cecho("sWb", "\"" + build.btype'Image + " " + sl + " mrun\" build not ready yet")
    else:
        cecho("sWb", "\"" + build.btype'Image + " " + sl + "\" build not ready yet")

def process_build_subtype(build: Build, subtype: BuildSubtype,
                          basedir: Path):
    """Process one subtype of a build, for both normal and mrun passes."""
    def tacot_dir(basedir: Path, build: Build, pass_: BuildPass) -> str:
        """The tacot_corico directory for a given pass."""
        case pass_:
            when normal: str(basedir / build.name / "saved_logs" / "tacot_corico.LATEST")
            when mrun: str(basedir / build.name / "saved_logs" / "tacot_corico_mrun.LATEST_GOOD")   
    def lo_build_checks(tacot_corico_latest: str):
        """Check for FORCE_TRACE errors in LO build logs."""
        let lo_logdir: str = tacot_corico_latest + "/work/logging-lo"
        if -e Path(lo_logdir):
            cecho("syB", "Doing lo-build checks in " + lo_logdir)
            grep_force_trace_in_dir(lo_logdir + "/LOGS")
            grep_force_trace_in_dir(lo_logdir + "/LOGS_others")             
    for pass_ in BuildPass:
        if pass_ == mrun and (build.btype != IP or subtype != in_test):    
            continue # we are only interested in "IP in" for the mrun pass
        let dir: str = tacot_dir(basedir, build, pass_)
        show_tlog_if_present(build, subtype, pass_, dir)
        if subtype == lo and pass_ == normal:
            lo_build_checks(dir)

# ---------------------------------------------------------------------------
# Padactl / Gnatcheck
# ---------------------------------------------------------------------------

def process_gnatcheck(ip_build: str, basedir: Path):
    """Show the Padactl/CRC summary from the IP build."""
    hr('#')
    cecho("sWr", "Padactl")
    let padactl_file: Path = basedir / ip_build / "saved_logs" / "Padactl.LATEST" / "Padactl.summary"
    if -f padactl_file:
        hr('-')
        cecho("sWb", str(padactl_file))
        let r = shell: grep -A20 delta {padactl_file}
        if r.output.strip() != "":
            print r.output.rstrip("\n")
        let r2 = shell: grep -A20 -i 'summary of last changes' {padactl_file}
        if r2.output.strip() != "":
            print r2.output.rstrip("\n")
        echo_emacs(padactl_file)
    else:
        cecho("sWb", "WARNING: No CRC summary file found!")

# ---------------------------------------------------------------------------
# Check build closure and test programs
# ---------------------------------------------------------------------------

def process_run_test_programs_log(ip_build: str, basedir: Path,
                                  baseline: str, fast_mode: bool):
    """Find or run check_run_test_programs_log from the IP build."""
    print ""
    hr('#')
    cecho("sWr", "Check build closure and test programs.")
    cecho("usBy", "CHECK RUN TEST PROGRAMS LOG FOR " + str(basedir / ip_build) + " ...")
    let find_lines: []str = shellLines: find {basedir}/{ip_build}/saved_logs/tacot_corico.LATEST/work -type f -name 'check_run_test_programs.log' -print -quit 2>/dev/null
    var logfile: str = ""
    if find_lines'Length > 0:
        logfile = find_lines[0]

    if logfile == "":
        if fast_mode:
            cecho("sWb", "check_run_test_programs_log not yet complete and we are in fast mode -> skip this check.")
        else:
            cecho("sWb", "check_run_test_programs_log not yet complete -> execute the program manually. This can take some minutes (run with -f to disable the execution).")
            let build_subtype: str = ip_build.replace("build_", "")
            let rc: int = shell: cd /tmp && echo check_run_test_programs_log | Ccontext -b "TACT.TACT_CONFIG.{baseline}" -e "{build_subtype}" 2>&1
    else:
        let mktemp_lines: []str = shellLines: cfmu_mktemp
        let full_report: str = mktemp_lines[0] if mktemp_lines'Length > 0 else "/tmp/tcheck_report.txt"
        print "Full report is found in " + full_report + "."
        print ""
        let cp_rc: int = shell: cp {logfile} {full_report}
        let filtered = shell: grep -v 'Running.*setup' {full_report} | grep -v 'Checking for errors' | grep -v 'No errors found in' | grep -v -E '^[0-9.]+:\s+\S+\s+INFORMATION:' | grep -E '\S'
        if filtered.output.strip() != "":
            print filtered.output.rstrip("\n")

# ---------------------------------------------------------------------------
# List all changes (placeholder — format has changed)
# ---------------------------------------------------------------------------

def list_all_changes(baseline: str):
    hr('#')
    cecho("sWr", "LIST OF CHANGES")
    print "listing all changes"

# ---------------------------------------------------------------------------
# Options
# ---------------------------------------------------------------------------

def usage():
    print "  This script will report the status of a baseline build,"
    print "  scan the size of replay_dirs of all baselines of the same branch."
    print "  See how_to_tactdev for tips for buildmaster."
    print f"  usage: {PROG} [-c] [-s] [-h] [-v] [-f] [-l] [-batch] [-focus <domain> [<detail>]] [<BASELINE>]"
    print f"  Example: {PROG} -c 30.0.0.120"
    print f"  Example: {PROG} -focus IP mono 30.0.0.120"
    print f"  Example: {PROG} -focus replay run_prequal 30.0.0.120"
    print "Options:"
    print "  -c           Show the coloured version."
    print "  -s           Compute the sizes of replay dirs (no parameter expected for -s)."
    print "  -h           Display this help message and exit."
    print "  -f           Fast mode: skip run check_run_test_programs_log."
    print "  -v           Enable the VERBOSE option (more info)."
    print "  -l           List available builds and replays for the baseline, then exit."
    print "  -batch       Non-interactive: skip meld and emacs in troubleshoot mode."
    print "  -focus <domain> [<detail>]"
    print "               Focus on a specific domain and optionally a detail within it."
    print "               domain: IP, OP, SIP, replay, or build_info"
    print "               detail: a build subtype (in, mono, assert, ...) or a replay type"
    print "  <BASELINE>   Required if -c or -v is specified, or if no options are given."
    quit(1)

class Options:
    colored      : bool = False
    compute_size : bool = False
    verbose      : bool = False
    fast_mode    : bool = False
    list_only    : bool = False
    focus_domain : FocusDomain = no_focus
    focus_detail : str  = ""
    batch        : bool = False
    baseline     : str  = "" # e.g. 30.0.0.121

    def __init__(self, argv: []str):
        var i: Natural = 0
        while i < argv'Length:
            let arg: str = argv[i]
            case arg:
                when "-c":     self.colored = True
                when "-s":     self.compute_size = True
                when "-h":     usage()
                when "-v":     self.verbose = True
                when "-f":     self.fast_mode = True
                when "-l":     self.list_only = True
                when "-batch": self.batch = True
                when "-focus":
                    i += 1
                    if i >= argv'Length:
                        die("-focus requires at least one argument")
                    let domain_arg: str = argv[i]
                    case domain_arg:
                        when "IP":         self.focus_domain = focus_IP
                        when "OP":         self.focus_domain = focus_OP
                        when "SIP":        self.focus_domain = focus_SIP
                        when "replay":     self.focus_domain = focus_replay
                        when "build_info": self.focus_domain = focus_build_info
                        when others:
                            die("invalid focus domain: " + domain_arg + " (expected IP, OP, SIP, replay, build_info)")
                    # Peek at the next arg: if it doesn't start with '-'
                    # and isn't a baseline (digits+dots), it's the detail.
                    if i + 1 < argv'Length and not argv[i + 1].startswith("-"):
                        let next: str = argv[i + 1]
                        if next != "" and not next[0].isdigit():
                            self.focus_detail = next
                            i += 1
                when others:
                    if arg.startswith("-"):
                        stderr.writeLine("Invalid option: " + arg)
                        usage()
                    self.baseline = arg
            i += 1
        if (self.colored or self.verbose or self.list_only or self.focus_domain != no_focus or not self.compute_size) and self.baseline == "":
            stderr.writeLine("Error: <BASELINE> is required.")
            usage()
        # Validate focus detail against domain.
        if self.focus_detail != "":
            case self.focus_domain:
                when focus_IP:
                    if self.focus_detail not in ("in", "mono", "lo", "hi", "memcheck", "with_secondary"):
                        die("invalid subtype for IP: " + self.focus_detail)
                when focus_OP:
                    if self.focus_detail not in ("in", "assert"):
                        die("invalid subtype for OP: " + self.focus_detail + " (OP only has in, assert)")
                when focus_SIP:
                    if self.focus_detail not in ("in",):
                        die("invalid subtype for SIP: " + self.focus_detail)
                when focus_replay:
                    try:
                        let rt: ReplayType = ReplayType(self.focus_detail)
                    except:
                        die("invalid replay type: " + self.focus_detail)
                when focus_build_info:
                    die("-focus build_info takes no detail")
                when no_focus:
                    die("-focus detail given without a domain")

def find_builds_to_be_processed(basedir: Path) -> []Build:
    """List build_G!* directories under basedir, returning name and type."""
    let SKIP_BUILD_PATTERNS: []str = ["92", "94", "95", "98", "30"]    
    let listing: []str = shellLines: ls -1d {basedir}/build_G!* 2>/dev/null
    var builds: []Build = []
    for line in listing:
        continue if line == ""
        let basename: str = Path(line).name # e.g. build_G!31.IP.L8
        continue if any(pat in basename for pat in SKIP_BUILD_PATTERNS)
        let bt: ?BuildType = build_type_from(basename)
        continue if bt is None
        builds.append((name: basename, btype: bt.get())) # auto-unwrap transpiler bug -> .get is necessary
    return builds
# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

if $CONTEXT_CM_BASELINE == "":
    print "Please use this script within a context"

let args: []str = $@
if $# == 0:
    usage()

let opt: Options = Options(args)
COLORED = opt.colored
BATCH = opt.batch

let baseline: str = opt.baseline
let basedir: Path = Path("/cm/ot/TACT/TACT_CONFIG." + baseline)

if opt.compute_size:
    # check_replay_dirs_size would go here.
    print "check_replay_dirs_size: not yet translated"
    quit(0)

if not -d basedir:
    cecho("sWb", "DIR " + str(basedir) + " does not exist")
    quit(1)

let builds_to_be_processed: []Build = find_builds_to_be_processed(basedir)
let replays_to_be_processed: []Replay = find_replays_to_be_processed(basedir)
let focus: FocusDomain = opt.focus_domain
let detail: str = opt.focus_detail

def show_header():
    cecho("sWr", "AVAILABLE BUILDS for " + str(basedir) + ":")
    for build in builds_to_be_processed:
        print build.name
    cecho("sWr", "AVAILABLE REPLAYS for " + str(basedir) + ":")
    for replay in replays_to_be_processed:
        print replay.rtype'Image + "  " + str(replay.file)
    if opt.list_only:
        quit(0)
    hr('#')

def show_regression_tests():
    cecho("sWr", "TESTS")
    for build in builds_to_be_processed:
        case focus:
            when focus_IP:  continue if build.btype != IP
            when focus_OP:  continue if build.btype != OP
            when focus_SIP: continue if build.btype != SIP
            when focus_replay | focus_build_info: break
            when no_focus:  pass
        cecho("usBy", "PROCESSING " + build.name + " ...")
        for subtype in BuildSubtype:
            continue if detail != "" and subtype_label(subtype) != detail
            stderr.writeLine(PROG + ": checking " + build.name + " / " + subtype_label(subtype))
            process_build_subtype(build, subtype, basedir)

def show_replays():
    hr('#')
    cecho("sWr", "REPLAYS")
    if replays_to_be_processed'Length == 0:
        cecho("sWb", "WARNING: NO REPLAYS FOUND")
    for replay in replays_to_be_processed:
        continue if detail != "" and replay.rtype'Image != detail
        process_replay(replay, opt.verbose)

def show_build_info():
    for b in builds_to_be_processed:
        if b.btype == IP:
            process_gnatcheck(b.name, basedir)
            process_run_test_programs_log(b.name, basedir, baseline, opt.fast_mode)
            break


# ---------------------------------------------------------------------------
# Troubleshoot helpers (from Ttroubleshoot — detailed prev-vs-current comparisons)
# ---------------------------------------------------------------------------

def previous_baseline_nr(bl: str) -> str:
    let parts: []str = bl.split(".")
    return ".".join(parts[0:-1]) + "." + str(int(parts[-1]) - 1)

def saved_logs_dir(bl: str, btype: BuildType) -> str:
    var env_id: str = $CM_ENV_ID
    case btype:
        when IP:  env_id = env_id.replace(".OP.", ".IP.")
        when OP:  env_id = env_id.replace(".IP.", ".OP.")
        when SIP: env_id = env_id.replace(".IP.", ".SIP.")
    return str(basedir) + "/../TACT_CONFIG." + bl + "/build_" + env_id + "/saved_logs"

def compute_baseline_prevdir(cur_dir: str) -> str:
    let parts: []str = cur_dir.split("/")
    var new_parts: []str = []
    for part in parts:
        if part.startswith("TACT_CONFIG."):
            var config_parts: []str = part.split(".")
            config_parts[-1] = str(int(config_parts[-1]) - 1)
            new_parts.append(".".join(config_parts))
        elif part.startswith("tacot_corico_"):
            new_parts.append("tacot_corico.LATEST")
        else:
            new_parts.append(part)
    return "/".join(new_parts)

def grep_logfile(filepath: str, max_errors: Positive = 100) -> str:
    let r = shell: ( rg -l analyze_core {filepath}; rg FATAL {filepath} | head -{max_errors}; rg 'SEVERE.*Description' {filepath} | head -{max_errors}; pyrg RAISED_EXCEPTION {filepath} | head -100; pyrg EDIFF_FILES {filepath} | head -100 ) 2>/dev/null
    let output: str = r.output.strip()
    if output != "":
        print output
    return output

def find_core_dumps(dir: str):
    let r = shell: fdcore {dir} 2>/dev/null
    if r.output.strip() != "":
        cecho("sWr", "CORE DUMPS:")
        print r.output.rstrip("\n")

def make_report(content: str, bl: str, report_name: str) -> str:
    let rc0: int = shell: mkdir -p /tmp/reports
    let report_file: str = "/tmp/reports/" + report_name + "_" + bl + ".txt"
    writeFile(report_file, content)
    let rc: int = shell: make_comparable.ksh {report_file} {bl} 2>/dev/null
    return report_file

def replay_dir_pattern(replay_type: str) -> str:
    case replay_type:
        when "performance": return "TAC_LO3"
        when "prequal":     return "run_prequal"
        when others:        return replay_type

def get_replay_log_dir(build_dir: str, replay_type: str) -> str:
    let dir_pat: str = replay_dir_pattern(replay_type)
    var dir: str = build_dir
    var attempts: int = 0
    while attempts < 20:
        let listing: []str = shellLines: ls -d {dir}/replay_dir*{dir_pat}*/work/logging/LOGS 2>/dev/null
        if listing'Length > 0 and listing[0] != "":
            return listing[0]
        dir = compute_baseline_prevdir(dir)
        stderr.writeLine(PROG + ": trying " + dir)
        attempts += 1
    return ""

def scan_replay_dir_detailed(replay_log_dir: str, bl: str, replay_type: str) -> str:
    if replay_log_dir == "":
        cecho("sWb", "no replay log dir found")
        return ""
    cecho("usBy", "REPLAY DIR: " + replay_log_dir)
    let replay_root: str = str(Path(replay_log_dir).parent.parent.parent)
    find_core_dumps(replay_root)
    var report: str = ""
    let check_result: []str = shellLines: ls {replay_log_dir}/*check_logs.result.svlog 2>/dev/null
    for f in check_result:
        continue if f == ""
        cecho("sWb", "check_logs.result.svlog:")
        let content: str = readFile(f)
        print content
        report = report + content + "\n"
    let check_run: []str = shellLines: ls {replay_log_dir}/*check_logs.run.svlog 2>/dev/null
    for f in check_run:
        continue if f == ""
        cecho("sWb", "check_logs.run.svlog:")
        let content: str = readFile(f)
        print content
        report = report + content + "\n"
    return make_report(report, bl, f"replay-{replay_type}")

def scan_regression_tests_detailed(build_dir: str, btype: BuildType, subtype: BuildSubtype, bl: str) -> str:
    var dir: str = build_dir
    case btype:
        when IP: dir = dir.replace("OP", "IP")
        when OP: dir = dir.replace("IP", "OP")
        when others: pass
    let sl: str = subtype_label(subtype)
    var log_dir: str = ""
    case subtype:
        when mono:
            log_dir = dir + "/tacot_corico.LATEST/work/logging-" + sl + "/LOGS_mono"
        when others:
            log_dir = dir + "/tacot_corico.LATEST/work/logging-" + sl + "/LOGS_others"
    if not -d Path(log_dir):
        cecho("sWb", "log dir does not exist: " + log_dir)
        return ""
    cecho("usBy", "scanning " + log_dir)
    let tacot_root: str = str(Path(log_dir).parent.parent.parent)
    find_core_dumps(tacot_root)
    var report: str = ""
    case subtype:
        when mono:
            let mono_out: str = log_dir + "/mono.out"
            if -f Path(mono_out):
                let hits: str = grep_logfile(mono_out)
                report = hits
        when others:
            let out_files: []str = shellLines: ls {log_dir}/*1_out_01 2>/dev/null
            for f in out_files:
                continue if f == ""
                hr("#")
                cecho("sWb", Path(f).name)
                hr("#")
                let hits: str = grep_logfile(f)
                if hits != "":
                    report = report + "##### " + Path(f).name + " #####\n" + hits + "\n"
    return make_report(report, bl, "regression_" + btype'Image + "_" + sl)

def show_failed_tests(build_dir: str, btype: BuildType, subtype: BuildSubtype, n_baselines: int = 15) -> str:
    var dir: str = build_dir
    case btype:
        when IP: dir = dir.replace("OP", "IP")
        when OP: dir = dir.replace("IP", "OP")
        when others: pass
    var bl: str = ""
    for part in dir.split("/"):
        if part.startswith("TACT_CONFIG."):
            bl = part.replace("TACT_CONFIG.", "")
            break
    let sl: str = subtype_label(subtype)
    var ip_env: str = $CM_ENV_ID
    var op_env: str = ip_env.replace(".IP.", ".OP.")
    ip_env = ip_env.replace(".OP.", ".IP.")
    var result: str = ""
    for iteration in range(n_baselines):
        let header: str = f"FAILED {btype'Image} REGRESSION TESTS logging-{sl} for BASELINE {bl}"
        hr("-")
        cecho("sWr", header)
        result = result + header + "\n"
        var env: str = ip_env
        var suffix: str = "failed-in"
        case subtype:
            when mono:
                env = ip_env
                suffix = "failed-mono"
            when in_test:
                case btype:
                    when IP:  env = ip_env
                    when OP:  env = op_env
                    when others: pass
                suffix = "failed-in"
            when assert_test:
                env = op_env
                suffix = "failed-assert"
            when others: pass
        let r = shell: nl /cm/ot/TACT/test_reports/TACT.TACT_CONFIG.{bl}-{env}*/general.results.{suffix} 2>/dev/null
        if r.output.strip() != "":
            print r.output.rstrip("\n")
            result = result + r.output
        bl = previous_baseline_nr(bl)
    return result

def make_comparable(logfile: str, bl: str) -> str:
    """Normalize a log file for diffing: make_executable_output_comparable + make_comparable.ksh + test name normalization."""
    let rc0: int = shell: mkdir -p /tmp/reports
    let out_file: str = "/tmp/reports/" + bl + "_" + Path(logfile).name
    let rc1: int = shell: make_executable_output_comparable {!logfile} -o {!out_file} 2>/dev/null
    let rc2: int = shell: make_comparable.ksh {!out_file} {bl} 2>/dev/null
    # Normalize test names so trivial renames don't show as diffs.
    let rc3: int = shell: sd '[vb]1.el' 'test1.el' {!out_file}; sd '[vb]2.el' 'test2.el' {!out_file}; sd '[vb]3.el' 'test3.el' {!out_file}
    return out_file

def show_detailed_build_info():
    let prev_baseline: str = previous_baseline_nr(baseline)
    let cur_build: str = saved_logs_dir(baseline, IP).replace("/saved_logs", "")
    let prev_build: str = saved_logs_dir(prev_baseline, IP).replace("/saved_logs", "")
    let prev_log: str = prev_build + "/Csystem_build.log"
    let cur_log: str = cur_build + "/Csystem_build.log"
    cecho("sWr", "Compare Csystem_build.log:")
    print "  prev: " + prev_log
    print "  cur:  " + cur_log
    let prev_normalized: str = make_comparable(prev_log, prev_baseline)
    let cur_normalized: str = make_comparable(cur_log, baseline)
    if not BATCH:
        let rc: int = shell: meld {!prev_normalized} {!cur_normalized} &
    else:
        let rc: int = shell: diff {!prev_normalized} {!cur_normalized}

def show_detailed_regression_tests():
    if detail == "":
        die("-focus IP/OP with detail required for troubleshoot mode")
    var btype: BuildType = IP
    case focus:
        when focus_IP:  btype = IP
        when focus_OP:  btype = OP
        when others: pass
    var subtype: BuildSubtype = in_test
    for st in BuildSubtype:
        if subtype_label(st) == detail:
            subtype = st
            break
    let prev_baseline: str = previous_baseline_nr(baseline)
    let cur_dir: str = saved_logs_dir(baseline, btype)
    let prev_dir: str = saved_logs_dir(prev_baseline, btype)
    let prev_report: str = scan_regression_tests_detailed(prev_dir, btype, subtype, prev_baseline)
    let cur_report: str = scan_regression_tests_detailed(cur_dir, btype, subtype, baseline)
    if prev_report != "" and cur_report != "" and not BATCH:
        let meld_rc: int = shell: meld {prev_report} {cur_report} &
    let failed_file: str = "/tmp/reports/failed_tests"
    let failed_output: str = show_failed_tests(cur_dir, btype, subtype)
    writeFile(failed_file, failed_output)
    if not BATCH:
        let emacs_rc: int = shell: emacs {!failed_file} &

def show_detailed_replays():
    if detail == "":
        die("-focus replay with detail required for troubleshoot mode")
    let replay_type: str = detail
    let prev_baseline: str = previous_baseline_nr(baseline)
    let cur_dir: str = saved_logs_dir(baseline, OP)
    let prev_dir: str = saved_logs_dir(prev_baseline, OP)
    let prev_log: str = get_replay_log_dir(prev_dir, replay_type)
    let cur_log: str = get_replay_log_dir(cur_dir, replay_type)
    let prev_report: str = scan_replay_dir_detailed(prev_log, prev_baseline, replay_type)
    let cur_report: str = scan_replay_dir_detailed(cur_log, baseline, replay_type)
    if prev_report != "" and cur_report != "" and not BATCH:
        let meld_rc: int = shell: meld {prev_report} {cur_report} &

# ---------------------------------------------------------------------------
# Run
# ---------------------------------------------------------------------------

def run():
    case focus:
        when focus_replay:
            show_replays()
            show_detailed_replays()
        when focus_IP | focus_OP | focus_SIP:
            show_regression_tests()
            show_detailed_regression_tests()
        when focus_build_info:
            show_build_info()
            show_detailed_build_info()
        when no_focus:
            show_header()
            show_regression_tests()
            show_build_info()
            show_replays()
            list_all_changes(baseline)
run()
