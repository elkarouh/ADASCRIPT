#!/usr/bin/env ady2nim
#ady2nim-args c -d:release
"""Tblame — batch WHO/WHEN/WHY git-blame lookups for grep-style input.

Reads lines shaped <file>:<line_no>[<info>] (e.g. piped from `grep -n`) and
answers, per line, WHO (user) last touched it, WHEN (date), and WHY (the
software-change ticket the commit belongs to) -- plus the blamed source
text and any trailing <info> carried on the input line. Typical use: pipe
the output of a source-code search through Tblame to see who to ask about
each hit.

Flow, once the Options are parsed:

  1. Resolver turns every input line into a Hit: which repository,
     revision and file it names, or that it names none. A line naming
     none is passed through to the output (or dropped, under
     `-filter_unmatched`); the Resolver knows the two path shapes this
     site uses and caches the revision each baseline resolves to.

  2. BlameBatch groups the Hits by (repository, revision, file) and blames
     each group exactly once: one `git blame` per file asks for every line
     needed there via repeated `-L n,n` flags, and each result is matched
     back to the Hits that asked for it by the line number git itself
     reports in the porcelain block -- git sorts and deduplicates -L
     ranges, so results cannot be matched back by the order or count of
     the flags sent.

  3. Report takes the Hits back in input order, drops those older than
     `-since`, and prints one row per Hit: each requested column (date,
     user, sc ticket, blamed text, ...) padded to its widest value, except
     "reference" and "reference_blame", which are prefixed with "| ".
     Pass-through lines keep their place among the rows, those after the
     last row included.
"""

var SHOW_DEBUG: bool = False

def debug_log(msg: str):
    if SHOW_DEBUG:
        stderr.writeLine(PROG + ": " + msg)

# ---------------------------------------------------------------------------
# Output columns
# ---------------------------------------------------------------------------

type OutputColumn is enum Col_Checksum, Col_Date, Col_User, Col_ScFirst, Col_ScHint, Col_ScAll, Col_FileOriginal, Col_FileName, Col_FileWorkspace, Col_Reference, Col_ReferenceBlame

let COLUMN_NAME: [OutputColumn]str = [
    Col_Checksum:       "checksum",
    Col_Date:           "date",
    Col_User:           "user",
    Col_ScFirst:        "sc_first",
    Col_ScHint:         "sc_hint",
    Col_ScAll:          "sc_all",
    Col_FileOriginal:   "file_original",
    Col_FileName:       "file_name",
    Col_FileWorkspace:  "file_workspace",
    Col_Reference:      "reference",
    Col_ReferenceBlame: "reference_blame",
]

let COLUMN_HELP: [OutputColumn]str = [
    Col_Checksum:       "A CRC checksum of the line and filename.",
    Col_Date:           "The date which the line was last modified",
    Col_User:           "The user that made the change",
    Col_ScFirst:        'The first software change associated with the change. No guarantee that it is the "best" one.',
    Col_ScHint:         "Same as sc_first but with a hint if more exist.",
    Col_ScAll:          "All software changes associated with the change. There can be many, making it difficult to display.",
    Col_FileOriginal:   "Provide the same path as supplied to stdin in the output",
    Col_FileName:       "The file name only",
    Col_FileWorkspace:  "The path to the file in the workspace, relative to the NM repo dir.",
    Col_Reference:      "The reference content trailing the file and line number, from stdin.",
    Col_ReferenceBlame: "The line in the source file which the git blame references, from git blame.",
]

let DEFAULT_COLUMNS: []OutputColumn = [Col_Date, Col_ScHint, Col_User, Col_FileWorkspace, Col_ReferenceBlame]

def column_from_name(name: str) -> OutputColumn:
    """The column whose CLI spelling is NAME, or die saying it is not one."""
    for c in OutputColumn:
        if COLUMN_NAME[c] == name:
            return c
    die("Invalid column specifier " + name)

# ---------------------------------------------------------------------------
# What flows between the stages
# ---------------------------------------------------------------------------

# seconds since 1970-01-01 UTC, as git blame's author-time gives it
type Epoch is int
# an Epoch as the date column prints it: YYYY.MM.DD
type DateStamp is str
# a 1-based line number within a file
type LineNo is int
# a Hit's position in the input
type HitIndex is int
# a commit's 40-hex-digit SHA-1
type CommitHash is str
# what git rev-parse resolved a baseline to; "" means the working tree
type Revision is str
# "<repo>\x01<revision>\x01<file>": which Target a Hit names
type TargetKey is str

type HitKind is enum HK_Blame, HK_Passthrough, HK_Drop

type Hit is record:
    # One input line: what it says, and -- for HK_Blame -- the repository,
    # revision and file git blame is to be asked about.
    raw:      str
    repo:     Path
    revision: Revision
    file:     Path
    nmroot:   Path
    # the path exactly as written on the input line
    orig:     Path
    line_no:  LineNo
    # free text after the line number
    trailing: str
    kind:     HitKind = HK_Drop

type Blame is record:
    committer:   str = ""
    author_time: Epoch = 0
    summary:     str = ""
    text:        str = ""

type Target is record:
    # one file at one revision in one repository: what one git blame covers
    repo:     Path
    revision: Revision
    file:     Path

# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

def strip_after(s: str, marker: str) -> str:
    """Everything before the first occurrence of MARKER, or S unchanged."""
    let at: int = s.find(marker)
    if at >= 0:
        return s[:at]
    return s

def strip_prefix(s: str, prefix: str) -> str:
    if s.startswith(prefix):
        return s[len(prefix):]
    return s

# ---------------------------------------------------------------------------
# NM/CM site tools, wrapped as opaque external programs
# ---------------------------------------------------------------------------
# Psort and where_workspace are site-specific NM tooling.

def add_alternate(nmroot: Path, alternate: Path):
    """Register ALTERNATE as a git alternate object store for NMROOT's
    repository, unless it is already listed there."""
    let alt_file: Path = nmroot / ".git" / "objects" / "info" / "alternates"
    var already_listed: bool = False
    if -f alt_file:
        let r = shell: grep -qxF -- {!alternate} {alt_file}
        already_listed = (r.code == 0)
    if not already_listed:
        shell: echo {!alternate} >> {alt_file}

def where_workspace(cmpath: str) -> (Path, int):
    """Resolve a /cm/ot/... context path to its workspace path.

    Returns (path, exit_code); exit_code 2 means "the subsystem is not
    checked out".
    """
    let r = shell: where_workspace {!cmpath}
    return (Path(r.output.strip()), r.code)

# ---------------------------------------------------------------------------
# Column values
# ---------------------------------------------------------------------------

def line_checksum(line: str) -> str:
    let stripped: str = line.replace(" ", "")
    debug_log(f"CKSUM:[{stripped}]")
    let r = shell(stdin = stripped): cksum
    let parts: []str = r.output.split()
    if len(parts) == 0:
        return "0000000000"
    return f"{int(parts[0]):010d}"

def sc_value(col: OutputColumn, tickets: []str) -> str:
    """sc_first, sc_hint or sc_all, from the SC tickets a commit names."""
    if len(tickets) == 0:
        return "<no-sc>"
    case col:
        when Col_ScAll:
            return ",".join(tickets)
        when Col_ScHint:
            if len(tickets) > 1:
                return tickets[0] + f"(+{len(tickets) - 1})"
            return tickets[0]
        when others:
            return tickets[0]

def column_value(col: OutputColumn, hit: Hit, b: Blame, tickets: []str) -> str:
    """The value of every column but Col_Date, which Report fills in all at
    once (see format_dates)."""
    case col:
        when Col_Checksum:
            return line_checksum(hit.raw)
        when Col_User:
            return b.committer
        when Col_ScFirst | Col_ScHint | Col_ScAll:
            return sc_value(col, tickets)
        when Col_FileOriginal:
            return str(hit.orig) + ":" + str(hit.line_no)
        when Col_FileName:
            return hit.file.name + ":" + str(hit.line_no)
        when Col_FileWorkspace:
            return strip_prefix(str(hit.file), str(hit.nmroot) + "/") + ":" + str(hit.line_no)
        when Col_Reference:
            return hit.trailing
        when Col_ReferenceBlame:
            return b.text
        when others:
            return ""

def format_dates(epochs: []Epoch) -> {Epoch}DateStamp:
    """YYYY.MM.DD for each epoch, from a single `date` process.

    A row per `date` call was one process per output line, which undid most
    of what blaming each file once saves: a thousand hits spread over a
    handful of commits still started a thousand processes.
    """
    var wanted: []Epoch = []
    var seen: {}Epoch = {}
    for e in epochs:
        if e not in seen:
            seen.add(e)
            wanted.append(e)
    if len(wanted) == 0:
        return {:}
    let stamps: str = "\n".join(["@" + str(e) for e in wanted]) + "\n"
    let days: []DateStamp = shellLines(stdin = stamps): date -f - +%Y.%m.%d
    return {e: day for e, day in zip(wanted, days)}

# ---------------------------------------------------------------------------
# Stage 1: what each input line names
# ---------------------------------------------------------------------------

class Resolver:
    """What this site's paths mean: turns an input line into a Hit.

    Holds the workspace root, the optional alternate repository, and the
    revision each context-path baseline resolves to, so Psort and
    rev-parse run once per baseline rather than once per line.
    """
    workspace:       Path = Path("")
    alternate:       Path = Path("")
    show_unmatched:  bool = True
    # keyed by "system/subsystem.baseline", the baseline lower-cased
    revisions:       {str}Revision = {:}
    alternate_added: bool = False

    def __init__(self, workspace: Path, alternate: Path, show_unmatched: bool):
        self.workspace = workspace
        self.alternate = alternate
        self.show_unmatched = show_unmatched

    def resolve(self, raw: str) -> Hit:
        """What an input line names. Two path shapes are known:

          /NM/<system>/<subsystem>/<subdir+file>:<line>[:<trailing>]
            -- an absolute workspace path; blamed in place, no revision
               needed.
          /cm/ot/<system>/<subsystem>!<baseline>/<build_X>/<subdir+file>:<line>[:<trailing>]
            -- a build-context path; the workspace file and the baseline's
               git revision have to be resolved first.

        Anything else is passed through, or dropped under -filter_unmatched.
        """
        case raw:
            when /\/NM\/(?P<system>\w+)\/(?P<subsystem>\w+)\/[^:]+:(?P<lineno>[0-9]+):?(?P<trailing>.*)$/:
                return self.workspace_hit(raw, $+{system}, $+{subsystem}, int($+{lineno}), $+{trailing})
            when /\/cm\/ot\/(?P<system>\w+)\/(?P<subsystem>\w+)[!\.][^\/]+\/[^\/]+\/(?P<filepath>[^:]+):(?P<lineno>[0-9]+):?(?P<trailing>.*)$/:
                return self.context_hit(raw, $+{system}, $+{subsystem}, Path($+{filepath}), int($+{lineno}), $+{trailing})
            when others:
                var hit: Hit
                hit.raw = raw
                if self.show_unmatched:
                    hit.kind = HK_Passthrough
                    debug_log("Unmatched:")
                    debug_log(raw)
                else:
                    debug_log("Skipped " + raw)
                return hit

    def workspace_hit(self, raw: str, system: str, subsystem: str, line_no: LineNo, trailing: str) -> Hit:
        """A /NM/... line: the file as written, in the workspace."""
        if self.alternate != "" and not self.alternate_added:
            # Once per run: the workspace, and so the file it writes, is
            # the same for every workspace-path line.
            add_alternate(self.workspace, self.alternate)
            self.alternate_added = True
        var hit: Hit
        hit.raw = raw
        hit.kind = HK_Blame
        hit.file = Path(raw[:raw.find(":")])
        hit.orig = hit.file
        hit.nmroot = self.workspace
        hit.repo = self.workspace / system / subsystem
        hit.revision = ""
        hit.line_no = line_no
        hit.trailing = trailing
        return hit

    def context_hit(self, raw: str, system: str, subsystem: str, filepath: Path, line_no: LineNo, trailing: str) -> Hit:
        """A /cm/ot/... line: blamed in the alternate when there is one,
        else in the workspace -- at the revision its baseline names.
        FILEPATH is the subdir+file part, relative to the subsystem."""
        let written: str = raw[:raw.find(":")]
        var hit: Hit
        hit.raw = raw
        hit.orig = Path(written)
        hit.line_no = line_no
        hit.trailing = trailing
        if self.alternate != "":
            hit.nmroot = self.alternate
            hit.file = filepath
        elif self.workspace != "":
            let (ws_path, ws_code) = where_workspace(written)
            if ws_code == 2:
                debug_log("Could not find the file " + written + " in the workspace, the subsystem is not checked out.")
                return hit
            if ws_code != 0:
                warn("Below line looks like it contains a context path but it could not be found in the workspace.")
                warn(raw)
                return hit
            hit.nmroot = self.workspace
            hit.file = ws_path
        else:
            return hit
        hit.kind = HK_Blame
        hit.repo = hit.nmroot / system / subsystem
        hit.revision = self.revision_of(written, hit.nmroot)
        return hit

    def revision_of(self, cmpath_in: str, nmroot: Path) -> Revision:
        """The git revision a /cm/ot/... path's baseline names, "" if none.

        Psort lists the baseline's related context paths; each whose
        subsystem is checked out under NMROOT is resolved with rev-parse
        and cached under its lower-cased baseline, which is also what the
        lookup uses -- so a mixed-case baseline (an NM build id like
        "G!31.IP.L8") finds the entry it has just filled.
        """
        var cmpath: str = strip_after(cmpath_in, "/build_")
        cmpath = strip_after(cmpath, "/sources")
        if cmpath != /\/cm\/ot\/(?P<system>\w+)\/(?P<subsystem>\w+)[!\.](?P<baseline>[^\/]+)/:
            return ""
        let system: str = $+{system}
        let subsystem: str = $+{subsystem}
        let baseline: str = $+{baseline}
        let key: str = system + "/" + subsystem + "." + baseline.lower()
        if key not in self.revisions:
            let forward  = shell(stdin = cmpath): Psort
            let backward = shell(stdin = cmpath): Psort -reverse -backward
            var seen: {}str = {}
            for candidate in (forward.output + "\n" + backward.output).split("\n"):
                continue if candidate == ""
                continue if candidate in seen
                seen.add(candidate)
                continue if not (baseline.lower() in candidate.lower() or candidate == /!\d+/)
                continue if candidate != /\/cm\/ot\/(?P<system>\w+)\/(?P<subsystem>\w+)[!\.](?P<baseline>[^\/]+)/
                let sys2: str = $+{system}
                let sub2: str = $+{subsystem}
                let bl2:  str = $+{baseline}
                let repo_dir: Path = nmroot / sys2 / sub2
                let repo_git: Path = repo_dir / ".git"
                if not -r repo_git:
                    debug_log("Not populating revision for " + sys2 + "/" + sub2 + " because it isn't checked out.")
                    continue
                let r = shell: git -C {repo_dir} rev-parse {bl2}
                if r.code == 0:
                    self.revisions[sys2 + "/" + sub2 + "." + bl2.lower()] = r.output.strip()
                else:
                    warn("Could not determine revision for " + repo_dir + " " + bl2)
        return self.revisions.get(key, "")

# ---------------------------------------------------------------------------
# Stage 2: blame each file once
# ---------------------------------------------------------------------------

class BlameBatch:
    """Every blame this run needs, grouped so that each file is blamed once.

    Hits are known by their index in the input; the Target a Hit names and
    the line it wants are all BlameBatch needs from it. git-blame's
    porcelain output gives a commit's metadata (committer, author-time,
    summary) only the first time that commit appears in one invocation, so
    blame_target keeps it per commit for the lines that come later.
    """
    targets: {TargetKey}Target = {:}
    # the distinct lines wanted in each target, first-seen order
    lines:   {TargetKey}[]LineNo = {:}
    # the hits that asked for each line of each target
    owners:  {TargetKey}{LineNo}[]HitIndex = {:}
    results: {HitIndex}Blame = {:}

    def __init__(self):
        pass

    def add(self, idx: HitIndex, hit: Hit):
        let key: TargetKey = str(hit.repo) + "\x01" + hit.revision + "\x01" + str(hit.file)
        if key not in self.targets:
            var t: Target
            t.repo = hit.repo
            t.revision = hit.revision
            t.file = hit.file
            self.targets[key] = t
            self.lines[key] = []
            self.owners[key] = {:}
        if hit.line_no not in self.owners[key]:
            self.lines[key].append(hit.line_no)
            self.owners[key][hit.line_no] = [idx]
        else:
            self.owners[key][hit.line_no].append(idx)

    def run(self):
        for key in self.targets.keys():
            self.blame_target(key)

    def has(self, idx: HitIndex) -> bool:
        return idx in self.results

    def blame_of(self, idx: HitIndex) -> Blame:
        return self.results[idx]

    def blame_target(self, key: TargetKey):
        let t: Target = self.targets[key]
        var args: []str = ["-P", "-C", str(t.repo), "blame"]
        if t.revision != "":
            args.append(t.revision)
        args.append("-p")
        args.append("-t")
        for ln in self.lines[key]:
            args.append("-L")
            args.append(f"{ln},{ln}")
        args.append("--")
        args.append(str(t.file))
        let porcelain: []str = shellLines: git {*args}

        let owners: {LineNo}[]HitIndex = self.owners[key]
        var committer:   {CommitHash}str = {:}
        var author_time: {CommitHash}Epoch = {:}
        var summary:     {CommitHash}str = {:}
        var cur_hash: CommitHash = ""
        var cur_line_no: LineNo = 0
        for pline in porcelain:
            if pline.startswith("\t"):
                var b: Blame
                b.committer = committer.get(cur_hash, "")
                b.author_time = author_time.get(cur_hash, 0)
                b.summary = summary.get(cur_hash, "")
                b.text = pline[1:]
                for idx in owners.get(cur_line_no, []):
                    self.results[idx] = b
            elif pline.startswith("committer "):
                committer[cur_hash] = pline[len("committer "):]
            elif pline.startswith("author-time "):
                author_time[cur_hash] = int(pline[len("author-time "):])
            elif pline.startswith("summary "):
                summary[cur_hash] = pline[len("summary "):]
            else:
                let tokens: []str = pline.split()
                if len(tokens) > 2 and tokens[0] == /^[0-9a-f]{40}$/:
                    cur_hash = tokens[0]
                    cur_line_no = int(tokens[2])

# ---------------------------------------------------------------------------
# Stage 3: the report
# ---------------------------------------------------------------------------

class Report:
    """The rows to print, in input order, and the lines passed through.

    A pass-through line keeps its place: it prints just ahead of the next
    row, or after the last row when none follows it.
    """
    columns:  []OutputColumn = []
    since:    Epoch = 0
    # one entry per row, all the same length
    values:   [][OutputColumn]str = []
    epochs:   []Epoch = []
    # the pass-through lines to print ahead of each row
    before:   [][]str = []
    pending:  []str = []

    def __init__(self, columns: []OutputColumn, since: Epoch):
        self.columns = columns
        self.since = since

    def pass_through(self, raw: str):
        self.pending.append(raw)

    def add(self, hit: Hit, b: Blame):
        if b.author_time > 0 and b.author_time < self.since:
            debug_log(f"Skipped {hit.file} (too old).")
            return
        let tickets: []str = b.summary == /SC-\d+/g
        var row: [OutputColumn]str
        for col in self.columns:
            row[col] = column_value(col, hit, b, tickets)
        self.values.append(row)
        self.epochs.append(b.author_time)
        self.before.append(self.pending)
        self.pending = []

    def print_all(self):
        if Col_Date in self.columns:
            let dates: {Epoch}DateStamp = format_dates(self.epochs)
            for i, epoch in enumerate(self.epochs):
                self.values[i][Col_Date] = dates.get(epoch, "")

        var widths: [OutputColumn]int
        for row in self.values:
            for c in self.columns:
                if len(row[c]) > widths[c]:
                    widths[c] = len(row[c])

        for i, row in enumerate(self.values):
            for line in self.before[i]:
                print(line)
            var parts: []str = []
            for c in self.columns:
                if c == Col_Reference or c == Col_ReferenceBlame:
                    parts.append("| " + row[c])
                else:
                    parts.append(row[c].ljust(widths[c]))
            print(" ".join(parts))
        for line in self.pending:
            print(line)

# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def usage():
    stderr.writeLine(f"""
{PROG} [OPTIONS...] [COLUMN_NAME...] [- FILENAME...]
  Retrieve history data by transforming input in format:

    <file>:<line_no>[<info>]

  into (by default):

    <date> <user> <first_sc> <file>:<line_no> | <info>

  In other words, find out WHO (user) did WHAT (info/line_no), WHEN (date) and WHY (sc)

OPTIONS

  -filter_unmatched
    Input lines that do not match the pattern <file>:<line_no> are not forwarded to stdout.

  -alternate <NM repository root>
    Use an alternative NM repository root to lookup the history. This can be used to prevent
    slow lookups on the default shallow-cloned repositories used in NM. The target repository
    does not need to be a workspace, it can be a recursively cloned NM repo. Regardless of
    whether the target repository is a workspace or not, it needs to be kept up-to-date
    with the latest baselines to ensure the queries succeed.

    Alternatively the environment variable NM_REPOSITORY_ALTERNATE can be used to define it.

  -since <epoch>
    Do not show lines committed before <epoch>.

  -source
    Recognised for compatibility with the ksh original (which could be dot-sourced to expose
    its functions for testing without running); this build just exits.

COLUMNS
""")
    for c in OutputColumn:
        stderr.writeLine(f"  {COLUMN_NAME[c]}\n    {COLUMN_HELP[c]}\n")

class Options:
    """What was asked for on the command line and in the environment."""
    show_debug:     bool = False
    show_unmatched: bool = True
    since_epoch:    Epoch = 0
    alternate:      Path = Path("")
    columns:        []OutputColumn = []
    filepaths:      []Path = []

    def __init__(self, argv: []str):
        var i: int = 0
        while i < len(argv):
            let a: str = argv[i]
            case a:
                when "-debug":            self.show_debug = True
                when "-filter_unmatched": self.show_unmatched = False
                when "-help" | "-h":
                    usage()
                    quit(0)
                when "-alternate":
                    i += 1
                    if i >= len(argv):
                        die("-alternate requires an argument")
                    self.alternate = Path(argv[i])
                when "-since":
                    i += 1
                    if i >= len(argv):
                        die("-since requires an argument")
                    self.since_epoch = int(argv[i])
                when "-source":
                    quit(0)
                when "-":
                    break
                when others:
                    if a.startswith("-"):
                        die("Unrecognised option " + a)
                    break
            i += 1

        while i < len(argv):
            if argv[i] == "-":
                i += 1
                break
            self.columns.append(column_from_name(argv[i]))
            i += 1

        while i < len(argv):
            if not -f argv[i]:
                die("File does not exist: " + argv[i])
            self.filepaths.append(Path(argv[i]))
            i += 1

        if len(self.columns) == 0:
            self.columns = DEFAULT_COLUMNS

        # Before the alternate check below, which logs under -debug.
        SHOW_DEBUG = self.show_debug
        if self.alternate == "" and $NM_REPOSITORY_ALTERNATE != "":
            self.alternate = Path($NM_REPOSITORY_ALTERNATE)
        if self.alternate != "":
            let alt_git: Path = self.alternate / ".git"
            if not -r alt_git:
                die(f"An alternate was defined at {self.alternate} but it is not readable.")
            debug_log(f"Using repository alternate at {self.alternate}")

    def input_lines(self) -> []str:
        """The named files' lines, or stdin's when no file was named."""

        def read_files_as_lines(paths: []Path) -> []str:
            """Each line of each file as "<file>:<lineno>:<content>" -- the
            shape `grep --line-number --with-filename -e '.*'` gives, which
            is what the rest of the program reads from stdin.

            <file> is made absolute: only /NM/... and /cm/ot/... paths are
            known, so a name given relative to the current directory would
            match neither. Symlinks are left as written, so a workspace
            reached through one keeps its /NM/... form.
            """
            var out: []str = []
            for p in paths:
                let name: str = os.path.abspath(str(p))
                let f: File = open(p)
                for n, content_line in enumerate(f.lines, 1):
                    out.append(name + ":" + str(n) + ":" + content_line)
            return out

        if len(self.filepaths) > 0:
            return read_files_as_lines(self.filepaths)
        return [line for line in stdin.lines]

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

let opt: Options = Options($@)

var resolver: Resolver = Resolver(Path($CMA_WORKSPACE_NM_REPOSITORY_DIRECTORY), opt.alternate, opt.show_unmatched)
var hits: []Hit = []
for raw in opt.input_lines():
    hits.append(resolver.resolve(raw))

var batch: BlameBatch = BlameBatch()
for idx, hit in enumerate(hits):
    if hit.kind == HK_Blame:
        batch.add(idx, hit)
batch.run()

var report: Report = Report(opt.columns, opt.since_epoch)
for idx, hit in enumerate(hits):
    case hit.kind:
        when HK_Passthrough:
            report.pass_through(hit.raw)
        when HK_Drop:
            pass
        when HK_Blame:
            if not batch.has(idx):
                warn(f"Could not retrieve blame data for input line '{hit.raw}'")
                continue
            report.add(hit, batch.blame_of(idx))
report.print_all()
