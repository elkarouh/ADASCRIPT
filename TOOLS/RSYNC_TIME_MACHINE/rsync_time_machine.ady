#!/usr/bin/env ady2nim
#ady2nim-args c -d:release
"""rsync-time-machine.ady: Time Machine-style backups using rsync.
Adascript translation of rsync-time-machine.py by basnijholt (Apache-2.0).

Not a line-for-line port: where the Python original reaches for a library,
this reaches for the language.
  - `Path` instead of `str` for anything that's actually a filesystem path
    (a database name, an rsync flag, or a PID-as-text is not a path, and
    stays `str` -- see the comment on each such field for why).
  - Native `{!path}` shell quoting and file-test operators (`-e`) for the
    purely-local case, instead of always hand-building a quoted command
    string and shelling out even for a stat() the runtime can do directly.
  - `$HOME` / `$PWD` read natively where a default or a relative path
    needs resolving, instead of embedding literal "$HOME" text and
    expanding it later with Python's os.path (imported as pyos).
  - Command-line parsing via Adascript's native `$@`/`$#`/`$0`, not
    Python's argparse.
  - No `pyimport` at all -- but note which of the replacements is which.
    The process id and the clock are `nimport os` / `nimport time`, native
    on both backends and free. Only what has no mapping goes to the shell:
    `date +%Y-%m-%d-%H%M%S` for a formatted stamp, `uname -s` for the
    platform. Exiting is `quit()`, and a backup directory's name becomes an
    epoch by arithmetic rather than by strptime, because `date -d` is GNU
    and `date -j -f` is BSD. The Nim build therefore needs neither nimpy nor
    libpython, which is what lets `make test` compile it.
  - Failures are values. Every step that changes something -- a mkdir, an
    rm, the `latest` link, the lock file -- returns `T | !Failure_T`, the
    steps are chained in `do:` blocks, and main() alone decides what to
    print and which status to exit with. The original ignored the exit
    status of all of those, so a failed `ln -s` still ended in "success"
    with no `latest` link at all, and called exit() from a dozen places.
"""

# No pyimports. What the Python originals were here for -- the clock, the
# process id, the platform, exiting -- is a nimport, a shell word or a
# builtin, and doing it that way means the Nim build needs neither nimpy nor
# libpython at run time.
# `os` and `time` are nimports, not pyimports: they map to Nim's own
# getCurrentProcessId() and epochTime() and to Python's os / time on the
# other backend. A nimport is free. A pyimport would cost nimpy on the Nim
# path and a libpython link, which is the whole reason this file has none.
nimport strutils
nimport os
nimport time

# Terminal styling comes from the Adascript standard library rather than
# maintaining a second set of ANSI escape sequences in this example.
from ansi import Style, bold, fg_green, fg_red, fg_yellow, fg_magenta

# Reusable combined styles.  Keep these as Style values so call sites can
# simply write `text | success_style` rather than rebuilding the combination.
let error_style:   Style = bold + fg_red
let success_style: Style = bold + fg_green
let bold_warning_style: Style = bold + fg_yellow

# ---------------------------------------------------------------------------
# Global state
# ---------------------------------------------------------------------------

var APPNAME: str = "rsync-time-machine.py"
var VERBOSE: bool = False

# ---------------------------------------------------------------------------
# Types
# ---------------------------------------------------------------------------

type SSH is tuple:
    src_folder_prefix:  str    # "" or "user@host:" -- text glued in front of a path, not a path itself
    dest_folder_prefix: str    # same, for the destination
    cmd:                str    # the `ssh ...` invocation used to run a command on the remote host
    src_folder:         Path   # the real path on whichever side is remote (or unchanged, if src is local)
    dest_folder:        Path   # likewise for the destination
    port:               str    # SSH port, as text -- goes straight into a command line, not a path
    id_rsa:             ?Path  # private key file -- always a *local* file read by the local ssh client

type CmdResult is tuple:
    stdout:     str    # arbitrary command output -- sometimes path-shaped text, often not; stays str
    stderr:     str
    returncode: int

type ResolvedPaths is tuple:
    src:  Path   # source path, with any "user@host:" prefix stripped off
    dest: Path   # destination path, likewise
    ssh:  ?SSH   # set when either side turned out to be remote

type LogLevel_T is enum INFO, WARNING, ERROR

# Why a run stopped. A step that can fail returns `T | !Failure_T`; main()
# is the one place that reports a Failure_T and picks the exit status.
type ErrKind_T is enum CMD_FAILED, NOT_A_BACKUP_DEST, SOURCE_MISSING, STILL_RUNNING, NO_SPACE, BAD_ARGUMENTS

type Failure_T is record:
    kind:   ErrKind_T
    detail: str    # the command that failed, the path at fault, or what went wrong
    stderr: str    # what a failed command said; "" for any other failure
    fix:    str    # a command that would fix it; "" when there is none

def failure(kind: ErrKind_T, detail: str, stderr: str = "", fix: str = "") -> Failure_T:
    return Failure_T(kind=kind, detail=detail, stderr=stderr, fix=fix)

# ---------------------------------------------------------------------------
# ANSI styling
# ---------------------------------------------------------------------------
#
# Use the styles from STDLIB/ansi.ady directly.  There is deliberately no
# local colour enum or style adapter here: `text | fg_green`,
# `text | bold`, and `text | error_style` use the stdlib interface.
#
# Reusable combinations such as `bold + fg_green` are named above and then
# applied with the same pipe syntax as ordinary styles.
#
# `ansi.ady` has no separate classic ANSI orange, so the places that used
# the old `orange` colour use `fg_yellow` directly.

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

def log(message: str, level: LogLevel_T = INFO) -> None:
    let prefix: str = APPNAME | bold
    case level:
        when WARNING:
            print f"{prefix}: [WARNING] {message | fg_yellow}"
        when ERROR:
            print f"{prefix}: [ERROR] {message | error_style}"
        when INFO:
            print f"{prefix}: {message}"

# ---------------------------------------------------------------------------
# Shell helpers — Adascript shell: integration
#
# Every primitive below branches on `ssh is None`. Locally, it uses
# Adascript's own shell:/file-test syntax directly -- `{!path}` quotes the
# path itself (no hand-rolled '...' wrapping to get wrong), and a couple of
# operations (existence, absolute-path resolution) skip the subprocess
# entirely and go through the runtime's own filesystem calls. Remotely, the
# whole command still has to be handed to `ssh` as one opaque string, so
# that path keeps building it with run_cmd() as before -- there's no way to
# quote pieces of a command that's about to be re-parsed by a shell on the
# other end of an SSH connection from inside our own shell: block.
# ---------------------------------------------------------------------------

def run_cmd(cmd: str, ssh: ?SSH = None) -> CmdResult:
    var full_cmd: str = cmd
    if ssh is not None:
        full_cmd = f"{ssh.cmd} '{cmd}'"
    if VERBOSE:
        let target: str = "remote" if ssh is not None else "local"
        log(f"Running {target} command: {full_cmd | success_style}", INFO)
    let r = shell: {full_cmd}
    if VERBOSE and r.code != 0:
        log(f"Command exit code: {str(r.code) | error_style}", ERROR)
    return (stdout: r.output, stderr: r.stderr, returncode: r.code)

# run_cmd answers questions -- `find`, `test -e`, `ps | grep` -- whose
# non-zero status is an answer, not a failure. A command that *changes*
# something is a do: step instead -- a local shell: step, or run_checked for
# a remote one -- and its failure stops the run.

def run_checked(cmd: str, ssh: ?SSH = None) -> str | !Failure_T:
    let r: CmdResult = run_cmd(cmd, ssh)
    if r.returncode != 0:
        return failure(CMD_FAILED, cmd, r.stderr.strip())
    return r.stdout

def bad_number(f: ParseFailure_T) -> Failure_T:
    """A piece of an expiration strategy that is not a whole number, as this
    program's failure: the `else` of the step below."""
    return failure(BAD_ARGUMENTS, f"'{f.text}' is not a whole number")

def cmd_failed(f: ShellFailure_T) -> Failure_T:
    """A local command's failure -- the built-in ShellFailure_T a shell:
    step fails with -- as this program's: the `else` of the steps below."""
    return failure(CMD_FAILED, f.command, f.stderr.strip())

def find_cmd(path: Path, ssh: ?SSH = None, maxdepth: ?int = None) -> str:
    if ssh is None:
        if maxdepth is not None:
            let r = shell: find {!path} -maxdepth {maxdepth}
            return r.output
        let r = shell: find {!path}
        return r.output
    var cmd: str = f"find '{path}'"
    if maxdepth is not None:
        cmd = cmd + f" -maxdepth {maxdepth}"
    return run_cmd(cmd, ssh).stdout

def get_absolute_path(path: Path, ssh: ?SSH = None) -> Path | !Failure_T:
    if ssh is None:
        return path.resolve()   # native resolve -- absolute, symlinks expanded, no subprocess
    do:
        abs_path <- run_checked(f"cd '{path}' && pwd", ssh)
    return Path(abs_path.strip())

def mkdir_p(path: Path, ssh: ?SSH = None) -> None | !Failure_T:
    if ssh is None:
        do:
            r <- shell: mkdir -p -- {!path} else cmd_failed(r)
        return
    do:
        run_checked(f"mkdir -p -- '{path}'", ssh)

def rm_file(path: Path, ssh: ?SSH = None) -> None | !Failure_T:
    if ssh is None:
        do:
            r <- shell: rm -f -- {!path} else cmd_failed(r)
        return
    do:
        run_checked(f"rm -f -- '{path}'", ssh)

def rm_dir(path: Path, ssh: ?SSH = None) -> None | !Failure_T:
    if ssh is None:
        do:
            r <- shell: rm -rf -- {!path} else cmd_failed(r)
        return
    do:
        run_checked(f"rm -rf -- '{path}'", ssh)

def ln_s(src: Path, dest: Path, ssh: ?SSH = None) -> None | !Failure_T:
    if ssh is None:
        do:
            r <- shell: ln -s -- {!src} {!dest} else cmd_failed(r)
        return
    do:
        run_checked(f"ln -s -- '{src}' '{dest}'", ssh)

def test_file_exists(path: Path, ssh: ?SSH = None) -> bool:
    if ssh is None:
        return -e path        # native file-test operator, no `test` subprocess needed
    return run_cmd(f"test -e '{path}'", ssh).returncode == 0

def get_filesystem_type(path: Path, ssh: ?SSH = None) -> str:
    var lines: []str
    if ssh is None:
        let r = shell: df -T {!path}
        lines = r.output.split("\n")
    else:
        let r: CmdResult = run_cmd(f"df -T '{path}'", ssh)
        lines = r.stdout.split("\n")
    if len(lines) > 1:
        return lines[1].split()[1]
    return ""

# ---------------------------------------------------------------------------
# SSH helpers
# ---------------------------------------------------------------------------

def dest_is_ssh(ssh: ?SSH) -> ?SSH:
    if ssh is not None and ssh.dest_folder_prefix != "":
        return ssh
    return None

def parse_ssh_pattern(folder: str, allow_host_only: bool = False) -> ?{str}str:
    # `folder` is raw CLI text here -- it might be "user@host:/path" (not a
    # real local path at all) or a plain path, so it has to stay `str`
    # until this regex has had a chance to tell the two apart.
    if folder == /^(?:(?P<user>[a-z0-9\._\-]+)@)?(?P<host>[A-Za-z0-9.\-]+):(?P<path>.+)$/:
        let match_result: {str}str = namedCaptures
        if not allow_host_only and "user" not in match_result:
            return None
        return match_result
    return None

def parse_ssh(
    src_folder: str,
    dest_folder: str,
    ssh_port: str,
    id_rsa: ?Path,
    allow_host_only: bool,
) -> ?SSH:
    let ssh_src:  ?{str}str = parse_ssh_pattern(src_folder,  allow_host_only)
    let ssh_dest: ?{str}str = parse_ssh_pattern(dest_folder, allow_host_only)

    if ssh_src is None and ssh_dest is None:
        return None

    # if-blocks rather than `x if x is not None else y` ternaries: here the
    # two candidates are checked in turn, so an if reads better than a
    # nested ternary would. (Narrowing works in a ternary and across an
    # `and` as well, so this is a choice rather than a workaround.)
    var ssh: {str}str = {:}
    if ssh_src is not None:
        ssh = ssh_src
    else:
        if ssh_dest is not None:
            ssh = ssh_dest

    let ssh_user: str = ssh.get("user", "")
    let ssh_host: str = ssh["host"]
    let auth: str = f"{ssh_user}@{ssh_host}" if ssh_user else ssh_host

    var id_rsa_opt: str = ""
    if id_rsa is not None:
        id_rsa_opt = f"-i {id_rsa} "
    let ssh_cmd: str = f"ssh -p {ssh_port} {id_rsa_opt}{auth}"

    # the regex capture is plain `str`; this is the one place it becomes a
    # real Path, once we know it's a genuine filesystem path and not
    # "user@host:..." syntax
    var src_prefix:  str  = ""
    var dest_prefix: str  = ""
    var real_src:    Path = Path(src_folder)
    var real_dest:   Path = Path(dest_folder)
    if ssh_src is not None:
        src_prefix = f"{auth}:"
        real_src = Path(ssh_src["path"])
    if ssh_dest is not None:
        dest_prefix = f"{auth}:"
        real_dest = Path(ssh_dest["path"])

    return (
        src_folder_prefix:  src_prefix,
        dest_folder_prefix: dest_prefix,
        cmd:                ssh_cmd,
        src_folder:         real_src,
        dest_folder:        real_dest,
        port:               ssh_port,
        id_rsa:             id_rsa,
    )

# ---------------------------------------------------------------------------
# Date helpers
# ---------------------------------------------------------------------------

def days_from_civil(y_in: int, m: int, d: int) -> int:
    """Days since 1970-01-01, by arithmetic rather than by a library.

    Howard Hinnant's days-from-civil, exact for every date the proleptic
    Gregorian calendar has. Doing it here rather than shelling out to
    `date -d` keeps it portable -- `-d` is GNU, and a backup tool has no
    business being Linux-only -- and costs no process per backup directory.
    """
    var y: int = y_in
    if m <= 2:
        y -= 1
    let era: int = (y if y >= 0 else y - 399) // 400
    let yoe: int = y - era * 400                      # [0, 399]
    let mp:  int = (m + 9) if m <= 2 else (m - 3)     # March is month 0
    let doy: int = (153 * mp + 2) // 5 + d - 1        # [0, 365]
    let doe: int = yoe * 365 + yoe // 4 - yoe // 100 + doy
    era * 146097 + doe - 719468

def own_pid() -> int:
    """This process's id, which the lock file records so a later run can
    ask `ps` whether the earlier one is still going.

    Behind a `nimport` this is native on both backends -- Nim's
    getCurrentProcessId(), Python's os.getpid() -- and costs nothing. It was
    `shell: echo $PPID` here for a while, which is correct but starts a
    process to learn something this one already knows. (The bare env read
    `$PPID` is not an option at all: PPID is a shell variable, and no shell
    exports it, so it reads as empty. That is the trap the shell form was
    written to get around; the import is the way past it.)
    """
    os.getpid()

def parse_date_to_epoch(date_str: str) -> int:
    """A backup directory's name -- "2026-09-15-112313" -- as a UTC epoch.

    Every use of the result is a difference or a day bucket, so what
    matters is that this and now_epoch() agree about the zero, not which
    zone they are in.
    """
    let year:   int = int(date_str[0:4])
    let month:  int = int(date_str[5:7])
    let day:    int = int(date_str[8:10])
    let hour:   int = int(date_str[11:13])
    let minute: int = int(date_str[13:15])
    let second: int = int(date_str[15:17])
    days_from_civil(year, month, day) * 86400 + hour * 3600 + minute * 60 + second

def now_str() -> str:
    """A backup's directory *name* (e.g. "2026-09-13-153000").

    Not a path until it is joined onto dest_folder, so it stays str. The
    clock is `date`, which every system has and which needs no import.
    """
    let (stamp, rc) = shell: date +%Y-%m-%d-%H%M%S
    return stamp.strip()

def now_epoch() -> int:
    """The current UTC epoch.

    `date +%s` would answer too, and did; `time.time()` behind a `nimport`
    is the same number without a process, and with the fraction of a second
    that `date` does not have. Truncated here because a backup's name has
    one-second resolution anyway.
    """
    int(time.time())

# ---------------------------------------------------------------------------
# Backup marker
# ---------------------------------------------------------------------------

def backup_marker_path(folder: Path) -> Path:
    return folder / "backup.marker"

def find_backup_marker(folder: Path, ssh: ?SSH = None) -> ?Path:
    let marker: Path = backup_marker_path(folder)
    let output: str = find_cmd(marker, dest_is_ssh(ssh))
    if output:
        return marker
    return None

# ---------------------------------------------------------------------------
# Backup enumeration
# ---------------------------------------------------------------------------

def find_backups(dest_folder: Path, ssh: ?SSH = None) -> []Path:
    let cmd: str = f"find '{dest_folder}/' -maxdepth 1 -type d -name '????-??-??-??????' -prune | sort -r"
    let r: CmdResult = run_cmd(cmd, dest_is_ssh(ssh))
    let raw_lines: []str = r.stdout.splitlines()
    var backups: []Path = []
    for line in raw_lines:
        # Nim's splitLines("") yields @[""] (one blank entry), unlike
        # Python's "".splitlines() which yields [] -- without this guard,
        # an empty destination silently produced one bogus empty-Path
        # "backup" on the Nim backend, which then cascaded into treating
        # it as a real (if unparseable) previous backup.
        if line:
            backups.append(Path(line))
    return backups

# ---------------------------------------------------------------------------
# Backup expiration
# ---------------------------------------------------------------------------

def expire_backup(backup_path: Path, ssh: ?SSH) -> None | !Failure_T:
    let parent_dir: Path = backup_path.parent
    if find_backup_marker(parent_dir, ssh) is None:
        return failure(NOT_A_BACKUP_DEST, str(parent_dir))
    log(f"Expiring {backup_path}", INFO)
    do:
        rm_dir(backup_path, ssh)

def expire_backups(
    dest_folder:         Path,
    expiration_strategy: str,
    backup_to_keep:      Path,
    ssh:                 ?SSH,
) -> None | !Failure_T:
    let current_timestamp: int = now_epoch()
    var last_kept_timestamp: int = 9999999999
    let backups: []Path = find_backups(dest_folder, ssh)
    var oldest_backup_to_keep: ?Path = None
    if backups:
        oldest_backup_to_keep = sorted(backups)[0]

    for backup_dir in sorted(backups):
        let backup_date: str = backup_dir.name
        let backup_timestamp: int = parse_date_to_epoch(backup_date)

        if backup_dir == backup_to_keep:
            break

        var is_oldest: bool = False
        if oldest_backup_to_keep is not None:
            if backup_dir == oldest_backup_to_keep:
                is_oldest = True
        if is_oldest:
            last_kept_timestamp = backup_timestamp
            continue

        # Hoisted out of the for-loop header for readability only.
        # `sorted(..., reverse=True)` used to mis-transpile on the Nim
        # backend, which is why an earlier draft of this file spelled it
        # `list(reversed(sorted(...)))`; that is fixed, so this says what
        # it means.
        let strategy_tokens: []str = sorted(expiration_strategy.split(), reverse=True)
        for strategy_token in strategy_tokens:
            var t: []int = []
            for piece in strategy_token.split(":"):
                do:
                    n <- parse_int(piece) else bad_number(n)
                t.append(n)
            let cut_off_timestamp: int = current_timestamp - t[0] * 86400
            let cut_off_interval_days: int = t[1]

            if backup_timestamp <= cut_off_timestamp:
                if cut_off_interval_days == 0:
                    do:
                        expire_backup(backup_dir, ssh)
                    break

                let last_kept_days: int = last_kept_timestamp // 86400
                let backup_days: int = backup_timestamp // 86400
                let interval_days: int = backup_days - last_kept_days

                if interval_days < cut_off_interval_days:
                    do:
                        expire_backup(backup_dir, ssh)
                    break

                last_kept_timestamp = backup_timestamp
                break

# ---------------------------------------------------------------------------
# Destination checks
# ---------------------------------------------------------------------------

def check_dest_is_backup_folder(dest_folder: Path, ssh: ?SSH) -> None | !Failure_T:
    if find_backup_marker(dest_folder, ssh) is None:
        let marker: Path = backup_marker_path(dest_folder)
        var fix: str = f'mkdir -p -- "{dest_folder}" ; touch "{marker}"'
        if ssh is not None:
            fix = f"{ssh.cmd} '{fix}'"
        return failure(NOT_A_BACKUP_DEST, str(dest_folder), fix=fix)

# ---------------------------------------------------------------------------
# rsync helpers
# ---------------------------------------------------------------------------

def get_link_dest_option(previous_dest: ?Path, ssh: ?SSH) -> str | !Failure_T:
    if previous_dest is None:
        log("No previous backup - creating new one.", INFO)
        return ""
    do:
        abs_prev <- get_absolute_path(previous_dest, ssh)
    var full_prev: str = str(abs_prev)
    if ssh is not None:
        full_prev = f"{ssh.dest_folder_prefix}{abs_prev}"
    log(f"Previous backup found - doing incremental backup from {full_prev | bold}" | fg_yellow, INFO)
    return f"--link-dest='{abs_prev}'"

def get_rsync_flags(
    src_folder:        Path,
    dest_folder:       Path,
    rsync_set_flags:   ?str,
    rsync_append_flags: ?str,
    ssh:               ?SSH,
) -> []str:
    var rsync_flags: []str = [
        "-D",
        "--numeric-ids",
        "--links",
        "--hard-links",
        "--one-file-system",
        "--itemize-changes",
        "--times",
        "--recursive",
        "--perms",
        "--owner",
        "--group",
        "--stats",
        "--human-readable",
    ]
    if rsync_set_flags is not None:
        rsync_flags = rsync_set_flags.split()
    if rsync_append_flags is not None:
        rsync_flags = rsync_flags + rsync_append_flags.split()

    let fs_type_src:  str = get_filesystem_type(src_folder, ssh)
    let fs_type_dest: str = get_filesystem_type(dest_folder, dest_is_ssh(ssh))
    if fs_type_src.lower() == "fat" or fs_type_dest.lower() == "fat":
        log("File-system is a version of FAT.", INFO)
        log("Using the --modify-window rsync parameter with value 2.", INFO)
        rsync_flags.append("--modify-window=2")

    if ssh is not None:
        rsync_flags.append("--compress")
    return rsync_flags

# ---------------------------------------------------------------------------
# PID / lock helpers
# ---------------------------------------------------------------------------

def check_not_running(running_pid: str, ssh: ?SSH = None) -> None | !Failure_T:
    # running_pid is a PID rendered as text (read back out of a lock file),
    # not a path -- stays str
    # `uname -s` in place of sys.platform: Linux, Darwin, NetBSD,
    # CYGWIN_NT-10.0-... . Lowercased, the two the original singled out
    # read the same way they did.
    let (uname_s, uname_rc) = shell: uname -s
    let platform: str = uname_s.strip().lower()
    var cmd: str = ""
    if platform.startswith("cygwin"):
        cmd = f"procps -wwfo cmd -p {running_pid} --no-headers | grep '{APPNAME}'"
        let cmd_result: CmdResult = run_cmd(cmd, ssh)
        if cmd_result.returncode == 0:
            return failure(STILL_RUNNING, cmd_result.stdout.strip())
    else:
        var ps_flags: str = "-p"
        if platform.startswith("netbsd"):
            ps_flags = "-axp"
        cmd = f"ps {ps_flags} {running_pid} -o 'command' | grep '{APPNAME}'"
        let check_result: CmdResult = run_cmd(cmd)
        if check_result.stdout:
            return failure(STILL_RUNNING, check_result.stdout.strip())

def handle_still_running_or_failed_or_interrupted_backup(
    inprogress_file: Path,
    mypid:           int,
    dest:            Path,
    dest_folder:     Path,
    previous_dest:   ?Path,
    ssh:             ?SSH,
) -> None | !Failure_T:
    let marker_hit: str = find_cmd(inprogress_file, ssh)
    if not marker_hit:
        return

    let running_pid: str = run_cmd(f"cat {inprogress_file}", ssh).stdout
    do:
        check_not_running(running_pid, ssh)

    if previous_dest is not None:
        var prefix: str = ""
        if ssh is not None:
            prefix = ssh.dest_folder_prefix
        log(f"{prefix}{inprogress_file} already exists - the previous backup failed or was interrupted. Backup will resume from there.", INFO)
        do:
            run_checked(f"mv -- {previous_dest} {dest}", ssh)

    do:
        run_checked(f"echo {mypid} > {inprogress_file}", ssh)

# ---------------------------------------------------------------------------
# Space / error handling
# ---------------------------------------------------------------------------

def deal_with_no_space_left(
    log_file:    Path,
    dest_folder: Path,
    ssh:         ?SSH,
    auto_expire: bool,
) -> bool | !Failure_T:
    var log_data: str = ""
    with open(log_file) as f:
        log_data = f.read()
    let no_space: bool = log_data == /No space left on device \(28\)|Result too large \(34\)/
    if not no_space:
        return False

    if not auto_expire:
        return failure(NO_SPACE, "No space left on device, and automatic purging of old backups is disabled.")

    log("No space left on device - removing oldest backup and resuming.", WARNING)
    let backups: []Path = find_backups(dest_folder, ssh)
    if len(backups) <= 1:
        return failure(NO_SPACE, "No space left on device, and no old backup to delete.")

    # The oldest is the first in date order. find_backups() lists them
    # newest first, and this used to re-sort them oldest first and take the
    # *last* -- the newest, which is the backup in progress: it was deleted
    # instead, freeing nothing, and the run retried into the same full disk.
    do:
        expire_backup(sorted(backups)[0], ssh)
    return True

def check_rsync_errors(log_file: Path, auto_delete_log: bool) -> None | !Failure_T:
    var log_data: str = ""
    with open(log_file) as f:
        log_data = f.read()
    if "rsync error:" in log_data:
        log(f"Rsync reported an error. Run this command for more details: grep -E 'rsync:|rsync error:' '{log_file}'", ERROR)
    elif "rsync:" in log_data:
        log(f"Rsync reported a warning. Run this command for more details: grep -E 'rsync:|rsync error:' '{log_file}'", WARNING)
    else:
        log("Backup completed without errors." | fg_magenta, INFO)
        if auto_delete_log:
            do:
                rm_file(log_file)   # log_file is always local -- reuse the local fast path directly

# ---------------------------------------------------------------------------
# SSH input validation
# ---------------------------------------------------------------------------

def handle_ssh(
    src_folder:     str,
    dest_folder:    str,
    ssh_port:       str,
    id_rsa:         ?Path,
    exclusion_file: ?Path,
    allow_host_only: bool,
) -> ResolvedPaths | !Failure_T:
    var ssh: ?SSH = parse_ssh(
        src_folder, dest_folder, ssh_port, id_rsa, allow_host_only,
    )
    # src/dest stay `str` here -- they may still carry "user@host:" syntax
    # (or need .rstrip()), neither of which is a real Path
    var src:  str = src_folder
    var dest: str = dest_folder
    if ssh is not None:
        let ssh_dest_str: str = str(ssh.dest_folder)
        if ssh_dest_str:
            dest = ssh_dest_str
        let ssh_src_str: str = str(ssh.src_folder)
        if ssh_src_str:
            src = ssh_src_str

    dest = dest.rstrip("/") if dest != "/" else dest
    src  = src.rstrip("/")  if src  != "/" else src

    if not src or not dest:
        return failure(BAD_ARGUMENTS, "Source and destination folder cannot be empty.")

    var has_quote: bool = "'" in src or "'" in dest
    if exclusion_file is not None:
        if "'" in str(exclusion_file):
            has_quote = True
    if has_quote:
        return failure(BAD_ARGUMENTS, "Source and destination directories may not contain single quote characters.")

    # now that any "user@host:" prefix is gone, these really are paths
    let handled: ResolvedPaths = (src: Path(src), dest: Path(dest), ssh: ssh)
    return handled

# ---------------------------------------------------------------------------
# Core backup logic
# ---------------------------------------------------------------------------

def start_backup(
    src_folder:        Path,
    dest:              Path,
    exclusion_file:    ?Path,
    inprogress_file:   Path,
    link_dest_option:  str,
    rsync_flags:       []str,
    log_dir:           Path,
    mypid:             int,
    ssh:               ?SSH,
    id_rsa:            ?Path,
    now:               str,
) -> Path | !Failure_T:
    let log_file: Path = log_dir / f"{now}.log"

    var src: str = str(src_folder)
    var dst: str = str(dest)
    if ssh is not None:
        src = f"{ssh.src_folder_prefix}{src_folder}"
        dst = f"{ssh.dest_folder_prefix}{dest}"

    log("Starting backup..." | fg_yellow, INFO)
    log(f"From: {src | bold}/", INFO)
    log(f"To:   {dst | bold}/", INFO)

    var cmd: str = "rsync"
    if ssh is not None:
        # id_rsa comes in as its own top-level parameter, not via
        # ssh.id_rsa -- extracting an Optional field straight out of an
        # already-unwrapped struct and into another Optional-typed
        # variable double-wraps it on the Nim backend (ssh.id_rsa is
        # already ?Path; a `let key: ?Path = ssh.id_rsa` re-wraps it as
        # Option[Option[Path]]). id_rsa and ssh.id_rsa are always the same
        # value -- ssh.id_rsa is set from this same parameter in
        # parse_ssh() -- so passing it straight through sidesteps the bug.
        var id_rsa_opt: str = ""
        if id_rsa is not None:
            id_rsa_opt = f"-i {id_rsa} "
        cmd = f"{cmd} -e 'ssh -p {ssh.port} {id_rsa_opt}-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'"

    let flags_str: str = " ".join(rsync_flags)
    cmd = f"{cmd} {flags_str}"
    cmd = f"{cmd} --log-file '{log_file}'"
    if exclusion_file is not None:
        cmd = f"{cmd} --exclude-from '{exclusion_file}'"
    cmd = f"{cmd} {link_dest_option}"
    cmd = f"{cmd} -- '{src}/' '{dst}/'"

    log("Running command:" | bold, INFO)
    log(cmd | fg_green, INFO)

    # Every attempt of one run writes the same log, and rsync appends to it:
    # the "No space left" of the attempt before was still in there, so each
    # retry took it for its own and expired another backup -- all of them,
    # in the end, even once rsync had room. Each attempt starts a fresh log.
    do:
        rm_file(log_file)
        run_checked(f"echo {mypid} > {inprogress_file}", ssh)
    # rsync's own status is not checked: running out of space is one of its
    # failures, and the log is where deal_with_no_space_left() and
    # check_rsync_errors() read what happened and what to do about it.
    run_cmd(cmd)
    return log_file

def backup(
    src_folder:          str,
    dest_folder:         str,
    exclusion_file:      ?Path,
    log_dir:             Path,
    auto_delete_log:     bool,
    expiration_strategy: str,
    auto_expire:         bool,
    port:                str,
    id_rsa:              ?Path,
    rsync_set_flags:     ?str,
    rsync_append_flags:  ?str,
    rsync_get_flags:     bool,
    allow_host_only:     bool,
    dry_run:             bool,
) -> None | !Failure_T:
    do:
        resolved <- handle_ssh(
            src_folder, dest_folder, port, id_rsa, exclusion_file, allow_host_only,
        )
    let src:    Path = resolved.src
    let dest_f: Path = resolved.dest
    let ssh:    ?SSH = resolved.ssh

    if not test_file_exists(src, ssh):
        return failure(SOURCE_MISSING, str(src))

    do:
        check_dest_is_backup_folder(dest_f, dest_is_ssh(ssh))

    let now:  str  = now_str()
    let dest: Path = dest_f / now
    # Hoisted rather than nested: a method chained onto a call whose last
    # argument is an Optional gets attached to that argument instead of to
    # the call's result -- `find_backups(dest_f, some(ssh).sorted(...))`.
    let all_backups: []Path = find_backups(dest_f, ssh)
    let sorted_backups: []Path = sorted(all_backups, reverse=True)
    var previous_dest: ?Path = None
    if sorted_backups:
        previous_dest = sorted_backups[0]
    let inprogress_file: Path = dest_f / "backup.inprogress"
    let mypid: int = own_pid()

    if not -d log_dir:
        log(f"Creating log folder in '{log_dir}'...", INFO)
        do:
            mkdir_p(log_dir)     # log_dir is always local

    do:
        handle_still_running_or_failed_or_interrupted_backup(
            inprogress_file, mypid, dest, dest_f, previous_dest, ssh,
        )

    var rsync_flags: []str = get_rsync_flags(src, dest_f, rsync_set_flags, rsync_append_flags, ssh)

    if "-n" in rsync_flags or "--dry-run" in rsync_flags:
        dry_run = True
        log(f"Dry-run detected in rsync flags - setting {'--dry-run' | fg_green}.", INFO)
    elif dry_run:
        rsync_flags.append("--dry-run")

    if dry_run:
        log(f"Dry-run mode enabled: {'no changes will be persisted' | fg_yellow}.", INFO)

    if rsync_get_flags:
        log(f"Rsync flags:\n{' '.join(rsync_flags) | bold_warning_style}", INFO)
        return

    var log_file: Path = Path("")
    for _ in 0 ..< 100:
        do:
            link_dest <- get_link_dest_option(previous_dest, ssh)

        let dest_marker: str = find_cmd(dest, ssh, 0)
        if not dest_marker:
            var dest_prefix: str = ""
            if ssh is not None:
                dest_prefix = ssh.cmd
            let full_dest: str = f"{dest_prefix}{dest}" | bold
            log(f"Creating destination {full_dest}", INFO)
            do:
                mkdir_p(dest, ssh)

        # Bound under names of their own, not log_file: a do: binding is a
        # new name, and this one has to outlive the loop.
        do:
            expire_backups(dest_f, expiration_strategy, previous_dest or dest, ssh)
            this_log <- start_backup(
                src, dest, exclusion_file, inprogress_file,
                link_dest, rsync_flags, log_dir, mypid, ssh, id_rsa, now,
            )
            retry <- deal_with_no_space_left(this_log, dest_f, ssh, auto_expire)
        log_file = this_log
        if not retry:
            break

    do:
        check_rsync_errors(log_file, auto_delete_log)

    if dry_run:
        do:
            rm_dir(dest, ssh)
            rm_file(inprogress_file, ssh)
        log("Dry run complete - no backup was saved.", INFO)
        return

    # One railway: the lock is released only once `latest` points at this
    # backup. If the link fails, the lock stays, and the next run finds an
    # interrupted backup to resume rather than a finished one with no link.
    do:
        rm_file(dest_f / "latest", dest_is_ssh(ssh))
        ln_s(Path(dest.name), dest_f / "latest", dest_is_ssh(ssh))
        rm_file(inprogress_file, ssh)

# ---------------------------------------------------------------------------
# Argument parsing and entry point
# ---------------------------------------------------------------------------

def report(f: Failure_T) -> None:
    """What went wrong, said once, here, for every step that can fail."""
    case f.kind:
        when CMD_FAILED:
            log(f"Command failed: {f.detail}", ERROR)
            if f.stderr:
                log(f.stderr, ERROR)
        when NOT_A_BACKUP_DEST:
            log(f"Safety check failed - {f.detail} does not appear to be a backup folder or drive (marker file not found)." | fg_yellow, INFO)
            log("If it is indeed a backup folder — you may add the marker file by running the following command:" | fg_yellow, INFO)
            log(f.fix | success_style, INFO)
        when SOURCE_MISSING:
            log(f"Source folder '{f.detail}' does not exist - aborting.", ERROR)
        when STILL_RUNNING:
            log(f"Previous backup task is still active - aborting (command: {f.detail}).", ERROR)
        when NO_SPACE:
            log(f.detail, ERROR)
        when BAD_ARGUMENTS:
            log(f.detail, ERROR)

def print_usage() -> None:
    print(f"Usage: {$0} [options] SRC DEST [EXCLUSION_FILE]")
    print("")
    print("  -p, --port PORT              SSH port. Default: 22")
    print("  -i, --id_rsa KEYFILE         Specify the private ssh key to use.")
    print("  --rsync-get-flags            Display the default rsync flags used for backup.")
    print("  --rsync-set-flags FLAGS      Set the rsync flags.")
    print("  --rsync-append-flags FLAGS   Append rsync flags.")
    print("  --log-dir DIR                Set the log file directory.")
    print('  --strategy STRATEGY          Set the expiration strategy. Default: "1:1 30:7 365:30"')
    print("  --no-auto-expire             Disable automatically deleting backups when out of space.")
    print("  --allow-host-only            Allow HOST-only pattern (without USER@) for SSH connections.")
    print("  --dry-run                    Simulate the backup process without making any persistent changes.")
    print("  --exclude-from FILE          Path to the file containing exclude patterns (alternative to positional arg).")
    print("  -v, --verbose                Enable verbose output.")
    print("  -h, --help                   Show this help message and exit.")
    quit(2)

def main() -> None:
    # computed natively via $HOME, rather than embedding the literal text
    # "$HOME" and relying on pyos.path.expandvars() to expand it at runtime
    let default_log_dir: Path = Path($HOME) / ".rsync-time-backup"

    var port:              str   = "22"
    var id_rsa:            ?Path = None
    var rsync_get_flags:   bool  = False
    var rsync_set_flags:   ?str  = None
    var rsync_append_flags: ?str = None
    var log_dir_arg:       str   = str(default_log_dir)
    var strategy:          str   = "1:1 30:7 365:30"
    var no_auto_expire:    bool  = False
    var allow_host_only:   bool  = False
    var dry_run:           bool  = False
    var exclude_from:      ?str  = None
    var verbose:           bool  = False
    var positionals:       []str = []

    # native Adascript argv access ($@ / $#) instead of Python's sys.argv --
    # a plain if/elif chain rather than case/when, since case/when's
    # documented patterns are list/tuple matches, not an OR of string
    # literals for a single arm (e.g. `when "-p", "--port":` would be read
    # as a 2-tuple pattern, not "either flag spelling").
    let argv: []str = $@
    var i: int = 0
    while i < len(argv):
        let arg: str = argv[i]
        if arg == "-p" or arg == "--port":
            i += 1
            if i >= len(argv): print_usage()
            port = argv[i]
        elif arg == "-i" or arg == "--id_rsa":
            i += 1
            if i >= len(argv): print_usage()
            id_rsa = Path(argv[i])
        elif arg == "--rsync-get-flags":
            rsync_get_flags = True
        elif arg == "--rsync-set-flags":
            i += 1
            if i >= len(argv): print_usage()
            rsync_set_flags = argv[i]
        elif arg == "--rsync-append-flags":
            i += 1
            if i >= len(argv): print_usage()
            rsync_append_flags = argv[i]
        elif arg == "--log-dir":
            i += 1
            if i >= len(argv): print_usage()
            log_dir_arg = argv[i]
        elif arg == "--strategy":
            i += 1
            if i >= len(argv): print_usage()
            strategy = argv[i]
        elif arg == "--no-auto-expire":
            no_auto_expire = True
        elif arg == "--allow-host-only":
            allow_host_only = True
        elif arg == "--dry-run":
            dry_run = True
        elif arg == "--exclude-from":
            i += 1
            if i >= len(argv): print_usage()
            exclude_from = argv[i]
        elif arg == "-v" or arg == "--verbose":
            verbose = True
        elif arg == "-h" or arg == "--help":
            print_usage()
        elif arg.startswith("-") and arg != "-":
            print(f"Unknown option: {arg}")
            print_usage()
        else:
            positionals.append(arg)
        i += 1

    if len(positionals) < 2:
        print_usage()

    let src_folder:  str = positionals[0]
    let dest_folder: str = positionals[1]
    var exclusion_file_arg: ?str = exclude_from
    if len(positionals) >= 3:
        if exclude_from is not None:
            log("Both positional `exclusion_file` and `--exclude-from` were provided. Please use only one.", ERROR)
            quit(2)
        exclusion_file_arg = positionals[2]

    let auto_delete_log: bool = (log_dir_arg == str(default_log_dir))

    VERBOSE = verbose
    # The Python original installed a SIGINT handler that logged one line
    # and exited 1. There is no native way to ask for that, and the default
    # action already ends the process, so the log line is what was lost.

    # A relative --log-dir is resolved against $PWD -- the directory the
    # script was actually invoked from -- the same way a shell resolves a
    # relative path, rather than leaving it to whatever the interpreter's
    # cwd happens to be by the time this runs.
    # `~` expanded here rather than by os.path.expanduser. A bare $VAR in
    # --log-dir is no longer expanded: the shell the user typed it at does
    # that already unless they quoted it, and expanding it a second time
    # ourselves is the surprising half of what expandvars did.
    var expanded: str = log_dir_arg
    if expanded == "~":
        expanded = $HOME
    elif expanded.startswith("~/"):
        expanded = $HOME + expanded[1:]
    var log_dir: Path = Path(expanded)
    if not str(log_dir).startswith("/"):
        log_dir = Path($PWD) / log_dir

    var exclusion_file: ?Path = None
    if exclusion_file_arg is not None:
        let raw: Path = Path(exclusion_file_arg)
        exclusion_file = raw if str(raw).startswith("/") else Path($PWD) / raw

    let outcome: None | !Failure_T = backup(
        src_folder, dest_folder, exclusion_file, log_dir, auto_delete_log,
        strategy, not no_auto_expire, port, id_rsa,
        rsync_set_flags, rsync_append_flags, rsync_get_flags,
        allow_host_only, dry_run,
    )
    if outcome is Failure_T:
        report(outcome)
        quit(1)

main()
